if (is_android) {
} else if (is_mac) {
} else if (is_ios) {
  declare_args() {
    # The bundle identifier. Overriding this will affect the provisioning
    # profile used, and hence will affect the app's capabilities.
    ios_content_shell_bundle_identifier = shared_bundle_id_for_test_apps

    # Path to an entitlements file used in ios_content_shell. Can be overridden
    # to provide an alternative.
    if (target_platform == "iphoneos") {
      ios_content_shell_entitlements_path =
          "//content/app/ios/appex/app.entitlements"
    } else {
      ios_content_shell_entitlements_path =
          "//build/config/ios/entitlements.plist"
    }
  }

  declare_args() {
    ios_content_process_bundle_identifier =
        "$ios_content_shell_bundle_identifier.ContentProcessExtension"
    ios_network_process_bundle_identifier =
        "$ios_content_shell_bundle_identifier.NetworkProcessExtension"
    ios_gpu_process_bundle_identifier =
        "$ios_content_shell_bundle_identifier.GPUProcessExtension"
  }

  ios_app_ipa("content_shell_ipa") {
    testonly = true
    bundle_target = ":content_shell"
  }

  if (target_platform == "iphoneos") {
    browserkit_extension("gpu_process") {
      testonly = true
      bundle_identifier = ios_gpu_process_bundle_identifier
    }

    browserkit_extension("network_process") {
      testonly = true
      bundle_identifier = ios_network_process_bundle_identifier
    }

    browserkit_extension("content_process") {
      testonly = true
      bundle_identifier = ios_content_process_bundle_identifier
    }
  }
} else {

  if (is_fuchsia) {
    fuchsia_component("content_shell_component") {
      testonly = true
      manifest = "fuchsia/content_shell.cml"
      data_deps = [ ":content_shell" ]
      visibility = [ ":*" ]
    }

    fuchsia_package("content_shell_pkg") {
      testonly = true
      package_name = "content_shell"
      deps = [ ":content_shell_component" ]
    }

    fuchsia_package_installer("content_shell_fuchsia") {
      testonly = true
      visibility = [
        ":*",  # See https://crbug.com/1328459#c4.
        "//:*",
      ]
      package = ":content_shell_pkg"
      package_name = "content_shell"
    }
  }
}



