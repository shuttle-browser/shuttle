import("//components/guest_view/buildflags/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")
import("//testing/test.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")
import("//ui/base/ui_features.gni")

assert(enable_extensions_core)
assert(!is_fuchsia)

# If enable_extensions is true then enable_guest_view must also be true.
assert(!enable_extensions || enable_guest_view)

if (is_component_build) {
  component("extensions") {
    visibility = [
      "//extensions/common:common_constants",
      "//extensions/common:export",
      "//extensions/common:extension_features",
    ]
    public_deps = [
      "//extensions/common:constants_impl",
      "//extensions/common:export_impl",
    ]
  }
}

# Used by targets that compile into the implementation.
config("component_implementation") {
  defines = [ "EXTENSIONS_COMPONENT_IMPLEMENTATION" ]
}

group("extensions_resources") {
  public_deps = [
    ":extensions_browser_resources",
    ":extensions_resources_grd",
    "//extensions/renderer/resources:extensions_renderer_generated_resources",
    "//extensions/renderer/resources:extensions_renderer_resources",
  ]
}

grit("extensions_resources_grd") {
  source = "extensions_resources.grd"
  inputs = [ "common/api/_api_features.json" ]
  outputs = [
    "grit/extensions_resources.h",
    "extensions_resources.pak",
  ]
}

grit("extensions_browser_resources") {
  source = "browser/resources/extensions_browser_resources.grd"
  inputs = [
    "browser/resources/default_100_percent/app_default_icon.png",
    "browser/resources/default_100_percent/extension_action_plain_background.png",
    "browser/resources/default_100_percent/extension_default_icon.png",
    "browser/resources/default_100_percent/extension_icon_plain_background.png",
    "browser/resources/default_100_percent/favicon_extensions.png",
    "browser/resources/default_200_percent/app_default_icon.png",
    "browser/resources/default_200_percent/extension_action_plain_background.png",
    "browser/resources/default_200_percent/extension_default_icon.png",
    "browser/resources/default_200_percent/extension_icon_plain_background.png",
    "browser/resources/default_200_percent/favicon_extensions.png",
  ]
  outputs = [
    "grit/extensions_browser_resources.h",
    "grit/extensions_browser_resources_map.cc",
    "grit/extensions_browser_resources_map.h",
    "extensions_browser_resources_100_percent.pak",
    "extensions_browser_resources_200_percent.pak",
  ]
}

