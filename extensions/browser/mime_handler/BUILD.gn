import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions && !is_android)

source_set("mime_handler") {
  sources = [
    "generic_mime_handler_stream_delegate.cc",
    "generic_mime_handler_stream_delegate.h",
    "mime_handler_stream_delegate.cc",
    "mime_handler_stream_delegate.h",
    "mime_handler_stream_manager.cc",
    "mime_handler_stream_manager.h",
    "mime_handler_ui_util.cc",
    "mime_handler_ui_util.h",
    "stream_info.cc",
    "stream_info.h",
  ]
  public_deps = [
    "//base",
    "//content/public/browser",
    "//extensions/browser:browser_sources",
    "//extensions/common:mojom",
    "//mojo/public/cpp/bindings",
  ]
  deps = [
    ":stream_container",
    "//components/crash/core/common:crash_key",
    "//extensions/common",
    "//extensions/common:common_constants",
  ]
}

source_set("mime_handler_registry") {
  sources = [
    "mime_handler_registry.cc",
    "mime_handler_registry.h",
  ]
  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//extensions/browser:browser_sources",
    "//extensions/common",
  ]
  deps = [
    "//components/keyed_service/content",
    "//content/public/browser",
  ]
}

source_set("mime_handler_page") {
  sources = [
    "mime_handler_page.cc",
    "mime_handler_page.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
  deps = [
    "//content/public/browser",
    "//content/public/common",
    "//content/public/common:buildflags",
    "//extensions:extensions_resources_grd",
    "//skia",
    "//ui/base",
  ]
}

source_set("stream_container") {
  sources = [
    "mime_handler_body_cache.cc",
    "mime_handler_body_cache.h",
    "stream_container.cc",
    "stream_container.h",
  ]
  public_deps = [
    "//base",
    "//extensions/common",
    "//extensions/common/api",
    "//mojo/public/cpp/system",
    "//third_party/blink/public/mojom:mojom_platform_headers",
    "//url",
  ]
  deps = [
    "//mojo/public/cpp/bindings",
    "//net",
  ]
}
