<?xml version="1.0" encoding="UTF-8"?>

<!--
This file contains strings for code in //services.
-->

<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/services_strings.h" type="rc_header">
      <emit emit_type="prepend"></emit>
    </output>
    <output filename="services_strings_en-US.pak" type="data_package" lang="en" />
    <if expr="is_ios">
      <!-- iOS uses es-MX for es-419 -->
    </if>
    <!-- The translation console uses 'no' for Norwegian Bokmål. It should
         be 'nb'. -->
    <if expr="is_ios">
      <!-- iOS uses pt for pt-BR -->
    </if>
    <!-- Pseudolocales -->
  </outputs>
  <translations>
    <!-- The translation console uses 'iw' for Hebrew, but we use 'he'. -->
  </translations>
  <release seq="1">
    <messages fallback_to_english="true">
      <message name="IDS_PROXY_RESOLVER_DISPLAY_NAME" desc="The name of the display name (in system task manager, etc) of the service process used for out-of-process V8 proxy resolution.">
        V8 Proxy Resolver
      </message>
      <message name="IDS_MAC_SYSTEM_PROXY_RESOLVER_DISPLAY_NAME" desc="The display name (in Chrome Task Manager, etc) of the service process used for out-of-process macOS system proxy resolution.">
        macOS System Proxy Resolver
      </message>
    </messages>
  </release>
</grit>
