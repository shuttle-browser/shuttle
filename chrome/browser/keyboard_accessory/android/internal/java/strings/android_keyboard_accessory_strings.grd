<?xml version="1.0" encoding="UTF-8"?>
<!-- android_chrome_strings.grd contains strings for the keyboard accessory in Chrome for Android. -->
<grit current_release="1" latest_public_release="0">
  <outputs>
    <output filename="values/android_keyboard_accessory_strings.xml" lang="en" type="android" />
    <!-- Pseudolocales -->
  </outputs>
  <translations>
  </translations>
  <release seq="1">
    <messages fallback_to_english="true">
    </messages>
  </release>
</grit>
