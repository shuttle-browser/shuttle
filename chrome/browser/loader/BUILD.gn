source_set("loader") {
  sources = [
    "from_gws_navigation_and_keep_alive_request_observer.h",
    "from_gws_navigation_and_keep_alive_request_tracker.h",
    "from_gws_navigation_and_keep_alive_request_tracker_factory.h",
    "keep_alive_request_tracker.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//content/public/browser",
    "//services/metrics/public/cpp:ukm_builders",
    "//url",
  ]

  # ScopedKeepAlive / ScopedProfileKeepAlive are desktop-only.
  if (!is_android) {
    sources += [
      "features.cc",
      "features.h",
      "fetch_keepalive_process_manager.h",
    ]
  }
}

source_set("impl") {
  sources = [
    "from_gws_navigation_and_keep_alive_request_observer.cc",
    "from_gws_navigation_and_keep_alive_request_tracker.cc",
    "from_gws_navigation_and_keep_alive_request_tracker_factory.cc",
    "keep_alive_request_tracker.cc",
  ]
  deps = [
    ":loader",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/navigator",
    "//components/page_load_metrics/browser",
    "//components/page_load_metrics/google/browser",
    "//services/metrics/public/cpp:metrics_cpp",
  ]
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]

  # ScopedKeepAlive / ScopedProfileKeepAlive are desktop-only.
  if (!is_android) {
    sources += [ "fetch_keepalive_process_manager.cc" ]
    deps += [
      "//chrome/browser/profiles/keep_alive",
      "//chrome/browser/ui/browser_window",
      "//components/keep_alive_registry",
    ]
  }
}

if (!is_android) {
}

