import("//build/config/chromeos/args.gni")
import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions)

source_set("controlled_frame") {
  sources = [
    "api/controlled_frame_internal_api.cc",
    "api/controlled_frame_internal_api.h",
    "controlled_frame_extensions_browser_api_provider.cc",
    "controlled_frame_extensions_browser_api_provider.h",
    "controlled_frame_menu_icon_loader.cc",
    "controlled_frame_menu_icon_loader.h",
    "controlled_frame_user_agent_util.cc",
    "controlled_frame_user_agent_util.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/extensions",
    "//chrome/common/controlled_frame/api",
    "//components/embedder_support:user_agent",
    "//components/guest_view/browser",
    "//content/public/common",
    "//extensions/browser",
    "//extensions/common",
    "//ui/gfx",
  ]

  configs += [
    "//build/config:precompiled_headers",
    "//build/config/compiler:wexit_time_destructors",
  ]

  public_deps = [ "//chrome/browser/controlled_frame/api:api_registration" ]
}

source_set("media_access_handler") {
  sources = [ "controlled_frame_media_access_handler.h" ]
  public_deps = [ "//chrome/browser/media:access_handler" ]
}

source_set("media_access_handler_impl") {
  sources = [
    "controlled_frame_media_access_handler.cc",
    "controlled_frame_media_permission_cache.cc",
    "controlled_frame_media_permission_cache.h",
    "controlled_frame_media_permission_cache_factory.cc",
    "controlled_frame_media_permission_cache_factory.h",
  ]
  public_deps = [ "//chrome/browser/media:access_handler" ]
  deps = [
    ":media_access_handler",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/profiles:profile",
    "//extensions/browser",
  ]
}

if (!is_android && !is_chromeos_device) {
}

