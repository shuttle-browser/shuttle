    "//components/language/core/common",
    "//components/live_caption:constants",
    "//components/metrics/demographics",
    "//components/network_time",
    "//components/performance_manager",
    "//components/privacy_sandbox:privacy_sandbox_prefs",
    "//components/spellcheck:buildflags",
    "//components/spellcheck/browser",
    "//components/strings:components_strings_grit",
    "//components/sync_preferences:features",
    "//components/user_manager",
    "//components/variations/service",

  ]
}

# Code that depends on this target must be linked into //chrome/browser:browser
# to pick up the implementations. The reason for this target separation is
# because KeyedServiceFactories mix the interface and implementation.
source_set("factories") {
  sources = [
    "sync_service_factory.h",
  ]
  public_deps = [
    ":data_type_store_service_factory",
    "//base",
    "//chrome/browser/profiles",
    "//components/sync/engine",
  ]
}

source_set("data_type_store_service_factory") {
  public = [ "data_type_store_service_factory.h" ]
  sources = [ "data_type_store_service_factory.cc" ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/sync/model",
  ]
  deps = [ "//components/keyed_service/content" ]
}

# Agent Chrome: sync tests removed; empty targets keep chrome/test deps valid.
source_set("unit_tests") {
  testonly = true
}

source_set("browser_tests") {
  testonly = true
}
