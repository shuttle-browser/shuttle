# The in-browser MCP server (agent profiles, sessions, tabs). Design:
# tools/shuttle/docs/MCP.md.

assert(!is_android)

source_set("shuttle") {
  public = [
    "shuttle_service.h",
    "shuttle_service_factory.h",
  ]

  public_deps = [
    ":network_access",
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//content/public/browser",
    "//ui/gfx",
  ]
}

# Shuttle command-line switches that live outside chrome_switches.h.
source_set("switches") {
  sources = [ "switches.h" ]
}

# Network mode (--shuttle-listen) and its access token.
source_set("network_access") {
  sources = [
    "network_access.cc",
    "network_access.h",
  ]
  deps = [
    "//base",
    "//crypto",
    "//net",
  ]
}

source_set("impl") {
  sources = [
    "agent_browser_sidecar.cc",
    "agent_browser_sidecar.h",
    "shuttle_service.cc",
    "shuttle_service_factory.cc",
    "avatar_cache.cc",
    "avatar_cache.h",
    "mcp_tools.cc",
    "mcp_tools.h",
    "page_tools.cc",
    "page_tools.h",
    "page_tools_data.inc",
    "pref_names.h",
    "profile_registry.cc",
    "profile_registry.h",
    "session_cdp_filter.cc",
    "session_cdp_filter.h",
    "session_manager.cc",
    "session_manager.h",
  ]

  deps = [
    ":shuttle",
    "//base",
    "//base:i18n",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/lifetime",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/keep_alive_registry",
    "//components/keyed_service/content",
    "//components/pref_registry",
    "//components/prefs",
    "//components/tab_groups",
    "//components/tabs:public",
    "//components/version_info",
    "//components/viz/common",
    "//content/public/browser",
    "//net",
    "//services/data_decoder/public/cpp",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//skia",
    "//ui/base",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
    "//url",
  ]
}
