import("//build/config/ui.gni")

source_set("webauthn") {
  public = [
    "credential_sorter.h",
    "shared_types.h",
    "touch_to_fill_credential_receiver.h",
    "webauthn_metrics_util.h",
    "webauthn_pref_names.h",
    "webauthn_switches.h",
  ]
  sources = [ "webauthn_pref_names.cc" ]
  public_deps = [
    "//content/public/browser",
    "//device/fido",
  ]

  if (is_android) {
    public += [
      "android/cable_module_android.h",
      "android/cable_registration_state.h",
      "android/chrome_webauthn_client_android.h",
      "android/credential_sorter_android.h",
    ]

    public_deps += [
      "//components/webauthn/android",
      "//device/fido:cablev2_registration",
    ]
  }

  if (!is_android) {
    public += [
      "authenticator_reference.h",
      "authenticator_request_dialog_controller.h",
      "authenticator_request_dialog_model.h",
      "authenticator_request_scheduler.h",
      "authenticator_transport.h",
      "chrome_authenticator_request_delegate.h",
      "credential_sorter_desktop.h",
      "immediate_request_rate_limiter_factory.h",
      "local_authentication_token.h",
    ]
    public_deps += [
      "//base",
      "//build:buildflag_header_h",
      "//chrome/browser/profiles:profile",
      "//chrome/common",
      "//chrome/common:version_header",
      "//components/keyed_service/core",
      "//components/os_crypt/common",
      "//components/webauthn/core/browser",
      "//crypto",
      "//google_apis",
    ]
  }

  if (is_mac) {
    public += [ "chrome_authenticator_request_delegate_mac.h" ]
  }
}

source_set("impl") {
  sources = [
    "webauthn_metrics_util.cc",
    "webauthn_switches.cc",
  ]

  public_deps = [
    ":webauthn",
    "//chrome/browser:browser_public_dependencies",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//url",
  ]

  if (is_android) {
    sources += [
      "android/cable_module_android.cc",
      "android/cable_registration_state.cc",
      "android/credential_sorter_android.cc",
    ]
    deps += [
      "//chrome/android:chrome_jni_headers",
      "//chrome/browser/gcm",
      "//chrome/browser/net",
      "//chrome/browser/webauthn/android:jni_headers",
      "//components/cbor",
      "//components/webauthn/android",
      "//components/webauthn/core/browser",
      "//components/webauthn/json",
      "//device/fido:cablev2_registration",
      "//third_party/blink/public/common:headers",
    ]
  }

  if (!is_android) {
    sources += [
      "authenticator_reference.cc",
      "authenticator_request_dialog_controller.cc",
      "authenticator_request_dialog_model.cc",
      "authenticator_request_scheduler.cc",
      "chrome_authenticator_request_delegate.cc",
      "credential_sorter_desktop.cc",
      "immediate_request_rate_limiter_factory.cc",
    ]
    deps += [
      ":chrome_web_authentication_delegate",
      "//chrome/app:generated_resources",
      "//chrome/app/vector_icons",
      "//chrome/browser/net",
      "//chrome/browser/profiles",
      "//chrome/browser/ui:chrome_pages",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/navigator",
      "//chrome/browser/ui/webauthn",
      "//components/cbor",
      "//components/device_event_log",
      "//components/pref_registry",
      "//components/prefs",
      "//components/signin/public/base:signin_buildflags",
      "//components/signin/public/base:signin_switches",
      "//components/user_prefs",
      "//components/vector_icons",
      "//components/webauthn/content/browser",
      "//components/webauthn/core/browser",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
      "//ui/base",
      "//ui/gfx",
    ]
  }

  if (is_mac) {
    sources += [ "chrome_authenticator_request_delegate_mac.mm" ]
  }

  if (is_win) {
    deps += [ ":local_credential_management" ]
  }

  if (is_chromeos) {
    deps += [
      "//ash",
      "//chromeos/components/webauthn",
    ]
  }
}

if (is_android) {
  source_set("webauthn_request_delegate_android") {
    public = [ "android/webauthn_request_delegate_android.h" ]

    public_deps = [
      ":webauthn",
      "//base",
      "//components/webauthn/android",
      "//content/public/browser",
      "//device/fido",
    ]
  }

  source_set("webauthn_request_delegate_android_impl") {
    sources = [
      "android/chrome_webauthn_client_android.cc",
      "android/webauthn_request_delegate_android.cc",
    ]

    public_deps = [
      ":webauthn_request_delegate_android",
      "//chrome/browser:browser_public_dependencies",
    ]

    deps = [
      ":webauthn",
      "//chrome/browser/profiles:profile",
      "//components/webauthn/android",
      "//components/webauthn/core/browser",
    ]
  }
}

source_set("chrome_web_authentication_delegate") {
  public = [ "chrome_web_authentication_delegate_base.h" ]
  sources = [ "chrome_web_authentication_delegate_base.cc" ]

  public_deps = [
    "//base",
    "//content/public/browser",
  ]

  deps = [
    ":webauthn",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//components/prefs",
    "//device/fido",
  ]

  if (is_win || is_mac || is_linux) {
    deps += [ "//chrome/browser/extensions/api/web_authentication_proxy" ]
  }

  if (!is_android) {
    public += [ "chrome_web_authentication_delegate.h" ]
    sources += [ "chrome_web_authentication_delegate.cc" ]

    deps += [
      "//components/device_event_log",
      "//components/webauthn/core/browser",
    ]

    if (is_chromeos) {
      deps += [ "//chromeos/components/webauthn" ]
    }
  }

  deps += [ "//chrome/browser/enterprise" ]
}

if (!is_android) {
  source_set("local_credential_management") {
    public = [ "local_credential_management.h" ]
    sources = [ "local_credential_management.cc" ]

    public_deps = [
      "//base",
      "//chrome/browser/profiles:profile",
      "//device/fido",
      "//third_party/icu",
    ]

    deps = [
      "//base:i18n",
      "//components/prefs",
      "//net",
    ]

    if (is_win) {
      public += [ "local_credential_management_win.h" ]
      sources += [ "local_credential_management_win.cc" ]
      deps += [
        "//components/pref_registry",
        "//components/user_prefs",
      ]
    }

    if (is_mac) {
      public += [ "local_credential_management_mac.h" ]
      sources += [ "local_credential_management_mac.cc" ]
      deps += [ ":chrome_web_authentication_delegate" ]
    }
  }

}

if (!is_android) {

  if (!is_chromeos_device) {
  }
}
