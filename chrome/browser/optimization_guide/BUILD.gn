assert(is_win || is_mac || is_linux || is_chromeos || is_android)

source_set("optimization_guide") {
  sources = [
    "chrome_browser_main_extra_parts_optimization_guide.h",
    "chrome_hints_manager.h",
    "model_execution/optimization_guide_global_state.h",
    "optimization_guide_global_state_holder_keyed_service.h",
    "optimization_guide_global_state_holder_keyed_service_factory.h",
    "optimization_guide_internals_ui.h",
    "optimization_guide_keyed_service.h",
    "optimization_guide_keyed_service_factory.h",
    "optimization_guide_tab_url_provider.h",
    "optimization_guide_web_contents_observer.h",
    "prediction/chrome_profile_download_service_tracker.h",
    "prediction/prediction_model_download_client.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser:main_extra_parts",
    "//chrome/browser/navigation_predictor",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//components/optimization_guide:optimization_guide_buildflags",
    "//components/optimization_guide/core",
    "//components/optimization_guide/core:prediction",
    "//components/optimization_guide/optimization_guide_internals/webui",
    "//components/services/unzip/content",
    "//components/signin/public/identity_manager",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/base",
    "//ui/webui",
  ]
  if (is_android) {
    public_deps += [
      "//chrome/browser/optimization_guide/android:jni_headers",
    ]
  }
}

source_set("impl") {
  sources = [
    "chrome_browser_main_extra_parts_optimization_guide.cc",
    "chrome_hints_manager.cc",
    "model_execution/optimization_guide_global_state.cc",
    "optimization_guide_global_state_holder_keyed_service.cc",
    "optimization_guide_global_state_holder_keyed_service_factory.cc",
    "optimization_guide_internals_ui.cc",
    "optimization_guide_keyed_service.cc",
    "optimization_guide_keyed_service_factory.cc",
    "optimization_guide_tab_url_provider.cc",
    "optimization_guide_web_contents_observer.cc",
    "prediction/chrome_profile_download_service_tracker.cc",
    "prediction/prediction_model_download_client.cc",
  ]
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    ":optimization_guide",
    "//chrome/browser:browser_process",
    "//chrome/browser:global_features",
    "//chrome/browser/download",
    "//chrome/browser/metrics",
    "//chrome/browser/preloading/prefetch/no_state_prefetch",
    "//chrome/browser/profiles",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/signin",
    "//components/component_updater/installer_policies:installer_policies_with_content_deps",
    "//components/metrics_services_manager",
    "//components/no_state_prefetch/browser",
    "//components/user_prefs",
    "//components/variations",
    "//components/variations/service",
    "//components/version_info",
    "//ui/webui",
  ]
  if (is_android) {
    deps += [
      "//base",
      "//chrome/browser/optimization_guide/android:jni_headers",
      "//chrome/browser/optimization_guide/android:native",
    ]
  } else {
    deps += [
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/tabs:tab_strip",
    ]
  }
}



