import("//components/enterprise/buildflags/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")

source_set("sdk_manager") {
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [
    "content_analysis_sdk_manager.cc",
    "content_analysis_sdk_manager.h",
  ]

  public_deps = [
    "//base",
    "//content/public/browser",
    "//third_party/content_analysis_sdk:liblcasdk",
  ]
}

if (is_chromeos) {
  source_set("obfuscation_rename_handler") {
    public = [ "obfuscation_rename_handler.h" ]

    sources = [ "obfuscation_rename_handler.cc" ]

    deps = [
      "//base",
      "//chrome/browser/ash/file_manager",
      "//components/enterprise/obfuscation/core:enterprise_obfuscation",
    ]
  }

  source_set("test_support") {
    testonly = true

    public = [
    ]

    sources = [
    ]

    public_deps = [
      "//base",
      "//chrome/browser/ash/file_manager",
      "//chrome/browser/ash/guest_os/public",
      "//chrome/browser/enterprise",
      "//chrome/browser/safe_browsing",
      "//chrome/browser/safe_browsing:test_support",
      "//chromeos/ash/components/disks",
      "//chromeos/ash/components/disks:test_support",
      "//components/enterprise/common/proto:connectors_proto",
      "//storage/browser",
      "//testing/gmock",
    ]

    deps = [
      "//base/test:test_support",
      "//chrome/test:test_support",
    ]
  }
}

