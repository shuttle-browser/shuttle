import("//components/enterprise/buildflags/buildflags.gni")
import("//components/safe_browsing/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")
import("//printing/buildflags/buildflags.gni")

source_set("enterprise") {
  public = [
    "browser_management/browser_management_service.h",
    "browser_management/browser_management_status_provider.h",
    "browser_management/management_service_factory.h",
    "identifiers/profile_id_delegate_impl.h",
    "identifiers/profile_id_service_factory.h",
    "util/affiliation.h",
    "util/managed_browser_utils.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser:main_extra_parts",
    "//chrome/browser/enterprise/browser_management:management_identity",
    "//chrome/browser/profiles",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/signin",
    "//components/enterprise",
    "//components/enterprise/browser/identifiers",
    "//components/enterprise/buildflags",
    "//components/enterprise/common:files_scan_data",
    "//components/enterprise/common/proto:connectors_proto",
    "//components/enterprise/common/proto:legacy_tech_events_proto",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/os_crypt/browser",
    "//components/policy/core/browser",
    "//components/policy/core/common",
    "//components/prefs",
    "//components/safe_browsing:buildflags",
    "//components/safe_browsing/core/browser:referrer_chain_provider",
    "//components/safe_browsing/core/browser/realtime:url_lookup_service_base",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/safe_browsing/core/common/proto:csd_proto",
    "//components/safe_browsing/core/common/proto:realtimeapi_proto",
    "//components/security_interstitials/content:security_interstitial_page",
    "//components/security_interstitials/core",
    "//components/security_interstitials/core:unsafe_resource",
    "//components/signin/public/base",
    "//components/signin/public/base:signin_buildflags",
    "//components/signin/public/identity_manager",
    "//components/url_matcher",
    "//content/public/browser",
    "//extensions/buildflags",
    "//services/data_decoder/public/cpp",
    "//ui/base/idle",
    "//url",
  ]

  if (safe_browsing_mode != 0) {
    public_deps += [
      "//components/safe_browsing/content/browser:safe_browsing_blocking_page",
    ]
  }

  # Circular deps: //chrome/browser/safe_browsing, //chrome/browser/extensions,
  # //chrome/browser/ui, //chrome/browser/ui/webui/signin, and
  # //chrome/browser/ash/policy/core all depend on :enterprise via
  # browser_public_dependencies. Unconditional includes from those targets are
  # handled via allow_circular_includes_from on the respective owning targets.
  # Conditional includes guarded by #if BUILDFLAG() use nogncheck.

  if (!is_android) {
    public_deps += [
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/tabs:tab_strip_model_observer",
      "//chrome/browser/upgrade_detector:build_state_observer",
      "//ui/message_center/public/cpp",
      "//ui/views",
    ]
  }

  if (is_chromeos) {
    public_deps += [
      "//chromeos/ash/components/kcer",
    ]

    public += [
      "connectors/device_trust/ash/ash_attestation_policy_observer.h",
      "connectors/device_trust/attestation/ash/flex_attester.h",
      "connectors/device_trust/signals/ash/ash_signals_filterer.h",
      "connectors/device_trust/signals/decorators/ash/ash_signals_decorator.h",
    ]
  }

  if (is_linux || is_win || is_mac) {
  }

  if (enable_extensions_core) {
    public_deps += [
      "//extensions/common",
      "//ui/message_center/public/cpp",
    ]
  }
}

