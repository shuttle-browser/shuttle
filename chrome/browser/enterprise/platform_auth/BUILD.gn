source_set("features") {
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [ "platform_auth_features.cc" ]

  public = [ "platform_auth_features.h" ]

  public_deps = [ "//base" ]
}

if (is_android) {
  import("//build/config/android/rules.gni")

  java_cpp_enum("entra_auth_enum_javagen") {
    sources = [ "entra_provider_android.h" ]
  }
}

if (!is_android) {
}

if (is_android) {
  source_set("android_browsertests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [
      "entra_sso_android_browsertest.cc",
    ]

    deps = [
      ":features",
      ":test_utils",
      "//base",
      "//chrome/android:chrome_jni_headers",
      "//chrome/browser/enterprise:impl",
      "//chrome/test:test_support",
      "//content/test:test_support",
      "//testing/gmock",
    ]
  }
}
