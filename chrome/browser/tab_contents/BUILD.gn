import("//extensions/buildflags/buildflags.gni")
source_set("tab_contents") {
  public = [
    "form_interaction_tab_helper.h",
    "navigation_metrics_recorder.h",
    "tab_util.h",
    "web_contents_collection.h",
  ]

  public_deps = [
    "//base",
    "//components/content_settings/core/browser:cookie_settings",
    "//content/public/browser",
    "//ui/base/unowned_user_data",
    "//url",
  ]
}

source_set("impl") {
  sources = [
    "form_interaction_tab_helper.cc",
    "navigation_metrics_recorder.cc",
    "tab_util.cc",
    "web_contents_collection.cc",
  ]

  deps = [
    ":tab_contents",
    "//chrome/browser:browser_process",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/browser/ui/webui:chrome_web_ui_controller_factory",
    "//components/navigation_metrics",
    "//components/performance_manager",
    "//components/profile_metrics",
    "//components/site_engagement/content",
    "//components/tabs:public",
    "//extensions/buildflags",
  ]

  if (enable_extensions) {
    deps += [ "//extensions/browser" ]
  }
}

if (!is_android) {
}
