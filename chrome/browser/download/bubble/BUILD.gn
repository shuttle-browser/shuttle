    "download_bubble_accessible_alerts_map.cc",
    "download_bubble_display_info.cc",
    "download_bubble_prefs.cc",
    "download_bubble_ui_controller.cc",
    "download_bubble_update_service.cc",
    "download_bubble_update_service_factory.cc",
    "download_bubble_utils.cc",
