# The download bubble UI is desktop-only.
assert(is_win || is_mac || is_linux)

source_set("bubble") {
  public = [
    "download_bubble_accessible_alerts_map.h",
    "download_bubble_display_info.h",
    "download_bubble_prefs.h",
    "download_bubble_ui_controller.h",
    "download_bubble_update_service.h",
    "download_bubble_update_service_factory.h",
    "download_bubble_utils.h",
    "download_display_controller.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/download",
    "//chrome/browser/metrics",
