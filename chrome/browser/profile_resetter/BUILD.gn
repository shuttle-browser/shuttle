import("//third_party/protobuf/proto_library.gni")

proto_library("profile_reset_report_proto") {
  sources = [ "profile_reset_report.proto" ]
}

if (!is_android) {
  source_set("profile_resetter") {
    sources = [
      "brandcode_config_fetcher.h",
      "brandcoded_default_settings.h",
      "profile_resetter.h",
      "reset_report_uploader.h",
      "reset_report_uploader_factory.h",
      "resettable_settings_snapshot.h",
      "triggered_profile_resetter.h",
      "triggered_profile_resetter_factory.h",
    ]

    public_deps = [
      "//base",
      "//build:chromeos_buildflags",
      "//chrome/browser/prefs:util",
      "//chrome/browser/profiles:profile",
      "//components/keyed_service/core",
      "//components/search_engines",
      "//content/public/browser",
      "//services/data_decoder/public/cpp",
      "//url",
    ]
  }

  source_set("impl") {
    public_deps = [ "//chrome/browser:browser_public_dependencies" ]

    sources = [
      "brandcode_config_fetcher.cc",
      "brandcoded_default_settings.cc",
      "profile_resetter.cc",
      "reset_report_uploader.cc",
      "reset_report_uploader_factory.cc",
      "resettable_settings_snapshot.cc",
      "triggered_profile_resetter.cc",
      "triggered_profile_resetter_factory.cc",
    ]

    deps = [
      ":profile_reset_report_proto",
      ":profile_resetter",
      "//base",
      "//build:branding_buildflags",
      "//build:chromeos_buildflags",
      "//chrome/app:branded_strings",
      "//chrome/app:generated_resources",
      "//chrome/browser:browser_process",
      "//chrome/browser/browsing_data:constants",
      "//chrome/browser/content_settings:content_settings_factory",
      "//chrome/browser/extensions",
      "//chrome/browser/file_system_access",
      "//chrome/browser/google",
      "//chrome/browser/prefs:util",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/search_engines",
      "//chrome/browser/ui",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/common:channel_info",
      "//chrome/common:constants",
      "//chrome/installer/util:constants",
      "//components/browsing_data/content",
      "//components/content_settings/core/browser",
      "//components/crx_file",
      "//components/embedder_support:user_agent",
      "//components/keyed_service/core",
      "//components/language/core/browser",
      "//components/pref_registry",
      "//components/prefs",
      "//components/proxy_config",
      "//components/search_engines",
      "//components/spellcheck/browser",
      "//components/strings",
      "//components/version_info",
      "//content/public/browser",
      "//crypto",
      "//extensions/browser",
      "//extensions/common",
      "//google_apis",
      "//net",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
      "//ui/base",
      "//url",
    ]

    if (is_win) {
      sources += [ "triggered_profile_resetter_win.cc" ]
      deps += [ "//chrome/installer/util:with_no_strings" ]
    } else {
      sources += [ "triggered_profile_resetter_stub.cc" ]
    }

    if (is_chromeos) {
      deps += [
        "//chrome/browser/ash/input_method",
        "//chromeos/ash/components/network",
      ]
    }
  }

}
