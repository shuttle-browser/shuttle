source_set("subscription_eligibility") {
  sources = [
    "subscription_eligibility_metrics_provider.h",
    "subscription_eligibility_service_factory.cc",
    "subscription_eligibility_service_factory.h",
  ]

  public_deps = [
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//components/keyed_service/core",
    "//components/metrics",
    "//components/subscription_eligibility",
  ]

  deps = [
    "//chrome/browser:browser_process",
    "//components/pref_registry",
    "//components/prefs",
    "//third_party/metrics_proto:metrics_proto_gen",
  ]

  if (is_android) {
    sources += [
      "android/subscription_eligibility_service_bridge.cc",
      "android/subscription_eligibility_service_bridge.h",
    ]
    deps += [ ":jni_headers" ]
  }
}

source_set("impl") {
  sources = [ "subscription_eligibility_metrics_provider.cc" ]

  public_deps = [ ":subscription_eligibility" ]

  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/metrics",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//components/metrics",
    "//components/subscription_eligibility",
    "//components/variations",
    "//third_party/metrics_proto:metrics_proto_gen",
  ]
}

if (!is_android) {
}

if (is_android) {
  import("//build/config/android/rules.gni")
  import("//third_party/jni_zero/jni_zero.gni")

  generate_jni("jni_headers") {
    sources = [ "android/java/src/org/chromium/chrome/browser/subscription_eligibility/SubscriptionEligibilityService.java" ]
  }

  android_library("java") {
    sources = [
      "android/java/src/org/chromium/chrome/browser/subscription_eligibility/SubscriptionEligibilityService.java",
      "android/java/src/org/chromium/chrome/browser/subscription_eligibility/SubscriptionEligibilityServiceFactory.java",
    ]
    deps = [
      "//base:base_java",
      "//build/android:build_java",
      "//chrome/browser/profiles/android:java",
      "//third_party/jni_zero:jni_zero_java",
    ]
    srcjar_deps = [ ":jni_headers" ]
  }
}
