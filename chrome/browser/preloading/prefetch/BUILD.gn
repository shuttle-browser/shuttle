import("//build/config/features.gni")
import("//extensions/buildflags/buildflags.gni")

source_set("prefetch") {
  public = [ "chrome_prefetch_manager.h" ]

  public_deps = [
    "//base",
    "//content/public/browser",
  ]
}

source_set("impl") {
  sources = [ "chrome_prefetch_manager.cc" ]

  deps = [
    ":prefetch",
    "//chrome/browser/preloading",
  ]

  if (is_android) {
    deps += [ "//chrome/browser/flags:flags_android" ]
  }
}

if (!is_android) {
  source_set("zero_suggest_prefetch") {
    public = [ "zero_suggest_prefetch/zero_suggest_prefetch_tab_helper.h" ]
    sources = [ "zero_suggest_prefetch/zero_suggest_prefetch_tab_helper.cc" ]

    public_deps = [
      "//chrome/browser/ui/tabs:tab_strip_model_observer",
      "//content/public/browser",
    ]

    deps = [
      "//base",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/omnibox",
      "//chrome/browser/ui/search",
      "//chrome/browser/ui/tabs:tab_strip",
      "//components/omnibox/browser",
      "//components/omnibox/common",
    ]
  }

}
