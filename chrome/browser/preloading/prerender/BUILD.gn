import("//extensions/buildflags/buildflags.gni")

source_set("prerender") {
  public = [
    "dse_prewarm_navigation_throttle.h",
    "prerender_manager.h",
    "prerender_utils.h",
    "prerender_web_contents_delegate.h",
    "search_preload_progress_service.h",
    "search_preload_progress_service_factory.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/preloading",
    "//chrome/browser/profiles:profile",
    "//components/omnibox/browser",
    "//content/public/browser",
    "//url",
  ]
}

source_set("impl") {
  sources = [
    "dse_prewarm_navigation_throttle.cc",
    "prerender_manager.cc",
    "prerender_utils.cc",
    "prerender_web_contents_delegate.cc",
    "search_preload_progress_service.cc",
    "search_preload_progress_service_factory.cc",
  ]

  deps = [
    ":prerender",
    "//chrome/browser:after_startup_task_utils",
    "//chrome/browser:browser_features",
    "//chrome/browser:chrome_content_browser_client",
    "//chrome/browser/content_settings",
    "//chrome/browser/headless",
    "//chrome/browser/page_load_metrics",
    "//chrome/browser/preloading",
    "//chrome/browser/preloading/prefetch/search_prefetch",
    "//chrome/browser/preloading/prefetch/search_prefetch:field_trial_settings",
    "//chrome/browser/search_engines",
    "//chrome/browser/subresource_filter",
    "//chrome/browser/task_manager",
    "//chrome/browser/ui:tab_helpers",
    "//chrome/browser/ui/browser_window",
    "//chrome/common:chrome_features",
    "//components/content_settings/browser",
    "//components/optimization_guide/core:features",
    "//components/page_load_metrics/browser",
    "//components/page_load_metrics/google/browser",
    "//components/tabs:impl",
    "//extensions/buildflags",
  ]

  if (enable_extensions_core) {
    deps += [
      "//chrome/browser/extensions",
      "//chrome/browser/extensions/api/web_navigation",
      "//extensions/browser",
      "//extensions/common:mojom",
    ]
  }

  if (is_chromeos) {
    deps += [ "//chromeos/components/kiosk" ]
  }

  if (!is_android) {
  }
}

if (!is_android) {
}
