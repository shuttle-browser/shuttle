import("//chrome/common/features.gni")

assert(is_win || is_mac || is_linux || is_chromeos || is_android)

# The window occlusion logic is currently for desktop only, and the
# WebContentsObserver-based implementation does not work on Linux
# since it depends on aura::WindowOcclusionTracker which is not
# supported on Linux.
use_web_contents_occlusion_helper = is_win || is_chromeos || is_mac
use_widget_occlusion_helper = is_linux
use_stub_occlusion_helper = is_android

source_set("picture_in_picture") {
  sources = [
    "picture_in_picture_bounds_cache.h",
    "picture_in_picture_window_manager.h",
    "video_overlay_window.h",

    # Common Auto Picture-in-Picture files
    "auto_picture_in_picture_safe_browsing_checker_client.h",
    "auto_picture_in_picture_tab_helper.h",
    "auto_picture_in_picture_tab_observer_helper_base.h",
    "auto_picture_in_picture_window_occlusion_helper_base.h",
    "auto_pip_setting_helper.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/safe_browsing/core/browser/db:database_manager",
    "//components/safe_browsing/core/browser/db:sb_protocol_manager_util",
    "//components/safe_browsing/core/browser/db:util",
    "//content/public/browser",
    "//third_party/blink/public/common",
    "//ui/gfx/geometry",
    "//url",
  ]

  if (is_mac || is_win || is_linux || is_chromeos) {
  }
  if (!is_android) {
    sources += [
      "auto_picture_in_picture_tab_strip_observer_helper.h",
      "auto_pip_setting_overlay_view.h",
      "auto_pip_setting_view.h",
      "picture_in_picture_input_protector.h",
      "picture_in_picture_occlusion_observer.h",
      "picture_in_picture_occlusion_tracker.h",
      "picture_in_picture_occlusion_tracker_observer.h",
      "picture_in_picture_widget_fade_animator.h",
      "picture_in_picture_window.h",
      "picture_in_picture_window_manager_uma_helper.h",
      "scoped_disallow_picture_in_picture.h",
      "scoped_picture_in_picture_occlusion_observation.h",
      "scoped_tuck_picture_in_picture.h",
    ]
    public_deps += [
      "//chrome/browser/ui/tabs:tab_strip_model_observer",
      "//ui/views",
    ]
  } else {  # is_android
    sources += [ "auto_picture_in_picture_tab_model_observer_helper.h" ]
    public_deps += [
      "//chrome/browser/ui/android/tab_model",
    ]
  }

  if (use_web_contents_occlusion_helper) {
    sources +=
        [ "auto_picture_in_picture_window_occlusion_helper_web_contents.h" ]
  }
  if (use_widget_occlusion_helper) {
    sources += [ "auto_picture_in_picture_window_occlusion_helper_widget.h" ]
    public_deps += [ "//chrome/browser/ui/browser_window" ]
  }
}

source_set("impl") {
  sources = [
    "picture_in_picture_bounds_cache.cc",
    "picture_in_picture_window_manager.cc",

    # Common Auto Picture-in-Picture files
    "auto_picture_in_picture_safe_browsing_checker_client.cc",
    "auto_picture_in_picture_tab_helper.cc",
    "auto_picture_in_picture_tab_observer_helper_base.cc",
    "auto_picture_in_picture_window_occlusion_helper_base.cc",
    "auto_pip_setting_helper.cc",
  ]

  deps = [
    ":picture_in_picture",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/permissions",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/safe_browsing",
    "//chrome/browser/ui:recently_audible_helper",
    "//chrome/browser/ui/navigator",
    "//components/content_settings/browser",
    "//components/content_settings/core/browser",
    "//components/permissions",
    "//components/safe_browsing/core/browser/db:v5_get_hash_protocol_manager",
    "//content/public/browser",
    "//content/public/common",
    "//extensions/buildflags",
    "//media",
    "//services/metrics/public/cpp:ukm_builders",
    "//ui/display",
    "//ui/gfx/geometry",
  ]

  if (enable_extensions_core) {
    deps += [ "//extensions/common:common_constants" ]
  }

  if (is_android) {
    sources += [
      "auto_picture_in_picture_permission_controller_bridge.cc",
      "auto_picture_in_picture_tab_model_observer_helper.cc",
      "document_picture_in_picture_bridge_android.cc",
      "picture_in_picture_bounds_cache_bridge.cc",
      "picture_in_picture_window_manager_bridge.cc",
    ]
    deps += [
      "//chrome/browser/ui/android/overlay",
      "//components/strings:components_strings",
    ]
  } else {
    sources += [
      "auto_picture_in_picture_tab_strip_observer_helper.cc",
      "auto_pip_setting_overlay_view.cc",
      "auto_pip_setting_view.cc",
      "picture_in_picture_input_protector.cc",
      "picture_in_picture_occlusion_observer.cc",
      "picture_in_picture_occlusion_tracker.cc",
      "picture_in_picture_occlusion_tracker_observer.cc",
      "picture_in_picture_widget_fade_animator.cc",
      "picture_in_picture_window_manager_uma_helper.cc",
      "scoped_disallow_picture_in_picture.cc",
      "scoped_picture_in_picture_occlusion_observation.cc",
      "scoped_tuck_picture_in_picture.cc",
    ]
    deps += [
      "//chrome/app:generated_resources",
      "//chrome/browser/ui:browser_tab_strip",
      "//chrome/browser/ui/color:color_headers",
      "//chrome/browser/ui/views/picture_in_picture",
      "//components/strings:components_strings",
      "//components/unified_consent",
      "//components/url_formatter",
      "//net",
      "//third_party/blink/public/common:headers",
      "//ui/views",
    ]
  }

  if (use_web_contents_occlusion_helper) {
    sources +=
        [ "auto_picture_in_picture_window_occlusion_helper_web_contents.cc" ]
  }
  if (use_widget_occlusion_helper) {
    deps += [ "//chrome/browser/ui:browser_window_header" ]
    sources += [ "auto_picture_in_picture_window_occlusion_helper_widget.cc" ]
  }
  if (use_stub_occlusion_helper) {
    sources += [ "auto_picture_in_picture_window_occlusion_helper_stub.cc" ]
  }

  if (use_ozone) {
    deps += [ "//ui/ozone" ]
  }

  if (!is_android) {
    deps += [
      "//chrome/browser/ui:browser_tab_strip_tracker",
      "//chrome/browser/ui/views/frame:browser_view_header",
    ]
  }
}

if (!is_android) {

}
