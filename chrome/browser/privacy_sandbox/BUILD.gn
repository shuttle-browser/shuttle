import("//build/config/chromeos/args.gni")

assert(!is_ios)

source_set("headers") {
  public = [
    "privacy_sandbox_policy_handler.h",
    "privacy_sandbox_service.h",
    "privacy_sandbox_service_factory.h",
    "privacy_sandbox_service_impl.h",
    "privacy_sandbox_settings_factory.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/first_party_sets",
    "//chrome/browser/profiles:profile",
    "//components/content_settings/core/browser",
    "//components/keyed_service/core",
    "//components/policy/core/browser",
    "//components/prefs",
    "//components/privacy_sandbox",
    "//components/privacy_sandbox:privacy_sandbox_prefs",
    "//components/profile_metrics",
    "//content/public/browser",
    "//net",
  ]
}

source_set("impl") {
  sources = [
    "privacy_sandbox_policy_handler.cc",
    "privacy_sandbox_service_factory.cc",
    "privacy_sandbox_service_impl.cc",
    "privacy_sandbox_settings_factory.cc",
  ]

  public_deps = [
    ":headers",
    "//chrome/browser:browser_public_dependencies",
  ]

  deps = [
    "//chrome/browser:browser_process",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/signin",
    "//components/content_settings/core/browser:cookie_settings",
    "//components/content_settings/core/common",
    "//components/google/core/common",
    "//components/metrics:metrics_pref_names",
    "//components/policy:generated",
    "//components/policy/core/common",
    "//components/privacy_sandbox:features",
    "//components/signin/public/identity_manager",
    "//components/strings:components_strings",
    "//components/url_formatter",
    "//third_party/blink/public/common:headers",
    "//ui/base",
    "//url",
  ]

  if (is_android) {
    sources += [ "android/privacy_sandbox_bridge.cc" ]
    deps += [ "android:jni_headers" ]
  }

  if (is_chromeos) {
    deps += [
      "//chrome/browser/profiles",
      "//chromeos/ash/components/browser_context_helper",
      "//chromeos/components/kiosk",
      "//chromeos/components/mgs",
    ]
  }
}

if (!is_android) {
} else {
}

if (!is_android) {
}

