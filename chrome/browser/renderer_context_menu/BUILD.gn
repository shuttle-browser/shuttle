import("//components/spellcheck/spellcheck_build_features.gni")
import("//extensions/buildflags/buildflags.gni")
import("//pdf/features.gni")
import("//printing/buildflags/buildflags.gni")

# The bubble model headers only need the small confirm_bubble_model target
# rather than all of //chrome/browser/ui, so they live in their own target
# that can be depended on without forming a cycle through
# //chrome/browser/ui:ui (e.g. from //chrome/browser/ui/webui/settings).
source_set("bubble_models") {
  if (!is_android) {
    public = [
      "accessibility_labels_bubble_model.h",
      "spelling_bubble_model.h",
    ]

    public_deps = [
      "//base",
      "//chrome/browser/ui:confirm_bubble_model",
      "//ui/base/mojom",
      "//url",
    ]
  }
}

source_set("renderer_context_menu") {
  if (!is_android) {
    if (is_mac) {
      allow_circular_includes_from = [ "//chrome/browser/ui/cocoa" ]
    }

    public = [ "render_view_context_menu.h" ]

    public_deps = [
      ":bubble_models",
      "//base",
      "//chrome/app:command_ids",
      "//chrome/common:mojo_bindings",
      "//components/compose:buildflags",
      "//components/custom_handlers",
      "//components/lens:buildflags",
      "//components/renderer_context_menu",
      "//components/supervised_user/core/browser",
      "//content/public/browser",
      "//content/public/common:buildflags",
      "//extensions/buildflags",
      "//mojo/public/cpp/bindings",
      "//printing/buildflags",
      "//ui/base",
      "//ui/base/interaction",
      "//ui/gfx",
      "//ui/menus",
      "//url",
    ]

    if (is_mac) {
      public_deps += [ "//chrome/browser/ui/cocoa" ]
    }

    if (is_chromeos) {
      public_deps += [ "//chromeos/ui/clipboard_history" ]
    }

    if (enable_extensions) {
      public_deps += [ "//chrome/browser/extensions" ]
    }
  }
}

source_set("impl") {
  friend = [ ":unit_tests" ]
  public = [ "context_menu_content_type_factory.h" ]
  sources = [ "context_menu_content_type_factory.cc" ]

  deps = [
    ":renderer_context_menu",
    "//base",
    "//base:i18n",
    "//chrome/browser/app_mode",
    "//chrome/browser/ui",
    "//chrome/common",
    "//components/language/core/browser",
    "//components/renderer_context_menu",
    "//content/public/browser",
    "//extensions/buildflags",
  ]

  if (!is_android) {
    public += [
      "accessibility_labels_menu_observer.h",
      "link_to_text_menu_observer.h",
      "spelling_menu_observer.h",
    ]

    sources += [
      "accessibility_labels_bubble_model.cc",
      "accessibility_labels_menu_observer.cc",
      "context_menu_content_type_read_anything.cc",
      "context_menu_content_type_read_anything.h",
      "link_to_text_menu_observer.cc",
      "render_view_context_menu.cc",
