import("//ui/webui/webui_features.gni")

assert(enable_webui_history)

source_set("history") {
  deps = [ "//chrome/browser/ui/tabs:tab_strip" ]

  if (is_android) {
    sources = [ "history_ui_android.cc" ]
    public = [ "history_ui_android.h" ]
    deps += [
      "//base",
      "//components/resources:components_scaled_resources",
      "//ui/base",
    ]
  } else {
    sources = [
      "browsing_history_handler.cc",
      "history_ui.cc",
      "navigation_handler.cc",
    ]
    public = [
      "browsing_history_handler.h",
      "history_ui.h",
      "navigation_handler.h",
    ]
    deps += [
      "//base",
      "//chrome/app:generated_resources",
      "//chrome/browser/content_settings:content_settings_factory",
      "//chrome/browser/favicon",
      "//chrome/browser/history",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/resources/history:resources",
      "//chrome/browser/sessions",
      "//chrome/browser/ui:browser_element_identifiers",
      "//chrome/browser/ui:chrome_pages",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui:url_identity",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/webui:favicon_source",
      "//chrome/browser/ui/webui:managed_ui_handler",
      "//chrome/browser/ui/webui:metrics_handler",
      "//chrome/browser/ui/webui:theme_source",
      "//chrome/browser/ui/webui:webui_util",
      "//chrome/browser/ui/webui/cr_components/history",
      "//chrome/browser/ui/webui/ntp",
      "//chrome/browser/ui/webui/top_chrome",
      "//chrome/common",
      "//components/favicon_base",
      "//components/history/core/browser",
      "//components/keyed_service/core",
      "//components/pref_registry",
      "//components/prefs",
      "//components/query_parser",
      "//components/sessions",
      "//components/strings:components_strings",
      "//content/public/browser",
      "//mojo/public/cpp/bindings",
      "//net",
      "//ui/base",
      "//ui/webui",
      "//ui/webui/resources/cr_components/history:mojo_bindings",
      "//ui/webui/tracked_element",
      "//url",
    ]
  }
}

if (!is_android) {
}
