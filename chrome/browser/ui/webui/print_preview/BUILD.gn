import("//build/config/ui.gni")
import("//chrome/common/features.gni")
import("//extensions/buildflags/buildflags.gni")
import("//pdf/features.gni")
import("//printing/buildflags/buildflags.gni")

assert(enable_print_preview)

# Header-only target exposing the print_preview public API. This is kept
# separate from ":impl" so that //chrome/browser/printing:impl can include
# print_preview headers (e.g. print_preview_ui.h, printer_handler.h) without
# forming a dependency cycle with ":impl" (which depends on printing:impl).
source_set("print_preview") {
  public = [
    "extension_printer_handler.h",
    "parse_data_path.h",
    "pdf_printer_handler.h",
    "policy_settings.h",
    "print_preview_handler.h",
    "print_preview_metrics.h",
    "print_preview_ui.h",
    "print_preview_ui_untrusted.h",
    "print_preview_utils.h",
    "printer_handler.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/printing",
    "//chrome/browser/ui/webui",
    "//chrome/services/printing/public/mojom",
    "//components/printing/common:mojo_interfaces",
    "//components/services/print_compositor/public/mojom",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/common",
    "//mojo/public/cpp/bindings",
    "//printing/buildflags",
    "//printing/mojom",
    "//services/device/public/mojom:usb",
    "//ui/gfx/geometry",
    "//ui/webui",
  ]

  if (is_chromeos) {
    public += [
      "local_printer_handler_chromeos.h",
      "print_preview_handler_chromeos.h",
    ]
    public_deps += [
      "//chrome/browser/ash/printing",
      "//chromeos/printing",
    ]
  } else {
    public += [ "local_printer_handler_default.h" ]
  }
}

source_set("impl") {
  sources = [
    "extension_printer_handler.cc",
    "parse_data_path.cc",
    "pdf_printer_handler.cc",
    "policy_settings.cc",
    "print_preview_handler.cc",
    "print_preview_metrics.cc",
    "print_preview_ui.cc",
    "print_preview_ui_untrusted.cc",
    "print_preview_utils.cc",
    "printer_handler.cc",
  ]
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    ":print_preview",
    "//base",
    "//chrome/app:generated_resources",
    "//chrome/browser:bad_message",
    "//chrome/browser:browser_process",
    "//chrome/browser:primitives",
    "//chrome/browser/app_mode",
    "//chrome/browser/download",
    "//chrome/browser/enterprise",
    "//chrome/browser/pdf:pdf_pref_names",
    "//chrome/browser/printing",
    "//chrome/browser/printing:impl",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/select_file_policy",
    "//chrome/browser/ui/webui",
    "//chrome/browser/ui/webui:managed_ui_handler",
    "//chrome/browser/ui/webui:metrics_handler",
    "//chrome/browser/ui/webui:plural_string_handler",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/common",
    "//chrome/common:constants",
    "//chrome/common/printing",
    "//chrome/services/printing/public/mojom",
    "//components/cloud_devices/common",
    "//components/crash/core/common",
    "//components/device_event_log",
    "//components/download/public/common:public",
    "//components/drive",
    "//components/enterprise/buildflags",
    "//components/pdf/common:constants",
    "//components/policy/core/common",
    "//components/pref_registry",
    "//components/prefs",
    "//components/printing/browser",
    "//components/printing/common",
    "//components/printing/common:mojo_interfaces",
    "//components/services/print_compositor/public/mojom",
    "//components/strings:components_strings",
    "//components/url_formatter",
    "//content/public/browser",
    "//content/public/common",
    "//extensions/browser",
    "//extensions/common",
    "//net",
    "//printing",
    "//printing/backend",
    "//printing/buildflags",
    "//printing/mojom",
    "//services/device/public/cpp/usb",
    "//services/device/public/mojom:usb",
    "//services/network/public/mojom",
    "//ui/base",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/shell_dialogs",
    "//ui/web_dialogs",
    "//ui/webui",
  ]

  if (enable_pdf) {
    deps += [
      "//chrome/browser/pdf",
      "//pdf:features",
    ]
  }

  if (use_aura) {
    deps += [ "//ui/aura" ]
  }

  if (is_chromeos) {
    sources += [
      "local_printer_handler_chromeos.cc",
      "print_preview_handler_chromeos.cc",
    ]
    deps += [
      "//ash/constants",
      "//chrome/browser:browser_process_platform_part",
      "//chrome/browser/ash/drive",
      "//chrome/browser/ash/printing",
      "//chrome/browser/ash/profiles",
      "//chrome/browser/resources/ash/print_preview:resources",
      "//chrome/browser/ui/ash/holding_space",
      "//chromeos/ash/components/browser_context_helper",
      "//chromeos/ash/experiences/settings_ui",
      "//chromeos/printing",
      "//components/session_manager/core",
      "//components/signin/public/identity_manager",
      "//components/user_manager",
    ]
  } else {
    sources += [ "local_printer_handler_default.cc" ]
    deps += [ "//chrome/browser/resources/print_preview:resources" ]
  }
}

