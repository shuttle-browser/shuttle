# chrome://agents: the user's view of the agents (profiles), their sessions
# and tabs.

assert(!is_android)

source_set("agents") {
  sources = [
    "agents_ui.cc",
    "agents_ui.h",
  ]
  public_deps = [ "//content/public/browser" ]
  deps = [
    "//base",
    "//chrome/browser/agent_chrome",
    "//chrome/browser/agent_chrome:impl",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/agents:resources",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/common",
    "//services/network/public/mojom",
    "//ui/webui",
    "//url",
  ]
}
