import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  public_deps = [
    "//components/content_settings/core/common:mojo_bindings",
    "//mojo/public/mojom/base",
  ]

  deps = [ "//components/content_settings/core/common:content_settings_types" ]

  sources = [ "content_settings_internals.mojom" ]
  webui_module_path = "/"
}

source_set("content_settings") {
  sources = [
    "content_settings_handler.cc",
    "content_settings_handler.h",
    "content_settings_ui.cc",
    "content_settings_ui.h",
  ]

  public_deps = [
    ":mojo_bindings",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
  ]

  deps = [
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/resources/content_settings:resources",
    "//ui/base",
  ]
}

if (!is_android) {
}
