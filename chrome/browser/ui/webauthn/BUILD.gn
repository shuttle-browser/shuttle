import("//build/config/ui.gni")

source_set("webauthn") {
  sources = [ "authenticator_request_dialog_view_controller.h" ]
  public_deps = []

  if (toolkit_views) {
    sources += [
      "account_hover_list_model.h",
      "authenticator_request_sheet_model.h",
      "hover_list_model.h",
      "sheet_models.h",
      "transport_hover_list_model.h",
      "user_actions.h",
      "webauthn_ui_helpers.h",
    ]
    public_deps += [
      "//base",
      "//chrome/browser/webauthn",
      "//content/public/browser",
      "//device/fido",
      "//ui/base",
      "//ui/views",
    ]

    allow_circular_includes_from = [ "//chrome/browser/webauthn" ]
  }
}

source_set("impl") {
  if (toolkit_views) {
    sources = [
      "account_hover_list_model.cc",
      "authenticator_request_sheet_model.cc",
      "sheet_models.cc",
      "transport_hover_list_model.cc",
      "user_actions.cc",
      "webauthn_ui_helpers.cc",
    ]
    deps = [
      ":webauthn",
      "//base",
      "//chrome/app:generated_resources",
      "//chrome/app/vector_icons",
      "//chrome/browser:resources",
      "//chrome/browser:resources_grit",
      "//chrome/browser/net",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/profiles:profile_util",
      "//chrome/browser/ui:browser_actions",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/browser_window:create_browser_window",
      "//chrome/browser/ui/tabs:tab_enums",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/views/frame:toolbar_button_provider",
      "//chrome/browser/ui/views/page_action",
      "//chrome/browser/webauthn",
      "//components/device_event_log",
      "//components/keyed_service/core",
      "//components/password_manager/core/common",
      "//components/signin/public/identity_manager",
      "//components/strings:components_strings",
      "//components/url_formatter",
      "//components/vector_icons",
      "//content/public/browser",
      "//device/fido",
      "//google_apis",
      "//net",
      "//ui/base",
      "//ui/color:color_headers",
      "//ui/gfx",
      "//ui/gfx/geometry",
      "//url",
    ]
    public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  }
}

