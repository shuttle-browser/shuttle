import("//build/config/chromeos/args.gni")

if (!is_android) {
  source_set("thumbnails") {
    sources = [
      "background_thumbnail_capturer.h",
      "background_thumbnail_video_capturer.cc",
      "background_thumbnail_video_capturer.h",
      "thumbnail_capture_driver.cc",
      "thumbnail_capture_driver.h",
      "thumbnail_capture_info.h",
      "thumbnail_image.cc",
      "thumbnail_image.h",
      "thumbnail_readiness_tracker.cc",
      "thumbnail_readiness_tracker.h",
      "thumbnail_scheduler.h",
      "thumbnail_scheduler_impl.cc",
      "thumbnail_scheduler_impl.h",
      "thumbnail_tab_helper.cc",
      "thumbnail_tab_helper.h",
      "thumbnail_tracker.cc",
      "thumbnail_tracker.h",
    ]

    public_deps = [
      "//base",
      "//components/viz/host",
      "//content/public/browser",
      "//skia",
      "//ui/base/unowned_user_data",
      "//ui/gfx",
      "//ui/gfx/geometry",
    ]

    deps = [
      "//chrome/browser/ui/tabs",
      "//components/tabs:public",
      "//media/capture/mojom:video_capture_buffer",
      "//ui/gfx/codec",
      "//ui/gfx/geometry:geometry_skia",
      "//ui/native_theme",
    ]
  }

  if (!is_chromeos_device) {
  }

}
