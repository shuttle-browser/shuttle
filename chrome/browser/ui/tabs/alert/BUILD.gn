assert(is_win || is_mac || is_linux || is_chromeos || is_android)

import("//chrome/common/features.gni")

source_set("tab_alert") {
  public = [
    "child_tab_alert_helper.h",
    "tab_alert_controller.h",
    "tab_alert_icon.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/contextual_tasks",
    "//chrome/browser/ui/tabs:tabs_public",
    "//chrome/browser/vr",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    "//chrome/browser/media/webrtc",
    "//chrome/browser/ui/color:color_headers",
  ]
}

source_set("impl") {
  sources = [
    "child_tab_alert_helper.cc",
    "tab_alert_controller.cc",
    "tab_alert_icon.cc",
  ]

  deps = [
    ":tab_alert",
    "//chrome/app/vector_icons",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/ui:layout_constants",
    "//chrome/browser/ui:recently_audible_helper",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/common:chrome_features",
    "//components/contextual_tasks/public:feature_list",
    "//components/tabs:public",
    "//components/vector_icons",
  ]
}

