source_set("desktop_tab_drag_impl") {
  sources = [
    "tab_drag_session_desktop_injector.cc",
    "tab_drag_session_desktop_injector.h",
    "tab_drag_session_input_adapter_factory.cc",
    "tab_drag_session_input_adapter_factory.h",
    "tab_drag_window_adapter_impl.cc",
    "tab_drag_window_adapter_impl.h",
  ]

  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser:global_features",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/tabs:tab_model",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/browser_apis/tab_drag",
    "//components/browser_apis/tab_drag/adapters",
    "//components/browser_apis/tab_drag/sessions",
    "//components/browser_apis/tab_strip/types",
    "//components/tabs:impl",
    "//ui/base",
    "//ui/display",
    "//ui/events",
    "//ui/views",
  ]

  if (is_mac) {
    sources += [
      "tab_drag_session_input_adapter_mac.h",
      "tab_drag_session_input_adapter_mac.mm",
    ]
    deps += [ "//components/remote_cocoa/app_shim" ]
  } else {
    sources += [
      "tab_drag_session_input_adapter_aura.cc",
      "tab_drag_session_input_adapter_aura.h",
    ]
    deps += [ "//ui/aura" ]
    deps += [ "//ui/gfx" ]
  }
}

