import("//build/config/ui.gni")
import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions_core)

source_set("extension_enable_flow_delegate") {
  sources = [ "extension_enable_flow_delegate.h" ]
}

source_set("extension_popup_types") {
  sources = [ "extension_popup_types.h" ]
  public_deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

source_set("extensions_menu_handler") {
  sources = [ "extensions_menu_handler.h" ]
  deps = [
    "//extensions/browser",
    "//extensions/common",
  ]
}

source_set("extensions") {
  sources = [
    "confirm_protocol_handler_dialog.h",
    "controlled_home_dialog.h",
    "controlled_home_dialog_controller.h",
    "controlled_home_dialog_controller_interface.h",
    "download_danger_dialog.h",
    "download_open_dialog.h",
    "extension_action_view_model.h",
    "extension_dialog_utils.h",
    "extension_install_ask_parent_dialog.h",
    "extension_install_blocked_dialog.h",
    "extension_install_friction_dialog.h",
    "extension_install_ui.h",
    "extension_installed_watcher.h",
    "extension_multiple_uninstall_dialog.h",
    "extension_post_install_dialog.h",
    "extension_post_install_dialog_model.h",
    "extension_settings_overridden_dialog.h",
    "extensions_container.h",
    "extensions_menu_view_model.h",
    "extensions_overrides/simple_overrides.h",
    "extensions_toolbar_view_model.h",
    "icon_with_badge_image_source.h",
    "reload_page_dialog_controller.h",
    "search_override_stack.h",
    "settings_api_bubble_helpers.h",
    "settings_overridden_dialog.h",
    "settings_overridden_dialog_controller.h",
    "settings_overridden_params_providers.h",
  ]

  public_deps = []

  if (is_android) {
    sources += [ "extension_install_ui_android.h" ]
    public_deps += [ "//components/messages/android" ]
  }

  if (is_win || is_mac || is_linux || is_chromeos) {
    sources += [ "extension_install_ui_desktop.h" ]
  }
  public_deps += [
    ":extension_popup_types",
    "//base",
    "//chrome/browser/download",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/toolbar",
    "//components/omnibox/browser",
    "//extensions/browser",
    "//extensions/common",
    "//skia",
    "//ui/base:types",
    "//ui/base/interaction",
    "//ui/base/mojom:ui_base_types",
    "//ui/base/unowned_user_data",
    "//ui/gfx",
    "//ui/gfx/geometry",
  ]

  if (enable_extensions) {
    sources += [
      "accelerator_priority.h",
      "extension_action_delegate.h",
      "extension_enable_flow.h",
      "installation_error_infobar_delegate.h",
      "web_file_handlers/multiclient_util.h",
    ]

    public_deps += [
      "//base",
      "//chrome/browser/ui/tabs:tab_strip_model_observer",
      "//chrome/browser/ui/toolbar",
      "//components/infobars/core",
      "//components/omnibox/browser",
      "//components/services/app_service",
      "//components/services/app_service/public/cpp:app_types",
      "//extensions/browser",
      "//extensions/browser/install",
      "//extensions/buildflags",
      "//extensions/common",
      "//skia",
      "//ui/base",
      "//ui/base:types",
      "//ui/base/mojom:ui_base_types",
      "//ui/gfx",
      "//ui/gfx/geometry",
      "//url",
    ]
  }
}

source_set("extension_post_install_dialog") {
  sources = [
    "extension_post_install_dialog.cc",
    "extension_post_install_dialog.h",
  ]
  public_deps = [ ":extensions" ]
  deps = [
    "//base:i18n",
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//ui/base",
    "//ui/strings",
  ]
  if (is_android) {
    deps += [ "//components/prefs" ]
  }
}

source_set("impl") {
  sources = [
    "controlled_home_dialog.cc",
    "controlled_home_dialog_controller.cc",
    "download_danger_dialog.cc",
    "download_open_dialog.cc",
    "extension_action_delegate.cc",
    "extension_action_view_model.cc",
    "extension_install_ask_parent_dialog.cc",
    "extension_install_blocked_dialog.cc",
    "extension_install_friction_dialog.cc",
    "extension_install_ui.cc",
    "extension_installed_watcher.cc",
    "extension_multiple_uninstall_dialog.cc",
    "extension_post_install_dialog_model.cc",
    "extension_settings_overridden_dialog.cc",
    "extension_uninstall_dialog_impl.cc",
    "extensions_container.cc",
    "extensions_menu_view_model.cc",
    "extensions_overrides/simple_overrides.cc",
    "extensions_toolbar_view_model.cc",
    "icon_with_badge_image_source.cc",
    "reload_page_dialog_controller.cc",
    "search_override_stack.cc",
    "settings_api_bubble_helpers.cc",
    "settings_overridden_dialog.cc",
    "settings_overridden_dialog_controller.cc",
    "settings_overridden_params_providers.cc",
  ]
  deps = [
    ":extension_post_install_dialog",
    ":extensions",
    "//chrome/browser/extensions",
    "//chrome/browser/favicon",
    "//chrome/browser/image_fetcher",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/safe_browsing:advanced_protection",
    "//chrome/browser/search_engines",
    "//chrome/browser/signin",
    "//chrome/browser/supervised_user",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui:simple_message_box_headers",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/dialogs",
    "//chrome/browser/ui/toolbar",
    "//components/google/core/common",
    "//components/image_fetcher/core",
    "//components/search_engines",
    "//components/sessions",
    "//components/tabs:public",
    "//components/url_formatter",
    "//components/vector_icons",
    "//extensions/common",
    "//ui/strings",
  ]

  if (is_win || is_mac || is_linux || is_chromeos) {
    sources += [ "extension_install_ui_desktop.cc" ]
    deps += [
      "//chrome/app:generated_resources",
      "//chrome/browser/prefs",
      "//chrome/browser/themes",
      "//chrome/browser/ui:browser_commands",
      "//chrome/browser/ui:browser_window_header",
      "//chrome/browser/ui:scoped_tabbed_browser_displayer",
      "//chrome/browser/ui:singleton_tabs",
      "//chrome/browser/ui/navigator",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/views/toolbar",
      "//chrome/browser/ui/webui/extensions",
      "//chrome/common",
      "//components/custom_handlers",
      "//components/infobars/content",
      "//content/public/browser",
      "//extensions/browser/install",
      "//extensions/common",
      "//ui/base",
    ]
  }
  if (is_android) {
    sources += [
      "extension_dialog_utils_android.cc",
      "extension_install_ui_android.cc",
    ]
    deps += [
      "//chrome/browser/ui/android/extensions",
      "//chrome/browser/ui/android/tab_model",
      "//extensions/common",
    ]
  }
  if (toolkit_views) {
    sources += [
      "extension_dialog_utils_views.cc",
    ]
    deps += [
      "//chrome/browser/ui/views/extensions:extension_view_utils",
      "//chrome/browser/ui/views/extensions:extension_view_views",
      "//chrome/browser/ui/views/extensions:extensions_container_views",
      "//chrome/browser/ui/views/extensions:extensions_menu_delegate_desktop",
      "//chrome/browser/ui/views/extensions:extensions_toolbar_desktop",
      "//chrome/browser/ui/views/frame:toolbar_button_provider",
    ]
  }
  if (is_win || is_mac) {
    deps += [ "//chrome/browser/ui/views/extensions:settings_overridden_dialog_view_utils" ]
  }

  if (enable_extensions) {
    sources += [
      "confirm_protocol_handler_dialog.cc",
      "extension_enable_flow.cc",
      "installation_error_infobar_delegate.cc",
      "web_file_handlers/multiclient_util.cc",
    ]

    deps += [
      ":extension_enable_flow_delegate",
      ":extension_popup_types",
      "//chrome/browser/app_mode",
      "//chrome/browser/extensions",
      "//chrome/browser/favicon",
      "//chrome/browser/infobars",
      "//chrome/browser/search_engines",
      "//chrome/browser/tab_list",
      "//chrome/browser/ui:browser_actions",
      "//chrome/browser/ui:browser_init_state",
      "//chrome/browser/ui/location_bar",
      "//chrome/browser/ui/profiles",
      "//chrome/browser/ui/startup",
      "//chrome/browser/ui/window_metadata",
      "//components/prefs",
      "//components/security_state/content",
      "//components/services/app_service",
      "//components/signin/public/base:signin_switches",
    ]
  }
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]

  if (!is_android) {
    deps += [ "//chrome/browser/ui/views/frame:browser_view_header" ]
  }
}

