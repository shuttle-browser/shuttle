import("//build/config/ui.gni")

assert(!is_android && !is_fuchsia)

source_set("window_sizer") {
  sources = [ "window_sizer.h" ]

  public_deps = [
    "//base",
    "//ui/base:types",
    "//ui/base/mojom:ui_base_types",
    "//ui/gfx/geometry",
  ]

  if (is_chromeos) {
    sources += [ "window_sizer_chromeos.h" ]
  }
}

source_set("impl") {
  sources = [ "window_sizer.cc" ]

  public_deps = [
    "//chrome/browser:browser_public_dependencies",
    "//ui/base/mojom:ui_base_types",
  ]

  deps = [
    ":window_sizer",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:browser_init_state",
    "//chrome/browser/ui:browser_window_header",
    "//chrome/browser/ui:browser_window_state",
    "//chrome/browser/ui/browser_window",
    "//chrome/common:non_code_constants",
    "//components/prefs",
    "//ui/base",
    "//ui/display",
  ]

  if (is_mac) {
    sources += [ "window_sizer_mac.mm" ]
  }

  if (use_aura) {
    sources += [ "window_sizer_aura.cc" ]

    if (is_chromeos) {
      sources += [ "window_sizer_chromeos.cc" ]
      deps += [
        "//chrome/browser/ui/window_feature_controller",
        "//chrome/common:constants",
        "//ui/aura",
      ]
    }
  }
}

if (is_chromeos) {
  source_set("interactive_ui_tests") {
    testonly = true

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "window_sizer_chromeos_uitest.cc" ]

    deps = [
      "//base",
      "//chrome/browser/ui",
      "//chrome/browser/ui:browser_window_header",
      "//chrome/browser/ui/window_sizer",
      "//chrome/test:test_support_ui",
      "//components/keep_alive_registry",
      "//content/test:test_support",
      "//ui/compositor",
      "//ui/events:test_support",
      "//ui/views",
      "//ui/wm",
    ]
  }
}
