import("//build/config/ui.gni")

assert(use_aura)

source_set("accessibility") {
  sources = [ "automation_manager_aura.h" ]

  public_deps = [
    "//base",
    "//extensions/browser/api",
    "//ui/accessibility",
    "//ui/views",
  ]
}

source_set("impl") {
  sources = [ "automation_manager_aura.cc" ]

  deps = [
    ":accessibility",
    "//base",
    "//extensions/browser/api",
    "//ui/accessibility",
    "//ui/aura",
    "//ui/display",
    "//ui/views",
    "//ui/wm",
    "//ui/wm/public",
  ]
}

