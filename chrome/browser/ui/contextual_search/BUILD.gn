import("//pdf/features.gni")

assert(is_win || is_mac || is_linux || is_chromeos || is_android)

source_set("contextual_search") {
  sources = [
    "searchbox_context_data.cc",
    "searchbox_context_data.h",
  ]

  public_deps = [ "//ui/base/unowned_user_data" ]

  deps = [
    "//base",
    "//chrome/browser/page_content_annotations:extraction_service",
    "//chrome/browser/profiles",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tabs_public",
    "//components/omnibox/browser:mojo_bindings",
    "//components/optimization_guide/content/browser",
    "//components/optimization_guide/content/browser:page_context_eligibility",
    "//components/page_content_annotations/content",
    "//components/sessions",
    "//components/tabs:public",
    "//components/viz/common",
    "//content/public/browser",
    "//pdf:buildflags",
    "//skia",
  ]

  if (enable_pdf) {
    public_deps += [
      "//components/pdf/browser",
      "//pdf/mojom",
    ]
  }

  if (is_android) {
    deps += [ "//chrome/browser/android:tabs_public" ]
  }
}

if (!is_android) {
  source_set("unit_tests") {
    testonly = true
    sources = [
      "searchbox_context_data_unittest.cc",
    ]
    deps = [
      ":contextual_search",
      "//base",
      "//base/test:test_support",
      "//chrome/browser/tab_list:test_support",
      "//chrome/browser/ui:test_support",
      "//chrome/browser/ui/actions",
      "//chrome/test:test_support",
      "//chrome/test:test_support_unit",
      "//components/omnibox/browser:mojo_bindings",
      "//components/tabs:public",
      "//components/tabs:test_support",
      "//content/test:test_support",
      "//testing/gmock",
      "//testing/gtest",
      "//third_party/omnibox_proto",
      "//url",
    ]
  }
}
