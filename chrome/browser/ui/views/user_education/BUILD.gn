import("//build/config/ui.gni")
import("//extensions/buildflags/buildflags.gni")
import("//pdf/features.gni")

assert(toolkit_views)

source_set("user_education") {
  public = [
    "browser_help_bubble.h",
    "browser_help_bubble_event_relay.h",
    "browser_user_education_service.h",
    "custom_webui_help_bubble_controller.h",
    "impl/browser_feature_promo_controller.h",
    "impl/browser_feature_promo_preconditions.h",
    "impl/browser_user_education_context.h",
    "impl/browser_user_education_interface_impl.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/user_education",
    "//chrome/browser/ui/webui/top_chrome",
    "//chrome/browser/user_education",
    "//components/user_education/common",
    "//components/user_education/views",
    "//components/user_education/webui",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/interaction",
    "//ui/events",
    "//ui/views",
    "//ui/webui/resources/cr_components/help_bubble:mojo_bindings",
  ]

  # impl/browser_user_education_interface_impl.h needs
  # //chrome/browser/ui/user_education, which itself (transitively, via
  # //chrome/browser/user_education) already depends on this target --
  # grant it access rather than adding a real dep the other way, which
  # would be a cycle.
  allow_circular_includes_from = [ "//chrome/browser/user_education" ]
}

# custom_webui_help_bubble.h lives here, not in :user_education: its
# CreateForController<T>() template calls GetBrowserView().GetProfile(),
# which needs BrowserView's complete type wherever it's instantiated.
# frame/browser_view.h is still monolithic in ui:ui (crbug.com/353332589),
# so this stays confined to the target ui:ui already grants circular
# access to, rather than forcing it onto the public :user_education
# target.
source_set("impl") {
  sources = [
    "browser_help_bubble.cc",
    "browser_help_bubble_event_relay.cc",
    "browser_user_education_service.cc",
    "custom_webui_help_bubble.cc",
    "custom_webui_help_bubble.h",
    "custom_webui_help_bubble_controller.cc",
    "impl/browser_feature_promo_controller.cc",
    "impl/browser_feature_promo_preconditions.cc",
    "impl/browser_user_education_context.cc",
    "impl/browser_user_education_interface_impl.cc",
  ]

  public_deps = [ ":user_education" ]

  deps = [
    "//chrome/browser/actor",
    "//chrome/browser/devtools",
    "//chrome/browser/pdf",
    "//chrome/browser/profiles",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/signin",
    "//chrome/browser/themes",
    "//chrome/browser/ui:browser_actions",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/actions:actions_headers",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/feature_first_run",
    "//chrome/browser/ui/focus",
    "//chrome/browser/ui/location_bar",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/omnibox",
    "//chrome/browser/ui/page_action:icon_type",
    "//chrome/browser/ui/side_panel",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/tabs:tab_group",
    "//chrome/browser/ui/tabs:tab_model",
    "//chrome/browser/ui/tabs:tabs_public",
    "//chrome/browser/ui/toolbar",
    "//chrome/browser/ui/toolbar/pinned_toolbar",
    "//chrome/browser/ui/views:bubble_anchor_util_views",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/browser/ui/views/accessibility",
    "//chrome/browser/ui/views/frame:contents_web_view",
    "//chrome/browser/ui/views/frame:toolbar_button_provider",
    "//chrome/browser/ui/views/page_action",
    "//chrome/browser/ui/views/tabs:tab",
    "//chrome/browser/ui/views/tabs/common:impl",
    "//chrome/browser/ui/views/tabs/horizontal",
    "//chrome/browser/ui/views/tabs/tab",
    "//chrome/browser/ui/views/toolbar",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/browser/ui/webui/history",
    "//chrome/browser/ui/webui/settings",
    "//chrome/browser/user_education",
    "//components/feature_engagement/public",
    "//components/pdf/browser",
    "//components/user_education/views",
    "//components/user_education/webui",
    "//content/public/browser",
    "//ui/base",
    "//ui/views",
  ]

  if (is_chromeos) {
    deps += [ "//ash" ]
  }

  if (is_mac) {
    sources += [ "browser_help_bubble_event_relay_mac.mm" ]
    deps += [ "//components/remote_cocoa/app_shim" ]
  }

  if (is_win) {
    deps += [ "//chrome/browser/ui/search_promotion" ]
  }

  if (enable_extensions_core) {
    deps += [ "//chrome/browser/ui/webui/extensions_zero_state_promo" ]
  }

  if (enable_pdf_ink2) {
    deps += []
  }
}

if (!is_chromeos_device) {
}
