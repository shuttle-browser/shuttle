import("//build/config/chromeos/args.gni")
import("//build/config/ui.gni")

assert(toolkit_views)

source_set("groups") {
  public = [
    "color_picker_view.h",
    "tab_group_accessibility.h",
    "tab_group_editor_bubble_tracker.h",
    "tab_group_editor_bubble_view.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//chrome/browser/ui/views/controls",
    "//chrome/browser/ui/views/location_bar",
    "//components/favicon_base",
    "//components/tab_groups",
    "//ui/base/interaction",
    "//ui/base/metadata",
    "//ui/base/mojom:ui_base_types",
    "//ui/base/unowned_user_data",
    "//ui/views",
  ]
}

source_set("impl") {
  sources = [
    "color_picker_view.cc",
    "tab_group_accessibility.cc",
    "tab_group_editor_bubble_tracker.cc",
    "tab_group_editor_bubble_view.cc",
  ]

  deps = [
    ":groups",
    "//base",
    "//chrome/app/vector_icons",
    "//chrome/browser/favicon",
    "//chrome/browser/image_fetcher",
    "//chrome/browser/profiles",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui:tab_ui_helper",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/tabs:features",
    "//chrome/browser/ui/tabs:tab_group",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views:bubble_menu_item_factory",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/browser/ui/views/tabs:tab_strip",
    "//chrome/browser/ui/views/toolbar",
    "//components/image_fetcher/core",
    "//components/prefs",
    "//components/signin/public/base",
    "//components/strings",
    "//components/tabs:public",
    "//components/vector_icons",
    "//skia",
    "//third_party/icu",
    "//ui/accessibility:ax_enums_mojo",
    "//ui/base",
    "//ui/base:features",
    "//ui/compositor",
    "//ui/events/types:headers",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/gfx/range",
    "//ui/native_theme",
    "//ui/strings:ui_strings",
    "//url",
  ]

  if (is_chromeos) {
    deps += [ "//ash" ]
  }

  if (use_ozone) {
    deps += [ "//ui/ozone" ]
  }

  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
}

