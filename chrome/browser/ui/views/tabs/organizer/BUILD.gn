import("//extensions/buildflags/buildflags.gni")

source_set("organizer") {
  sources = [
    "layout_constants.h",
    "organizer_panel_controls_view.h",
    "organizer_panel_host.h",
    "organizer_panel_utils.h",
    "organizer_panel_view.h",
    "organizer_tray_view.h",
  ]

  public_deps = [
    "//base",
    "//chrome/app/vector_icons",
    "//chrome/browser/ui/tabs/organizer",
    "//ui/base",
    "//ui/views",
  ]

  if (enable_extensions) {
    public_deps += [
      "//extensions/buildflags",
      "//extensions/common",
    ]
  }
}

source_set("impl") {
  sources = [
    "organizer_panel_controls_view.cc",
    "organizer_panel_host.cc",
    "organizer_panel_utils.cc",
    "organizer_panel_view.cc",
    "organizer_tray_view.cc",
  ]

  public_deps = [ ":organizer" ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/app/vector_icons",
    "//chrome/browser/ui",
    "//chrome/browser/ui:browser_actions",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui:layout_constants",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/actions:actions_headers",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/tabs:tab_group",
    "//chrome/browser/ui/tabs/organizer:impl",
    "//chrome/browser/ui/views/tabs/shared",
    "//chrome/browser/ui/views/tabs/vertical",
    "//chrome/browser/ui/views/toolbar",
    "//ui/actions",
    "//ui/decoration",
    "//ui/views/controls/webview",
    "//url",
  ]

  if (enable_extensions) {
    deps += [
      "//chrome/browser/extensions",
      "//chrome/common/extensions/api",
      "//extensions/browser",
      "//extensions/common",
    ]
  }
}

