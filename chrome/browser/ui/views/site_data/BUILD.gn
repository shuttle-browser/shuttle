import("//build/config/ui.gni")

assert(toolkit_views)

# site_data has no circular dependency back into //chrome/browser/ui:ui, so the
# public headers and implementation live in a single source_set (no :impl
# split).
source_set("site_data") {
  public = [
    "page_specific_site_data_dialog.h",
    "page_specific_site_data_dialog_controller.h",
    "site_data_row_view.h",
  ]

  sources = [
    "page_specific_site_data_dialog.cc",
    "page_specific_site_data_dialog_controller.cc",
    "site_data_row_view.cc",
  ]

  public_deps = [
    "//base",
    "//components/browsing_data/content",
    "//components/content_settings/core/common",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/metadata",
    "//ui/views",
    "//url",
  ]

  deps = [
    "//chrome/app:generated_resources",
    "//chrome/app/vector_icons",
    "//chrome/browser:browser_process",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/favicon",
    "//chrome/browser/history",
    "//chrome/browser/infobars",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:chrome_pages",
    "//chrome/browser/ui:collected_cookies_infobar_delegate",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui:url_identity",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/browser/ui/views/accessibility",
    "//chrome/common",
    "//components/browsing_data/core",
    "//components/constrained_window",
    "//components/content_settings/browser",
    "//components/content_settings/core/browser",
    "//components/infobars/content",
    "//components/omnibox/browser",
    "//components/privacy_sandbox:features",
    "//components/strings:components_strings_grit",
    "//components/vector_icons",
    "//components/web_modal",
    "//net",
    "//ui/gfx",
  ]
}

