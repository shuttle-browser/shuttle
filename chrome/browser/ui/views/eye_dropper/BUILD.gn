import("//build/config/features.gni")
import("//ui/views/features.gni")

source_set("eye_dropper") {
  public = []
  sources = []
  deps = []
  public_deps = []

  if (!is_android) {
    public += [ "eye_dropper.h" ]
    sources += [ "eye_dropper.cc" ]
    deps += [ "//content/public/browser" ]
  }

  if (is_mac) {
    public += [ "eye_dropper_view_mac.h" ]
    sources += [ "eye_dropper_view_mac.mm" ]
    public_deps += [
      "//base",
      "//content/public/browser/",
    ]
    deps += [
      "//skia",
      "//ui/base:features",
    ]
  }

  if (use_aura) {
    sources += [ "eye_dropper_aura.cc" ]
    deps += [
      "//build/config/linux/dbus:buildflags",
      "//chrome/browser/ui/color:color_headers",
      "//components/eye_dropper",
      "//ui/base:features",
    ]

    if (use_dbus && is_linux) {
      public += [ "eye_dropper_portal.h" ]
      sources += [ "eye_dropper_portal.cc" ]
      deps += [
        "//components/dbus",
        "//dbus",
        "//ui/aura",
        "//ui/linux:linux_ui",
      ]
    }

    if (is_chromeos) {
      deps += [
        "//ash/public/cpp",
        "//ui/aura",
      ]
    }
  }
}

if (!is_android && !is_chromeos_device) {
}

