import("//build/config/ui.gni")

# RenderViewContextMenuViews is the Aura context menu (Mac uses the cocoa
# variant), and its implementation uses aura unconditionally.
assert(use_aura)

source_set("renderer_context_menu") {
  public = [ "render_view_context_menu_views.h" ]

  public_deps = [
    "//chrome/browser/renderer_context_menu",
    "//ui/base/mojom:ui_base_types",
  ]
}

source_set("impl") {
  sources = [ "render_view_context_menu_views.cc" ]

  deps = [
    ":renderer_context_menu",
    "//chrome/app:command_ids",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/common:non_code_constants",
    "//components/lens:buildflags",
    "//components/renderer_context_menu",
    "//content/public/browser",
    "//ui/aura",
    "//ui/base",
    "//ui/events",
    "//ui/strings",
    "//ui/views",
  ]
}

