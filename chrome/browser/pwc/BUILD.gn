import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "pwc.mojom" ]
}

source_set("pwc") {
  public = [
    "privileged_web_contents.h",
    "pwc_api_binder.h",
    "pwc_component_policy.h",
    "pwc_navigation_throttle.h",
    "pwc_permission_delegate.h",
  ]

  sources = [
    "privileged_web_contents.cc",
    "pwc_api_binder.cc",
    "pwc_component_policy.cc",
    "pwc_navigation_throttle.cc",
  ]

  public_deps = [
    ":mojo_bindings",
    "//base",
    "//components/content_settings/core/common:content_settings_types",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/mojom:mojom_platform_headers",
    "//ui/base/unowned_user_data",
    "//url",
  ]

  deps = [
    "//chrome/browser:bad_message",
    "//components/back_forward_cache",
  ]
}

