import("//extensions/buildflags/buildflags.gni")
import("//ui/webui/webui_features.gni")

source_set("constants") {
  sources = [ "chrome_browsing_data_remover_constants.h" ]
  deps = [
    "//chrome/common:buildflags",
    "//content/public/browser",
    "//extensions/buildflags",
  ]
}

source_set("browsing_data") {
  public = [
    "browsing_data_history_observer_service.h",
    "browsing_data_important_sites_util.h",
    "browsing_data_lifetime_policy_handler.h",
    "chrome_browsing_data_lifetime_manager.h",
    "chrome_browsing_data_lifetime_manager_factory.h",
    "chrome_browsing_data_model_delegate.h",
    "chrome_browsing_data_remover_delegate.h",
    "chrome_browsing_data_remover_delegate_factory.h",
    "counters/browsing_data_counter_factory.h",
    "counters/browsing_data_counter_utils.h",
    "counters/cache_counter.h",
    "counters/downloads_counter.h",
    "counters/site_data_counter.h",
    "counters/site_data_counting_helper.h",
    "counters/site_settings_counter.h",
    "navigation_entry_remover.h",
    "site_data_size_collector.h",
  ]

  if (is_android) {
    public += [ "counters/tabs_counter.h" ]
  }
  if (enable_hosted_apps) {
    public += [ "counters/hosted_apps_counter.h" ]
  }

  public_deps = [
    ":constants",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/common:buildflags",
    "//components/browsing_data/content",
    "//components/browsing_data/core",
    "//components/content_settings/core/browser",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//components/offline_pages/core",
    "//components/policy/core/browser",
    "//components/prefs",
    "//components/webid",
    "//content/public/browser",
    "//device/fido",
    "//extensions/buildflags",
    "//ui/base/interaction",
  ]
}

source_set("impl") {
  sources = [
    "browsing_data_history_observer_service.cc",
    "browsing_data_important_sites_util.cc",
    "browsing_data_lifetime_policy_handler.cc",
    "chrome_browsing_data_lifetime_manager.cc",
    "chrome_browsing_data_lifetime_manager_factory.cc",
    "chrome_browsing_data_model_delegate.cc",
