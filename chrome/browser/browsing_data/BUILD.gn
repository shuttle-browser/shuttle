    "chrome_browsing_data_remover_delegate_factory.cc",
    "counters/browsing_data_counter_factory.cc",
    "counters/browsing_data_counter_utils.cc",
    "counters/cache_counter.cc",
    "counters/downloads_counter.cc",
    "counters/site_data_counter.cc",
    "counters/site_data_counting_helper.cc",
    "counters/site_settings_counter.cc",
