    "//components/browsing_data/content",
    "//components/browsing_data/core",
    "//components/content_settings/browser",
    "//components/crash/core/app",
    "//components/device_event_log",
    "//components/heavy_ad_intervention",
    "//components/history/core/common",
    "//components/language/core/browser",
    "//components/media_device_salt",
    "//components/open_from_clipboard",
    "//components/performance_manager",
    "//components/privacy_sandbox:privacy_sandbox_settings_headers",
    "//components/safe_browsing/core/browser:suspicious_site_warning_allowlist",
    "//components/safe_browsing/core/browser:verdict_cache_manager",
    "//components/search_engines",
    "//components/strings",
    "//components/url_matcher",
