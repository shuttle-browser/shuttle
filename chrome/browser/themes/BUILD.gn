import("//extensions/buildflags/buildflags.gni")

assert(!is_ios)

source_set("themes") {
  public = [
    "autogenerated_theme_supplier.h",
    "browser_theme_provider_delegate.h",
    "custom_theme_supplier.h",
    "theme_helper.h",
    "theme_properties.h",
    "theme_service.h",
    "theme_service_factory.h",
    "theme_service_observer.h",
  ]
  sources = [
    "autogenerated_theme_supplier.cc",
    "custom_theme_supplier.cc",
    "theme_helper.cc",
    "theme_properties.cc",
    "theme_service.cc",
    "theme_service_factory.cc",
  ]
  deps = [
    "//chrome/browser:browser_process",
    "//chrome/browser/infobars",
    "//chrome/browser/new_tab_page/chrome_colors",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/webui/cr_components/theme_color_picker",
    "//chrome/common",
    "//components/infobars/content",
    "//components/keyed_service/content",
    "//components/pref_registry",
    "//components/tab_groups",
    "//components/tabs:public",
    "//components/themes",
    "//components/themes:prefs",
    "//components/version_info",
    "//content/public/browser",
    "//third_party/abseil-cpp:absl",
    "//ui/color",
    "//ui/color/dynamic_color",
    "//ui/gfx",
    "//ui/native_theme",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/common/themes:autogenerated_theme_util",
    "//components/keyed_service/core",
    "//components/prefs",
    "//extensions/buildflags",
    "//skia",
    "//ui/base",
    "//ui/base/mojom",
    "//ui/color:color_provider_key",
    "//ui/gfx:color_utils",
  ]
  if (enable_extensions_core) {
    # These targets also exist when only extensions_core is enabled (e.g.
    # desktop-android). The includes that need them are guarded on
    # ENABLE_EXTENSIONS, but gn check does not evaluate the preprocessor.
    public_deps += [ "//extensions/common" ]
    deps += [ "//extensions/browser" ]
  }
  if (enable_extensions) {
    public += [
      "browser_theme_pack.h",
    ]
    sources += [
      "browser_theme_pack.cc",
    ]
    public_deps += [ "//components/sync/model" ]
    deps += [
      "//components/crx_file",
    ]
  }
  if (is_win) {
    sources += [
      "theme_helper_win.cc",
      "theme_helper_win.h",
    ]
  }
  if (is_linux) {
    public += [ "theme_service_aura_linux.h" ]
    sources += [ "theme_service_aura_linux.cc" ]
    deps += [
      "//ui/linux:linux_ui",
      "//ui/linux:linux_ui_factory",
      "//ui/ozone",
    ]
  }
  if (!is_android) {
    deps += [
      "//chrome/app/theme:theme_resources",
      "//chrome/browser/ui/frame",
      "//chrome/browser/ui/tabs:features",
      "//chrome/browser/ui/tabs:tab_group",
      "//components/resources:components_scaled_resources",
    ]
  }
}

if (!is_android) {

}
