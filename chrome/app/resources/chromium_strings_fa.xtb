<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="1029669172902658969">‏راه‌اندازی مجدد برای به‌روزرسانی ChromiumOS</translation>
<translation id="8271032073852564289">‏Agent Chrome توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="1395700234492294565">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، Agent Chrome از سرورهای Google استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما Google متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="1051793555070215510">با تکمیل این نظرسنجی ۱ دقیقه‌ای به ما کمک کنید «حالت ناشناس» را بهبود ببخشیم.</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="3693661839172633833">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای Agent Chrome خاموش کرده است</translation>
<translation id="4676383270508741906">‏برای جستجو کردن افزونه یا ویژگی خاص Agent Chrome، میان‌بر آن را در نوار نشانی تایپ کنید و به‌دنبال آن کلید صفحه‌کلید انتخابی‌تان را فشار دهید</translation>
<translation id="1098493699368672217">‏نشان دادن جستجو با Chromium در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="1104942323762546749">‏Chromium می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="112640046208448578">چیزها یا مکان‌ها را شناسایی کنید و نوشتار را کپی یا ترجمه کنید. وقتی از «جستجوی تصویر» استفاده می‌کنید، نماگرفتی از صفحه به سرور ارسال می‌شود. <ph name="LEARN_MORE" /></translation>
<translation id="5373975050135708711">‏Agent Chrome مرورگر پیش‌فرضتان است</translation>
<translation id="1131805035311359397">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK" />به سیستم Chromium وارد شوید<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">‏روی منو Chromium کلیک کنید</translation>
<translation id="1157985233335035034">زبان‌های اخیر</translation>
<translation id="1184145431117212167">‏نصب انجام نشد چون از نسخه Windows شما پشتیبانی نمی‌شود.</translation>
<translation id="604454529346438712">‏درباره Agent Chrome</translation>
<translation id="1186645291482254714">‏با Chromium در تلفنتان، هشدارهای پیگیری قیمت را دریافت کنید</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="1232234696885483911">‏وقتی‌که «جستجوی تصویر» را باز می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به‌طور خودکار به سرور ارسال می‌شوند. <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و سایر داده‌های «حساب Google» خود در Chromium استفاده کنید. برای تغییر دادن این تنظیم، به «حساب شما در Chromium» بروید.</translation>
<translation id="1244381985120794049">‏نمایش «Gemini در Chromium» در نوار منو Mac</translation>
<translation id="1257483544893909270">‏برای انتخاب بخشی از صفحه در «Gemini در Chromium»، از میان‌بر صفحه‌کلید استفاده کنید.</translation>
<translation id="1262876892872089030">‏وقتی این زبانه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت Chromium حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="3777643518642881741">‏‫Agent Chrome این بارگیری را مسدود کرد زیرا این فایل خطرناک است</translation>
<translation id="126567311906253476">‏وقتی با <ph name="USER_EMAIL" /> به سیستم سرویس‌های Google مثل Gmail یا YouTube وارد می‌شوید، می‌توانید به‌طور خودکار با همان حساب به سیستم Chromium وارد شوید</translation>
<translation id="1287534462498555020">‏دریافت کردن Chromium در تلفن</translation>
<translation id="1290883685122687410">خطای راه‌اندازی: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">‏راه‌اندازی نمایه Chromium جدید</translation>
<translation id="132092532143527429">‏با «Gemini در Chromium» امتحان کنید</translation>
<translation id="200785071050073583">‏‫Agent Chrome برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">‏ورود به سیستم Chromium در تلفن</translation>
<translation id="1330562121671411446">تشخیص دادن زبان</translation>
<translation id="1342274909142618978">‏داده‌ها از Chromium هم حذف شود (<ph name="URL" />)</translation>
<translation id="1345251407431278948">سنجاق شد! دفعه بعد می‌توانید «جستجوی تصویر» را ازطریق این دکمه جدید در نوارابزار باز کنید</translation>
<translation id="1356661055722410047">جدید! می‌توانید هم نوشتار و هم تصاویر روی صفحه‌نمایش را ترجمه کنید</translation>
<translation id="1383876407941801731">جستجو</translation>
<translation id="1388276868779258475">‏برای ادامه مرور در حرکت، از برنامه Chromium استفاده کنید</translation>
<translation id="141901961143729572">افکارتان را هم‌رسانی</translation>
<translation id="8789809509510733987">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Agent Chrome مجاز کنید.</translation>
<translation id="1478370723027452770">‏دریافت راهنمایی درباره Chrome for Testing</translation>
<translation id="1497802159252041924">خطای نصب: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">این صفحه محافظت شده است</translation>
<translation id="3850708453627715578">‏هم‌رسانی برگه Agent Chrome</translation>
<translation id="154404805518949443">‏ورود به سیستم Chromium</translation>
<translation id="1547469039832541117">تکلیف برجسته‌شده را به‌پایان می‌رساند.</translation>
<translation id="8546278207686764484">‏سنجاق کردن Agent Chrome</translation>
<translation id="1574377791422810894">‏ابزارهای ایمنی Chromium</translation>
<translation id="1594928384848033697">‏‫Chromium می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="551713766576210710">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="1623563412065267963">‏با برنامه Chromium در تلفنتان، بیشترین بهره را از Google ببرید</translation>
<translation id="1625909126243026060">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Chromium</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="1665602916345474427">با <ph name="USER_NAME" />، <ph name="USER_EMAIL" />، عضویت به سیستم وارد شده‌اید. باز کردن منو حساب</translation>
<translation id="2604712040942461790">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Agent Chrome باز کنید. این برنامه به نوار وظیفه هم سنجاق خواهد شد.</translation>
<translation id="1709772298389099340">امتیازهای عالی برای <ph name="BROWSER_NAME" /> ارائه می‌دهد.</translation>
<translation id="1722488837206509557">این کار به شما امکان می‌دهد از بین دستگاه‌های دردسترس انتخاب کنید و محتوا را در آن‌ها نمایش دهید.</translation>
<translation id="4145295773323539953">‏Agent Chrome به‌زودی داده‌های مرور را حذف می‌کند</translation>
<translation id="1736443181683099871">‏Chromium سعی می‌کند پیمایش‌ها را به HTTPS ارتقا دهد</translation>
<translation id="7280502947294080605">‏داده‌های Agent Chrome پاک شد</translation>
<translation id="1745121272106313518">‏Chromium تا <ph name="REMAINING_TIME" /> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="1749104137266986751">‏وقتی HTTPS دردسترس نباشد، Chromium بدون دادن هشدار به شما از اتصال ناامن استفاده می‌کند</translation>
<translation id="1887395919652703120">‏اجازه به Agent Chrome برای اجرا در پس‌زمینه</translation>
<translation id="1779356040007214683">‏برای ایمن‌تر کردن Chromium، برخی از افزونه‌هایی را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست شده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="1793486931176048546">‏روی <ph name="BEGIN_BOLD" />بله<ph name="END_BOLD" /> در اعلان Windows کلیک کنید تا Chromium را برای دسترسی سریع به نوار وظیفه سنجاق کنید.</translation>
<translation id="357645171972700077">‏نصب مجدد Agent Chrome</translation>
<translation id="1820835682567584003">‏Chromium در تلاش است <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">‏دفعه بعد که Chromium را در <ph name="DEVICE_TYPE" /> باز می‌کنید، پیام‌واره‌ای برای استفاده از «مدیر گذرواژه Google» خواهید دید.</translation>
<translation id="1838374766361614909">پاک کردن جستجو</translation>
<translation id="18552579716432081">‏برای حذف کردن داده‌های مرور فقط از این دستگاه و نگهداری آن در «حساب Google»، <ph name="BEGIN_LINK" />از سیستم Chromium خارج شوید<ph name="END_LINK" />.</translation>
<translation id="1857749206890802997">‏با بارگیری Chromium در تلفنتان، درحال حرکت گروه‌های زبانه جدید باز کنید یا بسازید.</translation>
<translation id="185970820835152459">‏می‌توانید «حساب‌های Google» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های Google» شما در مرورگر Chromium، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE" /> خود اضافه کنید. <ph name="LINK_BEGIN" />بیشتر بدانید<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">جستجو کردن با «جستجوی تصویر»</translation>
<translation id="1863837059069884561">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Chromium وارد شوید. همچنین نشانک‌ها و موارد دیگر را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="1880677175115548835">انتخاب نوشتار</translation>
<translation id="1881322772814446296">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Chromium خود را می‌دهید. داده‌های Chromium شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Google حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های Chromium موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE" /></translation>
<translation id="4964792828232534953">‏‫Agent Chrome با محدود کردن فعالیت پس‌زمینه و جلوه‌های دیداری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند. <ph name="BEGIN_LINK" />درباره «بهینه‌سازی انرژی» بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">‏سرویس به‌روزرسان Chromium</translation>
<translation id="1911763535808217981">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Chromium به سیستم سایت‌های Google مانند Gmail وارد شوید</translation>
<translation id="1929939181775079593">‏Chromium پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="1933341829955786215">‏سازمانتان (<ph name="MANAGER" />) شما را ملزم می‌کند به سیستم Chromium وارد شوید</translation>
<translation id="193439633299369377">‏برای اعمال به‌روزرسانی، ChromiumOS باید بازراه‌اندازی شود.</translation>
<translation id="207375373460618430">‏‫Agent Chrome این بارگیری را مسدود کرد زیرا این نوع فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE" /> دقیقه باقی مانده است</translation>
<translation id="700162948230159797">‏Agent Chrome نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="197326043290947695">با «جستجوی تصویر» هوشمندانه‌تر مرور کنید</translation>
<translation id="1990262977744080398">‏ببینید چرا Chromium برخی‌از فایل‌ها را مسدود می‌کند، در زبانه جدید باز می‌شود</translation>
<translation id="1999715455684970349">‏نرم‌افزار Chromium را به‌روز نگه می‌دارد. اگر این سرویس غیرفعال یا متوقف شود، نرم‌افزار Chromium به‌روز نخواهد ماند، به این معنی که آسیب‌پذیری‌های امنیتی احتمالی برطرف نمی‌شود و ممکن است ویژگی‌ها کار نکنند. این سرویس زمانی‌که هیچ نرم‌افزار Chromium از آن استفاده نکند، خود را حذف نصب می‌کند.</translation>
<translation id="2008474315282236005">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Chromium وارد شوید.</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="2039417478970545937">تنظیمات.</translation>
<translation id="2049376729098081731">‏انتخاب کنید که آیا سابقه Chromium برای تجربه‌های شخصی‌شده‌تر در سرویس‌های Google لحاظ شود یا نه</translation>
<translation id="2050698962207788467">‏این ویژگی در Chromium تعبیه شده است تا به شما در ساختن، ذخیره، و تکمیل خودکار گذرواژه‌های قوی کمک کند. برای دسترسی آسان، میان‌بر را اضافه کنید</translation>
<translation id="2064856577282482477">‏روی دکمه «سفارشی‌سازی Chromium» در «صفحه زبانه جدید» کلیک کنید و ظاهری جدید به Chromium ببخشید</translation>
<translation id="6816376218079012438">‏‫Agent Chrome این بارگیری را مسدود کرد زیرا این فایل فریب‌دهنده است و ممکن است تغییرات غیرمنتظره‌ای در دستگاهتان ایجاد کند</translation>
<translation id="208726765006323911">‏دفعه بعد که Chromium iOS را باز می‌کنید، پیام‌واره‌ای برای امتحان کردن «<ph name="FEATURE_NAME" />» خواهید دید.</translation>
<translation id="2099452623287920103">‏گذرواژه‌ها و دیگر داده‌های Chromium که در «حساب Google» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Chromium، دوباره به سیستم وارد شوید.</translation>
<translation id="8983263343920390117">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Agent Chrome استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}one{‏اگر به‌مدت # دقیقه از Agent Chrome استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}other{‏اگر به‌مدت # دقیقه از Agent Chrome استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}}</translation>
<translation id="2125838419757773031">بخشی از صفحه‌نمایش را برای جستجو انتخاب کنید</translation>
<translation id="2126108037660393668">فایل بارگیری‌شده تأیید نشد.</translation>
<translation id="2135919691573380097">گزارش کردن این سایت</translation>
<translation id="2137162749895930932">بستن صفحه ترجمه</translation>
<translation id="822057692680289847">‏‫Agent Chrome این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="2170098639895543546">هر چیزی در صفحه را انتخاب کنید</translation>
<translation id="2174178932569897599">‏سفارشی کردن Chromium</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
