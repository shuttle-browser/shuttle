<translation id="310459126943037700">تکلیف(ها) پایان نیافت.</translation>
<translation id="3104828284009500087">جستجو کردن هر چیزی در صفحه</translation>
<translation id="3126784891977756556">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Chromium، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید.</translation>
<translation id="2894555444497054373">‏Agent Chrome درحال استفاده از میکروفون شما است.</translation>
<translation id="3130333203120345554">جستجوی جدید</translation>
<translation id="3137969841538672700">برای جستجو، بخش موردنظر را بکشید</translation>
<translation id="3144188012276422546">‏این زبانه از منابع اضافی استفاده می‌کند. برای بهبود عملکرد، اجازه دهید Chromium آن را غیرفعال کند.</translation>
<translation id="3092580151719004572">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Agent Chrome مجاز کنید</translation>
<translation id="2314296667497715523">‏اجرای مجدد Agent Chrome</translation>
<translation id="3161522574479303604">همه زبان‌ها</translation>
<translation id="3179665906251668410">‏باز کردن پیوند در پنجره &amp;ناشناس Chromium</translation>
<translation id="3185330573522821672">‏سفارشی کردن نمایه جدید Chromium</translation>
<translation id="3189205223539394158">‏می‌توانید بدون عوض کردن زبانه، به گپ زدن با «حالت هوشواره‌ای» ادامه دهید. برای شروع، به سیستم Chromium وارد شوید. گذرواژه‌هایتان و اطلاعات دیگر را نیز در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="3224847870593914902">‏برای برداشتن «حساب Google» خود از Chromium، در صفحه «تنظیمات» از سیستم Chromium خارج شوید</translation>
<translation id="3234316605225071811">‏بعداً Chromium می‌تواند از شما بپرسد که آیا می‌خواهید از اطلاعات ذخیره‌شده برای تکمیل خودکار فرم‌ها استفاده کنید</translation>
<translation id="5982289753835865194">‏Agent Chrome نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد:
<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">‏با Chromium در iOS، ابزارهای هوشواره Google دلخواهتان را درحرکت همراه داشته باشید.</translation>
<translation id="3286538390144397061">راه‌اندازی مجدد اکنون</translation>
<translation id="3920105041734426863">‏کلیدهای Google API وجود ندارند. برخی از عملکردهای Agent Chrome از کار خواهند افتاد.</translation>
<translation id="5621884903587730053">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه Agent Chrome بسته می‌شود</translation>
<translation id="3313189106987092621">‏Chromium قبل‌از اینکه هر سایتی را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="3316771292331273802">‏وقتی همه پنجره‌های Chromium را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Chromium وارد شده باشید از «حساب Google» خارج نخواهید شد. برای اینکه سایت‌ها شما را به‌خاطر بسپارند، <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">‏گوشه بالا سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT" /> سمت چپ، ‎٪<ph name="TOP" /> بالا</translation>
<translation id="3366305173356742781">‏داده‌های Chromium در حساب شما</translation>
<translation id="3375770072980084583">‏از گذرواژه‌هایتان با Chromium در تلفنتان استفاده کنید</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3406848076815591792">‏به نمایه Chromium موجود می‌روید؟</translation>
<translation id="3412460710772753638">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="3438772217992559640">جستجوی این زبانه با «جستجوی تصویر»</translation>
<translation id="3455907671758333080">‏«مرور ایمن پیشرفته» را با Chromium در تلفنتان گسترش دهید</translation>
<translation id="3461644266919055473">‏درحال شخصی‌سازی Chromium…</translation>
<translation id="3474745554856756813">‏این کار <ph name="ITEMS_COUNT" /> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Chromium وارد شوید.</translation>
<translation id="3497319089134299931">‏با <ph name="SHORTCUT" /> می‌توانید بین نمایه‌های Chromium جابه‌جا شوید</translation>
<translation id="3509308970982693815">‏لطفاً همه پنجره‌های Chromium را ببندید و دوباره سعی کنید.</translation>
<translation id="4449744684308538611">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Agent Chrome مجاز کنید</translation>
<translation id="3530103706039034513">‏‫<ph name="EXISTING_USER" /> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Chromium وارد شوید.</translation>
<translation id="3531741627422851418">‏رمزینه پاسخ‌سریع برای بارگیری مرورگر Chromium در دستگاه‌های همراه</translation>
<translation id="354621070532799440">‏یادآور: بهترین ویژگی‌های ایمنی Google در جیب شما</translation>
<translation id="4902762267468919597">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Agent Chrome مجاز کنید.</translation>
<translation id="4199561934263811659">‏محافظت بهبودیافته، بهینه‌سازی جاوا اسکریپت را برای سایت‌هایی که Agent Chrome آن‌ها را نمی‌شناسد، خاموش می‌کند</translation>
<translation id="3597003331831379823">راه‌اندازی با امتیازهای عالی اجرا نشد. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">‏ورود به سیستم Chromium</translation>
<translation id="3639635944603682591">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL" /> به سیستم Chromium وارد شوید.</translation>
<translation id="7335807248512894660">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای Agent Chrome در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای Agent Chrome در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای Agent Chrome در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای Agent Chrome در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="3667616615096815454">نصب نشد، برنامه برای سرور ناشناس است.</translation>
<translation id="3675854891107786059">‏استفاده از <ph name="BEGIN_LINK" />گذرعبارت خودتان<ph name="END_LINK" /> برای رمزگذاری همه داده‌های Chromium موجود در «حساب Google» شما. روش‌های پرداخت و نشانی‌های موجود در Google Pay رمزگذاری نخواهند شد. سابقه مرور Chromium همگام‌سازی نخواهد شد.</translation>
<translation id="3697825383460320042">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="7584080815951640016">‏باز کردن پیوند در &amp;برگه جدید Agent Chrome</translation>
<translation id="3728124580182886854">‏برای شخصی‌سازی و اهداف بیشتر، Chromium و دیگر سرویس‌های Google را به‌هم پیوند دهید</translation>
<translation id="3729187154190517324">بااستفاده از دکمه «افزودن زبانه و موارد دیگر»، چند زبانه، فایل، و ابزار اضافه کنید و جستجویتان را عمیق‌تر کنید.</translation>
<translation id="3788675262216168505">‏مدیریت نمایه‌های Chromium</translation>
<translation id="9153620230534680918">‏ببینید چرا Agent Chrome برخی‌از بارگیری‌ها را مسدود می‌کند</translation>
<translation id="379589255253486813">‏اگر موردی نیاز به بررسی داشته باشد، Chromium به شما اطلاع می‌دهد</translation>
<translation id="4835254782629421085">‏‫Agent Chrome صفحه‌هایی را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="3810973564298564668">مدیریت</translation>
<translation id="3823384748599722168">‏برای استفاده کردن از گذرواژه‌های ذخیره‌شده، رمزینه پاسخ‌سریع را دنبال کنید، Chromium ویژه iOS را بارگیری کنید، و به سیستم «حساب Google» وارد شوید</translation>
<translation id="3846683726093018685">**خلاصه کردن:** در یک جمله کمتر از ۳۰ کلمه، موضوع اصلی و هدف محتوای نماگرفت را شرح بده.

          **پیشنهاد سؤال:** فهرستی گلوله‌ای با ۳ تا ۵ سؤال تأمل‌برانگیز تولید کن که کاربر بتواند برای درک بهتر نماگرفت بپرسد. حداقل یک مورد از این سؤالات باید به‌طور خاص درباره یک شیء بصری، طراحی، یا جای آن باشد.</translation>
<translation id="5151092236561494204"><ph name="PAGE_TITLE" /> - Agent Chrome</translation>
<translation id="387514319934708384">‏‫Chromium برای این سایت به اجازه شبکه محلی نیاز دارد</translation>
<translation id="3885770153807205175">انتخاب‌گر زبان</translation>
<translation id="8310546736680726676">‏Agent Chrome را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="3889543394854987837">‏برای باز کردن Chromium و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="3892148308691398805">کپی کردن نوشتار</translation>
<translation id="390528597099634151">‏<ph name="EXISTING_USER" /> قبلاً به سیستم این نمایه Chromium وارد شده است. برای جدا نگه داشتن مرور، Chromium می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="334040592769172771">‏این افزونه خط‌مشی «نت‌بازار Chrome» را نقض می‌کند و ممکن است ناامن باشد. آن را از Agent Chrome حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="3941890832296813527">خطای نصب: نام فایل نصب‌کننده نامعتبر است یا از آن پشتیبانی نمی‌شود.</translation>
<translation id="3945058413678539331">‏Chromium می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="3954172517175569325">‏گذرواژه‌ها، روش‌های پرداخت، و نشانی‌هایی که در «حساب Google» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Chromium، دوباره به سیستم وارد شوید.</translation>
<translation id="395904275706073188">صفحه‌های محافظت‌شده خوانده نمی‌شوند. صفحه دیگری را امتحان کنید.</translation>
<translation id="3962647064319009959">‏ببینید Chromium چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="3967822245660637423">بارگیری کامل شد</translation>
<translation id="6274881217831291926">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Agent Chrome چیزی را که تایپ می‌کنید برای دریافت پیشنهاد به ابزارهای عامل، جستجو، و هوش مصنوعی سازمانتان ارسال می‌کند.</translation>
<translation id="3975724895399328945">‏درباره Google Chrome for Testing</translation>
<translation id="3997429360543082038">‏درباره ChromiumOS</translation>
<translation id="8089050973791989914">‏وقتی‌که از سایتی بازدید می‌کنید، Agent Chrome بخش مبهم‌سازی‌شده‌ای از نشانی وب را ازطریق سرور حافظ حریم خصوصی‌ای که نشانی IP شما را پنهان می‌کند به <ph name="BEGIN_LINK" />مرور ایمن Google<ph name="END_LINK" /> ارسال می‌کند. اگر سایتی کار مشکوکی انجام دهد، نشانی‌های وب کامل و بخش‌هایی از محتوای صفحه نیز ارسال می‌شوند.</translation>
<translation id="4016217212818346953">با «مدیر گذرواژه» ایمن بمانید</translation>
<translation id="4019629340646866719">‏ارائه ChromiumOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS" />محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS" /> ممکن شده است.</translation>
<translation id="4022972681110646219">ترجمه کردن صفحه‌نمایش</translation>
<translation id="4023601594785368013">زبان اصلی: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">‏پیوندها را از هر برنامه‌ای در Chromium باز کنید. همچنین برای دسترسی آسان، Chromium به نوار وظیفه شما سنجاق می‌شود.</translation>
<translation id="2466379549068383575">‏با گزارش <ph name="BEGIN_LINK" />تنظیمات کنونی<ph name="END_LINK" />، به بهتر شدن Agent Chrome کمک کنید</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4055805654398742145">مدیر گذرواژه</translation>
<translation id="409373329602981607">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Agent Chrome استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از Agent Chrome استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از Agent Chrome استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
<translation id="4118474109249235144">‏حالت ناشناس Chromium</translation>
<translation id="4122186850977583290">‏رفتن به صفحه «درباره Chromium»</translation>
<translation id="4135244987012252068">‏با سفارشی‌سازی Chromium، ظاهر جدیدی به مرورگرتان بدهید</translation>
<translation id="4147856324248078748">‏سفارشی‌سازی Chromium</translation>
<translation id="4148957013307229264">درحال نصب…</translation>
<translation id="2058774528396152893">‏<ph name="PAGE_TITLE" /> - ورود به سیستم شبکه - Agent Chrome</translation>
<translation id="7685529984676330289">‏برنامه‌ها، بازی‌ها، افزونه‌ها و طرح‌های زمینه Agent Chrome را کشف کنید.</translation>
<translation id="4217080900579554343">‏برای دریافت این افزونه و موارد دیگر در همه رایانه‌هایتان، به سیستم Chromium وارد شوید</translation>
<translation id="4217972271355023382">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به همان نمایه Chromium بروید که قبلاً با <ph name="USER_EMAIL_ADDRESS" /> به سیستم وارد شده‌اید</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="4224210481850767180">نصب لغو شده است.</translation>
<translation id="4230135487732243613">‏داده‌های Chromium به این حساب مرتبط شود؟</translation>
<translation id="274377438883177878">‏با تجزیه‌وتحلیل داده‌های بیشتری از سایت‌ها در مقایسه با محافظت استاندارد، درباره سایت‌های خطرناک به شما هشدار می‌دهد، حتی سایت‌هایی که Google قبلاً از آن‌ها اطلاعی نداشته است. می‌توانید هشدارهای Agent Chrome را رد کنید.</translation>
<translation id="4269093074552541569">‏خروج از سیستم Chromium</translation>
<translation id="8361584154950824008">‏دریافت کمک برای Agent Chrome</translation>
<translation id="4281844954008187215">شرایط استفاده از سرویس</translation>
<translation id="4285930937574705105">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر Chromium در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="4298125729853015961">‏صادر کردن گذرواژه‌ها از Chromium</translation>
<translation id="4304713468139749426">مدیر گذرواژه</translation>
<translation id="4334241893986177674">جستجو کردن این نماگرفت</translation>
<translation id="4368547723231502008">‏از هرجا که هستید جستجو کنید و سؤال بپرسید، حتی اگر Chromium کوچک شده باشد</translation>
<translation id="1172096072757635810">‏راه‌اندازی Agent Chrome هنگام شروع Windows</translation>
<translation id="4400772909124543403">به‌روزرسانی دردسترس نیست</translation>
<translation id="8069611125329654712">‏درهرصورت از Agent Chrome خارج می‌شوید؟</translation>
<translation id="4413205837991854510">همیشه نشان دادن میان‌بر «جستجوی تصویر»</translation>
<translation id="3727041326435831325">‏اجازه به Agent Chrome برای اجرا در پس‌زمینه</translation>
<translation id="1713490836766202786">{NUM_EXTENSIONS,plural, =1{‏‫Agent Chrome توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}one{‏‫Agent Chrome توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}other{‏‫Agent Chrome توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}}</translation>
<translation id="7567010943765939594">‏سفارشی کردن و کنترل Agent Chrome</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="4434353761996769206">خطای نصب‌کننده: <ph name="INSTALLER_ERROR" /></translation>
<translation id="7498286168885369820">‏‫<ph name="MANAGER" /> ‏Agent Chrome را مدیریت می‌کند</translation>
<translation id="444069871276811466">‏افزودن نمایه Chromium</translation>
<translation id="4447409407328223819">‏درباره Chrome for Testing</translation>
<translation id="4470974262661801543">‏برای ذخیره کردن داده‌های Chromium در «حساب Google» خود و استفاده از آن‌ها، گذرعبارتتان را وارد کنید</translation>
<translation id="4493028449971051158">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش سرپرست اجرا کنید.</translation>
<translation id="4501471624619070934">نصب انجام نشد زیرا دسترسی در این کشور محدود است.</translation>
<translation id="4615766574627629942">‏این افزونه روش‌های اعمال حریم خصوصی، مثل نحوه جمع‌آوری و استفاده از داده‌ها را منتشر نکرده است. ‫Agent Chrome توصیه می‌کند آن را حذف کنید.</translation>
<translation id="452711251841752011">‏به Chromium خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="4531137820806573936">‏‫Chromium برای نقشه‌برداری از محیط اطراف و ردیابی دستان شما به اجازه نیاز دارد</translation>
<translation id="4536805923587466102">‏قبلاً با <ph name="USER_EMAIL_ADDRESS" /> در نمایه Chromium دیگری به سیستم وارد شده‌اید</translation>
<translation id="5945053225725114995">‏‫Agent Chrome صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو کردن سریع‌تر شود. <ph name="BEGIN_LINK" />درباره پیش‌بارگیری صفحه‌ها بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">وقتی سایتی را که فکر می‌کنید مضر است گزارش می‌کنید، به بهبود ایمنی آنلاین برای همه کمک می‌کنید.</translation>
<translation id="2899198307620821227">‏‫Agent Chrome این بارگیری را مسدود کرد زیرا «مرور ایمن» خاموش است و نمی‌توان فایل را تأیید کرد</translation>
<translation id="4583692638088316420">‏«لنز Google» را با Chromium در تلفنتان امتحان کنید</translation>
<translation id="4594305310729380060">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="6944119370969619446">‏برنامه‌های Agent Chrome</translation>
<translation id="4598116752460667024">فرایندی را ازطریق فهرست جستجو کنید.</translation>
<translation id="4613863813562375431">‏نسخه ChromiumOS</translation>
<translation id="6401103202303237090">‏تقریباً به‌روز شده است! برای تمام کردن به‌روزرسانی، Agent Chrome را راه‌اندازی مجدد کنید.</translation>
<translation id="4807663225386362301">‏سرعت سایت‌ها را با موتورV8 مرورگر Agent Chrome بالاتر می‌برد اما مقاومت Agent Chrome را دربرابر حمله‌ها کمی کمتر می‌کند</translation>
<translation id="4626321472657185181">‏باز کردن جستجو با Chromium</translation>
<translation id="521912697020157864">‏هشدار: Agent Chrome نمی‌تواند مانع از ثبت سابقه مرورتان توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت ناشناس»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="4673151026126227699">‏اگر گزارش‌های استفاده از Chromium را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="4673710618874938871">با <ph name="USER_NAME" />، عضویت به سیستم وارد شدید. باز کردن منو حساب</translation>
<translation id="5833534934470627293">‏ظاهراً نمایه توسط فرایند Agent Chrome دیگری (<ph name="PROCESS_ID" />) در رایانه‌ای دیگر (<ph name="HOST_NAME" />) در حال استفاده است. Agent Chrome نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرایندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و Agent Chrome را مجدداً راه‌اندازی کنید.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="469259825538636168">‏برخی‌از داده‌های Chromium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="4708193446201257833">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و موارد دیگر «حساب Google» خود در Chromium استفاده کنید. ‫<ph name="SHORTCUT" /> می‌تواند تنظیمات سرویس‌های Google را تغییر دهد.</translation>
<translation id="4708774505295300557">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST" /> به سیستم Chromium در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر Chrome جدیدی ایجاد کنید.</translation>
<translation id="4724676981607797757">نصب به‌دلیل خطای پروتکل پشتیبانی‌نشده انجام نشد.</translation>
<translation id="2783410850122241193">‏درهرصورت از Agent Chrome خارج می‌شوید؟</translation>
<translation id="4748217263233248895">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای Chromium اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="4771701986670315895">‏اخیراً بازدیدی نداشته‌اید. ‫Chromium ‏<ph name="PERMISSION_1" />،‏ <ph name="PERMISSION_2" />،‏ و <ph name="COUNT" /> مورد دیگر را برداشت.</translation>
<translation id="4786083865378785874">‏اگر «Gemini در Chromium» باز باشد، پانل کناری هنگام ایجاد زبانه‌های جدید باز می‌ماند</translation>
<translation id="479167709087336770">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی Google استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Google ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="4814736265800133385">‏استفاده از Chromium بدون حساب</translation>
<translation id="4888717733111232871">‏قانون ترافیک ورودی برای Chromium جهت اجازه به ترافیک mDNS.</translation>
<translation id="5600814355607573136">‏راه‌اندازی مجدد برای به‌روزرسانی Agent Chrome</translation>
<translation id="4918086044614829423">می‌پذیرم</translation>
<translation id="4918844574251943176">تصویر کپی شد</translation>
<translation id="4943838377383847465">‏Chromium در حالت پس‌زمینه است.</translation>
<translation id="494490797786467921">‏برای بستن کادر گفتگوی ورود به سیستم Chromium، کلیک کنید</translation>
<translation id="4950660488495335294">‏با نمایه‌های Chromium می‌توانید همه چیزهای مربوط به Chromium را از هم جدا کنید. برای دوستان و اعضای خانواده نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="4987820182225656817">‏مهمان‌ها می توانند از Chromium استفاده کنند بدون این‌که اثری از خود به جا بگذارند.</translation>
<translation id="4992938037305302429">‏حساب شما در Chromium</translation>
<translation id="4994636714258228724">‏افرودن خودتان به Chromium</translation>
<translation id="504699503110800016">باز کردن منو سرریز</translation>
<translation id="5074496654342756568">‏با Chromium در <ph name="DEVICE_TYPE" /> خود، به همه موارد دلخواه Google دسترسی پیدا کنید</translation>
<translation id="5123973130450702873">‏‫Chromium برای ردیابی کردن دست‌های شما به اجازه نیاز دارد</translation>
<translation id="5141988424377517949">‏اخیراً بازدیدی نداشته‌اید. ‫Chromium ‏<ph name="PERMISSION_1" />،‏ <ph name="PERMISSION_2" />،‏ و <ph name="PERMISSION_3" /> را برداشت.</translation>
<translation id="5174969993834422967">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان ارسال کند، روی نماد اعلان در گوشه چپ نوار نشانی کلیک کنید.</translation>
<translation id="5174983315706567306">فضای دیسک کافی نیست.</translation>
<translation id="5187123684706427865">‏حساب Chromium به اصالت‌سنجی مجدد نیاز دارد</translation>
<translation id="5223510345050543907">‏ادامه کار را دقیقاً از همان جایی که در Chromium روی iOS متوقف کرده بودید، از سر بگیرید.</translation>
<translation id="5231355151045086930">‏خروج از سیستم Chromium</translation>
<translation id="5234764350956374838">بستن</translation>
<translation id="5249261924633168472">‏باز کردن پیوند در پنجره حالت «&amp;ناشناس» Chromium</translation>
<translation id="5276305953263010518">‏برای ذخیره کردن گذرواژه‌ها درحرکت، برنامه Chromium را دریافت کنید</translation>
<translation id="1601187459465935178">‏برای اعمال تغییراتتان، Agent Chrome را راه‌اندازی مجدد کنید</translation>
<translation id="5286907366254680517">تشخیص داده شد</translation>
<translation id="5289287148052354622">‏دریافت برنامه Chromium</translation>
<translation id="5294316920224716406">‏هنگام مرور «درحالت ناشناس»، Chromium قبل‌از اینکه سایت را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="5296581118566748922">‏جستجو کردن با Chromium</translation>
<translation id="5313228254328109263">‏سرویس داخلی به‌روزرسان Chromium</translation>
<translation id="5324450571874973775">‏از آن‌ها در کنار دیگر ویژگی‌های Gemini در Chromium استفاده کنید</translation>
<translation id="5346389065299425353">جستجویتان را با افزودن چند زبانه، فایل، و ابزار عمیق‌تر کنید</translation>
<translation id="5348677704241861105">‏با «Gemini در Chromium»، مروری کوتاه از این سند دریافت کنید و سؤال بپرسید</translation>
<translation id="5352264705793813212">‏Chromium چند توصیه ایمنی برای بررسی پیدا کرد</translation>
<translation id="5352361688875342522">‏دیگر نمایه‌های Chromium</translation>
<translation id="535243042947607642">‏‫ChromiumOS نتوانست داده‌های Chromium را در «حساب Google» شما ذخیره کند زیرا جزئیات ورود به سیستم حسابتان به‌روز نیست</translation>
<translation id="5358375970380395591">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Chromium خود را می‌دهید. داده‌های Chromium شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Google حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">کد اضافی: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">‏برای گرفتن شخصی‌سازی‌ها، Chromium را به «فعالیت‌ها در وب و برنامه» اضافه کنید</translation>
<translation id="5382964351116519680">‏باز کردن جستجو با Chromium</translation>
<translation id="2524054769026663683">‏ببینید چرا Agent Chrome برخی‌از فایل‌ها را مسدود می‌کند</translation>
<translation id="8615009965479156445">‏درحال به‌روزرسانی Agent Chrome (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">‏مجاز کردن ورود به سیستم Chromium</translation>
<translation id="6256236118124872626">‏حذف از Agent Chrome</translation>
<translation id="5774731921051444461">‏عملکرد را کاهش می‌دهد اما Agent Chrome را دربرابر حملات مقاوم‌تر می‌کند</translation>
<translation id="5427571867875391349">‏تنظیم Chromium به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="8709870882148322247"><ph name="PAGE_TITLE" /> - Agent Chrome Beta</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{‏‫Chromium توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Chromium توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Chromium توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="3217425685577630218">‏Agent Chrome ممکن است درست کار نکند زیرا این توزیع Linux دیگر از آن پشتیبانی نمی‌کند.</translation>
<translation id="1045655099853558439">‏‫Agent Chrome این بارگیری را مسدود کرد زیرا این فایل می‌تواند به حساب‌های شخصی و شبکه‌های اجتماعی شما آسیب برساند</translation>
<translation id="549669000822060376">‏وقتی Chromium جدیدترین به‌روزرسانی‌های سیستم را نصب می‌کند، لطفاً صبر کنید.</translation>
<translation id="5496810170689441661">‏Chromium می‌خواهد گذرواژه‌ها را ویرایش کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="549975168243349205">‏با Chromium، در حرکت، به‌صورت یکپارچه با برنامه‌های موردعلاقه‌تان مانند Google Drive و YouTube کار کنید.</translation>
<translation id="5524890928877629608">‏گوشه بالا سمت راست ناحیه جستجو: ‎٪<ph name="LEFT" /> سمت راست، ‎٪<ph name="TOP" /> بالا</translation>
<translation id="565863787292824328">‏باز کردن فایل‌های PDF در Agent Chrome</translation>
<translation id="5536164441519929134">درباره این زبانه<ph name="LINE_BREAK" />بپرسید</translation>
<translation id="8869089999448782168">‏برای حفظ امنیت، وقتی برای اولین‌بار از سایتی بازدید می‌کنید، Agent Chrome «بهینه‌سازی جاوا اسکریپت» را خاموش می‌کند.

اگر این صفحه طبق انتظار کار نمی‌کند، «بهینه‌سازی» را مجاز کنید.</translation>
<translation id="5575874067957905201">‏نشان دادن «Gemini در Chromium» در نوار منو Mac و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="5576587363991567745">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Chromium وارد شوید. همچنین اطلاعات ذخیره‌شده و اطلاعات دیگر را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="5579324208890605088">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش کاربر معمولی اجرا کنید، نه با نقش سرپرست.</translation>
<translation id="5580770360767802657">‏استفاده کردن از Chromium به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن</translation>
<translation id="5596627076506792578">گزینه‌های بیشتر</translation>
<translation id="5605834417512968703">هرچیزی را که می‌خواهید برای جستجو کردن با «جستجوی تصویر» انتخاب کنید یا برای خارج شدن از «جستجوی تصویر»، کلید «گریز» را فشار دهید</translation>
<translation id="5618818588972826921">‏نوشتار یا تصویری را برای جستجو کردن با «جستجوی تصویر» انتخاب کنید یا برای خارج شدن از «جستجوی تصویر»، کلید Escape را فشار دهید</translation>
<translation id="4814380868372526025">{0,plural, =0{‏به‌روزرسانی Agent Chrome دردسترس است}=1{‏به‌روزرسانی Agent Chrome دردسترس است}one{‏به‌روزرسانی Agent Chrome از # روز پیش دردسترس است}other{‏به‌روزرسانی Agent Chrome از # روز پیش دردسترس است}}</translation>
<translation id="188722644954983559">‏داده‌های سایت همواره بعداز بستن Agent Chrome از دستگاه حذف شود</translation>
<translation id="5653831366781983928">‏لطفاً اکنون Chromium را بازراه‌اندازی کنید</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="1525044488102751845">‏نمایش Agent Chrome به این زبان</translation>
<translation id="569897634095159764">اتصال به اینترنت برقرار نشد. سرور پروکسی به اصالت‌سنجی نیاز دارد.</translation>
<translation id="7750959567789509941">‏‫Agent Chrome حافظه را از برگه‌های غیرفعال آزاد می‌کند. با این کار، منابع بیشتری در رایانه به برگه‌های فعال و سایر برنامه‌ها اختصاص داده می‌شود و سرعت بالای Agent Chrome حفظ می‌شود. هرزمان به برگه‌های غیرفعال برگردید، به‌طور خودکار دوباره فعال می‌شوند. <ph name="BEGIN_LINK" />درباره «بهینه‌سازی حافظه» بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، داده‌های Chromium ذخیره‌شده در حسابتان را <ph name="SETTINGS_LINK" /></translation>
<translation id="5800158606660203929">‏‫Chromium را سفارشی‌سازی و کنترل کنید. ‫Chromium را به‌عنوان مرورگر پیش‌فرض تنظیم کنید.</translation>
<translation id="5802618941556161431">‏با تعیین Chromium به‌عنوان مرورگر پیش‌فرض، گذرواژه‌ها، نشانک‌ها و سابقه مرورتان را کاملاً در همه دستگاه‌ها همگام‌سازی کنید.</translation>
<translation id="5809516625706423866">‏اتصال به اینترنت برقرار نشد. HTTP ۴۰۱ مجاز نیست. لطفاً پیکربندی پروکسی‌تان را بررسی کنید.</translation>
<translation id="2755468387099310604">‏با این کار سرعت سایت‌ها با موتور Agent Chrome نسخه ۸ بالاتر می‌رود اما مقاومت Agent Chrome دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم خاموش است.</translation>
<translation id="5821520528363214608">‏برای استفاده و ذخیره کردن داده‌های Chromium در «حساب Google» خود، Chromium را به‌روز کنید</translation>
<translation id="5824893331272123205">این پانل بارگیری نشد، دوباره امتحان کنید</translation>
<translation id="8972968824660717915">‏به Agent Chrome خوش آمدید</translation>
<translation id="8898055105597601099">‏ویژگی‌های اضافی را روشن می‌کند تا قدرتمندترین محافظت‌های Agent Chrome را ارائه دهد</translation>
<translation id="5871205389137001634">برای خارج شدن از «جستجوی تصویر»، کلیک کنید</translation>
<translation id="9158119422063615519">‏Agent Chrome متوجه شده است که این موارد حاوی بدافزار هستند:</translation>
<translation id="5889361821821684993">‏Chromium به‌طور منظم بررسی می‌کند تا مطمئن شود مرورگرتان ایمن‌ترین تنظیمات را دارد. اگر موردی به بازبینی شما نیاز داشته باشد، به شما اطلاع خواهیم داد.</translation>
<translation id="5895138241574237353">راه‌اندازی مجدد</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - ورود به سیستم شبکه</translation>
<translation id="5924017743176219022">درحال متصل شدن به اینترنت…</translation>
<translation id="5939553720811388432">‏بیایید Chromium را آماده کنیم</translation>
<translation id="5941711191222866238">کوچک کردن</translation>
<translation id="5949225980829865667">‏برای دریافت این نشانک و موارد بیشتر در همه دستگاه‌هایتان، به سیستم Chromium وارد شوید</translation>
<translation id="5953657885167112863">‏‫Chromium را مخصوص خودتان کنید</translation>
<translation id="5960071705175224773">برنامه‌ای ناشناس تنظیمات شما را تغییر داد</translation>
<translation id="5977420883993828287">سنجاق شد! برای استفاده دوباره از «تکالیف بافتاری»، از نوار‌ابزار استفاده کنید</translation>
<translation id="1956376169666014494">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Agent Chrome استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}one{‏اگر به‌مدت # دقیقه از Agent Chrome استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}other{‏اگر به‌مدت # دقیقه از Agent Chrome استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}}</translation>
<translation id="5987687638152509985">‏به‌روزرسانی Chromium برای شروع همگام‌سازی</translation>
<translation id="5990360079535151574">ازطریق دکمه «تکالیف بافتاری» در نوارابزار، می‌توانید «تکالیف بافتاری» را دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="6003112304606738118">درحال بارگیری… <ph name="HOURS" /> ساعت باقی مانده است</translation>
<translation id="6009821354356307391">پرسیدن سؤال تعقیبی</translation>
<translation id="6040143037577758943">بستن</translation>
<translation id="6044357424127037044">‏بااستفاده از برنامه Chromium در <ph name="DEVICE_TYPE" />، از خرید آنلاین بهره بیشتری ببرید</translation>
<translation id="6058380562449900225">‏برای محافظت از داده‌هایتان، به Chromium اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند. اعلان‌ها متوقف نمی‌شود.</translation>
<translation id="6063093106622310249">‏&amp;باز کردن در Chromium</translation>
<translation id="6069027071882229820">کپی کردن به‌عنوان تصویر</translation>
<translation id="8654038583091834120">‏<ph name="EXTENSION_NAME" /> به Agent Chrome اضافه شد</translation>
<translation id="8940723094351907049">‏سفارشی کردن و کنترل Agent Chrome. به‌روزرسانی‌ دردسترس است.</translation>
<translation id="334648248941185659">‏روشن • Agent Chrome نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="611228897408671387">‏حساب شما در Chromium</translation>
<translation id="1961808482688487456">‏مجاز کردن افزونه برای نمایش درخواست‌های دسترسی در نوارابزار Agent Chrome</translation>
<translation id="6880945371922378763">‏<ph name="FILE_NAME" /> خطرناک است، بنابراین Agent Chrome آن را مسدود کرده است.</translation>
<translation id="829957199361894387">‏Agent Chrome به‌زودی بسته می‌شود و داده‌ها را حذف می‌کند</translation>
<translation id="6145820983052037069">‏می‌توانید در اینجا بین نمایه‌های Chromium جابه‌جا شوید</translation>
<translation id="8333733115616087710">‏اگر کوکی‌ها را مجاز کنید، ممکن است Agent Chrome از آن‌ها هنگام پیش‌بارگیری استفاده کند</translation>
<translation id="6165508094623778733">بیشتر بدانید</translation>
<translation id="6173308241973263798">‏داده‌های Chromium ذخیره‌شده در حسابتان را پاک کنید</translation>
<translation id="8439223334931595792">‏این فایل ممکن است خطرناک باشد<ph name="LINE_BREAK" />اگر گذرواژه را ارائه دهید، Agent Chrome می‌تواند این بارگیری را برایتان بررسی کند. اطلاعات فایل به «مرور ایمن Google» ارسال می‌شود، اما محتوای فایل و گذرواژه در دستگاهتان باقی می‌ماند.</translation>
<translation id="6182736845697986886">نصب به‌دلیل وجود خطای داخلی در سرور به‌روزرسانی انجام نشد.</translation>
<translation id="6183079672144801177">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME" /> به سیستم Chromium وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="6212496753309875659">‏این رایانه در حال حاضر دارای یک نسخه جدیدتر از Chromium است. درصورتی‌که نرم‌افزار کار نمی‌کند، لطفاً Chromium را حذف نصب کنید و دوباره سعی کنید.</translation>
<translation id="6375381612105819561">{0,plural, =0{‏Agent Chrome هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏Agent Chrome ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏Agent Chrome ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏Agent Chrome ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="6241367896540709610">‏Chromium برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="6245734527075554892">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Chromium ذخیره شده است مقایسه می‌کند</translation>
<translation id="5070229316792137581">‏Agent Chrome  مرورگر پیش‌فرض شود</translation>
<translation id="6248988683584659830">تنظیمات جستجو</translation>
<translation id="6261803579884938625">‏با برنامه Chromium در تلفنتان، بهترین ویژگی‌های ایمنی Google را درحال حرکت دریافت کنید</translation>
<translation id="6268381023930128611">‏از Chromium خارج می‌شوید؟</translation>
<translation id="6270547683008298381">‏این زبانه‌ها از منابع بیشتری استفاده می‌کنند. برای بهبود عملکرد، اجازه دهید Chromium آن‌ها را غیرفعال کند.</translation>
<translation id="6281746429495226318">‏سفارشی کردن نمایه Chromium</translation>
<translation id="6290827346642914212">‏نام‌گذاری نمایه Chromium</translation>
<translation id="6294831894865512704">‏یکی از افزونه‌ها از شما می‌خواهد به سیستم Chromium وارد شوید</translation>
<translation id="1356965940380155951">‏<ph name="FILE_NAME" /> ممکن است خطرناک باشد، بنابراین Agent Chrome آن را مسدود کرده است.</translation>
<translation id="7321042153033393145">‏Agent Chrome درحال استفاده از دوربین شما است.</translation>
<translation id="6333502561965082103">‏عملیات دیگری در Chromium درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="6334986366598267305">‏اکنون استفاده از Chromium با حساب Google شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="6347002662287820329">‏با تنظیم کردن Chromium به‌عنوان مرورگر پیش‌فرض، به‌راحتی به ویژگی‌هایی که می‌شناسید، دوست دارید، و به آن‌ها اعتماد دارید دسترسی پیدا کنید.</translation>
<translation id="6663103136563143835">‏میان‌بر Agent Chrome</translation>
<translation id="8324836837188781073">‏‫Agent Chrome این بارگیری را مسدود کرد زیرا این فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="6373523479360886564">‏آیا مطمئن هستید که می‌خواهید Chromium را حذف نصب کنید؟</translation>
<translation id="6375219077595103062">میان‌بری به «مدیر گذرواژه» اضافه کنید</translation>
<translation id="6388799252195623474">در این مورد به من کمک کنید</translation>
<translation id="6390800440335263989">‏برای ادامه دادن، با حساب <ph name="EMAIL" /> به سیستم Chromium وارد شوید. با این کار مطمئن می‌شوید که خط‌مشی‌های سازمانتان اعمال شده‌اند.</translation>
<translation id="6400112897226594999">‏نشان‌واره Chromium درون صفحه‌نمایش رایانه.</translation>
<translation id="6403826409255603130">‏‫Chromium یک مرورگر وب است که صفحات وب و برنامه‌ها را با سرعت بسیار زیاد اجرا می‌کند. این مرورگر خیلی سریع و پایدار است کار کردن با آن آسان است. با محافظت دربرابر بدافزار و رمزگیری تعبیه‌شده در Chromium، با امنیت بیشتری وب را مرور کنید.</translation>
<translation id="6414624068245092115">‏برای اینکه مطمئن شوید همیشه می‌توانید از داده‌های Chromium در «حساب Google» خود استفاده کنید و آن‌ها را ذخیره کنید، هویتتان را درستی‌سنجی کنید</translation>
<translation id="5698692159722140301">‏‫Agent Chrome سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند</translation>
<translation id="6436260184216827876">«جستجوی تصویر» دردسترس نیست. بعداً دوباره امتحان کنید.</translation>
<translation id="6442900851116057561">‏بازراه‌اندازی ChromiumOS</translation>
<translation id="1150325299163558144">‏‫Agent Chrome صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="6450948450282634257">‏با بارگیری Chromium در تلفنتان، قیمت‌ها را پیگیری کنید و برای کاهش قیمت در هر سایتی هشدار دریافت کنید</translation>
<translation id="2302438614865168038">‏خاموش • Agent Chrome نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="6455857529632101747">‏به نمایه‌های Chromium خوش‌آمدید</translation>
<translation id="6460614424172581323">‏دفعه بعد که Chromium را در <ph name="DEVICE_TYPE" /> باز می‌کنید، پیام‌واره‌ای برای استفاده از گروه‌های زبانه خواهید دید.</translation>
<translation id="6466344609055215035">‏برداشتن حساب از Chromium</translation>
<translation id="5526497172610025231">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Agent Chrome نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="648319183876919572">«مرور ایمن پیشرفته» کارهای بیشتری برای محافظت از شما درمقابل وب‌سایت‌ها و بارگیری‌های خطرناک انجام می‌دهد</translation>
<translation id="6510925080656968729">‏حذف نصب Chromium </translation>
<translation id="124295298108005714">‏میان‌برها در Agent Chrome باز می‌شود</translation>
<translation id="9177671044583442813">‏اگر <ph name="TIMEOUT_DURATION" /> از Agent Chrome استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="6542839706527980775">‏هرکدام از نمایه‌ها دارای اطلاعات Chromium مختص خودش است (مثلاً نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="6556755379298048869">با میان‌بر صفحه‌کلید جستجو کنید.</translation>
<translation id="5677032436425073715">‏درباره اینکه <ph name="BEGIN_LINK" />Agent Chrome چگونه داده‌های شما را خصوصی نگه می‌دارد<ph name="END_LINK" /> بیشتر بدانید</translation>
<translation id="5967753610833950399">‏پس‌از بازراه‌اندازی Agent Chrome، تغییرات این تنظیم اعمال خواهد شد.</translation>
<translation id="4790842900919490952">‏افزونه‌هایتان را با کلیک کردن روی «افزونه‌ها» در منوِ اصلی Agent Chrome مدیریت کنید.</translation>
<translation id="656935081669708576">‏برای دیدن گذرواژه‌های نمایه Chromium دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="6569556444379005948">‏برای داشتن بهترین ابزارهای هوشواره‌ای درحرکت، از برنامه Chromium استفاده کنید</translation>
<translation id="8124768693572849485">‏برای رفع خطاهای املائی، Agent Chrome نوشتاری را که در فیلد نوشتار تایپ می‌کنید، برای Google ارسال می‌کند</translation>
<translation id="6598877126913850652">‏رفتن به تنظیمات اعلان Chromium</translation>
<translation id="6600016381025017075">هرچیزی در این صفحه را جستجو کنید</translation>
<translation id="1736130262142947818">‏دفعه بعدی که Agent Chrome را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="6637908313088374648">‏اکنون Chromium با شروع Windows راه‌اندازی می‌شود تا بتوانید بلافاصله مرور را شروع کنید. می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="6648212540664651655">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Chromium زبانه‌های جلسه قبلی‌تان را بازگرداند. می‌توانید این ویژگی را در اینجا خاموش کنید:</translation>
<translation id="665732753414869868">‏Chromium برای ایجاد نقشه سه‌بعدی از محیط اطراف شما به اجازه دوربین نیاز دارد</translation>
<translation id="6669284030132180248">‏اگر نشانک‌ها را در «حساب Google» هم ذخیره کنید، می‌توانید قیمت محصولات را در Chromium پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="6676384891291319759">دسترسی به اینترنت</translation>
<translation id="668175097507315160">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromiumOS نتوانست داده‌های شما را همگام‌سازی کند.</translation>
<translation id="6691132793308828750">‏برداشتن داده‌های این برنامه از Chromium</translation>
<translation id="6709350901466051922">‏Chromium برای این سایت به اجازه میکروفون نیاز دارد</translation>
<translation id="6712881677154121168">خطای بارگیری: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="7755971898820142787">‏از نمایهٔ شما نمی‌توان استفاده کرد زیرا دارای نسخه جدیدتری از Agent Chrome است.

برخی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک فهرست راهنمای نمایه دیگری را مشخص کنید یا از نسخه جدیدتری از Agent Chrome استفاده کنید.</translation>
<translation id="6729124504294600478">‏برای گرفتن شخصی‌سازی‌ها و ویژگی‌های دیگر، Chromium را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده Google اضافه کنید</translation>
<translation id="6734291798041940871">‏Chromium از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="6742093177587589736">‏برای دریافت نشانک‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Chromium وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانک در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="7821834337023193240">‏با این کار سرعت سایت‌ها با موتور Agent Chrome نسخه ۸ بالاتر می‌رود اما مقاومت Agent Chrome دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم روشن است.</translation>
<translation id="6754665438209053659">{count,plural, =1{‏برخی‌از داده‌های Chromium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏برخی‌از داده‌های Chromium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏برخی‌از داده‌های Chromium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="67706546131546258">‏Chromium توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="6779406956731413166">‏ارائه ChromiumOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی ممکن شده است.</translation>
<translation id="6831043979455480757">ترجمه</translation>
<translation id="6847869444787758381">‏Chromium می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="684888714667046800">نمی‌توان به اینترنت متصل شد. اگر از دیوار آتش استفاده می‌کنید، لطفاً مطمئن شوید <ph name="PRODUCT_EXE_NAME" /> در فهرست مجازها باشد.</translation>
<translation id="6219638737609534419">Agent Chrome - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">برای ادامه دادن، کلید «جهش» را فشار دهید</translation>
<translation id="6862030660799253820">جستجوی این تصویر با «جستجوی تصویر»</translation>
<translation id="6869568587896659271">دسترسی آسان به وب‌سایت‌های زیر نوار نشانی</translation>
<translation id="7421523967177993052">‏Agent Chrome متوجه شده است که «<ph name="EXTENSION_NAME" />» حاوی بدافزار است</translation>
<translation id="6877155553248388166">‏گوشه پایین سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT" /> سمت چپ، ‎٪<ph name="BOTTOM" /> پایین</translation>
<translation id="6896758677409633944">کپی کردن</translation>
<translation id="6898028264630240901">می‌توانید «تکالیف بافتاری» را سنجاق کنید تا هنگام مرور کردن به‌راحتی سؤالات خود را بپرسید</translation>
<translation id="6901631050894301805">‏‫Chromium را به‌عنوان مرورگر پیش‌فرض خود تنظیم کنید و آن را به نوار وظیفه‌تان سنجاق کنید</translation>
<translation id="6909503629704372277">‏مدیریت نمایه‌های Chromium</translation>
<translation id="9199111398679939226">‏این کنش:
          <ph name="LINE_BREAKS" />
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK" />
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK" />
            • کوکی‌ها و دیگر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAK" />
            • میان‌برهای Agent Chrome را بازنشانی می‌کند
            <ph name="LINE_BREAKS" />
            نشانک‌ها، سابقه، و گذرواژه‌های ذخیره‌شده تحت‌تأثیر قرار نخواهند گرفت.</translation>
<translation id="6948031725951063910">‏به حداکثر تعداد نشانک‌های Chromium (<ph name="BOOKMARK_LIMIT" />) رسیده‌اید، بنابراین برخی‌از نشانک‌هایتان هنوز در «حساب Google» شما ذخیره نشده است.

تا زمانی‌که تعدادی از نشانک‌ها را حذف نکنید، نمی‌توانید نشانک‌های جدید را در حسابتان ذخیره کنید. اگر اکنون از سیستم خارج شوید، نشانک‌های ذخیره‌نشده حذف خواهد شد.</translation>
<translation id="6964305034639999644">‏باز کردن پیوند در پنجره &amp;ناشناس Chromium</translation>
<translation id="6965382102122355670">تأیید</translation>
<translation id="6985329841647292029">‏شرایط ChromiumOS</translation>
<translation id="7003299027384820442">‏برای استفاده از داده‌های Chromium و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL" />)، گذرعبارت خود را وارد کنید</translation>
<translation id="7011190694940573312">نصب انجام نشد زیرا این نسخه از سیستم‌عامل پشتیبانی نمی‌شود.</translation>
<translation id="7024536598735240744">خطای لغو فشرده‌سازی: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7045244423563602563">‏Chromium را برای خود اختصاصی کنید</translation>
<translation id="7047386856539490735">این نتایج مفیدند؟</translation>
<translation id="705851970750939768">‏به‌روزرسانی Chromium</translation>
<translation id="1222890016986172619">‏اگر تصویری توضیح مفیدی نداشته باشد، Agent Chrome توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Google ارسال می‌شود.</translation>
<translation id="7074836723476134809">‏هنگام استفاده از برنامه Chromium در <ph name="DEVICE_TYPE" />، قدرت هوشواره را تجربه کنید</translation>
<translation id="7134687062119989071">‏با برنامه Chromium در تلفنتان، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحال حرکت همراه خود داشته باشید</translation>
<translation id="7141270731789036260">‏سفارشی‌سازی Chrome for Testing</translation>
<translation id="5669948510815930830">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Agent Chrome باز کنید</translation>
<translation id="5576210706466474421">‏حذف <ph name="EXTENSION_NAME" /> از Agent Chrome</translation>
<translation id="4588941330171478873">‏اگر <ph name="TIMEOUT_DURATION" /> از Agent Chrome استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="718435575166326686">‏Chromium برای این سایت به اجازه دوربین نیاز دارد</translation>
<translation id="2916059341902838041">‏Agent Chrome راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="7204669035546236137">‏در همان جایی که هستید، درباره هر چیزی از «Gemini در Chromium» بپرسید</translation>
<translation id="1716746018761150810">‏‫Agent Chrome را در Dock نگه دارید تا هرزمان خواستید سریع به آن دسترسی داشته باشید</translation>
<translation id="7213407614656404070">‏از Chromium برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="7216228761061470870">‏وقتی در رایانه از «جستجوی تصویر» استفاده می‌کنید، عنوان صفحه، نشانی وب، و محتوا ازجمله فایل‌های PDF به سرور ارسال می‌شود.</translation>
<translation id="4816956813330284757">‏مدیر وظایف - Agent Chrome</translation>
<translation id="7227958669698166857">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Chromium وارد شوید. همچنین به اطلاعات ذخیره‌شده و اطلاعات دیگر در همه دستگاه‌هایتان دسترسی خواهید داشت.</translation>
<translation id="7252276985725323153">‏مرور را فوراً شروع کنید: اکنون Chromium می‌تواند هنگام شروع Windows راه‌اندازی شود.</translation>
<translation id="7274695763216404502">سنجاق شد! دفعه بعد «جستجوی تصویر» را از نوارابزار باز کنید</translation>
<translation id="7288567540154601580">زبانه‌ها و افزونه‌ها</translation>
<translation id="3631444715156784168">{NUM_EXTENSIONS,plural, =1{‏Agent Chrome توصیه می‌کند آن را بردارید}one{‏Agent Chrome توصیه می‌کند آن را بردارید}other{‏Agent Chrome توصیه می‌کند آن‌ها را بردارید}}</translation>
<translation id="2739521415810397215">‏برای هم‌رسانی کردن صدای سیستم، «تنظیمات سیستم» را باز کنید و «فقط ضبط صدای سیستم» را برای Agent Chrome مجاز کنید. سپس باید Agent Chrome را بازراه‌اندازی کنید.</translation>
<translation id="1945073734373493421">‏در حال به‌روزرسانی Agent Chrome</translation>
<translation id="7323500970718355745">‏فایل اولویت‌های شما خراب یا نامعتبر است. 
Agent Chrome قادر به بازیابی تنظیمات شما نیست.</translation>
<translation id="7324051657739063017">می‌توانید «تکالیف بافتاری» را دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="734373864078049451">‏وب، نشانک‌ها و موارد دیگر Chromium شما در اینجا هستند.</translation>
<translation id="7347827960336370838">‏فقط شخصی که گذرعبارت شما را دراختیار داشته باشد می‌تواند داده‌های رمزگذاری‌شده‌تان را بخواند. گذرعبارت به Google ارسال نمی‌شود یا توسط آن ذخیره نمی‌شود. اگر گذرعبارت را فراموش کنید یا بخواهید این تنظیم را تغییر دهید، باید <ph name="BEGIN_LINK" />داده‌های Chromium ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK" />.</translation>
<translation id="7994662313190863803">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME" /> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME" />، Agent Chrome را پیکربندی کرده است.</translation>
<translation id="7352651011704765696">مشکلی پیش آمد</translation>
<translation id="4438212735766904761">‏برای دریافت به‌روزرسانی‌های بعدی Agent Chrome، باید macOS نسخه ۱۳ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۲ استفاده می‌کند.</translation>
<translation id="7376384068949534168">‏اخیراً بازدیدی نداشته‌اید. ‫Chromium ‏<ph name="PERMISSION_1" /> و <ph name="PERMISSION_2" /> را برداشت.</translation>
<translation id="73786666777299047">‏باز کردن نت‌بازار Chrome</translation>
<translation id="7394275517973019558">‏نمایش «Gemini در Chromium» در سینی سیستم</translation>
<translation id="7401687852903179959">جستجوی این ویدیو با «جستجوی تصویر»</translation>
<translation id="7407655596887111931">‏‫Chromium اکنون مرورگر پیش‌فرض شما است</translation>
<translation id="3957050361764426740">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Agent Chrome هربار که آن را بازراه‌اندازی کنید، زبانه‌هایتان را بازمی‌گرداند. برای خاموش کردن این ویژگی، به اینجا بروید:</translation>
<translation id="7427879960656355200">‏وارد کردن گذرواژه‌ها به Chromium</translation>
<translation id="744815265653811511">‏۱. روی <ph name="BUTTON_LABEL" /> در زیر کلیک کنید
۲. روی <ph name="BUTTON_2" /> در تنظیمات Windows کلیک کنید
۳. روی <ph name="BUTTON_3" /> در اعلان Windows کلیک کنید تا Chromium را برای دسترسی سریع به نوار وظیفه سنجاق کنید</translation>
<translation id="4378256924846450484"><ph name="PAGE_TITLE" /> - Agent Chrome Dev</translation>
<translation id="7450541714075000668">نوشتار کپی شد</translation>
<translation id="1661210845845599119">‏برای استفاده از میکروفون، در <ph name="BEGIN_LINK" />تنظیمات سیستم<ph name="END_LINK" /> به Agent Chrome دسترسی دهید</translation>
<translation id="7461356015007898716">‏برای دریافت به‌روزرسانی‌های آتی Chromium، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 7 استفاده می‌کند.</translation>
<translation id="7782360127659485548">‏Agent Chrome راه‌اندازی مجدد شود؟</translation>
<translation id="7483335560992089831">‏نمی‌توانید Chromium دارای نسخه مشابه با نسخه در حال اجرا را نصب کنید. لطفاً Chromium را ببندید و دوباره سعی کنید.</translation>
<translation id="7510190804000607802">‏یادآور: بهترین‌های Google در جیب شما</translation>
<translation id="4114725046952451715">‏سایت‌ها احتمالاً عملکرد موردانتظار را خواهند داشت. وقتی همه پنجره‌های Agent Chrome را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Agent Chrome وارد شده باشید از «حساب Google» خارج نخواهید شد.</translation>
<translation id="8460803820751380899">{0,plural, =1{‏Agent Chrome ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏Agent Chrome ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏Agent Chrome ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="7565444033145385702">‏برای محافظت از داده‌هایتان، به Chromium اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند.</translation>
<translation id="7806190892617295204">‏برای شروع فوری مرور، Agent Chrome را به‌طور خودکار راه‌اندازی کنید.</translation>
<translation id="7583399374488819119">نصب‌کننده <ph name="COMPANY_NAME" /></translation>
<translation id="4114499337401148821">‏Agent Chrome درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="7617377681829253106">‏Chromium اکنون بهتر شده است</translation>
<translation id="4075526625511660913">‏اکنون ویژگی‌های بیشتری در Agent Chrome دردسترس شما قرار دارد</translation>
<translation id="7624307931717240213">ما از اطلاعات برای بهبود این سرویس استفاده می‌کنیم. به «خط‌مشی رازداری» و «شرایط خدمات» مراجعه کنید.</translation>
<translation id="7649070708921625228">راهنما</translation>
<translation id="7650134251917003571">‏دریافت برنامه Chromium</translation>
<translation id="7658239707568436148">لغو</translation>
<translation id="5829091955527196771">‏Agent Chrome مرورگر پیش‌فرض شما نیست</translation>
<translation id="7689606757190482937">‏Chromium را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="7699779824407626136">‏به‌روزرسانی Chromium</translation>
<translation id="7700735928747402058">‏کارهای شما در Chromium ایمن است</translation>
<translation id="7716950018788545737">تکلیف(ها) پایان یافت.</translation>
<translation id="77283119132245232">سرویس‌های ردیابی سیستم را برای <ph name="BROWSER_NAME" /> ارائه می‌دهد. اگر این سرویس غیرفعال باشد، ردیابی‌های عملکردی که مرورگر ایجاد می‌کند شامل رویدادهای در سطح سیستم مانند رویدادهای تغییر زمینه و آماده‌سازی رشته نخواهد بود.</translation>
<translation id="7745317241717453663">‏این کار داده‌های محصول مرورتان را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Chromium وارد شوید.</translation>
<translation id="7747138024166251722">نصب‌کننده نتوانست دایرکتوری موقت ایجاد کند. لطفاً فضای خالی دیسک و اجازه نصب نرم‌افزار را بررسی کنید.</translation>
<translation id="7747820849741499258">‏جستجو در Chromium</translation>
<translation id="7750130090210923118">‏بازنشانی به Chromium پیش‌فرض</translation>
<translation id="7752521946322750699">‏برای حفظ امنیت کارهای شما در Chromium، سازمان‌تان می‌تواند اطلاعات خاصی را هنگام ورود به سیستم Chromium مشاهده یا مدیریت کند.</translation>
<translation id="7781047659465034537">‏‫Chromium را به‌عنوان پیش‌فرض تنظیم کنید و آن را به نوار وظیفه سنجاق کنید</translation>
<translation id="7786760609782648049">‏سرعت Chromium را افزایش دهید</translation>
<translation id="1092858669153166534"><ph name="PAGE_TITLE" /> - Agent Chrome Canary</translation>
<translation id="6890902183809417868">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫Agent Chrome برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="7810005234485217901">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید</translation>
<translation id="4343938787674079986">‏انتخاب کردن چیزهایی که می‌خواهید با Agent Chrome هم‌رسانی شود</translation>
<translation id="7828947555739565424">‏درحال‌حاضر یک نمایه Chromium با این حساب در این دستگاه وجود دارد</translation>
<translation id="7845233973568007926">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید رایانه را بازراه‌اندازی کنید.</translation>
<translation id="6129792107484731038">‏موتور جستجوی شما از خارج‌از Agent Chrome تغییر کرد. برای محافظت از شما، Agent Chrome آن را به پیش‌فرض اصلی‌اش بازنشانی کرد. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="7853661403199074278">‏با سفارشی‌سازی Chromium، ظاهری جدید به آن ببخشید</translation>
<translation id="5018331886385637870">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Agent Chrome آنچه تایپ می‌کنید را به موتور جستجوی پیش‌فرض شما ارسال می‌کند تا پیشنهادهای بهتری دریافت کند. این ویژگی در «حالت ناشناس» خاموش است.</translation>
<translation id="473441635289092936">‏Agent Chrome به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="7872446069773932638">درحال بارگیری… <ph name="SECONDS" /> ثانیه باقی مانده است</translation>
<translation id="7873537467422636035">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، <ph name="BEGIN_LINK" />داده‌های Chromium ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK" /></translation>
<translation id="7874369989024033742">‏هر زمان که نیاز داشتید، «Gemini در Chromium» به‌سرعت باز می‌شود</translation>
<translation id="7888981273428720788">‏تنظیم Chromium به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="7934340546140346950">‏‫Chromium اتصال‌های ناامن را درصورت امکان به‌طور خودکار به HTTPS ارتقا می‌دهد</translation>
<translation id="7937630085815544518">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS" /> وارد سیستم Chromium شده‌اید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="7944602660083060118">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Chromium وارد شوید. همچنین نشانک‌ها و اطلاعات دیگر در همه دستگاه‌های شما قابل دسترسی خواهد بود.</translation>
<translation id="688313102897865477">‏این نصب ثانویه Agent Chrome است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>
<translation id="8514782479541580218">‏افزونه‌ها، برنامه‌ها، و زمینه‌های دریافتی از منابع ناشناخته می‌توانند به دستگاهتان آسیب برسانند. Agent Chrome توصیه می‌کند آن‌ها را فقط از <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> نصب کنید</translation>
<translation id="8000759043835159571">‏با برنامه Chromium در <ph name="DEVICE_TYPE" />، بیشترین بهره را از Google ببرید</translation>
<translation id="8004582292198964060">مرورگر</translation>
<translation id="8010081455002666927">شناسایی خودکار</translation>
<translation id="403216574291780144">‏وقتی Agent Chrome دسترسی داشته باشد، وب‌سایت‌ها می‌توانند مجوز دسترسی درخواست کنند.</translation>
<translation id="7835197459694498831">‏‫Agent Chrome را به نوار وظیفه سنجاق کنید تا هرزمان خواستید سریع‌تر به آن دسترسی داشته باشید</translation>
<translation id="80471789339884597">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید همه مرورگرها را بازراه‌اندازی کنید.</translation>
<translation id="8054112667659782652">همیشه نشان دادن میان‌بر «جستجوی تصویر»</translation>
<translation id="8069447462453318634">«سنجاق کردن به نوارابزار» را انتخاب کنید</translation>
<translation id="787536271006179882">‏غیرفعال کردن اجرای Agent Chrome در پس‌زمینه برای برنامه‌ها</translation>
<translation id="80790299200510644">جستجوی تصویر</translation>
<translation id="8086881907087796310">نصب انجام نشد زیرا رایانه شما با حداقل شرایط سخت‌افزاری مطابقت ندارد.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="8105840573057009683">‏Chromium برای این سایت به اجازه مکان نیاز دارد</translation>
<translation id="8107060931443639922">‏دفعه بعد که Chromium را در <ph name="DEVICE_TYPE" /> باز می‌کنید، پیام‌واره‌ای برای فعال کردن هشدارهای ردگیری قیمت خواهید دید.</translation>
<translation id="8117908349476699973">‏با برنامه Chromium در تلفنتان، برای کالاهایی که به آن‌ها علاقه‌مندید هشدار کاهش قیمت دریافت کنید</translation>
<translation id="8118331347066725040">درباره جستجو با «لنز»، بازخورد ارسال کنید</translation>
<translation id="8130609355518033382">‏‫Chromium را مخصوص خودتان کنید</translation>
<translation id="8133124826068723441">‏ChromiumOS نتوانست داده‌هایتان را همگام‌سازی کند زیرا «همگام‌سازی» برای دامنه شما دردسترس نیست.</translation>
<translation id="813913629614996137">درحال مقداردهی اولیه…</translation>
<translation id="8161503455832158203">‏‫«Gemini در Chromium» را با میان‌بر صفحه‌کلید باز کنید.</translation>
<translation id="7109772131778940712">‏شرایط خدمات تکمیلی Agent Chrome</translation>
<translation id="7759642951398174884">‏این فایل خطرناک است، بنابراین Agent Chrome آن را مسدود کرده است.</translation>
<translation id="8177472873527554730">محتوای موردنظر در صفحه پیدا نشد</translation>
<translation id="8200109504272824693">‏برای استفاده از داده‌های Chromium و ذخیره کردن آن‌ها در حسابتان (<ph name="USER_EMAIL" />)، گذرعبارت خود را وارد کنید</translation>
<translation id="820759916613250543">جستجوی این تصویر با «جستجوی تصویر»</translation>
<translation id="8221491193165283816">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان بفرستد، اینجا را کلیک کنید.</translation>
<translation id="5410773870087525304">‏برای استفاده از دوربین، در <ph name="BEGIN_LINK" />تنظیمات سیستم<ph name="END_LINK" /> به Agent Chrome دسترسی دهید</translation>
<translation id="1057772683559103555">‏‫Agent Chrome نمی‌تواند منبع این افزونه را تأیید کند و این افزونه ممکن است ناامن باشد. آن را از Agent Chrome حذف کنید تا دیگر نتواند داده‌های شما را (ازجمله اطلاعات شخصی) در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="1968416200800224093">‏اگر تصویری توضیح مفیدی نداشته باشد، Agent Chrome توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Google ارسال می‌شود. هروقت خواستید می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="8254601181414348851">‏در نمایه جدید به سیستم Chromium وارد می‌شوید؟</translation>
<translation id="8262224117913639129">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Chromium وارد شوید. همچنین گذرواژه‌ها و اطلاعات دیگر را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="8277334259226003205">‏نشان دادن «Gemini در Chromium» در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="8286943863733751221">‏‫Chromium درباره سایت‌ها و بارگیری‌های ناامن <ph name="BEGIN_LINK" />به شما هشدار می‌دهد<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">‏اخیراً بازدیدی نداشته‌اید. ‫Chromium ‏<ph name="PERMISSION" /> را برداشت.</translation>
<translation id="8296236834352487533">‏در برنامه Chromium ویژه iOS، با دوربینتان آنچه را می‌بینید بخرید، ترجمه کنید، و شناسایی کنید</translation>
<translation id="8310603974518734211">‏رمزینه پاسخ‌سریع برای ورود به سیستم Chromium با <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">خطای راه‌اندازی: <ph name="STARTUP_ERROR" />.</translation>
<translation id="2256229026962116267">‏اگر <ph name="TIMEOUT_DURATION" /> از Agent Chrome استفاده نشود، سازمانتان آن را می‌بندد.</translation>
<translation id="8321888067342493336">ذخیره کردن به‌عنوان تصویر</translation>
<translation id="8340674089072921962">‏<ph name="USER_EMAIL_ADDRESS" /> قبلاً از Chromium استفاده می‌کرد</translation>
<translation id="8351551329754447960">‏فعال کردن «مهارت‌ها» در Chromium</translation>
<translation id="8359544530202147897">‏برای ادامه استفاده از داده‌های Chromium ذخیره‌شده در «حساب Google» خود (<ph name="ACCOUNT_EMAIL" />)،‏ Chromium را به‌روز کنید</translation>
<translation id="8360718212975266891">‏برای دریافت به‌روزرسانی‌های آتی Chromium، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8 استفاده می‌کند.</translation>
<translation id="8362914115861174987">ترجمه به</translation>
<translation id="8367705492654390392">هرچه می‌خواهید بپرسید</translation>
<translation id="8370517070665726704">‏حق نشر <ph name="YEAR" /> Google LLC.‎ کلیه حقوق محفوظ است.</translation>
<translation id="8372327902843331129">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Chromium وارد شوید. بعداز اینکه به سیستم وارد شدید، این گذرواژه در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="3962779702290581702">‏سپس باید Agent Chrome را بازراه‌اندازی کنید.</translation>
<translation id="6085013152567092546">‏‫Agent Chrome توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="8142784445734351509">‏این افزونه توسط توسعه‌دهنده آن لغو انتشار شده است و ممکن است ناامن باشد. آن را از Agent Chrome حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="8416884904046428725">‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Google» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Chromium باید هویت شما را تأیید کند. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="7611805576553766531">{0,plural, =1{‏Agent Chrome را ظرف یک روز راه‌اندازی مجدد کنید}one{‏Agent Chrome را ظرف # روز راه‌اندازی مجدد کنید}other{‏Agent Chrome را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="8438543370129609977">‏وقتی از «جستجوی تصویر» استفاده می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به سرور ارسال می‌شود. <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">‏درباره جستجو کردن با «جستجوی تصویر» در Chromium بیشتر بدانید</translation>
<translation id="8453117565092476964">‏بایگانی نصب‌کننده خراب یا نامعتبر است. لطفاً Chromium را دوباره را بارگیری کنید.</translation>
<translation id="8458614432758743027">‏Chromium به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="8463672209299734063">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به Google، به بهبود ویژگی‌ها و عملکرد ChromiumOS کمک کنید.</translation>
<translation id="8471947159125090285">‏برای ذخیره کردن داده‌های Chromium در «حساب Google» خود و استفاده کردن از آن‌ها، هویتتان را درستی‌سنجی کنید</translation>
<translation id="8482493977473846331">‏پیام‌واره‌های ورود به سیستم Chromium را نشان می‌دهد</translation>
<translation id="6049002268233195982">‏نسخه Agent Chrome قدیمی است</translation>
<translation id="6156435126546305838">‏از اینکه Agent Chrome را به‌عنوان مرورگر پیش‌فرض خود انتخاب کردید سپاس‌گزاریم!</translation>
<translation id="8522801943730206384">‏‫Chromium زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید</translation>
<translation id="8525579356836940628">نصب متوقف شد</translation>
<translation id="8545729292258443488">‏با برنامه Chromium در<ph name="DEVICE_TYPE" />، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحرکت همراه خود داشته باشید</translation>
<translation id="8548787790260785208">‏اگر Chromium یکی از گذرواژه‌هایتان را در سرقت اطلاعات شبکه عمومی پیدا کند، هشدار دریافت می‌کنید</translation>
<translation id="8555465886620020932">خطای سرویس: <ph name="SERVICE_ERROR" />.</translation>
<translation id="2713372071612730965">‏برخی‌از ویژگی‌ها و افزونه‌های Agent Chrome دارای میان‌بر هستند. می‌توانید انتخاب کنید که آن‌ها را دوباره روشن کنید.</translation>
<translation id="8556420416730706394">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید؛ روی دکمه «سنجاق کردن» در بالای پانل کناری کلیک کنید</translation>
<translation id="856656450041460113">جستجوی فهرست زبان‌ها</translation>
<translation id="1783040386392706016">‏چندین سازمان Agent Chrome را مدیریت می‌کنند</translation>
<translation id="7921569471494089882">‏حق نشر <ph name="YEAR" /> نویسندگان Agent Chrome. کلیه حقوق محفوظ است.</translation>
<translation id="8601359445272098721">جدید! با انتخاب دکمه «ترجمه کردن صفحه‌نمایش»، می‌توانید هم نوشتار و هم تصاویر روی صفحه‌نمایش را ترجمه کنید</translation>
<translation id="6294059080097269555">‏درحال راه‌اندازی Agent Chrome…</translation>
<translation id="8624541899164515475">«تنظیمات»، در زبانه جدیدی باز می‌شود.</translation>
<translation id="8648201657708811153">‏نمی‌توان Google Chrome for Testing را به‌عنوان مرورگر پیش‌فرض تنظیم کرد.</translation>
<translation id="5652647471010716562">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Agent Chrome یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="8704119203788522458">‏این Chromium شماست</translation>
<translation id="8712637175834984815">متوجه شدم</translation>
<translation id="8719993436687031146">‏به سیستم Chromium وارد می‌شوید؟</translation>
<translation id="8747073452963259673">‏گوشه پایین سمت راست ناحیه جستجو: ‎٪<ph name="LEFT" /> سمت راست، ‎٪<ph name="BOTTOM" /> پایین</translation>
<translation id="878572486461146056">خطای نصب: سرپرست شبکه شما «خط‌مشی گروهی» اعمال کرده است که از نصب جلوگیری می‌کند: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">بعداً به من یادآوری شود</translation>
<translation id="8816416449795340678">‏این سند را با «Gemini در Chromium» هم‌رسانی کنید تا مرور کوتاهی از آن داشته باشید و سؤالات تعقیبی بپرسید</translation>
<translation id="8818550178040858407">‏به سیستم Chromium وارد می‌شوید؟</translation>
<translation id="4188893721116572726">‏تنظیم کردن Agent Chrome به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن به نوار وظیفه</translation>
<translation id="8826492472752484139">روی «مدیر گذرواژه» کلیک کنید</translation>
<translation id="8833697763442816810">‏سیستم ChromiumOS</translation>
<translation id="341256515309503869">‏این زبان برای نمایش منوها، تنظیمات، هشدارها، و نوشتارهای دیگر در Agent Chrome استفاده می‌شود</translation>
<translation id="8862326446509486874">شما حقوق لازم برای نصب در سطح سیستم را ندارید. دوباره به‌عنوان سرپرست نصب‌کننده را اجرا کنید.</translation>
<translation id="8876044221123442390">‏افزودن نمایه Chromium</translation>
<translation id="8890569919834781711">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromiumOS نتوانست داده‌های Chromium را در «حساب Google» شما ذخیره کند</translation>
<translation id="8891709362986793894">‏سازمانتان شما را ملزم می‌کند به سیستم Chromium وارد شوید</translation>
<translation id="8907580949721785412">‏Chromium در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="8932992523185907506">‏‫Chromium دیگر مرورگر پیش‌فرض شما نیست. Chromium  مرورگر پیش‌فرض شود</translation>
<translation id="2086624065931944916">‏به‌روزرسانی Agent Chrome امکان‌پذیر نیست</translation>
<translation id="8944232836376404813">این کنش:
          <ph name="LINE_BREAKS" />
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK" />
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK" />
            • کوکی‌ها و سایر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAKS" />
            نشانک‌ها، سابقه و گذرواژه‌های ذخیره‌شده شما تحت تأثیر قرار نخواهند گرفت.</translation>
<translation id="8966875421152977384">‏نشان دادن میان‌برهای سایت Chromium</translation>
<translation id="4591081057798655502">‏نشان‌واره Agent Chrome Enterprise</translation>
<translation id="8980139959902937527">‏با برنامه Chromium در <ph name="DEVICE_TYPE" />، ایمنی Google را درحرکت داشته باشید</translation>
<translation id="352721818246741864">‏‫Agent Chrome شروع نشد، زیرا هنگام باز کردن نمایه‌تان مشکلی پیش آمد. ‫Agent Chrome را بازراه‌اندازی کنید.</translation>
<translation id="8988036198400390003">‏مدیریت نمایه‌های Chromium</translation>
<translation id="8993855408334954620">‏از صفحه‌کلید برای پیمایش بین «Gemini در Chromium» و زبانه باز استفاده کنید.</translation>
<translation id="9018218886431812662">نصب کامل شد</translation>
<translation id="9019929317751753759">‏برای ایمن‌تر کردن Chromium، افزونه زیر را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست نشده است و ممکن است بدون اطلاع شما اضافه شده باشد، غیرفعال کردیم.</translation>
<translation id="9022552996538154597">‏ورود به سیستم Chromium</translation>
<translation id="9035791714111278917">‏نشان دادن جستجو با Chromium در نوار منو Mac و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="144293525744948128">‏‫Agent Chrome این بارگیری را مسدود کرد زیرا فایل بایگانی حاوی فایل‌های دیگری است که ممکن است بدافزار باشد</translation>
<translation id="9053882453960391422">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Chromium، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید. ‫Chromium برای دسترسی سریع به نوار وظیفه سنجاق خواهد شد.</translation>
<translation id="9056398481763999048">‏با برنامه Chromium در تلفنتان از بهترین ابزارهای هوشواره‌ای Google استفاده کنید</translation>
<translation id="9062666675513499497">‏ورود به سیستم Chromium هنگام وارد شدن به سیستم دیگر سرویس‌های Google</translation>
<translation id="5989671354018094677">‏Agent Chrome به‌طور خودکار بسته شد</translation>
<translation id="5288426372256126088">‏نسخه Agent Chrome قدیمی است</translation>
<translation id="8599483501705081932">{0,plural, =1{‏Agent Chrome یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏Agent Chrome # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏Agent Chrome # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="9106236359747881194">نوشتاری را برای جستجو انتخاب کنید</translation>
<translation id="9106612006984859720">‏برای دریافت به‌روزرسانی‌های آتی Chromium، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8.1 استفاده می‌کند.</translation>
<translation id="6660967356554387137">‏باز کردن پیوند در &amp;برگه جدید Agent Chrome</translation>
<translation id="911206726377975832">داده‌های مرور شما نیز حذف شود؟</translation>
<translation id="9134482777260927479">کمک در تکالیف</translation>
<translation id="9148058034647219655">خارج شدن</translation>
<translation id="356554850028684199">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Agent Chrome می‌تواند هربار که آن را بازراه‌اندازی می‌کنید، زبانه‌هایتان را بازگرداند. برای روشن کردن این ویژگی، به اینجا بروید:</translation>
<translation id="2217675621893057123">‏سرپرست سیستم شما برای باز شدن مرورگر جایگزین برای دسترسی به <ph name="TARGET_URL_HOSTNAME" />، Agent Chrome را پیکربندی کرده است.</translation>
<translation id="7637726452490203009">‏راه‌اندازی مجدد برای به‌روزرسانی Agent Chrome</translation>
<translation id="9190841055450128916">‏Chromium‏ (mDNS ورودی)</translation>
<translation id="924957577793602335">‏شخصی‌سازی کردن Chromium</translation>
<translation id="93478295209880648">‏Chromium ممکن است درست کار نکند زیرا دیگر در Windows XP یا Windows Vista پشتیبانی نمی‌شود</translation>
<translation id="945098430667185067">‏با Chromium، بهترین ویژگی‌های ایمنی Google را در حرکت دریافت کنید.</translation>
<translation id="945522503751344254">ارسال بازخورد</translation>
<translation id="965162752251293939">‏چه‌کسی از Chromium استفاده می‌کند؟</translation>
<translation id="967427899662692980">‏دریافت قوی‌ترین امنیت Chromium</translation>
<translation id="983803489796659991">نصب انجام نشد چون سرور به‌روزرسانی هیچ‌گونه داده درهمی برای برنامه ندارد.</translation>
<translation id="985498048907240953">‏استفاده از Chromium بدون حساب</translation>
<translation id="5192139095541169725">Agent Chrome Authors</translation>
<translation id="989970834842471429">نوشتار یا تصویری را برای جستجو کردن با «جستجوی تصویر» انتخاب کنید</translation>
<translation id="5834693163377136360">‏برای استفاده از مکان، در <ph name="BEGIN_LINK" />تنظیمات سیستم<ph name="END_LINK" /> به Agent Chrome دسترسی دهید</translation>
