<translation id="2199210295479376551">‏برداشتن حساب از Chromium</translation>
<translation id="2201788217099588893">‏برای داشتن بهترین ابزارهای خرید درحرکت، از برنامه Chromium استفاده کنید</translation>
<translation id="2210502920229141283">‏با «مرور ایمن پیشرفته» در Chromium برای iOS، درحرکت ایمن‌تر مرور کنید</translation>
<translation id="2210682093923538346">‏سایت خطرناک. ‫Chromium اعلان‌ها را برداشت.</translation>
<translation id="2236949375853147973">فعالیت‌هایم</translation>
<translation id="2238130810669087193">‏برای دریافت نشانی‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Chromium وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانی در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="2241627712206172106">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و Chromium را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="22571759390241347">‏مهارت‌ها در Chromium</translation>
<translation id="2283803047247799269">این زبانه با «جستجوی تصویر» جستجو شود</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{‏‫Chromium توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Chromium توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Chromium توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="2307973900865360088">‏نگه داشتن در Dock</translation>
<translation id="2313870531055795960">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Chromium ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Chromium ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
<translation id="2356070529366658676">سؤال شود</translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="2361918034042471035">‏افزونه «<ph name="EXTENSION_NAME" />» از شما می‌خواهد به سیستم Chromium وارد شوید</translation>
<translation id="2028456545634496358">‏غیرفعال کردن اجرای Agent Chrome در پس‌زمینه برای برنامه‌ها</translation>
<translation id="2374216753258219393">‏برای استفاده از این افزونه با حساب <ph name="USER_EMAIL_ADDRESS" />، به سیستم Chromium وارد شوید.</translation>
<translation id="2384373936468275798">‏ChromiumOS نتوانست داده‌های شما را همگام‌سازی کند زیرا جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="3040857862310351495">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Agent Chrome به یک «دستگاه میانای انسانی» (HID) دسترسی داشتند}=1{‏یک یا چند افزونه Agent Chrome به یک «دستگاه میانای انسانی» (HID) دسترسی دارند}one{‏یک یا چند افزونه Agent Chrome به # «دستگاه میانای انسانی» (HID) دسترسی دارند}other{‏یک یا چند افزونه Agent Chrome به # «دستگاه میانای انسانی» (HID) دسترسی دارند}}</translation>
<translation id="2401032172288869980">‏Chromium برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="2403703063067034158">خطای راه‌اندازی: فعلاً راه‌اندازی دیگری درحال اجرا است، لطفاً کمی بعد دوباره امتحان کنید.</translation>
<translation id="2418322681019544463">‏پیوندها را از هر برنامه‌ای در Chromium باز کنید و مرورگر را در نوار وظیفه دردسترس نگه دارید</translation>
<translation id="2425157128016763890">‏برای هم‌رسانی این سند با Gemini در Chromium و دریافت مرور کوتاه و پرسیدن سؤالات تعقیبی، روی دکمه «خلاصه کردن» کلیک کنید</translation>
<translation id="2440750600860946460">‏با <ph name="BEGIN_LINK" />ابزارهای Chromium<ph name="END_LINK" />، می‌توانید به‌طور ایمن مرور کنید و کنترل را دردست بگیرید</translation>
<translation id="2449487342837813167">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Chromium وارد شوید. همچنین گذرواژه‌هایتان و اطلاعات دیگر را در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="2451727308784734061">از میان‌بر برای دسترسی سریع به «مدیر گذرواژه» استفاده کنید. می‌توانید میان‌برتان را به صفحه اصلی رایانه یا راه‌انداز برنامه منتقل کنید.</translation>
