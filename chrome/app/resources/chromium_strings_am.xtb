<translation id="9148058034647219655">ውጣ</translation>
<translation id="373308981796873164">ካቆሙበት ይቀጥሉ፦ Shuttle እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት መመለስ ይችላል። ይህን ለማብራት ወደሚከተለው ይሂዱ</translation>
<translation id="4482819741686179260">የእርስዎ የስርዓት አስተዳዳሪ <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ Shuttle ተለዋጭ አሳሽን እንዲከፍት አዋቅረውታል።</translation>
