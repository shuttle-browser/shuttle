<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="1026101648481255140">Орнатуды жалғастыру</translation>
<translation id="1029669172902658969">&amp;ChromiumOS жүйесін жаңарту үшін қайта іске қосу</translation>
<translation id="9022540553404839453">Shuttle осы кеңейтімді қарап шығуды ұсынады</translation>
<translation id="5410799103647685860">Сайт беттегі сілтемелерді құпия түрде алдын ала жүктеуді сұрағанда, Shuttle браузері Google серверлерін пайдаланады. Осылайша жеке деректеріңіз алдын ала жүктелетін сайттан жасырылады, бірақ Google алдын ала жүктелетін сайттарды біледі.</translation>
<translation id="1051793555070215510">Осы 1 минуттық сауалнамаға жауап беру арқылы инкогнито режимін жақсартуымызға көмектесіңіз.</translation>
<translation id="1065672644894730302">Реттеулерді оқу мүмкін емес.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін және параметрлерге жасалған өзгертулер сақталмайды.</translation>
<translation id="2526735598866766848">Ата-анаңыз Shuttle браузері үшін "Сайттарға, қолданбаларға және кеңейтімдерге арналған рұқсаттар" параметрін өшірді</translation>
<translation id="4554538601245550915">Белгілі бір Shuttle функциясын немесе кеңейтімін іздеу үшін мекенжай жолағына оның жылдам пәрменін енгізіп, содан кейін таңдалған пернені басыңыз.</translation>
<translation id="1098493699368672217">Chromium-мен іздеу функциясын жүйелік науада көрсету және пернелер тіркесімін қосу</translation>
<translation id="1104942323762546749">Chromium құпия сөздерді экспорттағысы келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="112640046208448578">Заттарды не орындарды анықтауға және мәтінді көшіруге не аударуға болады. "Сурет іздеу" функциясын пайдаланғанда, беттің скриншоты серверге жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="5857101132283857610">Shuttle әдепкі браузеріңіз болып табылады</translation>
<translation id="1131805035311359397">Құпия сөздеріңіздің ұрланудан және басқа да қауіпсіздік мәселелерінен қаншалықты қорғалғанын тексеру үшін <ph name="BEGIN_LINK" />Chromium браузеріне кіріңіз<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Chromium мәзірін басыңыз.</translation>
<translation id="1157985233335035034">Жақында таңдалған тілдер</translation>
<translation id="1184145431117212167">Орнатылмады, себебі сіздегі Windows нұсқасына қолдау көрсетілмейді.</translation>
<translation id="2517811539192985920">Shuttle туралы ақпарат</translation>
<translation id="1186645291482254714">Телефондағы Chromium арқылы бағаны бақылау туралы хабарландырулар алыңыз</translation>
<translation id="1203500561924088507">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="1232234696885483911">"Сурет іздеу" функциясын ашқан кезде, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге автоматты түрде жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">Аккаунтқа кірсеңіз, Chromium-нен Google аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. Мұны өзгерту үшін "Chromium-дегі аккаунтыңыз" бөліміне өтіңіз.</translation>
<translation id="1244381985120794049">Chromium-дегі Gemini-ды Mac мәзір жолағында көрсету</translation>
<translation id="1257483544893909270">Chromium-дегі Gemini-да экранның бір бөлігін таңдау үшін пернелер тіркесімін пайдаланыңыз.</translation>
<translation id="1262876892872089030">Бұл қойынды әрекетсіз тұрған кезде, Chromium жылдам жұмыс істеуі үшін, жад босатылды. Сіз бұл сайтты әрекетсіз тұру тізімінен әрдайым шығарып отыру опциясын таңдай аласыз.</translation>
<translation id="5920228800659800735">Shuttle жүктеп алуды блоктады, себебі бұл файл қауіпті.</translation>
<translation id="126567311906253476">Gmail не YouTube сияқты Google қызметтеріне <ph name="USER_EMAIL" /> көмегімен кірген кезде, Chromium-ге сол аккаунтпен автоматты түрде кіруге болады.</translation>
<translation id="1287534462498555020">Chromium-ді телефоныңызға орнатыңыз</translation>
<translation id="1290883685122687410">Реттеу қатесі: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Жаңа Chromium профилінің параметрлерін реттеу</translation>
<translation id="132092532143527429">Chromium-дегі Gemini-мен байқап көру</translation>
<translation id="7886367104480106107">Bluetooth құрылғыларын табу үшін Shuttle-ге Bluetooth пайдалану рұқсаты қажет. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">Телефоныңыздағы Chromium-ге кіріңіз</translation>
<translation id="1330562121671411446">Тілді анықтау</translation>
<translation id="1342274909142618978">Деректерді Chromium-нен (<ph name="URL" />) де жою</translation>
<translation id="1345251407431278948">Бекітілді! "Сурет іздеу" функциясына құралдар тақтасындағы жаңа түймені басу арқылы қайта кіруге болады.</translation>
<translation id="1356661055722410047">Жаңалық! Енді экрандағы мәтін мен суреттерді де аудара аласыз.</translation>
<translation id="1383876407941801731">Іздеу</translation>
<translation id="1388276868779258475">Жол-жөнекей шолу үшін Chromium пайдаланыңыз.</translation>
<translation id="141901961143729572">Ойыңызды бөлісіңіз.</translation>
<translation id="1958991777362218128">Терезені бөлісу үшін жүйе параметрлерінде Shuttle-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="1478370723027452770">Chrome for Testing бойынша анықтама алу</translation>
<translation id="1497802159252041924">Орнату қатесі: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Бұл бет қорғалған</translation>
<translation id="8079206111514107729">Shuttle қойындысын бөлісу</translation>
<translation id="154404805518949443">Chromium аккаунтына кіру</translation>
<translation id="1547469039832541117">Ерекшеленген тапсырманы аяқтайды.</translation>
<translation id="5481132473679919711">Shuttle-ді бекіту</translation>
<translation id="1574377791422810894">Chromium-нің қауіпсіздік құралдары</translation>
<translation id="1594928384848033697">Chromium браузері Password Manager-дегі деректеріңізді жоюға рұқсат сұрайды. Рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="9144100729492133749">{COUNT,plural, =0{Жаңартылған нұсқаны қолдану үшін әкімшіңіз Shuttle браузерін қайта іске қосуыңызды талап етеді.}=1{Жаңартылған нұсқаны қолдану үшін әкімшіңіз Shuttle браузерін қайта іске қосуыңызды талап етеді. Инкогнито терезесі қайта ашылмайды.}other{Жаңартылған нұсқаны қолдану үшін әкімшіңіз Shuttle браузерін қайта іске қосуыңызды талап етеді. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="1623563412065267963">Телефондағы Chromium-мен Google-дың барлық мүмкіндігін пайдаланыңыз</translation>
<translation id="1625909126243026060">Chromium-дегі құпиялық пен қауіпсіздікті басқарудың маңызды құралдарын қарап шығыңыз.</translation>
<translation id="1640672724030957280">Жүктеп алынып жатыр…</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" /> (мүше) ретінде кірдіңіз. Аккаунт мәзірін ашу</translation>
<translation id="5133024692341945870">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, Shuttle браузерін кез келген уақытта пайдалана аласыз. Сондай-ақ ол тапсырмалар жолағына бекітіледі.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> браузеріне кеңейтілген құқықтар береді.</translation>
<translation id="1722488837206509557">Бұл жағдайда қолжетімді құрылғылардың арасынан таңдап, оларда контент көрсетуге болады.</translation>
<translation id="5930953237660560582">Shuttle жақын арада браузерді пайдалану деректерін жояды</translation>
<translation id="1736443181683099871">Chromium браузері навигацияларды HTTPS кеңейтіміне жаңартып көреді.</translation>
<translation id="3225043540098941089">Shuttle деректері жойылды</translation>
<translation id="1745121272106313518">Chromium <ph name="REMAINING_TIME" /> кейін қайта қосылады</translation>
<translation id="1749104137266986751">HTTPS қолжетімді болмаған кезде, Chromium сізге ескертпестен, қауіпті байланысты пайдаланады.</translation>
<translation id="4139175757782872962">Shuttle жүйесін фонда іске қосуға рұқсат беру</translation>
<translation id="1779356040007214683">Chromium қауіпсіз ету үшін <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ішінде көрсетілмеген және сізге білдірмей қосылған болуы мүмкін кейбір кеңейтімдерді өшірдік.</translation>
<translation id="1793486931176048546">Chromium-ге жылдам кіру үшін оны тапсырмалар жолағына бекітіңіз. Ол үшін Windows хабарландыруындағы <ph name="BEGIN_BOLD" />Иә<ph name="END_BOLD" /> түймесін басыңыз.</translation>
<translation id="6621264839978531733">Shuttle қайта орнату</translation>
<translation id="1820835682567584003">Chromium <ph name="AUTHENTICATION_PURPOSE" /> қолданып көрейін деп жатыр</translation>
<translation id="183031085822326697">Келесі жолы Chromium-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, Google Password Manager-ді пайдалану туралы нұсқауды көресіз.</translation>
<translation id="1838374766361614909">Іздеуді тазарту</translation>
<translation id="18552579716432081">Браузерді пайдалану деректерін Google аккаунтында сақтай отырып, тек осы құрылғыдан жою үшін <ph name="BEGIN_LINK" />Chromium-де аккаунттан шығыңыз<ph name="END_LINK" />.</translation>
<translation id="1857749206890802997">Жолда жаңа қойындылар тобын ашу немесе жасау үшін телефоныңызға Chromium-ді жүктеп алыңыз.</translation>
<translation id="185970820835152459">Кірген Google аккаунттарыңызды басқара аласыз. Google аккаунттарыңыз Chromium браузері, Play Store, Gmail және тағы басқа қызметтерде пайдаланылады. Егер отбасы мүшесі сияқты әлдебіреудің аккаунтын қосқыңыз келсе, жаңа пайдаланушыны <ph name="DEVICE_TYPE" /> құрылғыңызға қосыңыз. <ph name="LINK_BEGIN" />Толығырақ<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">"Сурет іздеу" функциясымен іздеу</translation>
<translation id="1863837059069884561"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Chromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Бетбелгілер мен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="1880677175115548835">Мәтінді таңдаңыз</translation>
<translation id="1881322772814446296">Бақыланатын аккаунт арқылы кіріп, оның әкімшісіне Chromium профиліңізді басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты Chromium деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME" /> пайдаланушысына байланыстырылады. Бұл деректерді Google аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. Бар Chromium деректерін бөлек ұстау үшін қосымша жаңа профиль жасай аласыз. <ph name="LEARN_MORE" /></translation>
<translation id="1305483712531564950">Shuttle браузері біркелкі айналдыру және бейнекадр жиілігі сияқты фондық әрекеттерді және визуалдық әсерлерді шектеу арқылы батарея қуатын үнемдейді. <ph name="BEGIN_LINK" />Қуат үнемдеу туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">"Chromium-ді жаңарту құралы" қызметі</translation>
<translation id="1911763535808217981">Бұл функцияны өшіріп, Chromium браузеріне кірместен Gmail сияқты Google сайттарын пайдалана беруіңізге болады</translation>
<translation id="1929939181775079593">Chromium жауап бермейді. Қазір қайта іске қосасыз ба?</translation>
<translation id="1933341829955786215">Ұйымыңыз (<ph name="MANAGER" />) Chromium-ге кіруді талап етеді</translation>
<translation id="193439633299369377">Жаңарту күшіне енуі үшін ChromiumOS жүйесін өшіріп қосу керек.</translation>
<translation id="4872059215343855880">Shuttle жүктеп алуды блоктады, себебі бұл файл түрі әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="1953553007165777902">Жүктеп алынып жатыр… <ph name="MINUTE" /> минут қалды.</translation>
<translation id="1220136003951684816">Shuttle әдепкі браузерді анықтай не орната алмайды</translation>
<translation id="197326043290947695">Сурет іздеу функциясымен тиімдірек шолыңыз</translation>
<translation id="1990262977744080398">Неліктен Chromium кейбір файлдарды блоктайтыны туралы ақпарат жаңа қойындыдан ашылады.</translation>
<translation id="1999715455684970349">Chromium бағдарламалық құралын жаңартып отырады. Егер бұл қызмет өшірілген немесе тоқтатылған болса, Chromium бағдарламалық құралыңыз жаңартылмайды. Нәтижесінде қауіпсіздік ақауларын жою мүмкін болмай, функциялар жұмыс істемеуі мүмкін. Бұл қызмет пайдаланылатын Chromium бағдарламалық құралы болмаса, өздігінен жойылады.</translation>
<translation id="2008474315282236005">Құрылғыдан 1 элемент жойылады. Деректерді кейінірек алу үшін Chromium браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="2018879682492276940">Орнатылмады. Қайталап көріңіз.</translation>
<translation id="2039417478970545937">Параметрлер.</translation>
<translation id="2049376729098081731">Google қызметтерінде жекелендірілген мүмкіндіктерді пайдалану үшін Chromium тарихын қосу-қоспау нұсқасын таңдаңыз.</translation>
<translation id="2050698962207788467">Күрделі құпия сөздерді жасауға, сақтауға және автоматты түрде толтыруға көмектесу үшін Chromium-ге ендірілген. Оңай кіру үшін пернелер тіркесімін қосыңыз.</translation>
<translation id="2064856577282482477">Chromium-ге жаңа көрініс беру үшін жаңа қойынды бетіндегі "Chromium-ді бейімдеу" түймесін басыңыз.</translation>
<translation id="4748815521068816647">Shuttle жүктеп алуды блоктады, себебі бұл – алдамшы файл және ол құрылғыңызға күтпеген өзгерістер енгізуі мүмкін.</translation>
<translation id="208726765006323911">Chromium iOS браузерін келесіде ашқанда, <ph name="FEATURE_NAME" /> функциясын пайдаланып көру туралы нұсқауды көресіз.</translation>
<translation id="2099452623287920103">Google аккаунтыңызда сақталған құпия сөздеріңіз бен Chromium-дегі басқа деректеріңіз осы құрылғыдан өшіріледі. Оларды Chromium-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="8053870167789043907">{COUNT,plural, =1{Shuttle 1 минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}other{Shuttle # минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}}</translation>
<translation id="2125838419757773031">Іздеу үшін экран аймағын таңдаңыз.</translation>
<translation id="2126108037660393668">Жүктеп алынған файл растаудан өтпеді.</translation>
<translation id="2135919691573380097">Осы сайт туралы шағымдану</translation>
<translation id="2137162749895930932">Аударма экранын жабу</translation>
<translation id="8598177558941030115">Shuttle жүктеп алуды блоктады, себебі сайтта қауіпсіз байланыс пайдаланылып жатқан жоқ және файл өзгертілген болуы мүмкін.</translation>
<translation id="2170098639895543546">Беттен кез келген нәрсені таңдау</translation>
<translation id="2174178932569897599">Chromium-ді реттеу</translation>
<translation id="2174917724755363426">Орнату аяқталмады. Шынымен бас тартқыңыз келе ме?</translation>
<translation id="2629211622516729574">Shuttle – Желіге кіру - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Жаңа нұсқаны тексеру қатесі: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Аккаунтты Chromium-нен өшіру</translation>
<translation id="2201788217099588893">Үздік сатып алу құралдарын жол-жөнекей алып жүру үшін Chromium пайдаланыңыз.</translation>
<translation id="2210502920229141283">iOS жүйесіне арналған Chromium-дегі Күшейтілген Safe Browsing деректеріңізді фондық режимде қорғауға көмектеседі.</translation>
<translation id="2210682093923538346">Сайт қауіпті. Chromium хабарландыруларды өшірді.</translation>
<translation id="2236949375853147973">Әрекеттерім</translation>
<translation id="2238130810669087193">Мекенжайлар мен басқа ақпаратты барлық құрылғыдан алу үшін Chromium аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл мекенжай Google аккаунтыңызға сақталады.</translation>
<translation id="2241627712206172106">Компьютерді бөлісетін болсаңыз, достарыңыз интернетке бөлек кіріп, Chromium жүйесін қалауынша орната алады.</translation>
<translation id="22571759390241347">Chromium-дегі дағдылар</translation>
<translation id="2283803047247799269">Бұл қойындыны сурет іздеу функциясымен іздеу</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Chromium браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{Chromium браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="2307973900865360088">Бекітілген күйде қалдыру</translation>
<translation id="2313870531055795960">URL мекенжайларын Chromium браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді. Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, Chromium браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="2356070529366658676">Сұрау</translation>
<translation id="2359808026110333948">Жалғастыру</translation>
<translation id="2361918034042471035">"<ph name="EXTENSION_NAME" />" кеңейтімін қолдану үшін Chromium-ге кіруіңіз керек</translation>
<translation id="2875952783855795871">Shuttle-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="2374216753258219393">Бұл кеңейтімді <ph name="USER_EMAIL_ADDRESS" /> ретінде пайдалану үшін Chromium-ге кіріңіз.</translation>
<translation id="2384373936468275798">ChromiumOS деректеріңізді синхрондай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="2792662518458751900">{NUM_DEVICES,plural, =0{1 HID құрылғысын бір немесе бірнеше Shuttle кеңейтімі пайдаланды}=1{1 HID құрылғысын бір немесе бірнеше Shuttle кеңейтімі пайдаланып жатыр}other{# HID құрылғысын бір немесе бірнеше Shuttle кеңейтімі пайдаланып жатыр}}</translation>
<translation id="2401032172288869980">Chromium бұл сайт үшін камера мен микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="2403703063067034158">Іске қосу қатесі: қазір басқа орнату процесі жүріп жатыр, әрекетті кейінірек қайталаңыз.</translation>
<translation id="2418322681019544463">Кез келген қолданбадағы сілтемелерді Chromium-нен ашып, браузерді тапсырмалар жолағында қолжетімді етіп қойыңыз.</translation>
<translation id="2425157128016763890">Қысқаша мазмұнын біліп, қосымша сұрақтар қою мақсатында бұл құжатты Chromium-дегі Gemini-мен бөлісу үшін "Қысқаша мазмұндау" түймесін басыңыз.</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-дегі құралдар<ph name="END_LINK" /> көмегімен браузерді қауіпсіз қолданып, барлығын басқаруға болады.</translation>
<translation id="2449487342837813167"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Chromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Құпия сөздер мен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="2451727308784734061">Password Manager қызметіне жылдам өту үшін таңбашаны пайдаланыңыз. Таңбашаны компьютердің негізгі экранына немесе қолданбаларды іске қосу тақтасына жылжытуға болады.</translation>
<translation id="2236435189491185832">Shuttle жақын арада жабылады</translation>
<translation id="8393832920806146440">Shuttle аясында</translation>
<translation id="2485422356828889247">Жою</translation>
<translation id="2513154137948333830">Өшіріп қосу қажет: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">"Сурет іздеу" функциясымен мәтінді таңдаңыз.</translation>
<translation id="2554739539410784893">Chromium бұрыннан бар құпия сөздерді ауыстырғысы келеді. Бұған рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="2560420686485554789">Файлдарды жүктеп алу үшін Chromium браузеріне сақтау орнын пайдалану құқығы қажет</translation>
<translation id="2562045627058601347">Shuttle Helper</translation>
<translation id="2575822587468774919">"Сурет іздеу" функциясымен іздеу керек кез келген нәрсені таңдаңыз.</translation>
<translation id="2576118232315942160">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін Chromium аккаунтына кіріңіз.</translation>
<translation id="2587622539943955767">Chromium браузерін жүктеп алу және Google аккаунтына кіру үшін телефонмен QR кодын сканерлеңіз.</translation>
<translation id="4702236029576678227">Shuttle-ді пайдалана беру</translation>
<translation id="259935314519650377">Жүктеп алынған орнату құралы кэштелмеді. Қате: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Жүйе</translation>
<translation id="2629740064077610681">Ұйымыңыз сіздегі бетбелгілер, тарих және құпия сөздер сияқты браузерді пайдалану деректерін көріп, басқара алады. Ол басқа Chromium профильдеріндегі браузерді пайдалану деректерін көре алмайды.</translation>
<translation id="2635452620547538388">Chromium деректерін <ph name="ACCOUNT_EMAIL" /> аккаунтында қолдану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="8493546940144832853">{COUNT,plural, =0{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін Shuttle-ді қайта іске қосуыңызды талап етеді.}=1{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін Shuttle-ді қайта іске қосуыңызды талап етеді. Инкогнито терезесі қайта ашылмайды.}other{Күшейтілген қорғаныс функциясы жаңартуды қолдану үшін Shuttle-ді қайта іске қосуыңызды талап етеді. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="263863604136125912">Chromium-ді іске қосу</translation>
<translation id="2648074677641340862">Орнату барысында операциялық жүйе қатесі орын алды. Chromium қайта жүктеңіз.</translation>
<translation id="2661879430930417727">Құрылғыңызды басқа адамдар да пайдаланатын болса, достарыңыз және отбасыңыздың мүшелері интернетке бөлек кіріп, Chromium параметрлерін өздері қалағандай орната алады.</translation>
<translation id="2676569452213089702">Chromium кішірейтілсе де, Chromium-дегі Gemini-ға құрылғыңызда оңай кіріп, пайдаланыңыз.</translation>
<translation id="1290871231853377661">Shuttle қойындысы</translation>
<translation id="2718390899429598676">Қосымша қауіпсіздік үшін Chromium деректеріңізді шифрлайды.</translation>
<translation id="2721354645805494590">Chromium-нен Google аккаунтын өшіру үшін аккаунттан шығыңыз.</translation>
<translation id="2722636413143664436">Құпия сөздерді, бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін Chromium аккаунтына кіріңіз.</translation>
<translation id="2738871930057338499">Интернетке қосылу мүмкін емес. HTTP 403 бойынша тыйым салынған. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="2753623023919742414">Іздеу үшін басыңыз.</translation>
<translation id="8088988796099973210">Shuttle-ді әдепкі PDF көру құралы ретінде орнату</translation>
<translation id="2218752565776962982">Бұл кеңейтімде зиянды бағдарлама бар болғандықтан, ол қауіпті. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Shuttle-нан жойыңыз.</translation>
<translation id="2799223571221894425">Қайта іске қосу</translation>
<translation id="7485171825548475983">Сіздің Shuttle браузеріңіз</translation>
<translation id="2816462166102338036">Бұл бейнені сурет іздеу функциясымен іздеу</translation>
<translation id="282591729717417030">Жол-жөнекей iOS-тегі Chromium арқылы камерамен тауарларды тауып, бағаның төмендеуін бақылап, басқа да әрекеттерді орындаңыз.</translation>
<translation id="2841525013647267359">Бастапқы тіл</translation>
<translation id="2846251086934905009">Орнату қатесі: орнату аяқталмады, оның орнына доғарылды.</translation>
<translation id="2847479871509788944">Chromium жүйесінен алып тастау…</translation>
<translation id="2850691299438350830">Аккаунтқа кірген кезде, Chromium браузерінде қауіпсіздігіңізді қамтамасыз етеді және басқа Google қолданбаларында қауіпсіздік деңгейін арттыру үшін пайдаланылуы мүмкін.</translation>
<translation id="2885378588091291677">Тапсырмалар реттегіші</translation>
<translation id="4736743449957355772">&amp;Shuttle туралы</translation>
<translation id="2915996080311180594">Кейін қайта қосу</translation>
<translation id="2933336679234709858">Деректер құпия фразаңызбен шифрланды. Google аккаунтыңызда Chromium деректерін пайдалану және сақтау үшін оны енгізіңіз.</translation>
<translation id="2945997411976714835">Орнату қатесі: орнату процесі басталмады.</translation>
<translation id="2948852018303413228">iOS жүйесіне арналған Chromium-де сақталған құпия сөздер арқылы сайттарға жылдам кіріңіз.</translation>
<translation id="5394294335480248696">Shuttle-ді ұйымыңыз басқарады</translation>
<translation id="6474149732639814113">Shuttle жаңартылған</translation>
<translation id="2977506796191543575">Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, Chromium браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="2981563588585023386">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін Chromium-ге кіріңіз.</translation>
<translation id="3003694935412297923">Барлық тапсырма</translation>
<translation id="3012615494352020668">{count,plural, =1{Chromium браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{Chromium браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="6798600078593703276"><ph name="URL" /> сілтемесі Shuttle-дегі жаңа қойындыдан ашылады.</translation>
<translation id="302551344979399011">Дағдылар сияқты ЖИ инновациялары Google аккаунтыңызға сақталады және Chromium Sync-тен бөлек басқарылады.</translation>
<translation id="2572386815899642990">Shuttle жүйесіне қосылуда…</translation>
<translation id="3038232873781883849">Сәлден соң орнатыла бастайды…</translation>
<translation id="3045032126857188731">Аударма тілі: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">"Пікір" диалогтік терезесін жабу</translation>
<translation id="3068187312562070417">Басқа Chromium профильдері</translation>
<translation id="3068290154869370196">Кеңейтімдер – Chromium браузерін бейімдеуге мүмкіндік беретін қосымшалар. Олар Chromium-ді өзіңізге ыңғайлы етіп реттеуге, күнделікті тапсырмаларды жеңілдетуге көмектеседі.</translation>
<translation id="1841107660132296794">Google компаниясына жаңылыс туралы есептер және <ph name="UMA_LINK" /> жіберу арқылы Shuttle жақсартуға көмектесіңіз</translation>
<translation id="3071024987058544609">Жол-жөнекей Google қауіпсіздігін қамтамасыз ету үшін Chromium пайдаланыңыз.</translation>
<translation id="3739686665197813096">{NUM_DEVICES,plural, =0{1 USB құрылғысын бір немесе бірнеше Shuttle кеңейтімі пайдаланды}=1{1 USB құрылғысын бір немесе бірнеше Shuttle кеңейтімі пайдаланып жатыр}other{# USB құрылғысын бір немесе бірнеше Shuttle кеңейтімі пайдаланып жатыр}}</translation>
<translation id="2502156653706673977">Shuttle тарихы</translation>
<translation id="3103660991484857065">Орнату құралы мұрағаттан шығара алмады. Chromium қолданбасын қайта жүктеңіз.</translation>
<translation id="310459126943037700">Тапсырмалар аяқталмады.</translation>
<translation id="3104828284009500087">Беттегі кез келген нәрсені іздеңіз.</translation>
<translation id="3126784891977756556">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді Chromium-ге жаңартып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз.</translation>
<translation id="1074920430236894401">Shuttle микрофоныңызды пайдалануда.</translation>
<translation id="3130333203120345554">Жаңадан іздеу</translation>
<translation id="3137969841538672700">Іздеу үшін курсорды жүргізіңіз.</translation>
<translation id="3144188012276422546">Бұл қойынды ресурстарды көп қолданып жатыр. Өнімділікті жақсарту үшін Chromium-ге оны әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="6825554846760229393">Экранды бөлісу үшін жүйе параметрлерінде Shuttle-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="3761350857202901706">Shuttle қолданбасын қайта іске қосу</translation>
<translation id="3161522574479303604">Барлық тіл</translation>
<translation id="3179665906251668410">Сілтемені Chromium инкогнито терезесінде ашу</translation>
<translation id="3185330573522821672">Жаңа Chromium профилін реттеңіз.</translation>
<translation id="3189205223539394158">Қойындыларды ауыстырмай-ақ ЖИ режимінде сөйлесе беруге болады. Бастау үшін Chromium-ге кіріңіз. Құпия сөздер мен басқа деректеріңіз барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="3224847870593914902">Chromium-нен Google аккаунтын өшіру үшін Chromium-нен "Параметрлер" бетінде шығыңыз.</translation>
<translation id="3234316605225071811">Кейінірек Chromium сізден үлгілерді автоматты түрде толтыру үшін сақталған ақпаратты пайдалану-пайдаланбау қажеттігін сұрауы мүмкін.</translation>
<translation id="9058828139997344018">Shuttle өзінің деректер каталогін оқи және оған жаза алмайды:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">Таңдаулы Google AI құралдарын iOS-тегі Chromium-де жол-жөнекей алып жүріңіз.</translation>
<translation id="3286538390144397061">Қазір қайта іске қосу</translation>
<translation id="8765302055862543686">Google API пернелері жоқ. Кейбір Shuttle функциялары өшіріледі.</translation>
<translation id="4826503398521877963">Shuttle жабылғанда, фондық қолданбаларды пайдалануды жалғастыру</translation>
<translation id="3313189106987092621">Chromium кез келген сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="3316771292331273802">Chromium-де аккаунтқа кірген болсаңыз, барлық Chromium терезесін жапқан кезде, Google аккаунтын қоспағанда, сайттардың көпшілігінен шығарыласыз. Сайттар сізді есте сақтасын десеңіз, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">іздеу аймағының жоғарғы оң жақ бұрышы: оң жақ <ph name="RIGHT" />%, жоғарғы жақ <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Аккаунтыңыздағы Chromium деректері</translation>
<translation id="3375770072980084583">Құпия сөздерді телефондағы Chromium-мен пайдаланыңыз</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3406848076815591792">Бұрыннан бар Chromium профиліне ауыстырылсын ба?</translation>
<translation id="3412460710772753638">Осы құрылғыдағы Құпия сөз менеджерінде</translation>
<translation id="3438772217992559640">Бұл қойындыны сурет іздеу функциясымен іздеу</translation>
<translation id="3455907671758333080">Телефоныңыздағы Chromium браузерімен күшейтілген Safe Browsing мүмкіндіктерін кеңейтіңіз</translation>
<translation id="3461644266919055473">Chromium-ді сізге бейімдеп жатырмыз...</translation>
<translation id="3474745554856756813">Құрылғыдан <ph name="ITEMS_COUNT" /> элемент жойылады. Деректерді кейінірек алу үшін Chromium браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> арқылы Chromium профильдерін ауыстыруға болады.</translation>
<translation id="3509308970982693815">Барлық Chromium терезелерін жауып, әрекетті қайталап көріңіз.</translation>
<translation id="5876629139177327931">Терезені бөлісу үшін жүйе параметрлерінде Shuttle-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="3530103706039034513"><ph name="EXISTING_USER" /> әлдеқашан кірді.  Браузерді пайдалану тарихын бөлек сақтау үшін Chromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз.</translation>
<translation id="3531741627422851418">Chromium браузерін мобильдік құрылғыларға жүктеп алуға арналған QR коды</translation>
<translation id="354621070532799440">Еске салғыш: Google-дың ең үздік қауіпсіздік функциялары қалтаңызда болады</translation>
<translation id="2337565425943560376">Экранды бөлісу үшін жүйе параметрлерінде Shuttle-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="4821889377524170187">Күшейтілген қорғаныс Shuttle танымайтын сайттар үшін JavaScript оңтайландыру мүмкіндігін өшіреді.</translation>
<translation id="3597003331831379823">Реттеуді кеңейтілген құқықтармен бастау мүмкін болмады. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">Chromium аккаунтына кіріңіз</translation>
<translation id="3639635944603682591">Бұл пайдаланушының браузерді пайдалану деректері құрылғыдан жойылады. Деректерді қалпына келтіру үшін Chromium браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="1300475218926632111">{COUNT,plural, =0{Shuttle браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады.}=1{Shuttle браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады. Инкогнито терезесі қайта ашылмайды.}other{Shuttle браузерінің жаңа нұсқасы шықты. Ол браузерді өшіріп, қайта іске қосқанда орнатылады. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="3667616615096815454">Орнату мүмкін болмады, себебі сервер қолданбаны анықтай алмады.</translation>
<translation id="3675854891107786059">Google аккаунтындағы барлық Chromium дерегін шифрлау үшін <ph name="BEGIN_LINK" />жеке құпия фразаны<ph name="END_LINK" /> пайдаланыңыз. Google Pay қызметіндегі төлеу әдістері мен мекенжайлары шифрланбайды. Chromium-нің браузерді қолдану тарихы синхрондалмайды.</translation>
<translation id="5274497473086430153">{COUNT,plural, =0{Жаңартылған нұсқасын қолдану үшін әкімші Shuttle-ді қайта іске қосуыңызды сұрайды.}=1{Жаңартылған нұсқасын қолдану үшін әкімші Shuttle-ді қайта іске қосуыңызды сұрайды. Инкогнито терезесі қайта ашылмайды.}other{Жаңартылған нұсқасын қолдану үшін әкімші Shuttle-ді қайта іске қосуыңызды сұрайды. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="6123757042710639920">Сілтемені жаңа Shuttle қойындысында ашу</translation>
<translation id="3728124580182886854">Жекелендіру және басқа мақсаттарды орындау үшін Chromium мен басқа Google қызметтерін байланыстырыңыз.</translation>
<translation id="3729187154190517324">"Қойынды және т.б. қосу" түймесін басып, бірнеше қойынды, файл және құрал қосып, жан-жақты іздеңіз.</translation>
<translation id="3788675262216168505">Chromium профильдерін басқару</translation>
<translation id="4583231988142868515">Неліктен Shuttle кейбір жүктеп алынғандарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="379589255253486813">Тексеруге қажетті нәрсе болса, Chromium сізге хабар береді</translation>
<translation id="9161544906744429402">Shuttle сіз кіруіңіз мүмкін беттерді алдын ала жүктейді, сонда оларға кірген кезіңізде, тезірек жүктеледі.</translation>
<translation id="3810973564298564668">Басқару</translation>
<translation id="3823384748599722168">Сақталған құпия сөздерді пайдалану үшін QR кодын қолданып, iOS-ке арналған Chromium браузерін жүктеп алып, Google аккаунтына кіріңіз.</translation>
<translation id="3846683726093018685">**Қысқаша мазмұндау:** скриншоттағы контенттің негізгі тақырыбы мен мақсатын 30 сөзден аспайтын бір сөйлеммен сипатта.

          **Сұрақтар ұсыну:** пайдаланушының скриншотты жете түсінуіне көмектесетін, ой тудыратын 3–5 сұрақтан тұратын таңбаланған тізім жаса. Бұл сұрақтардың кемінде біреуі нақты визуалдық нысан, оның дизайны немесе орналасуы туралы болуы керек.</translation>
<translation id="4250996466392346267"><ph name="PAGE_TITLE" /> – Shuttle</translation>
<translation id="387514319934708384">Chromium бұл сайт үшін жергілікті желіні пайдалануға рұқсат сұрайды</translation>
<translation id="3885770153807205175">Тіл таңдағыш</translation>
<translation id="3870879982795295801">Shuttle-ді реттеу және басқару. Назар аударуыңыз қажет. Толығырақ ақпарат алу үшін басыңыз.</translation>
<translation id="3889543394854987837">Chromium ашу үшін атыңызды басып, шарлауды бастаңыз.</translation>
<translation id="3892148308691398805">Мәтінді көшіру</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> бұл Chromium профиліне кіріп қойған. Браузерді пайдалану деректерін бөлек сақтау үшін Chromium сізге жеке профиль жасай алады.</translation>
<translation id="2803413259281481072">Бұл кеңейтім Chrome Web Store саясатына қайшы, сондықтан қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Shuttle-нан жойыңыз.</translation>
<translation id="3941890832296813527">Орнату қатесі: орнату файлының атауы жарамсыз немесе оған қолдау көрсетілмейді.</translation>
<translation id="3945058413678539331">Chromium құпия сөздерді көшіргісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="3954172517175569325">Google аккаунтыңызға сақтаған құпия сөздер, төлеу әдістері және мекенжайлар осы құрылғыдан өшіріледі. Оларды Chromium-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="395904275706073188">Қорғалған беттерді оқу мүмкін емес. Басқа бетті байқап көріңіз.</translation>
<translation id="3962647064319009959">Chromium сізді қалай қорғайтыны туралы ақпарат алыңыз</translation>
<translation id="3967822245660637423">Жүктеп алынды</translation>
<translation id="8478344872731892094">Мекенжай жолағына немесе іздеу өрісіне терген кезіңізде, Shuttle ұсыныстар алу үшін терген нәрсеңізді ұйымның іздеу жүйесіне, жасанды интеллектіге және агент құралдарына жібереді.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing туралы</translation>
<translation id="3997429360543082038">ChromiumOS туралы</translation>
<translation id="1813754478883624120">Сайтқа кірген кезіңізде, Shuttle браузері URL мекенжайының обфускация жасалған бөлігін IP мекенжайыңызды жасыратын құпиялық сервері арқылы <ph name="BEGIN_LINK" />Google Safe Browsing-ге<ph name="END_LINK" /> жібереді. Сайтта күдікті әрекеттер орындалса, толық URL мекенжайлары және беттегі контент бөліктері де жіберіледі.</translation>
<translation id="4016217212818346953">Password Manager-мен қауіпсіздікті сақтаңыз</translation>
<translation id="4019629340646866719">ChromiumOS жүйесі де <ph name="BEGIN_LINK_LINUX_OSS" />Linux әзірлеу ортасы<ph name="END_LINK_LINUX_OSS" /> сияқты <ph name="BEGIN_LINK_CROS_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="4022972681110646219">Экран мазмұнын аудару</translation>
<translation id="4023601594785368013">Түпнұсқа тілі: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Кез келген қолданба сілтемесін Chromium-нен ашыңыз. Оңай қол жеткізу үшін ол тапсырмалар жолағына бекітіледі.</translation>
<translation id="3334942702828280015"><ph name="BEGIN_LINK" />Ағымдағы параметрлерді<ph name="END_LINK" /> хабарлау арқылы Shuttle браузерін жақсартуға көмектесіңіз</translation>
<translation id="4050175100176540509">Соңғы нұсқасында қауіпсіздік жақсартылып, жаңа мүмкіндіктер берілген.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="4210170830543121132">{COUNT,plural, =1{Shuttle 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}other{Shuttle # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}}</translation>
<translation id="4118474109249235144">Chromium-нің инкогнито режимі</translation>
<translation id="4122186850977583290">"Chromium туралы ақпарат" бетіне өту</translation>
<translation id="4135244987012252068">Браузеріңізге жаңа көрініс беру үшін Chromium-ді бейімдеңіз</translation>
<translation id="4147856324248078748">Chromium браузеріңізді бейімдеңіз</translation>
<translation id="4148957013307229264">Орнатылуда…</translation>
<translation id="6643591336183767153"><ph name="PAGE_TITLE" /> –Желіге кіру – Shuttle</translation>
<translation id="8999328492520314624">Shuttle үшін тамаша қолданбалар, ойындар мен тақырыптарды таба аласыз.</translation>
<translation id="4217080900579554343">Осы кеңейтімді және тағы басқасын компьютерлеріңізге орнату үшін Chromium аккаунтына кіріңіз.</translation>
<translation id="4217972271355023382">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін <ph name="USER_EMAIL_ADDRESS" /> ретінде кірген Chromium профиліңізге ауысыңыз.</translation>
<translation id="4222932583846282852">Бас тартылуда…</translation>
<translation id="4224210481850767180">Орнату тоқтатылды.</translation>
<translation id="4230135487732243613">Chromium дерегіңізді осы аккаунтпен байланыстырасыз ба?</translation>
<translation id="2078444352649860973">Стандартты қорғанысқа қарағанда сайттардағы көбірек деректерді талдау арқылы қауіпті сайттар, тіпті Google-ға бұрын белгісіз болған сайттар туралы ескертеді. Shuttle ескертулерін өткізіп жіберуді таңдауға болады.</translation>
<translation id="4269093074552541569">Chromium-нен шығу</translation>
<translation id="5558993553168424235">Shuttle жөнінде анықтама алу</translation>
<translation id="4281844954008187215">Қызмет көрсету шарттары</translation>
<translation id="4285930937574705105">Орнату анықталмаған қате себебінен сәтсіз аяқталды. Ағымда Chromium жұмыс істеп тұрса, оны жауып, әрекетті қайталаңыз.</translation>
<translation id="4298125729853015961">Құпия сөздерді Chromium-нен экспорттау</translation>
<translation id="4304713468139749426">Құпия сөздер реттегіші</translation>
<translation id="4334241893986177674">Осы скриншотты іздеу</translation>
<translation id="4368547723231502008">Chromium кішірейтілсе де, кез келген жерден іздеңіз және сұрақ қойыңыз.</translation>
<translation id="5810569516587906396">Windows жұмысын бастағанда, Shuttle-ді іске қосады</translation>
<translation id="4400772909124543403">Ешқандай жаңарту жоқ.</translation>
<translation id="3931397122598189404">Shuttle браузерінен бәрібір шығасыз ба?</translation>
<translation id="4413205837991854510">"Сурет іздеу" жылдам пәрменін үнемі көрсету</translation>
<translation id="8644661686228434842">Shuttle браузеріне фондық режимде жұмыс істеуге рұқсат беру</translation>
<translation id="603827111501511568">{NUM_EXTENSIONS,plural, =1{Shuttle оны өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" />}other{Shuttle оларды өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" />}}</translation>
<translation id="8695231474189911275">Shuttle реттеу және басқару</translation>
<translation id="4427306783828095590">Жақсартылған қорғаныс фишинг пен зиянды бағдарламаларды бөгеуде көбірек істейді.</translation>
<translation id="4434353761996769206">Орнату құралының қатесі: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3897345295068202634">Shuttle-ді <ph name="MANAGER" /> басқарады</translation>
<translation id="444069871276811466">Chromium профилін қосу</translation>
<translation id="4447409407328223819">Chrome for Testing туралы</translation>
<translation id="4470974262661801543">Google аккаунтыңызда Chromium деректерін пайдалану және сақтау үшін құпия фразаңызды енгізіңіз.</translation>
<translation id="4493028449971051158">Іске қосу қатесі: орнату құралын әкімші ретінде іске қосыңыз.</translation>
<translation id="4501471624619070934">Орнату мүмкін болмады, себебі бұл елде кіруге шектеу қойылған.</translation>
<translation id="7538943987967358068">Бұл кеңейтім пайдаланушы деректерін қалай жинап, қолданатыны сияқты құпиялық шараларын жарияламаған. Shuttle оны өшіруге кеңес береді.</translation>
<translation id="452711251841752011">Chromium браузеріне қош келдіңіз! Жаңа браузер терезесі ашылды.</translation>
<translation id="4531137820806573936">Chromium-ге айналаңызды картаға түсіруге және қолыңызды бақылауға рұқсат қажет.</translation>
<translation id="4536805923587466102">Басқа Chromium профилінде әлдеқашан <ph name="USER_EMAIL_ADDRESS" /> ретінде кіргенсіз.</translation>
<translation id="7291454099139632344">Shuttle беттерді алдын ала жүктейді, осылайша браузерді пайдалану және іздеу әрекеті тез жүреді. <ph name="BEGIN_LINK" />Беттерді алдын ала жүктеу туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Зиянды деп ойлаған сайт туралы шағымданғанда, онлайн қауіпсіздікті барлық пайдаланушы үшін жақсартыңыз.</translation>
<translation id="4229052424516163100">Shuttle жүктеп алуды блоктады, себебі Safe Browsing функциясы өшірілді және файлды растау мүмкін емес.</translation>
<translation id="4583692638088316420">Телефоныңыздағы Chromium-мен Google Lens-ді пайдаланып көріңіз</translation>
<translation id="4594305310729380060">Осы құрылғыдағы Құпия сөз менеджеріне</translation>
<translation id="4559123577107659130">Shuttle қолданбалары</translation>
<translation id="4598116752460667024">Тізімнен кез келген процесті іздейді.</translation>
<translation id="4613863813562375431">ChromiumOS нұсқасы</translation>
<translation id="8540523969518172575">Сәл қалды! Жаңартуды аяқтау үшін Shuttle жүйесін қайта іске қосыңыз.</translation>
<translation id="2509032609305193511">Shuttle-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Shuttle-нің шабуылдарға төзімділігі сәл азаяды.</translation>
<translation id="4626321472657185181">Chromium-мен іздеу функциясын ашу</translation>
<translation id="7601899887920501075">Ескерту: Shuttle кеңейтімдердің браузерді қолдану тарихын жазуына кедергі бола алмайды. Бұл кеңейтімді Инкогнито режимінде өшіру үшін бұл опцияның белгісін алып тастаңыз.</translation>
<translation id="4673151026126227699">Chromium пайдалану есептерін де бөліссеңіз, бұл есептерде сіз кірген URL мекенжайлары қамтылады.</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" /> (мүше) ретінде кірдіңіз. Аккаунт мәзірін ашу</translation>
<translation id="1081748947768053336">Профиль басқа Shuttle процесімен (<ph name="PROCESS_ID" />) басқа компьютерде (<ph name="HOST_NAME" />) пайдаланылып жатыр. Бүлінбеуі үшін Shuttle профильді құлыптап қойды. Басқа процестер бұл профильді пайдаланып жатпаса, профильді құлыптан ашып, Shuttle қайта іске қосуыңызға болады.</translation>
<translation id="4680828127924988555">Орнатудан бас тарту</translation>
<translation id="469259825538636168">Chromium деректерінің кейбірі Google аккаунтыңызға әлі сақталмаған. Шығу алдында бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="4708193446201257833">Аккаунтқа кірсеңіз, Chromium-нен Google аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. <ph name="SHORTCUT" /> тіркесімі арқылы Google қызметтерінің параметрлерін өзгертуге болады.</translation>
<translation id="4708774505295300557">Бұрын әлдекім осы компьютерден Chromium браузеріне <ph name="ACCOUNT_EMAIL_LAST" /> болып кірген. Ақпаратты бөлек ұстау үшін жаңа Chromium пайдаланушысын жасаңыз.</translation>
<translation id="4724676981607797757">Орнатылмады, себебі қолдау көрсетілмейтін протокол қатесі пайда болды.</translation>
<translation id="333286104758608669">Shuttle браузерінен бәрібір шығасыз ба?</translation>
<translation id="4748217263233248895">Chromium браузеріне қазір ғана қауіпсіздік бойынша арнайы жаңартылған нұсқа қолданылды. Оны қазір қайта ашсаңыз, қойындылар қалпына келтіріледі.</translation>
<translation id="4771701986670315895">Жақында кірмедіңіз. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> рұқсаттарын және тағы <ph name="COUNT" /> рұқсатты өшірді.</translation>
<translation id="4786083865378785874">Chromium-дегі Gemini ашық болса, жаңа қойындылар жасаған кезде, бүйірлік панель ашық қалады.</translation>
<translation id="479167709087336770">Google Search қызметіндегі емле тексеру құралы пайдаланылады. Браузерде терілген мәтін Google-ға жіберіледі. Мұны параметрлерде өзгертуіңізге болады.</translation>
<translation id="4814736265800133385">Chromium-ді аккаунтсыз қолдану</translation>
<translation id="4888717733111232871">mDNS трафигіне рұқсат беретін Chromium кіріс ережесі.</translation>
<translation id="3854801763817831716">&amp;Shuttle-ді жаңарту үшін қайта іске қосу</translation>
<translation id="4918086044614829423">Қабылдау</translation>
<translation id="4918844574251943176">Сурет көшірілді.</translation>
<translation id="4943838377383847465">Chromium фондық режимде.</translation>
<translation id="494490797786467921">Chromium-ге кірудің диалогтік терезесін жабу үшін басыңыз.</translation>
<translation id="4950660488495335294">Chromium профильдері арқылы Chromium-дегі барлық материалыңызды бөле аласыз. Достар мен отбасыңызға арналған немесе жұмысқа не көңіл көтеруге бөлек профильдер жасаңыз.</translation>
<translation id="4987820182225656817">Қонақтар Chromium қолданбасын ешқандай дерек қалдырмай пайдалана алады.</translation>
<translation id="4992938037305302429">Chromium-дегі аккаунтыңыз</translation>
<translation id="4994636714258228724">Chromium жүйесіне өзіңізді қосу</translation>
<translation id="504699503110800016">Қосымша мәзірді ашу</translation>
<translation id="5074496654342756568"><ph name="DEVICE_TYPE" /> құрылғысындағы Chromium-мен Google-дың барлық таңдаулы қызметін пайдаланыңыз.</translation>
<translation id="5123973130450702873">Chromium қолыңызды бақылауға рұқсат сұрайды.</translation>
<translation id="5141988424377517949">Жақында кірмедіңіз. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> рұқсаттарын өшірді.</translation>
<translation id="5174969993834422967">Әдетте хабарландыруларға тыйым саласыз. Бұл сайт сізге хабарландыру жіберсін десеңіз, локация жолағының оң жақ бұрышындағы хабарландыру белгішесін басыңыз.</translation>
<translation id="5174983315706567306">Диск жады жеткіліксіз.</translation>
<translation id="5187123684706427865">Chromium аккаунтын қайта аутентификациялау қажет.</translation>
<translation id="5223510345050543907">iOS-тегі Chromium-де тоқтаған жеріңізден жалғастырыңыз.</translation>
<translation id="5231355151045086930">Chromium жүйесінен шығу</translation>
<translation id="5234764350956374838">Жабу</translation>
<translation id="5249261924633168472">Сілтемені Chromium инкогнито терезесінде ашу</translation>
<translation id="5276305953263010518">Құпия сөздерді кез келген жерде сақтау үшін Chromium қолданбасын жүктеп алыңыз</translation>
<translation id="6904011543478254794">Өзгерістер енуі үшін, Shuttle браузерін қайта қосыңыз</translation>
<translation id="5286907366254680517">Анықталды</translation>
<translation id="5289287148052354622">Chromium қолданбасын жүктеп алу</translation>
<translation id="5294316920224716406">Инкогнито режимін пайдаланған кезде, Chromium сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="5296581118566748922">Chromium-мен іздеу</translation>
<translation id="5313228254328109263">"Chromium-ді жаңарту құралы" ішкі қызметі</translation>
<translation id="5324450571874973775">Оларды Chromium-дегі басқа Gemini функцияларымен бірге пайдаланыңыз.</translation>
<translation id="5346389065299425353">Бірнеше қойынды, файл және құрал қосып, жан-жақты іздеңіз.</translation>
<translation id="5348677704241861105">Chromium-дегі Gemini көмегімен осы құжаттың қысқаша мазмұнын біліп, сұрақтар қойыңыз.</translation>
<translation id="5352264705793813212">Chromium тексеруге қажетті қауіпсіздікке қатысты кейбір ұсыныстарды тапты</translation>
<translation id="5352361688875342522">Басқа Chromium профильдері</translation>
<translation id="535243042947607642">ChromiumOS жүйесі Chromium деректерін Google аккаунтыңызға сақтай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="5358375970380395591">Бақыланатын аккаунт арқылы кірдіңіз және оның әкімшілік бөлігін Chromium профилі арқылы басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты Chromium деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME" /> пайдаланушысына байланыстырылады. Бұл деректерді Google аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Қосымша код: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Жекелендіру үшін Chromium-ді интернет пен қолданбаларды пайдалану тарихына қосыңыз.</translation>
<translation id="5382964351116519680">Chromium-мен іздеу функциясын ашу</translation>
<translation id="4877717772512674872">Неліктен Shuttle кейбір файлдарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="8341327126333983765">Shuttle жаңартылуда (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Chromium браузеріне кіруге рұқсат ету</translation>
<translation id="2064155379595075287">Shuttle-нен жою</translation>
<translation id="1764424071909520660">Өнімділік азаяды, бірақ Shuttle шабуылдарға төзімді болады.</translation>
<translation id="5427571867875391349">Әдепкі браузер ретінде Chromium қолданбасын орнату</translation>
<translation id="3552564955884420948"><ph name="PAGE_TITLE" /> - Shuttle бета нұсқасы</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Chromium браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{Chromium браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="3837394572112225231">Shuttle дұрыс жұмыс істемеуі мүмкін, себебі оған Linux жүйесінде қолдау көрсетілмейді.</translation>
<translation id="2864501208955185201">Shuttle бұл файлды жүктеп алуға тыйым салды, себебі ол жеке және әлеуметтік желі аккаунттарыңызға қауіп төндіруі мүмкін</translation>
<translation id="549669000822060376">Chromium ең соңғы жүйе жаңартуларын орнатуда, күте тұрыңыз.</translation>
<translation id="5496810170689441661">Chromium құпия сөздерді өзгерткісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="549975168243349205">Chromium-мен жол-жөнекей Google Drive және YouTube сияқты сүйікті қолданбаларыңызды кедергісіз пайдаланыңыз.</translation>
<translation id="5524890928877629608">іздеу аймағының жоғарғы сол жақ бұрышы: сол жақ <ph name="LEFT" />%, жоғарғы жақ <ph name="TOP" />%</translation>
<translation id="3510916764590863589">PDF-терді Shuttle-де ашу</translation>
<translation id="5536164441519929134">Осы қойынды туралы<ph name="LINE_BREAK" />сұраңыз</translation>
<translation id="8317102978607899723">Сайтқа бірінші рет кірген кезіңізде, Shuttle браузері қауіпсіздік үшін JavaScript оңтайландыру әдісін өшіреді.

Бұл бет ойдағыдай істемесе, оңтайландыруға рұқсат беріп көріңіз.</translation>
<translation id="5575874067957905201">Chromium-дегі Gemini-ды Mac мәзір жолағында көрсету және пернелер тіркесімін қосу</translation>
<translation id="5576587363991567745"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Chromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Сақталған ақпарат пен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="5579324208890605088">Іске қосу қатесі: орнату құралын әкімші емес, кәдімгі пайдаланушы ретінде іске қосыңыз.</translation>
<translation id="5580770360767802657">Chromium-ді әдепкісінше пайдалану және бекіту</translation>
<translation id="5596627076506792578">Қосымша опциялар</translation>
<translation id="5605834417512968703">"Сурет іздеу" функциясы арқылы іздеу керек кез келген нәрсені таңдаңыз немесе бұл функциядан шығу үшін Escape пернесін басыңыз.</translation>
<translation id="5618818588972826921">"Сурет іздеу" функциясымен іздеу керек кез келген мәтінді не суретті таңдаңыз немесе "Сурет іздеу" функциясынан шығу үшін Escape пернесін басыңыз.</translation>
<translation id="8908504550344650717">{0,plural, =0{Shuttle браузерінің жаңартылған нұсқасы қолжетімді}=1{Shuttle браузерінің жаңартылған нұсқасы қолжетімді}other{Shuttle браузерінің жаңартылған нұсқасы # күннен бері қолжетімді}}</translation>
<translation id="1107298128800350481">Shuttle браузерін жапқан кезде құрылғыңыздан сайт деректерін үнемі жою</translation>
<translation id="5653831366781983928">Chromium браузерін қайта іске қосыңыз</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="3675878834104730294">Shuttle жүйесін осы тілде көрсету</translation>
<translation id="569897634095159764">Интернетке қосылу мүмкін емес. Прокси-сервер үшін аутентификация қажет.</translation>
<translation id="7168202961287328687">Shuttle әрекетсіз қойындылардағы жадты босатады. Мұның нәтижесінде белсенді қойындылар мен басқа қолданбаларға қосымша компьютер ресурстары үлестіріліп, Shuttle жылдам жұмыс істейді. Әрекетсіз қойындыларды ашқанда, олар автоматты түрде қайтадан белсенді болады. <ph name="BEGIN_LINK" />Жад үнемдегіш туралы толық ақпарат<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, аккаунтыңыздағы Chromium деректерін <ph name="SETTINGS_LINK" />.</translation>
<translation id="5800158606660203929">Chromium-ді бейімдеңіз және басқарыңыз. Chromium-ді әдепкі браузер етіп орнатыңыз.</translation>
<translation id="5802618941556161431">Chromium-ді әдепкі браузер етіп орнату арқылы құпия сөздеріңізді, бетбелгілеріңізді және тарихыңызды құрылғыларда синхрондаңыз.</translation>
<translation id="5809516625706423866">Интернетке қосылу мүмкін емес. HTTP 401 бойынша рұқсат берілмейді. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="4687670724165839540">Shuttle-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Shuttle-нің шабуылдарға төзімділігі сәл азаяды. Бұл параметр өшірулі.</translation>
<translation id="5821520528363214608">Google аккаунтындағы Chromium деректерін пайдалану және сақтау үшін Chromium-ді жаңартыңыз.</translation>
<translation id="5824893331272123205">Бұл панельді жүктеу мүмкін болмады. Әрекетті қайталаңыз</translation>
<translation id="137189936820997722">Shuttle жүйесіне қош келдіңіз</translation>
<translation id="6407035307321626411">Shuttle-де ең күшті қорғау мүмкіндігін қамтамасыз ету үшін қосымша функцияларды қосады.</translation>
<translation id="5871205389137001634">"Сурет іздеу" функциясынан шығу үшін басыңыз.</translation>
<translation id="3128663943810469943">Shuttle бұл элементтерде зиянды бағдарлама бар екенін анықтады:</translation>
<translation id="5889361821821684993">Браузеріңізде ең қауіпсіз параметрлер бар екеніне көз жеткізу үшін Chromium жүйелі түрде тексереді. Пікіріңіз керек болса, сізге хабар жібереміз.</translation>
<translation id="5895138241574237353">Қайта іске қосу</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Желіге кіру</translation>
<translation id="5924017743176219022">Интернетке қосылып жатыр…</translation>
<translation id="5939553720811388432">Chromium браузерін дайындайық</translation>
<translation id="5941711191222866238">Жию</translation>
<translation id="5949225980829865667">Осы бетбелгі және басқа да көптеген нәрселер барлық құрылғыңызда болуы үшін, Chromium-ға кіріңіз.</translation>
<translation id="5953657885167112863">Chromium-ді өзіңізге сай бейімдеңіз</translation>
<translation id="5960071705175224773">Параметрлеріңізді белгісіз қолданба өзгертті</translation>
<translation id="5977420883993828287">Бекітілді! Контекстік тапсырмаларды құралдар тақтасынан қайта пайдаланыңыз.</translation>
<translation id="5340341384223569715">{COUNT,plural, =1{Shuttle 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}other{Shuttle # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}}</translation>
<translation id="5987687638152509985">Chromium браузерін жаңартып, синхрондауды бастаңыз</translation>
<translation id="5990360079535151574">Шолу кезінде сұрақ қою үшін құралдар тақтасындағы "Контекстік тапсырмалар" түймесін басып, контекстік тапсырмаларды қайта ашуға болады.</translation>
<translation id="6003112304606738118">Жүктеп алынып жатыр… <ph name="HOURS" /> сағат қалды.</translation>
<translation id="6009821354356307391">Қосымша сұрақ қойыңыз</translation>
<translation id="6040143037577758943">Жабу</translation>
<translation id="6044357424127037044"><ph name="DEVICE_TYPE" /> құрылғысында Chromium пайдаланып, онлайн сатып алудан барынша пайда көріңіз</translation>
<translation id="6058380562449900225">Деректеріңізді қорғау үшін Chromium-ге сіз соңғы уақытта кірмеген сайттар рұқсаттарын өшіруге рұқсат беріңіз. Хабарландырулар көрсетіле береді.</translation>
<translation id="6063093106622310249">&amp;Chromium жүйесінде ашу</translation>
<translation id="6069027071882229820">Сурет түрінде көшіру</translation>
<translation id="3642130578728163190"><ph name="EXTENSION_NAME" /> кеңейтімі Shuttle браузеріне енгізілді</translation>
<translation id="2484600148019262399">Shuttle браузерін реттеңіз және басқарыңыз. Жаңартылған нұсқа қолжетімді.</translation>
<translation id="5098189861342100628">Қосулы • Shuttle бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="611228897408671387">Chromium-дегі аккаунтыңыз</translation>
<translation id="8603072311189086377">Кеңейтімге Shuttle құралдар тақтасында сайтқа кіру сұрауларын көрсетуге рұқсат беру</translation>
<translation id="6801818398062031196"><ph name="FILE_NAME" /> қауіпті болғандықтан, Shuttle оны бөгеді.</translation>
<translation id="4712579756381990057">Shuttle жақын арада жабылып, деректерді жояды</translation>
<translation id="6145820983052037069">Осы жерде Chromium профильдерін ауыстыра аласыз.</translation>
<translation id="4257025918694286900">Егер cookie файлдарына рұқсат берсеңіз, Shuttle оларды алдын ала жүктеу кезінде пайдалануы мүмкін.</translation>
<translation id="6165508094623778733">Толық ақпарат</translation>
<translation id="6173308241973263798">Аккаунттағы Chromium деректерін тазалау</translation>
<translation id="8755328651499078855">Бұл файл қауіпті болуы мүмкін.<ph name="LINE_BREAK" />Құпия сөзді көрсетсеңіз, Shuttle бұл жүктеп алу әрекетін тексере алады. Файл туралы ақпарат Google Safe Browsing қызметіне жіберіледі, бірақ файл контенті мен құпия сөз құрылғыңызда қалады.</translation>
<translation id="6182736845697986886">Орнатылмады, себебі жаңарту серверінде ішкі қате пайда болды.</translation>
<translation id="6183079672144801177"><ph name="TARGET_DEVICE_NAME" /> құрылғысындағы Chromium браузеріне кіргеніңізді тексеріп, қайта жіберіп көріңіз.</translation>
<translation id="6212496753309875659">Бұл компьютерде жаңа Chromium нұсқасы бұрыннан бар. Бағдарламалық жасақтама жұмыс істемесе, Chromium жойып, әрекетті қайталап көріңіз.</translation>
<translation id="1515663301924664480">{0,plural, =0{Shuttle браузері қазір қайта іске қосылады}=1{Shuttle браузері 1 секундтан кейін қайта іске қосылады}other{Shuttle браузері # секундтан кейін қайта іске қосылады}}</translation>
<translation id="6241367896540709610">Chromium файлдарды жүктеп алу үшін жадты пайдалануға рұқсат сұрайды.</translation>
<translation id="6245734527075554892">URL мекенжайларын Chromium браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді.</translation>
<translation id="4713635402704891510">Әдепкі браузер ретінде Shuttle орнату</translation>
<translation id="6248988683584659830">Іздеу параметрлері</translation>
<translation id="6261803579884938625">Телефондағы Chromium-мен Google-дың үздік қауіпсіздік функцияларын жол-жөнекей пайдаланыңыз</translation>
<translation id="6268381023930128611">Chromium жүйесінен шығасыз ба?</translation>
<translation id="6270547683008298381">Бұл қойындылар тым көп ресурстар қолданып жатыр. Өнімділікті жақсарту үшін Chromium-ге оларды әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="6281746429495226318">Chromium профилін реттеу</translation>
<translation id="6290827346642914212">Chromium профиліне ат қойыңыз</translation>
<translation id="6294831894865512704">Кеңейтімді қолдану үшін Chromium-ге кіруіңіз керек</translation>
<translation id="3997120491472930522"><ph name="FILE_NAME" /> қауіпті болуы мүмкін болғандықтан, Shuttle оны бөгеді.</translation>
<translation id="5186109991568427789">Shuttle камераңызды пайдалануда.</translation>
<translation id="6333502561965082103">Chromium браузерінде басқа операция орындалуда. Әрекетті кейінірек қайталаңыз.</translation>
<translation id="6334986366598267305">Енді Chromium қолданбасын Google аккаунтымен және ортақ компьютерлерде пайдалану жеңілірек.</translation>
<translation id="6347002662287820329">Chromium-ді әдепкі браузер етіп орнату арқылы өзіңіз білетін, ұнататын және сенетін функцияларды оңай пайдаланыңыз.</translation>
<translation id="7093968037936297432">Shuttle пернелер тіркесімі</translation>
<translation id="7334991367988739135">Shuttle жүктеп алуды блоктады, себебі бұл файл әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="6373523479360886564">Chromium жою қажет пе?</translation>
<translation id="6375219077595103062">Password Manager таңбашасын қосу</translation>
<translation id="6388799252195623474">осы бетке қатысты көмек қажет</translation>
<translation id="6390800440335263989">Жалғастыру үшін Chromium-ге <ph name="EMAIL" /> аккаунтымен кіріңіз. Осылайша ұйым саясаттары сақталады.</translation>
<translation id="6400112897226594999">Компьютер экранындағы Chromium логотипі.</translation>
<translation id="6403826409255603130">Chromium — веб-беттер мен қолданбаларды өте жылдам ашатын веб-браузер. Ол жылдам, тұрақты және пайдалануға оңай. Chromium жүйесіне ендірілген зиянды бағдарлама және фишинг қорғанысымен интернетті уайымсыз пайдалана беруіңізге болады.</translation>
<translation id="6414624068245092115">Google аккаунтыңызда Chromium деректерін үнемі пайдалану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="3077581991710361221">Shuttle жылдам істейді. JavaScript қолданатын функциялар тиісті түрде істеуі керек.</translation>
<translation id="6436260184216827876">"Сурет іздеу" функциясы істемейді. Кейінірек қайталап көріңіз.</translation>
<translation id="6442900851116057561">ChromiumOS жүйесін өшіріп қосу</translation>
<translation id="6836481692352030024">Shuttle сіз кіруіңіз мүмкін көбірек бетті алдын ала жүктейді, сонда оларға кірген кезіңізде, тезірек жүктеледі.</translation>
<translation id="6450948450282634257">Бағаларды бақылау және кез келген сайтта баға түскен кезде, хабарландырулар алу үшін телефоныңызға Chromium-ді жүктеп алыңыз.</translation>
<translation id="2653849928907685021">Өшірулі • Shuttle бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="6455857529632101747">Chromium профильдеріне қош келдіңіз!</translation>
<translation id="6460614424172581323">Келесі жолы Chromium-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, қойындылар топтарын пайдалану туралы нұсқауды көресіз.</translation>
<translation id="6466344609055215035">Аккаунтты Chromium-нен өшіру</translation>
<translation id="4119585981464207648">Сонымен қатар Shuttle іске қосылғанда қайсы бет көрсетілуін бақылайды.</translation>
<translation id="648319183876919572">Күшейтілген Safe Browsing-нің қауіпті веб-сайттар мен файлдардан қорғау қабілеті жоғарырақ.</translation>
<translation id="6510925080656968729">Chromium жою</translation>
<translation id="4635313972402880015">Пернелер тіркесімдері Shuttle-нен ашылады.</translation>
<translation id="4810254941066760486">Ұйымыңыз Shuttle-ді <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жабады. Браузерді пайдалану деректері жойылды. Оларға тарих, автотолтыру мәліметтері және жүктеп алынғандар кіруі мүмкін.</translation>
<translation id="6542839706527980775">Әр профильде бетбелгілер, тарих, құпия сөздер және тағы басқа Chromium ақпараты бар.</translation>
<translation id="6556755379298048869">Пернелер тіркесімімен іздеңіз.</translation>
<translation id="2636806189032302779"><ph name="BEGIN_LINK" />Shuttle-нің деректеріңізді құпия сақтау жолы<ph name="END_LINK" /> туралы толық ақпарат</translation>
<translation id="5478536825661470867">Бұл параметрге енгізілген өзгерістер Shuttle өшіп қосылғаннан кейін күшіне енеді.</translation>
<translation id="4113260229270901158">Кеңейтімдерді реттеу үшін Shuttle негізгі мәзіріндегі "Кеңейтімдер" түймесін басыңыз.</translation>
<translation id="656935081669708576">Басқа Chromium профиліндегі құпия сөздерді көру үшін ауысуға болады</translation>
<translation id="6569556444379005948">Үздік ЖИ құралдарын жол-жөнекей алып жүру үшін Chromium пайдаланыңыз.</translation>
<translation id="7057131640166361945">Емле қателерін түзету үшін Shuttle браузері мәтін жолына терілген сөздерді Google-ға жібереді</translation>
<translation id="6598877126913850652">Chromium хабарландыру параметрлері бөліміне өту</translation>
<translation id="6600016381025017075">Бұл беттен кез келген нәрсені іздеңіз.</translation>
<translation id="3051968423457057392">Өзгертулеріңіз Shuttle келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="6637908313088374648">Windows жұмысын бастаған кезде, Chromium іске қосылады, сондықтан браузерді бірден пайдалануға болады. Оны параметрлерден өшіруге болады.</translation>
<translation id="6648212540664651655">Тоқтаған жерден жалғастырыңыз: Chromium соңғы сеанстағы қойындыларды қалпына келтірді. Мұны келесі бөлімде өшіруге болады:</translation>
<translation id="665732753414869868">Chromium айналаңыздың 3D картасын жасау үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="6669284030132180248">Бетбелгілерді Google аккаунтыңызда да сақтасаңыз, Chromium-дe өнім бағаларын бақылап, баға төмендеген кезде, хабарландыру аласыз.</translation>
<translation id="6676384891291319759">Интернетке кіру</translation>
<translation id="668175097507315160">Кіру кезіндегі қате себебінен ChromiumOS деректеріңізді синхрондай алмады.</translation>
<translation id="6691132793308828750">Chromium-нен бұл қолданба деректерін өшіру</translation>
<translation id="6709350901466051922">Chromium бұл сайт үшін микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="6712881677154121168">Жүктеп алу қатесі: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="2725737003556499783">Профиліңізді пайдалану мүмкін емес, себебі ол жаңарақ Shuttle нұсқасынан.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін. Басқа профиль каталогін көрсетіңіз немесе жаңарақ Shuttle нұсқасын пайдаланыңыз.</translation>
<translation id="6729124504294600478">Жекелендіру мен басқа функцияларды алу үшін Chromium-ді интернет пен қолданбаларды пайдалану тарихы мен байланысқан Google қызметтеріне қосыңыз.</translation>
<translation id="6734291798041940871">Chromium компьютердегі барлық пайдаланушылар үшін әлдеқашан орнатылған.</translation>
<translation id="6742093177587589736">Бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін Chromium аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл бетбелгі Google аккаунтыңызға сақталады.</translation>
<translation id="1073375677278272498">Shuttle-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Shuttle-нің шабуылдарға төзімділігі сәл азаяды. Бұл параметр қосулы.</translation>
<translation id="6754665438209053659">{count,plural, =1{Chromium деректерінің кейбірі Google аккаунтыңызда әлі сақталмаған. Шықпай тұрып, бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{Chromium деректерінің кейбірі Google аккаунтыңызда әлі сақталмаған. Шықпай тұрып, бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="67706546131546258">Chromium бұл файлды сканерлеуді ұсынады, себебі ол қауіпті болуы мүмкін.</translation>
<translation id="6779406956731413166">ChromiumOS қосымша <ph name="BEGIN_LINK_CROS_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="6831043979455480757">Аудару</translation>
<translation id="6847869444787758381">Құпия сөздеріңіз ұрланған жағдайда, Chromium бұл туралы хабарлайды.</translation>
<translation id="684888714667046800">Интернетке қосылу мүмкін емес. Брандмауэр пайдалансаңыз, <ph name="PRODUCT_EXE_NAME" /> өнімінің рұқсат тізімінде екеніне көз жеткізіңіз.</translation>
<translation id="776553009482398136">Shuttle – <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Жалғастыру үшін Tab пернесін басыңыз.</translation>
<translation id="6862030660799253820">Бұл суретті сурет іздеу функциясымен іздеу</translation>
<translation id="6869568587896659271">Мекенжай жолағының астындағы веб-сайттарға оңай кіріңіз.</translation>
<translation id="5180440422324801473">Shuttle "<ph name="EXTENSION_NAME" />" кеңейтімінде зиянды бағдарлама бар екенін анықтады.</translation>
<translation id="6877155553248388166">іздеу аймағының төменгі оң жақ бұрышы: оң жақ <ph name="RIGHT" />%, төменгі жақ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Көшіру</translation>
<translation id="6898028264630240901">Шолған кезде сұрақ қою үшін контекстік тапсырмаларды бекітуге болады.</translation>
<translation id="6901631050894301805">Chromium-ді әдепкі браузер ретінде орнатып, тапсырмалар жолағына бекітіңіз.</translation>
<translation id="6909503629704372277">&amp;Chromium профильдерін басқару</translation>
<translation id="4581248703262892072">Бұл әрекет:
          <ph name="LINE_BREAKS" />
            • бастапқы бетті, жаңа қойынды бетін, іздеу жүйесін және бекітілген қойындыларды бастапқы күйге қайтарады;
            <ph name="LINE_BREAK" />
            • кеңейтімдерді өшіреді;
            <ph name="LINE_BREAK" />
            • cookie файлдарын және басқа уақытша сайт деректерін жояды;
            <ph name="LINE_BREAK" />
            • Shuttle таңбашаларын бастапқы күйге қайтарады.
            <ph name="LINE_BREAKS" />
            Бетбелгілерге, тарихқа және сақталған құпия сөздерге ештеңе болмайды.</translation>
<translation id="6948031725951063910">Chromium-нің <ph name="BOOKMARK_LIMIT" /> бетбелгі шегіне жеттіңіз, сондықтан кейбір бетбелгілер Google аккаунтыңызға әлі сақталмады.

Кейбір бетбелгілерді жоймайынша, аккаунтыңызға жаңа бетбелгілерді сақтау мүмкін емес. Аккаунттан қазір шықсаңыз, сақталмаған бетбелгілер жойылады.</translation>
<translation id="6964305034639999644">Сілтемені Chromium инкогнито терезесінде ашу</translation>
<translation id="6965382102122355670">Жарайды</translation>
<translation id="6985329841647292029">ChromiumOS шарттары</translation>
<translation id="7003299027384820442">Chromium деректерін <ph name="ACCOUNT_EMAIL" /> аккаунтында қолдану және сақтау үшін құпия фразаны енгізіңіз.</translation>
<translation id="7011190694940573312">Орнатылмады, себебі операциялық жүйенің бұл нұсқасына қолдау көрсетілмейді.</translation>
<translation id="7024536598735240744">Пакеттен шығару қатесі: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7045244423563602563">Chromium браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="7047386856539490735">Бұл нәтижелер пайдалы ма?</translation>
<translation id="705851970750939768">Chromium жаңарту</translation>
<translation id="3425455063038300019">Егер суреттің пайдалы сипаттамасы болмаса, Shuttle оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Google-ға жіберіледі.</translation>
<translation id="7074836723476134809">Chromium-ді <ph name="DEVICE_TYPE" /> құрылғысында пайдаланған кезде, ЖИ мүмкіндіктерін қолданыңыз</translation>
<translation id="7134687062119989071">Телефондағы Chromium-мен құпия сөздерді, қойындылар мен басқа деректерді жол-жөнекей пайдаланыңыз</translation>
<translation id="7141270731789036260">Chrome for Testing қызметін бейімдеу</translation>
<translation id="2566749447284070075">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, Shuttle браузерін кез келген уақытта пайдалана аласыз.</translation>
<translation id="4717037424104880768">Shuttle-нен <ph name="EXTENSION_NAME" /> кеңейтімін жою</translation>
<translation id="5499504683862746062">Ұйымыңыз Shuttle деректерін <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жояды. Оларға тарих, автотолтыру мәліметтері және жүктеп алынғандар кіруі мүмкін.</translation>
<translation id="718435575166326686">Chromium бұл сайт үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="73779270539924806">Shuttle браузері қосылмады. Қайталап көріңіз.</translation>
<translation id="7204669035546236137">Қай жерде болсаңыз да, Chromium-дегі Gemini-ға кез келген сұрақ қойыңыз</translation>
<translation id="3909780788712619547">Shuttle-ді кез келген уақытта жылдам ашу үшін бекітілген күйде қалдырыңыз</translation>
<translation id="7213407614656404070">Хабарларда, құжаттарда және басқа қолданбаларда сілтемелерді басып, Chromium браузерін кез келген уақытта пайдаланыңыз.</translation>
<translation id="7216228761061470870">Компьютерде сурет іздеу функциясын пайдалансаңыз, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге жіберіледі.</translation>
<translation id="5152543266278054880">Тапсырмалар реттегіші – Shuttle</translation>
<translation id="7227958669698166857"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Chromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Сақталған ақпарат пен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="7252276985725323153">Браузерден шолуды жылдам бастау: Windows жұмысын бастағанда, Chromium іске қосылады.</translation>
<translation id="7274695763216404502">Бекітілді! "Сурет іздеу" функциясын құралдар тақтасынан қайтадан пайдаланыңыз.</translation>
<translation id="7288567540154601580">Қойындылар мен кеңейтімдер</translation>
<translation id="7301179260332476710">{NUM_EXTENSIONS,plural, =1{Shuttle мұны өшіруге кеңес береді.}other{Shuttle бұларды өшіруге кеңес береді.}}</translation>
<translation id="6738087381969111286">Жүйе дыбысын бөлісу үшін жүйе параметрлерін ашып, Shuttle үшін "Тек жүйе дыбысын жазу" опциясына рұқсат беріңіз. Содан кейін Shuttle-ді қайта іске қосуыңыз қажет.</translation>
<translation id="882134845922037914">Shuttle браузерін жаңарту</translation>
<translation id="5911508944834868675">Реттеулер файлы бұзылған немесе жарамсыз.

Shuttle параметрлеріңізді қалпына келтіре алмайды.</translation>
<translation id="7324051657739063017">Шолу кезінде сұрақ қою үшін контекстік тапсырмаларды қайта ашуға болады.</translation>
<translation id="734373864078049451">Мұнда веб-беттер, бетбелгілер және басқа Chromium материалдары тұрады.</translation>
<translation id="7347827960336370838">Құпия фразасы бар адам ғана шифрланған деректеріңізді оқи алады. Құпия фраза Google компаниясына жіберілмейді немесе ол құпия фразаңызды сақтамайды. Құпия фразаны ұмытып қалсаңыз немесе осы параметрді өзгерту керек болса, <ph name="BEGIN_LINK" />аккаунттағы Chromium деректерін жою<ph name="END_LINK" /> қажет.</translation>
<translation id="5213396397254545050">Жүйе әкімшісі Shuttle браузерін <ph name="TARGET_URL_HOSTNAME" /> бетіне кіргенде <ph name="ALTERNATIVE_BROWSER_NAME" /> браузері ашылатын етіп конфигурациялады.</translation>
<translation id="7352651011704765696">Бірнәрсе дұрыс емес</translation>
<translation id="7241271939430402377">Shuttle-нің жаңа нұсқаларын алып тұру үшін macOS 13 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде macOS 12 нұсқасы орнатылған.</translation>
<translation id="7376384068949534168">Жақында кірмедіңіз. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> рұқсаттарын өшірді.</translation>
<translation id="73786666777299047">Chrome Web Store қызметін ашу</translation>
<translation id="7394275517973019558">Chromium-дегі Gemini-ды жүйелік науада көрсету</translation>
<translation id="7401687852903179959">Бұл бейнені сурет іздеу функциясымен іздеу</translation>
<translation id="7407655596887111931">Chromium – енді сіздің әдепкі браузеріңіз.</translation>
<translation id="3052711235626610530">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, Shuttle қойындыларды қалпына келтіреді. Мұны өшіру үшін келесі бөлімге өтіңіз:</translation>
<translation id="7427879960656355200">Құпия сөздерді Chromium-ге экспорттау</translation>
<translation id="744815265653811511">1. Төмендегі <ph name="BUTTON_LABEL" /> түймесін басыңыз.
2. Windows параметрлерінде <ph name="BUTTON_2" /> түймесін басыңыз.
3. Chromium-ге жылдам кіру үшін, оны тапсырмалар жолағына бекітіңіз. Ол үшін Windows хабарландыруындағы <ph name="BUTTON_3" /> түймесін басыңыз.</translation>
<translation id="9197089209084271928"><ph name="PAGE_TITLE" /> - Shuttle әзірлеуші нұсқасы</translation>
<translation id="7450541714075000668">Мәтін көшірмесі жасалды</translation>
<translation id="313710343255539509">Микрофонды пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Shuttle-ге рұқсат беріңіз.</translation>
<translation id="7461356015007898716">Chromium-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 7 нұсқасы орнатылған.</translation>
<translation id="3993055863855039235">Shuttle қайта іске қосылсын ба?</translation>
<translation id="7483335560992089831">Ашылып тұрғанмен бірдей Chromium нұсқасын орнату мүмкін емес. Chromium қолданбасын жауып, әрекетті қайталаңыз.</translation>
<translation id="7510190804000607802">Еске салғыш: Google-дың үздік мүмкіндіктері қалтаңызда болады</translation>
<translation id="8341160057232502783">Сайттар ойдағыдай жұмыс істеуі керек. Shuttle-де аккаунтқа кірген болсаңыз, барлық Shuttle терезесін жапқан кезде, Google аккаунтын қоспағанда, сайттардың көпшілігінен шығарыласыз.</translation>
<translation id="6139170930430750545">{0,plural, =1{Shuttle браузері 1 минуттан кейін қайта іске қосылады}other{Shuttle браузері # минуттан кейін қайта іске қосылады}}</translation>
<translation id="7565444033145385702">Деректеріңізді қорғау үшін Chromium-ге сіз соңғы уақытта кірмеген сайттардың рұқсаттарын өшіруге рұқсат беріңіз.</translation>
<translation id="7445475294019002626">Браузерді жылдам пайдалану үшін Shuttle-ді автоматты түрде іске қосады.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> орнату құралы</translation>
<translation id="3770734847062637711">Shuttle камераңыз бен микрофоныңызды пайдалануда.</translation>
<translation id="7617377681829253106">Chromium жақсара түсті</translation>
<translation id="8871277779820248167">Енді Shuttle-дегі функциялар көбейді.</translation>
<translation id="7624307931717240213">Біз бұл қызметті жақсарту үшін ақпаратты пайдаланамыз. Құпиялық саясаты мен Қызмет көрсету шарттарын қараңыз.</translation>
<translation id="7649070708921625228">Анықтама</translation>
<translation id="7650134251917003571">Chromium қолданбасын жүктеп алу</translation>
<translation id="7658239707568436148">Бас тарту</translation>
<translation id="8213236740307893655">Shuttle әдепкі браузеріңіз емес</translation>
<translation id="7689606757190482937">Chromium браузерін барлық құрылғыларда синхрондап, параметрлерін жекелендіріңіз</translation>
<translation id="7699779824407626136">Chromium жаңарту</translation>
<translation id="7700735928747402058">Жұмысыңыз Chromium-де қорғалады</translation>
<translation id="7716950018788545737">Тапсырмалар аяқталды.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" /> браузеріне арналған жүйені трассалау қызметтерін ұсынады. Қызмет өшірілсе, браузер жасаған өнімділік трассалары контекст ауыстыру және дайын ағын оқиғалары сияқты жалпы жүйелік оқиғаларды қамтымайды.</translation>
<translation id="7745317241717453663">Шолу деректері бұл құрылғыдан жойылады. Деректерді кейінірек алу үшін Chromium жүйесіне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="7747138024166251722">Орнату құралы уақытша каталогті жасай алмады. Дисктегі бос орынды және бағдарламалық жасақтама рұқсатын тексеріңіз.</translation>
<translation id="7747820849741499258">Chromium-нен іздеу</translation>
<translation id="7750130090210923118">Chromium-ді әдепкі күйге қайтару</translation>
<translation id="7752521946322750699">Chromium-ге кірген кезіңізде, Chromium-дегі жұмысыңызды қорғау үшін ұйымыңыз белгілі бір ақпаратты көре алады немесе басқара алады.</translation>
<translation id="7781047659465034537">Chromium-ді әдепкі браузер етіп орнатып, тапсырмалар жолағына бекітіңіз</translation>
<translation id="7786760609782648049">Chromium жылдамдығын арттырыңыз</translation>
<translation id="5390209367680424449"><ph name="PAGE_TITLE" /> - Shuttle Canary</translation>
<translation id="5236799997529789289">Интернет трафигіңізді пайдалана алатын адамдар қандай сайттарға кіретініңізді көрмейтіндей етіңіз. Shuttle браузері DNS жүйесіндегі сайттың IP мекенжайын іздеу үшін қауіпсіз байланысты пайдаланады.</translation>
<translation id="7810005234485217901">"Сурет іздеу" функциясына оңай кіру үшін оны бекітуге болады.</translation>
<translation id="6809035843240398711">Shuttle-мен бөлісетін контентті таңдау</translation>
<translation id="7828947555739565424">Осы құрылғыда бұл аккаунтқа Chromium профилі тіркеліп қойған.</translation>
<translation id="7845233973568007926">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын компьютерді өшіріп қосуыңыз керек.</translation>
<translation id="2536014991386708485">Іздеу жүйесі Shuttle-нен тыс өзгертілді. Сізді қорғау үшін Shuttle оны бастапқы әдепкі күйіне қайтарды. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="7853661403199074278">Chromium-ге жаңа көрініс беру үшін оны бейімдеңіз.</translation>
<translation id="2266811154496778101">Мекенжай жолағында немесе іздеу өрісінде терген кезде, Shuttle браузері жақсырақ ұсыныстар алу үшін тергеніңізді әдепкі іздеу жүйесіне жібереді. Бұл Инкогнито режимінде өшірілген.</translation>
<translation id="6065091602420830">Shuttle браузерінің ең соңғы нұсқасы орнатылмады, сондықтан жаңа мүмкіндіктер мен қауіпсіздікке қатысты түзетілген функцияларды пайдалана алмайсыз.</translation>
<translation id="7872446069773932638">Жүктеп алынып жатыр… <ph name="SECONDS" /> секунд қалды.</translation>
<translation id="7873537467422636035">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, <ph name="BEGIN_LINK" />аккаунтыңыздағы Chromium деректерін жойыңыз<ph name="END_LINK" />.</translation>
<translation id="7874369989024033742">Chromium-дегі Gemini-ды қажет кезде лезде ашыңыз.</translation>
<translation id="7888981273428720788">Chromium-ді әдепкі браузер етіп орнату</translation>
<translation id="7934340546140346950">Мүмкін болса, Chromium қауіпті байланыстарды HTTPS кеңейтіміне автоматты түрде жаңартады.</translation>
<translation id="7937630085815544518">Chromium жүйесіне <ph name="USER_EMAIL_ADDRESS" /> ретінде кірдіңіз. Қайта кіру үшін бірдей аккаунтты пайдаланыңыз.</translation>
<translation id="7944602660083060118"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Chromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Бетбелгілер мен басқа деректер барлық құрылғыңызда қолжетімді болады.</translation>
<translation id="7585793177462647372">Бұл – Shuttle браузерінің қайта орнатылған нұсқасы және әдепкі браузер бола алмайды.</translation>
<translation id="6559029165921633261">Белгісіз дереккөздерден алынған кеңейтім, қолданба, тақырыптар құрылғыңызға зиянын тигізуі мүмкін. Shuttle оларды тек <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> дүкенінен орнатуды ұсынады.</translation>
<translation id="8000759043835159571"><ph name="DEVICE_TYPE" /> құрылғысындағы Chromium-мен Google-дың барлық мүмкіндігін пайдаланыңыз</translation>
<translation id="8004582292198964060">Браузер</translation>
<translation id="8010081455002666927">Автоанықтау</translation>
<translation id="8002328729078921180">Shuttle браузерінің кіру рұқсаты болса, веб-сайттар сізден кіру рұқсатын сұрайды.</translation>
<translation id="818329629430342049">Shuttle-ді кез келген уақытта жылдам ашу үшін тапсырмалар жолағына бекітіңіз</translation>
<translation id="80471789339884597">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME" /> пайдаланбас бұрын барлық браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="8054112667659782652">"Сурет іздеу" жылдам пәрменін үнемі көрсету</translation>
<translation id="8069447462453318634">"Құралдар тақтасына бекіту" опциясын таңдаңыз.</translation>
<translation id="3155838504016687695">Shuttle-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="80790299200510644">Сурет іздеу</translation>
<translation id="8086881907087796310">Орнатылмады, себебі компьютер минималды жабдық талаптарына жауап бермейді.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="8105840573057009683">Chromium бұл сайт үшін локацияны пайдалануға рұқсат сұрайды.</translation>
<translation id="8107060931443639922">Келесі жолы Chromium-ді <ph name="DEVICE_TYPE" /> құрылғысынан ашқан кезде, баға бақылау хабарландыруларын қосу туралы нұсқауды көресіз.</translation>
<translation id="8117908349476699973">Өзіңізге қызықты тауарлардың бағасы төмендеген кезде, телефондағы Chromium арқылы хабарландыру алыңыз</translation>
<translation id="8118331347066725040">Lens-бен іздеуге қатысты пікіріңізді жазыңыз.</translation>
<translation id="8130609355518033382">Chromium-ді өзіңізге бейімдеңіз</translation>
<translation id="8133124826068723441">ChromiumOS деректеріңізді синхрондай алмады, себебі синхрондау функциясы доменіңіз үшін қолжетімді емес.</translation>
<translation id="813913629614996137">Дайындауда…</translation>
<translation id="8161503455832158203">Chromium-дегі Gemini-ды пернелер тіркесімімен ашыңыз.</translation>
<translation id="369114052288176160">Shuttle Қосымша қызмет көрсету шарттары</translation>
<translation id="680378955833427720">Бұл файл қауіпті болғандықтан, Shuttle оны бөгеді.</translation>
<translation id="8177472873527554730">Беттен ештеңе табылмады.</translation>
<translation id="8200109504272824693">Chromium деректерін <ph name="USER_EMAIL" /> аккаунтында қолдану және сақтау үшін құпия фразаны енгізіңіз.</translation>
<translation id="820759916613250543">Бұл суретті сурет іздеу функциясымен іздеу</translation>
<translation id="8221491193165283816">Әдетте хабарландыруларға тыйым саласыз. Осы сайттың сізге хабарландыру жіберуіне рұқсат ету үшін осы жерді басыңыз.</translation>
<translation id="8107647892434846563">Камераны пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Shuttle-ге рұқсат беріңіз.</translation>
<translation id="1786899383568465391">Shuttle бұл кеңейтімнің қайдан келгенін анықтай алмайды. Ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Shuttle-нан жойыңыз.</translation>
<translation id="493819615490030185">Егер суреттің пайдалы сипаттамасы болмаса, Shuttle оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Google-ға жіберіледі. Бұл функцияны кез келген уақытта параметрлерден өшіріп қоюға болады.</translation>
<translation id="8254601181414348851">Chromium-ге жаңа профильмен кіру қажет пе?</translation>
<translation id="8262224117913639129"><ph name="EXISTING_USER" /> әлдеқашан кірді. Браузерді пайдалану тарихын бөлек сақтау үшін Chromium-ге <ph name="USER_EMAIL_ADDRESS" /> ретінде жеке профиліңізбен кіріңіз. Құпия сөздер мен басқа деректерді <ph name="DEVICE" /> ала аласыз.</translation>
<translation id="8277334259226003205">Chromium-дегі Gemini-ды жүйелік науада көрсету және пернелер тіркесімін қосу</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium сізге<ph name="END_LINK" /> қауіпті сайттар мен жүктеп алу әрекеттері туралы ескертеді</translation>
<translation id="8295827201165805317">Жақында кірмедіңіз. Chromium <ph name="PERMISSION" /> рұқсатын өшірді.</translation>
<translation id="8296236834352487533">Chromium iOS қолданбасында камера көмегімен нәрселерді сатып алуға, аударуға және анықтауға болады.</translation>
<translation id="8310603974518734211">Chromium-ге <ph name="USER_NAME" /> ретінде кіруге арналған QR коды</translation>
<translation id="8313851650939857356">Іске қосу қатесі: <ph name="STARTUP_ERROR" />.</translation>
<translation id="2189465505625523876">Ұйымыңыз Shuttle-ді <ph name="TIMEOUT_DURATION" /> бойы пайдаланбаған кезде жабады.</translation>
<translation id="8321888067342493336">Сурет түрінде сақтау</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> бұрын Chromium браузерін пайдаланған</translation>
<translation id="8351551329754447960">Chromium-дегі дағдыларды қосу</translation>
<translation id="8359544530202147897">Chromium деректерін Google аккаунтында (<ph name="ACCOUNT_EMAIL" />) әрі қарай пайдалану үшін Chromium-ді жаңартыңыз.</translation>
<translation id="8360718212975266891">Chromium-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8 нұсқасы орнатылған.</translation>
<translation id="8362914115861174987">Аударма тілі:</translation>
<translation id="8367705492654390392">Кез келген нәрсе сұраңыз</translation>
<translation id="8370517070665726704">Copyright <ph name="YEAR" /> Google LLC. Барлық құқықтары қорғалған.</translation>
<translation id="8372327902843331129">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін Chromium аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл құпия сөз Google аккаунтыңызға сақталады.</translation>
<translation id="7737586770085807713">Содан кейін Shuttle-ді өшіріп қосуыңыз қажет.</translation>
<translation id="458720374088121514">Shuttle оны өшіруге кеңес береді. <ph name="BEGIN_LINK" />Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK" /></translation>
<translation id="3243699608914041912">Бұл кеңейтімді әзірлеушісі жариялаудан бас тартқан, сондықтан ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Shuttle-нан жойыңыз.</translation>
<translation id="8416884904046428725">Chromium браузері деректерді Google аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="2803567348225973544">{0,plural, =1{Shuttle браузерін бір күннің ішінде қайта іске қосыңыз}other{Shuttle браузерін # күннің ішінде қайта іске қосыңыз}}</translation>
<translation id="8438543370129609977">Сурет іздеу функциясын пайдалансаңыз, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге жіберіледі. <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">Chromium-де сурет іздеу функциясымен іздеу туралы толық ақпарат</translation>
<translation id="8453117565092476964">Орнатқыш мұрағаты бүлінген немесе жарамсыз. Chromium қайтадан жүктеңіз.</translation>
<translation id="8458614432758743027">Chromium браузері Windows 10 жүйесін не одан кейінгі нұсқасын қажет етеді.</translation>
<translation id="8463672209299734063">Міндетті емес: диагностика және пайдалану туралы деректі Google-ға автоматты түрде жіберу арқылы ChromiumOS функциялары мен жұмыс өнімділігін жақсартуға көмектесіңіз.</translation>
<translation id="8471947159125090285">Google аккаунтында Chromium деректерін пайдалану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="8482493977473846331">Chromium-ге кіру нұсқауларын көрсетеді</translation>
<translation id="4333599663015089415">Shuttle ескірген</translation>
<translation id="8376091195503089226">Shuttle-ді әдепкі браузер етіп таңдағаныңызға рақмет!</translation>
<translation id="8522801943730206384">Құпия сөздер сақталған кезде, Chromium оларды тексере алады.</translation>
<translation id="8525579356836940628">Орнату тоқтап қалды.</translation>
<translation id="8545729292258443488"><ph name="DEVICE_TYPE" /> құрылғысындағы Chromium-мен құпия сөздерді, қойындылар мен басқа деректерді жол-жөнекей пайдаланыңыз</translation>
<translation id="8548787790260785208">Chromium құпия сөздеріңіздің бірін баршаға ашық қолды болған деректерден тапса, ескерту алыңыз.</translation>
<translation id="8555465886620020932">Қызмет қатесі: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3871600948131730253">Кейбір Shuttle функциялары мен кеңейтімдерінің жылдам пәрмендері бар. Оларды қайта қосуға болады.</translation>
<translation id="8556420416730706394">"Сурет іздеу" функциясына оңай кіру үшін оны бекітуге болады. Ол үшін бүйірлік панельдің жоғарғы жағындағы "Бекіту" түймесін басыңыз.</translation>
<translation id="856656450041460113">Тілдер тізімін іздеу</translation>
<translation id="2164758091986776102">Shuttle-ді бірнеше ұйым басқарады</translation>
<translation id="7921569471494089882">Copyright <ph name="YEAR" /> Silkweave. Барлық құқықтар қорғалған.</translation>
<translation id="8601359445272098721">Жаңалық! Енді "экранды аудару" түймесін басу арқылы экрандағы мәтін мен суреттерді де аудара аласыз.</translation>
<translation id="5197416451456327645">Shuttle іске қосылуда…</translation>
<translation id="8624541899164515475">Параметрлер, жаңа қойындыда ашылады.</translation>
<translation id="8648201657708811153">Google Chrome for Testing браузерін әдепкі браузер қылу мүмкін емес.</translation>
<translation id="733927313102300080">Сонымен қатар ол Shuttle іске қосқаныңызда немесе Omnibox ішінен іздегеніңізде қайсы бет көрсетілетінін бақылайды.</translation>
<translation id="8704119203788522458">Сізге арналған Chromium.</translation>
<translation id="8712637175834984815">Түсінікті</translation>
<translation id="8719993436687031146">Chromium-ге кіру қажет пе?</translation>
<translation id="8747073452963259673">іздеу аймағының төменгі сол жақ бұрышы: сол жақ <ph name="LEFT" />%, төменгі жақ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Орнату қатесі: желі әкімшісі орнатуға рұқсат бермейтін топтық саясатты қолданды: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Кейінірек еске салу</translation>
<translation id="8816416449795340678">Қысқаша мазмұнын біліп, қосымша сұрақтар қою үшін бұл құжатты Chromium-дегі Gemini-мен бөлісіңіз.</translation>
<translation id="8818550178040858407">Chromium-ге кіру қажет пе?</translation>
<translation id="1740477639007879167">Shuttle-ді әдепкі браузер қылу және тапсырмалар жолағына бекіту</translation>
<translation id="8826492472752484139">"Password Manager" түймесін басыңыз.</translation>
<translation id="8833697763442816810">ChromiumOS жүйесі</translation>
<translation id="51810846847651902">Бұл тіл Shuttle-де мәзірлерді, параметрлерді, ескертулерді және басқа мәтінді көрсету үшін пайдаланылады.</translation>
<translation id="8862326446509486874">Жүйе деңгейінде орнату үшін тиісті құқықтарыңыз жоқ. Әкімші ретінде орнату құралын қайта іске қосып көріңіз.</translation>
<translation id="8876044221123442390">Chromium профилін қосу</translation>
<translation id="8890569919834781711">Кіру кезіндегі қатеге байланысты ChromiumOS жүйесі Chromium деректерін Google аккаунтыңызға сақтай алмады.</translation>
<translation id="8891709362986793894">Ұйымыңыз Chromium-ге кіруді талап етеді</translation>
<translation id="8907580949721785412">Chromium құпия сөздерді көрсетуге әрекет етуде. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="8932992523185907506">Chromium енді әдепкі браузеріңіз емес. Оны әдепкі браузер ретінде орнату қажет пе?</translation>
<translation id="7727082350762937793">Shuttle браузерін жаңарту мүмкін емес</translation>
<translation id="8944232836376404813">Бұл әрекет:
          <ph name="LINE_BREAKS" />
            • бастапқы бетті, жаңа қойынды бетін, іздеу жүйесін және бекітілген қойындыларды бастапқы күйге қайтарады;
            <ph name="LINE_BREAK" />
            • кеңейтімдерді өшіреді;
            <ph name="LINE_BREAK" />
            • cookie файлдарын және басқа уақытша сайт деректерін жояды.
            <ph name="LINE_BREAKS" />
            Бетбелгілерге, тарихқа және сақталған құпия сөздерге ештеңе болмайды.</translation>
<translation id="8966875421152977384">Chromium сайтының пернелер тіркесімдерін көрсету</translation>
<translation id="1008106080699243847">Shuttle Enterprise логотипі</translation>
<translation id="8980139959902937527"><ph name="DEVICE_TYPE" /> құрылғысындағы Chromium-мен жол-жөнекей Google қауіпсіздігін қамтамасыз етіңіз</translation>
<translation id="3649746906258419479">Профиліңізді ашу кезінде бірдеңе дұрыс болмағандықтан, Shuttle-ді іске қосу мүмкін емес. Shuttle-ді қайта іске қосып көріңіз.</translation>
<translation id="8988036198400390003">Chromium профильдерін басқару</translation>
<translation id="8993855408334954620">Chromium-дегі Gemini мен ашық қойынды арасында ауысу үшін пернетақтаны пайдаланыңыз.</translation>
<translation id="9018218886431812662">Орнату аяқталды</translation>
<translation id="9019929317751753759">Chromium браузерін қауіпсіз ету үшін, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> тізімінде жоқ келесі кеңейтім өшірілді, ол сізге ескертілмей қосылған болуы мүмкін.</translation>
<translation id="9022552996538154597">Chromium жүйесіне кіру</translation>
<translation id="9035791714111278917">Chromium-мен іздеу функциясын Mac мәзір жолағында көрсету және пернелер тіркесімін қосу</translation>
<translation id="3267341748208131224">Shuttle бұл мұрағаттау файлын жүктеп алуға тыйым салды, себебі онда зиянды бағдарламаны жасыруы мүмкін басқа файлдар бар</translation>
<translation id="9053882453960391422">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді Chromium-ге ауыстырып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз. Жылдам кіру үшін, Chromium тапсырмалар жолағына бекітіледі.</translation>
<translation id="9056398481763999048">Телефондағы Chromium-мен Google-дың үздік жасанды интеллект құралдарын пайдаланыңыз</translation>
<translation id="9062666675513499497">Басқа Google қызметтеріне кірген кезде, Chromium-ге де кіресіз</translation>
<translation id="4265215433857167851">Shuttle автоматты түрде жабылған</translation>
<translation id="7469466263552552140">Shuttle ескірген</translation>
<translation id="72499647218501325">{0,plural, =1{Shuttle браузері бір сағаттан кейін қайта іске қосылады}other{Shuttle браузері # сағаттан кейін қайта іске қосылады}}</translation>
<translation id="9106236359747881194">Іздеу үшін мәтін таңдаңыз.</translation>
<translation id="9106612006984859720">Chromium-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8.1 нұсқасы орнатылған.</translation>
<translation id="3313508441926611846">Сілтемені жаңа Shuttle қойындысында ашу</translation>
<translation id="911206726377975832">Сонымен қатар шолу деректеріңізді жоясыз ба?</translation>
<translation id="9134482777260927479">Үй тапсырмасын орындауға көмектесу</translation>
<translation id="9148058034647219655">Шығу</translation>
<translation id="373308981796873164">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, Shuttle қойындыларды қалпына келтіре алады. Мұны қосу үшін келесі бөлімге өтіңіз:</translation>
<translation id="4482819741686179260">Жүйе әкімшісі Shuttle браузерін <ph name="TARGET_URL_HOSTNAME" /> сілтемесіне қосымша браузер арқылы кіре алатындай етіп конфигурациялады.</translation>
<translation id="5239882079227870661">&amp;Shuttle-ді жаңарту үшін қайта іске қосу</translation>
<translation id="9190841055450128916">Chromium (mDNS-In)</translation>
<translation id="924957577793602335">Chromium браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="93478295209880648">Chromium дұрыс жұмыс істемеуі мүмкін, себебі оған Windows XP не Windows Vista жүйелерінде қолдау көрсетілмейді</translation>
<translation id="945098430667185067">Chromium арқылы Google-дың ең үздік қауіпсіздік функцияларын жол-жөнекей пайдаланыңыз.</translation>
<translation id="945522503751344254">Пікір жіберу</translation>
<translation id="965162752251293939">Chromium-ді кім пайдаланып жатыр?</translation>
<translation id="967427899662692980">Chromium браузерінің ең күшті қорғанысын қолданыңыз</translation>
<translation id="983803489796659991">Орнатылмады, себебі жаңарту серверінде қолданбаға арналған хештеу деректері жоқ.</translation>
<translation id="985498048907240953">Chromium-ді аккаунтсыз қолдану</translation>
<translation id="5192139095541169725">Silkweave</translation>
<translation id="989970834842471429">"Сурет іздеу" функциясымен іздеу керек кез келген мәтінді не суретті таңдаңыз.</translation>
<translation id="1699696098551154749">Локацияны пайдалану үшін <ph name="BEGIN_LINK" />жүйе параметрлерінде<ph name="END_LINK" /> Shuttle-ге рұқсат беріңіз.</translation>
</translationbundle>