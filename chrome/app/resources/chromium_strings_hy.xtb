<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1026101648481255140">Վերսկսել տեղադրումը</translation>
<translation id="1029669172902658969">Վերագործարկել՝ &amp;ChromiumOS-ը թարմացնելու համար</translation>
<translation id="8271032073852564289">Agent Chrome-ը խորհուրդ է տալիս ստուգել այս ընդլայնումը</translation>
<translation id="1395700234492294565">Երբ որևէ կայք հայցում է էջերի անանուն նախաբեռնում իր էջում առկա հղումների միջոցով, Agent Chrome-ը օգտագործում է Google-ի սերվերները։ Այդպիսով ձեր անձնական տվյալները չեն փոխանցվում, սակայն Google-ը իմանում է, թե որ կայքերն են նախապես բեռնվում։</translation>
<translation id="1051793555070215510">Օգնեք մեզ բարելավել ինկոգնիտո ռեժիմը՝ անցնելով այս 1 րոպեանոց հարցումը։</translation>
<translation id="1065672644894730302">Ձեր նախասիրությունները չի հաջողվում ստանալ:

Որոշ գործառույթներ կարող են մատչելի չլինել: Նախընտրանքների փոփոխությունները չեն պահպանվի:</translation>
<translation id="3693661839172633833">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը Agent Chrome-ում</translation>
<translation id="4676383270508741906">Agent Chrome-ի որոշակի գործառույթ կամ ընդլայնում որոնելու համար հասցեագոտում մուտքագրեք դրա դյուրանցումը, ապա՝ ձեր ընտրած ստեղնը</translation>
<translation id="1098493699368672217">Ցույց տալ Chromium-ով որոնումը ծանուցման տարածքում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="1104942323762546749">Chromium-ն ուզում է արտահանել ձեր գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="112640046208448578">Նույնականացրեք իրեր կամ վայրեր և պատճենեք կամ թարգմանեք տեքստեր։ Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի սքրինշոթն ուղարկվում է սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="5373975050135708711">Agent Chrome-ը ձեր կանխադրված դիտարկիչն է</translation>
<translation id="1131805035311359397">Որպեսզի պաշտպանեք ձեր գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ Chromium դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="1153368717515616349">Սեղմեք Chromium-ի ընտրացանկը</translation>
<translation id="1157985233335035034">Վերջերս ընտրված լեզուներ</translation>
<translation id="1184145431117212167">Տեղադրումը ձախողվեց, քանի որ Windows-ի ձեր տարբերակը չի աջակցվում։</translation>
<translation id="604454529346438712">Agent Chrome-ի մասին</translation>
<translation id="1186645291482254714">Ստացեք գների հետագծման ծանուցումներ ձեր հեռախոսի Chromium դիտարկիչում</translation>
<translation id="1203500561924088507">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր դիտարկիչը։</translation>
<translation id="1232234696885483911">Երբ բացեք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ավտոմատ կուղարկվեն սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">Հաշիվ մուտք գործած ժամանակ Chromium-ում դուք կարող եք օգտագործել ձեր գաղտնաբառերն ու մյուս կարգավորումները ձեր Google հաշվից։ Այս կարգավորումը փոխելու համար անցեք «Ձեր հաշիվը Chromium-ում» բաժին։</translation>
<translation id="1244381985120794049">Ցույց տալ «Gemini-ը Chromium-ում» հավելվածը Mac-ի ընտրացանկի գոտում</translation>
<translation id="1257483544893909270">«Gemini-ը Chromium-ում» հավելվածում էկրանի մի մասն ընտրելու համար օգտագործել ստեղնային դյուրանցում։</translation>
<translation id="1262876892872089030">Մինչ այս ներդիրն ակտիվ չէր, Chromium-ի աշխատանքի արագությունը պահպանելու համար տարածք է ազատվել։ Դուք կարող եք ընտրել, որ այս կայքը միշտ ակտիվ մնա։</translation>
<translation id="3777643518642881741">Agent Chrome-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը վտանգավոր է</translation>
<translation id="126567311906253476">Երբ <ph name="USER_EMAIL" /> հաշվի միջոցով մուտք եք գործում Google-ի ծառայություններ, օր․՝ Gmail կամ YouTube, նույն հաշվի միջոցով կարող եք ավտոմատ մուտք գործել Chrome</translation>
<translation id="1287534462498555020">Ներբեռնեք Chromium-ը ձեր հեռախոսում</translation>
<translation id="1290883685122687410">Կարգավորման սխալ՝ <ph name="METAINSTALLER_EXIT_CODE" />։ <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Կարգավորեք Chromium-ի ձեր նոր պրոֆիլը</translation>
<translation id="132092532143527429">Փորձել Gemini-ը Chromium-ում</translation>
<translation id="200785071050073583">Agent Chrome-ին անհրաժեշտ է Bluetooth-ի հասանելիություն՝
 Bluetooth սարքեր որոնելու համար։ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">Մուտք գործեք Chromium ձեր հեռախոսում</translation>
<translation id="1330562121671411446">Ճանաչել լեզուն</translation>
<translation id="1342274909142618978">Նաև հեռացնել տվյալները Chromium-ից (<ph name="URL" />)</translation>
<translation id="1345251407431278948">«Որոնում պատկերով» գործառույթն ամրացված է․ այն բացելու համար օգտագործեք գործիքագոտու նոր կոճակը</translation>
<translation id="1356661055722410047">Նորույթ․ դուք կարող եք ձեր էկրանին թարգմանել ինչպես տեքստ, այնպես էլ պատկերներ</translation>
<translation id="1383876407941801731">Որոնում</translation>
<translation id="1388276868779258475">Շարունակեք դիտարկումը Chromium հավելվածի միջոցով՝ շարժման մեջ</translation>
<translation id="141901961143729572">Կիսվեք ձեր մտքերով</translation>
<translation id="8789809509510733987">Ձեր պատուհանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Agent Chrome-ի համար։</translation>
<translation id="1478370723027452770">Ստանալ օգնություն Chrome for Testing-ի միջոցով</translation>
<translation id="1497802159252041924">Տեղադրման սխալ՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Այս էջը պաշտպանված է</translation>
<translation id="3850708453627715578">Կիսվեք Agent Chrome-ի ներդիրով</translation>
<translation id="154404805518949443">Մուտք գործել Chromium</translation>
<translation id="1547469039832541117">Ավարտում է ընդգծված առաջադրանքը։</translation>
<translation id="8546278207686764484">Ամրացնել Agent Chrome-ը</translation>
<translation id="1574377791422810894">Chromium-ի անվտանգության գործիքներ</translation>
<translation id="1594928384848033697">Chromium-ը ուզում է ջնջել Գաղտնաբառերի կառավարչի ձեր տվյալները։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="551713766576210710">{COUNT,plural, =0{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Agent Chrome-ը}=1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Agent Chrome-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Agent Chrome-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Agent Chrome-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="1623563412065267963">Օգտվեք Google-ի բոլոր առավելություններից ձեր հեռախոսի Chromium հավելվածի միջոցով</translation>
<translation id="1625909126243026060">Դիտեք գաղտնիության և անվտանգության հիմնական կառավարման տարրերը Chromium-ում։</translation>
<translation id="1640672724030957280">Ներբեռնում…</translation>
<translation id="1665602916345474427">Մուտք եք գործել որպես <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, բաժանորդագրություն։ Բացել հաշվի ընտրացանկը</translation>
<translation id="2604712040942461790">Օգտագործեք Agent Chrome-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա։ Այն նաև կամրացվի հավելվածների վահանակում։</translation>
<translation id="1709772298389099340">Ընդլայնված արտոնություններ է տալիս <ph name="BROWSER_NAME" />-ին։</translation>
<translation id="1722488837206509557">Սա ձեզ թույլ կտա ընտություն կատարել հասանելի սարքերից և բովանդակություն ցուցադրել այդ սարքերում։</translation>
<translation id="4145295773323539953">Agent Chrome-ը շուտով կջնջի դիտարկման տվյալները</translation>
<translation id="1736443181683099871">Chromium-ը կփորձի անցնել HTTPS հաղորդակարգի</translation>
<translation id="7280502947294080605">Agent Chrome-ի տվյալները մաքրվեցին</translation>
<translation id="1745121272106313518">Chromium-ը կվերագործարկվի <ph name="REMAINING_TIME" />ից</translation>
<translation id="1749104137266986751">Երբ HTTPS հաղորդակարգը հասանելի չէ, Chromium-ը առանց ձեզ զգուշացնելու կօգտագործի ոչ ապահով միացում</translation>
<translation id="1887395919652703120">Թույլ տալ Agent Chrome-ին աշխատել հետնաշերտում</translation>
<translation id="1779356040007214683">Chromium-ն ավելի ապահով դարձնելու համար որոշ ընդլայնումներ, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացվել առանց ձեր իմացության, անջատվել են։</translation>
<translation id="1793486931176048546">Սեղմեք <ph name="BEGIN_BOLD" />Այո<ph name="END_BOLD" /> Windows-ի ծանուցման մեջ՝ Chromium-ը հավելվածների վահանակում ամրացնելու համար։</translation>
<translation id="357645171972700077">Նորից տեղադրել Agent Chrome-ը</translation>
<translation id="1820835682567584003">Chromium-ը փորձում է <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք Chromium-ը, կտեսնեք Google գաղտնաբառերի կառավարիչն օգտագործելու հրավեր։</translation>
<translation id="1838374766361614909">Մաքրել որոնումը</translation>
<translation id="18552579716432081">Այցելությունների պատմությունը միայն այս սարքից ջնջելու, սակայն Google հաշվում պահպանելու համար <ph name="BEGIN_LINK" />դուրս եկեք Chromium-ից<ph name="END_LINK" />։</translation>
<translation id="1857749206890802997">Ներբեռնեք Chromium-ը հեռախոսում՝ ցանկացած վայրից ներդիրների նոր խմբեր բացելու կամ ստեղծելու համար։</translation>
<translation id="185970820835152459">Դուք կարող եք կառավարել ձեր Google հաշիվները, որոնցում մուտք եք գործել։ Դրանք օգտագործվում են Chromium դիտարկիչում, Play Խանութում, Gmail-ում և այլ ծառայություններում։ Եթե ուզում եք ընտանեկան խմբի անդամի կամ մեկ ուրիշի համար հաշիվ ավելացնել, <ph name="DEVICE_TYPE" /> սարքում ավելացրեք նոր օգտատեր։ <ph name="LINK_BEGIN" />Իմանալ ավելին<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Որոնել «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="1863837059069884561"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Chromium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն էջանիշները և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="1880677175115548835">Ընտրեք տեքստը</translation>
<translation id="1881322772814446296">Դուք մուտք եք գործում վերահսկվող հաշիվ` թույլ տալով ադմինիստրատորին վերահսկել ձեր Chromium պրոֆիլը: Ձեր Chromium տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները մշտապես կկցվեն <ph name="USER_NAME" />-ին: Դուք կարող եք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարող համակցել այս տվյալները այլ հաշվի հետ: Կարող եք ստեղծել նոր պրոֆիլ՝ ձեր առկա Chromium տվյալներն առանձին պահելու համար: <ph name="LEARN_MORE" /></translation>
<translation id="4964792828232534953">Agent Chrome-ը տնտեսում է մարտկոցի լիցքը՝ սահմանափակելով աշխատանքը ֆոնային ռեժիմում և վիզուալ էֆեկտները, օրինակ՝ սահուն ոլորումը և տեսանյութերի կադրերի հաճախականությունը։ <ph name="BEGIN_LINK" />Իմանալ ավելին Էներգիայի խնայման մասին<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">Chromium Updater ծառայություն</translation>
<translation id="1911763535808217981">Անջատելով այս գործառույթը՝ դուք կարող եք մտնել հաշիվ Google-ի կայքերում, օրինակ՝ Gmail, առանց մուտք գործելու Chromium:</translation>
<translation id="1929939181775079593">Chromium-ը չի պատասխանում: Վերագործարկե՞լ:</translation>
<translation id="1933341829955786215">Ձեր կազմակերպության (<ph name="MANAGER" />) կանոնների համաձայն՝ դուք պետք է մուտք գործեք Chromium</translation>
<translation id="193439633299369377">Թարմացումը կիրառելու համար հարկավոր է վերագործարկել ChromiumOS-ը։</translation>
<translation id="207375373460618430">Agent Chrome-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլի այս տեսակը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="1953553007165777902">Ներբեռնում… Մնաց <ph name="MINUTE" /> րոպե</translation>
<translation id="700162948230159797">Agent Chrome-ը չի կարողանում որոշել կամ սահմանել կանխադրված դիտարկիչը</translation>
<translation id="197326043290947695">Որոնեք ավելի խելացի կերպով «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="1990262977744080398">Իմացեք, թե ինչու է Chromium-ն արգելափակում որոշ ֆայլեր կամ բացում նոր ներդիրում</translation>
<translation id="1999715455684970349">Թարմացնում է Chromium-ի ծրագրակազմը։ Եթե անջատեք կամ դադարեցնեք ծառայությունը, դա կարող է հանգեցնել նրան, որ ի հայտ եկած խոցելիությունները չշտկվեն, և որոշ գործառույթներ չաշխատեն։ Այս ծառայությունն ավտոմատ կհեռացվի, եթե չկա Chromium-ի ծրագրակազմ, որն օգտագործում է այն։</translation>
<translation id="2008474315282236005">1 տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="2018879682492276940">Չհաջողվեց տեղադրել։ Նորից փորձեք։</translation>
<translation id="2039417478970545937">Կարգավորումներ։</translation>
<translation id="2049376729098081731">Ընտրեք, թե արդյոք ներառել Chromium-ի պատմությունը՝ Google-ի ծառայությունների ավելի անհատականացված օգտագործման համար։</translation>
<translation id="2050698962207788467">Ներկառուցված է Chromium-ում՝ օգնելու ձեզ ստեղծել, պահել և ավտոմատ լրացնել հուսալի գաղտնաբառեր։ Ավելացրեք դյուրանցումը՝ արագ մուտքի համար։</translation>
<translation id="2064856577282482477">Սեղմեք «Անհատականացնել Chromium-ը» կոճակը նոր ներդիրի էջում՝ Chromium-ին նոր տեսք հաղորդելու համար</translation>
<translation id="6816376218079012438">Agent Chrome-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կասկածելի է և կարող է անսպասելի փոփոխություններ կատարել ձեր սարքում</translation>
<translation id="208726765006323911">Հաջորդ անգամ Chromium iOS-ը բացելիս կտեսնեք <ph name="FEATURE_NAME" /> գործառույթը փորձելու հրավեր։</translation>
<translation id="2099452623287920103">Ձեր գաղտնաբառերն ու Chromium-ի մյուս տվյալները, որոնք պահել եք ձեր Google հաշվում, կհեռացվեն այս սարքից։ Chromium-ում դրանք նորից օգտագործելու համար պետք է կրկին մուտք գործեք։</translation>
<translation id="8983263343920390117">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Agent Chrome-ը 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}one{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Agent Chrome-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}other{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Agent Chrome-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}}</translation>
<translation id="2125838419757773031">Որոնելու համար ընտրեք էկրանի տարածքը</translation>
<translation id="2126108037660393668">Ներբեռնված ֆայլը չանցավ հաստատումը։</translation>
<translation id="2135919691573380097">Հաղորդել այս կայքի մասին</translation>
<translation id="2137162749895930932">Փակել թարգմանել պատուհանը</translation>
<translation id="822057692680289847">Agent Chrome-ն արգելափակել է այս ներբեռնումը, քանի որ կայքը չի օգտագործում անվտանգ կապ, և ֆայլում, հնարավոր է, չարտոնված գործողություններ են կատարվել</translation>
<translation id="2170098639895543546">Ընտրեք ցանկացած բան էջում</translation>
<translation id="2174178932569897599">Անհատականացնել Chromium-ը</translation>
<translation id="2174917724755363426">Տեղադրումը չի ավարտվել։ Իսկապե՞ս ուզում եք չեղարկել։</translation>
<translation id="922967513335788675">Agent Chrome – Ցանցի մուտք – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Թարմացումների ստուգման սխալ՝ <ph name="UPDATE_CHECK_ERROR" />։</translation>
<translation id="2199210295479376551">Հեռացնել հաշիվը Chromium-ից</translation>
<translation id="2201788217099588893">Օգտագործեք Chromium հավելվածը՝ գնումների համար լավագույն գործիքներից շարժման մեջ օգտվելու համար</translation>
<translation id="2210502920229141283">iOS-ի համար Chromium-ում բարելավված Ապահով դիտարկումը կօգնի պաշտպանել բջջային սարքերի տվյալները</translation>
<translation id="2210682093923538346">Վտանգավոր կայք։ Chromium-ը հեռացրել է ծանուցումների թույլտվությունը։</translation>
<translation id="2236949375853147973">Իմ գործողությունները</translation>
<translation id="2238130810669087193">Հասցեները և այլ տվյալներ ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Chromium։ Այս հասցեն կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="2241627712206172106">Եթե ձեզնից բացի որևէ այլ մեկն օգտվում է այս համակարգչից, օրինակ ձեր ընկերները կամ հարազատները, ապա նրանք կարող են առանձին աշխատել և կարգավորել Chromium-ն իրենց ուզած ձևով:</translation>
<translation id="22571759390241347">Հմտություններ Chromium-ում</translation>
<translation id="2283803047247799269">Որոնել այս ներդիրը պատկերով որոնման միջոցով</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Chromium-ը խորհուրդ է տալիս դադարեցնել ներդիրը, որը դադաղեցնում է ձեր դիտարկիչը}one{Chromium-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}other{Chromium-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}}</translation>
<translation id="2307973900865360088">Ամրացնել Dock վահանակի վրա</translation>
<translation id="2313870531055795960">Ստուգում է URL-ները Chromium-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Chromium-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2356070529366658676">Հարցնել</translation>
<translation id="2359808026110333948">Շարունակել</translation>
<translation id="2361918034042471035">«<ph name="EXTENSION_NAME" />» ընդլայնումն ուզում է, որ դուք մուտք գործեք Chromium</translation>
<translation id="2028456545634496358">Անջատել Agent Chrome-ի ֆոնային ռեժիմը հավելվածների համար</translation>
<translation id="2374216753258219393">Այս ընդլայնումը որպես <ph name="USER_EMAIL_ADDRESS" /> օգտագործելու համար մուտք գործեք Chromium։</translation>
<translation id="2384373936468275798">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են։</translation>
<translation id="3040857862310351495">{NUM_DEVICES,plural, =0{Agent Chrome-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 HID սարքի հասանելիություն}=1{Agent Chrome-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 HID սարք}one{Agent Chrome-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}other{Agent Chrome-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}}</translation>
<translation id="2401032172288869980">Այս կայքի համար Chromium-ին անհրաժեշտ է խոսափողն ու տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2403703063067034158">Մեկնարկի սխալ․ ներկայումս կարգավորման մեկ այլ օրինակ է աշխատում։ Փորձեք ավելի ուշ։</translation>
<translation id="2418322681019544463">Բացեք հղումները Chromium-ում ցանկացած հավելվածից և պահեք դիտարկիչը հավելվածների վահանակում՝ հեշտ մուտքի համար</translation>
<translation id="2425157128016763890">Սեղմեք «Ամփոփել» կոճակը՝ այս փաստաթղթով Gemini-ի հետ Chromium-ում կիսվելու համար, որպեսզի ստանաք համառոտ նկարագրություն և լրացուցիչ հարցեր տաք</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-ի գործիքների<ph name="END_LINK" /> միջոցով դուք կարող եք ապահով դիտարկել և կառավարել կարգավորումները</translation>
<translation id="2449487342837813167"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Chromium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Գաղտնաբառերը և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="2451727308784734061">Արագ բացեք Գաղտնաբառերի կառավարիչը դյուրանցման միջոցով։ Դյուրանցումը կարող եք տեղափոխել համակարգչի հիմնական էկրան կամ հավելվածների գործարկիչ։</translation>
<translation id="4405360797107732759">Agent Chrome-ը շուտով կփակվի</translation>
<translation id="1660473983484527105">Agent Chrome-ի մեջ</translation>
<translation id="2485422356828889247">Ապատեղադրել</translation>
<translation id="2513154137948333830">Հարկավոր է վերաբեռնել. <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Ընտրեք տեքստ «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="2554739539410784893">Chromium-ը փորձում է փոխարինել գոյություն ունեցող գաղտնաբառերը։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="2560420686485554789">Ֆայլեր ներբեռնելու համար Chromium-ին անհրաժեշտ է պահեստի օգտագործման թույլտվություն</translation>
<translation id="8620990455069644819">Agent Chrome օգնական</translation>
<translation id="2575822587468774919">Ընտրեք ցանկացած բան՝ «Որոնում պատկերով» գործառույթի միջոցով որոնելու համար</translation>
<translation id="2576118232315942160">Գաղտնաբառերը և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Chromium</translation>
<translation id="2587622539943955767">Հեռախոսով սկանավորեք QR կոդը՝ Chromium-ը ներբեռնելու և ձեր Google հաշիվ մուտք գործելու համար։</translation>
<translation id="4496289616420025644">Շարունակել Agent Chrome-ի օգտագործումը</translation>
<translation id="259935314519650377">Չհաջողվեց քեշավորել ներբեռնված տեղադրիչը։ Սխալ՝ <ph name="UNPACK_CACHING_ERROR_CODE" />։</translation>
<translation id="2620436844016719705">Համակարգ</translation>
<translation id="2629740064077610681">Ձեր կազմակերպությունը կարող է տեսնել և կառավարել այցելությունների պատմությունը, օրինակ՝ էջանիշները, պատմությունը և գաղտնաբառերը։ Chromium-ի անձնական պրոֆիլներում այցելությունների պատմությունը հասանելի չի լինի ձեր կազմակերպությանը։</translation>
<translation id="2635452620547538388">Հաստատեք ձեր ինքնությունը, որպեսզի օգտագործեք և պահեք Chromium-ի տվյալները ձեր <ph name="ACCOUNT_EMAIL" /> հաշվում</translation>
<translation id="8944895445911901418">{COUNT,plural, =0{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Agent Chrome-ը}=1{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Agent Chrome-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Agent Chrome-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Agent Chrome-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="263863604136125912">Գործարկել Chromium-ը</translation>
<translation id="2648074677641340862">Տեղադրման ժամանակ օպերացիոն համակարգի սխալ տեղի ունեցավ: Նորից տեղադրեք Chromium-ը:</translation>
<translation id="2661879430930417727">Եթե ձեզնից բացի որևէ այլ օգտատեր օգտվում է այս սարքից (օրինակ՝ ձեր ընկերները կամ հարազատները), ապա նրանք կարող են առանձին աշխատել և անհատականացնել Chromium-ը</translation>
<translation id="2676569452213089702">Թույլ է տալիս արագ բացել «Gemini-ը Chromium-ում» հավելվածը ձեր սարքում, նույնիսկ եթե Chromium-ը ծալված է։</translation>
<translation id="3144164911846092828">Agent Chrome-ի ներդիր</translation>
<translation id="2718390899429598676">Լրացուցիչ անվտանգության համար Chromium-ը կգաղտնագրի ձեր տվյալները:</translation>
<translation id="2721354645805494590">Ձեր Google հաշիվը Chromium-ից հեռացնելու համար դուրս եկեք հաշվից</translation>
<translation id="2722636413143664436">Գաղտնաբառերը, էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Chromium</translation>
<translation id="2738871930057338499">Հնարավոր չէ միանալ ինտերնետին։ HTTP 403 Forbidden։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="2753623023919742414">Սեղմեք որոնելու համար</translation>
<translation id="2657110490709402112">Սահմանեք Agent Chrome-ը որպես ձեր կանխադրված PDF դիտակ</translation>
<translation id="4262158525170658092">Այս ընդլայնումը պարունակում է վնասագիր և վտանգավոր է։ Հեռացրեք ընդլայնումը Agent Chrome-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="2799223571221894425">Վերագործարկել</translation>
<translation id="4930235474290498361">Ձեր Agent Chrome-ը</translation>
<translation id="2816462166102338036">Որոնել այս տեսանյութը պատկերով որոնման միջոցով</translation>
<translation id="282591729717417030">Գտեք ապրանքներ ձեր տեսախցիկի օգնությամբ, հետևեք գնիջեցումներին և ավելին արեք շարժման մեջ՝ iOS-ի համար Chromium հավելվածի միջոցով։</translation>
<translation id="2841525013647267359">Թարգմանվող լեզու</translation>
<translation id="2846251086934905009">Տեղադրման սխալ. չհաջողվեց ավարտել տեղադրումը։ Գործընթացն ընդհատվել է։</translation>
<translation id="2847479871509788944">Հեռացնել Chromium-ից...</translation>
<translation id="2850691299438350830">Ապահովում է ձեր անվտանգությունը Chromium-ում և Google հավելվածներում, երբ մտել եք ձեր հաշիվ։</translation>
<translation id="2885378588091291677">Task Manager</translation>
<translation id="8454027198329266279">&amp;Agent Chrome-ի մասին</translation>
<translation id="2915996080311180594">Վերագործարկել ավելի ուշ</translation>
<translation id="2933336679234709858">Ձեր տվյալները գաղտնագրված են անցաբառով։ Chromium-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="2945997411976714835">Տեղադրման սխալ. չհաջողվեց սկսել տեղադրումը։</translation>
<translation id="2948852018303413228">Ավելի արագ մուտք գործեք կայքեր՝ օգտագործելով iOS-ի համար Chromium-ում պահված գաղտնաբառերը</translation>
<translation id="80325676287146281">Agent Chrome-ը կառավարվում է ձեր կազմակերպության կողմից</translation>
<translation id="789940813130504773">Agent Chrome-ը թարմացված է</translation>
<translation id="2977506796191543575">Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Chromium-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ Ապահով դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2981563588585023386">Ձեր ծնողների ընտրած ավելի անվտանգ կարգավորումներն օգտագործելու համար մուտք գործեք Chromium</translation>
<translation id="3003694935412297923">Բոլոր առաջադրանքները</translation>
<translation id="3012615494352020668">{count,plural, =1{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Chromium-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները (1 տարր) կջնջվեն։}one{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Chromium-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}other{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Chromium-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}}</translation>
<translation id="8084335581332031126">Բացել <ph name="URL" /> հղումը Agent Chrome-ի նոր ներդիրում։</translation>
<translation id="302551344979399011">ԱԲ նորարարությունները, օրինակ՝ հմտությունները, պահվում են ձեր Google հաշվում և կառավարվում են Chromium-ի համաժամացումից առանձին</translation>
<translation id="7024173799494459794">Ավելացվում է Agent Chrome-ին…</translation>
<translation id="3038232873781883849">Սպասում ենք տեղադրմանը…</translation>
<translation id="3045032126857188731">Թարգմանության լեզուն՝ <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Փակել կարծիքով երկխոսության պատուհանը</translation>
<translation id="3068187312562070417">Chromium-ի այլ պրոֆիլներ</translation>
<translation id="3068290154869370196">Ընդլայնումները հավելումներ են, որոնք թույլ են տալիս անհատականացնել Chromium-ը։ Դրանք օգնում են կազմակերպել աշխատանքը, պարզեցնել առօրյա առաջադրանքները և անհատականացնել Chromium-ը։</translation>
<translation id="7027973430362347863">Օգնեք բարելավել Agent Chrome-ը՝ Google-ին ուղարկելով խափանման մասին հաշվետվությունները և <ph name="UMA_LINK" />ը</translation>
<translation id="3071024987058544609">Օգտագործեք Google-ի անվտանգության գործառույթները Chromium հավելվածի միջոցով՝ շարժման մեջ</translation>
<translation id="4925327325707966890">{NUM_DEVICES,plural, =0{Agent Chrome-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 USB սարքի հասանելիություն}=1{Agent Chrome-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 USB սարք}one{Agent Chrome-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}other{Agent Chrome-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}}</translation>
<translation id="6827369771274328769">Agent Chrome-ի պատմություն</translation>
<translation id="3103660991484857065">Տեղադրիչը չկարողացավ բացել արխիվը: Նորից ներբեռնեք Chromium-ը:</translation>
<translation id="310459126943037700">Չհաջողվեց ավարտել առաջադրանք(ներ)ը։</translation>
<translation id="3104828284009500087">Որոնեք ցանկացած բան էջում</translation>
<translation id="3126784891977756556">Ձեր գաղտնաբառերը, էջանիշները և պատմությունը կհամաժամացվեն ձեր բոլոր սարքերում։ Հեշտությամբ օգտագործեք ձեզ ծանոթ և սիրելի գործառույթները՝ որպես կանխադրված դիտարկիչ ընտրելով Chromium-ը։</translation>
<translation id="2894555444497054373">Agent Chrome-ն օգտագործում է ձեր խոսափողը:</translation>
<translation id="3130333203120345554">Նոր որոնում</translation>
<translation id="3137969841538672700">Քաշեք որոնելու համար</translation>
<translation id="3144188012276422546">Այս ներդիրն օգտագործում է լրացուցիչ ռեսուրսներ։ Թույլատրեք Chromium-ին ապակտիվացնել այն, և աշխատանքի արդյունավետությունը կբարձրանա։</translation>
<translation id="3092580151719004572">Ձեր էկրանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Agent Chrome-ի համար</translation>
<translation id="2314296667497715523">Agent Chrome-ի վերագործարկում</translation>
<translation id="3161522574479303604">Բոլոր լեզուները</translation>
<translation id="3179665906251668410">Բացել հղումը Chromium-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="3185330573522821672">Կարգավորեք Chromium-ի նոր պրոֆիլը</translation>
<translation id="3189205223539394158">Դուք կարող եք շարունակել զրույցը ԱԲ ռեժիմում՝ առանց մեկ ներդիրից մյուսն անցնելու։ Սկսելու համար մուտք գործեք Chromium։ Ձեր գաղտնաբառերը և այլ տվյալներ նույնպես հասանելի կլինեն բոլոր սարքերում։</translation>
<translation id="3224847870593914902">Ձեր Google հաշիվը Chromium-ից հեռացնելու համար դուրս եկեք Chromium-ից «Կարգավորումներ» էջում</translation>
<translation id="3234316605225071811">Հետագայում Chromium-ը կարող է հարցնել, թե արդյոք ուզում եք օգտագործել պահված տեղեկությունները ձևերի ավտոմատ լրացման համար</translation>
<translation id="5982289753835865194">Agent Chrome-ը չի կարող կարդալ և գրել իր տվյալների գրացուցակում՝

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">Օգտագործեք Google-ի ԱԲ գործիքները շարժման մեջ՝ iOS-ի համար Chromium-ի միջոցով։</translation>
<translation id="3286538390144397061">Վերագործարկել հիմա</translation>
<translation id="3920105041734426863">Google API-ի բանալիները չկան: Agent Chrome-ի որոշ գործառույթներ կանջատվեն:</translation>
<translation id="5621884903587730053">Շարունակել հետնաշերտի հավելվածների աշխատանքը, երբ Agent Chrome-ը փակված է</translation>
<translation id="3313189106987092621">Նախքան ոչ ապահով միացման միջոցով որևէ կայք բեռնելը Chromium-ը ձեզ կնախազգուշացնի</translation>
<translation id="3316771292331273802">Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք Chromium-ի բոլոր պատուհանները, սակայն կմնաք ձեր Google հաշվում, եթե մուտք եք գործել Chromium։ Որպեսզի թույլ տաք կայքերին հիշել ձեզ, <ph name="SETTINGS_LINK" />։</translation>
<translation id="3352986031709923790">որոնման տարածքի վերևի աջ անկյուն՝ <ph name="RIGHT" />% աջից, <ph name="TOP" />% վերևից</translation>
<translation id="3366305173356742781">Chromium-ի տվյալները ձեր հաշվում</translation>
<translation id="3375770072980084583">Օգտագործեք ձեր գաղտնաբառերը ձեր հեռախոսի Chromium դիտարկիչում</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3406848076815591792">Անցնե՞լ Chromium-ի ընթացիկ պրոֆիլ</translation>
<translation id="3412460710772753638">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="3438772217992559640">Որոնել այս ներդիրը պատկերով որոնման միջոցով</translation>
<translation id="3455907671758333080">Ընդլայնեք բարելավված Ապահով դիտարկման հնարավորությունները Chromium-ի հետ ձեր հեռախոսում</translation>
<translation id="3461644266919055473">Chromium-ի անհատականացում…</translation>
<translation id="3474745554856756813"><ph name="ITEMS_COUNT" /> տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="3497319089134299931">Chromium-ի այլ պրոֆիլի կարող եք անցնել <ph name="SHORTCUT" /> ստեղների համադրության միջոցով</translation>
<translation id="3509308970982693815">Փակեք Chromium-ի բոլոր պատուհանները և կրկին փորձեք:</translation>
<translation id="4449744684308538611">Ձեր պատուհանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Agent Chrome-ի համար</translation>
<translation id="3530103706039034513"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։  Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Chromium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։</translation>
<translation id="3531741627422851418">QR կոդ՝ Chromium դիտարկիչը շարժական սարքերում ներբեռնելու համար</translation>
<translation id="354621070532799440">Հիշեցում․ Google-ի անվտանգության լավագույն գործառույթները ձեր գրպանում</translation>
<translation id="4902762267468919597">Ձեր էկրանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Agent Chrome-ի համար։</translation>
<translation id="4199561934263811659">Բարելավված պաշտպանությունն անջատում է JavaScript-ի օպտիմալացումը այն կայքերի համար, որոնք Agent Chrome-ը չի ճանաչում</translation>
<translation id="3597003331831379823">Չհաջողվեց գործարկել ընդլայնված արտոնություններով կարգավորումը։ <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">Մուտք գործեք Chromium</translation>
<translation id="3639635944603682591">Այս օգտատիրոջ այցելությունների պատմությունը կհեռացվի այս սարքից։ Տվյալները վերականգնելու համար <ph name="USER_EMAIL" /> հաշվով մուտք գործեք Chromium-ում։</translation>
<translation id="7335807248512894660">{COUNT,plural, =0{Agent Chrome-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։}=1{Agent Chrome-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Agent Chrome-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Agent Chrome-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3667616615096815454">Չհաջողվեց տեղադրել․ հավելվածն անծանոթ է սերվերի համար։</translation>
<translation id="3675854891107786059">Օգտագործեք <ph name="BEGIN_LINK" />ձեր անցաբառը<ph name="END_LINK" />՝ Chromium-ի բոլոր տվյալները Google հաշվում գաղտնագրելու համար։ Վճարման եղանակները և Google Pay-ի հասցեները չեն գաղտնագրվի։ Chromium-ի այցելությունների պատմությունը չի համաժամացվի։</translation>
<translation id="3697825383460320042">{COUNT,plural, =0{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Agent Chrome-ը}=1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Agent Chrome-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Agent Chrome-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Agent Chrome-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="7584080815951640016">Բացել հղումը Agent Chrome-ի նոր &amp;ներդիրում</translation>
<translation id="3728124580182886854">Կապեք Chromium-ը Google-ի մյուս ծառայությունների հետ՝ անհատականացման և այլ գործընթացների համար</translation>
<translation id="3729187154190517324">Որոնումն ընդլայնելու համար ավելացրեք մի քանի ներդիր, ֆայլեր և գործիքներ՝ օգտագործելով «Ավելացնել ներդիր կամ մեկ այլ բան» կոճակը։</translation>
<translation id="3788675262216168505">Կառավարել Chromium-ի պրոֆիլները</translation>
<translation id="9153620230534680918">Իմացեք, թե ինչու է Agent Chrome-ն արգելափակում որոշ ներբեռնումներ</translation>
<translation id="379589255253486813">Chromium-ը ձեզ կտեղեկացնի, եթե որևէ բան փոխելու անհրաժեշտություն լինի</translation>
<translation id="4835254782629421085">Agent Chrome-ը նախապես բեռնում է էջերը, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="3810973564298564668">Կառավարել</translation>
<translation id="3823384748599722168">Պահված գաղտնաբառերն օգտագործելու համար սկանավորեք QR կոդը, ներբեռնեք iOS-ի համար նախատեսված Chromium դիտարկիչը և մուտք գործեք ձեր Google հաշիվ</translation>
<translation id="3846683726093018685">**Ամփոփում։** Մեկ նախադասությամբ մինչև 30 բառի սահմաններում սքրինշոթից նկարագրիր հիմնական թեման և բովանդակության նշանակությունը։

          **Առաջարկվող հարցեր։** Ստեղծիր մտածելու տեղիք տվող 3-5 հարցից բաղկացած կետանշված ցուցակ, որոնք օգտատերը կարող է տալ՝ սքրինշոթն ավելի լավ հասկանալու համար։ Դրանցից առնվազն մեկը պետք է կապված լինի վիզուալ օբյեկտի, դրա դիզայնի կամ տեղակայման հետ։</translation>
<translation id="5151092236561494204"><ph name="PAGE_TITLE" /> - Agent Chrome</translation>
<translation id="387514319934708384">Այս կայքի համար Chromium-ին անհրաժեշտ է լոկալ ցանցն օգտագործելու թույլտվություն</translation>
<translation id="3885770153807205175">Լեզվի ընտրիչ</translation>
<translation id="8310546736680726676">Agent Chrome-ի կարգավորման և կառավարման համար անհրաժեշտ է ձեր ուշադրությունը։ Սեղմեք՝ մանրամասներին ծանոթանալու համար։</translation>
<translation id="3889543394854987837">Սեղմեք ձեր անվան վրա՝ Chromium-ը բացելու համար:</translation>
<translation id="3892148308691398805">Պատճենել տեքստը</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" />-ն արդեն մուտք է գործել Chromium-ի այս պրոֆիլը։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք Chromium-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="334040592769172771">Այս ընդլայնումը խախտում է Chrome Web Store-ի քաղաքականությունը և կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Agent Chrome-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="3941890832296813527">Տեղադրման սխալ. տեղադրման ծրագրի ֆայլի անվանումն անվավեր է կամ չի աջակցվում։</translation>
<translation id="3945058413678539331">Chromium-ը փորձում է պատճենել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="3954172517175569325">Ձեր գաղտնաբառերը, վճարման եղանակները և հասցեները, որոնք պահել եք ձեր Google հաշվում, կհեռացվեն այս սարքից։ Chromium-ում դրանք նորից օգտագործելու համար պետք է նորից մուտք գործեք։</translation>
<translation id="395904275706073188">Պաշտպանված էջերը հնարավոր չէ ընթերցել։ Փորձեք այլ էջ։</translation>
<translation id="3962647064319009959">Ինչպես է Chromium-ն ապահով պահում ձեր տվյալները</translation>
<translation id="3967822245660637423">Ներբեռնումն ավարտվեց</translation>
<translation id="6274881217831291926">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Agent Chrome-ը ձեր հարցումն ուղարկում է ձեր կազմակերպության որոնողական համակարգին, ԱԲ-ին և ագենտային գործիքներին՝ առաջարկներ ստանալու համար։</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing-ի մասին</translation>
<translation id="3997429360543082038">ChromiumOS-ի մասին</translation>
<translation id="8089050973791989914">Երբ այցելում եք որևէ կայք, Agent Chrome-ն ուղարկում է URL-ի քողարկված մասը <ph name="BEGIN_LINK" />Google Ապահով դիտարկմանը<ph name="END_LINK" /> գաղտնիության պաշտպանության սերվերի միջոցով, որը թաքցնում է ձեր IP հասցեն։ Եթե կայքը կասկածելի է թվում, Chrome-ը նաև ուղարկում է էջի բովանդակության ամբողջական URL-ները և հատվածները։</translation>
<translation id="4016217212818346953">Եղեք պաշտպանված Գաղտնաբառերի կառավարչի օգնությամբ</translation>
<translation id="4019629340646866719">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա, ինչպիսին է <ph name="BEGIN_LINK_LINUX_OSS" />Լինուքսի մշակման միջավայրը<ph name="END_LINK_LINUX_OSS" />։</translation>
<translation id="4022972681110646219">Թարգմանել էկրանը</translation>
<translation id="4023601594785368013">Բնօրինակի լեզուն՝ <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Հղումները բացեք Chromium-ում ցանկացած հավելվածից։ Հեշտ մուտքի համար դիտարկիչն ամրացվում է խնդրագոտում։</translation>
<translation id="2466379549068383575">Օգնեք կատարելագործել Agent Chrome-ը՝ հաղորդելով <ph name="BEGIN_LINK" />ընթացիկ կարգավորումների<ph name="END_LINK" /> մասին</translation>
<translation id="4050175100176540509">Վերջին տարբերակում առկա են անվտանգության կարևոր բարելավումներ և նոր գործառույթներ:</translation>
<translation id="4055805654398742145">Գ&amp;աղտնաբառերի կառավարիչ</translation>
<translation id="409373329602981607">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է Agent Chrome-ը, երբ այն 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է Agent Chrome-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է Agent Chrome-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}}</translation>
<translation id="4118474109249235144">Chromium ինկոգնիտո</translation>
<translation id="4122186850977583290">Անցնել «Chromium-ի մասին» էջ</translation>
<translation id="4135244987012252068">Անհատականացրեք Chromium-ը՝ ձեր դիտարկիչին նոր տեսք հաղորդելու համար</translation>
<translation id="4147856324248078748">Անհատականացրեք ձեր Chromium-ը</translation>
<translation id="4148957013307229264">Տեղադրում…</translation>
<translation id="2058774528396152893"><ph name="PAGE_TITLE" /> – Ցանցի մուտքի էջ – Agent Chrome</translation>
<translation id="7685529984676330289">Հավելվածների, խաղերի, ընդլայնումների և թեմաների լայն ընտրանի Agent Chrome-ի համար:</translation>
<translation id="4217080900579554343">Ձեր բոլոր համակարգիչներում այս ընդլայնումը և ավելին ստանալու համար մուտք գործեք Chromium</translation>
<translation id="4217972271355023382">Ձեր ծնողների ընտրած ավելի անվտանգ կարգավորումներն օգտագործելու համար անցեք Chromium պրոֆիլ, որտեղ արդեն մուտք եք գործել որպես <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Չեղարկվում է…</translation>
<translation id="4224210481850767180">Տեղադրումը չեղարկվել է։</translation>
<translation id="4230135487732243613">Կապել Chromium-ի տվյալներն այս հաշվի հետ:</translation>
<translation id="274377438883177878">Զգուշացնում է ձեզ վտանգավոր, այդ թվում՝ Google-ին նախկինում անհայտ կայքերի մասին, քանի որ ավելի շատ տվյալներ է վերլուծում կայքերում՝ համեմատած ստանդարտ պաշտպանության հետ։ Դուք կարող եք բաց թողնել Agent Chrome-ի նախազգուշացումները։</translation>
<translation id="4269093074552541569">Դուրս գալ Chromium-ից</translation>
<translation id="8361584154950824008">Agent Chrome-ի օգնության էջ</translation>
<translation id="4281844954008187215">Օգտագործման պայմաններ</translation>
<translation id="4285930937574705105">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Եթե Chromium-ը բաց է, փակեք այն և կրկին փորձեք:</translation>
<translation id="4298125729853015961">Արտահանեք գաղտնաբառերը Chromium-ից</translation>
<translation id="4304713468139749426">Գաղտնաբառերի կառավարիչ</translation>
<translation id="4334241893986177674">Որոնում այս սքրինշոթում</translation>
<translation id="4368547723231502008">Որոնեք և հարցեր տվեք ցանկացած տեղից, նույնիսկ եթե Chromium-ը ծալված է</translation>
<translation id="1172096072757635810">Գործարկել Agent Chrome-ը, երբ Windows-ը միանա</translation>
<translation id="4400772909124543403">Հասանելի թարմացումներ չկան</translation>
<translation id="8069611125329654712">Փակե՞լ Agent Chrome-ը։</translation>
<translation id="4413205837991854510">Միշտ ցույց տալ պատկերով որոնման դյուրանցումը</translation>
<translation id="3727041326435831325">Թույլատրել Agent Chrome-ին աշխատել ֆոնային ռեժիմում</translation>
<translation id="1713490836766202786">{NUM_EXTENSIONS,plural, =1{Agent Chrome-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}one{Agent Chrome-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}other{Agent Chrome-ը խորհուրդ է տալիս հեռացնել դրանք։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}}</translation>
<translation id="7567010943765939594">Հարմարեցնել և վերահսկել Agent Chrome-ը</translation>
<translation id="4427306783828095590">Լրացուցիչ պաշտպանությունն օգնում է խուսափել ֆիշինգից և արգելափակել վնասաբեր ծրագրերը</translation>
<translation id="4434353761996769206">Տեղադրիչի սխալ՝ <ph name="INSTALLER_ERROR" /></translation>
<translation id="7498286168885369820">Agent Chrome-ը կառավարվում է <ph name="MANAGER" />-ի կողմից</translation>
<translation id="444069871276811466">Ավելացնել Chromium պրոֆիլ</translation>
<translation id="4447409407328223819">Chrome for Testing-ի մասին</translation>
<translation id="4470974262661801543">Chromium-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="4493028449971051158">Մեկնարկի սխալ․ գործարկեք տեղադրիչը որպես ադմինիստրատոր։</translation>
<translation id="4501471624619070934">Չհաջողվեց տեղադրել, քանի որ այս երկրում հասանելիության սահմանափակումներ կան։</translation>
<translation id="4615766574627629942">Այս ընդլայնումը չի հրապարակել գաղտնիության քաղաքականություն, օրինակ՝ թե ինչպես է այն հավաքում և օգտագործում տվյալները։ Agent Chrome-ը խորհուրդ է տալիս հեռացնել այն։</translation>
<translation id="452711251841752011">Բարի գալուստ Chromium․ բացված է դիտարկիչի նոր պատուհան</translation>
<translation id="4531137820806573936">Chromium-ին անհրաժեշտ է թույլտվություն՝ ձեր շրջակայքի քարտեզը ստեղծելու և ձեր ձեռքերի շարժումները հետագծելու համար</translation>
<translation id="4536805923587466102">Դուք արդեն մուտք եք գործել <ph name="USER_EMAIL_ADDRESS" /> հաշիվ մյուս Chromium պրոֆիլում</translation>
<translation id="5945053225725114995">Agent Chrome-ը նախապես բեռնում է էջերը՝ արագացնելով դիտարկումն ու որոնումը։ <ph name="BEGIN_LINK" />Իմանալ ավելին էջերի նախաբեռնման մասին<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Հաղորդեք կայքի մասին, որը ձեր կարծիքով վնասակար է, և օգնեք բարելավել համացանցի անվտանգությունը բոլորի համար։</translation>
<translation id="2899198307620821227">Agent Chrome-ն արգելափակել է այս ներբեռնումը, քանի որ դուք անջատել եք Անվտանգ դիտարկումը, և ֆայլը հնարավոր չէ ստուգել</translation>
<translation id="4583692638088316420">Փորձեք Google Տեսապակին Chromium-ի հետ ձեր հեռախոսում</translation>
<translation id="4594305310729380060">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="6944119370969619446">Agent Chrome հավելվածներ</translation>
<translation id="4598116752460667024">Ցանկում գտեք անհրաժեշտ գործընթացը։</translation>
<translation id="4613863813562375431">ChromiumOS-ի տարբերակը</translation>
<translation id="6401103202303237090">Գրեթե պատրաստ է: Վերագործարկեք Agent Chrome-ը՝ թարմացումն ավարտելու համար:</translation>
<translation id="4807663225386362301">Արագացնում է կայքերի աշխատանքը Agent Chrome-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Agent Chrome-ը հարձակումների նկատմամբ</translation>
<translation id="4626321472657185181">Բացել Որոնումը Chromium-ով</translation>
<translation id="521912697020157864">Ուշադրություն․ Agent Chrome-ը չի կարող արգելել ընդլայնումներին գրանցել ձեր այցելությունների պատմությունը։ Ընդլայնումն ինկոգնիտո ռեժիմում անջատելու համար ապանշեք այս պարամետրը։</translation>
<translation id="4673151026126227699">Եթե դուք նաև ուղարկում եք Chromium-ի օգտագործման մասին հաշվետվություններ, դրանցում կներառվեն ձեր այցելած URL-ները։</translation>
<translation id="4673710618874938871">Մուտք եք գործել որպես <ph name="USER_NAME" />, բաժանորդագրություն։ Բացել հաշվի ընտրացանկը</translation>
<translation id="5833534934470627293">Կարծես թե պրոֆիլն օգտագործվում է Agent Chrome-ի այլ գործընթացի կողմից (<ph name="PROCESS_ID" />) այլ համակարգչում (<ph name="HOST_NAME" />): Agent Chrome-ը կողպել է պրոֆիլը, որպեսզի այն չվնասվի: Եթե համոզված եք, որ պրոֆիլը չի օգտագործվում այլ գործընթացների կողմից, կարող եք ապակողպել պրոֆիլը և նորից գործարկել Agent Chrome-ը:</translation>
<translation id="4680828127924988555">Չեղարկել տեղադրումը</translation>
<translation id="469259825538636168">Chromium-ի որոշ տվյալներ դեռ չեն պահվել ձեր Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="4708193446201257833">Հաշիվ մուտք գործած ժամանակ Chromium-ում դուք կարող եք օգտագործել ձեր գաղտնաբառերն ու մյուս կարգավորումները ձեր Google հաշվից։ <ph name="SHORTCUT" /> դյուրանցումով կարող եք փոխել Google-ի ձեր ծառայությունների կարգավորումները։</translation>
<translation id="4708774505295300557">Ինչ-որ մեկն այս համակարգչում <ph name="ACCOUNT_EMAIL_LAST" /> հասցեով մուտք է գործել Chromium: Ստեղծեք Chromium-ի նոր պրոֆիլ` ձեր տվյալներն առանձին պահելու համար:</translation>
<translation id="4724676981607797757">Չհաջողվեց տեղադրել հավելվածը, քանի որ չաջակցվող հաղորդակարգի կիրառման արդյունքում սխալ է առաջացել։</translation>
<translation id="2783410850122241193">Փակե՞լ Agent Chrome-ը։</translation>
<translation id="4748217263233248895">Chromium-ի անվտանգության կարգավորումները հենց նոր թարմացվել են: Վերագործարկեք Chrome-ը, և ձեր ներդիրները կվերականգնվեն:</translation>
<translation id="4771701986670315895">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />», «<ph name="PERMISSION_2" />» ու ևս <ph name="COUNT" /> թույլտվություն։</translation>
<translation id="4786083865378785874">Եթե «Gemini-ը Chromium-ում» հավելվածը բացված է, նոր ներդիրներ ստեղծելիս կողային վահանակը բացված կմնա</translation>
<translation id="479167709087336770">Օգտագործվում է միևնույն ուղղագրիչը, ինչ Google Որոնման մեջ: Դիտարկիչում մուտքագրված տեքստերն ուղարկվում են Google-ին: Սա կարող եք փոխել կարգավորումներում։</translation>
<translation id="4814736265800133385">Օգտագործել Chromium-ն առանց հաշվի</translation>
<translation id="4888717733111232871">Թույլատրել Chromium-ում տվյալների մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="5600814355607573136">Վերագործարկել՝ &amp;Agent Chrome-ը թարմացնելու համար</translation>
<translation id="4918086044614829423">Ընդունել</translation>
<translation id="4918844574251943176">Պատկերը պատճենվեց</translation>
<translation id="4943838377383847465">Chromium-ն աշխատում է ֆոնային ռեժիմում:</translation>
<translation id="494490797786467921">Սեղմեք՝ Chromium մտնելու երկխոսության պատուհանը փակելու համար</translation>
<translation id="4950660488495335294">Chromium պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օգտատերերից։ Ստեղծեք պրոֆիլներ ձեր ընկերների և ընտանիքի անդամների կամ գործնական և անձնական նպատակների համար։</translation>
<translation id="4987820182225656817">Օգտագործելով Chromium-ը հյուրի ռեժիմում՝ դուք ոչ մի հետք չեք թողնում:</translation>
<translation id="4992938037305302429">Ձեր հաշիվը Chromium-ում</translation>
<translation id="4994636714258228724">Ավելացրեք ձեր հաշիվը Chromium-ին</translation>
<translation id="504699503110800016">Բացեք լրացուցիչ ընտրացանկը</translation>
<translation id="5074496654342756568">Օգտագործեք Google-ի ձեր սիրելի ծառայությունները Chromium-ի միջոցով ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="5123973130450702873">Chromium-ին անհրաժեշտ է թույլտվություն՝ ձեր ձեռքերի շարժումները հետագծելու համար</translation>
<translation id="5141988424377517949">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />», «<ph name="PERMISSION_2" />» և «<ph name="PERMISSION_3" />» թույլտվությունները։</translation>
<translation id="5174969993834422967">Դուք սովորաբար արգելափակում եք ծանուցումները։ Հասցեագոտու աջ անկյունում սեղմեք ծանուցման պատկերակը, որպեսզի թույլ տաք կայքին ծանուցել ձեզ։</translation>
<translation id="5174983315706567306">Սկավառակում բավարար տարածք չկա։</translation>
<translation id="5187123684706427865">Chromium հաշիվը պահանջում է վերաիսկորոշում</translation>
<translation id="5223510345050543907">Շարունակեք այնտեղից, որտեղ կանգ էիք առել iOS-ի համար Chromium-ում։</translation>
<translation id="5231355151045086930">Դուրս գալ Chromium-ից</translation>
<translation id="5234764350956374838">Փակել</translation>
<translation id="5249261924633168472">Բացել հղումը Chromium-ի ինկո&amp;գնիտո պատուհանում</translation>
<translation id="5276305953263010518">Ներբեռնեք Chromium հավելվածը՝ գաղտնաբառերը ցանկացած պահի պահելու համար</translation>
<translation id="1601187459465935178">Փոփոխությունները կիրառելու համար վերագործարկեք Agent Chrome-ը</translation>
<translation id="5286907366254680517">Ճանաչվել է</translation>
<translation id="5289287148052354622">Ներբեռնել Chromium հավելվածը</translation>
<translation id="5294316920224716406">Երբ ինկոգնիտո ռեժիմում դիտարկելիս լինեք, նախքան ոչ ապահով միացման միջոցով կայք բեռնելը Chromium-ը ձեզ կնախազգուշացնի</translation>
<translation id="5296581118566748922">Որոնում Chromium-ով</translation>
<translation id="5313228254328109263">Chromium Updater ներքին ծառայություն</translation>
<translation id="5324450571874973775">Օգտագործեք դրանք Chromium-ում Gemini-ի այլ գործառույթների հետ միասին</translation>
<translation id="5346389065299425353">Որոնումն ընդլայնելու համար ավելացրեք մի քանի ներդիր, ֆայլեր և գործիքներ</translation>
<translation id="5348677704241861105">Ստացեք այս փաստաթղթի համառոտ նկարագրությունը և հարցեր տվեք Gemini-ին Chromium-ում</translation>
<translation id="5352264705793813212">Chromium-ը անվտանգության հետ կապված որոշ առաջարկներ է գտել ձեզ համար</translation>
<translation id="5352361688875342522">Chromium-ի այլ պրոֆիլներ</translation>
<translation id="535243042947607642">ChromiumOS-ին չհաջողվեց պահել Chromium-ի տվյալները ձեր Google հաշվում, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են</translation>
<translation id="5358375970380395591">Դուք մուտք եք գործում վերահսկվող հաշիվ՝ թույլ տալով ադմինիստրատորին կառավարել ձեր Chromium պրոֆիլը: Ձեր Chromium-ի տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները, մշտապես կկապվեն <ph name="USER_NAME" />-ի հետ: Դուք կկարողանաք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարողանա համակցել դրանք այլ հաշվի հետ: <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Լրացուցիչ կոդ՝ <ph name="EXTRA_CODE" />։</translation>
<translation id="5377622451696208284">Անհատականացումը կարգավորելու համար ավելացրեք Chromium-ը Վեբ որոնման և հավելվածների պատմության մեջ</translation>
<translation id="5382964351116519680">Բացել որոնումը Chromium-ով</translation>
<translation id="2524054769026663683">Իմացեք, թե ինչու է Agent Chrome-ն արգելափակում որոշ ֆայլեր</translation>
<translation id="8615009965479156445">Agent Chrome-ի թարմացում (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Թույլատրել մուտքը Chromium-ում</translation>
<translation id="6256236118124872626">Հեռացնել Agent Chrome-ից</translation>
<translation id="5774731921051444461">Արդյունավետությունը կնվազի, սակայն Agent Chrome-ն ավելի դիմակայուն կդառնա հարձակումների նկատմամբ</translation>
<translation id="5427571867875391349">Դարձնել Chromium-ը կանխադրված դիտարկիչը</translation>
<translation id="8709870882148322247"><ph name="PAGE_TITLE" /> – Agent Chrome բետա</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Chromium-ը խորհուրդ է տալիս դադարեցնել ներդիրը, որը դադաղեցնում է ձեր դիտարկիչը}one{Chromium-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}other{Chromium-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}}</translation>
<translation id="3217425685577630218">Agent Chrome-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Լինուքսի այս բաշխման մեջ։</translation>
<translation id="1045655099853558439">Agent Chrome-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կարող է վնասել ձեր անձնական և սոցիալական ցանցերի հաշիվները</translation>
<translation id="549669000822060376">Սպասեք` մինչ Chromium-ը տեղադրում է համակարգի նորագույն թարմացումները:</translation>
<translation id="5496810170689441661">Chromium-ը փորձում է փոխել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="549975168243349205">Սահուն աշխատեք ձեր սիրած հավելվածների հետ, ինչպիսիք են Google Drive-ը և YouTube-ը, Chromium-ի միջոցով։</translation>
<translation id="5524890928877629608">որոնման տարածքի վերևի ձախ անկյուն՝ <ph name="LEFT" />% ձախից, <ph name="TOP" />% վերևից</translation>
<translation id="565863787292824328">Բացել PDF ֆայլեր Agent Chrome-ում</translation>
<translation id="5536164441519929134">Հարցրեք<ph name="LINE_BREAK" />այս ներդիրի մասին</translation>
<translation id="8869089999448782168">Անվտանգության նկատառումներից ելնելով՝ Agent Chrome-ն անջատում է JavaScript-ի օպտիմալացումը, երբ առաջին անգամ եք այցելում կայք։

Եթե այս էջը չի աշխատում սպասվածի պես, փորձեք թույլատրել օպտիմալացումը։</translation>
<translation id="5575874067957905201">Ցույց տալ «Gemini-ը Chromium-ում» հավելվածը Mac-ի ընտրացանկի գոտում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="5576587363991567745"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Chromium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն պահված տեղեկությունները և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="5579324208890605088">Մեկնարկի սխալ․ գործարկեք տեղադրիչը որպես սովորական օգտատեր, այլ ոչ որպես ադմինիստրատոր։</translation>
<translation id="5580770360767802657">Դարձրեք Chromium-ը ձեր կանխադրված դիտարկիչը և ամրացրեք այն</translation>
<translation id="5596627076506792578">Լրացուցիչ ընտրանքներ</translation>
<translation id="5605834417512968703">Ընտրեք որևէ բան՝ «Որոնում պատկերով» գործառույթի միջոցով որոնելու համար, կամ սեղմեք Escape՝ այդ գործառույթից դուրս գալու համար</translation>
<translation id="5618818588972826921">Ընտրեք ցանկացած տեքստ կամ պատկեր պատկերների որոնման միջոցով որոնելու համար կամ սեղմեք Escape՝ պատկերների միջոցով որոնումից դուրս գալու համար</translation>
<translation id="4814380868372526025">{0,plural, =0{Հասանելի է Agent Chrome-ի նոր տարբերակը}=1{Հասանելի է Agent Chrome-ի նոր տարբերակը}one{Agent Chrome-ի նոր տարբերակը # օր է հասանելի է}other{Agent Chrome-ի նոր տարբերակը # օր է հասանելի է}}</translation>
<translation id="188722644954983559">Միշտ ջնջել կայքերի տվյալները սարքից՝ Agent Chrome-ը փակելու դեպքում</translation>
<translation id="5653831366781983928">Վերագործարկեք Chromium-ը</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="1525044488102751845">Agent Chrome-ը ցուցադրել այս լեզվով</translation>
<translation id="569897634095159764">Հնարավոր չէ միանալ ինտերնետին։ Պրոքսի սերվերն իսկորոշում է պահանջում։</translation>
<translation id="7750959567789509941">Agent Chrome-ը ազատում է ոչ ակտիվ ներդիրներին հատկացված հիշողությունը։ Դրա շնորհիվ ակտիվ ներդիրներն ու մյուս հավելվածները համակարգչի ավելի շատ ռեսուրսներից են կարողանում օգտվել, իսկ Agent Chrome-ը կարողանում է արագ աշխատել։ Ոչ ակտիվ ներդիրներն ավտոմատ կակտիվանան, երբ նորից սկսեք օգտագործել դրանք։ <ph name="BEGIN_LINK" />Իմանալ ավելին Հիշողության տնտեսման մասին<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, խորհուրդ ենք տալիս <ph name="SETTINGS_LINK" /> Chromium-ի տվյալները ձեր հաշվից</translation>
<translation id="5800158606660203929">Անհատականացրեք և վերահսկեք Chromium-ը։ Դարձրեք Chromium-ը ձեր կանխադրված դիտարկիչը։</translation>
<translation id="5802618941556161431">Դարձրեք Chromium-ը ձեր կանխադրված դիտարկիչը, որպեսզի ձեր գաղտնաբառերը, էջանիշները և պատմությունը համաժամացվեն ձեր բոլոր սարքերում։</translation>
<translation id="5809516625706423866">Հնարավոր չէ միանալ ինտերնետին։ HTTP 401 Unauthorized։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="2755468387099310604">Արագացնում է կայքերի աշխատանքը Agent Chrome-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Agent Chrome-ը հարձակումների նկատմամբ։ Այս կարգավորումն անջատված է։</translation>
<translation id="5821520528363214608">Chromium-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար թարմացրեք Chromium-ը</translation>
<translation id="5824893331272123205">Չհաջողվեց բեռնել այս վահանակը։ Նորից փորձեք։</translation>
<translation id="8972968824660717915">Բարի գալուստ Agent Chrome</translation>
<translation id="8898055105597601099">Միացնում է լրացուցիչ գործառույթներ՝ Agent Chrome-ի ամենաուժեղ պաշտպանությունն ապահովելու համար</translation>
<translation id="5871205389137001634">Սեղմեք՝ «Որոնում պատկերով» գործառույթից դուրս գալու համար</translation>
<translation id="9158119422063615519">Agent Chrome-ը այս տարրերում վնասագիր է հայտնաբերել՝</translation>
<translation id="5889361821821684993">Chromium-ը պարբերաբար ստուգում է իրականացնում՝ համոզվելու, որ ձեր դիտարկիչն ամենաանվտանգ կարգավորումներն ունի։ Մենք ձեզ կտեղեկացնենք, եթե որևէ բան փոխելու անհրաժեշտություն լինի։</translation>
<translation id="5895138241574237353">Վերագործարկել</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Ցանցի մուտք</translation>
<translation id="5924017743176219022">Միացում համացանցին…</translation>
<translation id="5939553720811388432">Եկեք կարգավորենք ձեր Chromium-ը</translation>
<translation id="5941711191222866238">Նվազեցնել</translation>
<translation id="5949225980829865667">Որպեսզի այս էջանիշը և այլ տվյալներ հասանելի լինեն ձեր բոլոր սարքերում, մուտք գործեք Chromium</translation>
<translation id="5953657885167112863">Հարմարեցրեք Chromium-ը</translation>
<translation id="5960071705175224773">Կարգավորումները փոխվել են անհայտ հավելվածի կողմից</translation>
<translation id="5977420883993828287">Ամրացված է։ Համատեքստային առաջադրանքների վահանակն այժմ հասանելի է գործիքագոտում</translation>
<translation id="1956376169666014494">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է Agent Chrome-ը, երբ այն 1 րոպե չի օգտագործվում։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է Agent Chrome-ը, երբ այն # րոպե չի օգտագործվում։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է Agent Chrome-ը, երբ այն # րոպե չի օգտագործվում։}}</translation>
<translation id="5987687638152509985">Թարմացրեք Chromium-ը՝ համաժամացումը սկսելու համար</translation>
<translation id="5990360079535151574">Գործիքագոտում սեղմելով «Համատեքստային առաջադրանքներ» կոճակը՝ կարող եք նորից բացել համատեքստային առաջադրանքները և հարցեր տալ դիտարկման ընթացքում։</translation>
<translation id="6003112304606738118">Ներբեռնում… Մնաց <ph name="HOURS" /> ժամ</translation>
<translation id="6009821354356307391">Լրացուցիչ հարցեր տվեք</translation>
<translation id="6040143037577758943">Փակել</translation>
<translation id="6044357424127037044">Օգտվեք առցանց գնումների բոլոր առավելություններից՝ ձեր <ph name="DEVICE_TYPE" />-ում օգտագործելով Chromium հավելվածը</translation>
<translation id="6058380562449900225">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Chromium-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։ Ընդ որում՝ ծանուցումները չեն անջատվի։</translation>
<translation id="6063093106622310249">&amp;Բացել Chromium-ում</translation>
<translation id="6069027071882229820">Պատճենել որպես պատկեր</translation>
<translation id="8654038583091834120">«<ph name="EXTENSION_NAME" />» ընդլայնումն ավելացվել է Agent Chrome-ին</translation>
<translation id="8940723094351907049">Հասանելի է Agent Chrome-ի նոր տարբերակը։</translation>
<translation id="334648248941185659">Միացված է • Agent Chrome-ը չի կարող հաստատել այս ընդլայնման ծագումը</translation>
<translation id="611228897408671387">Ձեր հաշիվը Chromium-ում</translation>
<translation id="1961808482688487456">Թույլատրել ընդլայնմանը մուտքի հարցումներ ցուցադրել Agent Chrome-ի գործիքագոտում</translation>
<translation id="6880945371922378763"><ph name="FILE_NAME" /> ֆայլը վտանգավոր է, և Agent Chrome-ն արգելափակել է այն։</translation>
<translation id="829957199361894387">Agent Chrome-ը շուտով կփակվի և կջնջի տվյալները</translation>
<translation id="6145820983052037069">Այստեղ կարող եք անցնել Chromium-ի այլ պրոֆիլի</translation>
<translation id="8333733115616087710">Եթե դուք թույլատրում եք քուքիների օգտագործումը, Agent Chrome-ը կարող է դրանք օգտագործել նախաբեռնման ժամանակ</translation>
<translation id="6165508094623778733">Իմանալ ավելին</translation>
<translation id="6173308241973263798">Մաքրել Chromium-ի տվյալները ձեր հաշվից</translation>
<translation id="8439223334931595792">Այս ֆայլը կարող է վտանգավոր լինել<ph name="LINE_BREAK" />Agent Chrome-ը կարող է ստուգել այն, եթե մուտքագրեք ձեր գաղտնաբառը։ Ֆայլի մասին տեղեկությունները կուղարկվեն «Google Ապահով դիտարկում» ծառայությանը, սակայն ֆայլի բովանդակությունը և գաղտնաբառը կմնան ձեր սարքում։</translation>
<translation id="6182736845697986886">Չհաջողվեց տեղադրել հավելվածը թարմացումն իրականացնող սերվերի ներքին սխալի պատճառով։</translation>
<translation id="6183079672144801177">Համոզվեք, որ մուտք եք գործել հաշիվ <ph name="TARGET_DEVICE_NAME" /> սարքի Chromium դիտարկիչում և փորձեք նորից ուղարկել։</translation>
<translation id="6212496753309875659">Այս համակարգչում արդեն տեղադրված է Chromium-ի ավելի նոր տարբերակը: Եթե ծրագրակազմը չի աշխատում, ապատեղադրեք Chromium-ը և նորից փորձեք:</translation>
<translation id="6375381612105819561">{0,plural, =0{Agent Chrome-ը հիմա կվերագործարկվի}=1{Agent Chrome-ը կվերագործարկվի 1 վայրկյանից}one{Agent Chrome-ը կվերագործարկվի # վայրկյանից}other{Agent Chrome-ը կվերագործարկվի # վայրկյանից}}</translation>
<translation id="6241367896540709610">Ֆայլեր ներբեռնելու համար Chromium-ին անհրաժեշտ է հիշողությունն օգտագործելու թույլտվություն</translation>
<translation id="6245734527075554892">Ստուգում է URL-ները Chromium-ում պահված վտանգավոր կայքերի ցանկի միջոցով։</translation>
<translation id="5070229316792137581">Դարձնել Agent Chrome-ը կանխադրված դիտարկիչ</translation>
<translation id="6248988683584659830">Որոնման կարգավորումներ</translation>
<translation id="6261803579884938625">Օգտվեք Google-ի անվտանգության լավագույն գործառույթներից ցանկացած պահի ձեր հեռախոսի Chromium հավելվածի օգնությամբ</translation>
<translation id="6268381023930128611">Դուրս գա՞լ Chromium-ից:</translation>
<translation id="6270547683008298381">Այս ներդիրները լրացուցիչ ռեսուրսներ են օգտագործում։ Թույլատրեք Chromium-ին ապակտիվացնել դրանք, և աշխատանքի արդյունավետությունը կբարձրանա։</translation>
<translation id="6281746429495226318">Անհատականացնել Chromium-ի պրոֆիլը</translation>
<translation id="6290827346642914212">Անվանեք ձեր Chromium պրոֆիլը</translation>
<translation id="6294831894865512704">Ընդլայնումն ուզում է, որ դուք մուտք գործեք Chromium</translation>
<translation id="1356965940380155951"><ph name="FILE_NAME" /> ֆայլը կարող է վտանգավոր լինել, և Agent Chrome-ն արգելափակել է այն։</translation>
<translation id="7321042153033393145">Agent Chrome-ն օգտագործում է ձեր տեսախցիկը:</translation>
<translation id="6333502561965082103">Chromium-ում տեղադրման մեկ այլ գործողություն ընթացքի մեջ է: Փորձեք ավելի ուշ:</translation>
<translation id="6334986366598267305">Այժմ ավելի հեշտ է օգտագործել Chromium-ը ձեր Google հաշվի հետ, այդ թվում նաև համօգտագործվող համակարգիչներով:</translation>
<translation id="6347002662287820329">Դարձրեք Chromium-ը ձեր կանխադրված դիտարկիչը՝ հեշտությամբ օգտվելու ձեզ ծանոթ, սիրելի և վստահելի գործառույթներից։</translation>
<translation id="6663103136563143835">Agent Chrome-ի դյուրանցում</translation>
<translation id="8324836837188781073">Agent Chrome-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="6373523479360886564">Հեռացնե՞լ Chromium-ը:</translation>
<translation id="6375219077595103062">Ավելացրեք Գաղտնաբառերի կառավարչի դյուրանցումը</translation>
<translation id="6388799252195623474">ինձ օգնություն է անհրաժեշտ</translation>
<translation id="6390800440335263989">Շարունակելու համար մուտք գործեք Chromium <ph name="EMAIL" /> էլփոստով։ Սա ապահովում է, որ դուք ունեք ձեր կազմակերպության կանոնները։</translation>
<translation id="6400112897226594999">Chromium-ի լոգոն՝ համակարգչի էկրանին։</translation>
<translation id="6403826409255603130">Chromium-ը վեբ դիտարկիչ է, որը կայծակի արագությամբ է բացում վեբէջերն ու հավելվածները: Այն արագ է, կայուն և պարզ՝ օգտագործման մեջ: Ավելի ապահով աշխատեք համացանցում՝ վնասագրերի և խաբկայքերի դեմ ներկառուցված պաշտպանության շնորհիվ:</translation>
<translation id="6414624068245092115">Հաստատեք ձեր ինքնությունը, որպեսզի միշտ կարողանաք օգտագործել և պահել Chromium-ի տվյալները ձեր Google հաշվում</translation>
<translation id="5698692159722140301">Agent Chrome-ն ավելի արագ է աշխատում, իսկ JavaScript օգտագործող գործառույթները պետք է աշխատեն նախատեսվածի պես</translation>
<translation id="6436260184216827876">«Որոնում պատկերով» գործառույթը հասանելի չէ։ Փորձեք ավելի ուշ։</translation>
<translation id="6442900851116057561">Վերագործարկեք ChromiumOS-ը</translation>
<translation id="1150325299163558144">Agent Chrome-ը նախապես բեռնում է էլ ավելի շատ էջեր, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="6450948450282634257">Ներբեռնեք Chromium-ը հեռախոսում՝ գներին հետևելու և ծանուցումներ ստանալու համար, երբ որևէ կայքում գնիջեցում լինի</translation>
<translation id="2302438614865168038">Անջատված է • Agent Chrome-ը չի կարող հաստատել այս ընդլայնման ծագումը</translation>
<translation id="6455857529632101747">Բարի գալուստ Chromium պրոֆիլներ</translation>
<translation id="6460614424172581323">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք Chromium-ը, կտեսնեք ներդիրների խմբերն օգտագործելու հրավեր։</translation>
<translation id="6466344609055215035">Հեռացնել հաշիվը Chromium-ից</translation>
<translation id="5526497172610025231">Այն նաև վերահսկում է, թե որ էջը ցուցադրվի Agent Chrome-ը մեկնարկելիս:</translation>
<translation id="648319183876919572">Բարելավված Ապահով դիտարկումն օգնում է պաշտպանվել վտանգավոր կայքերից և ներբեռնումներից</translation>
<translation id="6510925080656968729">Ապատեղադրել Chromium-ը</translation>
<translation id="124295298108005714">Դյուրանցումները բացվում են Agent Chrome-ում</translation>
<translation id="9177671044583442813">Ձեր կազմակերպությունը փակում է Agent Chrome-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այցելությունների պատմությունը ջնջվել է։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="6542839706527980775">Յուրաքանչյուր պրոֆիլում առանձին պահվում են Chromium-ի օգտատերերի տվյալները, օրինակ՝ էջանիշները, պատմությունը, գաղտնաբառերը և այլն</translation>
<translation id="6556755379298048869">Որոնեք ստեղնային դյուրանցման միջոցով։</translation>
<translation id="5677032436425073715">Իմացեք ավելին, թե <ph name="BEGIN_LINK" />ինչպես է Agent Chrome-ը պահպանում ձեր տվյալների գաղտնիությունը<ph name="END_LINK" /></translation>
<translation id="5967753610833950399">Այս կարգավորումների փոփոխությունները կկիրառվեն Agent Chrome-ի վերագործարկումից հետո։</translation>
<translation id="4790842900919490952">Կառավարեք ընդլայնումները՝ Agent Chrome-ի հիմնական ընտրացանկում սեղմելով Ընդլայնումներ։</translation>
<translation id="656935081669708576">Դուք կարող եք դիտել գաղտնաբառերը՝ անցնելով մյուս Chromium պրոֆիլ</translation>
<translation id="6569556444379005948">Օգտագործեք Chromium հավելվածը՝ ԱԲ լավագույն գործիքները շարժման մեջ օգտագործելու համար</translation>
<translation id="8124768693572849485">Ուղղագրական սխալները շտկելու համար Agent Chrome-ը Google-ին է ուղարկում տեքստային դաշտերում ձեր մուտքագրած տեքստը</translation>
<translation id="6598877126913850652">Անցնել Chromium-ի ծանուցումների կարգավորումներ</translation>
<translation id="6600016381025017075">Որոնեք ցանկացած բան այս էջում</translation>
<translation id="1736130262142947818">Փոփոխություններն ուժի մեջ կմտնեն Agent Chrome-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="6637908313088374648">Chromium-ն այժմ գործարկվում է Windows-ի միանալուն պես, այնպես որ կարող եք ակնթարթորեն սկսել դիտարկումը։ Դուք կարող եք անջատել այս գործառույթը կարգավորումներում։</translation>
<translation id="6648212540664651655">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ Chromium-ը վերականգնել է ձեր նախորդ աշխատաշրջանի ներդիրները։ Այս գործառույթն անջատելու համար անցեք</translation>
<translation id="665732753414869868">Ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար Chromium-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="6669284030132180248">Պահելով էջանիշները Google հաշվում՝ դուք կարող եք հետագծել ապրանքների գները Chromium-ում և ստանալ զեղչերի մասին ծանուցումներ</translation>
<translation id="6676384891291319759">Մտնել համացանց</translation>
<translation id="668175097507315160">Մուտքի սխալի պատճառով ChromiumOS-ը չկարողացավ համաժամացնել ձեր տվյալները։</translation>
<translation id="6691132793308828750">Հեռացնել այս հավելվածի տվյալները Chromium-ից</translation>
<translation id="6709350901466051922">Այս կայքի համար Chromium-ին անհրաժեշտ է խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="6712881677154121168">Ներբեռնման սխալ՝ <ph name="DOWNLOAD_ERROR" />։</translation>
<translation id="7755971898820142787">Դուք չեք կարող օգտագործել ձեր պրոֆիլը, քանի որ այն Agent Chrome-ի նոր տարբերակից է:

Որոշ գործառույթներ մատչելի չեն լինի: Հատկորոշեք այլ պրոֆիլի գրացուցակ կամ օգտվեք Agent Chrome-ի ավելի նոր տարբերակից:</translation>
<translation id="6729124504294600478">Անհատականացումը և այլ գործառույթներ կարգավորելու համար ավելացրեք Chromium-ը Վեբ որոնման և հավելվածների պատմության մեջ և Google-ի կապված ծառայություններում</translation>
<translation id="6734291798041940871">Chromium-ն արդեն տեղադրված է ձեր համակարգչում բոլոր օգտատերերի համար:</translation>
<translation id="6742093177587589736">Էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Chromium։ Այս էջանիշը կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="7821834337023193240">Արագացնում է կայքերի աշխատանքը Agent Chrome-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Agent Chrome-ը հարձակումների նկատմամբ։ Այս կարգավորումը միացված է։</translation>
<translation id="6754665438209053659">{count,plural, =1{Chromium-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները (1 տարր) կջնջվեն։}one{Chromium-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}other{Chromium-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}}</translation>
<translation id="67706546131546258">Chromium-ը խորհուրդ է տալիս ստուգել այս ֆայլը, քանի որ այն կարող է վտանգավոր լինել։</translation>
<translation id="6779406956731413166">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա։</translation>
<translation id="6831043979455480757">Թարգմանել</translation>
<translation id="6847869444787758381">Chromium-ը ձեզ տեղյակ կպահի, եթե ձեր գաղտնաբառերի անվտագությանը սպառնալիք լինի</translation>
<translation id="684888714667046800">Հնարավոր չէ միանալ ինտերնետին։ Հրապատ օգտագործելու դեպքում համոզվեք, որ <ph name="PRODUCT_EXE_NAME" /> ֆայլը թույլատրվածների ցուցակում է։</translation>
<translation id="6219638737609534419">Agent Chrome – <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Շարունակելու համար սեղմեք Tab</translation>
<translation id="6862030660799253820">Որոնել այս պատկերը պատկերով որոնման միջոցով</translation>
<translation id="6869568587896659271">Հասցեագոտու տակ գտնվող կայքերի հեշտ հասանելիություն</translation>
<translation id="7421523967177993052">Agent Chrome-ը «<ph name="EXTENSION_NAME" />» ընդլայնման մեջ վնասագիր է հայտնաբերել</translation>
<translation id="6877155553248388166">որոնման տարածքի ներքևի աջ անկյուն՝ <ph name="RIGHT" />% աջից, <ph name="BOTTOM" />% վերևից</translation>
<translation id="6896758677409633944">Պատճենել</translation>
<translation id="6898028264630240901">Դուք կարող եք ամրացնել համատեքստային առաջադրանքները, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="6901631050894301805">Նշեք Chromium-ը որպես կանխադրված դիտարկիչ և այն ամրացրեք ձեր հավելվածների վահանակում</translation>
<translation id="6909503629704372277">&amp;Կառավարել Chromium-ի պրոֆիլները</translation>
<translation id="9199111398679939226">Այս գործողության արդյունքում տեղի կունենա հետևյալը․
          <ph name="LINE_BREAKS" />
            • Մեկնարկային էջի, նոր ներդիրի էջի, որոնողական համակարգի և ամրացված ներդիրների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAK" />
            • Ընդլայնումները կանջատվեն
            <ph name="LINE_BREAK" />
            • Քուքիները և կայքերի մյուս ժամանակավոր տվյալները կջնջվեն
            <ph name="LINE_BREAK" />
            • Agent Chrome-ի դյուրանցումների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAKS" />
            Էջանիշները, պատմությունը և պահված գաղտնաբառերը կպահպանվեն։</translation>
<translation id="6948031725951063910">Դուք Chromium-ում արդեն առավելագույն թույլատրելի թվով (<ph name="BOOKMARK_LIMIT" />) էջանիշներ եք պահել, ուստի ձեր էջանիշներից մի քանիսը դեռ չեն պահվել ձեր Google հաշվում։

Դուք չեք կարող նոր էջանիշներ պահել ձեր հաշվում, մինչև չջնջեք մի քանիսը։ Եթե դուրս գաք հիմա, չպահված էջանիշները կջնջվեն։</translation>
<translation id="6964305034639999644">Բացել հղումը Chromium-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="6965382102122355670">Եղավ</translation>
<translation id="6985329841647292029">ChromiumOS-ի պայմաններ</translation>
<translation id="7003299027384820442">Chromium-ի տվյալները <ph name="ACCOUNT_EMAIL" /> հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="7011190694940573312">Տեղադրումը ձախողվեց, քանի որ օպերացիոն համակարգի այս տարբերակը չի աջակցվում։</translation>
<translation id="7024536598735240744">Ապափաթեթավորման սխալ՝ <ph name="UNPACK_ERROR" />։</translation>
<translation id="7045244423563602563">Անհատականացրեք Chromium դիտարկիչը</translation>
<translation id="7047386856539490735">Այս արդյունքներն օգտակա՞ր են։</translation>
<translation id="705851970750939768">Թարմացնել Chromium-ը</translation>
<translation id="1222890016986172619">Եթե պատկերն օգտակար նկարագրություն չունի, Agent Chrome-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։</translation>
<translation id="7074836723476134809">Օգտվեք ԱԲ-ի հնարավորություններից, երբ օգտագործում եք Chromium հավելվածը ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="7134687062119989071">Ձեր գաղտնաբառերը, ներդիրները և այլ տվյալներ միշտ հասանելի կլինեն ձեր հեռախոսի Chromium հավելվածի շնորհիվ</translation>
<translation id="7141270731789036260">Անհատականացրեք Chrome for Testing-ը</translation>
<translation id="5669948510815930830">Օգտագործեք Agent Chrome-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա</translation>
<translation id="5576210706466474421">Հեռացնել <ph name="EXTENSION_NAME" /> ընդլայնումը Agent Chrome-ից</translation>
<translation id="4588941330171478873">Ձեր կազմակերպությունը ջնջում է Agent Chrome-ի տվյալները, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="718435575166326686">Այս կայքի համար Chromium-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2916059341902838041">Չհաջողվեց գործարկել Agent Chrome-ը։ Նորից փորձեք։</translation>
<translation id="7204669035546236137">Հարցրեք ցանկացած բան ցանկացած տեղում «Gemini-ը Chromium-ում» մոդելի միջոցով</translation>
<translation id="1716746018761150810">Ամրացրեք Agent Chrome-ը Dock վահանակի վրա՝ այն ցանկացած պահի արագ բացելու համար</translation>
<translation id="7213407614656404070">Օգտագործեք Chromium-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա</translation>
<translation id="7216228761061470870">Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ուղարկվում են սերվերին</translation>
<translation id="4816956813330284757">Խնդիրների կառավարիչ - Agent Chrome</translation>
<translation id="7227958669698166857"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Chromium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Պահպանված տեղեկությունները և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="7252276985725323153">Ակնթարթորեն սկսեք դիտարկումը․ Chromium-ն այժմ կարող է գործարկվել Windows-ի միանալուն պես։</translation>
<translation id="7274695763216404502">«Որոնում պատկերով» գործառույթն ամրացված է․ այն այժմ հասանելի է գործիքագոտում</translation>
<translation id="7288567540154601580">Ներդիրներ և ընդլայնումներ</translation>
<translation id="3631444715156784168">{NUM_EXTENSIONS,plural, =1{Agent Chrome-ը խորհուրդ է տալիս ձեզ հեռացնել այն}one{Agent Chrome-ը խորհուրդ է տալիս ձեզ հեռացնել այն}other{Agent Chrome-ը խորհուրդ է տալիս ձեզ հեռացնել դրանք}}</translation>
<translation id="2739521415810397215">Համակարգի աուդիոյով կիսվելու համար բացեք Համակարգի կարգավորումները և թույլատրեք «Միայն համակարգի աուդիոյի ձայնագրումը» Agent Chrome-ի համար։ Այնուհետև անհրաժեշտ կլինի վերագործարկել Agent Chrome-ը։</translation>
<translation id="1945073734373493421">Agent Chrome-ը թարմացվում է</translation>
<translation id="7323500970718355745">Ձեր նախընտրանքների ֆայլը վնասված է կամ անվավեր:

Agent Chrome-ին չհաջողվեց վերականգնել ձեր կարգավորումները:</translation>
<translation id="7324051657739063017">Դուք կարող եք նորից բացել համատեքստային առաջադրանքները, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="734373864078049451">Բոլոր վեբէջերը, էջանիշները և Chromium-ի այլ տվյալները պահվում են այստեղ:</translation>
<translation id="7347827960336370838">Միայն ձեր անցաբառն ունեցող մարդիկ կարող են կարդալ ձեր գաղտնագրված տվյալները։ Անցաբառը չի ուղարկվում Google-ին կամ պահվում նրա կողմից։ Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, ապա ձեզ անհրաժեշտ կլինի <ph name="BEGIN_LINK" />ջնջել Chromium-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="7994662313190863803">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել Agent Chrome-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի <ph name="ALTERNATIVE_BROWSER_NAME" /> դիտարկիչով։</translation>
<translation id="7352651011704765696">Ինչ-որ սխալ տեղի ունեցավ</translation>
<translation id="4438212735766904761">Agent Chrome-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է macOS 13 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է macOS 12 տարբերակը։</translation>
<translation id="7376384068949534168">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />» և «<ph name="PERMISSION_2" />» թույլտվությունները։</translation>
<translation id="73786666777299047">Բացել Chrome Web Store-ը</translation>
<translation id="7394275517973019558">Ցույց տալ «Gemini-ը Chromium-ում» հավելվածը ծանուցման տարածքում</translation>
<translation id="7401687852903179959">Որոնել այս տեսանյութը պատկերով որոնման միջոցով</translation>
<translation id="7407655596887111931">Chromium-ն այժմ ձեր կանխադրված դիտարկիչն է</translation>
<translation id="3957050361764426740">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ Agent Chrome-ը վերականգնում է ներդիրները յուրաքանչյուր վերագործարկումից հետո։ Այս գործառույթն անջատելու համար անցեք</translation>
<translation id="7427879960656355200">Արտահանեք գաղտնաբառեր Chromium</translation>
<translation id="744815265653811511">1. Սեղմեք <ph name="BUTTON_LABEL" /> ներքևում
2. Windows-ի կարգավորումներում սեղմեք <ph name="BUTTON_2" />
3. Սեղմեք <ph name="BUTTON_3" /> Windows-ի ծանուցման մեջ՝ Chromium-ը հավելվածների վահանակում ամրացնելու համար</translation>
<translation id="4378256924846450484"><ph name="PAGE_TITLE" /> – Agent Chrome Dev</translation>
<translation id="7450541714075000668">Տեքստը պատճենվեց</translation>
<translation id="1661210845845599119">Ձեր խոսափողն օգտագործելու համար Agent Chrome-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
<translation id="7461356015007898716">Chromium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 7 տարբերակը։</translation>
<translation id="7782360127659485548">Վերագործարկե՞լ Agent Chrome-ը</translation>
<translation id="7483335560992089831">Հնարավոր չէ տեղադրել Chromium-ի նույն տարբերակը, որն այժմ գործարկվում է: Փակեք Chromium-ը և նորից փորձեք:</translation>
<translation id="7510190804000607802">Հիշեցում․ Google-ի լավագույն հավելվածները ձեր գրպանում</translation>
<translation id="4114725046952451715">Կայքերի մեծ մասը ամենայն հավանականությամբ պատշաճ կերպով կաշխատի։ Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք Agent Chrome-ի բոլոր պատուհանները, սակայն կմնաք ձեր Google հաշվում, եթե մուտք եք գործել Agent Chrome։</translation>
<translation id="8460803820751380899">{0,plural, =1{Agent Chrome-ը կվերագործարկվի 1 րոպեից}one{Agent Chrome-ը կվերագործարկվի # րոպեից}other{Agent Chrome-ը կվերագործարկվի # րոպեից}}</translation>
<translation id="7565444033145385702">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Chromium-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։</translation>
<translation id="7806190892617295204">Ավտոմատ գործարկեք Agent Chrome-ը՝ անմիջապես դիտարկում սկսելու համար։</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" />-ի տեղադրիչ</translation>
<translation id="4114499337401148821">Agent Chrome-ն օգտագործում է ձեր տեսախցիկն ու խոսափողը:</translation>
<translation id="7617377681829253106">Chromium-ը կատարելագործվել է</translation>
<translation id="4075526625511660913">Այժմ Agent Chrome-ում ձեզ ավելի շատ գործառույթներ են հասանելի</translation>
<translation id="7624307931717240213">Մենք օգտագործում ենք տեղեկությունները՝ այս ծառայությունը բարելավելու համար։ Ծանոթացեք գաղտնիության քաղաքականությանը և Օգտագործման պայմաններին։</translation>
<translation id="7649070708921625228">Օգնություն</translation>
<translation id="7650134251917003571">Ներբեռնել Chromium հավելվածը</translation>
<translation id="7658239707568436148">Չեղարկել</translation>
<translation id="5829091955527196771">Agent Chrome-ը ձեր կանխադրված դիտարկիչը չէ</translation>
<translation id="7689606757190482937">Համաժամացրեք և անհատականացրեք Chromium-ը ձեր բոլոր սարքերում</translation>
<translation id="7699779824407626136">Chromium-ի թարմացում</translation>
<translation id="7700735928747402058">Ձեր աշխատանքը պաշտպանված է Chromium-ում</translation>
<translation id="7716950018788545737">Առաջադրանք(ներ)ը ավարտված են։</translation>
<translation id="77283119132245232">Տրամադրում է <ph name="BROWSER_NAME" /> դիտարկիչին համակարգի հետագծման ծառայություններ։ Եթե այս ծառայությունն անջատված է, դիտարկիչի կողմից ստեղծված արդյունավետության հետագծումները չեն ներառի համակարգային իրադարձություններ, ինչպիսիք են համատեքստի փոխանջատումը և հոսքի պատրաստությունը։</translation>
<translation id="7745317241717453663">Ձեր այցելությունների պատմությունը կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="7747138024166251722">Տեղադրիչը չկարողացավ ստեղծել ժամանակավոր գրացուցակ: Ստուգեք սկավառակում ազատ տարածքի առկայությունը և ծրագրակազմը տեղադրելու թույլտվությունը:</translation>
<translation id="7747820849741499258">Որոնում Chromium-ում</translation>
<translation id="7750130090210923118">Վերականգնել Chromium-ի կանխադրված կարգավորումները</translation>
<translation id="7752521946322750699">Chromium-ում աշխատանքի անվտանգությունն ապահովելու համար ձեր կազմակերպությունը կկարողանա դիտել կամ կառավարել որոշակի տեղեկություններ, երբ մուտք գործեք Chromium։</translation>
<translation id="7781047659465034537">Դարձրեք Chromium-ը կանխադրված դիտարկիչ և ամրացրեք այն հավելվածների վահանակում</translation>
<translation id="7786760609782648049">Արագացրեք Chromium-ի աշխատանքը</translation>
<translation id="1092858669153166534"><ph name="PAGE_TITLE" /> – Agent Chrome Canary</translation>
<translation id="6890902183809417868">Արեք այնպես, որ ձեր ինտերնետ թրաֆիկի հասանելիություն ունեցող մարդիկ չկարողանան տեսնել, թե ինչ կայքեր եք այցելել։ Agent Chrome-ն օգտագործում է ապահով միացում՝ DNS-ում (տիրույթի անունների համակարգ) կայքերի IP հասցեները որոնելու համար։</translation>
<translation id="7810005234485217901">Ամրացրեք «Որոնում պատկերով» գործառույթը՝ արագ մուտքի համար</translation>
<translation id="4343938787674079986">Ընտրեք, թե ինչ տվյալներով կիսվել Agent Chrome-ի հետ</translation>
<translation id="7828947555739565424">Այս հաշվի հետ կապված Chromium-ի պրոֆիլ արդեն գոյություն ունի այս սարքում</translation>
<translation id="7845233973568007926">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր համակարգիչը։</translation>
<translation id="6129792107484731038">Ձեր որոնողական համակարգը Agent Chrome-ից դուրս է փոխվել։ Անվտանգության նկատառումներով՝ Agent Chrome-ը վերականգնել է կանխադրված կարգավորումները։ <ph name="LEARN_MORE_LINK" /></translation>
<translation id="7853661403199074278">Անհատականացրեք Chromium-ը՝ դրան նոր տեսք հաղորդելու համար</translation>
<translation id="5018331886385637870">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Agent Chrome-ը ձեր հարցումն ուղարկում է կանխադրված որոնողական համակարգին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="473441635289092936">Չհաջողվեց տեղադրել Agent Chrome-ի վերջին տարբերակը, որը թարմացվել է նոր գործառույթներով և անվտանգության բարելավումներով:</translation>
<translation id="7872446069773932638">Ներբեռնում… Մնաց <ph name="SECONDS" /> վայրկյան</translation>
<translation id="7873537467422636035">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, <ph name="BEGIN_LINK" />ջնջեք Chromium-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="7874369989024033742">Թույլ է տալիս արագ բացել «Gemini-ը Chromium-ում» հավելվածը, երբ դրա անհրաժեշտությունը կա</translation>
<translation id="7888981273428720788">Դարձնել Chromium-ը ձեր կանխադրված դիտարկիչը</translation>
<translation id="7934340546140346950">Chromium-ը հնարավորության դեպքում ավտոմատ կերպով վերածում է ոչ ապահով միացումները HTTPS-ի</translation>
<translation id="7937630085815544518">Դուք մուտք եք գործել Chromium որպես <ph name="USER_EMAIL_ADDRESS" />: Նորից մուտք գործելու համար օգտագործեք նույն հաշիվը:</translation>
<translation id="7944602660083060118"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Chromium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Էջանիշները և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="688313102897865477">Սա Agent Chrome-ի երկրորդային տեղադրումն է: Այն չի կարող դառնալ ձեր կանխադրված դիտարկիչը:</translation>
<translation id="8514782479541580218">Անհայտ աղբյուրներից ընդլայնումները, հավելվածներն ու թեմաները կարող են վնասել ձեր սարքը։ Agent Chrome-ը խորհուրդ է տալիս դրանք տեղադրել միայն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ից։</translation>
<translation id="8000759043835159571">Օգտագործեք Google-ի բոլոր առավելությունները Chromium հավելվածի միջոցով ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="8004582292198964060">Դիտարկիչ</translation>
<translation id="8010081455002666927">Ինքնահայտնաբերում</translation>
<translation id="403216574291780144">Երբ Agent Chrome-ը հասանելիություն ստանա, կայքերը կկարողանան ձեզնից հասանելիություն խնդրել։</translation>
<translation id="7835197459694498831">Ամրացրեք Agent Chrome-ը խնդրագոտու վրա՝ այն ցանկացած պահի արագ բացելու համար</translation>
<translation id="80471789339884597">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր բոլոր դիտարկիչները։</translation>
<translation id="8054112667659782652">Միշտ ցույց տալ պատկերով որոնման դյուրանցումը</translation>
<translation id="8069447462453318634">Ընտրեք «Ամրացնել գործիքագոտում»</translation>
<translation id="787536271006179882">Անջատել Agent Chrome-ի ֆոնային ռեժիմը հավելվածների համար</translation>
<translation id="80790299200510644">Որոնում պատկերով</translation>
<translation id="8086881907087796310">Տեղադրումը ձախողվեց, քանի որ ձեր համակարգիչը չի համապատասխանում սարքակազմի նվազագույն պահանջներին։</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Google Chrome for Testing</translation>
<translation id="8105840573057009683">Այս կայքի համար Chromium-ին անհրաժեշտ է տեղորոշումն օգտագործելու թույլտվություն</translation>
<translation id="8107060931443639922">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք Chromium-ը, կտեսնեք գների հետագծման ծանուցումները միացնելու հրավեր։</translation>
<translation id="8117908349476699973">Ստացեք ձեզ հետաքրքրող ապրանքների գնիջեցման մասին ծանուցումներ ձեր հեռախոսի Chromium հավելվածում</translation>
<translation id="8118331347066725040">Կարծիք հայտնեք «Որոնել Տեսապակու միջոցով» գործառույթի մասին</translation>
<translation id="8130609355518033382">Անհատականացրեք Chromium-ը</translation>
<translation id="8133124826068723441">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ այդ գործառույթը հասանելի չէ ձեր տիրույթի համար։</translation>
<translation id="813913629614996137">Նախապատրաստվում է...</translation>
<translation id="8161503455832158203">Բացել «Gemini-ը Chromium-ում» հավելվածը ստեղնային դյուրանցման միջոցով։</translation>
<translation id="7109772131778940712">Agent Chrome-ի օգտագործման լրացուցիչ պայմաններ</translation>
<translation id="7759642951398174884">Այս ֆայլը վտանգավոր է, և Agent Chrome-ն արգելափակել է այն։</translation>
<translation id="8177472873527554730">Էջում բովանդակություն գտնել հնարավոր չէ</translation>
<translation id="8200109504272824693">Chromium-ի տվյալները <ph name="USER_EMAIL" /> հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="820759916613250543">Որոնել այս պատկերը պատկերով որոնման միջոցով</translation>
<translation id="8221491193165283816">Դուք սովորաբար արգելափակում եք ծանուցումները։ Այս կայքում ծանուցումներ ստանալու համար սեղմեք այստեղ։</translation>
<translation id="5410773870087525304">Ձեր տեսախցիկն օգտագործելու համար Agent Chrome-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
<translation id="1057772683559103555">Agent Chrome-ը չի կարող ստուգել այս ընդլայնման ծագումը, ուստի այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Agent Chrome-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="1968416200800224093">Եթե պատկերն օգտակար նկարագրություն չունի, Agent Chrome-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։ Ցանկացած պահի կարգավորումներում կարող եք անջատել սա:</translation>
<translation id="8254601181414348851">Մուտք գործե՞լ Chromium նոր պրոֆիլում</translation>
<translation id="8262224117913639129"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Chromium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն գաղտնաբառերը և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="8277334259226003205">«Gemini-ը Chromium-ում» հավելվածը ավելացնել ծանուցման տարածքում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium-ը զգուշացնում է ձեզ<ph name="END_LINK" /> վտանգավոր կայքերի և ներբեռնումների մասին</translation>
<translation id="8295827201165805317">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION" />» թույլտվությունը։</translation>
<translation id="8296236834352487533">Օգտագործեք ձեր շարժական սարքի տեսախցիկը՝ Chromium-ի iOS հավելվածում ապրանքներ գտնելու, տեքստեր թարգմանելու և ձեզ շրջապատող օբյեկտների մասին տեղեկություններ ստանալու համար</translation>
<translation id="8310603974518734211">QR կոդ՝ Chromium որպես <ph name="USER_NAME" /> մուտք գործելու համար</translation>
<translation id="8313851650939857356">Մեկնարկի սխալ․ <ph name="STARTUP_ERROR" />։</translation>
<translation id="2256229026962116267">Ձեր կազմակերպությունը փակում է Agent Chrome-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։</translation>
<translation id="8321888067342493336">Պահել որպես պատկեր</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" />-ը նախկինում Chromium է օգտագործել</translation>
<translation id="8351551329754447960">Միացնել հմտությունները Chromium-ում</translation>
<translation id="8359544530202147897">Թարմացրեք Chromium-ը, որպեսզի շարունակեք օգտագործել Chromium-ի տվյալները ձեր <ph name="ACCOUNT_EMAIL" /> Google հաշվում։</translation>
<translation id="8360718212975266891">Chromium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8 տարբերակը։</translation>
<translation id="8362914115861174987">Թարգմանության լեզու</translation>
<translation id="8367705492654390392">Հարցրեք որևէ բան</translation>
<translation id="8370517070665726704">© Google LLC <ph name="YEAR" />։ Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8372327902843331129">Գաղտնաբառերը և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Chromium։ Այս գաղտնաբառը կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="3962779702290581702">Այնուհետև անհրաժեշտ կլինի վերագործարկել Agent Chrome-ը։</translation>
<translation id="6085013152567092546">Agent Chrome-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" /></translation>
<translation id="8142784445734351509">Այս ընդլայնման հրապարակումը չեղարկվել է մշակողի կողմից, և այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Agent Chrome-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="8416884904046428725">Որպեսզի որոշ տվյալներ հնարավոր լինի պահել ձեր Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Chromium-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="7611805576553766531">{0,plural, =1{Վերագործարկեք Agent Chrome-ը մեկ օրվա ընթացքում}one{Վերագործարկեք Agent Chrome-ը # օրվա ընթացքում}other{Վերագործարկեք Agent Chrome-ը # օրվա ընթացքում}}</translation>
<translation id="8438543370129609977">Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ուղարկվում են սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">Իմանալ ավելին Chromium-ում պատկերների միջոցով որոնման մասին</translation>
<translation id="8453117565092476964">Տեղադրիչի արխիվը վնասված է կամ անվավեր: Նորից ներբեռնեք Chromium-ը:</translation>
<translation id="8458614432758743027">Chromium-ի համար պահանջվում է Windows 10 կամ ավելի նոր տարբերակ։</translation>
<translation id="8463672209299734063">Ըստ ցանկության. օգնեք բարելավել ChromiumOS-ի գործառույթներն ու աշխատանքը՝ Google-ին ավտոմատ կերպով ուղարկելով օգտագործման և դիագնոստիկ տվյալները։</translation>
<translation id="8471947159125090285">Chromium-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար հաստատեք ձեր ինքնությունը</translation>
<translation id="8482493977473846331">Ցույց է տալիս հաղորդագրություն Chromium-ում մուտք գործելու համար</translation>
<translation id="6049002268233195982">Agent Chrome-ը հնացած է</translation>
<translation id="6156435126546305838">Շնորհակալություն Agent Chrome-ը որպես ձեր կանխադրված դիտարկիչ ընտրելու համար։</translation>
<translation id="8522801943730206384">Chromium-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք</translation>
<translation id="8525579356836940628">Տեղադրումը կանգնեցվել է</translation>
<translation id="8545729292258443488">Ձեր գաղտնաբառերը, ներդիրները և այլ տվյալներ միշտ հասանելի կլինեն ձեր <ph name="DEVICE_TYPE" />-ի Chromium հավելվածի միջոցով</translation>
<translation id="8548787790260785208">Ստացեք ծանուցում, երբ Chromium-ը հայտնաբերի, որ ձեր գաղտնաբառերից մեկը բացահայտվել է տվյալների հանրային արտահոսքի արդյունքում</translation>
<translation id="8555465886620020932">Ծառայության սխալ՝ <ph name="SERVICE_ERROR" />։</translation>
<translation id="2713372071612730965">Agent Chrome-ի որոշ գործառույթներ և ընդլայնումներ ունեն դյուրանցումներ։ Դուք կարող եք նորից միացնել դրանք։</translation>
<translation id="8556420416730706394">«Որոնում պատկերով» գործառույթից արագ օգտվելու համար սեղմեք կողային վահանակի վերևի հատվածում գտնվող «Ամրացնել» կոճակը</translation>
<translation id="856656450041460113">Որոնել լեզուների ցանկում</translation>
<translation id="1783040386392706016">Agent Chrome-ը կառավարվում է մի քանի կազմակերպության կողմից</translation>
<translation id="7921569471494089882">© <ph name="YEAR" /> Silkweave: Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8601359445272098721">Նորույթ․ դուք կարող եք ձեր էկրանին թարգմանել ինչպես տեքստ, այնպես էլ պատկերներ՝ սեղմելով «Թարգմանել էկրանը» կոճակը</translation>
<translation id="6294059080097269555">Agent Chrome-ի գործարկում...</translation>
<translation id="8624541899164515475">Կարգավորումներ, բացվում է նոր ներդիրում։</translation>
<translation id="8648201657708811153">Google Chrome for Testing-ը չի կարող դառնալ ձեր կանխադրված դիտարկիչը։</translation>
<translation id="5652647471010716562">Այն նաև վերահսկում է Agent Chrome-ի մեկնարկի կամ Omnibox-ից որոնում կատարելու ժամանակ ցուցադրվող էջը:</translation>
<translation id="8704119203788522458">Սա ձեր Chromium-ն է</translation>
<translation id="8712637175834984815">Պատրաստ է</translation>
<translation id="8719993436687031146">Մուտք գործե՞լ Chromium</translation>
<translation id="8747073452963259673">որոնման տարածքի ներքևի ձախ անկյուն՝ <ph name="LEFT" />% ձախից, <ph name="BOTTOM" />% վերևից</translation>
<translation id="878572486461146056">Տեղադրման սխալ. ձեր ցանցի ադմինիստրատորը կիրառել է խմբային կանոն, որը կանխում է տեղադրումը՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Հիշեցնել ավելի ուշ</translation>
<translation id="8816416449795340678">Կիսվեք այս փաստաթղթով Gemini-ի հետ Chromium-ում՝ դրա համառոտ նկարագրությունը ստանալու և լրացուցիչ հարցեր տալու համար</translation>
<translation id="8818550178040858407">Մուտք գործե՞լ Chromium</translation>
<translation id="4188893721116572726">Դարձնել Agent Chrome-ը կանխադրված դիտարկիչ և ամրացնել խնդրագոտում</translation>
<translation id="8826492472752484139">Սեղմեք «Գաղտնաբառերի կառավարիչ»</translation>
<translation id="8833697763442816810">ChromiumOS համակարգ</translation>
<translation id="341256515309503869">Այս լեզուն օգտագործվում է՝ Agent Chrome-ում ընտրացանկերը, կարգավորումները, զգուշացումները և այլ տեքստեր ցուցադրելու համար</translation>
<translation id="8862326446509486874">Դուք չունեք համապատասխան իրավունքներ՝ համակարգի մակարդակով տեղադրում կատարելու համար: Փորձեք տեղադրումը կատարել որպես Ադմինիստրատոր:</translation>
<translation id="8876044221123442390">Ավելացնել Chromium պրոֆիլ</translation>
<translation id="8890569919834781711">Մուտքի սխալի պատճառով ChromiumOS-ին չհաջողվեց պահել Chromium-ի տվյալները ձեր Google հաշվում</translation>
<translation id="8891709362986793894">Ձեր կազմակերպության կանոնների համաձայն՝ դուք պետք է մուտք գործեք Chromium</translation>
<translation id="8907580949721785412">Chromium-ը փորձում է ցուցադրել գաղտնաբառերը: Մուտքագրեք ձեր Windows-ի գաղտնաբառը՝ այս գործողությունը թույլ տալու համար:</translation>
<translation id="8932992523185907506">Chromium-ն այլևս ձեր կանխադրված դիտարկիչը չէ։ Դարձնե՞լ Chromium-ը կանխադրված դիտարկիչ։</translation>
<translation id="2086624065931944916">Չհաջողվեց թարմացնել Agent Chrome-ը</translation>
<translation id="8944232836376404813">Այս գործողության արդյունքում տեղի կունենա հետևյալը․
          <ph name="LINE_BREAKS" />
            • Մեկնարկային էջի, նոր ներդիրի էջի, որոնողական համակարգի և ամրացված ներդիրների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAK" />
            • Ընդլայնումները կանջատվեն
            <ph name="LINE_BREAK" />
            • Քուքիները և կայքերի մյուս ժամանակավոր տվյալները կջնջվեն
            <ph name="LINE_BREAKS" />
            Էջանիշները, պատմությունը և պահված գաղտնաբառերը կպահպանվեն</translation>
<translation id="8966875421152977384">Ցույց տալ Chromium կայքի դյուրանցումները</translation>
<translation id="4591081057798655502">Agent Chrome Enterprise-ի լոգո</translation>
<translation id="8980139959902937527">Օգտագործեք Google-ի անվտանգության գործառույթները ձեր <ph name="DEVICE_TYPE" />-ում Chromium հավելվածի միջոցով</translation>
<translation id="352721818246741864">Չհաջողվեց գործարկել Agent Chrome-ը, քանի որ պրոֆիլը բացելիս սխալ առաջացավ։ Փորձեք վերագործարկել Agent Chrome-ը։</translation>
<translation id="8988036198400390003">Կառավարել Chromium-ի պրոֆիլները</translation>
<translation id="8993855408334954620">Օգտագործեք ձեր ստեղնաշարը՝ «Gemini-ը Chromium-ում» հավելվածի և ձեր բացված ներդիրի միջև անցում կատարելու համար։</translation>
<translation id="9018218886431812662">Տեղադրումն ավարտվեց</translation>
<translation id="9019929317751753759">Chromium-ն ավելի ապահով դարձնելու համար հետևյալ ընդլայնումներն անջատվել են, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացված լինել առանց ձեր իմացության։</translation>
<translation id="9022552996538154597">Մուտք գործել Chromium</translation>
<translation id="9035791714111278917">Ցույց տալ Chromium-ով որոնումը Mac-ի ընտրացանկի գոտում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="144293525744948128">Agent Chrome-ն արգելափակել է այս ներբեռնումը, քանի որ արխիվացված ֆայլը կարող է այլ ֆայլեր պարունակել, որոնք կարող են վնասագրեր լինել</translation>
<translation id="9053882453960391422">Ձեր գաղտնաբառերը, էջանիշները և պատմությունը կհամաժամացվեն ձեր բոլոր սարքերում։ Հեշտությամբ օգտագործեք ձեզ ծանոթ և սիրելի գործառույթները՝ որպես կանխադրված դիտարկիչ ընտրելով Chromium-ը։ Chromium-ը կամրացվի հավելվածների վահանակում՝ արագ մուտքի համար։</translation>
<translation id="9056398481763999048">Օգտվեք Google-ի լավագույն ԱԲ գործիքներից ձեր հեռախոսի Chromium հավելվածի օգնությամբ</translation>
<translation id="9062666675513499497">Մուտք գործեք Chromium, երբ մուտք եք գործում Google-ի այլ ծառայություններ</translation>
<translation id="5989671354018094677">Agent Chrome-ն ավտոմատ փակվել է</translation>
<translation id="5288426372256126088">Agent Chrome-ը հնացել է</translation>
<translation id="8599483501705081932">{0,plural, =1{Agent Chrome-ը կվերագործարկվի մեկ ժամից}one{Agent Chrome-ը կվերագործարկվի # ժամից}other{Agent Chrome-ը կվերագործարկվի # ժամից}}</translation>
<translation id="9106236359747881194">Ընտրեք տեքստը՝ որոնելու համար</translation>
<translation id="9106612006984859720">Chromium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8.1 տարբերակը։</translation>
<translation id="6660967356554387137">Բացել հղումը Agent Chrome-ի նոր &amp;ներդիրում</translation>
<translation id="911206726377975832">Ջնջե՞լ նաև ձեր դիտարկումների տվյալները:</translation>
<translation id="9134482777260927479">Օգնություն տնային աշխատանքը կատարելիս</translation>
<translation id="9148058034647219655">Ելնել</translation>
<translation id="356554850028684199">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ Agent Chrome-ը կարող է վերականգնել ներդիրները յուրաքանչյուր վերագործարկումից հետո։ Այս գործառույթը միացնելու համար անցեք</translation>
<translation id="2217675621893057123">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել Agent Chrome-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի մեկ այլ դիտարկիչով:</translation>
<translation id="7637726452490203009">Վերագործարկել՝ &amp;Agent Chrome-ը թարմացնելու համար</translation>
<translation id="9190841055450128916">Chromium (mDNS-In)</translation>
<translation id="924957577793602335">Անհատականացրեք Chromium-ը</translation>
<translation id="93478295209880648">Chromium-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Windows XP և Windows Vista համակարգերում</translation>
<translation id="945098430667185067">Օգտվեք Google-ի անվտանգության լավագույն գործառույթներից Chromium-ում։</translation>
<translation id="945522503751344254">Կարծիք հայտնել</translation>
<translation id="965162752251293939">Ո՞վ է օգտագործում Chromium-ը</translation>
<translation id="967427899662692980">Ուժեղացրեք Chromium-ի անվտանգությունը</translation>
<translation id="983803489796659991">Չհաջողվեց տեղադրել հավելվածը, քանի որ թարմացումն իրականացնող սերվերը չունի հավելվածի համար անհրաժեշտ հեշերի տվյալներ։</translation>
<translation id="985498048907240953">Օգտագործել Chromium-ն առանց հաշվի</translation>
<translation id="5192139095541169725">Agent Chrome Authors</translation>
<translation id="989970834842471429">Ընտրեք ցանկացած տեքստ կամ պատկեր պատկերների որոնման միջոցով որոնում անելու համար</translation>
<translation id="5834693163377136360">Ձեր տեղադրության տվյալներն օգտագործելու համար Agent Chrome-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
</translationbundle>