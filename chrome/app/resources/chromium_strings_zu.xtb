<translation id="7141270731789036260">Yenza i-Chrome ibe ngokwezifiso ukuze ihlolwe</translation>
<translation id="2566749447284070075">Ungasebenzisa iShuttle noma nini lapho uchofoza amalinki emiyalezweni, amadokhumenti, namanye ama-app</translation>
<translation id="4717037424104880768">Susa <ph name="EXTENSION_NAME" /> kuShuttle</translation>
