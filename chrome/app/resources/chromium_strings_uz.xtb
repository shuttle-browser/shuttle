<translation id="1518627427551567882">Bu sahifa himoyalangan</translation>
<translation id="3850708453627715578">Agent Chrome sahifasini namoyish qilish</translation>
<translation id="154404805518949443">Chromiumga kirish</translation>
<translation id="1547469039832541117">Belgilangan vazifani yakunlaydi.</translation>
<translation id="8546278207686764484">Agent Chromeni mahkamlash</translation>
