<translation id="4814380868372526025">{0,plural, =0{Ažuriranje za Agent Chrome je dostupno}=1{Ažuriranje za Agent Chrome je dostupno}one{Ažuriranje za Agent Chrome je dostupno # dan}few{Ažuriranje za Agent Chrome je dostupno # dana}other{Ažuriranje za Agent Chrome je dostupno # dana}}</translation>
<translation id="188722644954983559">Uvijek izbrišite podatke web lokacije s uređaja kada zatvorite Agent Chrome</translation>
