<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="1026101648481255140">Rifillo instalimin</translation>
<translation id="1029669172902658969">Nise sërish për të përditësuar ChromiumOS</translation>
<translation id="8271032073852564289">Agent Chrome rekomandon që ta rinovosh këtë shtesë</translation>
<translation id="1395700234492294565">Kur një sajt kërkon të ngarkojë paraprakisht lidhje në mënyrë private në faqen e tij, Agent Chrome përdor serverët e Google. Kjo e fsheh identitetin tënd nga sajti i ngarkuar paraprakisht, por Google mëson se çfarë sajtesh ngarkohen paraprakisht.</translation>
<translation id="1051793555070215510">Na ndihmo të përmirësojmë modalitetin "I fshehtë" duke plotësuar këtë anketë 1-minutëshe.</translation>
<translation id="1065672644894730302">Preferencat e tua nuk mund të lexohen.

Disa funksione mund të mos ofrohen dhe ndryshimet në preferenca nuk do të ruhen.</translation>
<translation id="3693661839172633833">Prindi yt ka çaktivizuar "Lejet për sajtet, aplikacionet dhe shtesat" për Agent Chrome</translation>
<translation id="4676383270508741906">Për të kërkuar një veçori ose shtesë specifike të Agent Chrome, shkruaj shkurtoren e saj në shiritin e adresave, të ndjekur nga tasti i zgjedhur i tastierës</translation>
<translation id="1098493699368672217">Shfaq kërkimin me Chromium në tabakanë e sistemit dhe aktivizo shkurtoren e tastierës</translation>
<translation id="1104942323762546749">Chromium dëshiron të eksportojë fjalëkalimet e tua. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="112640046208448578">Identifiko gjërat ose vendet dhe kopjo ose përkthe tekstin. Kur përdor "Kërkimin nëpërmjet imazheve", një pamje ekrani e faqes dërgohet te serveri. <ph name="LEARN_MORE" /></translation>
<translation id="5373975050135708711">Agent Chrome është shfletuesi yt i parazgjedhur</translation>
<translation id="1131805035311359397">Për të kontrolluar nëse fjalëkalimet e tua janë të sigurta nga nxjerrjet e paautorizuara të të dhënave dhe probleme të tjera të sigurisë, <ph name="BEGIN_LINK" />identifikohu në Chromium<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Kliko te menyja e Chromium</translation>
<translation id="1157985233335035034">Gjuhët e fundit</translation>
<translation id="1184145431117212167">Instalimi dështoi pasi versioni yt i Windows nuk mbështetet.</translation>
<translation id="604454529346438712">Rreth Agent Chrome</translation>
<translation id="1186645291482254714">Merr sinjalizime për monitorimin e çmimeve me Chromium në telefonin tënd</translation>
<translation id="1203500561924088507">Faleminderit që e instalove. Duhet të rinisësh shfletuesin përpara se të përdorësh <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Kur hap "Kërkimin e imazheve", titulli i faqes, URL-ja dhe përmbajtja, duke përfshirë skedarët PDF, do të dërgohen automatikisht te serveri. <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">Kur je i identifikuar, mund të përdorësh fjalëkalimet dhe më shumë nga "Llogaria jote e Google" në Chromium. Për ta ndryshuar këtë, shko te "Llogaria jote në Chromium".</translation>
<translation id="1244381985120794049">Shfaq Gemini në Chromium në shiritin e menysë së Mac</translation>
<translation id="1257483544893909270">Për të zgjedhur një pjesë të ekranit në Gemini në Chromium, përdor shkurtoren e tastierës.</translation>
<translation id="1262876892872089030">Kur kjo skedë ishte joaktive, memoria u lirua që Chromium të vazhdojë të jetë i shpejtë. Mund të zgjedhësh që ta përjashtosh gjithmonë këtë sajt nga caktimi si joaktiv.</translation>
<translation id="3777643518642881741">Agent Chrome e bllokoi këtë shkarkim sepse skedari është i rrezikshëm</translation>
<translation id="126567311906253476">Kur identifikohesh me <ph name="USER_EMAIL" /> në shërbimet e Google, si p.sh. Gmail ose YouTube, mund të identifikohesh automatikisht në Chromium me të njëjtën llogari</translation>
<translation id="1287534462498555020">Merr Chromium në telefonin tënd</translation>
<translation id="1290883685122687410">Gabim në konfigurim: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Konfiguro profilin tënd të ri të Chromium</translation>
<translation id="132092532143527429">Provo me Gemini në Chromium</translation>
<translation id="200785071050073583">Agent Chrome ka nevojë për qasje te Bluetooth-i për të eksploruar pajisjet me Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">Identifikohu në Chromium në telefonin tënd</translation>
<translation id="1330562121671411446">Zbulo gjuhën</translation>
<translation id="1342274909142618978">Fshi po ashtu të dhënat nga Chromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">U gozhdua! Mund të qasesh përsëri te "Kërkimi nëpërmjet imazheve" nga butoni i ri në shiritin e veglave</translation>
<translation id="1356661055722410047">E re! Mund të përkthesh tekstet dhe imazhet në ekranin tënd</translation>
<translation id="1383876407941801731">Kërko</translation>
<translation id="1388276868779258475">Përdor aplikacionin e Chromium për të vazhduar të shfletosh kur je në lëvizje</translation>
<translation id="141901961143729572">Ndaj mendimet e tua</translation>
<translation id="8789809509510733987">Për të ndarë dritaren tënde, lejo regjistrimin e ekranit për Agent Chrome te "Cilësimet e sistemit".</translation>
<translation id="1478370723027452770">Merr ndihmë për Chrome for Testing</translation>
<translation id="1497802159252041924">Gabim gjatë instalimit: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Kjo faqe është e mbrojtur</translation>
<translation id="3850708453627715578">Ndaj një skedë të Agent Chrome</translation>
<translation id="154404805518949443">Identifikohu në Chromium</translation>
<translation id="1547469039832541117">Përfundon detyrën e theksuar.</translation>
<translation id="8546278207686764484">Gozhdo Agent Chrome</translation>
<translation id="1574377791422810894">Veglat e sigurisë të Chromium</translation>
<translation id="1594928384848033697">Chromium dëshiron të fshijë të dhënat e tua të "Menaxherit të fjalëkalimeve". Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="551713766576210710">{COUNT,plural, =0{Administratori yt kërkon që të hapësh përsëri Agent Chrome për të zbatuar këtë përditësim}=1{Administratori yt kërkon që të hapësh përsëri Agent Chrome për të zbatuar këtë përditësim Dritarja jote "e fshehtë" nuk do të rihapet.}other{Administratori yt kërkon që të hapësh përsëri Agent Chrome për të zbatuar këtë përditësim # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="1623563412065267963">Merr më të mirën e Google me aplikacionin e Chromium në telefonin tënd</translation>
<translation id="1625909126243026060">Shqyrto kontrollet kryesore të sigurisë dhe privatësisë në Chromium</translation>
<translation id="1640672724030957280">Po shkarkohet...</translation>
<translation id="1665602916345474427">Identifikuar si <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, anëtarësim. Hap menynë e llogarisë</translation>
<translation id="2604712040942461790">Mund të përdorësh Agent Chrome sa herë që klikon te lidhjet në mesazhe, dokumente dhe aplikacione të tjera. Ai do të gozhdohet gjithashtu te shiriti i detyrave.</translation>
<translation id="1709772298389099340">Ofron privilegje të larta për <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Kjo do të të lejojë që të zgjedhësh nga pajisjet e disponueshme dhe të shfaqësh përmbajtjet në to.</translation>
<translation id="4145295773323539953">Agent Chrome do t'i fshijë së shpejti të dhënat e shfletimit</translation>
<translation id="1736443181683099871">Chromium do të përpiqet t'i përmirësojë navigimet në HTTPS</translation>
<translation id="7280502947294080605">Të dhënat e Agent Chrome u pastruan</translation>
<translation id="1745121272106313518">Chromium do të riniset pas <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Kur HTTPS nuk ofrohet, Chromium do të përdorë një lidhje të pasigurt pa të të paralajmëruar</translation>
<translation id="1887395919652703120">Lejo që Agent Chrome të ekzekutohet në sfond</translation>
<translation id="1779356040007214683">Për ta bërë më të sigurt Chromium, çaktivizuam disa shtesa që nuk janë të listuara në <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> dhe që mund të jenë shtuar pa dijeninë tënde.</translation>
<translation id="1793486931176048546">Kliko te <ph name="BEGIN_BOLD" />Po<ph name="END_BOLD" /> në njoftimin e Windows për të gozhduar Chromium te shiriti i detyrave për qasje të shpejtë.</translation>
<translation id="357645171972700077">Instalo përsëri Agent Chrome</translation>
<translation id="1820835682567584003">Chromium po përpiqet <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">Herën tjetër që të hapësh Chromium në <ph name="DEVICE_TYPE" />, do të shikosh një kërkesë për të përdorur "Menaxherin e fjalëkalimeve të Google".</translation>
<translation id="1838374766361614909">Fshi kërkimin</translation>
<translation id="18552579716432081">Për t'i fshirë të dhënat e shfletimit vetëm nga kjo pajisje, ndërkohë që i mban ato në "Llogarinë tënde të Google", <ph name="BEGIN_LINK" />dil nga llogaria në Chromium<ph name="END_LINK" />.</translation>
<translation id="1857749206890802997">Shkarko Chromium në telefon për të hapur ose krijuar grupe të reja skedash kur je në lëvizje.</translation>
<translation id="185970820835152459">Mund t'i menaxhosh "Llogaritë e Google" ku je identifikuar. "Llogaritë e tua të Google" përdoren për shfletuesin Chromium, Play Store, Gmail etj. Nëse do të shtosh një llogari për dikë tjetër, si p.sh. anëtar të familjes, shto më mirë një person të ri te <ph name="DEVICE_TYPE" /> yt. <ph name="LINK_BEGIN" />Mëso më shumë<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Kërko me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="1863837059069884561"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Chromium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu faqeshënuesit e tu etj. nga <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Përzgjidh tekstin</translation>
<translation id="1881322772814446296">Po identifikohesh me një llogari të menaxhuar dhe po i jep administratorit të saj kontrollin mbi profilin tënd të Chromium. Të dhënat e tua të Chromium, si aplikacionet, faqeshënuesit, historiku, fjalëkalimet dhe cilësimet e tjera do të bëhen të lidhura përgjithmonë me <ph name="USER_NAME" />. Do të mund t'i fshish këto të dhëna nëpërmjet "Panelit të llogarive të Google", por nuk do të mund t'i lidhësh këto të dhëna me një llogari tjetër. Mund të krijosh si opsion një profil të ri për t'i mbajtur më vete të dhënat ekzistuese të Chromium. <ph name="LEARN_MORE" /></translation>
<translation id="4964792828232534953">Agent Chrome kursen energjinë e baterisë duke kufizuar aktivitetin në sfond dhe efektet vizuale, si p.sh. lëvizjen e butë dhe shpejtësitë e kuadrove të videove. <ph name="BEGIN_LINK" />Mëso më shumë për "Kursyesin e energjisë"<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">Chromium Updater Service</translation>
<translation id="1911763535808217981">Duke çaktivizuar këtë, mund të identifikohesh në sajtet e Google si Gmail pa u identifikuar në Chromium</translation>
<translation id="1929939181775079593">Chromium nuk përgjigjet. Dëshiron ta hapësh sërish tani?</translation>
<translation id="1933341829955786215">Organizata jote, <ph name="MANAGER" />, kërkon që të identifikohesh në Chromium</translation>
<translation id="193439633299369377">ChromiumOS ka nevojë të riniset për të zbatuar përditësimin.</translation>
<translation id="207375373460618430">Agent Chrome e bllokoi këtë shkarkim sepse lloji i skedarit nuk është shkarkuar zakonisht dhe mund të jetë i rrezikshëm</translation>
<translation id="1953553007165777902">Po shkarkohet... Kanë mbetur edhe <ph name="MINUTE" /> minuta</translation>
<translation id="700162948230159797">Agent Chrome nuk mund të përcaktojë ose caktojë shfletuesin e parazgjedhur</translation>
<translation id="197326043290947695">Shfleto në mënyrë më inteligjente me "Kërkimin e imazheve"</translation>
<translation id="1990262977744080398">Mëso se pse Chromium i bllokon disa skedarë, hapet në një skedë të re</translation>
<translation id="1999715455684970349">E mban të përditësuar softuerin e Chromium. Nëse ky shërbim çaktivizohet ose ndalohet, softueri yt i Chromium nuk do të mbahet i përditësuar, që do të thotë se dobësitë e sigurisë që mund të lindin nuk mund të rregullohen dhe veçoritë mund të mos funksionojnë. Ky shërbim çinstalohet vetë kur nuk ka një softuer të Chromium që e përdor atë.</translation>
<translation id="2008474315282236005">Kjo do të fshijë 1 artikull nga kjo pajisje. Për t'i marrë më vonë të dhënat, identifikohu te Chromium si <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalimi nuk u krye. Provo përsëri.</translation>
<translation id="2039417478970545937">Cilësimet.</translation>
<translation id="2049376729098081731">Zgjidh nëse do ta përfshish historikun e Chromium për përvoja më të personalizuara në shërbimet e Google</translation>
<translation id="2050698962207788467">I integruar në Chromium për të të ndihmuar të krijosh, ruash dhe plotësosh automatikisht fjalëkalime të forta. Shto shkurtoren për qasje të lehtë.</translation>
<translation id="2064856577282482477">Kliko te butoni "Personalizo Chromium" në faqen e skedës së re për t'i dhënë Chromium një pamje të re</translation>
<translation id="6816376218079012438">Agent Chrome e bllokoi këtë shkarkim sepse skedari është mashtrues dhe mund të bëjë ndryshime të papritura në pajisjen tënde</translation>
<translation id="208726765006323911">Do të shikosh një kërkesë për të provuar <ph name="FEATURE_NAME" /> herën tjetër kur të hapësh Chromium për iOS.</translation>
<translation id="2099452623287920103">Fjalëkalimet e tua dhe të dhënat e tjera të Chromium që ke ruajtur në "Llogarinë tënde të Google" do të hiqen nga kjo pajisje. Për t'i përdorur përsëri në Chromium, identifikohu përsëri.</translation>
<translation id="8983263343920390117">{COUNT,plural, =1{Organizata jote i fshin automatikisht të dhënat e shfletimit kur Agent Chrome nuk përdoret për 1 minutë. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}other{Organizata jote i fshin automatikisht të dhënat e shfletimit kur Agent Chrome nuk përdoret për # minuta. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}}</translation>
<translation id="2125838419757773031">Zgjidh rajonin e ekranit për të kërkuar</translation>
<translation id="2126108037660393668">Skedari i shkarkuar nuk u verifikua.</translation>
<translation id="2135919691573380097">Raportoje këtë sajt</translation>
<translation id="2137162749895930932">Mbyll ekranin e përkthimit</translation>
<translation id="822057692680289847">Agent Chrome e bllokoi këtë shkarkim sepse sajti nuk po përdor një lidhje të sigurt dhe mund të ketë pasur ndërhyrje te skedari</translation>
<translation id="2170098639895543546">Zgjidh çdo gjë në faqe</translation>
<translation id="2174178932569897599">Personalizo Chromium</translation>
<translation id="2174917724755363426">Instalimi nuk përfundoi. E konfirmon që dëshiron ta anulosh?</translation>
<translation id="922967513335788675">Agent Chrome - identifikimi në rrjet - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Gabim në kontrollin e përditësimeve: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Hiqe llogarinë nga Chromium</translation>
<translation id="2201788217099588893">Përdor aplikacionin e Chromium për të marrë veglat më të mira të blerjeve kur je në lëvizje</translation>
<translation id="2210502920229141283">Qëndro më i sigurt në lëvizje me "Shfletimin e sigurt të përmirësuar" në Chromium për iOS</translation>
<translation id="2210682093923538346">Sajt i rrezikshëm. Chromium ka hequr njoftimet.</translation>
<translation id="2236949375853147973">Aktiviteti im</translation>
<translation id="2238130810669087193">Për të marrë adresat etj. në të gjitha pajisjet e tua, identifikohu në Chromium. Kjo adresë do të ruhet në "Llogarinë tënde të Google" pasi të identifikohesh.</translation>
<translation id="2241627712206172106">Nëse e ndan një kompjuter, miqtë dhe familja mund të shfletojnë veçmas dhe ta konfigurojnë Chromium pikërisht ashtu si dëshirojnë.</translation>
<translation id="22571759390241347">"Aftësitë" në Chromium</translation>
<translation id="2283803047247799269">Kërko në këtë skedë me "Kërkimin e imazheve"</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Chromium rekomandon vendosjen në pauzë të skedës që ngadalëson shfletuesin}other{Chromium rekomandon vendosjen në pauzë të skedave që ngadalësojnë shfletuesin}}</translation>
<translation id="2307973900865360088">Mbaje në "Stacion"</translation>
<translation id="2313870531055795960">Kontrollon URL-të kundrejt një liste sajtesh të pasigurta të ruajtur në Chromium. Nëse një sajt përpiqet të vjedhë fjalëkalimin tënd ose kur shkarkon një skedar të dëmshëm, Chromium mund t'i dërgojë gjithashtu URL-të, duke përfshirë pjesë të përmbajtjes së faqes, te "Shfletimi i sigurt".</translation>
<translation id="2356070529366658676">Pyet</translation>
<translation id="2359808026110333948">Vazhdo</translation>
<translation id="2361918034042471035">Shtesa "<ph name="EXTENSION_NAME" />" kërkon që të identifikohesh në Chromium</translation>
<translation id="2028456545634496358">Çaktivizo ekzekutimin e Agent Chrome në sfond për aplikacionet</translation>
<translation id="2374216753258219393">Për ta përdorur këtë shtesë si <ph name="USER_EMAIL_ADDRESS" />, identifikohu në Chromium.</translation>
<translation id="2384373936468275798">ChromiumOS nuk mund t'i sinkronizonte të dhënat e tua sepse detajet e identifikimit të llogarisë janë të papërditësuara.</translation>
<translation id="3040857862310351495">{NUM_DEVICES,plural, =0{Një ose disa shtesa të Agent Chrome kanë pasur qasje në 1 pajisje HID}=1{Një ose disa shtesa të Agent Chrome kanë qasje në 1 pajisje HID}other{Një ose disa shtesa të Agent Chrome kanë qasje në # pajisje HID}}</translation>
<translation id="2401032172288869980">Chromium ka nevojë për lejet e kamerës dhe të mikrofonit për këtë sajt</translation>
<translation id="2403703063067034158">Gabim në nisje: aktualisht po ekzekutohet një shembull tjetër i konfigurimit; provo përsëri më vonë.</translation>
<translation id="2418322681019544463">Hap lidhjet në Chromium nga çdo aplikacion dhe mbaje shfletuesin të qasshëm në shiritin e detyrave</translation>
<translation id="2425157128016763890">Kliko te butoni "Përmblidh" për ta ndarë këtë dokument me Gemini në Chromium për të marrë një përmbledhje të shpejtë dhe për të bërë pyetje vijuese</translation>
<translation id="2440750600860946460">Me <ph name="BEGIN_LINK" />veglat nga Chromium<ph name="END_LINK" />, mund të shfletosh në mënyrë të sigurt dhe të qëndrosh në kontroll</translation>
<translation id="2449487342837813167"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Chromium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu fjalëkalimet etj. në të gjitha pajisjet e tua.</translation>
<translation id="2451727308784734061">Përdor shkurtoren tënde për të shkuar me shpejtësi te "Menaxheri i fjalëkalimeve". Mund ta zhvendosësh shkurtoren tënde tek ekrani bazë i kompjuterit ose te nisësi i aplikacionit.</translation>
<translation id="4405360797107732759">Agent Chrome do të mbyllet së shpejti</translation>
<translation id="1660473983484527105">Në Agent Chrome</translation>
<translation id="2485422356828889247">Çinstalo</translation>
<translation id="2513154137948333830">Nevojitet rindezja: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Zgjidh tekstin nga "Kërkimi nëpërmjet imazheve"</translation>
<translation id="2554739539410784893">Chromium po përpiqet të zëvendësojë fjalëkalimet ekzistuese. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="2560420686485554789">Chromium ka nevojë për qasje te hapësira ruajtëse për të shkarkuar skedarë</translation>
<translation id="8620990455069644819">Ndihmuesi i Agent Chrome</translation>
<translation id="2575822587468774919">Zgjidh çdo gjë për të kërkuar me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="2576118232315942160">Për të marrë fjalëkalimet etj. në të gjitha pajisjet e tua, identifikohu në Chromium</translation>
<translation id="2587622539943955767">Skano kodin QR me telefonin tënd për të shkarkuar Chromium dhe identifikohu në "Llogarinë tënde të Google".</translation>
<translation id="4496289616420025644">Vazhdo të përdorësh Agent Chrome</translation>
<translation id="259935314519650377">Instaluesi i shkarkuar nuk u ruajt te memoria specifike. Gabim: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistemi</translation>
<translation id="2629740064077610681">Organizata jote mund të shikojë dhe të menaxhojë të dhënat e shfletimit, si p.sh. faqeshënuesit, historikun dhe fjalëkalimet e tua. Ajo nuk mund të shikojë të dhënat e shfletimit në profilet e tjera të Chromium</translation>
<translation id="2635452620547538388">Verifiko që je ti për të përdorur dhe ruajtur të dhënat e Chromium në llogarinë tënde <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8944895445911901418">{COUNT,plural, =0{"Mbrojtja e përparuar" kërkon që të hapësh përsëri Agent Chrome për të zbatuar një përditësim}=1{"Mbrojtja e përparuar" kërkon që të hapësh përsëri Agent Chrome për të zbatuar një përditësim. Dritarja jote "e fshehtë" nuk do të rihapet.}other{"Mbrojtja e përparuar" kërkon që të hapësh përsëri Agent Chrome për të zbatuar një përditësim. # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="263863604136125912">Nis Chromium</translation>
<translation id="2648074677641340862">Ndodhi një gabim në sistemin operativ gjatë instalimit. Shkarko përsëri Chromium.</translation>
<translation id="2661879430930417727">Nëse e ndan një pajisje, miqtë dhe familja mund të shfletojnë veçmas dhe ta konfigurojnë Chromium pikërisht ashtu si dëshirojnë</translation>
<translation id="2676569452213089702">Qasu me lehtësi për të përdorur Gemini në Chromium në pajisjen tënde, edhe nëse Chromium është i minimizuar.</translation>
<translation id="3144164911846092828">Skeda Agent Chrome</translation>
<translation id="2718390899429598676">Për më shumë siguri, Chromium do t'i enkriptojë të dhënat e tua.</translation>
<translation id="2721354645805494590">Për ta hequr "Llogarinë tënde të Google" nga Chromium, dil nga llogaria</translation>
<translation id="2722636413143664436">Për të marrë fjalëkalimet, faqeshënuesit etj. në të gjitha pajisjet e tua, identifikohu në Chromium</translation>
<translation id="2738871930057338499">Lidhja me internetin nuk mund të kryhej. HTTP 403 (E ndaluar). Kontrollo konfigurimin e proxy-t.</translation>
<translation id="2753623023919742414">Kliko për të kërkuar</translation>
<translation id="2657110490709402112">Cakto Agent Chrome si shikuesin e parazgjedhur të skedarëve PDF</translation>
<translation id="4262158525170658092">Kjo shtesë përmban softuerë keqdashës dhe nuk është e sigurt. Hiqe atë nga Agent Chrome që të mos arrijë të shikojë dhe të ndryshojë më të dhënat e tua në sajtin që viziton ti, duke përfshirë informacionet e tua personale.</translation>
<translation id="2799223571221894425">Nis sërish</translation>
<translation id="4930235474290498361">Shfletuesi yt Agent Chrome</translation>
<translation id="2816462166102338036">Kërkoje këtë video me "Kërkimin e imazheve"</translation>
<translation id="282591729717417030">Zbulo produkte me kamerën tënde, monitoro uljet e çmimeve etj. kur je në lëvizje me Chromium në iOS.</translation>
<translation id="2841525013647267359">Përkthe nga</translation>
<translation id="2846251086934905009">Gabim gjatë instalimit: Instaluesi nuk përfundoi. Instalimi është ndërprerë.</translation>
<translation id="2847479871509788944">Hiqe nga Chromium...</translation>
<translation id="2850691299438350830">Të mban të sigurt në Chromium dhe mund të përdoret për të përmirësuar sigurinë tënde në aplikacionet e tjera të Google kur je i identifikuar</translation>
<translation id="2885378588091291677">Menaxheri i detyrave</translation>
<translation id="8454027198329266279">Rreth &amp;Agent Chrome</translation>
<translation id="2915996080311180594">Rinise më vonë</translation>
<translation id="2933336679234709858">Të dhënat e tua janë të enkriptuara me frazën tënde të kalimit. Fute atë për të përdorur dhe ruajtur të dhënat e Chromium në "Llogarinë tënde të Google".</translation>
<translation id="2945997411976714835">Gabim gjatë instalimit: Nisja e procesit të instaluesit dështoi.</translation>
<translation id="2948852018303413228">Identifikohu më shpejt në sajte duke përdorur fjalëkalimet e ruajtura për Chromium në iOS</translation>
<translation id="80325676287146281">Organizata jote menaxhon Agent Chrome</translation>
<translation id="789940813130504773">Agent Chrome është i përditësuar</translation>
<translation id="2977506796191543575">Nëse një sajt përpiqet të vjedhë fjalëkalimin tënd ose kur shkarkon një skedar të dëmshëm, Chromium mund t'i dërgojë gjithashtu URL-të, duke përfshirë pjesë të përmbajtjes së faqeve, te "Shfletimi i sigurt".</translation>
<translation id="2981563588585023386">Për të qëndruar më i sigurt online me zgjedhjet e prindit tënd, identifikohu në Chromium</translation>
<translation id="3003694935412297923">Të gjitha detyrat</translation>
<translation id="3012615494352020668">{count,plural, =1{Chromium duhet të verifikojë që je ti përpara se të mund të ruhen disa të dhëna në "Llogarinë tënde të Google" dhe të përdoren në të gjitha pajisjet e tua. Nëse del tani, këto të dhëna (1 artikull) do të fshihen.}other{Chromium duhet të verifikojë që je ti përpara se të mund të ruhen disa të dhëna në "Llogarinë tënde të Google" dhe të përdoren në të gjitha pajisjet e tua. Nëse del tani, këto të dhëna ({count} artikuj) do të fshihen.}}</translation>
<translation id="8084335581332031126">Hap <ph name="URL" /> në një skedë të re në Agent Chrome.</translation>
<translation id="302551344979399011">Novacionet e IA-së, si p.sh. aftësitë, ruhen në "Llogarinë tënde të Google" dhe menaxhohen veçmas nga sinkronizimi i Chromium</translation>
<translation id="7024173799494459794">Po shton në Agent Chrome...</translation>
<translation id="3038232873781883849">Në pritje të instalimit...</translation>
<translation id="3045032126857188731">Gjuha e përkthyer: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Mbyll dialogun e komenteve</translation>
<translation id="3068187312562070417">Profilet e tjera të Chromium</translation>
<translation id="3068290154869370196">Shtesat janë veçori shtesë që të lejojnë të personalizosh Chromium. Nga ruajtja e organizimit e deri te thjeshtimi i detyrave të përditshme, shtesat të ndihmojnë të personalizosh Chromium.</translation>
<translation id="7027973430362347863">Ndihmo në përmirësimin e Agent Chrome duke dërguar te Google raportet e ndërprerjeve aksidentale dhe <ph name="UMA_LINK" /></translation>
<translation id="3071024987058544609">Përdor aplikacionin e Chromium për të marrë sigurinë e Google në lëvizje</translation>
<translation id="4925327325707966890">{NUM_DEVICES,plural, =0{Një ose disa shtesa të Agent Chrome kanë pasur qasje në 1 pajisje USB}=1{Një ose disa shtesa të Agent Chrome kanë qasje në 1 pajisje USB}other{Një ose disa shtesa të Agent Chrome kanë qasje në # pajisje USB}}</translation>
<translation id="6827369771274328769">Historiku i Agent Chrome</translation>
<translation id="3103660991484857065">Instaluesi nuk arriti ta nxjerrë arkivin. Shkarko përsëri Chromium.</translation>
<translation id="310459126943037700">Përfundimi i detyrave dështoi.</translation>
<translation id="3104828284009500087">Kërko për çdo gjë në faqe</translation>
<translation id="3126784891977756556">Mbaji fjalëkalimet, faqeshënuesit dhe historikun të sinkronizuar në mënyrë të përsosur në pajisje. Qasu me lehtësi te veçoritë që njeh dhe që të pëlqejnë duke e përditësuar shfletuesin tënd të parazgjedhur në Chromium.</translation>
<translation id="2894555444497054373">Agent Chrome po përdor mikrofonin tënd.</translation>
<translation id="3130333203120345554">Kërkim i ri</translation>
<translation id="3137969841538672700">Zvarrit për të kërkuar</translation>
<translation id="3144188012276422546">Kjo skedë po përdor burime shtesë. Për të përmirësuar performancën tënde, lejo që Chromium ta bëjë atë joaktive.</translation>
<translation id="3092580151719004572">Për të ndarë ekranin, lejo regjistrimin e ekranit për Agent Chrome te "Cilësimet e sistemit"</translation>
<translation id="2314296667497715523">Rinis Agent Chrome</translation>
<translation id="3161522574479303604">Të gjitha gjuhët</translation>
<translation id="3179665906251668410">Hape lidhjen në një dritare të fshe&amp;htë të Chromium</translation>
<translation id="3185330573522821672">Personalizo profilin tënd të ri të Chromium</translation>
<translation id="3189205223539394158">Mund të vazhdosh të bisedosh me "Modalitetin e IA-së" pa ndërruar skedat. Për të filluar, identifikohu në Chromium. Do të marrësh gjithashtu fjalëkalimet dhe më shumë në të gjitha pajisjet e tua.</translation>
<translation id="3224847870593914902">Për ta hequr "Llogarinë tënde të Google" nga Chromium, dil nga llogaria në Chromium te faqja e "Cilësimeve"</translation>
<translation id="3234316605225071811">Më vonë, Chromium mund të të pyesë nëse dëshiron të përdorësh informacionet e ruajtura për të plotësuar automatikisht formularët për ty</translation>
<translation id="5982289753835865194">Agent Chrome nuk mund të lexojë dhe shkruajë në direktorinë e tij të të dhënave:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">Merr veglat e tua të preferuara të IA-së së Google kur je në lëvizje me Chromium në iOS.</translation>
<translation id="3286538390144397061">Rindiz tani</translation>
<translation id="3920105041734426863">Çelësat API të Google mungojnë. Disa funksione të Agent Chrome do të çaktivizohen.</translation>
<translation id="5621884903587730053">Vazhdo funksionimin e aplikacioneve në sfond kur Agent Chrome është i mbyllur</translation>
<translation id="3313189106987092621">Chromium do të të paralajmërojë para se të ngarkojë një sajt duke përdorur një lidhje të pasigurt</translation>
<translation id="3316771292331273802">Do të dalësh nga shumica e sajteve kur të mbyllësh të gjitha dritaret e Chromium, përveçse nga "Llogaria jote e Google" nëse je i identifikuar në Chromium. Për t'i lejuar sajtet që të të kujtojnë, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">këndi lart djathtas i zonës së kërkimit: djathtas <ph name="RIGHT" />%, lart<ph name="TOP" />%</translation>
<translation id="3366305173356742781">Të dhënat e Chromium në llogarinë tënde</translation>
<translation id="3375770072980084583">Përdor fjalëkalimet e tua me Chromium në telefonin tënd</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3406848076815591792">Të kalohet te profili ekzistues i Chromium?</translation>
<translation id="3412460710772753638">Në "Menaxherin e fjalëkalimeve" në këtë pajisje</translation>
<translation id="3438772217992559640">Kërkoje këtë skedë me "Kërkimin e imazheve"</translation>
<translation id="3455907671758333080">Zgjero "Shfletimin e sigurt të përmirësuar" me Chromium në telefonin tënd</translation>
<translation id="3461644266919055473">Chromium po personalizohet...</translation>
<translation id="3474745554856756813">Kjo do të fshijë <ph name="ITEMS_COUNT" /> artikuj nga kjo pajisje. Për t'i marrë më vonë të dhënat, identifikohu te Chromium si <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> mund të kalojë nga një profil i Chromium te një tjetër</translation>
<translation id="3509308970982693815">Mbyll të gjitha dritaret e Chromium dhe provo sërish.</translation>
<translation id="4449744684308538611">Për të ndarë dritaren tënde, lejo regjistrimin e ekranit për Agent Chrome te "Cilësimet e sistemit"</translation>
<translation id="3530103706039034513"><ph name="EXISTING_USER" /> është i identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Chromium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3531741627422851418">Kodi QR për të shkarkuar shfletuesin Chromium në pajisjet celulare</translation>
<translation id="354621070532799440">Rikujtesë: Veçoritë më të mira të sigurisë të Google në xhepin tënd</translation>
<translation id="4902762267468919597">Për të ndarë ekranin, lejo regjistrimin e ekranit për Agent Chrome te "Cilësimet e sistemit".</translation>
<translation id="4199561934263811659">Mbrojtja e përmirësuar e çaktivizon optimizimin e JavaScript për sajtet që Agent Chrome nuk i njeh</translation>
<translation id="3597003331831379823">Ekzekutimi i konfigurimit me privilegje të larta dështoi. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">Identifikohu në Chromium</translation>
<translation id="3639635944603682591">Të dhënat e shfletimit të këtij personi do të fshihen nga kjo pajisje. Për të rikuperuar të dhënat, identifikohu në Chromium si <ph name="USER_EMAIL" />.</translation>
<translation id="7335807248512894660">{COUNT,plural, =0{Ka një përditësim të ri për Agent Chrome dhe do të zbatohet sapo ta rinisësh.}=1{Ka një përditësim të ri për Agent Chrome dhe do të zbatohet sapo ta rinisësh. Dritarja jote "e fshehtë" nuk do të rihapet.}other{Ka një përditësim të ri për Agent Chrome dhe do të zbatohet sapo ta rinisësh. # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="3667616615096815454">Instalimi nuk mund të kryhej. Aplikacioni është i panjohur për serverin.</translation>
<translation id="3675854891107786059">Përdor <ph name="BEGIN_LINK" />frazën tënde të kalimit<ph name="END_LINK" /> për të enkriptuar të gjitha të dhënat e Chromium në "Llogarinë tënde të Google". Mënyrat e pagesës dhe adresat nga Google Pay nuk do të enkriptohen. Historiku i shfletimit nga Chromium nuk do të sinkronizohet.</translation>
<translation id="3697825383460320042">{COUNT,plural, =0{Administratori yt kërkon që të hapësh përsëri Agent Chrome për të zbatuar këtë përditësim}=1{Administratori yt kërkon që të hapësh përsëri Agent Chrome për të zbatuar këtë përditësim Dritarja jote "e fshehtë" nuk do të rihapet.}other{Administratori yt kërkon që të hapësh përsëri Agent Chrome për të zbatuar këtë përditësim # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="7584080815951640016">Hape lidhjen në një &amp;skedë të re të Agent Chrome</translation>
<translation id="3728124580182886854">Lidh Chromium dhe shërbimet e tjera të Google për personalizimin dhe qëllime të tjera</translation>
<translation id="3729187154190517324">Thelloje kërkimin duke shtuar disa skeda, skedarë dhe vegla duke përdorur butonin "Shto një skedë dhe më shumë".</translation>
<translation id="3788675262216168505">Menaxho profilet e Chromium</translation>
<translation id="9153620230534680918">Mëso se pse Agent Chrome i bllokon disa shkarkime</translation>
<translation id="379589255253486813">Chromium do të të informojë nëse duhet të rishikosh diçka</translation>
<translation id="4835254782629421085">Agent Chrome ngarkon paraprakisht faqet që mund t'i vizitosh që ato të ngarkohen më shpejt kur t'i vizitosh</translation>
<translation id="3810973564298564668">Menaxho</translation>
<translation id="3823384748599722168">Për të përdorur fjalëkalimet e ruajtura, ndiq kodin QR, shkarko Chromium për iOS dhe identifikohu në "Llogarinë tënde të Google"</translation>
<translation id="3846683726093018685">**Përmblidh:** Në një fjali të vetme deri në 30 fjalë, përshkruaj subjektin kryesor dhe qëllimin e përmbajtjes në pamjen e ekranit.

          **Sugjero pyetje:** Gjenero një listë me pika prej 3 deri në 5 pyetje që nxisin të menduarit dhe që mund të bëhen nga një përdorues për të kuptuar më mirë pamjen e ekranit. Këto pyetje duhet të përfshijnë të paktën një pyetje që ka të bëjë në mënyrë specifike me një objekt vizual, dizajnin ose vendosjen e tij.</translation>
<translation id="5151092236561494204"><ph name="PAGE_TITLE" /> - Agent Chrome</translation>
<translation id="387514319934708384">Chromium ka nevojë për lejen e rrjetit lokal për këtë sajt</translation>
<translation id="3885770153807205175">Zgjedhësi i gjuhës</translation>
<translation id="8310546736680726676">Personalizo dhe kontrollo Agent Chrome. Diçka ka nevojë për vëmendjen tënde - kliko për detaje.</translation>
<translation id="3889543394854987837">Kliko emrin tënd për të hapur Chromium dhe fillo shfletimin.</translation>
<translation id="3892148308691398805">Kopjo tekstin</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> është i identifikuar tashmë në këtë profil të Chromium. Për ta mbajtur shfletimin tënd të ndarë, Chromium mund të krijojë profilin tënd personal për ty.</translation>
<translation id="334040592769172771">Kjo shtesë shkel politikën e "Dyqanit të uebit të Chrome" dhe mund të mos jetë e sigurt. Hiqe atë nga Agent Chrome që të mos arrijë të shikojë dhe të ndryshojë më të dhënat e tua në sajtin që viziton ti, duke përfshirë informacionet e tua personale.</translation>
<translation id="3941890832296813527">Gabim gjatë instalimit: Emri i skedarit të instaluesit është i pavlefshëm ose nuk mbështetet.</translation>
<translation id="3945058413678539331">Chromium po përpiqet të kopjojë fjalëkalimet. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="3954172517175569325">Fjalëkalimet e tua, mënyrat e pagesës dhe adresat që ke ruajtur në "Llogarinë tënde të Google" do të hiqen nga kjo pajisje. Për t'i përdorur përsëri në Chromium, identifikohu përsëri.</translation>
<translation id="395904275706073188">Faqet e mbrojtura nuk mund të lexohen. Provo një faqe tjetër.</translation>
<translation id="3962647064319009959">Mëso se si të mban të sigurt Chromium</translation>
<translation id="3967822245660637423">Shkarkimi përfundoi</translation>
<translation id="6274881217831291926">Kur shkruan në shiritin e adresave ose kutinë e kërkimit, Agent Chrome i dërgon ato që ti shkruan te veglat e kërkimit, IA-së dhe agjentit të organizatës sate për të marrë sugjerime.</translation>
<translation id="3975724895399328945">Rreth &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">Rreth ChromiumOS</translation>
<translation id="8089050973791989914">Kur ti viziton një sajt, Agent Chrome dërgon një pjesë të pakuptueshme të URL-së te <ph name="BEGIN_LINK" />"Shfletimi i sigurt" i Google<ph name="END_LINK" /> nëpërmjet një serveri të privatësisë që e fsheh adresën tënde IP. Nëse një sajt bën diçka të dyshimtë, dërgohen edhe URL-të e plota dhe pjesët e përmbajtjeve të faqeve.</translation>
<translation id="4016217212818346953">Qëndro i sigurt me "Menaxherin e fjalëkalimeve"</translation>
<translation id="4019629340646866719">ChromiumOS mundësohet nga <ph name="BEGIN_LINK_CROS_OSS" />softuerë shtesë me burim të hapur<ph name="END_LINK_CROS_OSS" />, si p.sh. <ph name="BEGIN_LINK_LINUX_OSS" />mjedisi i zhvillimit të Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Përkthe ekranin</translation>
<translation id="4023601594785368013">Gjuha origjinale: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Hap lidhjet në Chromium nga çdo aplikacion. Dhe për qasje të lehtë, ai gozhdohet te shiriti yt i veglave.</translation>
<translation id="2466379549068383575">Ndihmo në përmirësimin e Agent Chrome duke raportuar <ph name="BEGIN_LINK" />cilësimet aktuale<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Përmirësime të rëndësishme sigurie dhe funksione të reja ofrohen në versionin e fundit.</translation>
<translation id="4055805654398742145">Men&amp;axheri i fjalëkalimeve</translation>
<translation id="409373329602981607">{COUNT,plural, =1{Organizata jote e mbyll automatikisht Agent Chrome kur ai nuk përdoret për 1 minutë. Të dhënat e shfletimit do të fshihen. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet.}other{Organizata jote e mbyll automatikisht Agent Chrome kur ai nuk përdoret për # minuta. Të dhënat e shfletimit do të fshihen. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet.}}</translation>
<translation id="4118474109249235144">Modaliteti "i fshehtë" i Chromium</translation>
<translation id="4122186850977583290">Shko te faqja "Rreth Chromium"</translation>
<translation id="4135244987012252068">Personalizo Chromium për t'i dhënë një pamje të re shfletuesit tënd</translation>
<translation id="4147856324248078748">Personalizo Chromium</translation>
<translation id="4148957013307229264">Po instalohet...</translation>
<translation id="2058774528396152893"><ph name="PAGE_TITLE" /> - identifikimi në rrjet - Agent Chrome</translation>
<translation id="7685529984676330289">Zbulo aplikacione, lojëra, shtesa dhe tema të mrekullueshme për Agent Chrome.</translation>
<translation id="4217080900579554343">Për të marrë këtë shtesë dhe më shumë në të gjithë kompjuterët e tu, identifikohu në Chromium</translation>
<translation id="4217972271355023382">Për të qëndruar më i sigurt online me zgjedhjet e prindit tënd, kalo te profili yt i Chromium ku je i identifikuar tashmë si <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Po e anulon...</translation>
<translation id="4224210481850767180">Instalimi është anuluar.</translation>
<translation id="4230135487732243613">Të lidhen të dhënat e tua të Chromium me këtë llogari?</translation>
<translation id="274377438883177878">Të paralajmëron për sajtet e rrezikshme, edhe ato që Google nuk i ka njohur më parë, duke analizuar më shumë të dhëna nga sajtet sesa nga mbrojtja standarde. Mund të zgjedhësh që t'i kapërcesh paralajmërimet e Agent Chrome.</translation>
<translation id="4269093074552541569">Dil nga Chromium</translation>
<translation id="8361584154950824008">Merr ndihmë me Agent Chrome</translation>
<translation id="4281844954008187215">Kushtet e shërbimit</translation>
<translation id="4285930937574705105">Instalimi dështoi për shkak të një gabimi të paspecifikuar. Nëse Chromium është aktualisht në ekzekutim, mbylle dhe provo përsëri.</translation>
<translation id="4298125729853015961">Eksporto fjalëkalimet nga Chromium</translation>
<translation id="4304713468139749426">Menaxheri i fjalëkalimeve</translation>
<translation id="4334241893986177674">Kërko në këtë pamje ekrani</translation>
<translation id="4368547723231502008">Kërko dhe bëj pyetje nga kudo, edhe nëse Chromium është minimizuar</translation>
<translation id="1172096072757635810">Nis Agent Chrome kur të niset Windows</translation>
<translation id="4400772909124543403">Nuk ofrohet asnjë përditësim</translation>
<translation id="8069611125329654712">Dëshiron të dalësh nga Agent Chrome gjithsesi?</translation>
<translation id="4413205837991854510">Shfaq gjithmonë shkurtoren e "Kërkimit nëpërmjet imazheve"</translation>
<translation id="3727041326435831325">Lejo që Agent Chrome të ekzekutohet në sfond</translation>
<translation id="1713490836766202786">{NUM_EXTENSIONS,plural, =1{Agent Chrome rekomandon që ta heqësh atë. <ph name="BEGIN_LINK" />Mëso më shumë rreth shtesave të mbështetura<ph name="END_LINK" />}other{Agent Chrome rekomandon që t'i heqësh ato. <ph name="BEGIN_LINK" />Mëso më shumë rreth shtesave të mbështetura<ph name="END_LINK" />}}</translation>
<translation id="7567010943765939594">Personalizo dhe kontrollo Agent Chrome</translation>
<translation id="4427306783828095590">Mbrojtja e përmirësuar bën edhe më shumë për bllokimin e mashtrimeve dhe softuerëve keqdashës</translation>
<translation id="4434353761996769206">Gabim i instaluesit: <ph name="INSTALLER_ERROR" /></translation>
<translation id="7498286168885369820"><ph name="MANAGER" /> menaxhon Agent Chrome</translation>
<translation id="444069871276811466">Shto profilin e Chromium</translation>
<translation id="4447409407328223819">Rreth Chrome for Testing</translation>
<translation id="4470974262661801543">Për të përdorur dhe për të ruajtur të dhënat e Chromium në "Llogarinë tënde të Google", fut frazën tënde të kalimit</translation>
<translation id="4493028449971051158">Gabim në nisje: ekzekuto instaluesin si administrator.</translation>
<translation id="4501471624619070934">Instalimi nuk u krye sepse qasja është e kufizuar në këtë shtet.</translation>
<translation id="4615766574627629942">Kjo shtesë nuk i ka publikuar praktikat e privatësisë, si p.sh. se si i mbledh dhe i përdor të dhënat. Agent Chrome rekomandon që ta heqësh atë.</translation>
<translation id="452711251841752011">Mirë se erdhe në Chromium. U hap një dritare e re e shfletuesit</translation>
<translation id="4531137820806573936">Chromium ka nevojë për leje për të krijuar një hartë të ambientit rrethues dhe për të ndjekur duart e tua</translation>
<translation id="4536805923587466102">Je i identifikuar tashmë si <ph name="USER_EMAIL_ADDRESS" /> në një profil tjetër të Chromium</translation>
<translation id="5945053225725114995">Agent Chrome i ngarkon paraprakisht faqet, gjë që e bën më të shpejtë shfletimin dhe kërkimin. <ph name="BEGIN_LINK" />Mëso më shumë për ngarkimin paraprak të faqeve<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Përmirëso sigurinë online për të gjithë kur raporton një sajt që mendon se është i dëmshëm.</translation>
<translation id="2899198307620821227">Agent Chrome e bllokoi këtë shkarkim sepse ke çaktivizuar "Shfletimin e sigurt" dhe skedari nuk mund të verifikohet</translation>
<translation id="4583692638088316420">Provo "Lenten e Google" me Chromium në telefonin tënd</translation>
<translation id="4594305310729380060">Te "Menaxheri i Fjalëkalimeve" në këtë pajisje</translation>
<translation id="6944119370969619446">Aplikacionet Agent Chrome</translation>
<translation id="4598116752460667024">Kërko për çdo proces nga lista.</translation>
<translation id="4613863813562375431">Versioni i ChromiumOS</translation>
<translation id="6401103202303237090">Pothuajse i përditësuar! Hape përsëri Agent Chrome për të përfunduar përditësimin.</translation>
<translation id="4807663225386362301">Shpejton sajtet me motorin V8 të Agent Chrome, por e bën Agent Chrome disi më pak rezistent ndaj sulmeve</translation>
<translation id="4626321472657185181">Hap kërkimin me Chromium</translation>
<translation id="521912697020157864">Paralajmërim: Agent Chrome nuk mund të parandalojë regjistrimin e historikut të shfletimit nga shtesat. Për të çaktivizuar këtë shtesë në modalitetin "e fshehtë", anulo zgjedhjen e këtij opsioni.</translation>
<translation id="4673151026126227699">Nëse ndan edhe raportet e përdorimit të Chromium, ato raporte përfshijnë URL-të që ti viziton</translation>
<translation id="4673710618874938871">Identifikuar si <ph name="USER_NAME" />, anëtarësim. Hap menynë e llogarisë</translation>
<translation id="5833534934470627293">Profili duket të jetë në përdorim nga një tjetër proces i Agent Chrome (<ph name="PROCESS_ID" />) në një tjetër kompjuter (<ph name="HOST_NAME" />). Agent Chrome ka kyçur profilin që të mos dëmtohet. Nëse je i sigurt që asnjë proces tjetër nuk po e përdor këtë profil, mund të shkyçësh profilin dhe ta nisësh sërish Agent Chrome.</translation>
<translation id="4680828127924988555">Anulo instalimin</translation>
<translation id="469259825538636168">Disa nga të dhënat e tua të Chromium nuk janë ruajtur ende në "Llogarinë tënde të Google". Provo të presësh për disa minuta para se të dalësh nga ajo. Nëse del tani, këto të dhëna do të fshihen.</translation>
<translation id="4708193446201257833">Kur je i identifikuar, mund të përdorësh fjalëkalimet dhe më shumë nga "Llogaria jote e Google" në Chromium. <ph name="SHORTCUT" /> mund të ndryshojë cilësimet e shërbimeve të tua të Google.</translation>
<translation id="4708774505295300557">Dikush është identifikuar më parë në Chromium në këtë kompjuter si <ph name="ACCOUNT_EMAIL_LAST" />. Krijo një përdorues të ri të Chromium për t'i mbajtur të ndara informacionet e tua.</translation>
<translation id="4724676981607797757">Instalimi dështoi për shkak të një gabimi të protokollit të pambështetur.</translation>
<translation id="2783410850122241193">Dëshiron ta mbyllësh Agent Chrome gjithsesi?</translation>
<translation id="4748217263233248895">Sapo është zbatuar një përditësim special i sigurisë për Chromium. Rinise tani dhe do të restaurojmë skedat e tua.</translation>
<translation id="4771701986670315895">Nuk ke vizituar së fundi. Chromium ka hequr lejen "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />" dhe <ph name="COUNT" /> më shumë.</translation>
<translation id="4786083865378785874">Nëse Gemini në Chromium është i hapur, paneli anësor qëndron i hapur kur krijohen skeda të reja</translation>
<translation id="479167709087336770">Kjo përdor të njëjtin kontrollues drejtshkrimor që përdoret në kërkimin e Google. Teksti që shkruan në shfletues dërgohet te Google. Mund ta ndryshosh këtë sjellje gjithmonë te cilësimet.</translation>
<translation id="4814736265800133385">Përdor Chromium pa pasur llogari</translation>
<translation id="4888717733111232871">Rregulli hyrës për Chromium për të lejuar trafikun mDNS.</translation>
<translation id="5600814355607573136">Nise përsëri për të përditësuar &amp;Agent Chrome</translation>
<translation id="4918086044614829423">Prano</translation>
<translation id="4918844574251943176">Imazhi u kopjua</translation>
<translation id="4943838377383847465">Chromium është në modalitetin e sfondit.</translation>
<translation id="494490797786467921">Kliko për të mbyllur dialogun e identifikimit në Chromium</translation>
<translation id="4950660488495335294">Me profilet e Chromium, mund t'i ndash të gjitha gjërat e tua të Chromium. Krijo profile për miqtë dhe familjen ose ndaje punën nga argëtimi.</translation>
<translation id="4987820182225656817">Vizitorët mund të përdorin Chromium pa lënë asgjë prapa.</translation>
<translation id="4992938037305302429">Llogaria jote në Chromium</translation>
<translation id="4994636714258228724">Shtoje veten te Chromium</translation>
<translation id="504699503110800016">Hap menynë e tejkalimit</translation>
<translation id="5074496654342756568">Qasu te të gjitha të preferuarat e tua të Google me Chromium në <ph name="DEVICE_TYPE" /></translation>
<translation id="5123973130450702873">Chromium ka nevojë për leje për të gjurmuar duart e tua</translation>
<translation id="5141988424377517949">Nuk ke vizituar së fundi. Chromium ka hequr lejen "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />", "<ph name="PERMISSION_3" />".</translation>
<translation id="5174969993834422967">Ti i bllokon zakonisht njoftimet. Për ta lejuar këtë sajt që të të njoftojë, kliko tek ikona e njoftimit në këndin e djathtë të shiritit të vendndodhjes.</translation>
<translation id="5174983315706567306">Nuk ka hapësirë të mjaftueshme në disk.</translation>
<translation id="5187123684706427865">Llogaria e Chromium kërkon rivërtetim</translation>
<translation id="5223510345050543907">Vazhdo pikërisht aty ku e ke lënë me Chromium në iOS.</translation>
<translation id="5231355151045086930">Dil nga Chromium</translation>
<translation id="5234764350956374838">Hiq</translation>
<translation id="5249261924633168472">Hape lidhjen në një dritare të fshe&amp;htë të Chromium</translation>
<translation id="5276305953263010518">Merr aplikacionin e Chromium për t'i ruajtur fjalëkalimet kur je në lëvizje</translation>
<translation id="1601187459465935178">Për të zbatuar ndryshimet, rinis Agent Chrome</translation>
<translation id="5286907366254680517">Zbuluar</translation>
<translation id="5289287148052354622">Merr aplikacionin e Chromium</translation>
<translation id="5294316920224716406">Kur shfleton në "Modalitetin 'e fshehtë'", Chromium do të të paralajmërojë para se të ngarkojë një sajt duke përdorur një lidhje të pasigurt</translation>
<translation id="5296581118566748922">Kërko me Chromium</translation>
<translation id="5313228254328109263">Chromium Updater Internal Service</translation>
<translation id="5324450571874973775">Përdori ato bashkë me veçoritë e tjera të Gemini në Chromium</translation>
<translation id="5346389065299425353">Thelloje kërkimin duke shtuar disa skeda, skedarë dhe vegla</translation>
<translation id="5348677704241861105">Merr një përmbledhje të shpejtë të këtij dokumenti dhe bëj pyetje me Gemini në Chromium</translation>
<translation id="5352264705793813212">Chromium gjeti disa rekomandime për sigurinë për t'u rishikuar nga ti</translation>
<translation id="5352361688875342522">Profilet e tjera të Chromium</translation>
<translation id="535243042947607642">ChromiumOS nuk mund t'i ruante të dhënat e Chromium në "Llogarinë tënde të Google" sepse detajet e identifikimit të llogarisë janë të papërditësuara</translation>
<translation id="5358375970380395591">Po identifikohesh me një llogari të menaxhuar dhe po i jep administratorit të saj kontroll mbi profilin tënd të Chromium. Të dhënat e tua të Chromium, siç janë aplikacionet, faqeshënuesit, fjalëkalimet dhe cilësime të tjera do të lidhen në mënyrë të përhershme me <ph name="USER_NAME" />. Ti do të jesh në gjendje t'i fshish këto të dhëna përmes Panelit të llogarive të Google, por nuk do të jesh në gjendje t'i shoqërosh këto të dhëna me një llogari tjetër. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Kodi shtesë: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Për të marrë personalizimin, përfshi Chromium në "Aktivitetin e uebit dhe të aplikacioneve"</translation>
<translation id="5382964351116519680">Hap kërkimin me Chromium</translation>
<translation id="2524054769026663683">Mëso se pse Agent Chrome i bllokon disa skedarë</translation>
<translation id="8615009965479156445">Po përditëson Agent Chrome (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Lejo identifikimin në Chromium</translation>
<translation id="6256236118124872626">Hiq nga Agent Chrome</translation>
<translation id="5774731921051444461">Zvogëlon performancën, por e bën Agent Chrome më rezistent ndaj sulmeve</translation>
<translation id="5427571867875391349">Caktoje Chromium si shfletuesin tënd të parazgjedhur</translation>
<translation id="8709870882148322247"><ph name="PAGE_TITLE" /> - Agent Chrome Beta</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Chromium rekomandon vendosjen në pauzë të skedës që ngadalëson shfletuesin}other{Chromium rekomandon vendosjen në pauzë të skedave që ngadalësojnë shfletuesin}}</translation>
<translation id="3217425685577630218">Agent Chrome mund të mos funksionojë si duhet sepse nuk mbështetet më në këtë version të Linux</translation>
<translation id="1045655099853558439">Agent Chrome e bllokoi këtë shkarkim sepse skedari mund të dëmtojë llogaritë e tua personale dhe të rrjeteve sociale</translation>
<translation id="549669000822060376">Prit ndërsa Chromium instalon përditësimet më të fundit të sistemit.</translation>
<translation id="5496810170689441661">Chromium po përpiqet t'i modifikojë fjalëkalimet. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="549975168243349205">Puno pa ndërprerje me aplikacionet e tua të preferuara si "Disku i Google" dhe YouTube kur je në lëvizje me Chromium.</translation>
<translation id="5524890928877629608">këndi lart majtas i zonës së kërkimit: majtas <ph name="LEFT" />%, lart <ph name="TOP" />%</translation>
<translation id="565863787292824328">Hap PDF-të në Agent Chrome</translation>
<translation id="5536164441519929134">Pyet<ph name="LINE_BREAK" />për këtë skedë</translation>
<translation id="8869089999448782168">Për arsye sigurie, Agent Chrome e çaktivizon optimizimin e JavaScript kur ti viziton një sajt për herë të parë.

Nëse kjo faqe nuk funksionon siç pritet, provo të lejosh optimizimin.</translation>
<translation id="5575874067957905201">Shfaq Gemini në Chromium në shiritin e menysë së Mac dhe aktivizo shkurtoren e tastierës</translation>
<translation id="5576587363991567745"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Chromium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu informacionet e tua të ruajtura etj. nga <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Gabim në nisje: ekzekuto instaluesin si përdorues i rregullt, jo si administrator.</translation>
<translation id="5580770360767802657">Përdor Chromium si parazgjedhje dhe gozhdoje</translation>
<translation id="5596627076506792578">Më shumë opsione</translation>
<translation id="5605834417512968703">Zgjidh çdo gjë për të kërkuar me "Kërkimin nëpërmjet imazheve" ose shtyp tastin "Escape" për të dalë nga "Kërkimi nëpërmjet imazheve"</translation>
<translation id="5618818588972826921">Zgjidh një tekst ose imazh çfarëdo për të kërkuar me "Kërkimin i imazheve" ose shtyp tastin "Escape" për të dalë nga "Kërkimi i imazheve"</translation>
<translation id="4814380868372526025">{0,plural, =0{Ofrohet një përditësim i Agent Chrome}=1{Ofrohet një përditësim i Agent Chrome}other{Një përditësim i Agent Chrome ofrohet prej # ditësh}}</translation>
<translation id="188722644954983559">Fshi gjithmonë të dhënat e sajteve nga pajisja jote kur të mbyllësh Agent Chrome</translation>
<translation id="5653831366781983928">Rinise Chromium tani</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="1525044488102751845">Shfaqe Agent Chrome në këtë gjuhë</translation>
<translation id="569897634095159764">Lidhja me internetin nuk mund të kryhej. Serveri proxy kërkon vërtetim.</translation>
<translation id="7750959567789509941">Agent Chrome liron memorien nga skedat joaktive. Kjo u jep më shumë burime kompjuterike skedave aktive dhe aplikacioneve të tjera dhe bën që Agent Chrome të jetë i shpejtë. Skedat e tua joaktive bëhen përsëri aktive në mënyrë automatike kur kthehesh tek ato. <ph name="BEGIN_LINK" />Mëso më shumë për "Kursyesin e memories"<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">Nëse ke harruar frazën tënde të kalimit apo dëshiron ta ndryshosh këtë cilësim, <ph name="SETTINGS_LINK" /> të dhënat e Chromium në llogarinë tënde</translation>
<translation id="5800158606660203929">Personalizo dhe kontrollo Chromium. Cakto Chromium si parazgjedhje.</translation>
<translation id="5802618941556161431">Mbaji fjalëkalimet, faqeshënuesit dhe historikun të sinkronizuar në mënyrë të përsosur në pajisje duke caktuar Chromium si shfletuesin tënd të parazgjedhur.</translation>
<translation id="5809516625706423866">Lidhja me internetin nuk mund të kryhej. HTTP 401 (E paautorizuar). Kontrollo konfigurimin e proxy-t.</translation>
<translation id="2755468387099310604">Shpejton sajtet me motorin V8 të Agent Chrome, por e bën Agent Chrome disi më pak rezistent ndaj sulmeve. Ky cilësim është joaktiv.</translation>
<translation id="5821520528363214608">Për të përdorur dhe ruajtur të dhënat e Chromium te "Llogaria jote e Google", përditëso Chromium</translation>
<translation id="5824893331272123205">Ky panel nuk mund të ngarkohej. Provo përsëri</translation>
<translation id="8972968824660717915">Mirë se vjen në Agent Chrome</translation>
<translation id="8898055105597601099">Aktivizon veçori shtesë për të ofruar mbrojtjet më të forta të Agent Chrome</translation>
<translation id="5871205389137001634">Kliko për të dalë nga "Kërkimi nëpërmjet imazheve"</translation>
<translation id="9158119422063615519">Agent Chrome vuri re se këta artikuj përmbajnë softuer keqdashës:</translation>
<translation id="5889361821821684993">Chromium kontrollon rregullisht për t'u siguruar që shfletuesi yt ka cilësimet më të sigurta. Do të të informojmë nëse ka nevojë të rishikosh diçka.</translation>
<translation id="5895138241574237353">Rinis</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - identifikimi në rrjet</translation>
<translation id="5924017743176219022">Po lidhet me internetin...</translation>
<translation id="5939553720811388432">Le ta bëjmë gati Chromium</translation>
<translation id="5941711191222866238">Minimizo</translation>
<translation id="5949225980829865667">Për të marrë këtë faqeshënues dhe më shumë në të gjitha pajisjet e tua, identifikohu në Chromium</translation>
<translation id="5953657885167112863">Personalizo Chromium sipas dëshirës</translation>
<translation id="5960071705175224773">Cilësimet e tua u ndryshuan nga një aplikacion i panjohur</translation>
<translation id="5977420883993828287">Gozhduar! Përdor përsëri "Detyrat kontekstuale" nga shiriti i veglave</translation>
<translation id="1956376169666014494">{COUNT,plural, =1{Organizata jote e mbyll automatikisht Agent Chrome kur ai nuk përdoret për 1 minutë.}other{Organizata jote e mbyll automatikisht Agent Chrome kur ai nuk përdoret për # minuta.}}</translation>
<translation id="5987687638152509985">Përditëso Chromium për të nisur sinkronizimin</translation>
<translation id="5990360079535151574">Nga butoni "Detyrat kontekstuale" në shiritin e veglave, mund t'i rihapësh "Detyrat kontekstuale" për të bërë pyetje ndërkohë që shfleton</translation>
<translation id="6003112304606738118">Po shkarkohet... Kanë mbetur edhe <ph name="HOURS" /> orë</translation>
<translation id="6009821354356307391">Kërko një përgjigje vijuese</translation>
<translation id="6040143037577758943">Mbyll</translation>
<translation id="6044357424127037044">Përfito më shumë nga blerjet online kur përdor aplikacionin e Chromium në <ph name="DEVICE_TYPE" /></translation>
<translation id="6058380562449900225">Për të mbrojtur të dhënat e tua, lejo që Chromium të heqë lejet nga sajtet që nuk i ke vizituar së fundi. Kjo nuk i ndalon njoftimet.</translation>
<translation id="6063093106622310249">&amp;Hape në Chromium</translation>
<translation id="6069027071882229820">Kopjo si imazh</translation>
<translation id="8654038583091834120"><ph name="EXTENSION_NAME" /> është shtuar te Agent Chrome</translation>
<translation id="8940723094351907049">Personalizo dhe kontrollo Agent Chrome. Ofrohet përditësim.</translation>
<translation id="334648248941185659">Aktive • Agent Chrome nuk mund të verifikojë se nga vjen kjo shtesë</translation>
<translation id="611228897408671387">Llogaria jote në Chromium</translation>
<translation id="1961808482688487456">Lejo që shtesat të shfaqin kërkesat për qasje në shiritin e veglave të Agent Chrome</translation>
<translation id="6880945371922378763"><ph name="FILE_NAME" /> është i rrezikshëm, prandaj Agent Chrome e ka bllokuar.</translation>
<translation id="829957199361894387">Agent Chrome do të mbyllet dhe do t'i fshijë të dhënat së shpejti</translation>
<translation id="6145820983052037069">Këtu mund të kalosh nga një profil i Chromium te një tjetër</translation>
<translation id="8333733115616087710">Nëse lejon kukit, Agent Chrome mund t'i përdorë ato gjatë ngarkimit paraprak</translation>
<translation id="6165508094623778733">Mëso më shumë</translation>
<translation id="6173308241973263798">Pastro të dhënat e Chromium në llogarinë tënde</translation>
<translation id="8439223334931595792">Ky skedar mund të jetë i rrezikshëm<ph name="LINE_BREAK" />Agent Chrome mund ta kontrollojë këtë shkarkim për ty nëse ti jep fjalëkalimin. Informacionet për skedarin dërgohen te "Shfletimi i sigurt i Google", por përmbajtjet dhe fjalëkalimi i skedarit qëndrojnë në pajisjen tënde.</translation>
<translation id="6182736845697986886">Instalimi dështoi për shkak të një gabimi të brendshëm të serverit të përditësimit.</translation>
<translation id="6183079672144801177">Sigurohu që të jesh i identifikuar në Chromium në pajisjen tënde <ph name="TARGET_DEVICE_NAME" /> dhe më pas provo ta dërgosh përsëri.</translation>
<translation id="6212496753309875659">Ky kompjuter e ka tashmë një version më të ri të Chromium. Nëse softueri nuk punon, çinstaloje Chromium dhe provo përsëri.</translation>
<translation id="6375381612105819561">{0,plural, =0{Agent Chrome do të hapet përsëri tani}=1{Agent Chrome do të hapet përsëri për 1 sekondë}other{Agent Chrome do të hapet përsëri për # sekonda}}</translation>
<translation id="6241367896540709610">Chromium ka nevojë për leje qasjeje te hapësira ruajtëse për të shkarkuar skedarë</translation>
<translation id="6245734527075554892">Kontrollon URL-të kundrejt një liste sajtesh të pasigurta të ruajtur në Chromium.</translation>
<translation id="5070229316792137581">Bëje Agent Chrome, shfletuesin tënd të parazgjedhur</translation>
<translation id="6248988683584659830">Cilësimet e kërkimit</translation>
<translation id="6261803579884938625">Merr veçoritë më të mira të sigurisë të Google kur je në lëvizje me aplikacionin e Chromium në telefonin tënd</translation>
<translation id="6268381023930128611">Dëshiron të dalësh nga Chromium?</translation>
<translation id="6270547683008298381">Këto skeda po përdorin burime shtesë. Për të përmirësuar performancën tënde, lejo që Chromium t'i bëjë ato joaktive.</translation>
<translation id="6281746429495226318">Personalizo profilin tënd të Chromium</translation>
<translation id="6290827346642914212">Emërto profilin tënd të Chromium</translation>
<translation id="6294831894865512704">Një shtesë kërkon që të identifikohesh në Chromium</translation>
<translation id="1356965940380155951"><ph name="FILE_NAME" /> mund të jetë i rrezikshëm, prandaj Agent Chrome e ka bllokuar.</translation>
<translation id="7321042153033393145">Agent Chrome po përdor kamerën tënde.</translation>
<translation id="6333502561965082103">Një veprim tjetër në Chromium është në vazhdim. Provo përsëri më vonë.</translation>
<translation id="6334986366598267305">Tani është më e lehtë të përdorësh Chromium me llogarinë tënde të Google dhe në kompjuter të ndarë.</translation>
<translation id="6347002662287820329">Përfito qasje të lehtë te veçoritë që njeh, që të pëlqejnë dhe që u beson duke caktuar Chromium si shfletuesin tënd të parazgjedhur.</translation>
<translation id="6663103136563143835">Shkurtorja e Agent Chrome</translation>
<translation id="8324836837188781073">Agent Chrome e bllokoi këtë shkarkim sepse skedari nuk është shkarkuar zakonisht dhe mund të jetë i rrezikshëm</translation>
<translation id="6373523479360886564">Je i sigurt që dëshiron ta çinstalosh Chromium?</translation>
<translation id="6375219077595103062">Shto një shkurtore për te "Menaxheri i fjalëkalimeve"</translation>
<translation id="6388799252195623474">më ndihmo me këtë</translation>
<translation id="6390800440335263989">Për të vazhduar, identifikohu në Chromium si <ph name="EMAIL" />. Kjo siguron që të kesh politikat e organizatës sate.</translation>
<translation id="6400112897226594999">Logoja e Chromium brenda një ekrani kompjuteri.</translation>
<translation id="6403826409255603130">Chromium është një shfletues uebi që ekzekuton faqe uebi dhe aplikacione me një shpejtësi jashtëzakonisht të lartë. Është i shpejtë, i qëndrueshëm dhe i lehtë në përdorim. Shfleto në ueb në mënyrë më të sigurt, me mbrojtje të integruar në Chromium kundër mashtrimeve dhe softuerëve keqdashës.</translation>
<translation id="6414624068245092115">Për t'u siguruar që mund t'i përdorësh dhe t'i ruash gjithmonë të dhënat e Chromium në "Llogarinë tënde të Google", verifiko që je ti</translation>
<translation id="5698692159722140301">Agent Chrome funksionon më shpejt dhe veçoritë që përdorin JavaScript do të punojnë siç pritet</translation>
<translation id="6436260184216827876">"Kërkimi nëpërmjet imazheve" nuk ofrohet. Provo përsëri më vonë.</translation>
<translation id="6442900851116057561">Rinis ChromiumOS</translation>
<translation id="1150325299163558144">Agent Chrome ngarkon paraprakisht edhe faqe të tjera që mund t'i vizitosh që ato të ngarkohen më shpejt kur t'i vizitosh.</translation>
<translation id="6450948450282634257">Shkarko Chromium në telefon për të monitoruar çmimet dhe për të marrë sinjalizime kur ka rënie çmimi në ndonjë sajt</translation>
<translation id="2302438614865168038">Joaktive • Agent Chrome nuk mund të verifikojë se nga vjen kjo shtesë</translation>
<translation id="6455857529632101747">Mirë se vjen në profilet e Chromium</translation>
<translation id="6460614424172581323">Herën tjetër që të hapësh Chromium në <ph name="DEVICE_TYPE" />, do të shikosh një kërkesë për të përdorur grupet e skedave.</translation>
<translation id="6466344609055215035">Hiqe llogarinë nga Chromium</translation>
<translation id="5526497172610025231">Gjithashtu kontrollon se cila faqe shfaqet kur fillon Agent Chrome</translation>
<translation id="648319183876919572">"Shfletimi i sigurt i përmirësuar" bën më shumë për të të mbrojtur nga uebsajtet dhe shkarkimet e rrezikshme</translation>
<translation id="6510925080656968729">Çinstaloje Chromium</translation>
<translation id="124295298108005714">Shkurtoret janë hapur në Agent Chrome</translation>
<translation id="9177671044583442813">Organizata jote e mbyll Agent Chrome kur ai nuk përdoret për <ph name="TIMEOUT_DURATION" />. Të dhënat e shfletimit u fshinë. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet.</translation>
<translation id="6542839706527980775">Secili profil duhet të zotërojë informacionin e vet të Chromium, si: faqeshënuesit, historikun, fjalëkalimet etj.</translation>
<translation id="6556755379298048869">Kërko me një shkurtore tastiere.</translation>
<translation id="5677032436425073715">Mëso më shumë se <ph name="BEGIN_LINK" />si Agent Chrome i mban private të dhënat e tua<ph name="END_LINK" /></translation>
<translation id="5967753610833950399">Ndryshimet në këtë cilësim do të zbatohen pasi Agent Chrome të riniset.</translation>
<translation id="4790842900919490952">Menaxho shtesat e tua duke klikuar te "Shtesat" në menynë kryesore të Agent Chrome.</translation>
<translation id="656935081669708576">Mund ta ndërrosh për të parë fjalëkalimet nga një profil tjetër i Chromium</translation>
<translation id="6569556444379005948">Përdor aplikacionin e Chromium për të marrë veglat më të mira me IA kur je në lëvizje</translation>
<translation id="8124768693572849485">Për të korrigjuar gabimet drejtshkrimore, Agent Chrome e dërgon te Google tekstin që ti shkruan në fushat e tekstit</translation>
<translation id="6598877126913850652">Shko te "Cilësimet e njoftimeve" të Chromium</translation>
<translation id="6600016381025017075">Kërko për çdo gjë në këtë faqe</translation>
<translation id="1736130262142947818">Ndryshimet e tua do të hyjnë në fuqi herën tjetër kur të rinisësh Agent Chrome.</translation>
<translation id="6637908313088374648">Chromium tani niset kur niset Windows që të mund të fillosh të shfletosh menjëherë. Mund ta çaktivizosh këtë te cilësimet.</translation>
<translation id="6648212540664651655">Vazhdo aty ku e ke lënë: Chromium i restauroi skedat e tua nga sesioni yt i fundit. Mund ta çaktivizosh këtë te</translation>
<translation id="665732753414869868">Chromium ka nevojë për lejen e kamerës për të krijuar një hartë 3D të ambientit tënd rrethues</translation>
<translation id="6669284030132180248">Nëse i ruan faqeshënuesit e tu vetëm në "Llogarinë tënde të Google", mund t'i monitorosh çmimet e produkteve në Chromium dhe të marrësh njoftime kur të ulet çmimi</translation>
<translation id="6676384891291319759">Qasu në internet</translation>
<translation id="668175097507315160">ChromiumOS nuk mund t'i sinkronizonte të dhënat e tua për shkak të një gabimi gjatë identifikimit.</translation>
<translation id="6691132793308828750">Hiq të dhënat e këtij aplikacioni nga Chromium</translation>
<translation id="6709350901466051922">Chromium ka nevojë për lejen e mikrofonit për këtë sajt</translation>
<translation id="6712881677154121168">Gabim shkarkimi: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="7755971898820142787">Profili yt nuk mund të përdoret sepse është nga një version më i ri i Agent Chrome.

Disa funksione mund të mos ofrohen. Specifiko një direktori tjetër profili ose përdor një version më të ri të Agent Chrome.</translation>
<translation id="6729124504294600478">Për të marrë personalizimin dhe veçoritë e tjera, përfshi Chromium në "Aktivitetin e uebit dhe të aplikacioneve" dhe në shërbimet e lidhura të Google</translation>
<translation id="6734291798041940871">Chromium është i instaluar tashmë për të gjithë përdoruesit në kompjuterin tënd.</translation>
<translation id="6742093177587589736">Për të marrë fjalëkalimet, faqeshënuesit etj. në të gjitha pajisjet e tua, identifikohu në Chromium. Ky faqeshënues do të ruhet në "Llogarinë tënde të Google" pasi të identifikohesh.</translation>
<translation id="7821834337023193240">Shpejton sajtet me motorin V8 të Agent Chrome, por e bën Agent Chrome disi më pak rezistent ndaj sulmeve. Ky cilësim është aktiv.</translation>
<translation id="6754665438209053659">{count,plural, =1{Disa nga të dhënat e tua të Chromium nuk janë ruajtur ende në "Llogarinë tënde të Google". Provo të presësh për disa minuta para se të dalësh nga ajo. Nëse del tani, këto të dhëna (1 artikull) do të fshihen.}other{Disa nga të dhënat e tua të Chromium nuk janë ruajtur ende në "Llogarinë tënde të Google". Provo të presësh për disa minuta para se të dalësh nga ajo. Nëse del tani, këto të dhëna ({count} artikuj) do të fshihen.}}</translation>
<translation id="67706546131546258">Chromium rekomandon ta skanosh këtë skedar, sepse ai mund të jetë i rrezikshëm.</translation>
<translation id="6779406956731413166">ChromiumOS mundësohet nga <ph name="BEGIN_LINK_CROS_OSS" />softuerë shtesë me burim të hapur<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Përkthe</translation>
<translation id="6847869444787758381">Chromium të informon nëse fjalëkalimet e tua komprometohen ndonjëherë</translation>
<translation id="684888714667046800">Lidhja me internetin nuk mund të kryhej. Nëse përdor një mur mbrojtës, sigurohu që <ph name="PRODUCT_EXE_NAME" /> të jetë në listën e lejimeve.</translation>
<translation id="6219638737609534419">Agent Chrome - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Shtyp tastin Tab për të vazhduar</translation>
<translation id="6862030660799253820">Kërkoje këtë imazh me "Kërkimin e imazheve"</translation>
<translation id="6869568587896659271">Qasje e lehtë në uebsajtet poshtë shiritit të adresave</translation>
<translation id="7421523967177993052">Agent Chrome vuri re se "<ph name="EXTENSION_NAME" />" përmban softuer keqdashës</translation>
<translation id="6877155553248388166">këndi poshtë djathtas i zonës së kërkimit: djathtas <ph name="RIGHT" />%, poshtë <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Kopjo</translation>
<translation id="6898028264630240901">Mund t'i gozhdosh "Detyrat kontekstuale" për të bërë pyetje ndërkohë që shfleton</translation>
<translation id="6901631050894301805">Cakto Chromium si shfletuesin tënd të parazgjedhur dhe gozhdoje te shiriti i detyrave</translation>
<translation id="6909503629704372277">&amp;Menaxho profilet e Chromium</translation>
<translation id="9199111398679939226">Ky veprim:
          <ph name="LINE_BREAKS" />
            • Do të rivendosë faqen e parë, faqen e skedës së re, motorin e kërkimit dhe skedat e gozhduara
            <ph name="LINE_BREAK" />
            • Do të çaktivizojë shtesat
            <ph name="LINE_BREAK" />
            • Do të fshijë kukit dhe të dhënat e tjera të përkohshme të sajtit
            <ph name="LINE_BREAK" />
            • Do të rivendosë shkurtoret e Agent Chrome
            <ph name="LINE_BREAKS" />
            Faqeshënuesit, historiku dhe fjalëkalimet e ruajtura nuk do të preken.</translation>
<translation id="6948031725951063910">Ke arritur kufirin e Chromium prej <ph name="BOOKMARK_LIMIT" /> faqeshënuesish, prandaj disa nga faqeshënuesit e tu nuk janë ruajtur ende në "Llogarinë tënde të Google".

Faqeshënuesit e rinj nuk mund të ruhen në llogarinë tënde derisa të fshish disa. Nëse del tani, faqeshënuesit e paruajtur do të fshihen.</translation>
<translation id="6964305034639999644">Hape lidhjen në një dritare të fshe&amp;htë të Chromium</translation>
<translation id="6965382102122355670">Në rregull</translation>
<translation id="6985329841647292029">Kushtet e ChromiumOS</translation>
<translation id="7003299027384820442">Fut frazën e kalimit për të përdorur dhe ruajtur të dhënat e Chromium në llogarinë tënde <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Instalimi dështoi sepse ky version i sistemit operativ nuk mbështetet.</translation>
<translation id="7024536598735240744">Gabim shpaketimi: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7045244423563602563">Bëje Chromium tëndin</translation>
<translation id="7047386856539490735">A janë të dobishme këto rezultate?</translation>
<translation id="705851970750939768">Përditëso Chromium</translation>
<translation id="1222890016986172619">Nëse një imazh nuk ka një përshkrim të dobishëm, Agent Chrome do të përpiqet të të japë një përshkrim. Për të krijuar përshkrime, imazhet dërgohen te Google.</translation>
<translation id="7074836723476134809">Merr fuqinë e IA-së kur përdor aplikacionin e Chromium në <ph name="DEVICE_TYPE" /></translation>
<translation id="7134687062119989071">Merr fjalëkalimet, skedat etj. kur je në lëvizje me aplikacionin e Chromium në telefonin tënd</translation>
<translation id="7141270731789036260">Personalizo Chrome for Testing</translation>
<translation id="5669948510815930830">Mund të përdorësh Agent Chrome sa herë që klikon te lidhjet në mesazhe, dokumente dhe aplikacione të tjera</translation>
<translation id="5576210706466474421">Hiq <ph name="EXTENSION_NAME" /> nga Agent Chrome</translation>
<translation id="4588941330171478873">Organizata jote i fshin të dhënat e Agent Chrome kur ato nuk përdoren për <ph name="TIMEOUT_DURATION" />. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet.</translation>
<translation id="718435575166326686">Chromium ka nevojë për lejen e kamerës për këtë sajt</translation>
<translation id="2916059341902838041">Agent Chrome nuk mund të hapej. Provo përsëri.</translation>
<translation id="7204669035546236137">Pyet për çdo gjë, pikërisht aty ku je, me Gemini në Chromium</translation>
<translation id="1716746018761150810">Mbaje Agent Chrome në "Stacion" për ta hapur atë me shpejtësi në çdo kohë</translation>
<translation id="7213407614656404070">Përdor Chromium sa herë që klikon te lidhjet në mesazhe, dokumente dhe aplikacione të tjera</translation>
<translation id="7216228761061470870">Kur përdor "Kërkimin e imazheve" në desktop, titulli i faqes, URL-ja dhe përmbajtja, duke përfshirë skedarët PDF, dërgohen te serveri</translation>
<translation id="4816956813330284757">Menaxheri i detyrave - Agent Chrome</translation>
<translation id="7227958669698166857"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Chromium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu informacionet e ruajtura etj. në të gjitha pajisjet e tua.</translation>
