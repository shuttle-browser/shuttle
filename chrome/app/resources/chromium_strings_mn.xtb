<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mn">
<translation id="1026101648481255140">Үргэлжлүүлэн суулгах</translation>
<translation id="1029669172902658969">&amp;ChromiumOS-г шинэчлэхийн тулд дахин ачаална уу</translation>
<translation id="8271032073852564289">Agent Chrome танд энэ өргөтгөлийг шалгахыг зөвлөж байна</translation>
<translation id="1395700234492294565">Сайт өөрийн хуудсан дээр холбооснуудыг нууцлалтайгаар урьдчилан ачаалахыг хүсэхэд Agent Chrome Google-н серверүүдийг ашиглана. Энэ нь таны таниулбарыг урьдчилан ачаалсан сайтаас нуух ч Google ямар сайтуудыг урьдчилан ачаалдгийг мэдэж авна.</translation>
<translation id="1051793555070215510">Бидэнд энэ 1 минутын судалгааг бөглөж Нууцлалтай горимыг сайжруулахад тусална уу.</translation>
<translation id="1065672644894730302">Таны хүсэлтийг уншиж чадахгүй байна. 

Зарим үйлдлүүд нь боломжгүй байж магадгүй бөгөөд сонголтонд хийсэн өөрчлөлтүүд хадгалагдахгүй.</translation>
<translation id="3693661839172633833">Таны эцэг эх Agent Chrome-н "Сайт, апп болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна</translation>
<translation id="4676383270508741906">Agent Chrome-н тодорхой онцлог, өргөтгөлийг хайхын тулд хаяг оруулах хэсэгт товчлолыг нь сонгосон товчлуурт гарын товчийн хамт шивж оруулна уу</translation>
<translation id="1098493699368672217">Системийн жижиг тэмдэг бүхий хэсэгт Chromium дахь хайлтыг харуулж, гарын товчлолыг асаагаарай</translation>
<translation id="1104942323762546749">Chromium таны нууц үгийг экспортлох хүсэлтэй байна. Үүнийг зөвшөөрч байгаа бол Windows-н нууц үгээ оруулна уу.</translation>
<translation id="112640046208448578">Зүйл болон газрыг таньж, текст хуулж эсвэл орчуулна. Таныг Зурган хайлтыг ашиглахад хуудасны дэлгэцийн агшныг сервер лүү илгээнэ. <ph name="LEARN_MORE" /></translation>
<translation id="5373975050135708711">Agent Chrome таны өгөгдмөл хөтөч</translation>
<translation id="1131805035311359397">Нууц үгнүүддээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK" />Chromium-д нэвтэрнэ үү<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Chromium цэсийг товшино уу</translation>
<translation id="1157985233335035034">Саяхан сонгосон хэлнүүд</translation>
<translation id="1184145431117212167">Таны Windows-н хувилбарыг дэмждэггүй тул суулгаж чадсангүй.</translation>
<translation id="604454529346438712">Agent Chrome-ийн тухай</translation>
<translation id="1186645291482254714">Утсан дээрээ Chromium-р үнэ мөшгөх мэдэгдэл аваарай</translation>
<translation id="1203500561924088507">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="1232234696885483911">Таныг Зурган хайлтыг нээхэд хуудасны гарчиг, URL болон PDF зэрэг контентыг сервер лүү автоматаар илгээнэ. <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">Та нэвтэрсэн байхдаа Chromium-д Google Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. Үүнийг өөрчлөхийн тулд “Chromium дахь таны бүртгэл” рүү очно уу.</translation>
<translation id="1244381985120794049">Mac-н цэсийн мөрд Chromium дахь Gemini-г харуулах</translation>
<translation id="1257483544893909270">Chromium дахь Gemini-д дэлгэцийн хэсгийг сонгохын тулд товчлуурын шууд холбоосыг ашиглана уу.</translation>
<translation id="1262876892872089030">Энэ табыг идэвхгүй үед Chromium-г хурдан байлгахын тулд санах ойг чөлөөлсөн. Та энэ сайтыг идэвхгүй болохоос үргэлж хасахаар сонгох боломжтой.</translation>
<translation id="3777643518642881741">Энэ файл аюултай тул Agent Chrome энэ таталтыг блоклосон</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" />-р Gmail эсвэл YouTube зэрэг Google-н үйлчилгээнд нэвтрэх үед та тухайн бүртгэлээр Chromium-д автоматаар нэвтрэх боломжтой</translation>
<translation id="1287534462498555020">Утсан дээрээ Chromium-г аваарай</translation>
<translation id="1290883685122687410">Тохируулгын алдаа: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Chromium-н шинэ профайлаа тохируулах</translation>
<translation id="132092532143527429">Chromium дахь Gemini-р туршиж үзэх</translation>
<translation id="200785071050073583">Agent Chrome-д Bluetooth төхөөрөмжүүдийг судлахад 
 Bluetooth-н хандалт шаардлагатай. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">Утсан дээрээ Chromium-д нэвтрэх</translation>
<translation id="1330562121671411446">Хэл илрүүлэх</translation>
<translation id="1342274909142618978">Мөн Chromium-с өгөгдөл устгах (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Бэхэлсэн! Та Зурган хайлтад самбар дээрх шинэ товчоос дахин хандах боломжтой</translation>
<translation id="1356661055722410047">Шинэ! Та дэлгэц дээрх текст, зургийн аль алиныг орчуулах боломжтой</translation>
<translation id="1383876407941801731">Хайлт</translation>
<translation id="1388276868779258475">Явж байх зуураа үргэлжлүүлэн үзэхийн тулд Chromium аппыг ашиглаарай</translation>
<translation id="141901961143729572">Бодол санаагаа хуваалц</translation>
<translation id="8789809509510733987">Цонхоо хуваалцахын тулд Системийн тохиргоонд Agent Chrome-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="1478370723027452770">Chrome for Testing-р тусламж авах</translation>
<translation id="1497802159252041924">Суулгалтын алдаа: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Энэ хуудсыг хамгаалагдсан байна</translation>
<translation id="3850708453627715578">Agent Chrome-н таб хуваалцах</translation>
<translation id="154404805518949443">Chromium-д нэвтрэх</translation>
<translation id="1547469039832541117">Тодруулсан ажлыг дуусгана.</translation>
<translation id="8546278207686764484">Agent Chrome-г бэхлэх</translation>
<translation id="1574377791422810894">Chromium-н аюулгүй байдлын хэрэгсэл</translation>
<translation id="1594928384848033697">Chromium таны Нууц үгний менежерийн өгөгдлийг устгахыг хүсэж байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="551713766576210710">{COUNT,plural, =0{Шинэчлэлтийг хэрэгжүүлэхийн тулд Agent Chrome-г дахин ачаалахыг таны администратор танаас шаардаж байна}=1{Шинэчлэлтийг хэрэгжүүлэхийн тулд Agent Chrome-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Шинэчлэлтийг хэрэгжүүлэхийн тулд Agent Chrome-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="1623563412065267963">Утсан дээрээ Chromium аппаар Google-н шилдэг зүйлсийг аваарай</translation>
<translation id="1625909126243026060">Chromium-н нууцлал болон аюулгүй байдлын үндсэн хяналтуудыг шалгана уу</translation>
<translation id="1640672724030957280">Татаж байна...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" /> <ph name="USER_EMAIL" />-р гишүүнчлэлийн эрхтэйгээр нэвтэрсэн. Бүртгэлийн цэсийг нээх</translation>
<translation id="2604712040942461790">Та мессеж, баримт бичиг болон бусад апп дахь холбоосон дээр товших бүрдээ Agent Chrome-г ашиглах боломжтой. Үүнийг мөн таны ажлын хэсэгт бэхэлнэ.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" />-н нэмэлт эрхээр хангадаг.</translation>
<translation id="1722488837206509557">Энэ нь танд боломжтой төхөөрөмжүүд сонгож, тэдгээр төхөөрөмжид контент үзүүлэх боломжийг олгоно.</translation>
<translation id="4145295773323539953">Agent Chrome удахгүй интернэтээр үзсэн өгөгдлийг устгана</translation>
<translation id="1736443181683099871">Chromium навигацуудыг HTTPS болгож сайжруулахаар оролдоно</translation>
<translation id="7280502947294080605">Agent Chrome-н өгөгдлийг устгасан</translation>
<translation id="1745121272106313518">Chromium-г <ph name="REMAINING_TIME" />-н дараа дахин эхлүүлнэ</translation>
<translation id="1749104137266986751">HTTPS боломжгүй үед Chromium танд сануулалгүйгээр аюултай холболт ашиглана</translation>
<translation id="1887395919652703120">Agent Chrome-ыг арын орчинд ажиллуулах</translation>
<translation id="1779356040007214683">Chromium аюулгүй байдлыг нэмэгдүүлэхийн тулд бид <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ны жагсаалтад байхгүй бөгөөд танд мэдэгдэлгүйгээр нэмэгдсэн байж болзошгүй зарим өргөтгөлүүдийг идэвхгүй болгосон.</translation>
<translation id="1793486931176048546">Chromium-г ажлын хэсэгтээ бэхэлж, шуурхай хандахын тулд Windows-н мэдэгдэл дэх <ph name="BEGIN_BOLD" />Тийм<ph name="END_BOLD" /> дээр товшино уу</translation>
<translation id="357645171972700077">Agent Chrome-ыг дахин суулгах</translation>
<translation id="1820835682567584003">Chromium <ph name="AUTHENTICATION_PURPOSE" /> оролдож байна</translation>
<translation id="183031085822326697">Та дараагийн удаа <ph name="DEVICE_TYPE" /> дээрээ Chromium-г нээхдээ Google Нууц үгний менежерийг ашиглах сануулга харна.</translation>
<translation id="1838374766361614909">Хайлтыг арилгах</translation>
<translation id="18552579716432081">Интернэтээр үзсэн өгөгдлөө Google Бүртгэлдээ үлдээж, зөвхөн энэ төхөөрөмжөөс устгахын тулд <ph name="BEGIN_LINK" />Chromium-с гарна уу<ph name="END_LINK" />.</translation>
<translation id="1857749206890802997">Явж байх зуураа шинэ табын бүлэг нээх эсвэл үүсгэхийн тулд утсан дээрээ Chromium-г татаарай.</translation>
<translation id="185970820835152459">Та нэвтэрсэн Google Бүртгэлүүдээ удирдах боломжтой. Таны Google Бүртгэлүүдийг Chromium хөтөч, Play Store, Gmail болон бусад дээр ашигладаг. Хэрэв та гэр бүлийн гишүүн зэрэг өөр хэн нэгний бүртгэлийг нэмэхийг хүсвэл оронд нь өөрийн <ph name="DEVICE_TYPE" />-д шинэ хүн нэмнэ үү. <ph name="LINK_BEGIN" />Нэмэлт мэдээлэл авах<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Зурган хайлтаар хайх</translation>
<translation id="1863837059069884561"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Chromium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с хавчуурга болон бусад зүйлээ авна.</translation>
<translation id="1880677175115548835">Текст сонгох</translation>
<translation id="1881322772814446296">Та удирдлагатай бүртгэл рүү нэвтрэн орсноор түүний админд нь өөрийн Chromium-ын хувийн мэдээллийг удирдах эрхийг олгож байна гэсэн үг юм. Таны Chromium-ын мэдээлэл, аппликейшн, хайлтын жагсаалт, түүх, нууц үг болон бусад тохиргоонууд <ph name="USER_NAME" /> руу нэгдэх болно. Та энэ мэдээллийг Google-ийн Хяналтын самбарыг ашиглан устгаж болох хэдий ч энэ мэдээллийг өөр данс руу нэгтгэж чадахгүй. Та одоо байгаа Chromium-ын мэдээллийг тусад нь хадгалахын тулд шинэ хувийн мэдээлэл үүсгэж болно. <ph name="LEARN_MORE" /></translation>
<translation id="4964792828232534953">Agent Chrome саадгүй гүйлгэх, видеоны фреймийн хурд зэрэг арын үйл ажиллагаа болон визуал эффектийг хязгаарласнаар батарейн цэнэгийг хэмнэнэ. <ph name="BEGIN_LINK" />Эрчим хүч хэмнэгчийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">Chromium Шинэчлэгч үйлчилгээ</translation>
<translation id="1911763535808217981">Үүнийг унтрааснаар та Gmail зэрэг Google-н сайтуудад Chromium-д нэвтрэлгүйгээр нэвтэрч болно</translation>
<translation id="1929939181775079593">Chromium ажиллахгүй байна. Дахин эхлүүлэх үү?</translation>
<translation id="1933341829955786215">Танай байгууллага болох <ph name="MANAGER" /> таныг Chromium-д нэвтрэхийг шаардаж байна</translation>
<translation id="193439633299369377">Шинэчлэлтийг хэрэгжүүлэхийн тулд ChromiumOS-г дахин эхлүүлэх шаардлагатай.</translation>
<translation id="207375373460618430">Файлын төрлийг ихэвчлэн татдаггүй бөгөөд энэ нь аюултай байж магадгүй тул Agent Chrome энэ таталтыг блоклосон</translation>
<translation id="1953553007165777902">Татаж байна... <ph name="MINUTE" /> минут үлдсэн</translation>
<translation id="700162948230159797">Agent Chrome нь өгөгдмөл хөтчийг тодорхойлох эсвэл тохируулах боломжгүй</translation>
<translation id="197326043290947695">Зурган хайлтаар илүү ухаалгаар үзээрэй</translation>
<translation id="1990262977744080398">Chromium зарим файлыг яагаад блоклодог болохыг мэдэж авна уу, шинэ табд нээгдэнэ</translation>
<translation id="1999715455684970349">Таны Chromium программ хангамжийг хамгийн шинэ байлгана. Хэрэв энэ үйлчилгээг идэвхгүй болгосон эсвэл зогсоосон бол таны Chromium-н программ хангамж хамгийн шинэ байхгүй бөгөөд энэ нь аюулгүй байдлын гарч болзошгүй сул эмзэг байдлыг засах боломжгүй, мөн онцлогууд ажиллахгүй байж магадгүй гэсэн үг юм. Энэ үйлчилгээг ашигладаг Chromium-н программ хангамж байхгүй байхад энэ үйлчилгээ өөрийгөө устгана.</translation>
<translation id="2008474315282236005">Энэ нь төхөөрөмжөөс 1 зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="2018879682492276940">Суулгаж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="2039417478970545937">Тохиргоо.</translation>
<translation id="2049376729098081731">Google-н үйлчилгээнүүдэд илүү хувийн болгосон туршлага авахын тулд Chromium-н түүхийг багтаах эсэхээ сонгоно уу</translation>
<translation id="2050698962207788467">Танд сайн нууц үг үүсгэх, хадгалах, автоматаар бөглөхөд туслахын тулд Chromium-д суурилуулсан. Хялбар хандахын тулд товчлолыг нэмээрэй.</translation>
<translation id="2064856577282482477">Chromium-д шинэ дүр төрх өгөхийн тулд Шинэ таб хуудсан дээрх Chromium-г тусгайлан өөрчлөх товчин дээр товшино уу</translation>
<translation id="6816376218079012438">Файл нь хуурамч бөгөөд таны төхөөрөмжид гэнэтийн өөрчлөлт хийж магадгүй тул Agent Chrome энэ таталтыг блоклосон</translation>
<translation id="208726765006323911">Та дараагийн удаа Chromium iOS-г нээхдээ <ph name="FEATURE_NAME" />-г туршиж үзэхийг сануулсан сануулга харна.</translation>
<translation id="2099452623287920103">Таны Google Бүртгэлдээ хадгалсан нууц үг болон Chromium-н бусад өгөгдлийг энэ төхөөрөмжөөс хасна. Тэдгээрийг Chromium-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="8983263343920390117">{COUNT,plural, =1{Agent Chrome-г 1 минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}other{Agent Chrome-г # минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}}</translation>
<translation id="2125838419757773031">Хайх дэлгэцийн хэсэг сонгох</translation>
<translation id="2126108037660393668">Татсан файлын баталгаажуулалт амжилтгүй боллоо.</translation>
<translation id="2135919691573380097">Энэ сайтыг мэдээлэх</translation>
<translation id="2137162749895930932">Орчуулах дэлгэцийг хаах</translation>
<translation id="822057692680289847">Сайт аюулгүй холболт ашиглахгүй байгаа бөгөөд файлыг оролдсон байж магадгүй тул Agent Chrome энэ таталтыг блоклосон</translation>
<translation id="2170098639895543546">Хуудсан дээрх дурын зүйлийг сонгоно уу</translation>
<translation id="2174178932569897599">Chromium-г өөрчлөх</translation>
<translation id="2174917724755363426">Суулгаж дуусаагүй байна. Та цуцлахдаа итгэлтэй байна уу?</translation>
<translation id="922967513335788675">Agent Chrome - Сүлжээнд нэвтрэх - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Шалгалтын алдааг шинэчлэх: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Chromium-с бүртгэл хасах</translation>
<translation id="2201788217099588893">Chromium аппыг ашиглан худалдан авалтын шилдэг хэрэгслүүдийг явж байх зуураа ашиглаарай</translation>
<translation id="2210502920229141283">iOS-т зориулсан Chromium дээрх Сайжруулсан аюулгүй хөтчийг ашиглан явж байх зуур илүү аюулгүй байгаарай</translation>
<translation id="2210682093923538346">Аюултай сайт. Chromium мэдэгдлүүдийг хассан.</translation>
<translation id="2236949375853147973">Миний үйл ажиллагаа</translation>
<translation id="2238130810669087193">Хаяг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Chromium-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ хаягийг Google Бүртгэлд тань хадгална.</translation>
<translation id="2241627712206172106">Хэрэв та компьютероо дундаа ашиглаж байгаа бол таны найз нөхөд, гэр бүл  тусдаа хайлт хийж,  өөрсдийн хүссэнээрээ Chromium-ыг тохируулж болно.</translation>
<translation id="22571759390241347">Chromium-н Ур чадвар</translation>
<translation id="2283803047247799269">Зурган хайлтаар энэ табаас хайх</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Chromium таны хөтчийг удаашруулж буй табыг түр зогсоохыг зөвлөж байна}other{Chromium таны хөтчийг удаашруулж буй табуудыг түр зогсоохыг зөвлөж байна}}</translation>
<translation id="2307973900865360088">Суурилуулагчид байлгах</translation>
<translation id="2313870531055795960">URL-г Chromium-д хадгалсан аюултай сайтын жагсаалттай харьцуулж шалгадаг. Хэрэв сайт таны нууц үгийг хулгайлах гэж оролдвол эсвэл таныг аюултай файл татах үед Chromium нь хуудасны контентын зэрэг URL-г Аюулгүй хайлт руу мөн илгээж болзошгүй.</translation>
<translation id="2356070529366658676">Асуух</translation>
<translation id="2359808026110333948">Цааш</translation>
<translation id="2361918034042471035">"<ph name="EXTENSION_NAME" />" өргөтгөл таныг Chromium-д нэвтрэхийг хүсэж байна</translation>
<translation id="2028456545634496358">Аппуудын хувьд Agent Chrome-г дэвсгэрт ажиллуулахыг идэвхгүй болгох</translation>
<translation id="2374216753258219393">Энэ өргөтгөлийг <ph name="USER_EMAIL_ADDRESS" />-р ашиглахын тулд Chromium-д нэвтэрнэ үү.</translation>
<translation id="2384373936468275798">Таны бүртгэлийн нэвтрэх дэлгэрэнгүй мэдээлэл хуучирсан тул ChromiumOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="3040857862310351495">{NUM_DEVICES,plural, =0{1 HID төхөөрөмжид нэг эсвэл түүнээс олон Agent Chrome-н өргөтгөл хандаж байсан}=1{1 HID төхөөрөмжид нэг эсвэл түүнээс олон Agent Chrome-н өргөтгөл хандаж байна}other{# HID төхөөрөмжид нэг эсвэл түүнээс олон Agent Chrome-н өргөтгөл хандаж байна}}</translation>
<translation id="2401032172288869980">Chromium-д энэ сайтад зориулж камер болон микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="2403703063067034158">Эхлэхэд алдаа гарлаа: одоогоор тохируулгын өөр нэг инстанс ажиллаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="2418322681019544463">Дурын аппаас холбоосыг Chromium-д нээж, хөтчийг ажлын хэсэгтээ хандах боломжтой байлгаарай</translation>
<translation id="2425157128016763890">Шуурхай тойм авах, араас нь лавлах асуулт асуухаар энэ баримт бичгийг Chromium дахь Gemini-тай хуваалцахын тулд Хураангуйлах товчин дээр товшино уу</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-н хэрэгслийн<ph name="END_LINK" /> тусламжтайгаар та аюулгүй үзэх болон хяналтыг гартаа байлгах боломжтой</translation>
<translation id="2449487342837813167"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Chromium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ нууц үг болон бусад зүйлээ авна.</translation>
<translation id="2451727308784734061">Нууц үгний менежерт шуурхай очихын тулд товчлолоо ашиглана уу. Та товчлолоо компьютерын үндсэн нүүр эсвэл апп байршуулагч руугаа зөөх боломжтой.</translation>
<translation id="4405360797107732759">Agent Chrome-г удахгүй хаана</translation>
<translation id="1660473983484527105">Agent Chrome-д</translation>
<translation id="2485422356828889247">Устгах</translation>
<translation id="2513154137948333830">Дахин асаах шаардлагатай: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Зурган хайлтаар текст сонгоно уу</translation>
<translation id="2554739539410784893">Chromium одоо байгаа нууц үгнүүдийг солихоор оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="2560420686485554789">Файл татахын тулд Chromium-д сангийн хандалт шаардлагатай</translation>
<translation id="8620990455069644819">Agent Chrome-ийн туслагч</translation>
<translation id="2575822587468774919">Зурган хайлтаар хайхыг хүссэн зүйлээ сонгоно уу</translation>
<translation id="2576118232315942160">Нууц үг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Chromium-д нэвтэрнэ үү</translation>
<translation id="2587622539943955767">Chromium-г татаж, Google Бүртгэлдээ нэвтрэхийн тулд утсаараа QR кодыг скан хийнэ үү.</translation>
<translation id="4496289616420025644">Agent Chrome-г үргэлжлүүлэн ашиглах</translation>
<translation id="259935314519650377">Татсан суулгагчийг завсрын санах ойд хадгалж чадсангүй. Алдаа: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Систем</translation>
<translation id="2629740064077610681">Танай байгууллага таны хавчуурга, түүх, нууц үг зэрэг интернэтээр үзсэн өгөгдлийг харж, удирдах боломжтой. Энэ нь Chromium-н бусад профайл дахь интернэтээр үзсэн өгөгдлийг харах боломжгүй</translation>
<translation id="2635452620547538388"><ph name="ACCOUNT_EMAIL" /> бүртгэлдээ Chromium-н өгөгдлөө ашиглах, хадгалахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="8944895445911901418">{COUNT,plural, =0{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Agent Chrome-г дахин ачаалахыг шаарддаг}=1{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Agent Chrome-г дахин ачаалахыг шаарддаг. Таны нууцлалтай цонх дахин нээгдэхгүй.}other{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Agent Chrome-г дахин ачаалахыг шаарддаг. Таны нууцлалтай # цонх дахин нээгдэхгүй.}}</translation>
<translation id="263863604136125912">Chromium-г эхлүүлэх</translation>
<translation id="2648074677641340862">Суулгалтын явцад үйлдлийн системийн алдаа гарлаа. Chromium-ыг дахин татаж авна уу.</translation>
<translation id="2661879430930417727">Хэрэв та төхөөрөмжийг дундаа ашигладаг бол найз нөхөд, гэр бүл тань хөтчөөр тусдаа үзэж, Chromium-г хүссэнээрээ тохируулах боломжтой</translation>
<translation id="2676569452213089702">Chromium-г жижгэрүүлсэн байсан ч төхөөрөмж дээрээ Chromium дахь Gemini-г ашиглахын тулд хялбархан хандаарай.</translation>
<translation id="3144164911846092828">Agent Chrome таб</translation>
<translation id="2718390899429598676">Таны аюулгүй байдлыг сайжруулахын тулд Chromium таны өгөгдлийг шифрлэх болно.</translation>
<translation id="2721354645805494590">Google Бүртгэлээ Chromium-с хасахын тулд гарна уу</translation>
<translation id="2722636413143664436">Нууц үг, хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Chromium-д нэвтэрнэ үү</translation>
<translation id="2738871930057338499">Интернэтэд холбогдох боломжгүй байна. HTTP 403 хориотой. Прокси тохируулгаа шалгана уу.</translation>
<translation id="2753623023919742414">Хайхын тулд товшино уу</translation>
<translation id="2657110490709402112">Agent Chrome-г өгөгдмөл PDF үзэгчээрээ тохируулах</translation>
<translation id="4262158525170658092">Энэ өргөтгөл хортой программ агуулж байгаа бөгөөд аюултай байна. Үүнийг Agent Chrome-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="2799223571221894425">Дахин эхлүүлэх</translation>
<translation id="4930235474290498361">Таны Agent Chrome</translation>
<translation id="2816462166102338036">Зурган хайлтаар энэ видеог хай</translation>
<translation id="282591729717417030">iOS дээрх Chromium-р камераараа бүтээгдэхүүн олж, үнийн бууралт болон илүү ихийг явж байх зуураа хянаарай.</translation>
<translation id="2841525013647267359">Дараах хэлээс орчуулах</translation>
<translation id="2846251086934905009">Суулгах үед алдаа гарлаа: Суулгагч дуусгаагүй. Суулгалтыг тасалсан.</translation>
<translation id="2847479871509788944">Chromium-аас устгах ...</translation>
<translation id="2850691299438350830">Таныг нэвтэрсэн үед Chromium дээр таны аюулгүй байдлыг хангадаг бөгөөд Google-н бусад апп дахь таны аюулгүй байдлыг сайжруулахын тулд ашиглаж болзошгүй</translation>
<translation id="2885378588091291677">Асуудлын менежер</translation>
<translation id="8454027198329266279">Agent Chrome-ын тухай</translation>
<translation id="2915996080311180594">Дараа дахин эхлүүлэх</translation>
<translation id="2933336679234709858">Таны өгөгдлийг нэвтрэх үгээр тань шифрлэдэг. Google Бүртгэлдээ Chromium-н өгөгдлөө ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу.</translation>
<translation id="2945997411976714835">Суулгах үед алдаа гарлаа: Суулгагч явцыг эхлүүлж чадсангүй.</translation>
<translation id="2948852018303413228">iOS-т зориулсан Chromium-д хадгалсан нууц үгээ ашиглан сайтад илүү хурдан нэвтрээрэй</translation>
<translation id="80325676287146281">Танай байгууллага Agent Chrome-г удирддаг</translation>
<translation id="789940813130504773">Agent Chrome-г шинэчилсэн байна</translation>
<translation id="2977506796191543575">Хэрэв сайт таны нууц үгийг хулгайлахаар оролдох эсвэл таныг аюултай файл татах үед Chromium URL-г хуудасны бага зэрэг контентын хамт Аюулгүй үзэх рүү мөн илгээж болзошгүй</translation>
<translation id="2981563588585023386">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд Chromium-д нэвтэрнэ үү</translation>
<translation id="3003694935412297923">Бүх ажил</translation>
<translation id="3012615494352020668">{count,plural, =1{Зарим өгөгдлийг таны Google Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Chromium таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг (1 зүйл) устгана.}other{Зарим өгөгдлийг таны Google Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Chromium таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг ({count} зүйл) устгана.}}</translation>
<translation id="8084335581332031126"><ph name="URL" />-г Agent Chrome-д шинэ табд нээнэ үү.</translation>
<translation id="302551344979399011">Ур чадвар зэрэг ХОУ-ы инновацыг таны Google Бүртгэлд хадгалж, Chromium Синкээс тусад нь удирддаг</translation>
<translation id="7024173799494459794">Agent Chrome-д өгөгдөл нэмэх нь ...</translation>
<translation id="3038232873781883849">Суулгахыг хүлээж байна...</translation>
<translation id="3045032126857188731">Орчуулсан хэл: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Санал хүсэлтийн харилцах цонхыг хаах</translation>
<translation id="3068187312562070417">Chromium-н бусад профайл</translation>
<translation id="3068290154869370196">Өргөтгөл нь танд Chromium-г тусгайлан өөрчлөх боломжийг олгодог нэмэлт юм. Цэгцтэй байхаас эхлээд өдөр тутмын ажлыг хялбаршуулах хүртэл өргөтгөл танд Chromium-г өөрийн болгоход тусалдаг.</translation>
<translation id="7027973430362347863">Алдаа ослын тайлан болон <ph name="UMA_LINK" />-ыг Google рүү илгээх замаар Agent Chrome-ыг улам сайжруулахад тусална уу.</translation>
<translation id="3071024987058544609">Google-н аюулгүй байдлын онцлогуудыг явж байх зуураа авахын тулд Chromium аппыг ашиглаарай</translation>
<translation id="4925327325707966890">{NUM_DEVICES,plural, =0{1 USB төхөөрөмжид нэг эсвэл түүнээс олон Agent Chrome-н өргөтгөл хандаж байсан}=1{1 USB төхөөрөмжид нэг эсвэл түүнээс олон Agent Chrome-н өргөтгөл хандаж байна}other{# USB төхөөрөмжид нэг эсвэл түүнээс олон Agent Chrome-н өргөтгөл хандаж байна}}</translation>
<translation id="6827369771274328769">Agent Chrome-н түүх</translation>
<translation id="3103660991484857065">Програм суулгагч нь архивыг задалж үл чадсан тул Chromium-г дахин татаж авна уу.</translation>
<translation id="310459126943037700">Ажил(ууд)-ыг дуусгаж чадсангүй.</translation>
<translation id="3104828284009500087">Хуудсан дээрх аливаа зүйлийг хайна уу</translation>
<translation id="3126784891977756556">Нууц үг, хавчуурга, түүхээ төхөөрөмжүүд дээр төгс синк хийсэн байлгаарай. Та өгөгдмөл хөтчөө Chromium болгон шинэчилж мэддэг, дуртай онцлогууддаа хялбархан хандаарай.</translation>
<translation id="2894555444497054373">Agent Chrome нь таны микрофоныг ашиглаж байна.</translation>
<translation id="3130333203120345554">Шинэ хайлт</translation>
<translation id="3137969841538672700">Хайхын тулд чирнэ үү</translation>
<translation id="3144188012276422546">Энэ таб нэмэлт нөөц ашиглаж байна. Гүйцэтгэлээ сайжруулахын тулд Chromium-д энэ табыг идэвхгүй болгохыг зөвшөөрнө үү.</translation>
<translation id="3092580151719004572">Дэлгэцээ хуваалцахын тулд Системийн тохиргоонд Agent Chrome-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү</translation>
<translation id="2314296667497715523">Agent Chrome-г дахин эхлүүлэх</translation>
<translation id="3161522574479303604">Бүх хэл</translation>
<translation id="3179665906251668410">Холбоосыг Chromium-н нууцлалтай цонхонд нээх</translation>
<translation id="3185330573522821672">Chromium-н шинэ профайлаа тохируулна уу</translation>
<translation id="3189205223539394158">Та таб сэлгэхгүйгээр ХОУ-ы горимтой үргэлжлүүлэн чатлах боломжтой. Эхлүүлэхийн тулд Chromium-д нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ нууц үг болон бусад зүйлээ авна.</translation>
<translation id="3224847870593914902">Google Бүртгэлээ Chromium-с хасахын тулд Тохиргооны хуудсанд Chromium-с гарна уу</translation>
<translation id="3234316605225071811">Дараа нь Chromium танаас хадгалсан мэдээллийг танд зориулж маягтыг автоматаар бөглөхөд ашигламаар байгаа эсэхийг асууж болно</translation>
<translation id="5982289753835865194">Agent Chrome нь өөрийн өгөгдлийн сан руу уншуулж бас бичиж чадахгүй байна: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">iOS дээрх Chromium-р Google-н ХОУ-ы дуртай хэрэгслүүдээ явж байх зуураа ашиглаарай.</translation>
<translation id="3286538390144397061">Одоо дахин эхлүүлнэ үү</translation>
<translation id="3920105041734426863">Google-ийн API түлхүүр байхгүй байна. Agent Chrome-ийн зарим функц идэвхгүй болно.</translation>
<translation id="5621884903587730053">Agent Chrome-ийг хаахад ард байгаа програмуудыг ажиллуулсан хэвээр бай.</translation>
<translation id="3313189106987092621">Chromium аюултай холболт ашиглан аливаа сайтыг ачаалахаас өмнө танд сануулна</translation>
<translation id="3316771292331273802">Хэрэв та Chromium-д нэвтэрсэн бол таныг Chromium-н бүх цонхыг хаах үед Google Бүртгэлээс тань бусад ихэнх сайтаас гаргана. Сайтад таныг санахыг зөвшөөрөхийн тулд <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">хайлтын хэсгийн баруун дээд булан: баруун <ph name="RIGHT" />%, дээд <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Таны бүртгэлийн Chromium-н өгөгдөл</translation>
<translation id="3375770072980084583">Утсан дээрээ Chromium-р нууц үгнүүдээ ашиглах</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3406848076815591792">Chromium-н одоо байгаа профайл руу сэлгэх үү?</translation>
<translation id="3412460710772753638">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="3438772217992559640">Зурган хайлтаар энэ табаас хайх</translation>
<translation id="3455907671758333080">Утсан дээрээ Chromium-р Сайжруулсан аюулгүй хөтчийг өргөтгөх</translation>
<translation id="3461644266919055473">Chromium-г өөрийн болгоорой...</translation>
<translation id="3474745554856756813">Энэ нь төхөөрөмжөөс <ph name="ITEMS_COUNT" /> зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> Chromium-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="3509308970982693815">Chromium-н бүх цонхыг хаасны дараагаар дахин хандана уу.</translation>
<translation id="4449744684308538611">Цонхоо хуваалцахын тулд Системийн тохиргоонд Agent Chrome-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү</translation>
<translation id="3530103706039034513"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна.  Хөтчийн үзэлтээ тусдаа байлгахын тулд Chromium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү.</translation>
<translation id="3531741627422851418">Хөдөлгөөнт төхөөрөмж дээр Chromium хөтчийг татах QR код</translation>
<translation id="354621070532799440">Сануулагч: Google-н аюулгүй байдлын шилдэг онцлогууд таны халаасанд байна</translation>
<translation id="4902762267468919597">Дэлгэцээ хуваалцахын тулд Системийн тохиргоонд Agent Chrome-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="4199561934263811659">Сайжруулсан хамгаалалт нь Agent Chrome-н танихгүй сайтуудын JavaScript-н оновчлолыг унтраадаг</translation>
<translation id="3597003331831379823">Нэмэлт эрхтэйгээр тохируулгыг ажиллуулж чадсангүй. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">Chromium-д нэвтрэх</translation>
<translation id="3639635944603682591">Энэ хэрэглэгчийн хөтчийн өгөгдлийг энэ төхөөрөмжөөс устгана. Өгөгдлийг сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="7335807248512894660">{COUNT,plural, =0{Agent Chrome-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно.}=1{Agent Chrome-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Agent Chrome-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="3667616615096815454">Суулгах боломжгүй. Аппликэйшнийг сервер танихгүй байна.</translation>
<translation id="3675854891107786059">Google Бүртгэлийнхээ Chromium-н бүх өгөгдлийг шифрлэхийн тулд <ph name="BEGIN_LINK" />өөрийн нэвтрэх үгийг<ph name="END_LINK" /> ашиглана уу. Google Pay-н төлбөрийн хэрэгсэл, хаягийг шифрлэхгүй. Chromium-н хөтчийн түүхийг синк хийхгүй.</translation>
<translation id="3697825383460320042">{COUNT,plural, =0{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Agent Chrome-г дахин ачаалахыг таны администратор танаас хүсэж байна}=1{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Agent Chrome-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Agent Chrome-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="7584080815951640016">Холбоосыг шинэ Agent Chrome болон табад нээх</translation>
<translation id="3728124580182886854">Хувийн болгох болон бусад зорилгоор Chromium болон Google-н бусад үйлчилгээг холбоно уу</translation>
<translation id="3729187154190517324">"Таб болон бусад зүйл нэмэх" товчийг ашиглан олон таб, файл, хэрэгсэл нэмж хайлтаа гүнзгийрүүлээрэй.</translation>
<translation id="3788675262216168505">Chromium-н профайлуудыг удирдах</translation>
<translation id="9153620230534680918">Agent Chrome зарим татаж авсан файлыг яагаад блоклодог болохыг мэдэж авах</translation>
<translation id="379589255253486813">Та ямар нэг зүйлийг шалгах шаардлагатай бол Chromium танд мэдэгдэнэ</translation>
<translation id="4835254782629421085">Agent Chrome таны зочлох магадлалтай хуудаснуудыг урьдчилан ачаалах бөгөөд ингэснээр тэдгээр нь таныг зочлох үед илүү хурдан ачаална</translation>
<translation id="3810973564298564668">удирдах</translation>
<translation id="3823384748599722168">Хадгалсан нууц үгнүүдээ ашиглахын тулд QR кодыг уншуулаад, iOS-т зориулсан Chromium-г татаж, Google Бүртгэлдээ нэвтэрнэ үү</translation>
<translation id="3846683726093018685">**Хураангуйлах:** 30-аас цөөн үгтэй нэг өгүүлбэрээр дэлгэцийн агшны агуулгын үндсэн сэдэв, зорилгыг тайлбарлана уу.

          **Асуулт санал болгох:** Хэрэглэгч дэлгэцийн агшныг илүү сайн ойлгохын тулд асууж болох 3-5 бодлогошруулах асуултын жагсаалтын тэмдэгтэй жагсаалт (bulleted list) үүсгэнэ үү. Эдгээр асуултын дор хаяж нэг нь визуал объект, үүний дизайн, байршлын талаарх тодорхой асуулт байх ёстой.</translation>
<translation id="5151092236561494204"><ph name="PAGE_TITLE" /> - Agent Chrome</translation>
<translation id="387514319934708384">Chromium-д энэ сайтын хувьд дотоод сүлжээний зөвшөөрөл шаардлагатай</translation>
<translation id="3885770153807205175">Хэл сонгогч</translation>
<translation id="8310546736680726676">Agent Chrome-г өөрчилж, хянана уу. Та ямар нэг зүйлд анхаарлаа хандуулах шаардлагатай байна. Дэлгэрэнгүй мэдээлэл авахын тулд товшино уу.</translation>
<translation id="3889543394854987837">Chromium-г нээх мөн хөтөчийг ашиглаж эхлэхийн тулд өөрийн нэр дээр дарна уу.</translation>
<translation id="3892148308691398805">Текстийг хуулах</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> Chromium-н энэ профайлд аль хэдийн нэвтэрсэн байна. Таны хөтчийн үзэлтийг тусад нь байлгахын тулд Chromium танд өөрийн гэсэн профайл үүсгэж өгөх боломжтой.</translation>
<translation id="334040592769172771">Энэ өргөтгөл Chrome Веб Дэлгүүрийн бодлогыг зөрчиж байгаа бөгөөд аюултай байж магадгүй. Үүнийг Agent Chrome-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="3941890832296813527">Суулгах үед алдаа гарлаа: Суулгагчийн файлын нэр буруу эсвэл дэмжигдээгүй.</translation>
<translation id="3945058413678539331">Chromium нь нууц үгс хуулахыг оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="3954172517175569325">Таны Google Бүртгэлдээ хадгалсан нууц үг, төлбөрийн хэрэгсэл, хаягуудыг энэ төхөөрөмжөөс хасна. Тэдгээрийг Chromium-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="395904275706073188">Хамгаалагдсан хуудсыг унших боломжгүй. Өөр хуудас туршиж үзнэ үү.</translation>
<translation id="3962647064319009959">Chromium таныг хэрхэн аюулгүй байлгадаг болохыг мэдэж авна уу</translation>
<translation id="3967822245660637423">Татаж авч дууслаа</translation>
<translation id="6274881217831291926">Таныг хаяг оруулах хэсэг, хайх хэсэгт шивэх үед Agent Chrome зөвлөмж авахын тулд таны шивсэн зүйлийг танай байгууллагын хайлт, ХОУ, агентын хэрэгслүүд рүү илгээдэг.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing-н тухай</translation>
<translation id="3997429360543082038">ChromiumOS-н тухай</translation>
<translation id="8089050973791989914">Таныг сайтад зочлоход Agent Chrome таны IP хаягийг нуудаг нууцлалын серверээр дамжуулан URL-н будилуулсан хэсгийг <ph name="BEGIN_LINK" />Google-н аюулгүй хөтөч<ph name="END_LINK" /> рүү илгээнэ. Хэрэв сайт ямар нэг сэжигтэй зүйл хийвэл бүтэн URL, хуудасны контентын багахан хэсгийг мөн илгээнэ.</translation>
<translation id="4016217212818346953">Нууц үгний менежерээр аюулгүй байгаарай</translation>
<translation id="4019629340646866719">ChromiumOS-г <ph name="BEGIN_LINK_LINUX_OSS" />Linux-н хөгжүүлэлтийн орчин <ph name="END_LINK_LINUX_OSS" /> болох нэмэлт <ph name="BEGIN_LINK_CROS_OSS" />нээлттэй эх кодын программ хангамжаар<ph name="END_LINK_CROS_OSS" /> боломжтой болгосон.</translation>
<translation id="4022972681110646219">Дэлгэцийг орчуулах</translation>
<translation id="4023601594785368013">Эх хэл: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Дурын аппаас холбоосыг Chromium-д нээнэ үү. Түүнчлэн хялбар хандахад зориулж үүнийг таны ажлын хэсэгт бэхэлдэг.</translation>
<translation id="2466379549068383575"><ph name="BEGIN_LINK" />Одоогийн тохиргоог<ph name="END_LINK" /> мэдэгдэж Agent Chrome-г сайжруулахад тусална уу</translation>
<translation id="4050175100176540509">Хамгийн сүүлийн хувилбар дээр аюулгүй байдлын чухал сайжруулалт болон шинэ функцийг санал болгож байна.</translation>
<translation id="4055805654398742145">Нууц үгний менежер</translation>
<translation id="409373329602981607">{COUNT,plural, =1{Agent Chrome-г 1 минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}other{Agent Chrome-г # минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}}</translation>
<translation id="4118474109249235144">Chromium-н нууцлалын горим</translation>
<translation id="4122186850977583290">Chromium-н тухай хуудас руу очно уу</translation>
<translation id="4135244987012252068">Хөтчидөө шинэ дүр төрх өгөхийн тулд Chromium-г тусгайлан өөрчилнө үү</translation>
<translation id="4147856324248078748">Chromium-аа тусгайлан өөрчлөх</translation>
<translation id="4148957013307229264">Суулгаж байна...</translation>
<translation id="2058774528396152893"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх - Agent Chrome</translation>
<translation id="7685529984676330289">Agent Chrome-д зориулсан гайхалтай апп, тоглоом, өргөтгөл болон дэлгэцийн зургуудыг олж сонирхоорой.</translation>
<translation id="4217080900579554343">Энэ өргөтгөл болон илүү ихийг бүх компьютер дээрээ авахын тулд Chromium-д нэвтэрнэ үү</translation>
<translation id="4217972271355023382">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд та <ph name="USER_EMAIL_ADDRESS" />-р хэдийн нэвтэрсэн Chromium профайл руугаа сэлгэнэ үү</translation>
<translation id="4222932583846282852">Цуцалж байна...</translation>
<translation id="4224210481850767180">Суулгах үйлдлийг цуцалсан.</translation>
<translation id="4230135487732243613">Та өөрийн Chromium өгөгдлийг энэ хаягтай холбох хүсэлтэй байна уу?</translation>
<translation id="274377438883177878">Стандарт хамгаалалтаас илүүтэйгээр сайтуудын бусад өгөгдлийг задлан шинжилснээр танд аюултай сайтуудын талаар сануулах бөгөөд эдгээрт Google-н өмнө нь мэдээгүй сайт ч багтана. Та Agent Chrome-н сануулгыг алгасахаар сонгох боломжтой.</translation>
<translation id="4269093074552541569">Chromium-с гарах</translation>
<translation id="8361584154950824008">Agent Chrome-с тусламж авах</translation>
<translation id="4281844954008187215">Үйлчилгээний нөхцөл</translation>
<translation id="4285930937574705105">Гэнэтийн асуудлаас болж суулгах ажиллагаа амжилтгүй боллоо. Хэрвээ Chromium яг одоо ажиллаж байгаа бол хаагаад дахин оролдож үзнэ үү.</translation>
<translation id="4298125729853015961">Chromium-с нууц үг экспортлох</translation>
<translation id="4304713468139749426">Нууц үгний менежер</translation>
<translation id="4334241893986177674">Энэ дэлгэцийн агшнаас хайх</translation>
<translation id="4368547723231502008">Chromium-г жижгэрүүлсэн байсан ч хүссэн газраасаа хайж, асуулт асуугаарай</translation>
<translation id="1172096072757635810">Windows-г эхлэх үед Agent Chrome-г эхлүүлэх</translation>
<translation id="4400772909124543403">Шинэчлэлт боломжгүй байна</translation>
<translation id="8069611125329654712">Ямар ч байсан Agent Chrome-с гарах уу?</translation>
<translation id="4413205837991854510">Зурган хайлтын товчлолыг үргэлж харуулах</translation>
<translation id="3727041326435831325">Agent Chrome-г цаана ажиллуулахыг зөвшөөрөх</translation>
<translation id="1713490836766202786">{NUM_EXTENSIONS,plural, =1{Agent Chrome танд үүнийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK" />Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" />}other{Agent Chrome танд эдгээрийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK" />Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" />}}</translation>
<translation id="7567010943765939594">Agent Chrome-ыг гүйцэтгэх ба хянах</translation>
<translation id="4427306783828095590">Сайжруулсан хамгаалалт нь фишинг болон хортой кодыг блоклохын тулд илүү ихийг хийдэг</translation>
<translation id="4434353761996769206">Суулгагчийн алдаа: <ph name="INSTALLER_ERROR" /></translation>
<translation id="7498286168885369820"><ph name="MANAGER" /> Agent Chrome-г удирддаг</translation>
<translation id="444069871276811466">Chromium-н профайл нэмэх</translation>
<translation id="4447409407328223819">Chrome for Testing-н тухай</translation>
<translation id="4470974262661801543">Google Бүртгэлийнхээ Chromium-н өгөгдлийг ашиглах болон хадгалахын тулд нэвтрэх үгээ оруулна уу</translation>
<translation id="4493028449971051158">Эхлэхэд алдаа гарлаа: суулгагчийг администратораар дахин ажиллуулна уу.</translation>
<translation id="4501471624619070934">Энэ улсад хандалтыг хязгаарласан тул суулгаж чадсангүй.</translation>
<translation id="4615766574627629942">Энэ өргөтгөл өгөгдлийг хэрхэн цуглуулж, ашигладаг гэх мэт нууцлалын практикаа нийтлээгүй байна. Agent Chrome танд үүнийг хасахыг зөвлөж байна.</translation>
<translation id="452711251841752011">Chromium-д тавтай морилно уу; хөтчийн шинэ цонхыг нээсэн</translation>
<translation id="4531137820806573936">Таны орчин тойрныг зураглаж, гарыг тань тандахад Chromium-д зөвшөөрөл шаардлагатай</translation>
<translation id="4536805923587466102">Та <ph name="USER_EMAIL_ADDRESS" /> хаягаараа Chromium-н өөр профайлд аль хэдийн нэвтэрсэн байна</translation>
<translation id="5945053225725114995">Agent Chrome хуудаснуудыг урьдчилан ачаалах бөгөөд энэ нь үзэх, хайхыг илүү хурдан болгоно. <ph name="BEGIN_LINK" />Хуудас урьдчилан ачаалах талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Хортой гэж бодож буй сайтыг мэдээлж, хүн бүрийн онлайн аюулгүй байдлыг сайжруулахад тусална уу.</translation>
<translation id="2899198307620821227">Та Safe Browsing-г унтраасан бөгөөд файлыг баталгаажуулах боломжгүй тул Agent Chrome энэ таталтыг блоклосон</translation>
<translation id="4583692638088316420">Утсан дээрээ Chromium-р Google Lens-г туршиж үзэх</translation>
<translation id="4594305310729380060">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="6944119370969619446">Agent Chrome App</translation>
<translation id="4598116752460667024">Жагсаалтаас ямар нэг явцыг хайна уу.</translation>
<translation id="4613863813562375431">ChromiumOS-н хувилбар</translation>
<translation id="6401103202303237090">Удахгүй шинэчилж дууслаа! Agent Chrome-н шинэчлэлийг дуусгахын тулд дахин ачаалж эхлүүлнэ үү.</translation>
<translation id="4807663225386362301">Agent Chrome-н V8 системээр сайтыг хурдасгах ч Agent Chrome-г халдлагад арай тэсвэр багатай болгоно</translation>
<translation id="4626321472657185181">Chromium-р хайхыг нээх</translation>
<translation id="521912697020157864">Анхааруулга: Agent Chrome өргөтгөлүүдийг таны хөтчийн түүхийг бичихээс хамгаалж чадахгүй. Энэ өргөтгөлийг Нууцлалтай горимд идэвхгүй болгохын тулд энэ сонголтыг болиулна уу.</translation>
<translation id="4673151026126227699">Хэрэв та мөн Chromium-н ашиглалтын тайланг хуваалцвал тэдгээр тайланд таны зочилсон URL багтана</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" />-р гишүүнчлэлийн эрхтэйгээр нэвтэрсэн. Бүртгэлийн цэсийг нээх</translation>
<translation id="5833534934470627293">Хувийн мэдээллийг (<ph name="HOST_NAME" />) өөр компьютер дээр өөр Agent Chrome үйлдэлд (<ph name="PROCESS_ID" />) ашиглаж байна гэж харагдаж байна. Agent Chrome-аас хувийн мэдээллийг түгжсэн байгаа учраас үүнийг өөр зүйлд ашиглах боломжгүй юм. Хэрэв та өөр ямар ч үйлдэлд энэ хувийн мэдээллийг ашиглахгүй байгаа гэдэгт та итгэлтэй байгаа бол хувийн мэдээллээ цоожилж Agent Chrome-ыг дахин эхлүүлж болно.</translation>
<translation id="4680828127924988555">Суулгахыг цуцлах</translation>
<translation id="469259825538636168">Таны Chromium-н зарим өгөгдлийг одоогоор Google Бүртгэлд тань хадгалаагүй байна. Гарахаасаа өмнө хэдэн минут хүлээж үзнэ үү. Хэрэв та одоо гарвал энэ өгөгдлийг устгана.</translation>
<translation id="4708193446201257833">Та нэвтэрсэн байхдаа Chromium-д Google Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. <ph name="SHORTCUT" /> таны Google-н үйлчилгээний тохиргоог өөрчлөх боломжтой.</translation>
<translation id="4708774505295300557">Хэн нэгэн энэ компьютерт <ph name="ACCOUNT_EMAIL_LAST" /> бүртгэлээр Chromium-д нэвтэрсэн байна. Мэдээллээ тусад нь хадгалахын тулд Chromium-н шинэ хэрэглэгч үүсгэнэ үү.</translation>
<translation id="4724676981607797757">Дэмжигдээгүй протоколын алдааны улмаас суулгалт амжилтгүй болсон.</translation>
<translation id="2783410850122241193">Ямар ч байсан Agent Chrome-г орхих уу?</translation>
<translation id="4748217263233248895">Chromium-н аюулгүй байдлын тусгай шинэчлэлт хийгдэж дууслаа. Одоо дахин эхлүүлнэ үү. Бид таны табыг сэргээх болно.</translation>
<translation id="4771701986670315895">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> болон өөр <ph name="COUNT" /> зөвшөөрлийг хассан.</translation>
<translation id="4786083865378785874">Хэрэв Chromium дахь Gemini нээлттэй бол шинэ таб үүсгэхэд хажуугийн самбар нээлттэй хэвээр байна</translation>
<translation id="479167709087336770">Энэ нь Google хайлтад ашигладаг зөв бичгийн ижил алдаа шалгагчийг ашигладаг. Таны хөтчид бичсэн текстийг Google-д илгээдэг. Та энэ ажиллах төлөвийг хүссэн үедээ тохиргоонд өөрчилж болно</translation>
<translation id="4814736265800133385">Chromium-г бүртгэлгүйгээр ашиглах</translation>
<translation id="4888717733111232871">MDNS урсгалыг зөвшөөрөхийн тулд Chromium-д зориулсан хөндлөнгийн дүрэм.</translation>
<translation id="5600814355607573136">&amp;Agent Chrome-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="4918086044614829423">Хүлээн зөвшөөрөх</translation>
<translation id="4918844574251943176">Зургийг хуулсан</translation>
<translation id="4943838377383847465">Chromium нь суурь горимд байна.</translation>
<translation id="494490797786467921">Chromium-н нэвтрэх харилцах цонхыг хаахын тулд товшино уу</translation>
<translation id="4950660488495335294">Та Chromium профайлаар Chromium-н бүх зүйлээ тусгаарлах боломжтой. Найз, гэр бүлийнхэндээ зориулж профайл үүсгэх эсвэл ажил, зугааг ялгаж салгаарай.</translation>
<translation id="4987820182225656817">Зочид Chromium-ийг ашигласнаар хамгийн сүүлийн үеийн мэдээллийг авна.</translation>
<translation id="4992938037305302429">Таны Chromium дахь бүртгэл</translation>
<translation id="4994636714258228724">Өөрийгөө Chromium руу нэмэх</translation>
<translation id="504699503110800016">Урт цэсийг нээх</translation>
<translation id="5074496654342756568"><ph name="DEVICE_TYPE" /> дээрээ Chromium-р Google-н бүх дуртай зүйлдээ хандаарай</translation>
<translation id="5123973130450702873">Chromium-д таны гарыг хянах зөвшөөрөл шаардлагатай</translation>
<translation id="5141988424377517949">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />-г хассан.</translation>
<translation id="5174969993834422967">Та ихэвчлэн мэдэгдлийг блоклодог. Энэ сайтад танд мэдэгдэхийг зөвшөөрөхийн тулд байршлын хэсгийн тань баруун дээд буланд байх мэдэгдлийн дүрс тэмдгийг товшино уу.</translation>
<translation id="5174983315706567306">Дискийн зай хангалтгүй байна.</translation>
<translation id="5187123684706427865">Chromium бүртгэл дахин баталгаажуулахыг шаарддаг</translation>
<translation id="5223510345050543907">iOS дээрх Chromium-р яг орхисон газраасаа үргэлжлүүлээрэй.</translation>
<translation id="5231355151045086930">Chromium-с гарах</translation>
<translation id="5234764350956374838">Хэрэгсэхгүй болго</translation>
<translation id="5249261924633168472">Холбоосыг Chromium-н нууцлалтай цонхонд нээх</translation>
<translation id="5276305953263010518">Chromium аппыг аваад явж байх зуураа нууц үгээ хадгалаарай</translation>
<translation id="1601187459465935178">Өөрчлөлтөө хэрэгжүүлэхийн тулд Agent Chrome-г дахин ажиллуулна уу</translation>
<translation id="5286907366254680517">Илэрсэн</translation>
<translation id="5289287148052354622">Chromium аппыг авах</translation>
<translation id="5294316920224716406">Нууцлалын горимд үзэх үед Chromium аюултай холболт ашиглан сайтыг ачаалахаас өмнө танд сануулна</translation>
<translation id="5296581118566748922">Chromium-р хайх</translation>
<translation id="5313228254328109263">Chromium Шинэчлэгч дотоод үйлчилгээ</translation>
<translation id="5324450571874973775">Тэдгээрийг Chromium дахь Gemini-н бусад онцлогийн хамт ашиглана уу</translation>
<translation id="5346389065299425353">Олон таб, файл, хэрэгсэл нэмж хайлтаа гүнзгийрүүлээрэй</translation>
<translation id="5348677704241861105">Энэ баримт бичгийн шуурхай тоймыг авч, Chromium дахь Gemini-р асуулт асуугаарай</translation>
<translation id="5352264705793813212">Chromium таны шалгавал зохих аюулгүй байдлын зарим зөвлөмжийг оллоо</translation>
<translation id="5352361688875342522">Chromium-н бусад профайл</translation>
<translation id="535243042947607642">Таны бүртгэлийн нэвтрэх дэлгэрэнгүй мэдээлэл хуучирсан тул ChromiumOS таны Google Бүртгэлд Chromium-н өгөгдлийг хадгалж чадсангүй</translation>
<translation id="5358375970380395591">Та удирдан ажиллаж буй хаягт нэвтэрч байгаагаас гадна таны Chromium профайлыг хянах эрхийг системийн ажилтанд шилжүүлж байна. Таны апп, хавчуурга, түүх, нууц үг болон бусад тохиргоо гэх мэт таны Chromium өгөгдлийг <ph name="USER_NAME" />-тэй холбох болно. Та энэхүү өгөгдлийг Google Accounts Dashboard-р дамжуулан устгах боломжтой боловч та энэхүү өгөгдлийн өөр хаягтай холбох боломжгүй байна. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Нэмэлт код: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Хувийн болгох онцлогийг авахын тулд Chromium-г Веб, аппын үйл ажиллагаанд оруулна уу</translation>
<translation id="5382964351116519680">Chromium-р хайхыг нээх</translation>
<translation id="2524054769026663683">Agent Chrome зарим файлыг яагаад блоклодог болохыг мэдэж авах</translation>
<translation id="8615009965479156445">Agent Chrome-г шинэчилж байна (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Chromium-д нэвтрэхийг зөвшөөрөх</translation>
<translation id="6256236118124872626">Agent Chrome-аас устга</translation>
<translation id="5774731921051444461">Гүйцэтгэлийг багасгах ч Agent Chrome-г халдлагад илүү тэсвэртэй болгоно</translation>
<translation id="5427571867875391349">Chromium-ыг өөрийн анхдагч веб хөтөч болгон тохируулах</translation>
<translation id="8709870882148322247"><ph name="PAGE_TITLE" /> - Agent Chrome Бета</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Chromium таны хөтчийг удаашруулж буй табыг түр зогсоохыг зөвлөж байна}other{Chromium таны хөтчийг удаашруулж буй табуудыг түр зогсоохыг зөвлөж байна}}</translation>
<translation id="3217425685577630218">Үүнийг Linux дистрибьютер дээр цаашид дэмжихгүй тул Agent Chrome буруу ажиллаж болзошгүй</translation>
<translation id="1045655099853558439">Файл таны хувийн болон сошиал сүлжээний бүртгэлүүдэд хор хөнөөл учруулах боломжтой тул Agent Chrome энэ таталтыг блоклосон</translation>
<translation id="549669000822060376">Chromium нь хамгийн сүүлийн үеийн системийн шинэчлэлтүүдийг суулгаж байгаа тул түр хүлээнэ үү.</translation>
<translation id="5496810170689441661">Chromium нь нууц үгсийг засах гэж оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="549975168243349205">Chromium-р Google Драйв, YouTube зэрэг дуртай апп дээрээ явж байх зуураа саадгүй ажиллаарай.</translation>
<translation id="5524890928877629608">хайлтын хэсгийн зүүн дээд булан: зүүн <ph name="LEFT" />%, дээд <ph name="TOP" />%</translation>
<translation id="565863787292824328">PDF-г Agent Chrome-д нээх</translation>
<translation id="5536164441519929134">Энэ табын талаар<ph name="LINE_BREAK" />асуух</translation>
<translation id="8869089999448782168">Аюулгүй байдлын үүднээс таныг анх удаа сайтад зочлоход Agent Chrome JavaScript-н оновчлолыг унтраадаг.

Хэрэв энэ хуудас хүлээлтийн дагуу ажиллахгүй байвал оновчлолыг зөвшөөрч үзнэ үү.</translation>
<translation id="5575874067957905201">Mac-н цэсийн мөрд Chromium дахь Gemini-г харуулж, товчлуурын шууд холбоосыг асаана уу</translation>
<translation id="5576587363991567745"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Chromium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с хадгалсан мэдээлэл болон бусад зүйлээ авна.</translation>
<translation id="5579324208890605088">Эхлэхэд алдаа гарлаа: суулгагчийг администратораар бус, энгийн хэрэглэгчээр ажиллуулна уу.</translation>
<translation id="5580770360767802657">Chromium-г өгөгдмөлөөр ашиглаж, бэхлээрэй</translation>
<translation id="5596627076506792578">Бусад сонголт</translation>
<translation id="5605834417512968703">Зурган хайлтаар хайхыг хүссэн зүйлээ сонгох эсвэл Зурган хайлтаас гарахын тулд escape-г дарна уу</translation>
<translation id="5618818588972826921">Зурган хайлтаар хайхын тулд дурын текст, зургийг сонгох эсвэл Зурган хайлтаас гарахын тулд escape дээр дарна уу</translation>
<translation id="4814380868372526025">{0,plural, =0{Agent Chrome-н шинэчлэлт боломжтой байна}=1{Agent Chrome-н шинэчлэлт боломжтой байна}other{Agent Chrome-н шинэчлэлт # хоногийн турш боломжтой байсаар байна}}</translation>
<translation id="188722644954983559">Таныг Agent Chrome-г хаах үед төхөөрөмжөөс тань сайтын өгөгдлийг үргэлж устгана</translation>
<translation id="5653831366781983928">Chromium-г одоо дахин эхлүүлнэ үү</translation>
<translation id="5690427481109656848">Google ХХК</translation>
<translation id="1525044488102751845">Agent Chrome-г энэ хэлээр харуулах</translation>
<translation id="569897634095159764">Интернэтэд холбогдох боломжгүй байна. Прокси сервер баталгаажуулалт шаарддаг.</translation>
<translation id="7750959567789509941">Agent Chrome идэвхгүй табуудаас санах ойг суллана. Энэ нь идэвхтэй табууд болон бусад аппад компьютерын илүү их нөөцийг өгч, Agent Chrome-г хурдан байлгана. Таныг идэвхгүй табууд руугаа буцаж очиход тэдгээр таб автоматаар дахин идэвхтэй болно. <ph name="BEGIN_LINK" />Санах ой хэмнэгчийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">Хэрэв та нэвтрэх үгээ мартсан эсвэл энэ тохиргоог өөрчлөхийг хүсвэл бүртгэлийнхээ Chromium-н өгөгдлийг <ph name="SETTINGS_LINK" /></translation>
<translation id="5800158606660203929">Chromium-г өөрчилж, хянана уу. Chromium-г өгөгдмөлөөрөө тохируулна уу.</translation>
<translation id="5802618941556161431">Chromium-г өгөгдмөл хөтчөөрөө тохируулснаар нууц үг, хавчуурга, түүхээ төхөөрөмжүүд дээр төгс синк хийсээр байгаарай.</translation>
<translation id="5809516625706423866">Интернэтэд холбогдох боломжгүй байна. HTTP 401 зөвшөөрөлгүй. Прокси тохируулгаа шалгана уу.</translation>
<translation id="2755468387099310604">Agent Chrome-н V8 системээр сайтыг хурдасгах ч Agent Chrome-г халдлагад арай тэсвэр багатай болгоно. Энэ тохиргоо унтраалттай байна.</translation>
<translation id="5821520528363214608">Google Бүртгэлдээ Chromium-н өгөгдлийг ашиглах болон хадгалахын тулд Chromium-г шинэчилнэ үү</translation>
<translation id="5824893331272123205">Энэ түр зуурын самбарыг ачаалж чадсангүй. Дахин оролдоно уу</translation>
<translation id="8972968824660717915">Agent Chrome-д тавтай морил</translation>
<translation id="8898055105597601099">Agent Chrome-н хамгийн хүчтэй хамгаалалтаар хангахын тулд нэмэлт онцлогуудыг асаана</translation>
<translation id="5871205389137001634">Зурган хайлтаас гарахын тулд товшино уу</translation>
<translation id="9158119422063615519">Эдгээр зүйл хортой программ агуулж байгааг Agent Chrome олж мэдлээ:</translation>
<translation id="5889361821821684993">Chromium таны хөтөч хамгийн аюулгүй тохиргоотой болохыг баталгаажуулахаар тогтмол шалгадаг. Та ямар нэг зүйлийг шалгах шаардлагатай бол бид танд мэдэгдэнэ.</translation>
<translation id="5895138241574237353">Дахин асаах</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх</translation>
<translation id="5924017743176219022">Интернэтэд холбогдож байна...</translation>
<translation id="5939553720811388432">Таны Chromium-г бэлэн болгоцгооё</translation>
<translation id="5941711191222866238">Багасгах</translation>
<translation id="5949225980829865667">Энэ хавчуурга болон бусад зүйлийг бүх төхөөрөмж дээрээ авахын тулд Chromium-д нэвтэрнэ үү</translation>
<translation id="5953657885167112863">Chromium-г өөрийн болгох</translation>
<translation id="5960071705175224773">Таны тохиргоог тодорхойгүй апп өөрчилсөн</translation>
<translation id="5977420883993828287">Бэхэлсэн! Хэрэгслийн мөрөөс Хам сэдэвт ажлыг дахин ашиглана уу</translation>
<translation id="1956376169666014494">{COUNT,plural, =1{Agent Chrome-г 1 минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана.}other{Agent Chrome-г # минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана.}}</translation>
<translation id="5987687638152509985">Синкийг эхлүүлэхийн тулд Chromium-г шинэчлэх</translation>
<translation id="5990360079535151574">Та үзэх явцдаа асуулт асуухын тулд хэрэгслийн мөр дээрх "Хам сэдэвт ажил" товчноос Хам сэдэвт ажлыг дахин нээх боломжтой</translation>
<translation id="6003112304606738118">Татаж байна... <ph name="HOURS" /> цаг үлдсэн</translation>
<translation id="6009821354356307391">Араас нь лавлаж асуух</translation>
<translation id="6040143037577758943">Хаах</translation>
<translation id="6044357424127037044">Та <ph name="DEVICE_TYPE" /> дээрээ Chromium аппыг ашиглахдаа онлайн худалдан авалтаас илүү ихийг аваарай</translation>
<translation id="6058380562449900225">Өгөгдлөө хамгаалахын тулд Chromium-д таны ойрын хугацаанд зочлоогүй сайтуудаас зөвшөөрлүүдийг хасахыг зөвшөөрнө үү. Мэдэгдлүүдийг зогсоохгүй.</translation>
<translation id="6063093106622310249">&amp;Chromium-д нээх</translation>
<translation id="6069027071882229820">Зургаар хуулах</translation>
<translation id="8654038583091834120"><ph name="EXTENSION_NAME" />-г Agent Chrome-д нэмсэн</translation>
<translation id="8940723094351907049">Agent Chrome-г тохируулж, хянана уу. Шинэчлэх боломжтой.</translation>
<translation id="334648248941185659">Асаалттай • Agent Chrome энэ өргөтгөлийг хаанаас гаралтай болохыг баталгаажуулах боломжгүй</translation>
<translation id="611228897408671387">Таны Chromium дахь бүртгэл</translation>
<translation id="1961808482688487456">Өргөтгөлд Agent Chrome-н самбарт хандах хүсэлт харуулахыг зөвшөөрнө үү</translation>
<translation id="6880945371922378763"><ph name="FILE_NAME" /> аюултай тул үүнийг Agent Chrome блок хийсэн.</translation>
<translation id="829957199361894387">Agent Chrome удахгүй хаах бөгөөд өгөгдлийг устгана</translation>
<translation id="6145820983052037069">Та энд Chromium-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="8333733115616087710">Та күүкиг зөвшөөрсөн тохиолдолд Agent Chrome тэдгээрийг урьдчилан ачаалах үед ашиглаж магадгүй</translation>
<translation id="6165508094623778733">Нэмэлт мэдээлэл авах</translation>
<translation id="6173308241973263798">Бүртгэлийнхээ Chromium-н өгөгдлийг арилгана уу</translation>
<translation id="8439223334931595792">Энэ файл аюултай байж магадгүй<ph name="LINE_BREAK" />Хэрэв та нууц үгээр хангавал Agent Chrome энэ татаж авсан файлыг танд шалгаж өгөх боломжтой. Файлын талаарх мэдээллийг Google-н аюулгүй хөтөч рүү илгээдэг хэдий ч тухайн файлын контент болон нууц үг таны төхөөрөмжид үлддэг.</translation>
<translation id="6182736845697986886">Шинэчлэлтийн серверийн дотоод алдааны улмаас суулгалт амжилтгүй болсон.</translation>
<translation id="6183079672144801177">Та Chromium-д өөрийн <ph name="TARGET_DEVICE_NAME" />-с нэвтэрсэн эсэхээ шалгаад, дахин илгээхээр оролдоно уу.</translation>
<translation id="6212496753309875659">Энэ компьютерт Chromium-ийн хамгийн сүүлийн үеийн хувилбар байна. Хэрэв программ ажиллахгүй байвал Chromium-ийг устгаад, дахин суурьлуулж үзнэ үү.</translation>
<translation id="6375381612105819561">{0,plural, =0{Agent Chrome-г одоо дахин ажиллуулна}=1{Agent Chrome-г 1 секундийн дотор дахин ажиллуулна}other{Agent Chrome-г # секундийн дотор дахин ажиллуулна}}</translation>
<translation id="6241367896540709610">Файл татахын тулд Chromium-д хадгалах санд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="6245734527075554892">Chromium-д хадгалсан аюултай сайтын жагсаалттай URL-г шалгана</translation>
<translation id="5070229316792137581">Agent Chrome-ыг анхдагч веб хөтөч болгох</translation>
<translation id="6248988683584659830">Хайлтын тохиргоо</translation>
<translation id="6261803579884938625">Утсан дээрээ Chromium аппыг ашиглан явж байх зуураа Google-н аюулгүй байдлын шилдэг онцлогуудыг аваарай</translation>
<translation id="6268381023930128611">Chromium-с гарах уу?</translation>
<translation id="6270547683008298381">Эдгээр таб нэмэлт нөөцүүдийг ашиглаж байна. Гүйцэтгэлээ сайжруулахын тулд Chromium-д эдгээр табыг идэвхгүй болгохыг зөвшөөрнө үү.</translation>
<translation id="6281746429495226318">Chromium-н профайлаа өөрчлөх</translation>
<translation id="6290827346642914212">Chromium-н профайлаа нэрлэнэ үү</translation>
<translation id="6294831894865512704">Өргөтгөл таныг Chromium-д нэвтрэхийг хүсэж байна</translation>
<translation id="1356965940380155951"><ph name="FILE_NAME" /> аюултай байж болзошгүй тул үүнийг Agent Chrome блок хийсэн.</translation>
<translation id="7321042153033393145">Agent Chrome таны камерыг ашиглаж байна.</translation>
<translation id="6333502561965082103">Chromium-д өөр үйл ажиллагаа явагдаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="6334986366598267305">Одоо та Google хаягаа ашиглан мөн өөр бусад компьютер дээр Chromium-г ашиглахад хялбар боллоо.</translation>
<translation id="6347002662287820329">Chromium-г өгөгдмөл хөтчөөрөө тохируулж мэддэг, дуртай, итгэдэг онцлогууддаа хялбархан хандаарай.</translation>
<translation id="6663103136563143835">Agent Chrome-н товчлол</translation>
<translation id="8324836837188781073">Файлыг ихэвчлэн татдаггүй бөгөөд энэ нь аюултай байж магадгүй тул Agent Chrome энэ таталтыг блоклосон</translation>
<translation id="6373523479360886564">Та Chromium-ыг устгахыг хүсэж байгаадаа итгэлтэй байна уу?</translation>
<translation id="6375219077595103062">Нууц үгний менежерт товчлол нэмэх</translation>
<translation id="6388799252195623474">надад үүнд тусална уу</translation>
<translation id="6390800440335263989">Үргэлжлүүлэхийн тулд Chromium-д <ph name="EMAIL" />-р нэвтэрнэ үү. Энэ нь таныг байгууллагынхаа бодлогыг хүлээн авсныг баталгаажуулна.</translation>
<translation id="6400112897226594999">Компьютерын дэлгэц доторх Chromium-н лого.</translation>
<translation id="6403826409255603130">Chromium бол веб хуудсууд болон аппликейшнуудыг цахилгааны хурдаар ажиллуулдаг веб хөтөч юм. Энэ нь хурдан, найдвартай мөн хэрэглэхэд хялбар. Chromium-д бий болгосон хорт вирус болон фишингийн хамгаалалтыг ашиглан вебээр илүү аюулгүй хайлт хийгээрэй.</translation>
<translation id="6414624068245092115">Та Google Бүртгэлдээ Chromium-н өгөгдлийг үргэлж ашиглах, хадгалах боломжтой болохоо нягтлахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="5698692159722140301">Agent Chrome илүү хурдан ажилладаг бөгөөд JavaScript-г ашигладаг онцлогууд зориулалтын дагуу ажиллах ёстой</translation>
<translation id="6436260184216827876">Зурган хайлт боломжгүй байна. Дараа дахин оролдоно уу.</translation>
<translation id="6442900851116057561">ChromiumOS-г дахин эхлүүлнэ үү</translation>
<translation id="1150325299163558144">Agent Chrome таны зочлох магадлалтай илүү олон хуудсыг урьдчилан ачаалах бөгөөд ингэснээр тэдгээр нь таныг зочлох үед илүү хурдан ачаална</translation>
<translation id="6450948450282634257">Үнэ хянаж, аливаа сайт дээр үнэ буурахад мэдэгдэл авахын тулд утсан дээрээ Chromium-г татаарай</translation>
<translation id="2302438614865168038">Унтраалттай • Agent Chrome энэ өргөтгөлийг хаанаас гаралтай болохыг баталгаажуулах боломжгүй</translation>
<translation id="6455857529632101747">Chromium профайлд тавтай морилно уу</translation>
<translation id="6460614424172581323">Та дараагийн удаа <ph name="DEVICE_TYPE" /> дээрээ Chromium-г нээхэд табын бүлгийг ашиглах сануулга харагдана.</translation>
<translation id="6466344609055215035">Chromium-с бүртгэл хасах</translation>
<translation id="5526497172610025231">Энэ нь мөн таныг Agent Chrome-ыг эхлүүлж байх үед гарч ирсэн хуудсыг хянадаг.</translation>
<translation id="648319183876919572">Сайжруулсан аюулгүй хөтөч нь таныг аюултай вебсайт болон таталтаас хамгаалахын тулд илүү ихийг хийдэг</translation>
<translation id="6510925080656968729">Chromium-ийг устгах</translation>
<translation id="124295298108005714">Agent Chrome-д нээх товчлол</translation>
<translation id="9177671044583442813">Танай байгууллага Agent Chrome-г <ph name="TIMEOUT_DURATION" />-н турш ашиглаагүй үед хаадаг. Интернэтээр үзсэн өгөгдлийг устгасан. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.</translation>
<translation id="6542839706527980775">Профайл тус бүр Chromium-н өөрийн мэдээллийг агуулах бөгөөд үүнд хавчуурга, түүх, нууц үг болон бусад мэдээлэл багтана</translation>
<translation id="6556755379298048869">Гарын товчлолоор хайна уу</translation>
<translation id="5677032436425073715"><ph name="BEGIN_LINK" />Agent Chrome таны өгөгдлийг хэрхэн хувийн байлгадаг<ph name="END_LINK" /> талаар нэмэлт мэдээлэл авах</translation>
<translation id="5967753610833950399">Энэ тохиргооны өөрчлөлтийг Agent Chrome-г дахин эхлүүлсний дараа оруулна.</translation>
<translation id="4790842900919490952">Agent Chrome-н үндсэн цэс дэх Өргөтгөл дээр товшиж өргөтгөлүүдээ удирдана уу.</translation>
<translation id="656935081669708576">Та өөр Chromium профайлаас нууц үгнүүдийг харахын тулд шилжих боломжтой</translation>
<translation id="6569556444379005948">Хамгийн сайн ХОУ-ы хэрэгслүүдийг явж байх зуураа ашиглахын тулд Chromium аппыг ашиглаарай</translation>
<translation id="8124768693572849485">Зөв бичгийн алдааг засахын тулд Agent Chrome таны текстийн талбарт бичсэн текстийг Google-д илгээдэг</translation>
<translation id="6598877126913850652">Chromium-н мэдэгдлийн тохиргоо руу очих</translation>
<translation id="6600016381025017075">Энэ хуудсан дээрх дурын зүйлийг хайх</translation>
<translation id="1736130262142947818">Таныг Agent Chrome дахин эхлүүлэхэд өөрчлөлт идэвхжинэ.</translation>
<translation id="6637908313088374648">Chromium одоо Windows-г эхлэх үед эхэлдэг болсон тул та шуурхай үзэж эхлэх боломжтой боллоо. Та үүнийг тохиргооноос унтрааж болно.</translation>
<translation id="6648212540664651655">Орхисон газраасаа үргэлжлүүлнэ үү: Chromium таны сүүлийн харилцан үйлдлийн табуудыг сэргээсэн. Та үүнийг дараахаас унтрааж болно</translation>
<translation id="665732753414869868">Таны эргэн тойрны 3D газрын зургийг үүсгэхийн тулд Chromium-д камерын зөвшөөрөл шаардлагатай</translation>
<translation id="6669284030132180248">Хэрэв та мөн хавчуургаа Google Бүртгэлдээ хадгалдаг бол бүтээгдэхүүний үнийг Chromium-д хянаж, үнэ буурах үед мэдэгдэл авах боломжтой</translation>
<translation id="6676384891291319759">Интернэтэд нэвтрэх</translation>
<translation id="668175097507315160">Нэвтрэх алдааны улмаас ChromiumOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="6691132793308828750">Энэ аппын өгөгдлийг Chromium-с хасах</translation>
<translation id="6709350901466051922">Chromium-д энэ сайтад зориулж микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="6712881677154121168">Татахад алдаа гарлаа: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="7755971898820142787">Таны профайлыг ашиглах боломжгүй байна. Учир нь энэ Agent Chrome-ийн шинэ хувилбараас ирсэн байна.

Зарим функц ажиллахгүй байж болно. профайлын өөр зааварчилгааг тодорхойлж өгөх эсвэл Agent Chrome-ийн шинэ хувилбарыг ашиглана уу.</translation>
<translation id="6729124504294600478">Хувийн болгох болон бусад онцлогийг авахын тулд Chromium-г Веб, аппын үйл ажиллагаа болон Google-н холбосон үйлчилгээнүүдэд оруулна уу</translation>
<translation id="6734291798041940871">Chromium-г таны компьютерийн бүх хэрэглэгчид суулгасан байна.</translation>
<translation id="6742093177587589736">Хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Chromium-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ хавчуургыг Google Бүртгэлд тань хадгална.</translation>
<translation id="7821834337023193240">Agent Chrome-н V8 системээр сайтыг хурдасгах ч Agent Chrome-г халдлагад арай тэсвэр багатай болгоно. Энэ тохиргоо асаалттай байна.</translation>
<translation id="6754665438209053659">{count,plural, =1{Таны Chromium-н зарим өгөгдлийг Google Бүртгэлд тань хараахан хадгалаагүй байна. Гарахаасаа өмнө хэдэн минут хүлээж үзнэ үү. Хэрэв та одоо гарвал энэ өгөгдлийг (1 зүйл) устгана.}other{Таны Chromium-н зарим өгөгдлийг Google Бүртгэлд тань хараахан хадгалаагүй байна. Гарахаасаа өмнө хэдэн минут хүлээж үзнэ үү. Хэрэв та одоо гарвал энэ өгөгдлийг ({count} зүйл) устгана.}}</translation>
<translation id="67706546131546258">Энэ файл аюултай байж магадгүй тул Chromium үүнийг скан хийхийг зөвлөж байна.</translation>
<translation id="6779406956731413166">ChromiumOS-г нэмэлт <ph name="BEGIN_LINK_CROS_OSS" />нээлттэй эх кодын программ хангамжаар<ph name="END_LINK_CROS_OSS" /> боломжтой болгосон.</translation>
<translation id="6831043979455480757">Хөрвүүлэх</translation>
<translation id="6847869444787758381">Хэрэв таны нууц үг алдагдсан байвал Chromium танд мэдэгдэнэ</translation>
<translation id="684888714667046800">Интернэтэд холбогдох боломжгүй байна. Хэрэв та галт хана ашиглавал <ph name="PRODUCT_EXE_NAME" />-г зөвшөөрсөн жагсаалтад байгаа болохыг баталгаажуулна уу.</translation>
<translation id="6219638737609534419">Agent Chrome - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Үргэлжлүүлэхийн тулд Tab дээр дарна уу</translation>
<translation id="6862030660799253820">Зурган хайлтаар энэ зургийг хай</translation>
<translation id="6869568587896659271">Хаяг оруулах хэсгийн доорх вебсайтуудад хялбархан хандаарай</translation>
<translation id="7421523967177993052">"<ph name="EXTENSION_NAME" />" хортой программ агуулж байгааг Agent Chrome олж мэдлээ</translation>
<translation id="6877155553248388166">хайлтын хэсгийн баруун доод булан: баруун <ph name="RIGHT" />%, доод <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Хуулах</translation>
<translation id="6898028264630240901">Та үзэх явцдаа асуулт асуухын тулд Хам сэдэвт ажлыг бэхлэх боломжтой</translation>
<translation id="6901631050894301805">Chromium-г өгөгдмөл хөтчөөрөө тохируулж, ажлын хэсэгтээ бэхэлнэ үү</translation>
<translation id="6909503629704372277">&amp;Chromium-н профайлуудыг удирдах</translation>
<translation id="9199111398679939226">Энэ үйлдэл:
          <ph name="LINE_BREAKS" />
            • Таны эхлүүлэх хуудас, шинэ таб хуудас, хайлтын систем, бэхэлсэн табыг шинэчилнэ
            <ph name="LINE_BREAK" />
            • Өргөтгөлүүдийг идэвхгүй болгоно
            <ph name="LINE_BREAK" />
            • Күүки болон сайтын бусад түр өгөгдлийг устгана
            <ph name="LINE_BREAK" />
            • Agent Chrome-н товчлолуудыг шинэчилнэ
            <ph name="LINE_BREAKS" />
            Хавчуурга, түүх, хадгалсан нууц үгэнд нөлөөлөхгүй.</translation>
<translation id="6948031725951063910">Та Chromium-н <ph name="BOOKMARK_LIMIT" /> хавчуургын хязгаарт хүрсэн тул таны зарим хавчуургыг Google Бүртгэлд тань хараахан хадгалаагүй байна.

Та зарим хавчуургаа устгах хүртэл бүртгэлдээ шинэ хавчуурга хадгалах боломжгүй. Хэрэв та одоо гарвал хадгалаагүй хавчуургыг устгана.</translation>
<translation id="6964305034639999644">Холбоосыг Chromium-н нууцлалтай цонхонд нээх</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">ChromiumOS-н нөхцөл</translation>
<translation id="7003299027384820442"><ph name="ACCOUNT_EMAIL" /> бүртгэлдээ Chromium-н өгөгдлийг ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу</translation>
<translation id="7011190694940573312">Үйлдлийн системийн энэ хувилбарыг дэмждэггүй тул суулгалт амжилтгүй боллоо.</translation>
<translation id="7024536598735240744">Задлахад алдаа гарлаа: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7045244423563602563">Chromium-г өөрийн болгоoрой</translation>
<translation id="7047386856539490735">Эдгээр илэрц хэрэг болж байна уу?</translation>
<translation id="705851970750939768">Chromium-г шинэчлэх</translation>
<translation id="1222890016986172619">Хэрэв зурагт хэрэгтэй тайлбар байхгүй бол Agent Chrome танд тайлбар өгөхөөр оролдох болно. Тайлбар үүсгэхийн тулд зургийг Google-д илгээнэ.</translation>
<translation id="7074836723476134809"><ph name="DEVICE_TYPE" /> дээрээ Chromium аппыг ашиглахдаа ХОУ-ы хүчийг аваарай</translation>
<translation id="7134687062119989071">Утсан дээрээ Chromium аппыг ашиглан нууц үг, таб болон бусад зүйлээ явж байх зуураа аваарай</translation>
<translation id="7141270731789036260">Chrome for Testing-г өөрчлөх</translation>
<translation id="5669948510815930830">Та мессеж, баримт бичиг болон бусад апп дахь холбоосон дээр товших бүрдээ Agent Chrome-г ашиглах боломжтой</translation>
<translation id="5576210706466474421"><ph name="EXTENSION_NAME" />-г Agent Chrome-с хасах</translation>
<translation id="4588941330171478873">Танай байгууллага Agent Chrome-г <ph name="TIMEOUT_DURATION" />-н турш ашиглаагүй үед өгөгдлийг нь устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.</translation>
<translation id="718435575166326686">Chromium-д энэ сайтад зориулж камерын зөвшөөрөл шаардлагатай</translation>
<translation id="2916059341902838041">Agent Chrome-г эхлүүлж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="7204669035546236137">Chromium дахь Gemini-р байгаа газраасаа хүссэн зүйлээ асуугаарай</translation>
<translation id="1716746018761150810">Хүссэн үедээ Agent Chrome руу түргэн очихын тулд суурилуулагчдаа байлгана уу</translation>
<translation id="7213407614656404070">Та мессеж, документ болон бусад аппын холбоосыг товших бүрдээ Chromium-г ашиглана уу</translation>
<translation id="7216228761061470870">Таныг Зурган хайлтыг компьютер дээр ашиглахад хуудасны гарчиг, URL, PDF зэрэг контентыг сервер лүү илгээдэг</translation>
<translation id="4816956813330284757">Бодлогын менежер - Agent Chrome</translation>
<translation id="7227958669698166857"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Chromium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ хадгалсан мэдээлэл болон бусад зүйлээ авна.</translation>
<translation id="7252276985725323153">Шуурхай үзэж эхлээрэй: Chromium одоо Windows-г эхлэх үед эхлэх боломжтой боллоо.</translation>
<translation id="7274695763216404502">Бэхэлсэн! Самбараас Зурган хайлтыг дахин ашиглана уу</translation>
<translation id="7288567540154601580">Таб, өргөтгөл</translation>
<translation id="3631444715156784168">{NUM_EXTENSIONS,plural, =1{Agent Chrome танд үүнийг хасахыг зөвлөж байна}other{Agent Chrome танд тэдгээрийг хасахыг зөвлөж байна}}</translation>
<translation id="2739521415810397215">Системийн аудиог хуваалцахын тулд Системийн тохиргоог нээгээд, Agent Chrome-д 'Зөвхөн системийн аудио бичлэг'-ийг зөвшөөрнө үү. Та дараа нь Agent Chrome-г дахин эхлүүлэх шаардлагатай.</translation>
<translation id="1945073734373493421">Agent Chrome-г шинэчилж байна</translation>
<translation id="7323500970718355745">Таны тохиргоо файл алдаатай эсвэл хүчин төгөлдөр бус байна. Agent Chrome таны тохиргоог сэргээх боломжгүй байна.</translation>
<translation id="7324051657739063017">Та үзэх явцдаа асуулт асуухын тулд Хам сэдэвт ажлыг дахин нээх боломжтой</translation>
<translation id="734373864078049451">Таны веб хуудас, хавчуурга, болон бусад Chromium-ийн зүйлс энд байдаг.</translation>
<translation id="7347827960336370838">Зөвхөн таны нэвтрэх үгтэй хүн шифрлэгдсэн өгөгдлийг тань унших боломжтой. Нэвтрэх үгийг Google-д илгээдэггүй бөгөөд хадгалдаггүй. Хэрэв та нэвтрэх үгээ мартсан эсвэл энэ тохиргоог өөрчилмөөр байвал <ph name="BEGIN_LINK" />бүртгэлийнхээ Chromium-н өгөгдлийг устгах<ph name="END_LINK" /> шаардлагатай болно.</translation>
<translation id="7994662313190863803">Таны системийн админ Agent Chrome-г<ph name="TARGET_URL_HOSTNAME" />-д хандахын тулд <ph name="ALTERNATIVE_BROWSER_NAME" />-г нээхээр тохируулсан байна.</translation>
<translation id="7352651011704765696">Алдаа гарсан байна</translation>
<translation id="4438212735766904761">Agent Chrome-н цаашдын шинэчлэлтийг авахын тулд танд macOS 13 эсвэл түүнээс хойших хувилбар хэрэг болно. Энэ компьютер macOS 12 хувилбарыг ашиглаж байна.</translation>
<translation id="7376384068949534168">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />-г хассан.</translation>
<translation id="73786666777299047">Chrome Веб Дэлгүүр нээх</translation>
<translation id="7394275517973019558">Системийн жижиг тэмдэг бүхий хэсэгт Chromium дахь Gemini-г харуулах</translation>
<translation id="7401687852903179959">Зурган хайлтаар энэ видеоноос хайх</translation>
<translation id="7407655596887111931">Chromium таны өгөгдмөл хөтөч боллоо</translation>
<translation id="3957050361764426740">Орхисон газраасаа үргэлжлүүлнэ үү: Agent Chrome таныг дахин эхлүүлэх бүрд табуудыг тань сэргээнэ. Үүнийг унтраахын тулд дараах руу очно уу</translation>
<translation id="7427879960656355200">Нууц үгийг Chromium руу импортлох</translation>
<translation id="744815265653811511">1. Доорх <ph name="BUTTON_LABEL" /> дээр товшино уу Windows-н тохиргоондоо <ph name="BUTTON_2" /> дээр товшино уу Chromium-г ажлын хэсэгтээ бэхэлж, шуурхай хандахын тулд Windows-н мэдэгдэлд <ph name="BUTTON_3" /> дээр товшино уу</translation>
<translation id="4378256924846450484"><ph name="PAGE_TITLE" /> - Agent Chrome Дев</translation>
<translation id="7450541714075000668">Текстийг хуулсан</translation>
<translation id="1661210845845599119">Микрофоноо ашиглахын тулд <ph name="BEGIN_LINK" />системийн тохиргоонд<ph name="END_LINK" /> Agent Chrome-д хандах эрх өгнө үү</translation>
<translation id="7461356015007898716">Chromium-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 7-г ашиглаж байна.</translation>
<translation id="7782360127659485548">Agent Chrome-г дахин эхлүүлэх үү?</translation>
<translation id="7483335560992089831">Одоо ажиллаж байгаа Chromium-ын ижил хувилбарыг суулгаж чадахгүй байна. Chromium-аа хаагаад дахин оролдоно уу.</translation>
<translation id="7510190804000607802">Сануулагч: Google-н шилдэг зүйлс таны халаасанд</translation>
<translation id="4114725046952451715">Сайтууд тооцоолсноор ажиллах байх. Хэрэв та Agent Chrome-д нэвтэрсэн бол таныг Agent Chrome-н бүх цонхыг хаах үед Google Бүртгэлээс тань бусад ихэнх сайтаас гаргана.</translation>
<translation id="8460803820751380899">{0,plural, =1{Agent Chrome-г 1 минутын дотор дахин ажиллуулна}other{Agent Chrome-г # минутын дотор дахин ажиллуулна}}</translation>
<translation id="7565444033145385702">Өгөгдлөө хамгаалахын тулд Chromium-д таны сүүлийн үед зочлоогүй сайтын зөвшөөрлийг хасахыг зөвшөөрнө үү.</translation>
<translation id="7806190892617295204">Шууд үзэж эхлэхийн тулд Agent Chrome-г автоматаар эхлүүлнэ үү.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> суулгагч</translation>
<translation id="4114499337401148821">Agent Chrome нь таны камер болон микрофоныг ашиглаж байна.</translation>
<translation id="7617377681829253106">Chromium сайжирлаа</translation>
<translation id="4075526625511660913">Та одоо Agent Chrome-н бусад онцлогийг ашиглах боломжтой боллоо</translation>
<translation id="7624307931717240213">Бид энэ үйлчилгээг сайжруулахад мэдээллийг ашигладаг. Нууцлалын бодлого, Үйлчилгээний нөхцөлийг харна уу.</translation>
<translation id="7649070708921625228">Тусламж</translation>
<translation id="7650134251917003571">Chromium аппыг авах</translation>
<translation id="7658239707568436148">Болих</translation>
<translation id="5829091955527196771">Agent Chrome таны өгөгдмөл хөтөч биш юм</translation>
<translation id="7689606757190482937">Төхөөрөмжүүддээ Chromium-г синк хийж, хувийн болгох</translation>
<translation id="7699779824407626136">Chromium-н шинэчлэлт</translation>
<translation id="7700735928747402058">Таны ажлыг Chromium дээр хамгаалсан</translation>
<translation id="7716950018788545737">Ажил(ууд) дууссан.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" />-д зориулж системийн ул мөрийн үйлчилгээгээр хангадаг. Хэрэв энэ үйлчилгээг идэвхгүй болгосон бол хөтчийн үүсгэсэн гүйцэтгэлийн ул мөрд хам сэдэв сэлгэх болон дэд процессыг бэлдэх үйл явдал зэрэг систем дээрх үйл явдлуудыг оруулахгүй.</translation>
<translation id="7745317241717453663">Энэ нь төхөөрөмжөөс таны хайлтын түүхийг устгана. Өгөгдлөө дараа сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="7747138024166251722">Суулгагч нь түр зуурын хадгалалтын санг үүсгэж чадсангүй. Дискэнд сул зай байгаа эсэхийг мөн программ хангамж суулгах зөвшөөрлийг шалгана уу.</translation>
<translation id="7747820849741499258">Chromium-с хайх</translation>
<translation id="7750130090210923118">Өгөгдмөл Chromium руу шинэчлэх</translation>
<translation id="7752521946322750699">Таны Chromium дээрх ажлыг хамгаалахын тулд таныг Chromium-д нэвтрэхэд танай байгууллага тодорхой мэдээллийг харах, удирдах боломжтой болно.</translation>
<translation id="7781047659465034537">Chromium-г өгөгдмөлөөр тохируулж, ажлын хэсэгт бэхэлнэ үү</translation>
<translation id="7786760609782648049">Chromium-г илүү хурдан болгоорой</translation>
<translation id="1092858669153166534"><ph name="PAGE_TITLE" /> - Agent Chrome Канари</translation>
<translation id="6890902183809417868">Таны интернэтийн ачаалалд хандах эрхтэй хүмүүст таны зочилдог сайтуудыг харахыг илүү хүндрэлтэй болгоно. Agent Chrome DNS-с (Домэйн нэрийн систем) сайтын IP хаягийг хайхад аюулгүй холболт ашигладаг.</translation>
<translation id="7810005234485217901">Та хялбар хандахын тулд Зурган хайлтыг бэхлэх боломжтой</translation>
<translation id="4343938787674079986">Agent Chrome-тай юу хуваалцахаа сонгох</translation>
<translation id="7828947555739565424">Энэ бүртгэлтэй Chromium-н профайл аль хэдийн энэ төхөөрөмж дээр байна</translation>
<translation id="7845233973568007926">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө компьютероо дахин эхлүүлэх ёстой.</translation>
<translation id="6129792107484731038">Таны хайлтын системийг Agent Chrome-с гадуур өөрчилсөн. Таныг хамгаалахын тулд Agent Chrome үүнийг эх өгөгдмөл тохиргоо руу нь шинэчилсэн. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="7853661403199074278">Chromium-д шинэ дүр төрх өгөхийн тулд тусгайлан өөрчилнө үү</translation>
<translation id="5018331886385637870">Таныг хаяг оруулах хэсэг эсвэл хайх хэсэгт бичих үед Agent Chrome илүү сайн зөвлөмж авахын тулд таны бичсэн зүйлийг өгөгдмөл хайлтын системд тань илгээдэг. Энэ нь Нууцлалтай горимд унтраалттай.</translation>
<translation id="473441635289092936">Agent Chrome-г хамгийн сүүлийн хувилбарт шинэчлээгүй тул та шинэ онцлог болон аюулгүй байдлын засвар авах боломжгүй байна.</translation>
<translation id="7872446069773932638">Татаж байна... <ph name="SECONDS" /> секунд үлдсэн</translation>
<translation id="7873537467422636035">Хэрэв та нэвтрэх үгээ мартсан эсвэл энэ тохиргоог өөрчилмөөр байвал <ph name="BEGIN_LINK" />бүртгэлийнхээ Chromium-н өгөгдлийг устгана уу<ph name="END_LINK" /></translation>
<translation id="7874369989024033742">Танд хэрэг болох бүрд Chromium дахь Gemini-г шуурхай нээгээрэй</translation>
<translation id="7888981273428720788">Chromium-г өгөгдмөлөөрөө тохируулах</translation>
<translation id="7934340546140346950">Chromium боломжтой үед аюултай холболтыг HTTPS рүү автоматаар сайжруулдаг</translation>
<translation id="7937630085815544518">Та Chromium-д <ph name="USER_EMAIL_ADDRESS" />-аар нэвтэрсэн байна. Нэвтрэхийн тулд ижил данс хэрэглэнэ үү.</translation>
<translation id="7944602660083060118"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Chromium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ хавчуурга болон бусад зүйлээ авна.</translation>
<translation id="688313102897865477">Энэ нь Agent Chrome-н хоёр дахь суулгалт тул таны өгөгдмөл хөтчөөр сонгох боломжгүй.</translation>
<translation id="8514782479541580218">Тодорхойгүй эх сурвалжийн өргөтгөл, апп болон загвар нь таны төхөөрөмжийг гэмтээх боломжтой. Agent Chrome тэдгээрийг зөвхөн <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-с суулгахыг зөвлөж байна</translation>
<translation id="8000759043835159571"><ph name="DEVICE_TYPE" /> дээрээ Chromium аппаар Google-н шилдэг зүйлсийг аваарай</translation>
<translation id="8004582292198964060">Хөтөч</translation>
<translation id="8010081455002666927">Автоматаар илрүүлэх</translation>
<translation id="403216574291780144">Agent Chrome-д хандалт олгосны дараа веб сайтууд таны хандалтыг асуух боломжтой болно.</translation>
<translation id="7835197459694498831">Agent Chrome-д хүссэн үедээ шуурхай очихын тулд ажлын хэсэгтээ бэхэлнэ үү</translation>
<translation id="80471789339884597">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө бүх хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="8054112667659782652">Зурган хайлтын товчлолыг үргэлж харуулах</translation>
<translation id="8069447462453318634">"Хэрэгслийн мөрд бэхлэх" гэснийг сонгоно уу</translation>
<translation id="787536271006179882">Аппуудын хувьд Agent Chrome-г дэвсгэрт ажиллуулахыг идэвхгүй болгох</translation>
<translation id="80790299200510644">Зурган хайлт</translation>
<translation id="8086881907087796310">Таны компьютер техник хангамжийн доод шаардлагад нийцэхгүй байгаа тул суулгалт амжилтгүй болсон.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="8105840573057009683">Chromium-д энэ сайтад зориулж байршлын зөвшөөрөл шаардлагатай</translation>
<translation id="8107060931443639922">Та дараагийн удаа <ph name="DEVICE_TYPE" /> дээрээ Chromium-г нээхэд үнэ мөшгөх дохиог идэвхжүүлэх сануулга харагдана.</translation>
<translation id="8117908349476699973">Утсан дээрээ Chromium аппаар сонирхож буй зүйлсийнхээ үнэ буурсан талаарх сэрэмжлүүлгийг аваарай</translation>
<translation id="8118331347066725040">Lens-р хайхад зориулж санал хүсэлт илгээх</translation>
<translation id="8130609355518033382">Chromium-г өөрийн болгох</translation>
<translation id="8133124826068723441">Синк нь таны домэйнд боломжгүй тул ChromiumOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="813913629614996137">Эхлүүлж байна…</translation>
<translation id="8161503455832158203">Товчлуурын шууд холбоосоор Chromium дахь Gemini-г нээгээрэй.</translation>
<translation id="7109772131778940712">Agent Chrome-н Үйлчилгээний нэмэлт нөхцөл</translation>
<translation id="7759642951398174884">Энэ файл аюултай тул Agent Chrome блоклосон байна.</translation>
<translation id="8177472873527554730">Хуудаснаас контент олж чадсангүй</translation>
<translation id="8200109504272824693"><ph name="USER_EMAIL" /> бүртгэлдээ Chromium-н өгөгдлийг ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу</translation>
<translation id="820759916613250543">Зурган хайлтаар энэ зургаас хайх</translation>
<translation id="8221491193165283816">Та ихэвчлэн мэдэгдлийг хориглодог. Энэ сайтад танд мэдэгдэхийг зөвшөөрөхийн тулд энд товшино уу.</translation>
<translation id="5410773870087525304">Камераа ашиглахын тулд <ph name="BEGIN_LINK" />системийн тохиргоонд<ph name="END_LINK" /> Agent Chrome-д хандах эрх өгнө үү</translation>
<translation id="1057772683559103555">Agent Chrome энэ өргөтгөлийг хаанаас ирсэн болохыг баталгаажуулах боломжгүй ба энэ нь аюултай байж магадгүй. Үүнийг Agent Chrome-с хассанаар энэ нь цаашид хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="1968416200800224093">Хэрэв зурагт хэрэгтэй тайлбар байхгүй бол Agent Chrome танд тайлбар өгөхөөр оролдох болно. Тайлбар үүсгэхийн тулд зургийг Google-д илгээнэ. Та үүнийг хүссэн үедээ тохиргоонд унтрааж болно.</translation>
<translation id="8254601181414348851">Chromium-д шинэ профайлаар нэвтрэх үү?</translation>
<translation id="8262224117913639129"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Chromium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с нууц үг болон бусад зүйлээ авна.</translation>
<translation id="8277334259226003205">Системийн жижиг тэмдэг бүхий хэсэгт Chromium дахь Gemini-г харуулж, товчлуурын шууд холбоосыг асаана уу</translation>
<translation id="8286943863733751221">Аюултай сайт болон татаж авсан файлын талаар <ph name="BEGIN_LINK" />Chromium танд сануулна<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION" />-г хассан.</translation>
<translation id="8296236834352487533">Chromium iOS апп дээр харж буй зүйлээ камераараа худалдан авч, орчуулж, тодорхойлоорой</translation>
<translation id="8310603974518734211"><ph name="USER_NAME" />-р Chromium-д нэвтрэх QR код</translation>
<translation id="8313851650939857356">Эхлэхэд алдаа гарлаа: <ph name="STARTUP_ERROR" />.</translation>
<translation id="2256229026962116267">Танай байгууллага Agent Chrome-г <ph name="TIMEOUT_DURATION" />-н турш ашиглаагүй үед хаадаг.</translation>
<translation id="8321888067342493336">Зургаар хадгалах</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> өмнө нь Chromium-г ашиглаж байсан</translation>
<translation id="8351551329754447960">Chromium-д Ур чадварыг идэвхжүүлэх</translation>
<translation id="8359544530202147897"><ph name="ACCOUNT_EMAIL" /> Google Бүртгэлдээ Chromium-н өгөгдлөө ашигласаар байхын тулд Chromium-г шинэчилнэ үү</translation>
<translation id="8360718212975266891">Chromium-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 8-г ашиглаж байна.</translation>
<translation id="8362914115861174987">Дараах руу орчуулах</translation>
<translation id="8367705492654390392">Хүссэн зүйлээ асуугаарай</translation>
<translation id="8370517070665726704">Зохиогчийн эрх <ph name="YEAR" /> Google ХХК. Бүх эрх хуулиар хамгаалагдсан.</translation>
<translation id="8372327902843331129">Нууц үг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Chromium-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ нууц үгийг Google Бүртгэлд тань хадгална.</translation>
<translation id="3962779702290581702">Та тэгээд Agent Chrome-г дахин эхлүүлэх шаардлагатай болно.</translation>
<translation id="6085013152567092546">Agent Chrome танд үүнийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK" />Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="8142784445734351509">Энэ өргөтгөлийг хөгжүүлэгч нь нийтлэхээ больсон бөгөөд энэ нь аюултай байж магадгүй. Үүнийг Agent Chrome-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="8416884904046428725">Зарим өгөгдлийг таны Google Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Chromium таныг мөн болохыг баталгаажуулах шаардлагатай. Хэрэв та одоо гарвал энэ өгөгдлийг устгана.</translation>
<translation id="7611805576553766531">{0,plural, =1{Agent Chrome-г 1 хоногийн дотор дахин ажиллуулна уу}other{Agent Chrome-г # хоногийн дотор дахин ажиллуулна уу}}</translation>
<translation id="8438543370129609977">Таныг Зурган хайлтыг ашиглахад хуудасны гарчиг, URL, PDF зэрэг контентыг сервер лүү илгээдэг. <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">Chromium-д Зурган хайлтаар хайх талаар нэмэлт мэдээлэл авах</translation>
<translation id="8453117565092476964">Суулгагчийн архив устгагдсан эсвэл хүчингүй болсон байна. Chromium-ыг дахин татаж авна уу.</translation>
<translation id="8458614432758743027">Chromium нь Windows 10 эсвэл түүнээс дээших хувилбарыг шаарддаг.</translation>
<translation id="8463672209299734063">Заавал биш: Оношилгоо болон ашиглалтын өгөгдлийг Google-д автоматаар илгээснээр ChromiumOS-н онцлогууд, гүйцэтгэлийг сайжруулахад тусална уу.</translation>
<translation id="8471947159125090285">Google Бүртгэлдээ Chromium-н өгөгдлийг ашиглах, хадгалахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="8482493977473846331">Chromium-д нэвтрэх заавар харуулна</translation>
<translation id="6049002268233195982">Agent Chrome нь хуучирсан байна</translation>
<translation id="6156435126546305838">Agent Chrome-г өгөгдмөл хөтчөөрөө сонгосонд баярлалаа!</translation>
<translation id="8522801943730206384">Таныг нууц үгнүүдээ хадгалах үед Chromium тэдгээрийг шалгах боломжтой</translation>
<translation id="8525579356836940628">Суулгахыг зогсоосон</translation>
<translation id="8545729292258443488"><ph name="DEVICE_TYPE" /> дээрээ Chromium аппыг ашиглан нууц үг, таб болон бусад зүйлээ явж байх зуураа аваарай</translation>
<translation id="8548787790260785208">Хэрэв Chromium таны аль нэг нууц үгийг олон нийтийн өгөгдлийн зөрчлөөс олбол сануулга аваарай</translation>
<translation id="8555465886620020932">Үйлчилгээний алдаа: <ph name="SERVICE_ERROR" />.</translation>
<translation id="2713372071612730965">Agent Chrome-н зарим онцлог, өргөтгөл товчлолтой ирдэг. Та тэдгээрийг буцааж асааж болно.</translation>
<translation id="8556420416730706394">Та хялбар хандахын тулд Зурган хайлтыг бэхлэх боломжтой. Хажуугийн самбарын дээд талд байх Бэхлэх товчийг товшино уу</translation>
<translation id="856656450041460113">Хэлний жагсаалтаас хайх</translation>
<translation id="1783040386392706016">Олон байгууллага Agent Chrome-г удирддаг</translation>
<translation id="7921569471494089882">Agent Chrome-ийн зохиогчийн эрх <ph name="YEAR" />. Бүх эрхийг хуулиар хамгаалсан.</translation>
<translation id="8601359445272098721">Шинэ! Та "дэлгэцийг орчуулах" товчийг сонгож дэлгэц дээрх текст, зургийн аль алиныг орчуулах боломжтой</translation>
<translation id="6294059080097269555">Agent Chrome-г эхлүүлж байна...</translation>
<translation id="8624541899164515475">Тохиргоо, шинэ табд нээгдэнэ.</translation>
<translation id="8648201657708811153">Google Chrome for Testing-г өгөгдмөл хөтчөө болгох боломжгүй.</translation>
<translation id="5652647471010716562">Энэ нь мөн таныг Agent Chrome-ыг эхлүүлж байх үед эсвэл Omnibox-аас хайлт хийж буй үед гарч ирдэг хуудсыг хянаж байдаг.</translation>
<translation id="8704119203788522458">Энэ бол таны Chromium.</translation>
<translation id="8712637175834984815">Ойлголоо</translation>
<translation id="8719993436687031146">Chromium-д нэвтрэх үү?</translation>
<translation id="8747073452963259673">хайлтын хэсгийн зүүн доод булан: зүүн <ph name="LEFT" />%, доод <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Суулгах үед алдаа гарлаа: Танай сүлжээний админ суулгалтаас сэргийлдэг Бүлгийн бодлогыг хэрэгжүүлсэн: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Надад дараа сануулах</translation>
<translation id="8816416449795340678">Шуурхай тойм авах, араас нь лавлах асуулт асуухын тулд энэ баримт бичгийг Chromium дахь Gemini-тай хуваалцана уу</translation>
<translation id="8818550178040858407">Chromium-д нэвтрэх үү?</translation>
<translation id="4188893721116572726">Agent Chrome-г өгөгдмөл хөтөч болгож, ажлын хэсэгт бэхэлнэ үү</translation>
<translation id="8826492472752484139">“Нууц үгний менежер”-ийг товшино уу</translation>
<translation id="8833697763442816810">ChromiumOS систем</translation>
<translation id="341256515309503869">Энэ хэлийг Agent Chrome-д цэс, тохиргоо, сэрэмжлүүлэг болон бусад текстийг үзүүлэхэд ашигладаг</translation>
<translation id="8862326446509486874">Танд системийн түвшинд суулгах зохих эрх байхгүй байна. Суулгагчийг админы хувиар дахин ажиллуулахыг оролдож үзнэ үү.</translation>
<translation id="8876044221123442390">Chromium-н профайл нэмэх</translation>
<translation id="8890569919834781711">Нэвтрэх алдааны улмаас ChromiumOS таны Google Бүртгэлд Chromium-н өгөгдлийг хадгалж чадсангүй</translation>
<translation id="8891709362986793894">Танай байгууллага таныг Chromium-д нэвтрэхийг шаардаж байна</translation>
<translation id="8907580949721785412">Chromium нь нууц үгийг харуулахыг оролдож байна. Үүнийг зөвшөөрөхөөр бол  Windows нууц үгээ бичнэ үү.</translation>
<translation id="8932992523185907506">Chromium таны өгөгдмөл хөтөч биш болсон байна. Chromium-г өгөгдмөл хөтөч болгох уу?</translation>
<translation id="2086624065931944916">Agent Chrome-г шинэчилж чадсангүй</translation>
<translation id="8944232836376404813">Энэ үйлдэл:
          <ph name="LINE_BREAKS" />
            • Таны эхлүүлэх хуудас, шинэ таб хуудас, хайлтын систем, бэхэлсэн табыг шинэчилнэ
            <ph name="LINE_BREAK" />
            • Өргөтгөлүүдийг идэвхгүй болгоно
            <ph name="LINE_BREAK" />
            • Күүки болон сайтын бусад түр өгөгдлийг устгана
            <ph name="LINE_BREAKS" />
            Хавчуурга, түүх, хадгалсан нууц үгэнд нөлөөлөхгүй.</translation>
<translation id="8966875421152977384">Chromium-н сайтын товчлолуудыг харуулах</translation>
<translation id="4591081057798655502">Agent Chrome Enterprise-н лого</translation>
<translation id="8980139959902937527"><ph name="DEVICE_TYPE" /> дээрээ Chromium аппыг ашиглан Google-н аюулгүй байдлын онцлогуудыг явж байх зуураа аваарай</translation>
<translation id="352721818246741864">Таны профайлыг нээхэд ямар нэг алдаа гарсан тул Agent Chrome-г эхлүүлэх боломжгүй. Agent Chrome-г дахин эхлүүлж үзнэ үү.</translation>
<translation id="8988036198400390003">Chromium-н профайлуудыг удирдах</translation>
<translation id="8993855408334954620">Chromium дахь Gemini, нээлттэй табынхаа хооронд шилжихэд гараа ашиглана уу.</translation>
<translation id="9018218886431812662">Суулгаж дууссан</translation>
<translation id="9019929317751753759">Chromium-г илүү аюулгүй болгохын тулд <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> жагсаалтанд байхгүй, танд мэдэгдэлгүйгээр нэмэгдсэн байж болох дараах өргөтгөлийг идэвхгүй болголоо.</translation>
<translation id="9022552996538154597">Chromium дансандаа нэвтрэх</translation>
<translation id="9035791714111278917">Mac-н цэсийн мөрд Chromium дахь хайлтыг харуулж, гарын товчлолыг асаагаарай</translation>
<translation id="144293525744948128">Архивын файлд хортой программыг нууж байж магадгүй бусад файл багтдаг тул Agent Chrome энэ таталтыг блоклосон</translation>
<translation id="9053882453960391422">Нууц үг, хавчуурга, түүхээ төхөөрөмжүүд дээр төгс синк хийсээр байгаарай. Та өгөгдмөл хөтчөө Chromium болгон шинэчлээд мэддэг, дуртай онцлогууддаа хялбархан хандаарай. Chromium-г шуурхай хандахад зориулж таны ажлын хэсэгт бэхэлнэ.</translation>
<translation id="9056398481763999048">Утсан дээрээ Chromium аппаар Google-н шилдэг ХОУ-ы хэрэгслүүдийг ашиглаарай</translation>
<translation id="9062666675513499497">Та Google-н бусад үйлчилгээнд нэвтрэх үедээ Chromium-д нэвтэрнэ үү</translation>
<translation id="5989671354018094677">Agent Chrome-г автоматаар хаасан</translation>
<translation id="5288426372256126088">Agent Chrome хуучирсан байна</translation>
<translation id="8599483501705081932">{0,plural, =1{Agent Chrome-г 1 цагийн дотор дахин ажиллуулна}other{Agent Chrome-г # цагийн дотор дахин ажиллуулна}}</translation>
<translation id="9106236359747881194">Хайх текстийг сонгоно уу</translation>
<translation id="9106612006984859720">Chromium-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 8.1-г ашиглаж байна.</translation>
<translation id="6660967356554387137">Холбоосыг шинэ Agent Chrome болон табад нээх</translation>
<translation id="911206726377975832">Хайлтын мэдээллээ бас устгамаар байна уу?</translation>
<translation id="9134482777260927479">Гэрийн даалгаврын тусламж</translation>
<translation id="9148058034647219655">гарах</translation>
<translation id="356554850028684199">Орхисон газраасаа үргэлжлүүлнэ үү: Agent Chrome таныг дахин эхлүүлэх бүрд табуудыг тань сэргээж болно. Үүнийг асаахын тулд дараах руу очно уу</translation>
<translation id="2217675621893057123">Таны системийн админ Agent Chrome-г<ph name="TARGET_URL_HOSTNAME" />-д хандахын тулд өөр хөтөч нээхээр тохируулсан байна.</translation>
<translation id="7637726452490203009">&amp;Agent Chrome-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="9190841055450128916">Chromium (mDNS-In)</translation>
<translation id="924957577793602335">Chromium-г өөрийн болгоoрой</translation>
<translation id="93478295209880648">Windows XP болон Windows Vista нь цаашид Chromium-г дэмжихгүй тул буруу ажиллаж болзошгүй</translation>
<translation id="945098430667185067">Chromium-р Google-н аюулгүй байдлын шилдэг онцлогуудыг явж байх зуураа аваарай.</translation>
<translation id="945522503751344254">Санал хүсэлт илгээх</translation>
<translation id="965162752251293939">Chromium-г хэн ашиглаж байна вэ?</translation>
<translation id="967427899662692980">Chromium-н хамгийн хүчирхэг аюулгүй байдлыг аваарай</translation>
<translation id="983803489796659991">Шинэчлэлтийн серверт аппликэйшнд зориулсан ямар нэг хэш өгөгдөл байгаагүй тул суулгалт амжилтгүй болсон.</translation>
<translation id="985498048907240953">Chromium-г бүртгэлгүйгээр ашиглах</translation>
<translation id="5192139095541169725">Agent Chrome-ыг бүтээгчид</translation>
<translation id="989970834842471429">Зурган хайлтаар хайхын тулд дурын текст, зургийг сонгоно уу</translation>
<translation id="5834693163377136360">Байршлаа ашиглахын тулд <ph name="BEGIN_LINK" />системийн тохиргоонд<ph name="END_LINK" /> Agent Chrome-д хандах эрх өгнө үү</translation>
</translationbundle>