<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="1029669172902658969">Επανεκκίνηση για ενημέρωση του &amp;Chromium OS</translation>
<translation id="8271032073852564289">Το Agent Chrome συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="1395700234492294565">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το Agent Chrome χρησιμοποιεί τους διακομιστές της Google. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η Google μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="1051793555070215510">Βοηθήστε μας να βελτιώσουμε την ανώνυμη περιήγηση, συμμετέχοντας σε αυτή την έρευνα διάρκειας 1 λεπτού.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="3693661839172633833">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το Agent Chrome</translation>
<translation id="4676383270508741906">Για να αναζητήσετε μια συγκεκριμένη λειτουργία ή επέκταση του Agent Chrome, πληκτρολογήστε τη συντόμευσή της στη γραμμή διευθύνσεων και, στη συνέχεια, το επιλεγμένο πλήκτρο πληκτρολογίου</translation>
<translation id="1098493699368672217">Εμφάνιση της αναζήτησης με το Chromium στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="1104942323762546749">Το Chromium θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="112640046208448578">Αναγνωρίστε αντικείμενα ή μέρη και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="5373975050135708711">Το Agent Chrome είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="1131805035311359397">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK" />συνδεθείτε στο Chromium<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Κάντε κλικ στο μενού του Chromium</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="604454529346438712">Σχετικά με το Agent Chrome</translation>
<translation id="1186645291482254714">Λήψη ειδοποιήσεων παρακολούθησης τιμής με το Chromium στο τηλέφωνό σας</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Όταν ανοίγετε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, θα αποστέλλονται αυτόματα στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο Chromium. Για να αλλάξετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα Ο λογαριασμός σας στο Chromium.</translation>
<translation id="1244381985120794049">Εμφάνιση του Gemini στο Chromium στη γραμμή μενού του Mac</translation>
<translation id="1257483544893909270">Για να επιλέξετε ένα μέρος της οθόνης στο Gemini στο Chromium, χρησιμοποιήστε μια συντόμευση πληκτρολογίου.</translation>
<translation id="1262876892872089030">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το Chromium. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="3777643518642881741">Το Agent Chrome απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="126567311906253476">Όταν συνδέεστε σε υπηρεσίες Google, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL" />, μπορείτε να συνδέεστε αυτόματα στο Chromium με τον ίδιο λογαριασμό</translation>
<translation id="1287534462498555020">Λήψη του Chromium στο τηλέφωνό σας</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Ρυθμίστε το νέο σας προφίλ στο Chromium</translation>
<translation id="132092532143527429">Δοκιμάστε τη με το Gemini στο Chromium</translation>
<translation id="200785071050073583">Το Agent Chrome χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση 
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">Συνδεθείτε στο Chromium από το τηλέφωνό σας</translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="1342274909142618978">Να διαγραφούν επίσης δεδομένα από το Chromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στην Αναζήτηση με εικόνες από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="1356661055722410047">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="1388276868779258475">Χρησιμοποιήστε την εφαρμογή Chromium για να συνεχίσετε την περιήγηση εν κινήσει</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="8789809509510733987">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Agent Chrome στις Ρυθμίσεις συστήματος.</translation>
<translation id="1478370723027452770">Λήψη βοήθειας για το Chrome for Testing</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="3850708453627715578">Μοιραστείτε μια καρτέλα του Agent Chrome</translation>
<translation id="154404805518949443">Σύνδεση στο Chromium</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="8546278207686764484">Καρφίτσωμα Agent Chrome</translation>
<translation id="1574377791422810894">Εργαλεία ασφάλειας του Chromium</translation>
<translation id="1594928384848033697">Το Chromium θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="551713766576210710">{COUNT,plural, =0{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί μια ενημέρωση.}=1{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="1623563412065267963">Αξιοποιήστε τις καλύτερες λειτουργίες της Google με την εφαρμογή Chromium στο τηλέφωνό σας</translation>
<translation id="1625909126243026060">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο Chromium</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1665602916345474427">Συνδεθήκατε ως <ph name="USER_NAME" />, <ph name="USER_EMAIL" />: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="2604712040942461790">Μπορείτε να χρησιμοποιείτε το Agent Chrome κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές. Επίσης, θα καρφιτσωθεί στη γραμμή εργαλείων.</translation>
<translation id="1709772298389099340">Παρέχει αναβαθμισμένα προνόμια για το <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Αυτό θα σας επιτρέψει να επιλέγετε μία από τις διαθέσιμες συσκευές και να προβάλλετε περιεχόμενο σε αυτήν.</translation>
<translation id="4145295773323539953">Το Agent Chrome θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="1736443181683099871">Το Chromium θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="7280502947294080605">Διαγρ. δεδ. Agent Chrome</translation>
<translation id="1745121272106313518">Θα γίνει επανεκκίνηση του Chromium σε <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Όταν δεν είναι διαθέσιμο το HTTPS, το Chromium θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="1887395919652703120">Να επιτρέπεται στο Agent Chrome να εκτελείται στο παρασκήνιο</translation>
<translation id="1779356040007214683">Για να κάνουμε το Chromium πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="1793486931176048546">Κάντε κλικ στο κουμπί <ph name="BEGIN_BOLD" />Ναι<ph name="END_BOLD" /> στην ειδοποίηση των Windows, για να καρφιτσώσετε το Chromium στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="357645171972700077">Επανεγκατάσταση του Agent Chrome</translation>
<translation id="1820835682567584003">Το Chromium προσπαθεί να <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">Την επόμενη φορά που θα ανοίξετε το Chromium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση της Διαχείρισης κωδικών πρόσβασης Google.</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="18552579716432081">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας Google, <ph name="BEGIN_LINK" />αποσυνδεθείτε από το Chromium<ph name="END_LINK" />.</translation>
<translation id="1857749206890802997">Κατεβάστε το Chromium στο τηλέφωνό σας για άνοιγμα ή δημιουργία νέων ομάδων καρτελών εν κινήσει.</translation>
<translation id="185970820835152459">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας Google. Οι Λογαριασμοί σας Google χρησιμοποιούνται για το πρόγραμμα περιήγησης Chromium, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Μάθετε περισσότερα<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Αναζητήστε με την Αναζήτηση με εικόνες</translation>
<translation id="1863837059069884561">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Chromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="1881322772814446296">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Chromium. Τα δεδομένα σας στο Chromium, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του Chromium. <ph name="LEARN_MORE" /></translation>
<translation id="4964792828232534953">Το Agent Chrome εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">Υπηρεσία Chromium Updater</translation>
<translation id="1911763535808217981">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους Google, όπως το Gmail, χωρίς να συνδεθείτε στο Chromium</translation>
<translation id="1929939181775079593">Το Chromium δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="1933341829955786215">Ο οργανισμός σας, <ph name="MANAGER" />, απαιτεί να συνδεθείτε στο Chromium</translation>
<translation id="193439633299369377">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Chromium OS.</translation>
<translation id="207375373460618430">Το Agent Chrome απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE" /> λεπτά</translation>
<translation id="700162948230159797">Το Agent Chrome δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="197326043290947695">Περιηγηθείτε πιο έξυπνα με την Αναζήτηση με εικόνες</translation>
<translation id="1990262977744080398">Μάθετε γιατί το Chromium αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="1999715455684970349">Διατηρεί το λογισμικό Chromium ενημερωμένο. Εάν αυτή η υπηρεσία απενεργοποιηθεί ή σταματήσει, το λογισμικό Chromium δεν θα ενημερώνεται, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό Chromium που να τη χρησιμοποιεί.</translation>
<translation id="2008474315282236005">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="2039417478970545937">Ρυθμίσεις.</translation>
<translation id="2049376729098081731">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό Chromium για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες Google.</translation>
<translation id="2050698962207788467">Είναι ενσωματωμένη στο Chromium για να σας βοηθά να δημιουργείτε, να αποθηκεύετε και να συμπληρώνετε αυτόματα ισχυρούς κωδικούς πρόσβασης. Προσθέστε τη συντόμευση για εύκολη πρόσβαση.</translation>
<translation id="2064856577282482477">Κάντε κλικ στο κουμπί Προσαρμογή Chromium στη σελίδα Νέα καρτέλα, για να δώσετε μια νέα εμφάνιση στο Chromium</translation>
<translation id="6816376218079012438">Το Agent Chrome απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="208726765006323911">Την επόμενη φορά που θα ανοίξετε το Chromium iOS, θα δείτε μια προτροπή για να δοκιμάσετε τη λειτουργία <ph name="FEATURE_NAME" />.</translation>
<translation id="2099452623287920103">Οι κωδικοί πρόσβασης και άλλα δεδομένα του Chromium που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Chromium, συνδεθείτε ξανά.</translation>
<translation id="8983263343920390117">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Agent Chrome δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Agent Chrome δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="2125838419757773031">Επιλέξτε περιοχή της οθόνης για αναζήτηση</translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2135919691573380097">Αναφορά αυτού του ιστοτόπου</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="822057692680289847">Το Agent Chrome απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="2170098639895543546">Επιλέξτε οτιδήποτε στη σελίδα</translation>
<translation id="2174178932569897599">Προσαρμογή του Chromium</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="922967513335788675">Agent Chrome - Σύνδεση δικτύου - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Κατάργηση λογαριασμού από το Chromium</translation>
<translation id="2201788217099588893">Χρησιμοποιήστε την εφαρμογή Chromium για να έχετε τα καλύτερα εργαλεία αγορών εν κινήσει</translation>
<translation id="2210502920229141283">Παραμείνετε ασφαλείς εν κινήσει με τη Βελτιωμένη Ασφαλή περιήγηση στο Chromium για iOS</translation>
<translation id="2210682093923538346">Επικίνδυνος ιστότοπος. Το Chromium κατάργησε ειδοποιήσεις.</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="2238130810669087193">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Chromium. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας Google μετά τη σύνδεσή σας.</translation>
<translation id="2241627712206172106">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Chromium ακριβώς όπως θέλουν.</translation>
<translation id="22571759390241347">Δεξιότητες στο Chromium</translation>
<translation id="2283803047247799269">Αναζήτηση σε αυτή την καρτέλα με την Αναζήτηση με εικόνες</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Το Chromium συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Chromium συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="2307973900865360088">Διατήρηση στο Dock</translation>
<translation id="2313870531055795960">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Chromium. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Chromium μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="2356070529366658676">Να γίνεται ερώτηση</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="2361918034042471035">Η επέκταση <ph name="EXTENSION_NAME" /> θέλει να συνδεθείτε στο Chromium</translation>
<translation id="2028456545634496358">Απενεργοποίηση του Agent Chrome, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="2374216753258219393">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS" />, συνδεθείτε στο Chromium.</translation>
<translation id="2384373936468275798">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="3040857862310351495">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Agent Chrome}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Agent Chrome}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις Agent Chrome}}</translation>
<translation id="2401032172288869980">Το Chromium χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="2418322681019544463">Ανοίξτε συνδέσμους στο Chromium από οποιαδήποτε εφαρμογή και διατηρήστε το πρόγραμμα περιήγησης προσβάσιμο στη γραμμή εργαλείων</translation>
<translation id="2425157128016763890">Κάντε κλικ στο κουμπί Σύνοψη, για να κοινοποιήσετε αυτό το έγγραφο στο Gemini στο Chromium, να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="2440750600860946460">Με τα <ph name="BEGIN_LINK" />εργαλεία του Chromium<ph name="END_LINK" />, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="2449487342837813167">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Chromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="4405360797107732759">Το Agent Chrome θα κλείσει σύντομα</translation>
<translation id="1660473983484527105">Στο Agent Chrome</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Επιλογή κειμένου με την Αναζήτηση με εικόνες</translation>
<translation id="2554739539410784893">Το Chromium προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="2560420686485554789">Το Chromium χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="8620990455069644819">Πρόγραμμα βοήθειας Agent Chrome</translation>
<translation id="2575822587468774919">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="2576118232315942160">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Chromium</translation>
<translation id="2587622539943955767">Σαρώστε τον κωδικό QR με το τηλέφωνό σας, για να κατεβάσετε το Chromium και να συνδεθείτε στον Λογαριασμό σας Google.</translation>
<translation id="4496289616420025644">Συνέχεια χρήσης του Agent Chrome</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="2629740064077610681">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο Chromium</translation>
<translation id="2635452620547538388">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8944895445911901418">{COUNT,plural, =0{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί μια ενημέρωση}=1{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="263863604136125912">Έναρξη του Chromium</translation>
<translation id="2648074677641340862">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το Chromium ξανά.</translation>
<translation id="2661879430930417727">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Chromium ακριβώς όπως θέλουν.</translation>
<translation id="2676569452213089702">Εύκολη πρόσβαση για χρήση του Gemini στο Chromium σε όλη τη συσκευή σας, ακόμα και αν το Chromium είναι ελαχιστοποιημένο.</translation>
<translation id="3144164911846092828">Καρτέλα Agent Chrome</translation>
<translation id="2718390899429598676">Για επιπλέον ασφάλεια, το Chromium θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="2721354645805494590">Για να καταργήσετε τον Λογαριασμό σας Google από το Chromium, αποσυνδεθείτε</translation>
<translation id="2722636413143664436">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης, στους σελιδοδείκτες και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Chromium</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="2657110490709402112">Ορισμός του Agent Chrome ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="4262158525170658092">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το Agent Chrome, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="4930235474290498361">Το δικό σας Agent Chrome</translation>
<translation id="2816462166102338036">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="282591729717417030">Ανακαλύψτε προϊόντα με την κάμερα, παρακολουθήστε τις πτώσεις τιμών και πολλά άλλα εν κινήσει με το Chromium σε iOS.</translation>
<translation id="2841525013647267359">Μετάφραση από</translation>
<translation id="2846251086934905009">Σφάλμα εγκατάστασης: Το πρόγραμμα εγκατάστασης δεν ολοκληρώθηκε. Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="2847479871509788944">Κατάργηση από το Chromium…</translation>
<translation id="2850691299438350830">Διατηρεί την ασφάλειά σας στο Chromium και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές Google όταν είστε συνδεδεμένοι.</translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="8454027198329266279">Σχετικά με το &amp;Agent Chrome</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="2933336679234709858">Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον Λογαριασμό σας Google.</translation>
<translation id="2945997411976714835">Σφάλμα εγκατάστασης: Απέτυχε η εκκίνηση της διεργασίας του προγράμματος εγκατάστασης.</translation>
<translation id="2948852018303413228">Συνδεθείτε πιο γρήγορα σε ιστοτόπους χρησιμοποιώντας αποθηκευμένους κωδικούς πρόσβασης για το Chromium σε iOS</translation>
<translation id="80325676287146281">Ο οργανισμός σας διαχειρίζεται το Agent Chrome</translation>
<translation id="789940813130504773">Το Agent Chrome έχει ενημερωθεί</translation>
<translation id="2977506796191543575">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Chromium μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="2981563588585023386">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, συνδέσου στο Chromium</translation>
<translation id="3003694935412297923">Όλες οι εργασίες</translation>
<translation id="3012615494352020668">{count,plural, =1{Το Chromium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Το Chromium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="8084335581332031126">Άνοιγμα της διεύθυνσης <ph name="URL" /> σε νέα καρτέλα στο Agent Chrome.</translation>
<translation id="302551344979399011">Οι καινοτομίες AI, όπως οι δεξιότητες, αποθηκεύονται στον Λογαριασμό σας Google και η διαχείρισή τους γίνεται ξεχωριστά από τον συγχρονισμό του Chromium</translation>
<translation id="7024173799494459794">Προσθήκη στο Agent Chrome…</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="3045032126857188731">Γλώσσα μετάφρασης: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Κλείσιμο παραθύρου διαλόγου σχολίων</translation>
<translation id="3068187312562070417">Άλλα προφίλ Chromium</translation>
<translation id="3068290154869370196">Οι επεκτάσεις είναι πρόσθετα που σας επιτρέπουν να προσαρμόζετε το Chromium. Από την οργάνωση έως την απλοποίηση των καθημερινών εργασιών, οι επεκτάσεις σάς βοηθούν να προσαρμόζετε το Chromium στις ανάγκες σας.</translation>
<translation id="7027973430362347863">Βοηθήστε μας να κάνουμε το Agent Chrome καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK" /> στην Google</translation>
<translation id="3071024987058544609">Χρησιμοποιήστε την εφαρμογή Chromium για να έχετε μαζί σας την ασφάλεια της Google</translation>
<translation id="4925327325707966890">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Agent Chrome}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Agent Chrome}other{Αποκτήθηκε πρόσβαση σε # συσκευές USB από μία ή περισσότερες επεκτάσεις Agent Chrome}}</translation>
<translation id="6827369771274328769">Ιστορικό Agent Chrome</translation>
<translation id="3103660991484857065">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το Chromium ξανά.</translation>
<translation id="310459126943037700">Ο τερματισμός των εργασιών απέτυχε.</translation>
<translation id="3104828284009500087">Αναζητήστε οτιδήποτε στη σελίδα</translation>
<translation id="3126784891977756556">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Chromium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="2894555444497054373">Το Agent Chrome χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="3130333203120345554">Νέα αναζήτηση</translation>
<translation id="3137969841538672700">Σύρετε για αναζήτηση</translation>
<translation id="3144188012276422546">Αυτή η καρτέλα χρησιμοποιεί επιπλέον πόρους. Για να βελτιώσετε την απόδοση, επιτρέψτε στο Chromium να την απενεργοποιήσει.</translation>
<translation id="3092580151719004572">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Agent Chrome στις Ρυθμίσεις συστήματος</translation>
<translation id="2314296667497715523">Επανεκκίνηση Agent Chrome</translation>
<translation id="3161522574479303604">Όλες οι γλώσσες</translation>
<translation id="3179665906251668410">Άνοιγμα Συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης Chromium</translation>
<translation id="3185330573522821672">Προσαρμόστε το νέο σας προφίλ Chromium</translation>
<translation id="3189205223539394158">Μπορείτε να συνεχίσετε να συνομιλείτε με τη Λειτουργία AI χωρίς να αλλάξετε καρτέλες. Για να ξεκινήσετε, συνδεθείτε στο Chromium. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="3224847870593914902">Για να καταργήσετε τον Λογαριασμό σας Google από το Chromium, αποσυνδεθείτε από το Chromium στη σελίδα Ρυθμίσεις</translation>
<translation id="3234316605225071811">Αργότερα, το Chromium μπορεί να σας ρωτήσει αν θέλετε να χρησιμοποιήσετε τα αποθηκευμένα στοιχεία για την αυτόματη συμπλήρωση φορμών για εσάς</translation>
<translation id="5982289753835865194">Το Agent Chrome δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">Μεταφέρετε μαζί σας τα αγαπημένα σας εργαλεία Google AI με το Chromium σε iOS.</translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="3920105041734426863">Λείπουν κλειδιά του Google API. Ορισμένες λειτουργίες του Google Agent Chrome θα απενεργοποιηθούν.</translation>
<translation id="5621884903587730053">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το Agent Chrome είναι κλειστό</translation>
<translation id="3313189106987092621">Το Chromium θα σας ειδοποιεί πριν από τη φόρτωση ιστοτόπων με μη ασφαλή σύνδεση</translation>
<translation id="3316771292331273802">Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Chromium, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Chromium. Για να επιτρέψετε στους ιστοτόπους να απομνημονεύουν τα στοιχεία σας, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">επάνω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Δεδομένα Chromium στον λογαριασμό σας</translation>
<translation id="3375770072980084583">Χρησιμοποιήστε τους κωδικούς πρόσβασης με το Chromium στο τηλέφωνό σας</translation>
<translation id="3387527074123400161">Chromium OS</translation>
<translation id="3406848076815591792">Εναλλαγή σε υπάρχον προφίλ Chromium;</translation>
<translation id="3412460710772753638">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="3438772217992559640">Αναζήτηση αυτής της καρτέλας με την Αναζήτηση με εικόνες</translation>
<translation id="3455907671758333080">Επεκτείνετε τη Βελτιωμένη Ασφαλή περιήγηση με το Chromium στο τηλέφωνό σας</translation>
<translation id="3461644266919055473">Προσαρμογή του Chromium…</translation>
<translation id="3474745554856756813">Με αυτή την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT" /> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">Με τη συντόμευση <ph name="SHORTCUT" /> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ Chromium</translation>
<translation id="3509308970982693815">Κλείστε όλα τα παράθυρα του Chromium και δοκιμάστε ξανά.</translation>
<translation id="4449744684308538611">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Agent Chrome στις Ρυθμίσεις συστήματος</translation>
<translation id="3530103706039034513">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος.  Για να διατηρήσετε ξεχωριστά την περιήγησή σας, συνδεθείτε στο Chromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3531741627422851418">Κωδικός QR για τη λήψη του προγράμματος περιήγησης Chromium σε κινητές συσκευές</translation>
<translation id="354621070532799440">Υπενθύμιση: Οι καλύτερες λειτουργίες ασφαλείας της Google στην τσέπη σας</translation>
<translation id="4902762267468919597">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Agent Chrome στις Ρυθμίσεις συστήματος.</translation>
<translation id="4199561934263811659">Η Βελτιωμένη προστασία απενεργοποιεί τη βελτιστοποίηση JavaScript για ιστοτόπους που δεν αναγνωρίζει το Agent Chrome</translation>
<translation id="3597003331831379823">Απέτυχε η εκτέλεση της ρύθμισης με αναβαθμισμένα προνόμια. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">Σύνδεση στο Chromium</translation>
<translation id="3639635944603682591">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="7335807248512894660">{COUNT,plural, =0{Υπάρχει νέα διαθέσιμη ενημέρωση για το Agent Chrome και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}=1{Υπάρχει νέα διαθέσιμη ενημέρωση για το Agent Chrome και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Υπάρχει νέα διαθέσιμη ενημέρωση για το Agent Chrome και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="3667616615096815454">Δεν είναι δυνατή η εγκατάσταση, ο διακομιστής δεν γνωρίζει την εφαρμογή.</translation>
<translation id="3675854891107786059">Χρησιμοποιήστε τη <ph name="BEGIN_LINK" />δική σας φράση πρόσβασης<ph name="END_LINK" /> για την κρυπτογράφηση όλων των δεδομένων Chromium στον Λογαριασμό σας Google. Οι τρόποι και οι διευθύνσεις πληρωμής από το Google Pay δεν θα κρυπτογραφούνται. Το ιστορικό περιήγησης από το Chromium δεν θα συγχρονίζεται.</translation>
<translation id="3697825383460320042">{COUNT,plural, =0{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί αυτή η ενημέρωση.}=1{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Agent Chrome, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="7584080815951640016">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα Agent Chrome</translation>
<translation id="3728124580182886854">Σύνδεση του Chromium και άλλων υπηρεσιών Google για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="3729187154190517324">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία, χρησιμοποιώντας το κουμπί "Προσθήκη καρτέλας και άλλων".</translation>
<translation id="3788675262216168505">Διαχείριση προφίλ Chromium</translation>
<translation id="9153620230534680918">Μάθετε γιατί το Agent Chrome αποκλείει ορισμένες λήψεις</translation>
<translation id="379589255253486813">Το Chromium θα σας ενημερώσει σε περίπτωση που χρειαστεί να ελέγξετε κάτι</translation>
<translation id="4835254782629421085">Το Agent Chrome προφορτώνει σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνονται πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="3810973564298564668">Διαχείριση</translation>
<translation id="3823384748599722168">Για να χρησιμοποιήσετε τους αποθηκευμένους κωδικούς πρόσβασης, ακολουθήστε τον σύνδεσμο του κωδικού QR, κατεβάστε το Chromium για iOS και συνδεθείτε στον Λογαριασμό σας Google</translation>
<translation id="3846683726093018685">**Δημιουργήστε μια σύνοψη:** Σε μία πρόταση με λιγότερες από 30 λέξεις, περιγράψτε το κύριο θέμα και τον σκοπό του περιεχομένου στο στιγμιότυπο οθόνης.

          **Προτείνετε ερωτήσεις:** Δημιουργήστε μια λίστα με κουκκίδες με 3-5 ερωτήσεις που θα μπορούσε να κάνει ένας χρήστης για να κατανοήσει καλύτερα το στιγμιότυπο οθόνης. Αυτές οι ερωτήσεις πρέπει να περιλαμβάνουν τουλάχιστον μία η οποία θα αφορά συγκεκριμένα ένα οπτικό αντικείμενο, τον σχεδιασμό ή την τοποθέτησή του.</translation>
<translation id="5151092236561494204"><ph name="PAGE_TITLE" /> - Agent Chrome</translation>
<translation id="387514319934708384">Το Chromium χρειάζεται άδεια τοπικού δικτύου για αυτόν τον ιστότοπο</translation>
<translation id="3885770153807205175">Εργαλείο επιλογής γλώσσας</translation>
<translation id="8310546736680726676">Προσαρμογή και έλεγχος του Agent Chrome. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="3889543394854987837">Κάντε κλικ στο όνομά σας, για να ανοίξετε το Chromium και να ξεκινήσετε την περιήγηση.</translation>
<translation id="3892148308691398805">Αντιγραφή κειμένου</translation>
<translation id="390528597099634151">Ο χρήστης <ph name="EXISTING_USER" /> είναι συνδεδεμένος ήδη με αυτό το προφίλ Chromium. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το Chromium μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="334040592769172771">Αυτή η επέκταση παραβαίνει την πολιτική του Chrome Web Store και μπορεί να μην είναι ασφαλής. Καταργήστε την από το Agent Chrome, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="3941890832296813527">Σφάλμα εγκατάστασης: Το όνομα αρχείου του προγράμματος εγκατάστασης δεν είναι έγκυρο ή δεν υποστηρίζεται.</translation>
<translation id="3945058413678539331">Το Chromium προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="3954172517175569325">Οι κωδικοί πρόσβασης, οι τρόποι πληρωμής και οι διευθύνσεις που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Chromium, συνδεθείτε ξανά.</translation>
<translation id="395904275706073188">Δεν είναι δυνατή η ανάγνωση προστατευμένων σελίδων. Δοκιμάστε διαφορετική σελίδα.</translation>
<translation id="3962647064319009959">Μάθετε πώς σας προστατεύει το Chromium</translation>
<translation id="3967822245660637423">Ολοκλήρωση λήψης</translation>
<translation id="6274881217831291926">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Agent Chrome στέλνει αυτό που πληκτρολογείτε στα εργαλεία αναζήτησης, AI και agent του οργανισμού σας για να λάβει προτάσεις.</translation>
<translation id="3975724895399328945">Σχετικά με το &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">Σχετικά με το Chromium OS</translation>
<translation id="8089050973791989914">Όταν επισκέπτεστε έναν ιστότοπο, το Agent Chrome στέλνει ένα παραμορφωμένο τμήμα του URL στην <ph name="BEGIN_LINK" />Ασφαλή περιήγηση Google<ph name="END_LINK" /> μέσω ενός διακομιστή απορρήτου που αποκρύπτει τη διεύθυνση IP σας. Εάν ένας ιστότοπος κάνει κάτι ύποπτο, αποστέλλονται επίσης πλήρη URL και τμήματα περιεχομένου της σελίδας.</translation>
<translation id="4016217212818346953">Μείνετε ασφαλείς με τη Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4019629340646866719">Το Chromium OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS" />περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Μετάφραση οθόνης</translation>
<translation id="4023601594785368013">Αρχική γλώσσα: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Ανοίξτε συνδέσμους στο Chromium από οποιαδήποτε εφαρμογή. Επιπλέον, για εύκολη πρόσβαση, καρφιτσώνεται στη γραμμή εργαλείων.</translation>
<translation id="2466379549068383575">Συμβάλετε στη βελτίωση του Agent Chrome, αναφέροντας τις <ph name="BEGIN_LINK" />τρέχουσες ρυθμίσεις<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4055805654398742145">Δ&amp;ιαχειριστής κωδικών πρόσβασης</translation>
<translation id="409373329602981607">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Agent Chrome όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το Agent Chrome όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="4118474109249235144">Ανώνυμη περιήγηση του Chromium</translation>
<translation id="4122186850977583290">Μετάβαση στη σελίδα Σχετικά με το Chromium</translation>
<translation id="4135244987012252068">Προσαρμόστε το Chrome για να δώσετε μια νέα εμφάνιση στο πρόγραμμα περιήγησης</translation>
<translation id="4147856324248078748">Π&amp;ροσαρμογή του Chromium</translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="2058774528396152893"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου - Agent Chrome</translation>
<translation id="7685529984676330289">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το Agent Chrome.</translation>
<translation id="4217080900579554343">Για να λάβετε αυτή την επέκταση και άλλα στοιχεία σε όλους τους υπολογιστές σας, συνδεθείτε στο Chromium</translation>
<translation id="4217972271355023382">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, επίλεξε το προφίλ Chromium στο οποίο έχεις ήδη συνδεθεί ως <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="4224210481850767180">Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="4230135487732243613">Να συνδεθούν τα δεδομένα σας στο Chromium με αυτόν το λογαριασμό;</translation>
<translation id="274377438883177878">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η Google στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του Agent Chrome.</translation>
<translation id="4269093074552541569">Αποσύνδεση από το Chromium</translation>
<translation id="8361584154950824008">Λήψη βοήθειας σχετικά με το Agent Chrome</translation>
<translation id="4281844954008187215">Όροι παροχής υπηρεσιών</translation>
<translation id="4285930937574705105">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το Chromium εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="4298125729853015961">Εξαγωγή κωδικών πρόσβασης από το Chromium</translation>
<translation id="4304713468139749426">Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4334241893986177674">Αναζήτηση αυτού του στιγμιότυπου οθόνης</translation>
<translation id="4368547723231502008">Αναζητήστε και κάντε ερωτήσεις από οπουδήποτε, ακόμα και αν το Chromium είναι ελαχιστοποιημένο</translation>
<translation id="1172096072757635810">Άνοιγμα του Agent Chrome κατά την εκκίνηση των Windows</translation>
<translation id="4400772909124543403">Δεν υπάρχει διαθέσιμη ενημέρωση</translation>
<translation id="8069611125329654712">Να γίνει έξοδος από το Agent Chrome ούτως ή άλλως;</translation>
<translation id="4413205837991854510">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="3727041326435831325">Να επιτρέπεται στο Agent Chrome να εκτελείται στο παρασκήνιο</translation>
<translation id="1713490836766202786">{NUM_EXTENSIONS,plural, =1{Το Agent Chrome προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}other{Το Agent Chrome προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}}</translation>
<translation id="7567010943765939594">Προσαρμογή και έλεγχος του Agent Chrome</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="4434353761996769206">Σφάλμα προγράμματος εγκατάστασης: <ph name="INSTALLER_ERROR" /></translation>
<translation id="7498286168885369820">Ο οργανισμός <ph name="MANAGER" /> διαχειρίζεται το Agent Chrome</translation>
<translation id="444069871276811466">Προσθήκη προφίλ Chromium</translation>
<translation id="4447409407328223819">Σχετικά με το Chrome for Testing</translation>
<translation id="4470974262661801543">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον Λογαριασμό σας Google, εισαγάγετε τη φράση πρόσβασης</translation>
<translation id="4493028449971051158">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως διαχειριστής.</translation>
<translation id="4501471624619070934">Η εγκατάσταση απέτυχε επειδή η πρόσβαση είναι περιορισμένη σε αυτήν τη χώρα.</translation>
<translation id="4615766574627629942">Αυτή η επέκταση δεν έχει δημοσιεύσει πρακτικές απορρήτου, όπως τον τρόπο συλλογής και χρήσης δεδομένων. Το Agent Chrome προτείνει να την καταργήσετε.</translation>
<translation id="452711251841752011">Καλωσορίσατε στο Chromium. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="4531137820806573936">Το Chromium χρειάζεται άδεια για να χαρτογραφήσει τον περιβάλλοντα χώρο και να παρακολουθεί τα χέρια σας</translation>
<translation id="4536805923587466102">Έχετε συνδεθεί ήδη ως <ph name="USER_EMAIL_ADDRESS" /> σε άλλο προφίλ Chromium</translation>
<translation id="5945053225725114995">Το Agent Chrome προφορτώνει τις σελίδες, κάτι το οποίο επιταχύνει την περιήγηση και την αναζήτηση. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις σελίδες προφόρτωσης<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Βελτιώστε την ασφάλεια στο διαδίκτυο για όλους, αναφέροντας ιστοτόπους που πιστεύετε ότι είναι επιβλαβείς.</translation>
<translation id="2899198307620821227">Το Agent Chrome απέκλεισε αυτή τη λήψη, επειδή απενεργοποιήσατε την Ασφαλή περιήγηση και δεν είναι δυνατή η επαλήθευση του αρχείου</translation>
<translation id="4583692638088316420">Δοκιμάστε το Google Lens με το Chromium στο τηλέφωνό σας</translation>
<translation id="4594305310729380060">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="6944119370969619446">Εφαρμογές Agent Chrome</translation>
<translation id="4598116752460667024">Αναζητήστε οποιαδήποτε διεργασία από τη λίστα.</translation>
<translation id="4613863813562375431">Έκδοση Chromium OS</translation>
<translation id="6401103202303237090">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το Agent Chrome για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="4807663225386362301">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Agent Chrome, αλλά καθιστά το Agent Chrome ελαφρώς λιγότερο ανθεκτικό σε επιθέσεις</translation>
<translation id="4626321472657185181">Άνοιγμα Αναζήτησης με το Chromium</translation>
<translation id="521912697020157864">Προειδοποίηση: Το Agent Chrome δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτή την επέκταση σε κατάσταση ανώνυμης περιήγησης, καταργήστε αυτή την επιλογή.</translation>
<translation id="4673151026126227699">Εάν κοινοποιείτε επίσης αναφορές χρήσης του Chromium, αυτές περιλαμβάνουν τα URL που επισκέπτεστε.</translation>
<translation id="4673710618874938871">Συνδεθήκατε ως <ph name="USER_NAME" />: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="5833534934470627293">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του Agent Chrome (<ph name="PROCESS_ID" />) σε άλλο υπολογιστή (<ph name="HOST_NAME" />). Το Agent Chrome έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το Agent Chrome.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="469259825538636168">Ορισμένα δεδομένα του Chromium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="4708193446201257833">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο Chromium. Η συντόμευση <ph name="SHORTCUT" /> μπορεί να αλλάξει τις ρυθμίσεις των υπηρεσιών Google.</translation>
<translation id="4708774505295300557">Κάποιο άτομο συνδέθηκε προηγουμένως στο Chromium σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST" />. Δημιουργήστε έναν νέο χρήστη του Chromium, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="4724676981607797757">Η εγκατάσταση απέτυχε λόγω σφάλματος μη υποστηριζόμενου πρωτοκόλλου.</translation>
<translation id="2783410850122241193">Να τερματιστεί η λειτουργία του Agent Chrome ούτως ή άλλως;</translation>
<translation id="4748217263233248895">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το Chromium. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="4771701986670315895">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="COUNT" /> ακόμη.</translation>
<translation id="4786083865378785874">Εάν το Gemini στο Chromium είναι ανοικτό, το πλαϊνό πλαίσιο παραμένει ανοικτό κατά τη δημιουργία νέων καρτελών</translation>
<translation id="479167709087336770">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση Google. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην Google. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="4814736265800133385">Χρήση του Chromium χωρίς λογαριασμό</translation>
<translation id="4888717733111232871">Εισερχόμενος κανόνας για το Chromium για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="5600814355607573136">Επανεκκίνηση για ενημέρωση του &amp;Agent Chrome</translation>
<translation id="4918086044614829423">Αποδοχή</translation>
<translation id="4918844574251943176">Η εικόνα αντιγράφηκε</translation>
<translation id="4943838377383847465">Το Chromium εκτελείται στο παρασκήνιο.</translation>
<translation id="494490797786467921">Κάντε κλικ για να κλείσετε το παράθυρο διαλόγου σύνδεσης του Chromium</translation>
<translation id="4950660488495335294">Με τα προφίλ του Chromium μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο Chromium. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="4987820182225656817">Οι επισκέπτες μπορούν να χρησιμοποιούν το Chromium χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="4992938037305302429">Ο λογαριασμός σας στο Chromium</translation>
<translation id="4994636714258228724">Προσθήκη του εαυτού σας στο Chromium</translation>
<translation id="504699503110800016">Ανοίξτε το μενού υπερχείλισης</translation>
<translation id="5074496654342756568">Αποκτήστε πρόσβαση σε όλες τις αγαπημένες λειτουργίες της Google με το Chromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="5123973130450702873">Το Chromium χρειάζεται άδεια για να παρακολουθεί τα χέρια σας</translation>
<translation id="5141988424377517949">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ στο εικονίδιο ειδοποίησης στη δεξιά γωνία της γραμμής τοποθεσίας.</translation>
<translation id="5174983315706567306">Δεν υπάρχει αρκετός χώρος δίσκου.</translation>
<translation id="5187123684706427865">Ο λογαριασμός Chromium απαιτεί εκ νέου έλεγχο ταυτότητας</translation>
<translation id="5223510345050543907">Συνεχίστε ακριβώς από εκεί που είχατε σταματήσει με το Chromium σε iOS.</translation>
<translation id="5231355151045086930">Αποσύνδεση από το Chromium</translation>
<translation id="5234764350956374838">Παράβλεψη</translation>
<translation id="5249261924633168472">Άνοιγμα συνδέσμου σε παράθυρο για ανών&amp;υμη περιήγηση Chromium</translation>
<translation id="5276305953263010518">Αποκτήστε την εφαρμογή Chromium για να αποθηκεύετε κωδικούς πρόσβασης εν κινήσει</translation>
<translation id="1601187459465935178">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το Agent Chrome</translation>
<translation id="5286907366254680517">Εντοπίστηκε</translation>
<translation id="5289287148052354622">Λήψη της εφαρμογής Chromium</translation>
<translation id="5294316920224716406">Κατά την περιήγηση σε Κατάσταση ανώνυμης περιήγησης, το Chromium θα σας ειδοποιεί πριν από τη φόρτωση ενός ιστοτόπου με μη ασφαλή σύνδεση</translation>
<translation id="5296581118566748922">Αναζήτηση με το Chromium</translation>
<translation id="5313228254328109263">Εσωτερική υπηρεσία Chromium Updater</translation>
<translation id="5324450571874973775">Χρησιμοποιήστε τις μαζί με άλλες λειτουργίες του Gemini στο Chromium</translation>
<translation id="5346389065299425353">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία</translation>
<translation id="5348677704241861105">Δείτε μια γρήγορη επισκόπηση αυτού του εγγράφου και κάντε ερωτήσεις με το Gemini στο Chromium</translation>
<translation id="5352264705793813212">Το Chromium εντόπισε ορισμένες προτάσεις ασφάλειας για να ελέγξετε</translation>
<translation id="5352361688875342522">Άλλα προφίλ Chromium</translation>
<translation id="535243042947607642">Δεν ήταν δυνατή η αποθήκευση δεδομένων Chromium στον Λογαριασμό σας Google από το ChromiumOS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα</translation>
<translation id="5358375970380395591">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Chromium. Τα δεδομένα σας στο Chromium, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Επιπλέον κωδικός: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Για εξατομίκευση, συμπεριλάβετε το Chromium στη Δραστηριότητα ιστού και εφαρμογών</translation>
<translation id="5382964351116519680">Άνοιγμα αναζήτησης με το Chromium</translation>
<translation id="2524054769026663683">Μάθετε γιατί το Agent Chrome αποκλείει ορισμένα αρχεία</translation>
<translation id="8615009965479156445">Ενημέρωση του Agent Chrome (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Να επιτρέπεται η σύνδεση στο Chromium</translation>
<translation id="6256236118124872626">Κατάργηση από το Agent Chrome</translation>
<translation id="5774731921051444461">Μειώνει την απόδοση αλλά καθιστά το Agent Chrome πιο ανθεκτικό σε επιθέσεις</translation>
<translation id="5427571867875391349">Ορισμός του Chromium ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="8709870882148322247"><ph name="PAGE_TITLE" /> - Agent Chrome Beta</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Το Chromium συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Chromium συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="3217425685577630218">Το Agent Chrome ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="1045655099853558439">Το Agent Chrome απέκλεισε αυτή τη λήψη, επειδή το αρχείο μπορεί να βλάψει τους προσωπικούς σας λογαριασμούς και τους λογαριασμούς σας σε κοινωνικά δίκτυα</translation>
<translation id="549669000822060376">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το Chromium.</translation>
<translation id="5496810170689441661">Το Chromium προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="549975168243349205">Εργαστείτε απρόσκοπτα με τις αγαπημένες σας εφαρμογές, όπως το Google Drive και το YouTube, εν κινήσει με το Chromium.</translation>
<translation id="5524890928877629608">επάνω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="565863787292824328">Άνοιγμα PDF στο Agent Chrome</translation>
<translation id="5536164441519929134">Ερώτηση<ph name="LINE_BREAK" />σχετικά με αυτή την καρτέλα</translation>
<translation id="8869089999448782168">Για λόγους ασφαλείας, το Agent Chrome απενεργοποιεί τη βελτιστοποίηση JavaScript όταν επισκέπτεστε έναν ιστότοπο για πρώτη φορά.

Εάν αυτή η σελίδα δεν λειτουργεί με τον αναμενόμενο τρόπο, δοκιμάστε να επιτρέψετε τη βελτιστοποίηση.</translation>
<translation id="5575874067957905201">Εμφάνιση του Gemini στο Chromium στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="5576587363991567745">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Chromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως απλός χρήστης και όχι ως διαχειριστής.</translation>
<translation id="5580770360767802657">Χρήση Chromium από προεπιλογή και καρφίτσωμα</translation>
<translation id="5596627076506792578">Περισσότερες επιλογές</translation>
<translation id="5605834417512968703">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="5618818588972826921">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="4814380868372526025">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του Agent Chrome}=1{Υπάρχει μια διαθέσιμη ενημέρωση του Agent Chrome}other{Υπάρχει μια διαθέσιμη ενημέρωση του Agent Chrome για # ημέρες}}</translation>
<translation id="188722644954983559">Να διαγράφονται πάντα τα δεδομένα ιστοτόπων από τη συσκευή σας όταν κλείνετε το Agent Chrome</translation>
<translation id="5653831366781983928">Επανεκκινήστε το Chromium τώρα</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="1525044488102751845">Να εμφανίζεται το Agent Chrome σε αυτήν τη γλώσσα</translation>
<translation id="569897634095159764">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Ο διακομιστής μεσολάβησης απαιτεί έλεγχο ταυτότητας.</translation>
<translation id="7750959567789509941">Το Agent Chrome αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το Agent Chrome γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση μνήμης<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">Εάν ξεχάσατε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="SETTINGS_LINK" /> τα δεδομένα του Chromium στον λογαριασμό σας</translation>
<translation id="5800158606660203929">Προσαρμογή και έλεγχος του Chromium. Ορίστε το Chromium ως προεπιλογή.</translation>
<translation id="5802618941556161431">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές, ορίζοντας το Chromium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5809516625706423866">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 401 Unauthorized. Ελέγξτε τη διαμόρφωση παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2755468387099310604">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Agent Chrome, αλλά καθιστά το Agent Chrome ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι απενεργοποιημένη.</translation>
<translation id="5821520528363214608">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον Λογαριασμό σας Google, ενημερώστε το Chromium</translation>
<translation id="5824893331272123205">Δεν ήταν δυνατή η φόρτωση αυτού του πλαισίου. Δοκιμάστε ξανά.</translation>
<translation id="8972968824660717915">Καλώς ήρθατε στο Agent Chrome</translation>
<translation id="8898055105597601099">Ενεργοποιεί πρόσθετες λειτουργίες για την παροχή των ισχυρότερων μέτρων προστασίας του Agent Chrome</translation>
<translation id="5871205389137001634">Κάντε κλικ για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="9158119422063615519">Το Agent Chrome εντόπισε κακόβουλο πρόγραμμα σε αυτά τα στοιχεία:</translation>
<translation id="5889361821821684993">Το Chromium ελέγχει τακτικά για να διασφαλίζει ότι το πρόγραμμα περιήγησης που χρησιμοποιείτε έχει τις πιο ασφαλείς ρυθμίσεις. Θα σας ενημερώνουμε, αν χρειάζεται να ελέγξετε κάτι.</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="5939553720811388432">Ας ετοιμάσουμε το Chromium</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="5949225980829865667">Για να έχετε πρόσβαση σε αυτόν τον σελιδοδείκτη και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Chromium</translation>
<translation id="5953657885167112863">Εξατομίκευση του Chromium</translation>
<translation id="5960071705175224773">Οι ρυθμίσεις σας άλλαξαν από μια άγνωστη εφαρμογή</translation>
<translation id="5977420883993828287">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά τις Εργασίες με βάση τα συμφραζόμενα από τη γραμμή εργαλείων</translation>
<translation id="1956376169666014494">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Agent Chrome όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το Agent Chrome όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="5987687638152509985">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το Chromium</translation>
<translation id="5990360079535151574">Από το κουμπί Εργασίες με βάση τα συμφραζόμενα στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS" /> ώρες</translation>
<translation id="6009821354356307391">Κάντε ένα επιπλέον ερώτημα</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="6044357424127037044">Αξιοποιήστε περισσότερο τις ηλεκτρονικές αγορές όταν χρησιμοποιείτε την εφαρμογή Chromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="6058380562449900225">Για την προστασία των δεδομένων σας, επιτρέψτε στο Chromium να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα. Δεν διακόπτει τις ειδοποιήσεις.</translation>
<translation id="6063093106622310249">&amp;Άνοιγμα στο Chromium</translation>
<translation id="6069027071882229820">Αντιγραφή ως εικόνα</translation>
<translation id="8654038583091834120">Η επέκταση <ph name="EXTENSION_NAME" /> έχει προστεθεί στο Agent Chrome</translation>
<translation id="8940723094351907049">Προσαρμόστε και ελέγξτε το Agent Chrome. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="334648248941185659">Ενεργή • Το Agent Chrome δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="611228897408671387">Ο λογαριασμός σας στο Chromium</translation>
<translation id="1961808482688487456">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του Agent Chrome</translation>
<translation id="6880945371922378763">Το αρχείο <ph name="FILE_NAME" /> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Agent Chrome.</translation>
<translation id="829957199361894387">Το Agent Chrome θα κλείσει σύντομα και θα διαγράψει τα δεδομένα</translation>
<translation id="6145820983052037069">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ σας Chromium</translation>
<translation id="8333733115616087710">Εάν επιτρέπεται η λήψη cookie, το Agent Chrome μπορεί να τα χρησιμοποιεί κατά την προφόρτωση</translation>
<translation id="6165508094623778733">Μάθετε περισσότερα</translation>
<translation id="6173308241973263798">Διαγράψετε τα δεδομένα του Chromium στον λογαριασμό σας</translation>
<translation id="8439223334931595792">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο<ph name="LINE_BREAK" />Το Agent Chrome μπορεί να ελέγξει αυτή τη λήψη για εσάς εάν καταχωρίσετε τον κωδικό πρόσβασης. Οι πληροφορίες σχετικά με το αρχείο αποστέλλονται στην Ασφαλή περιήγηση Google, αλλά το περιεχόμενο και ο κωδικός πρόσβασης του αρχείου παραμένουν στη συσκευή σας.</translation>
<translation id="6182736845697986886">Η εγκατάσταση απέτυχε λόγω εσωτερικού σφάλματος στον διακομιστή ενημέρωσης.</translation>
<translation id="6183079672144801177">Βεβαιωθείτε ότι έχετε συνδεθεί στο Chromium στη συσκευή σας <ph name="TARGET_DEVICE_NAME" /> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="6212496753309875659">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του Chromium. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το Chromium και κατεβάστε το ξανά.</translation>
<translation id="6375381612105819561">{0,plural, =0{Η επανεκκίνηση του Agent Chrome θα γίνει τώρα}=1{Η επανεκκίνηση του Agent Chrome θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του Agent Chrome θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="6241367896540709610">Το Chromium χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="6245734527075554892">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Chromium</translation>
<translation id="5070229316792137581">Ορισμός Agent Chrome ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="6248988683584659830">Αναζήτηση ρυθμίσεων</translation>
<translation id="6261803579884938625">Αποκτήστε τις καλύτερες λειτουργίες ασφάλειας της Google εν κινήσει, με την εφαρμογή Chromium στο τηλέφωνό σας</translation>
<translation id="6268381023930128611">Θέλετε να αποσυνδεθείτε από το Chromium;</translation>
<translation id="6270547683008298381">Αυτές οι καρτέλες χρησιμοποιούν επιπλέον πόρους. Για να βελτιώσετε την απόδοσή σας, επιτρέψτε στο Chromium να τις απενεργοποιήσει.</translation>
<translation id="6281746429495226318">Προσαρμόστε το προφίλ σας Chromium</translation>
<translation id="6290827346642914212">Ονομάστε το προφίλ σας στο Chromium</translation>
<translation id="6294831894865512704">Μια επέκταση θέλει να συνδεθείτε στο Chromium</translation>
<translation id="1356965940380155951">Το αρχείο <ph name="FILE_NAME" /> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Agent Chrome.</translation>
<translation id="7321042153033393145">Το Agent Chrome χρησιμοποιεί την κάμερά σας.</translation>
<translation id="6333502561965082103">Μια άλλη λειτουργία στο Chromium βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="6334986366598267305">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το Chromium με το Λογαριασμό σας Google και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="6347002662287820329">Αποκτήστε εύκολη πρόσβαση στις λειτουργίες που γνωρίζετε, αγαπάτε και εμπιστεύεστε, ορίζοντας το Chromium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="6663103136563143835">Συντόμευση Agent Chrome</translation>
<translation id="8324836837188781073">Το Agent Chrome απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του αρχείου και ενδέχεται να είναι επικίνδυνο</translation>
<translation id="6373523479360886564">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του Chromium;</translation>
<translation id="6375219077595103062">Προσθήκη συντόμευσης στον Διαχειριστή κωδικών πρόσβασης</translation>
<translation id="6388799252195623474">βοήθησέ με με αυτή την εργασία</translation>
<translation id="6390800440335263989">Για να συνεχίσετε, συνδεθείτε στο Chromium ως <ph name="EMAIL" />. Αυτή η ενέργεια διασφαλίζει ότι ακολουθείτε τις πολιτικές του οργανισμού σας.</translation>
<translation id="6400112897226594999">Λογότυπο Chromium μέσα σε οθόνη υπολογιστή.</translation>
<translation id="6403826409255603130">Το Chromium είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="6414624068245092115">Για να βεβαιωθείτε ότι θα μπορείτε να χρησιμοποιείτε και να αποθηκεύετε πάντα δεδομένα Chromium στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="5698692159722140301">Το Agent Chrome εκτελείται πιο γρήγορα και οι λειτουργίες που χρησιμοποιούν JavaScript θα πρέπει να λειτουργούν με τον αναμενόμενο τρόπο</translation>
<translation id="6436260184216827876">Η Αναζήτηση με εικόνες δεν είναι διαθέσιμη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="6442900851116057561">Επανεκκίνηση Chromium OS</translation>
<translation id="1150325299163558144">Το Agent Chrome προφορτώνει ακόμα περισσότερες σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνουν πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="6450948450282634257">Κατεβάστε το Chromium στο τηλέφωνό σας για παρακολούθηση τιμών και λήψη ειδοποιήσεων σε περίπτωση πτώσης τιμής σε οποιονδήποτε ιστότοπο</translation>
<translation id="2302438614865168038">Ανενεργή • Το Agent Chrome δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="6455857529632101747">Καλώς ήρθατε στα προφίλ του Chromium</translation>
<translation id="6460614424172581323">Την επόμενη φορά που θα ανοίξετε το Chromium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση των ομάδων καρτελών.</translation>
<translation id="6466344609055215035">Κατάργηση λογαριασμού από το Chromium</translation>
<translation id="5526497172610025231">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Agent Chrome.</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="6510925080656968729">Απεγκατάσταση Chromium</translation>
<translation id="124295298108005714">Οι συντομεύσεις ανοίγουν στο Agent Chrome</translation>
<translation id="9177671044583442813">Ο οργανισμός σας κλείνει το Agent Chrome όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="6542839706527980775">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο Chromium, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="6556755379298048869">Κάντε αναζήτηση με συντόμευση πληκτρολογίου.</translation>
<translation id="5677032436425073715">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK" />πώς το Agent Chrome διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK" /></translation>
<translation id="5967753610833950399">Οι αλλαγές σε αυτή τη ρύθμιση θα εφαρμοστούν μετά από την επανεκκίνηση του Agent Chrome.</translation>
<translation id="4790842900919490952">Διαχειριστείτε τις επεκτάσεις σας, κάνοντας κλικ στην επιλογή Επεκτάσεις στο κύριο μενού του Agent Chrome.</translation>
<translation id="656935081669708576">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ Chromium</translation>
<translation id="6569556444379005948">Χρησιμοποιήστε την εφαρμογή Chromium για να έχετε μαζί σας τα καλύτερα εργαλεία AI</translation>
<translation id="8124768693572849485">Για τη διόρθωση ορθογραφικών λαθών, το Agent Chrome στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο Google</translation>
<translation id="6598877126913850652">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του Chromium</translation>
<translation id="6600016381025017075">Αναζητήστε οτιδήποτε σε αυτή τη σελίδα</translation>
<translation id="1736130262142947818">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το Agent Chrome.</translation>
<translation id="6637908313088374648">Το Chromium ανοίγει πλέον κατά την εκκίνηση των Windows, ώστε να μπορείτε να ξεκινήσετε άμεσα την περιήγηση. Μπορείτε να απενεργοποιήσετε αυτή τη λειτουργία στις ρυθμίσεις.</translation>
<translation id="6648212540664651655">Συνεχίστε από εκεί που σταματήσατε: Το Chromium έκανε επαναφορά των καρτελών σας από την τελευταία περίοδο λειτουργίας. Μπορείτε να απενεργοποιήσετε αυτή τη ρύθμιση στην ενότητα</translation>
<translation id="665732753414869868">Το Chromium χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="6669284030132180248">Εάν αποθηκεύσετε τους σελιδοδείκτες σας και στον Λογαριασμό σας Google, μπορείτε να παρακολουθείτε τις τιμές των προϊόντων στο Chromium και να λαμβάνετε ειδοποιήσεις όταν παρατηρείται πτώση τιμών</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="668175097507315160">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="6691132793308828750">Κατάργηση των δεδομένων αυτής της εφαρμογής από το Chromium</translation>
<translation id="6709350901466051922">Το Chromium χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="6712881677154121168">Σφάλμα λήψης: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="7755971898820142787">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του Agent Chrome.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του Agent Chrome.</translation>
<translation id="6729124504294600478">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το Chromium στη Δραστηριότητα ιστού και εφαρμογών και στις συνδεδεμένες υπηρεσίες Google</translation>
<translation id="6734291798041940871">Το Chromium είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="6742093177587589736">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Chromium. Αυτός ο σελιδοδείκτης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="7821834337023193240">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Agent Chrome, αλλά καθιστά το Agent Chrome ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι ενεργοποιημένη.</translation>
<translation id="6754665438209053659">{count,plural, =1{Ορισμένα δεδομένα του Chromium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Ορισμένα δεδομένα του Chromium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="67706546131546258">Το Chromium συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="6779406956731413166">Το Chromium OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="6847869444787758381">Το Chromium σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="684888714667046800">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Εάν χρησιμοποιείτε τείχος προστασίας, βεβαιωθείτε ότι το <ph name="PRODUCT_EXE_NAME" /> είναι στη λίστα επιτρεπομένων.</translation>
<translation id="6219638737609534419">Agent Chrome - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Πατήστε Tab για συνέχεια</translation>
<translation id="6862030660799253820">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="6869568587896659271">Εύκολη πρόσβαση σε ιστοτόπους κάτω από τη γραμμή διευθύνσεων</translation>
<translation id="7421523967177993052">Το Agent Chrome εντόπισε κακόβουλο πρόγραμμα στην επέκταση <ph name="EXTENSION_NAME" />.</translation>
<translation id="6877155553248388166">κάτω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Αντιγραφή</translation>
<translation id="6898028264630240901">Μπορείτε να καρφιτσώσετε τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6901631050894301805">Ορίστε το Chromium ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="6909503629704372277">&amp;Διαχείριση προφίλ Chromium</translation>
<translation id="9199111398679939226">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK" />
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK" />
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAK" />
            • Θα επαναφέρει τις συντομεύσεις του Agent Chrome
            <ph name="LINE_BREAKS" />
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="6948031725951063910">Έχετε συμπληρώσει το όριο των <ph name="BOOKMARK_LIMIT" /> σελιδοδεικτών του Chromium, επομένως ορισμένοι από τους σελιδοδείκτες σας δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google.

Δεν θα είναι δυνατή η αποθήκευση νέων σελιδοδεικτών στον λογαριασμό σας μέχρι να διαγράψετε ορισμένους. Εάν αποσυνδεθείτε τώρα, οι μη αποθηκευμένοι σελιδοδείκτες θα διαγραφούν.</translation>
<translation id="6964305034639999644">Άνοιγμα συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης Chromium</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">Όροι του Chromium OS</translation>
<translation id="7003299027384820442">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Η εγκατάσταση απέτυχε επειδή αυτή η έκδοση του λειτουργικού συστήματος δεν υποστηρίζεται.</translation>
<translation id="7024536598735240744">Σφάλμα αποσυσκευασίας: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7045244423563602563">Προσαρμόστε το Chromium για εσάς</translation>
<translation id="7047386856539490735">Είναι χρήσιμα αυτά τα αποτελέσματα;</translation>
<translation id="705851970750939768">Ενημέρωση Chromium</translation>
<translation id="1222890016986172619">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Agent Chrome θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google.</translation>
<translation id="7074836723476134809">Αξιοποιήστε τη δύναμη του AI όταν χρησιμοποιείτε την εφαρμογή Chromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="7134687062119989071">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή Chromium στο τηλέφωνό σας</translation>
<translation id="7141270731789036260">Προσαρμογή του Chrome for Testing</translation>
<translation id="5669948510815930830">Μπορείτε να χρησιμοποιείτε το Agent Chrome κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="5576210706466474421">Κατάργηση της επέκτασης <ph name="EXTENSION_NAME" /> από το Agent Chrome</translation>
<translation id="4588941330171478873">Ο οργανισμός σας διαγράφει τα δεδομένα του Agent Chrome όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION" />. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="718435575166326686">Το Chromium χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2916059341902838041">Δεν ήταν δυνατή η εκκίνηση του Agent Chrome. Προσπάθησε ξανά.</translation>
<translation id="7204669035546236137">Ρωτήστε οτιδήποτε, όπου κι αν βρίσκεστε, με το Gemini στο Chromium</translation>
<translation id="1716746018761150810">Διατηρήστε το Agent Chrome στο Dock για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="7213407614656404070">Χρησιμοποιήστε το Chromium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="7216228761061470870">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες σε υπολογιστή, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή</translation>
<translation id="4816956813330284757">Διαχείριση Εργασιών - Agent Chrome</translation>
<translation id="7227958669698166857">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Chromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="7252276985725323153">Ξεκινήστε άμεσα την περιήγηση: Το Chromium μπορεί πλέον να ανοίγει κατά την εκκίνηση των Windows.</translation>
<translation id="7274695763216404502">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά την Αναζήτηση με εικόνες από τη γραμμή εργαλείων</translation>
<translation id="7288567540154601580">Καρτέλες και επεκτάσεις</translation>
<translation id="3631444715156784168">{NUM_EXTENSIONS,plural, =1{Το Agent Chrome προτείνει να την καταργήσετε}other{Το Agent Chrome προτείνει να τις καταργήσετε}}</translation>
<translation id="2739521415810397215">Για κοινή χρήση του ήχου συστήματος, ανοίξτε τις Ρυθμίσεις συστήματος και επιτρέψτε την επιλογή "Μόνο εγγραφή ήχου συστήματος" για το Agent Chrome. Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Agent Chrome.</translation>
<translation id="1945073734373493421">Ενημέρωση του Agent Chrome</translation>
<translation id="7323500970718355745">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το Agent Chrome δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="7324051657739063017">Μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="734373864078049451">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του Chromium.</translation>
<translation id="7347827960336370838">Μόνο κάποιος που γνωρίζει τη φράση πρόσβασης μπορεί να διαβάσει τα κρυπτογραφημένα δεδομένα σας. H φράση πρόσβασης δεν αποστέλλεται στην Google, ούτε αποθηκεύεται από αυτήν. Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, θα χρειαστεί να <ph name="BEGIN_LINK" />διαγράψετε τα δεδομένα του Chromium στον λογαριασμό σας<ph name="END_LINK" />.</translation>
<translation id="7994662313190863803">Ο διαχειριστής συστήματος έχει διαμορφώσει το Agent Chrome ώστε να ανοίγει το <ph name="ALTERNATIVE_BROWSER_NAME" /> για την πρόσβαση σε <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="4438212735766904761">Για τη λήψη μελλοντικών ενημερώσεων του Agent Chrome, θα χρειαστείτε macOS 13 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 12.</translation>
<translation id="7376384068949534168">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" /> και <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Άνοιγμα του Chrome Web Store</translation>
<translation id="7394275517973019558">Εμφάνιση του Gemini στο Chromium στην περιοχή ειδοποιήσεων</translation>
<translation id="7401687852903179959">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="7407655596887111931">Το Chromium είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="3957050361764426740">Συνεχίστε από το σημείο που σταματήσατε: Το Agent Chrome επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να απενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="7427879960656355200">Εισαγωγή κωδικών πρόσβασης στο Chromium</translation>
<translation id="744815265653811511">1. Κάντε κλικ στο κουμπί <ph name="BUTTON_LABEL" /> παρακάτω
2. Κάντε κλικ στο κουμπί <ph name="BUTTON_2" /> στις ρυθμίσεις των Windows
3. Κάντε κλικ στο κουμπί <ph name="BUTTON_3" /> στην ειδοποίηση των Windows για να καρφιτσώσετε το Chromium στη γραμμή εργαλείων για γρήγορη πρόσβαση</translation>
<translation id="4378256924846450484"><ph name="PAGE_TITLE" /> - Agent Chrome Dev</translation>
<translation id="7450541714075000668">Το κείμενο αντιγράφηκε</translation>
<translation id="1661210845845599119">Για χρήση του μικροφώνου, παραχωρήστε πρόσβαση στο Agent Chrome στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="7461356015007898716">Για τη λήψη μελλοντικών ενημερώσεων του Chromium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="7782360127659485548">Επανεκκίνηση του Agent Chrome;</translation>
<translation id="7483335560992089831">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του Chromium που εκτελείται αυτήν τη στιγμή. Κλείστε το Chromium και δοκιμάστε ξανά.</translation>
<translation id="7510190804000607802">Υπενθύμιση: Οι καλύτερες λειτουργίες της Google στην τσέπη σας</translation>
<translation id="4114725046952451715">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο. Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Agent Chrome, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Agent Chrome.</translation>
<translation id="8460803820751380899">{0,plural, =1{Η επανεκκίνηση του Agent Chrome θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του Agent Chrome θα γίνει σε # λεπτά}}</translation>
<translation id="7565444033145385702">Για την προστασία των δεδομένων σας, επιτρέψτε στο Chromium να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα.</translation>
<translation id="7806190892617295204">Ανοίξτε αυτόματα το Agent Chrome, για να αρχίσετε άμεσα την περιήγηση.</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME" /></translation>
<translation id="4114499337401148821">Το Agent Chrome χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="7617377681829253106">Το Chromium έγινε ακόμα καλύτερο</translation>
<translation id="4075526625511660913">Έχετε πλέον περισσότερες διαθέσιμες λειτουργίες στο Agent Chrome</translation>
<translation id="7624307931717240213">Χρησιμοποιούμε πληροφορίες για τη βελτίωση αυτής της υπηρεσίας. Ανατρέξτε στην Πολιτική απορρήτου και στους Όρους παροχής υπηρεσιών.</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="7650134251917003571">Λήψη της εφαρμογής Chromium</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="5829091955527196771">Το Agent Chrome δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="7689606757190482937">Συγχρονίστε και εξατομικεύστε το Chromium στις συσκευές σας</translation>
<translation id="7699779824407626136">Ενημέρωση Chromium</translation>
<translation id="7700735928747402058">Η εργασία σας προστατεύεται στο Chromium</translation>
<translation id="7716950018788545737">Οι εργασίες τερματίστηκαν.</translation>
<translation id="77283119132245232">Παρέχει υπηρεσίες ανίχνευσης συστήματος για το <ph name="BROWSER_NAME" />. Εάν αυτή η υπηρεσία είναι απενεργοποιημένη, τα ίχνη απόδοσης που δημιουργούνται από το πρόγραμμα περιήγησης δεν θα περιλαμβάνουν συμβάντα σε επίπεδο συστήματος, όπως συμβάντα εναλλαγής περιβάλλοντος και συμβάντα ετοιμότητας νήματος.</translation>
<translation id="7745317241717453663">Με αυτή την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="7747820849741499258">Αναζήτηση στο Chromium</translation>
<translation id="7750130090210923118">Επαναφορά της προεπιλογής Chromium</translation>
<translation id="7752521946322750699">Για την προστασία της εργασίας σας στο Chromium, ο οργανισμός σας θα μπορεί να βλέπει ή να διαχειρίζεται ορισμένες πληροφορίες όταν είστε συνδεδεμένοι στο Chromium.</translation>
<translation id="7781047659465034537">Ορίστε το Chromium ως προεπιλογή και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="7786760609782648049">Κάντε το Chromium πιο γρήγορο</translation>
<translation id="1092858669153166534"><ph name="PAGE_TITLE" /> - Agent Chrome Canary</translation>
<translation id="6890902183809417868">Κάντε πιο δύσκολο για άτομα που έχουν πρόσβαση στη διαδικτυακή κίνησή σας να βλέπουν ποιους ιστοτόπους επισκέπτεστε. Το Agent Chrome χρησιμοποιεί μια ασφαλή σύνδεση για να αναζητήσει τη διεύθυνση IP ενός ιστοτόπου στο DNS (Domain Name System).</translation>
<translation id="7810005234485217901">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση</translation>
<translation id="4343938787674079986">Επιλέξτε τι θα κοινοποιείτε στο Agent Chrome</translation>
<translation id="7828947555739565424">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ Chromium με αυτόν τον λογαριασμό</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="6129792107484731038">Η μηχανή αναζήτησης άλλαξε από άλλο πρόγραμμα εκτός του Agent Chrome. Για την προστασία σας, το Agent Chrome την επανέφερε στην αρχική προεπιλογή. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="7853661403199074278">Προσαρμόστε το Chromium για να του δώσετε μια νέα εμφάνιση</translation>
<translation id="5018331886385637870">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Agent Chrome στέλνει αυτό που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησης για να λάβει καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ανώνυμη περιήγηση.</translation>
<translation id="473441635289092936">Δεν ήταν δυνατή η ενημέρωση του Agent Chrome στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS" /> δευτερόλεπτα.</translation>
<translation id="7873537467422636035">Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK" />διαγράψτε τα δεδομένα του Chromium στον λογαριασμό σας<ph name="END_LINK" /></translation>
<translation id="7874369989024033742">Ανοίξτε γρήγορα το Gemini στο Chromium όποτε το χρειάζεστε</translation>
<translation id="7888981273428720788">Ορισμός του Chromium ως προεπιλογής</translation>
<translation id="7934340546140346950">Το Chromium αναβαθμίζει αυτόματα τις μη ασφαλείς συνδέσεις σε HTTPS, όταν είναι εφικτό</translation>
<translation id="7937630085815544518">Συνδεθήκατε στο Chromium ως <ph name="USER_EMAIL_ADDRESS" />. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="7944602660083060118">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Chromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="688313102897865477">Αυτή είναι μια δευτερεύουσα εγκατάσταση του Agent Chrome και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="8514782479541580218">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το Agent Chrome συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="8000759043835159571">Αξιοποιήστε τις καλύτερες λειτουργίες της Google με την εφαρμογή Chromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8004582292198964060">Πρόγραμμα περιήγησης</translation>
<translation id="8010081455002666927">Αυτόματος εντοπισμός</translation>
<translation id="403216574291780144">Όταν το Agent Chrome αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="7835197459694498831">Καρφιτσώστε το Agent Chrome στη γραμμή εργαλείων για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="8069447462453318634">Επιλέξτε "Καρφίτσωμα στη γραμμή εργαλείων"</translation>
<translation id="787536271006179882">Απενεργοποίηση του Agent Chrome, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="80790299200510644">Αναζήτηση με εικόνες</translation>
<translation id="8086881907087796310">Η εγκατάσταση απέτυχε επειδή ο υπολογιστής σας δεν πληροί τις ελάχιστες απαιτήσεις εξοπλισμού.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="8105840573057009683">Το Chromium χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="8107060931443639922">Την επόμενη φορά που θα ανοίξετε το Chromium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για ενεργοποίηση των ειδοποιήσεων παρακολούθησης τιμής.</translation>
<translation id="8117908349476699973">Λάβετε ειδοποιήσεις για πτώση τιμής σε προϊόντα που σας ενδιαφέρουν με την εφαρμογή Chromium στο τηλέφωνό σας</translation>
<translation id="8118331347066725040">Αποστολή σχολίων για την αναζήτηση με το Lens</translation>
<translation id="8130609355518033382">Εξατομικεύστε το Chromium</translation>
<translation id="8133124826068723441">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="8161503455832158203">Ανοίξτε το Gemini στο Chromium με μια συντόμευση πληκτρολογίου.</translation>
<translation id="7109772131778940712">Πρόσθετοι όροι παροχής υπηρεσιών του Agent Chrome</translation>
<translation id="7759642951398174884">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το Agent Chrome.</translation>
<translation id="8177472873527554730">Δεν είναι δυνατή η εύρεση περιεχομένου στη σελίδα</translation>
<translation id="8200109504272824693">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον λογαριασμό σας, <ph name="USER_EMAIL" /></translation>
<translation id="820759916613250543">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="8221491193165283816">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ εδώ.</translation>
<translation id="5410773870087525304">Για χρήση της κάμερας, παραχωρήστε πρόσβαση στο Agent Chrome στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="1057772683559103555">Το Agent Chrome δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Agent Chrome, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων.</translation>
<translation id="1968416200800224093">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Agent Chrome θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="8254601181414348851">Σύνδεση στο Chromium με νέο προφίλ;</translation>
<translation id="8262224117913639129">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Chromium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="8277334259226003205">Εμφάνιση του Gemini στο Chromium στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Το Chromium σας προειδοποιεί<ph name="END_LINK" /> σχετικά με μη ασφαλείς ιστοτόπους και λήψεις</translation>
<translation id="8295827201165805317">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε την άδεια <ph name="PERMISSION" />.</translation>
<translation id="8296236834352487533">Αγοράστε, μεταφράστε και προσδιορίστε ό,τι βλέπετε με την κάμερα στην εφαρμογή Chromium iOS</translation>
<translation id="8310603974518734211">Κωδικός QR για σύνδεση στο Chromium ως <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Σφάλμα εκκίνησης: <ph name="STARTUP_ERROR" />.</translation>
<translation id="2256229026962116267">Ο οργανισμός σας κλείνει το Agent Chrome όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">Αποθήκευση ως εικόνα</translation>
<translation id="8340674089072921962">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS" /> χρησιμοποιούσε το Chromium στο παρελθόν</translation>
<translation id="8351551329754447960">Ενεργοποίηση Δεξιοτήτων στο Chromium</translation>
<translation id="8359544530202147897">Ενημερώστε το Chromium, για να συνεχίσετε να χρησιμοποιείτε τα δεδομένα του Chromium στον Λογαριασμό σας Google, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8360718212975266891">Για τη λήψη μελλοντικών ενημερώσεων του Chromium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="8362914115861174987">Μετάφραση στα</translation>
<translation id="8367705492654390392">Ρωτήστε οτιδήποτε</translation>
<translation id="8370517070665726704">Πνευματικά δικαιώματα <ph name="YEAR" /> Google LLC. Με την επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8372327902843331129">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Chromium. Αυτός ο κωδικός πρόσβασης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="3962779702290581702">Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Agent Chrome.</translation>
<translation id="6085013152567092546">Το Agent Chrome προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" /></translation>
<translation id="8142784445734351509">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Agent Chrome, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="8416884904046428725">Το Chromium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="7611805576553766531">{0,plural, =1{Επανεκκίνηση του Agent Chrome σε μία ημέρα}other{Επανεκκίνηση του Agent Chrome σε # ημέρες}}</translation>
<translation id="8438543370129609977">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">Μάθετε περισσότερα σχετικά με την αναζήτηση με την Αναζήτηση εικόνων στο Chromium</translation>
<translation id="8453117565092476964">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το Chromium ξανά.</translation>
<translation id="8458614432758743027">Το Chromium απαιτεί Windows 10 ή νεότερη έκδοση.</translation>
<translation id="8463672209299734063">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Chromium OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην Google.</translation>
<translation id="8471947159125090285">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="8482493977473846331">Εμφάνιση οδηγιών για σύνδεση στο Chromium</translation>
<translation id="6049002268233195982">Το Agent Chrome δεν είναι ενημερωμένο</translation>
<translation id="6156435126546305838">Σας ευχαριστούμε που ορίσατε το Agent Chrome ως το προεπιλεγμένο πρόγραμμα περιήγησης!</translation>
<translation id="8522801943730206384">Το Chromium μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύετε</translation>
<translation id="8525579356836940628">Η εγκατάσταση διακόπηκε</translation>
<translation id="8545729292258443488">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή Chromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8548787790260785208">Λάβετε ειδοποίηση, εάν το Chromium εντοπίσει έναν από τους κωδικούς πρόσβασής σας σε μια δημόσια παραβίαση δεδομένων</translation>
<translation id="8555465886620020932">Σφάλμα υπηρεσίας: <ph name="SERVICE_ERROR" />.</translation>
<translation id="2713372071612730965">Ορισμένες λειτουργίες και επεκτάσεις του Agent Chrome διαθέτουν συντομεύσεις. Μπορείτε να επιλέξετε να τις ενεργοποιήσετε ξανά.</translation>
<translation id="8556420416730706394">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση. Κάντε κλικ στο κουμπί Καρφίτσωμα στο επάνω μέρος του πλαϊνού πλαισίου</translation>
<translation id="856656450041460113">Αναζήτηση λίστας γλωσσών</translation>
<translation id="1783040386392706016">Πολλοί οργανισμοί διαχειρίζονται το Agent Chrome</translation>
<translation id="7921569471494089882">Πνευματικά δικαιώματα <ph name="YEAR" /> Οι συντάκτες του Agent Chrome. Με επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8601359445272098721">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας, επιλέγοντας το κουμπί Μετάφραση οθόνης</translation>
<translation id="6294059080097269555">Εκκίνηση του Agent Chrome…</translation>
<translation id="8624541899164515475">Ρυθμίσεις, ανοίγει σε νέα καρτέλα.</translation>
<translation id="8648201657708811153">Το Google Chrome for Testing δεν μπορεί να οριστεί ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5652647471010716562">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Agent Chrome ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="8704119203788522458">Ορίστε το δικό σας Chromium</translation>
<translation id="8712637175834984815">Κατάλαβα!</translation>
<translation id="8719993436687031146">Σύνδεση στο Chromium;</translation>
<translation id="8747073452963259673">κάτω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Σφάλμα εγκατάστασης: Ο διαχειριστής του δικτύου σας έχει εφαρμόσει μια πολιτική ομάδας που εμποδίζει την εγκατάσταση: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Υπενθύμιση αργότερα</translation>
<translation id="8816416449795340678">Μοιραστείτε αυτό το έγγραφο με το Gemini στο Chromium για να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="8818550178040858407">Σύνδεση στο Chromium;</translation>
<translation id="4188893721116572726">Ορισμός Agent Chrome ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφίτσωμα στη γραμμή εργαλείων</translation>
<translation id="8826492472752484139">Κάντε κλικ στην επιλογή Διαχείριση κωδικών πρόσβασης</translation>
<translation id="8833697763442816810">Σύστημα Chromium OS</translation>
<translation id="341256515309503869">Αυτή η γλώσσα χρησιμοποιείται για την προβολή μενού, ρυθμίσεων, ειδοποιήσεων και άλλου κειμένου στο Agent Chrome</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="8876044221123442390">Προσθήκη προφίλ Chromium</translation>
<translation id="8890569919834781711">Δεν ήταν δυνατή η αποθήκευση δεδομένων Chromium στον Λογαριασμό σας Google από το ChromiumOS λόγω σφάλματος κατά τη σύνδεση</translation>
<translation id="8891709362986793894">Ο οργανισμός σας απαιτεί να συνδεθείτε στο Chromium</translation>
<translation id="8907580949721785412">Το Chromium προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="8932992523185907506">Το Chromium δεν είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης. Θέλετε να ορίσετε το Chromium ως το προεπιλεγμένο πρόγραμμα περιήγησης;</translation>
<translation id="2086624065931944916">Δεν είναι δυνατή η ενημέρωση του Agent Chrome</translation>
<translation id="8944232836376404813">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK" />
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK" />
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAKS" />
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="8966875421152977384">Εμφάνιση συντομεύσεων ιστοτόπων στο Chromium</translation>
<translation id="4591081057798655502">Λογότυπο Agent Chrome Enterprise</translation>
<translation id="8980139959902937527">Απολαύστε την ασφάλεια της Google εν κινήσει με την εφαρμογή Chromium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="352721818246741864">Δεν είναι δυνατή η έναρξη του Agent Chrome, επειδή προέκυψε πρόβλημα κατά το άνοιγμα του προφίλ σας. Δοκιμάστε να επανεκκινήσετε το Agent Chrome.</translation>
<translation id="8988036198400390003">Διαχείριση προφίλ Chromium</translation>
<translation id="8993855408334954620">Χρησιμοποιήστε το πληκτρολόγιό σας για να πλοηγηθείτε μεταξύ του Gemini στο Chromium και της ανοιχτής καρτέλας σας.</translation>
<translation id="9018218886431812662">Η εγκατάσταση ολοκληρώθηκε</translation>
<translation id="9019929317751753759">Για να κάνουμε το Chromium πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="9022552996538154597">Σύνδεση στο Chromium</translation>
<translation id="9035791714111278917">Εμφάνιση της αναζήτησης με το Chromium στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="144293525744948128">Το Agent Chrome απέκλεισε αυτή τη λήψη, επειδή το αρχείο αρχειοθέτησης περιλαμβάνει άλλα αρχεία που ενδέχεται να κρύβουν κάποιο κακόβουλο πρόγραμμα</translation>
<translation id="9053882453960391422">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Chromium ως το προεπιλεγμένο πρόγραμμα περιήγησης. Το Chromium θα καρφιτσωθεί στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="9056398481763999048">Χρησιμοποιήστε τα καλύτερα εργαλεία AI της Google με την εφαρμογή Chromium στο τηλέφωνό σας</translation>
<translation id="9062666675513499497">Σύνδεση στο Chromium όταν συνδέεστε σε άλλες υπηρεσίες Google</translation>
<translation id="5989671354018094677">Το Agent Chrome έκλεισε αυτόματα</translation>
<translation id="5288426372256126088">Το Agent Chrome δεν είναι ενημερωμένο</translation>
<translation id="8599483501705081932">{0,plural, =1{Η επανεκκίνηση του Agent Chrome θα γίνει σε μία ώρα}other{Η επανεκκίνηση του Agent Chrome θα γίνει σε # ώρες}}</translation>
<translation id="9106236359747881194">Επιλογή κειμένου για αναζήτηση</translation>
<translation id="9106612006984859720">Για τη λήψη μελλοντικών ενημερώσεων του Chromium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="6660967356554387137">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα Agent Chrome</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="9134482777260927479">Βοήθεια για σχολικές εργασίες</translation>
<translation id="9148058034647219655">Έξοδος</translation>
<translation id="356554850028684199">Συνεχίστε από το σημείο που σταματήσατε: Το Agent Chrome μπορεί να επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να ενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="2217675621893057123">Ο διαχειριστής συστήματος έχει διαμορφώσει το Agent Chrome έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7637726452490203009">Επανεκκίνηση για ενημέρωση του &amp;Agent Chrome</translation>
<translation id="9190841055450128916">Chromium (mDNS-In)</translation>
<translation id="924957577793602335">Εξατομίκευση του Chromium</translation>
<translation id="93478295209880648">Το Chromium μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="945098430667185067">Μεταφέρετε μαζί σας τις καλύτερες λειτουργίες ασφαλείας της Google με το Chromium.</translation>
<translation id="945522503751344254">Αποστολή σχολίων</translation>
<translation id="965162752251293939">Ποιος χρησιμοποιεί το Chromium;</translation>
<translation id="967427899662692980">Λάβετε την ισχυρότερη προστασία του Chromium</translation>
<translation id="983803489796659991">Η εγκατάσταση απέτυχε επειδή ο διακομιστής ενημέρωσης δεν διαθέτει δεδομένα κατακερματισμού για την εφαρμογή.</translation>
<translation id="985498048907240953">Χρήση του Chromium χωρίς λογαριασμό</translation>
<translation id="5192139095541169725">Οι συντάκτες του Agent Chrome</translation>
<translation id="989970834842471429">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="5834693163377136360">Για χρήση της τοποθεσίας σας, παραχωρήστε πρόσβαση στο Agent Chrome στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
</translationbundle>