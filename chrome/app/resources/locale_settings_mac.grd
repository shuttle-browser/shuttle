      </message>

      <!-- The default value for |WebPreference::math_font_family| -->
      <message name="IDS_MATH_FONT_FAMILY" use_name_for_id="true">
        STIX Two Math
      </message>

      <!-- The default value for |WebPreference::standard_font_family_map| for
