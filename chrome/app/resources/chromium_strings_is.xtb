<translation id="4368547723231502008">Leita og spyrja spurninga hvar sem er, jafnvel þó Chromium sé minnkað</translation>
<translation id="1172096072757635810">Ræsa Agent Chrome þegar Windows ræsist</translation>
<translation id="4400772909124543403">Engin uppfærsla er tiltæk</translation>
<translation id="8069611125329654712">Viltu samt loka Agent Chrome?</translation>
<translation id="4413205837991854510">Alltaf sýna flýtileið myndaleitar</translation>
<translation id="3727041326435831325">Leyfa Agent Chrome að keyra í bakgrunni</translation>
<translation id="1713490836766202786">{NUM_EXTENSIONS,plural, =1{Agent Chrome mælir með að þú fjarlægir hana. <ph name="BEGIN_LINK" />Nánar um studdar viðbætur<ph name="END_LINK" />}one{Agent Chrome mælir með að þú fjarlægir þær. <ph name="BEGIN_LINK" />Nánar um studdar viðbætur<ph name="END_LINK" />}other{Agent Chrome mælir með að þú fjarlægir þær. <ph name="BEGIN_LINK" />Nánar um studdar viðbætur<ph name="END_LINK" />}}</translation>
