<translation id="3068187312562070417">‏פרופילים אחרים ב-Chromium</translation>
<translation id="3068290154869370196">‏תוספים הם רכיבים נוספים שמאפשרים לך להתאים אישית את Chromium. תוספים עוזרים לך להתאים את Chromium לצרכים שלך, בין אם זה לשמור על הסדר או לפשט משימות יומיומיות.</translation>
<translation id="1841107660132296794">‏עזרה בשיפור Shuttle על ידי שליחת <ph name="UMA_LINK" /> ודוחות קריסה אל Google</translation>
<translation id="3071024987058544609">‏עם אפליקציית Chromium אפשר ליהנות מתכונות הבטיחות של Google בכל מקום</translation>
<translation id="3739686665197813096">{NUM_DEVICES,plural, =0{‏תוסף אחד לפחות ל-Shuttle ניגש להתקן USB אחד}=1{‏תוסף אחד לפחות ל-Shuttle ניגש להתקן USB אחד}one{‏תוסף אחד לפחות ל-Shuttle ניגש ל-# התקני USB}two{‏תוסף אחד לפחות ל-Shuttle ניגש ל-# התקני USB}other{‏תוסף אחד לפחות ל-Shuttle ניגש ל-# התקני USB}}</translation>
<translation id="2502156653706673977">‏ההיסטוריה ב-Shuttle</translation>
<translation id="3103660991484857065">‏המתקין לא הצליח לבטל את דחיסת הארכיון. יש להוריד שוב את Chromium.</translation>
<translation id="310459126943037700">סיום המשימות נכשל.</translation>
<translation id="3104828284009500087">אפשר לחפש משהו בדף הזה</translation>
<translation id="3126784891977756556">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-Chromium.</translation>
<translation id="1074920430236894401">‏Shuttle משתמש במיקרופון שלך.</translation>
<translation id="3130333203120345554">חיפוש חדש</translation>
<translation id="3137969841538672700">צריך לגרור כדי לחפש</translation>
<translation id="3144188012276422546">‏בכרטיסייה הזו נעשה שימוש במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-Chromium להשבית אותה.</translation>
<translation id="6825554846760229393">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-Shuttle בקטע "הגדרות המערכת"</translation>
<translation id="3761350857202901706">‏הפעלה מחדש של Shuttle</translation>
<translation id="3161522574479303604">כל השפות</translation>
<translation id="3179665906251668410">‏פתיחת הקישור בחלון &amp;אנונימי של Chromium</translation>
<translation id="3185330573522821672">‏התאמה אישית של פרופיל Chromium החדש</translation>
<translation id="3189205223539394158">‏אפשר להמשיך להתכתב בצ'אט עם מצב AI בלי לעבור בין כרטיסיות. כדי להתחיל, עליך להיכנס לחשבון שלך ב-Chromium. אחרי הכניסה, הסיסמאות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="3224847870593914902">‏כדי להסיר את החשבון שלך ב-Google מ-Chromium, צריך לצאת מ-Chromium בדף ההגדרות</translation>
<translation id="3234316605225071811">‏בהמשך, תוצג לך שאלה ב-Chromium אם להשתמש במידע השמור כדי למלא בשבילך טפסים באופן אוטומטי</translation>
<translation id="9058828139997344018">‏Shuttle אינו יכול לקרוא ולכתוב בספריית הנתונים שלו: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">‏עם Chromium ב-iOS, אפשר לקחת את הכלים שמבוססים על Google AI איתך לכל מקום.</translation>
<translation id="3286538390144397061">הפעל מחדש כעת</translation>
<translation id="8765302055862543686">‏המפתחות של Google API חסרים. פונקציונליות מסוימת של Shuttle תהיה מושבתת.</translation>
<translation id="4826503398521877963">‏המשך הפעלת יישומים ברקע כאשר Shuttle סגור</translation>
<translation id="3313189106987092621">‏Chromium יציג אזהרה לפני טעינת אתר כלשהו באמצעות חיבור לא מאובטח</translation>
<translation id="3316771292331273802">‏אם סוגרים את כל החלונות של Chromium, מתבצעת יציאה מהחשבון ברוב האתרים, אבל לא מחשבון Google, אם נכנסת אליו ב-Chromium. כדי לאפשר לאתרים לזכור אותך, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">‏הפינה הימנית העליונה של אזור החיפוש: ‎<ph name="RIGHT" />%‎ מימין, ‎<ph name="TOP" />%‎ מלמעלה</translation>
<translation id="3366305173356742781">‏נתוני Chromium בחשבון שלך</translation>
<translation id="3375770072980084583">‏רוצה להשתמש בסיסמאות שלך ב-Chromium בטלפון?</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3406848076815591792">‏לעבור לפרופיל קיים של Chromium?</translation>
<translation id="3412460710772753638">עדכון במנהל הסיסמאות במכשיר הזה</translation>
<translation id="3438772217992559640">חיפוש בכרטיסייה בעזרת "חיפוש תמונות"</translation>
<translation id="3455907671758333080">‏רוצה להרחיב את הגרסה המשופרת של גלישה בטוחה ב-Chromium בטלפון?</translation>
<translation id="3461644266919055473">‏‫Chromium מבצע התאמה אישית…</translation>
<translation id="3474745554856756813">‏פעולה זו תמחק <ph name="ITEMS_COUNT" /> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Chromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">‏ניתן לעבור בין פרופילים של Chromium באמצעות <ph name="SHORTCUT" /></translation>
<translation id="3509308970982693815">‏יש לסגור את כל חלונות Chromium ולנסות שוב.</translation>
<translation id="5876629139177327931">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-Shuttle בקטע "הגדרות המערכת"</translation>
<translation id="3530103706039034513">‏כבר בוצעה כניסה לחשבון על ידי <ph name="EXISTING_USER" />.  כדי להפריד בין פעילויות הגלישה, עליך להיכנס ל-Chromium בפרופיל שלך עם האימייל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3531741627422851418">‏קוד QR להורדת הדפדפן Chromium למכשירים ניידים</translation>
<translation id="354621070532799440">‏תזכורת: תכונות הבטיחות הכי טובות של Google – אצלך בכיס</translation>
<translation id="2337565425943560376">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-Shuttle בקטע "הגדרות המערכת".</translation>
<translation id="4821889377524170187">‏הפעלת ההגנה המשופרת משביתה את האופטימיזציה של JavaScript באתרים ש-Shuttle לא מזהה</translation>
<translation id="3597003331831379823">הפעלת ההגדרה נכשלה עם הרשאות מורחבות. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">‏כניסה ל-Chromium</translation>
<translation id="3639635944603682591">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-Chromium בתור <ph name="USER_EMAIL" />.</translation>
<translation id="1300475218926632111">{COUNT,plural, =0{‏יש עדכון חדש בשביל Shuttle והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש.}=1{‏יש עדכון חדש בשביל Shuttle והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. החלון האנונימי לא ייפתח מחדש.}one{‏יש עדכון חדש בשביל Shuttle והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏יש עדכון חדש בשביל Shuttle והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏יש עדכון חדש בשביל Shuttle והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="3667616615096815454">אין אפשרות להתקין, האפליקציה לא מוכרת לשרת.</translation>
<translation id="3675854891107786059">‏שימוש ב<ph name="BEGIN_LINK" />ביטוי סיסמה משלך<ph name="END_LINK" /> כדי להצפין את כל נתוני Chromium בחשבון Google. אמצעי תשלום וכתובות שנשמרו ב-Google Pay לא יוצפנו. היסטוריית הגלישה ב-Chromium לא תסונכרן.</translation>
<translation id="5274497473086430153">{COUNT,plural, =0{‏מנהל המערכת מבקש להפעיל מחדש את Shuttle כדי להחיל את העדכון הזה}=1{‏מנהל המערכת מבקש להפעיל מחדש את Shuttle כדי להחיל את העדכון הזה. החלון האנונימי לא ייפתח מחדש.}one{‏מנהל המערכת מבקש להפעיל מחדש את Shuttle כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏מנהל המערכת מבקש להפעיל מחדש את Shuttle כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏מנהל המערכת מבקש להפעיל מחדש את Shuttle כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="6123757042710639920">‏פתיחת הקישור ב&amp;כרטיסיית Shuttle חדשה</translation>
<translation id="3728124580182886854">‏אפשר לקשר את Chromium לשירותי Google אחרים לצורך התאמה אישית ולמטרות אחרות</translation>
<translation id="3729187154190517324">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים באמצעות הכפתור "הוספת כרטיסייה ועוד".</translation>
<translation id="3788675262216168505">‏ניהול הפרופילים ב-Chromium</translation>
<translation id="4583231988142868515">‏למה הורדות מסוימות נחסמות ב-Shuttle</translation>
<translation id="379589255253486813">‏Chromium יעדכן אותך אם יש משהו שצריך לבדוק</translation>
<translation id="9161544906744429402">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Shuttle טוענת מראש דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="3810973564298564668">ניהול</translation>
<translation id="3823384748599722168">‏כדי להשתמש בסיסמאות השמורות, צריך לסרוק את קוד ה-QR, להוריד את Chromium ל-iOS ולהיכנס לחשבון Google</translation>
<translation id="3846683726093018685">**סיכום:** במשפט אחד של פחות מ-30 מילים, צריך לתאר את הנושא והמטרה העיקריים של התוכן בצילום המסך.

          **הצעת שאלות:** יצירת רשימה של 3-5 שאלות מעוררות מחשבה שהמשתמש יכול לשאול כדי להבין טוב יותר את צילום המסך. לפחות שאלה אחת צריכה להתייחס באופן ספציפי לאובייקט חזותי, לעיצוב שלו או למיקום שלו.</translation>
<translation id="4250996466392346267"><ph name="PAGE_TITLE" /> - Shuttle</translation>
<translation id="387514319934708384">‏לאתר הזה דרושה הרשאת גישה לרשת המקומית מ-Chromium</translation>
<translation id="3885770153807205175">הכלי לבחירת שפה</translation>
<translation id="3870879982795295801">‏התאמה אישית וניהול של Shuttle נחוצה פעולה שלך - יש ללחוץ לקבלת פרטים נוספים.</translation>
<translation id="3889543394854987837">‏יש ללחוץ על השם שלך כדי לפתוח את Chromium ולהתחיל לגלוש.</translation>
<translation id="3892148308691398805">העתקת הטקסט</translation>
<translation id="390528597099634151">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל Chromium הזה. כדי להפריד בין פעילויות גלישה, Chromium יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="2803413259281481072">‏התוסף הזה מפר את המדיניות של חנות האינטרנט של Chrome, ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-Shuttle כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="3941890832296813527">שגיאת התקנה: שם הקובץ של מנהל ההתקנה לא תקין או לא נתמך.</translation>
<translation id="3945058413678539331">‏Chromium מנסה להעתיק את הסיסמאות. כדי לאפשר למערכת לעשות זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="3954172517175569325">‏הסיסמאות, אמצעי התשלום והכתובות ששמרת בחשבון שלך ב-Google יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-Chromium, צריך להיכנס שוב לחשבון.</translation>
<translation id="395904275706073188">לא ניתן לקרוא דפים מוגנים. כדאי לנסות דף אחר.</translation>
<translation id="3962647064319009959">‏איך מערכת Chromium שומרת על האבטחה שלך</translation>
<translation id="3967822245660637423">ההורדה הושלמה</translation>
<translation id="8478344872731892094">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Shuttle שולח את הטקסט הזה לכלי החיפוש, הבינה המלאכותית והסוכנים של הארגון כדי לקבל הצעות.</translation>
<translation id="3975724895399328945">‏מידע על &amp;Google Chrome for Testing</translation>
<translation id="3997429360543082038">‏מידע על ChromiumOS</translation>
<translation id="1813754478883624120">‏כשמבקרים באתר מסוים, Shuttle שולח ל<ph name="BEGIN_LINK" />גלישה בטוחה של Google<ph name="END_LINK" /> קטע קוד מעורפל מכתובת ה-URL דרך שרת פרטיות שמסתיר את כתובת ה-IP. אם האתר פועל באופן שמעורר חשד, יישלחו גם כתובות URL מלאות וקטעי תוכן מדפים.</translation>
<translation id="4016217212818346953">מנהל הסיסמאות עוזר לשמור על הבטיחות שלך</translation>
<translation id="4019629340646866719">‏השימוש ב-ChromiumOS מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS" />תוכנות קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספות כמו <ph name="BEGIN_LINK_LINUX_OSS" />סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">תרגום המסך</translation>
<translation id="4023601594785368013">שפה מקורית: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">‏אפשר לפתוח קישורים ב-Chromium מכל אפליקציה. בנוסף Chromium מוצמד לשורת המשימות לגישה נוחה.</translation>
<translation id="3334942702828280015">‏דיווח על <ph name="BEGIN_LINK" />ההגדרות הנוכחיות<ph name="END_LINK" /> יעזור לשפר את Shuttle</translation>
<translation id="4050175100176540509">הגרסה החדשה כוללת שיפורי בטיחות חשובים ותכונות חדשות.</translation>
<translation id="4055805654398742145">מנהל הס&amp;יסמאות</translation>
<translation id="4210170830543121132">{COUNT,plural, =1{‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך דקה. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}one{‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}two{‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}other{‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}}</translation>
<translation id="4118474109249235144">‏מצב פרטי ב-Chromium</translation>
<translation id="4122186850977583290">‏מעבר לדף 'מידע על Chromium'</translation>
<translation id="4135244987012252068">‏אפשר להתאים אישית את Chromium כדי לשנות את מראה הדפדפן</translation>
<translation id="4147856324248078748">‏התאמה אישית של Chromium</translation>
<translation id="4148957013307229264">מתקין...</translation>
<translation id="6643591336183767153">‏<ph name="PAGE_TITLE" /> – כניסה לרשת – Shuttle</translation>
<translation id="8999328492520314624">‏אפליקציות, משחקים, תוספים ועיצובים מעולים בשביל Shuttle.</translation>
<translation id="4217080900579554343">‏כדי לקבל גישה לתוסף הזה ולנתונים נוספים בכל המחשבים, צריך להיכנס ל-Chromium</translation>
<translation id="4217972271355023382">‏כדי לשמור על הבטיחות אונליין בהתאם לאפשרויות שנבחרו על ידי ההורה שלך, עליך לעבור לפרופיל Chromium שבו כבר נכנסת לחשבון עם האימייל <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">מבטל…</translation>
<translation id="4224210481850767180">ההתקנה בוטלה.</translation>
<translation id="4230135487732243613">‏האם לקשר את הנתונים שלך ב-Chromium לחשבון זה?</translation>
<translation id="2078444352649860973">‏מקבלים אזהרות לגבי אתרים מסוכנים, גם כאלה שלא היו ידועים ל-Google לפני כן, בעזרת ניתוח של יותר נתונים מאתרים בהשוואה להגנה הרגילה. אפשר לדלג על האזהרות מ-Shuttle.</translation>
<translation id="4269093074552541569">‏יציאה מ-Chromium</translation>
<translation id="5558993553168424235">‏עזרה בנושא Shuttle</translation>
<translation id="4281844954008187215">תנאי שירות</translation>
<translation id="4285930937574705105">‏ההתקנה נכשלה בשל שגיאה לא צפויה. אם Chromium פועל כעת, יש לסגור אותו ולנסות שוב.</translation>
<translation id="4298125729853015961">‏ייצוא סיסמאות מ-Chromium</translation>
<translation id="4304713468139749426">מנהל הסיסמאות</translation>
<translation id="4334241893986177674">חיפוש צילום המסך הזה</translation>
<translation id="4368547723231502008">‏הקלדת חיפושים ושאלות מכל מקום במכשיר, גם אם Chromium ממוזער</translation>
<translation id="5810569516587906396">‏הפעלת Shuttle יחד עם Windows</translation>
<translation id="4400772909124543403">אין עדכונים כרגע.</translation>
<translation id="3931397122598189404">‏לסגור את Shuttle בכל זאת?</translation>
<translation id="4413205837991854510">תמיד להציג את קיצור הדרך לחיפוש תמונות</translation>
<translation id="8644661686228434842">‏Shuttle יכול לפעול ברקע</translation>
<translation id="603827111501511568">{NUM_EXTENSIONS,plural, =1{‏אנחנו ממליצים להסיר אותו מ-Shuttle. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}one{‏אנחנו ממליצים להסיר אותם מ-Shuttle. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}two{‏אנחנו ממליצים להסיר אותם מ-Shuttle. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}other{‏אנחנו ממליצים להסיר אותם מ-Shuttle. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" />}}</translation>
<translation id="8695231474189911275">‏התאמה אישית ושליטה ב-Shuttle</translation>
<translation id="4427306783828095590">עם ההגנה המשופרת, החסימה של פישינג ותוכנות זדוניות מקיפה יותר</translation>
<translation id="4434353761996769206">שגיאת מנהל התקנה: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3897345295068202634">‏הארגון '<ph name="MANAGER" />' מנהל את Shuttle</translation>
<translation id="444069871276811466">‏הוספת פרופיל Chromium</translation>
<translation id="4447409407328223819">‏מידע על Chrome for Testing</translation>
<translation id="4470974262661801543">‏כדי להשתמש בנתוני Chromium ולשמור אותם בחשבון Google, עליך להזין את ביטוי הסיסמה שלך</translation>
<translation id="4493028449971051158">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כאדמין.</translation>
<translation id="4501471624619070934">ההתקנה נכשלה כי הגישה מוגבלת במדינה הזו.</translation>
<translation id="7538943987967358068">‏לתוסף הזה לא פורסמו נוהלי פרטיות, למשל האופן שבו הוא אוסף נתונים ומשתמש בהם. ההמלצה של Shuttle היא להסיר אותו.</translation>
<translation id="452711251841752011">‏ברוך בואך אל Chromium. נפתח חלון חדש בדפדפן</translation>
<translation id="4531137820806573936">‏ל-Chromium נדרשת הרשאה כדי למפות את הסביבה שלך ולעקוב אחרי תנועות הידיים</translation>
<translation id="4536805923587466102">‏כבר נכנסת לחשבון בתור <ph name="USER_EMAIL_ADDRESS" /> בפרופיל Chromium אחר</translation>
<translation id="7291454099139632344">‏‫Shuttle טוען מראש דפים וכך ניתן לגלוש ולחפש מהר יותר. <ph name="BEGIN_LINK" />מידע נוסף על טעינה מראש של דפים<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">כדי לשפר את הבטיחות באינטרנט לכולם, אפשר לדווח על אתר שלדעתך עשוי לגרום נזק.</translation>
<translation id="4229052424516163100">‏Shuttle חסם את ההורדה הזאת כי השבתת את הגלישה הבטוחה ואי אפשר לאמת את הקובץ</translation>
<translation id="4583692638088316420">‏רוצה לנסות את Google Lens ב-Chromium בטלפון?</translation>
<translation id="4594305310729380060">שמירה למנהל הסיסמאות במכשיר הזה</translation>
<translation id="4559123577107659130">‏יישומי Shuttle</translation>
<translation id="4598116752460667024">מחפשים תהליך כלשהו מהרשימה.</translation>
<translation id="4613863813562375431">‏גרסת ChromiumOS</translation>
<translation id="8540523969518172575">‏העדכון כמעט הושלם! הפעל מחדש את Shuttle‏ כדי לסיים את העדכון.</translation>
<translation id="2509032609305193511">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Shuttle, אבל Shuttle יהיה קצת פחות עמיד בפני מתקפות.</translation>
<translation id="4626321472657185181">‏פתיחת החיפוש באמצעות Chromium</translation>
<translation id="7601899887920501075">‏אזהרה: Shuttle לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב אנונימי, צריך לבטל את הבחירה של האפשרות הזו.</translation>
<translation id="4673151026126227699">‏אם בנוסף ישותפו דוחות שימוש ב-Chromium, הדוחות האלה יכללו את כתובות ה-URL שבהן ביקרת</translation>
<translation id="4673710618874938871">נכנסת בתור <ph name="USER_NAME" />, עם מינוי. פתיחת תפריט החשבון</translation>
<translation id="1081748947768053336">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך Shuttle אחר (<ph name="PROCESS_ID" />) במחשב אחר (<ph name="HOST_NAME" />)‏. Shuttle נעל את הפרופיל כדי שלא ייפגם. אם וידאת שאף תהליך אחר אינו משתמש בפרופיל זה, אפשר את נעילת הפרופיל ולהפעיל את Shuttle מחדש.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="469259825538636168">‏חלק מהנתונים ב-Chromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="4708193446201257833">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Google ב-Chromium. אפשר לשנות את ההגדרות של שירותי Google באמצעות קיצור הדרך <ph name="SHORTCUT" />.</translation>
<translation id="4708774505295300557">‏מישהו נכנס בעבר ל-Chromium מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST" />. יש ליצור משתמש חדש ל-Chromium כדי לשמור על פרטיות המידע שלך.</translation>
<translation id="4724676981607797757">ההתקנה נכשלה בגלל שגיאת פרוטוקול שלא נתמך.</translation>
<translation id="333286104758608669">‏לסגור את Shuttle בכל זאת?</translation>
<translation id="4748217263233248895">‏בוצע עדכון אבטחה מיוחד של Chromium. עכשיו עליך להפעיל מחדש ואנחנו נשחזר את הכרטיסיות.</translation>
<translation id="4771701986670315895">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />" ועוד <ph name="COUNT" /> הרשאות הוסרו על ידי Chromium.</translation>
<translation id="4786083865378785874">‏אם Gemini פתוח ב-Chromium, החלונית הצדדית נשארת פתוחה כשיוצרים כרטיסיות חדשות</translation>
<translation id="479167709087336770">‏נעשה כאן שימוש בבדיקת האיות של חיפוש Google. הטקסט המוקלד בדפדפן נשלח אל Google. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="4814736265800133385">‏שימוש ב-Chromium ללא חשבון</translation>
<translation id="4888717733111232871">‏כלל נכנס עבור Chromium על מנת לאפשר תנועת mDNS.</translation>
<translation id="3854801763817831716">‏הפעלה מחדש לצורך עדכון &amp;Shuttle</translation>
<translation id="4918086044614829423">אישור</translation>
<translation id="4918844574251943176">התמונה הועתקה</translation>
<translation id="4943838377383847465">‏Chromium נמצא במצב רקע.</translation>
<translation id="494490797786467921">‏אפשר ללחוץ כדי לסגור את תיבת הדו-שיח של הכניסה ל-Chromium</translation>
<translation id="4950660488495335294">‏באמצעות פרופילים ב-Chromium, אפשר להפריד את כל הפריטים ב-Chromium. אפשר ליצור פרופילים שמיועדים לחברים ולבני משפחה או פרופילים נפרדים לעבודה ולבילויים בשעות הפנאי.</translation>
<translation id="4987820182225656817">‏אורחים יכולים להשתמש ב-Chromium בלי להשאיר דבר מאחור.</translation>
<translation id="4992938037305302429">‏החשבון שלך ב-Chromium</translation>
<translation id="4994636714258228724">‏הוספת החשבון שלך ל-Chromium</translation>
<translation id="504699503110800016">פתיחת האפשרויות הנוספות</translation>
<translation id="5074496654342756568">‏עם Chromium במכשיר <ph name="DEVICE_TYPE" /> אפשר להשתמש בכל הפריטים של Google שמעניינים אותך</translation>
<translation id="5123973130450702873">‏צריך לתת ל-Chromium הרשאה כדי לעקוב אחרי תנועות הידיים</translation>
<translation id="5141988424377517949">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />" ו"<ph name="PERMISSION_3" />" הוסרו על ידי Chromium.</translation>
<translation id="5174969993834422967">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות, יש ללחוץ על סמל ההתראה בפינה השמאלית של סרגל המיקום.</translation>
<translation id="5174983315706567306">אין מספיק מקום בכונן.</translation>
<translation id="5187123684706427865">‏נדרש אימות מחדש לחשבון Chromium</translation>
<translation id="5223510345050543907">‏עם Chromium ב-iOS אפשר להמשיך מהמקום שבו הפסקת.</translation>
<translation id="5231355151045086930">‏יציאה מ-Chromium</translation>
<translation id="5234764350956374838">סגירה</translation>
<translation id="5249261924633168472">‏פתיחת הקישור בחלון לגלישה &amp;פרטית של Chromium</translation>
<translation id="5276305953263010518">‏כדי לשמור סיסמאות תוך כדי תנועה, צריך להוריד את אפליקציית Chromium</translation>
<translation id="6904011543478254794">‏כדי להחיל את השינויים שביצעת, יש להפעיל מחדש את Shuttle</translation>
<translation id="5286907366254680517">זוהתה</translation>
<translation id="5289287148052354622">‏הורדת אפליקציית Chromium</translation>
<translation id="5294316920224716406">‏בגלישה במצב פרטי, Chromium יציג אזהרה לפני טעינת אתר באמצעות חיבור לא מאובטח</translation>
<translation id="5296581118566748922">‏חיפוש באמצעות Chromium</translation>
<translation id="5313228254328109263">‏שירות פנימי לעדכון של Chromium</translation>
<translation id="5324450571874973775">‏משתמשים בהן עם פיצ'רים אחרים של Gemini ב-Chromium</translation>
<translation id="5346389065299425353">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים</translation>
<translation id="5348677704241861105">‏אפשר לקבל סקירה כללית של המסמך הזה ולשאול את Gemini ב-Chromium שאלות.</translation>
<translation id="5352264705793813212">‏יש ל-Chromium כמה המלצות לגבי בטיחות שכדאי לבדוק</translation>
<translation id="5352361688875342522">‏פרופילים אחרים ב-Chromium</translation>
<translation id="535243042947607642">‏הנתונים מ-Chromium לא נשמרו בחשבון Google שלך ב-ChromiumOS כי פרטי הכניסה לחשבון לא מעודכנים</translation>
<translation id="5358375970380395591">‏הכניסה שלך מתבצעת באמצעות חשבון מנוהל שמעניק למנהל המערכת שלו שליטה על הפרופיל שלך ב-Chromium. הנתונים שלך ב-Chromium, כגון יישומים, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Google, אבל לא ניתן לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">קוד נוסף: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">‏כדי להשתמש בהתאמה אישית, צריך לכלול את Chromium ב'פעילות באינטרנט ובאפליקציות'</translation>
<translation id="5382964351116519680">‏פתיחת החיפוש באמצעות Chromium</translation>
<translation id="4877717772512674872">‏למה קבצים מסוימים נחסמים ב-Shuttle</translation>
<translation id="8341327126333983765">‏מתבצע עדכון של Shuttle‏ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">‏התרת כניסה אל Chromium</translation>
<translation id="2064155379595075287">‏להסיר מ-‏Shuttle‏</translation>
<translation id="1764424071909520660">‏ירידה ברמת הביצועים בתמורה להגברת העמידות של Shuttle בפני מתקפות</translation>
<translation id="5427571867875391349">‏הגדרת Chromium כדפדפן ברירת המחדל שלך</translation>
<translation id="3552564955884420948">‏<ph name="PAGE_TITLE" /> - Shuttle בגרסת בטא</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{‏ההמלצה של Chromium היא להשהות את הכרטיסייה שמאטה את הדפדפן}one{‏ההמלצה של Chromium היא להשהות את הכרטיסיות שמאטות את הדפדפן}two{‏ההמלצה של Chromium היא להשהות את הכרטיסיות שמאטות את הדפדפן}other{‏ההמלצה של Chromium היא להשהות את הכרטיסיות שמאטות את הדפדפן}}</translation>
<translation id="3837394572112225231">‏יכול להיות ש-Shuttle לא יפעל כראוי כי הוא כבר לא נתמך בגרסה הזו של Linux</translation>
<translation id="2864501208955185201">‏‫Shuttle חסם את ההורדה הזו כי הקובץ יכול לפגוע בחשבונות האישיים ובחשבונות שלך ברשתות החברתיות</translation>
<translation id="549669000822060376">‏יש להמתין בזמן ש-Chromium מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="5496810170689441661">‏Chromium מנסה לערוך את הסיסמאות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="549975168243349205">‏עם Chromium אפשר להשתמש בקלות ומכל מקום באפליקציות שמעניינות אותך, כמו Google Drive ו-YouTube.</translation>
<translation id="5524890928877629608">‏הפינה השמאלית העליונה של אזור החיפוש: ‎<ph name="LEFT" />%‎ משמאל, ‎<ph name="TOP" />%‎ מלמעלה</translation>
<translation id="3510916764590863589">‏פתיחה של קובצי PDF ב-Shuttle</translation>
<translation id="5536164441519929134">יש לי שאלה<ph name="LINE_BREAK" />לגבי הכרטיסייה הזו</translation>
<translation id="8317102978607899723">‏אם נכנסת לאתר בפעם הראשונה, Shuttle משבית את האופטימיזציה של JavaScript מטעמי אבטחה.

אם הדף הזה לא פועל כמו שצריך, כדאי להפעיל את האופטימיזציה.</translation>
<translation id="5575874067957905201">‏הצגת Gemini ב-Chromium בסרגל התפריטים של Mac והפעלת מקשי הקיצור</translation>
<translation id="5576587363991567745">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Chromium בתור <ph name="USER_EMAIL_ADDRESS" />. המידע השמור ופריטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כמשתמש רגיל ולא כאדמין.</translation>
<translation id="5580770360767802657">‏שימוש ב-Chromium כברירת מחדל והצמדה שלו</translation>
<translation id="5596627076506792578">אפשרויות נוספות</translation>
<translation id="5605834417512968703">‏אפשר לבחור משהו לחיפוש באמצעות התכונה 'חיפוש תמונות' או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
<translation id="5618818588972826921">‏אפשר לבחור טקסט או תמונה לחיפוש באמצעות התכונה "חיפוש תמונות" או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
<translation id="8908504550344650717">{0,plural, =0{‏יש עדכון ל-Shuttle}=1{‏יש עדכון ל-Shuttle}one{‏עדכון של Shuttle זמין כבר # ימים}two{‏עדכון של Shuttle זמין כבר # ימים}other{‏עדכון של Shuttle זמין כבר # ימים}}</translation>
<translation id="1107298128800350481">‏מחיקת נתונים מאתרים מהמכשיר בכל פעם שסוגרים את Shuttle</translation>
<translation id="5653831366781983928">‏יש להפעיל מחדש את Chromium</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="3675878834104730294">‏הצגת Shuttle בשפה זו</translation>
<translation id="569897634095159764">‏לא ניתן להתחבר לאינטרנט. נדרש אימות של שרת ה-proxy.</translation>
<translation id="7168202961287328687">‏‫Shuttle מפנה מקום בזיכרון שמוקצה לכרטיסיות לא פעילות. כך, לכרטיסיות הפעילות ולאפליקציות אחרות יש יותר משאבים מהמחשב ו-Shuttle פועל מהר. כשחוזרים לכרטיסיות הלא פעילות, הן מופעלות מחדש באופן אוטומטי. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון בזיכרון<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">‏אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="SETTINGS_LINK" /> את נתוני Chromium בחשבון</translation>
<translation id="5800158606660203929">‏אפשר להתאים אישית את Chromium ולנהל אותו. הגדרת Chromium כברירת המחדל.</translation>
<translation id="5802618941556161431">‏רוצה סנכרון מושלם של הסיסמאות, הסימניות וההיסטוריה שלך בין מכשירים? כדאי להגדיר את Chromium כדפדפן ברירת המחדל.</translation>
<translation id="5809516625706423866">‏לא ניתן להתחבר לאינטרנט. HTTP 401: אין הרשאה. צריך לבדוק את ההגדרה של שרת ה-proxy.</translation>
<translation id="4687670724165839540">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Shuttle, אבל Shuttle יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו מושבתת.</translation>
<translation id="5821520528363214608">‏כדי להשתמש בנתוני Chromium ולשמור אותם בחשבון Google, עליך לעדכן את Chromium</translation>
<translation id="5824893331272123205">לא הצלחנו לטעון את החלונית, אפשר לנסות שוב</translation>
<translation id="137189936820997722">‏ברוכים הבאים ל-Shuttle‏</translation>
<translation id="6407035307321626411">‏מפעילה תכונות נוספות שמספקות את ההגנות החזקות ביותר של Shuttle</translation>
<translation id="5871205389137001634">יש ללחוץ כדי לצאת מחיפוש התמונות</translation>
<translation id="3128663943810469943">‏מערכת Shuttle גילתה שהפריטים האלה מכילים תוכנה זדונית:</translation>
<translation id="5889361821821684993">‏Chromium בודק בקביעות כדי לוודא שלדפדפן יש את ההגדרות הבטוחות ביותר. נודיע לך אם צריך לבדוק משהו.</translation>
<translation id="5895138241574237353">הפעלה מחדש</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – כניסה לרשת</translation>
<translation id="5924017743176219022">מתבצעת התחברות לאינטרנט…</translation>
<translation id="5939553720811388432">‏עכשיו נגדיר את Chromium</translation>
<translation id="5941711191222866238">מזעור</translation>
<translation id="5949225980829865667">‏כדי לקבל גישה לסימניה הזו ולנתונים נוספים בכל המכשירים שלך, צריך להיכנס ל-Chromium</translation>
<translation id="5953657885167112863">‏התאמה אישית של Chromium</translation>
<translation id="5960071705175224773">ההגדרות שלך שונו על ידי אפליקציה לא ידועה</translation>
<translation id="5977420883993828287">התכונה הוצמדה. מעכשיו אפשר להשתמש ב"משימות לפי הקשר" דרך סרגל הכלים</translation>
<translation id="5340341384223569715">{COUNT,plural, =1{‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך דקה.}one{‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}two{‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}other{‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}}</translation>
<translation id="5987687638152509985">‏יש לעדכן את Chromium כדי להתחיל את הסנכרון</translation>
<translation id="5990360079535151574">כדי לשאול שאלות תוך כדי גלישה, אפשר ללחוץ על הכפתור משימות לפי הקשר שבסרגל הכלים ולפתוח את החלונית מחדש</translation>
<translation id="6003112304606738118">מתבצעת הורדה… יש עוד <ph name="HOURS" /> שע'</translation>
<translation id="6009821354356307391">הוספה של שאילתת המשך</translation>
<translation id="6040143037577758943">סגירה</translation>
<translation id="6044357424127037044">‏עם אפליקציית Chromium במכשיר <ph name="DEVICE_TYPE" /> אפשר ליהנות עוד יותר מהקניות באינטרנט</translation>
<translation id="6058380562449900225">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-Chromium להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה. המערכת תמשיך לשלוח התראות.</translation>
<translation id="6063093106622310249">‏&amp;פתיחה ב-Chromium</translation>
<translation id="6069027071882229820">העתקה כתמונה</translation>
<translation id="3642130578728163190">‏<ph name="EXTENSION_NAME" /> נוסף ל-‏Shuttle‏</translation>
<translation id="2484600148019262399">‏כדי להתאים אישית את Google Chrome ולשלוט בו טוב יותר, כדאי להוריד את העדכון החדש.</translation>
<translation id="5098189861342100628">‏מופעל • Shuttle לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="611228897408671387">‏החשבון שלך ב-Chromium</translation>
<translation id="8603072311189086377">‏מתן הרשאה לתוסף להציג בקשות גישה בסרגל הכלים של Shuttle</translation>
<translation id="6801818398062031196">‏<ph name="FILE_NAME" /> מסוכן, ולכן Shuttle חסם אותו.</translation>
<translation id="4712579756381990057">‏Shuttle ייסגר בקרוב והנתונים שבו יימחקו</translation>
<translation id="6145820983052037069">‏כאן ניתן לעבור בין פרופילים של Chromium</translation>
<translation id="4257025918694286900">‏אם מאפשרים שימוש בקובצי cookie, יכול להיות שמערכת Shuttle תשתמש בהם במהלך טעינה מראש.</translation>
<translation id="6165508094623778733">למידע נוסף</translation>
<translation id="6173308241973263798">‏צריך למחוק את נתוני Chromium בחשבון</translation>
<translation id="8755328651499078855">‏הקובץ הזה עלול להיות מסוכן<ph name="LINE_BREAK" />דפדפן Shuttle יכול לבדוק את ההורדה הזו אם מזינים את הסיסמה. מידע על הקובץ נשלח אל התכונה 'גלישה בטוחה של Google', אבל הסיסמה והתוכן של הקובץ נשארים במכשיר.</translation>
<translation id="6182736845697986886">ההתקנה נכשלה עקב שגיאה פנימית בשרת העדכון.</translation>
<translation id="6183079672144801177">‏יש לוודא שנכנסת ל-Chromium ב-<ph name="TARGET_DEVICE_NAME" /> שלך ולשלוח שוב.</translation>
<translation id="6212496753309875659">‏במחשב זה קיימת כבר גרסה מתקדמת יותר של Chromium. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של Chromium ולנסות שוב.</translation>
<translation id="1515663301924664480">{0,plural, =0{‏Shuttle יופעל מחדש עכשיו}=1{‏Shuttle יופעל מחדש בעוד שנייה אחת}one{‏Shuttle יופעל מחדש בעוד # שניות}two{‏Shuttle יופעל מחדש בעוד # שניות}other{‏Shuttle יופעל מחדש בעוד # שניות}}</translation>
<translation id="6241367896540709610">‏נדרשת הרשאת גישה לאחסון ב-Chromium כדי להוריד קבצים</translation>
<translation id="6245734527075554892">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Chromium</translation>
<translation id="4713635402704891510">‏יש להפוך את Shuttle לדפדפן ברירת המחדל</translation>
<translation id="6248988683584659830">חיפוש בהגדרות</translation>
<translation id="6261803579884938625">‏כשאפליקציית Chromium מותקנת בטלפון שלך, תכונות הבטיחות הטובות ביותר של Google מלוות אותך לכל מקום</translation>
<translation id="6268381023930128611">‏האם לצאת מ-Chromium?</translation>
<translation id="6270547683008298381">‏הכרטיסיות האלה משתמשות במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-Chromium להשבית אותן.</translation>
<translation id="6281746429495226318">‏התאמה אישית של פרופיל Chromium</translation>
<translation id="6290827346642914212">‏בחירת שם לפרופיל Chromium שלך</translation>
<translation id="6294831894865512704">‏תוסף מבקש ממך להיכנס ל-Chromium</translation>
<translation id="3997120491472930522">‏<ph name="FILE_NAME" /> עלול להיות מסוכן, ולכן Shuttle חסם אותו.</translation>
<translation id="5186109991568427789">‏Shuttle משתמש במצלמה שלך.</translation>
<translation id="6333502561965082103">‏מתבצעת כרגע פעולה אחרת ב-Chromium. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="6334986366598267305">‏קל יותר כעת להשתמש ב-Chromium באמצעות חשבון Google שלך ובמחשבים משותפים.</translation>
<translation id="6347002662287820329">‏כדי להשתמש בקלות בתכונות המוכרות והאהובות, כדאי להגדיר את Chromium בתור דפדפן ברירת המחדל.</translation>
<translation id="7093968037936297432">‏קיצור דרך ב-Shuttle</translation>
<translation id="7334991367988739135">‏Shuttle חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים כאלה ויכול להיות שהקובץ מסוכן</translation>
<translation id="6373523479360886564">‏ברצונך באמת להסיר את התקנת Chromium?</translation>
<translation id="6375219077595103062">ניתן להוסיף קיצור דרך למנהל הסיסמאות</translation>
<translation id="6388799252195623474">אני רוצה עזרה בנושא הזה</translation>
<translation id="6390800440335263989">‏כדי להמשיך, עליך להיכנס ל-Chromium באמצעות החשבון <ph name="EMAIL" />. כך המדיניות של הארגון תחול על המכשיר שלך.</translation>
<translation id="6400112897226594999">‏הלוגו של Chromium בתוך מסך מחשב.</translation>
<translation id="6403826409255603130">‏Chromium הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-Chromium.</translation>
<translation id="6414624068245092115">‏כדי שתמיד תהיה לך אפשרות להשתמש בנתונים ב-Chromium ולשמור אותם בחשבון שלך ב-Google, עליך לאמת את הזהות שלך</translation>
<translation id="3077581991710361221">‏דפדפן Shuttle פועל מהר יותר ותכונות שמשתמשות ב-JavaScript אמורות לפעול כמו שצריך</translation>
<translation id="6436260184216827876">התכונה 'חיפוש תמונות' לא זמינה. יש לנסות שוב מאוחר יותר.</translation>
<translation id="6442900851116057561">‏הפעלה מחדש של ChromiumOS</translation>
<translation id="6836481692352030024">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Shuttle טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="6450948450282634257">‏כדי לעקוב אחרי מחירים ולקבל התראות על ירידות במחיר באתר מסוים, כדאי להוריד את Chromium לטלפון שלך</translation>
<translation id="2653849928907685021">‏מושבת • Shuttle לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="6455857529632101747">‏ברוך בואך לפרופילים של Chromium</translation>
<translation id="6460614424172581323">‏בפתיחה הבאה של Chromium במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להשתמש בקבוצות של כרטיסיות.</translation>
<translation id="6466344609055215035">‏הסרת החשבון מ-Chromium</translation>
<translation id="4119585981464207648">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Shuttle.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="6510925080656968729">‏הסרה של התקנת Chromium</translation>
<translation id="4635313972402880015">‏קיצורי הדרך נפתחים ב-Shuttle</translation>
<translation id="4810254941066760486">‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="6542839706527980775">‏בכל פרופיל מאוחסנים נתוני Chromium משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="6556755379298048869">חיפוש באמצעות מקשי הקיצור.</translation>
<translation id="2636806189032302779">‏<ph name="BEGIN_LINK" />מידע נוסף לגבי השמירה על פרטיות הנתונים ב-Shuttle<ph name="END_LINK" /></translation>
<translation id="5478536825661470867">‏השינויים בהגדרה הזו ייכנסו לתוקף לאחר הפעלה מחדש של Shuttle.</translation>
<translation id="4113260229270901158">‏אפשר לנהל את התוספים בלחיצה על "תוספים" בתפריט הראשי של Shuttle.</translation>
<translation id="656935081669708576">‏אפשר לעבור לפרופיל Chromium אחר כדי לראות סיסמאות</translation>
<translation id="6569556444379005948">‏עם אפליקציית Chromium אפשר ליהנות מכלי ה-AI הכי טובים בכל מקום</translation>
<translation id="7057131640166361945">‏Shuttle שולח את הטקסט שמוקלד בשדות טקסט ל-Google כדי לתקן שגיאות כתיב</translation>
<translation id="6598877126913850652">‏מעבר אל הגדרות ההודעות של Chromium</translation>
<translation id="6600016381025017075">אפשר לחפש משהו בדף הזה</translation>
<translation id="3051968423457057392">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Shuttle‏.</translation>
<translation id="6637908313088374648">‏‫Chromium מופעל עכשיו יחד עם Windows, כך שאפשר להתחיל לגלוש מיד. ניתן להשבית זאת בהגדרות.</translation>
<translation id="6648212540664651655">‏אפשר להמשיך מהמקום שבו הפסקת: Chromium שחזר את הכרטיסיות מהסשן האחרון שלך. כדי להשבית את האפשרות הזאת, צריך לעבור אל</translation>
<translation id="665732753414869868">‏נדרשת הרשאת גישה למצלמה ב-Chromium כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="6669284030132180248">‏אם הסימניות שלך נשמרות גם בחשבון Google, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-Chromium ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="668175097507315160">‏לא בוצע סנכרון של הנתונים ב-ChromiumOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="6691132793308828750">‏להסיר את הנתונים של האפליקציה הזאת מ-Chromium?</translation>
<translation id="6709350901466051922">‏נדרשת הרשאת גישה למיקרופון ב-Chromium עבור האתר הזה</translation>
<translation id="6712881677154121168">שגיאה בהורדה: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="2725737003556499783">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של Shuttle.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של Shuttle.</translation>
<translation id="6729124504294600478">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את Chromium ב'פעילות באינטרנט ובאפליקציות' ובשירותי Google המקושרים</translation>
<translation id="6734291798041940871">‏Chromium כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="6742093177587589736">‏כדי לקבל גישה לסימניות ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-Chromium. לאחר הכניסה, הסימנייה הזו תישמר בחשבון Google.</translation>
<translation id="1073375677278272498">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Shuttle, אבל Shuttle יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו פועלת.</translation>
<translation id="6754665438209053659">{count,plural, =1{‏חלק מהנתונים ב-Chromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו (פריט אחד).}one{‏חלק מהנתונים ב-Chromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}two{‏חלק מהנתונים ב-Chromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}other{‏חלק מהנתונים ב-Chromium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}}</translation>
<translation id="67706546131546258">‏ההמלצה של Chromium היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="6779406956731413166">‏<ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת מאפשרת את השימוש ב-ChromiumOS.</translation>
<translation id="6831043979455480757">תרגום</translation>
<translation id="6847869444787758381">‏Chromium מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="684888714667046800">לא ניתן להתחבר לאינטרנט. אם משתמשים בחומת אש, צריך לוודא ש-<ph name="PRODUCT_EXE_NAME" /> ברשימת ההיתרים.</translation>
<translation id="776553009482398136">‏Shuttle‏ - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">צריך ללחוץ כדי להמשיך</translation>
<translation id="6862030660799253820">חיפוש התמונה הזו באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="6869568587896659271">גישה קלה לאתרים מתחת לסרגל הכתובות</translation>
<translation id="5180440422324801473">‏הפריט "<ph name="EXTENSION_NAME" />" שנמצא ב-Shuttle מכיל תוכנה זדונית</translation>
<translation id="6877155553248388166">‏הפינה הימנית התחתונה של אזור החיפוש: ‎<ph name="RIGHT" />%‎ מימין, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="6896758677409633944">העתקה</translation>
<translation id="6898028264630240901">כדי לשאול שאלות במהלך הגלישה, אפשר להצמיד "משימות לפי הקשר"</translation>
<translation id="6901631050894301805">‏הגדרת Chromium כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="6909503629704372277">‏&amp;ניהול הפרופילים ב-Chromium</translation>
<translation id="4581248703262892072">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS" />
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK" />
            • התוספים יושבתו
            <ph name="LINE_BREAK" />
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAK" />
            • יתאפסו קיצורי הדרך של Shuttle
            <ph name="LINE_BREAKS" />
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="6948031725951063910">‏הגעת למגבלת הסימניות ב-Chromium (<ph name="BOOKMARK_LIMIT" />), לכן חלק מהסימניות עדיין לא נשמרו בחשבון Google.

כדי לשמור סימניות חדשות בחשבון, צריך למחוק חלק מהסימניות הקיימות. יציאה מהחשבון תמחק את הסימניות שלא נשמרו.</translation>
<translation id="6964305034639999644">‏פתיחת הקישור בחלון &amp;אנונימי של Chromium</translation>
<translation id="6965382102122355670">אישור</translation>
<translation id="6985329841647292029">‏התנאים לשימוש ב-ChromiumOS</translation>
<translation id="7003299027384820442">‏כדי להשתמש בנתונים של Chromium ולשמור אותם בחשבון <ph name="ACCOUNT_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7045244423563602563">‏אפשר להתאים אישית את Chromium בדרך שנוחה לך</translation>
<translation id="7047386856539490735">התוצאות האלה מועילות?</translation>
<translation id="705851970750939768">‏יש לעדכן את Chromium‏</translation>
<translation id="3425455063038300019">‏אם אין לתמונה תיאור מועיל, Shuttle ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google.</translation>
<translation id="7074836723476134809">‏אפליקציית Chromium מביאה את העוצמה של ה-AI למכשיר <ph name="DEVICE_TYPE" /> שלך</translation>
<translation id="7134687062119989071">‏כשאפליקציית Chromium מותקנת אצלך בטלפון, הסיסמאות, הכרטיסיות ופריטים נוספים מלווים אותך לכל מקום</translation>
<translation id="7141270731789036260">‏התאמה אישית של Chrome for Testing</translation>
<translation id="2566749447284070075">‏אפשר להשתמש ב-Shuttle בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות</translation>
<translation id="4717037424104880768">‏הסרה של <ph name="EXTENSION_NAME" /> מ-Shuttle</translation>
<translation id="5499504683862746062">‏לפי הגדרת הארגון, נתוני Shuttle נמחקים אוטומטית כשלא משתמשים בהם במשך <ph name="TIMEOUT_DURATION" />. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="718435575166326686">‏נדרשת הרשאת גישה למצלמה ב-Chromium עבור האתר הזה</translation>
<translation id="73779270539924806">‏לא ניתן היה להפעיל את Shuttle. יש לנסות שוב.</translation>
<translation id="7204669035546236137">‏עם Gemini ב-Chromium אפשר לשאול כל דבר, מכל מקום</translation>
<translation id="3909780788712619547">‏כדאי להשאיר את Shuttle ב-Dock כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="7213407614656404070">‏שימוש ב-Chromium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="7216228761061470870">‏כשמשתמשים ב"חיפוש תמונות" במחשב, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת</translation>
<translation id="5152543266278054880">‏מנהל המשימות - Shuttle</translation>
<translation id="7227958669698166857">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Chromium בתור <ph name="USER_EMAIL_ADDRESS" />. המידע השמור ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="7252276985725323153">‏רוצה לגלוש מיד? עכשיו אפשר להגדיר את Chromium להתחיל לפעול יחד עם Windows.</translation>
<translation id="7274695763216404502">התכונה הוצמדה. מעכשיו אפשר להשתמש בתכונה 'חיפוש תמונות' דרך סרגל הכלים</translation>
<translation id="7288567540154601580">כרטיסיות ותוספים</translation>
<translation id="7301179260332476710">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של Shuttle היא להסיר אותו}one{‏ההמלצה של Shuttle היא להסיר אותם}two{‏ההמלצה של Shuttle היא להסיר אותם}other{‏ההמלצה של Shuttle היא להסיר אותם}}</translation>
<translation id="6738087381969111286">‏כדי לשתף אודיו מהמערכת, צריך לפתוח את הגדרות המערכת ולבחור באפשרות "הקלטת אודיו של המערכת בלבד" ל-Shuttle. לאחר מכן צריך להפעיל מחדש את Shuttle.</translation>
<translation id="882134845922037914">‏העדכון של Shuttle‏ מתבצע</translation>
<translation id="5911508944834868675">‏קובץ ההעדפות שלך פגום או לא חוקי. 

Shuttle לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="7324051657739063017">כדי לשאול שאלות תוך כדי גלישה, אפשר לפתוח מחדש את החלונית "משימות לפי הקשר"</translation>
<translation id="734373864078049451">‏היסטוריית האתרים, הסימניות ונתונים נוספים מ-Chromium נמצאים כאן.</translation>
<translation id="7347827960336370838">‏רק מי שיודע את ביטוי הסיסמה יכול לקרוא את הנתונים המוצפנים. ביטוי הסיסמה לא נשלח אל Google ולא מאוחסן אצלה. אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="BEGIN_LINK" />למחוק את נתוני Chromium בחשבון<ph name="END_LINK" />.</translation>
<translation id="5213396397254545050">‏לפי הגדרת מנהל המערכת, Shuttle יפתח את<ph name="ALTERNATIVE_BROWSER_NAME" /> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">משהו השתבש</translation>
<translation id="7241271939430402377">‏כדי לקבל עדכונים של Shuttle בעתיד, צריך macOS מגרסה 13 ואילך. במחשב הזה פועלת גרסה 12 של macOS.</translation>
<translation id="7376384068949534168">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />" ו"<ph name="PERMISSION_2" />" הוסרו על ידי Chromium.</translation>
<translation id="73786666777299047">‏פתיחת חנות האינטרנט של Chrome</translation>
<translation id="7394275517973019558">‏הצגת Gemini ב-Chromium במגש המערכת</translation>
<translation id="7401687852903179959">חיפוש בסרטון בעזרת "חיפוש תמונות"</translation>
<translation id="7407655596887111931">‏‫Chromium מוגדר עכשיו כדפדפן ברירת המחדל</translation>
<translation id="3052711235626610530">‏אפשר להמשיך מהמקום שבו הפסקת: Shuttle משחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להשבית את האפשרות הזו, צריך לעבור אל</translation>
<translation id="7427879960656355200">‏ייבוא סיסמאות אל Chromium</translation>
<translation id="744815265653811511">‏1. לוחצים על <ph name="BUTTON_LABEL" /> למטה
2. לוחצים על <ph name="BUTTON_2" /> בהגדרות של Windows
3. לוחצים על <ph name="BUTTON_3" /> בהתראה של Windows כדי להצמיד את Chromium לסרגל האפליקציות לגישה מהירה</translation>
<translation id="9197089209084271928">‏<ph name="PAGE_TITLE" /> - Shuttle בגרסת פיתוח</translation>
<translation id="7450541714075000668">הטקסט הועתק</translation>
<translation id="313710343255539509">‏כדי להשתמש במיקרופון, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Shuttle גישה</translation>
<translation id="7461356015007898716">‏כדי לקבל עדכונים של Chromium בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="3993055863855039235">‏להפעיל את Shuttle מחדש?</translation>
<translation id="7483335560992089831">‏לא ניתן להתקין את אותה גרסת Chromium שפועלת כרגע. יש לסגור את Chromium ולנסות שוב.</translation>
<translation id="7510190804000607802">‏תזכורת: כל היתרונות של Google – אצלך בכיס</translation>
<translation id="8341160057232502783">‏סביר להניח שאתרים יפעלו כצפוי. אם סוגרים את כל החלונות של Shuttle, מתבצעת יציאה מהחשבון ברוב האתרים, חוץ מחשבון Google אם הוא מחובר ל-Shuttle.</translation>
<translation id="6139170930430750545">{0,plural, =1{‏Shuttle יופעל מחדש בעוד דקה}one{‏Shuttle יופעל מחדש בעוד # דקות}two{‏Shuttle יופעל מחדש בעוד # דקות}other{‏Shuttle יופעל מחדש בעוד # דקות}}</translation>
<translation id="7565444033145385702">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-Chromium להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה.</translation>
<translation id="7445475294019002626">‏כדי להתחיל לגלוש מיד, אפשר להפעיל את Shuttle באופן אוטומטי.</translation>
<translation id="7583399374488819119">מנהל ההתקנה של <ph name="COMPANY_NAME" /></translation>
<translation id="3770734847062637711">‏Shuttle משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="7617377681829253106">‏Chromium השתפר</translation>
<translation id="8871277779820248167">‏עכשיו יש לך יותר תכונות זמינות ב-Shuttle</translation>
<translation id="7624307931717240213">אנחנו משתמשים במידע כדי לשפר את השירות הזה. אפשר לקרוא את מדיניות הפרטיות והתנאים וההגבלות.</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="7650134251917003571">‏הורדת אפליקציית Chromium</translation>
<translation id="7658239707568436148">ביטול</translation>
<translation id="8213236740307893655">‏Shuttle אינו דפדפן ברירת המחדל שלך</translation>
<translation id="7689606757190482937">‏סנכרון והתאמה אישית של Chromium בכל המכשירים שברשותך</translation>
<translation id="7699779824407626136">‏עדכון ל-Chromium</translation>
<translation id="7700735928747402058">‏עבודה מאובטחת ב-Chromium</translation>
<translation id="7716950018788545737">המשימות הסתיימו.</translation>
<translation id="77283119132245232">השירות הזה מספק תיעוד של עקבות המערכת ל-<ph name="BROWSER_NAME" />. אם השירות הזה מושבת, נתוני המעקב אחר הביצועים שנוצרים על ידי הדפדפן לא יכללו אירועים כלל-מערכתיים, כמו אירועי החלפת הקשר ואירועי שרשור מוכנים.</translation>
<translation id="7745317241717453663">‏פעולה זו תמחק את נתוני הגלישה מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Chromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="7747820849741499258">‏חיפוש ב-Chromium</translation>
<translation id="7750130090210923118">‏איפוס לברירת המחדל של Chromium</translation>
<translation id="7752521946322750699">‏כדי להגן על העבודה שלך ב-Chromium, הארגון יוכל לראות מידע מסוים או לנהל אותו אם התחברת לחשבון בדפדפן.</translation>
<translation id="7781047659465034537">‏הגדרת Chromium כדפדפן ברירת המחדל והצמדה שלו לסרגל האפליקציות</translation>
<translation id="7786760609782648049">‏שיפור המהירות ב-Chromium</translation>
<translation id="5390209367680424449">‏<ph name="PAGE_TITLE" /> – Shuttle בגרסת Canary</translation>
<translation id="5236799997529789289">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫Shuttle משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="7810005234485217901">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה</translation>
<translation id="6809035843240398711">‏בחירת המידע שישותף עם Shuttle</translation>
<translation id="7828947555739565424">‏כבר קיים במכשיר פרופיל Chromium עם החשבון הזה.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="2536014991386708485">‏בוצע שינוי מחוץ ל-Shuttle במנוע החיפוש שמוגדר כברירת המחדל. כדי להגן עליך, Shuttle איפס את ההגדרה לערך ברירת המחדל המקורי. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="7853661403199074278">‏אפשר להתאים אישית את Chromium כדי לשנות את המראה שלו.</translation>
<translation id="2266811154496778101">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Shuttle שולח את הטקסט הזה למנוע החיפוש שמוגדר כברירת מחדל כדי לקבל הצעות טובות יותר. האפשרות הזו מושבתת במצב הפרטי.</translation>
<translation id="6065091602420830">‏עדכון Shuttle לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS" /> שנ'</translation>
<translation id="7873537467422636035">‏אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, <ph name="BEGIN_LINK" />עליך למחוק את נתוני Chromium בחשבון<ph name="END_LINK" /></translation>
<translation id="7874369989024033742">‏אפשר לפתוח את Gemini ב-Chromium במהירות מתי שרוצים</translation>
<translation id="7888981273428720788">‏הגדרת Chromium כדפדפן ברירת המחדל</translation>
<translation id="7934340546140346950">‏‫Chromium משדרג חיבורים לא מאובטחים ל-HTTPS באופן אוטומטי כשאפשר</translation>
<translation id="7937630085815544518">‏נכנסת ל-Chromium כ-<ph name="USER_EMAIL_ADDRESS" />. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="7944602660083060118">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Chromium בתור <ph name="USER_EMAIL_ADDRESS" />. הסימניות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="7585793177462647372">‏זוהי התקנה משנית של Shuttle, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="6559029165921633261">‏תוספים, אפליקציות ועיצובים ממקורות לא מוכרים עלולים להזיק למכשיר. ההמלצה של Shuttle היא להתקין אותם רק מ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="8000759043835159571">‏עם אפליקציית Chromium במכשיר <ph name="DEVICE_TYPE" />, אפשר לקבל כל מה שיש ל-Google להציע</translation>
<translation id="8004582292198964060">דפדפן</translation>
<translation id="8010081455002666927">זיהוי אוטומטי</translation>
<translation id="8002328729078921180">‏אחרי מתן גישה ל-Shuttle, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="818329629430342049">‏אפשר להצמיד את Shuttle לסרגל האפליקציות כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="80471789339884597">תודה שהתקנת. עליך להפעיל מחדש את כל הדפדפנים לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">תמיד להציג את קיצור הדרך לחיפוש תמונות</translation>
<translation id="8069447462453318634">צריך לבחור באפשרות "הצמדה לסרגל הכלים"</translation>
<translation id="3155838504016687695">‏השבתת הפעילות של Shuttle ברקע לאפליקציות</translation>
<translation id="80790299200510644">חיפוש באמצעות תמונות</translation>
<translation id="8086881907087796310">ההתקנה נכשלה כי המחשב לא עומד בדרישות החומרה המינימליות.</translation>
<translation id="8096472344908884505">‏<ph name="PAGE_TITLE" /> –‏ Google Chrome for Testing</translation>
<translation id="8105840573057009683">‏נדרשת הרשאת מיקום ב-Chromium עבור האתר הזה</translation>
<translation id="8107060931443639922">‏בפתיחה הבאה של Chromium במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להפעיל התראות על מעקב מחירים.</translation>
<translation id="8117908349476699973">‏התראות על ירידות מחירים של פריטים שמעניינים אותך מחכות לך באפליקציית Chromium בטלפון</translation>
<translation id="8118331347066725040">‏שליחת משוב על חיפוש באמצעות Lens</translation>
<translation id="8130609355518033382">‏רוצה ש-Chromium יתאים לך בול?</translation>
<translation id="8133124826068723441">‏לא בוצע סנכרון של הנתונים ב-ChromiumOS כי אפשרות הסנכרון לא זמינה עבור הדומיין שלך.</translation>
<translation id="813913629614996137">מתבצע אתחול...</translation>
<translation id="8161503455832158203">‏אפשר לפתוח את Gemini ב-Chromium באמצעות מקש קיצור.</translation>
<translation id="369114052288176160">‏תנאים והגבלות נוספים של Shuttle</translation>
<translation id="680378955833427720">‏Shuttle‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8177472873527554730">לא נמצא תוכן בדף</translation>
<translation id="8200109504272824693">‏כדי להשתמש בנתונים של Chromium ולשמור אותם בחשבון <ph name="USER_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="820759916613250543">חיפוש בתמונה בעזרת "חיפוש תמונות"</translation>
<translation id="8221491193165283816">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות יש ללחוץ כאן.</translation>
<translation id="8107647892434846563">‏כדי להשתמש במצלמה, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Shuttle גישה</translation>
<translation id="1786899383568465391">‏‫Shuttle לא יכול לאמת את מקור התוסף הזה ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-Shuttle כדי לא לאפשר לו יותר לראות ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="493819615490030185">‏אם אין לתמונה תיאור מועיל, Shuttle ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="8254601181414348851">‏להיכנס ל-Chromium עם פרופיל חדש?</translation>
<translation id="8262224117913639129">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Chromium בתור <ph name="USER_EMAIL_ADDRESS" />. הסיסמאות שלך ופרטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="8277334259226003205">‏הצגת Gemini ב-Chromium במגש המערכת והפעלת מקשי הקיצור</translation>
<translation id="8286943863733751221">‏<ph name="BEGIN_LINK" />ב-Chromium מוצגות אזהרות<ph name="END_LINK" /> מפני הורדות ואתרים לא בטוחים</translation>
<translation id="8295827201165805317">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאה "<ph name="PERMISSION" />" הוסרה על ידי Chromium.</translation>
<translation id="8296236834352487533">‏אפשר לקנות, לתרגם ולזהות את מה שרואים במצלמה באפליקציית Chromium ל-iOS</translation>
<translation id="8310603974518734211">‏קוד QR לכניסה אל Chromium בתור <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">שגיאת הפעלה: <ph name="STARTUP_ERROR" />.</translation>
<translation id="2189465505625523876">‏לפי הגדרת הארגון, Shuttle נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">שמירה כתמונה</translation>
<translation id="8340674089072921962">‏בכתובת <ph name="USER_EMAIL_ADDRESS" /> השתמשו בעבר ב-Chromium</translation>
<translation id="8351551329754447960">‏הפעלה של מיומנויות ב-Chromium</translation>
<translation id="8359544530202147897">‏כדי להמשיך להשתמש בנתונים של Chromium בחשבון שלך ב-Google (<ph name="ACCOUNT_EMAIL" />), צריך לעדכן את Chromium</translation>
<translation id="8360718212975266891">‏כדי לקבל עדכונים של Chromium בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="8362914115861174987">תרגום ל</translation>
<translation id="8367705492654390392">אפשר לשאול הכל</translation>
<translation id="8370517070665726704">‏Copyright <ph name="YEAR" /> Google LLC.‎ כל הזכויות שמורות.</translation>
<translation id="8372327902843331129">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-Chromium. לאחר הכניסה, הסיסמה הזו תישמר בחשבון שלך ב-Google.</translation>
<translation id="7737586770085807713">‏לאחר מכן יהיה עליך להפעיל מחדש את Shuttle.</translation>
<translation id="458720374088121514">‏ההמלצה של Shuttle היא להסיר אותו. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" /></translation>
<translation id="3243699608914041912">‏הפרסום של התוסף הזה בוטל על ידי המפתח שלו, ויכול להיות שהתוסף לא בטוח. צריך להסיר אותו מ-Shuttle כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="8416884904046428725">‏‫Chromium צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון Google ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="2803567348225973544">{0,plural, =1{‏צריך להפעיל מחדש את Shuttle בתוך יום אחד}one{‏צריך להפעיל מחדש את Shuttle בתוך # ימים}two{‏צריך להפעיל מחדש את Shuttle בתוך # ימים}other{‏צריך להפעיל מחדש את Shuttle בתוך # ימים}}</translation>
<translation id="8438543370129609977">‏כשמשתמשים בתכונה 'חיפוש תמונות', כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">‏מידע נוסף על חיפוש באמצעות התכונה "חיפוש תמונות" ב-Chromium</translation>
<translation id="8453117565092476964">‏הארכיון של המתקין פגום או שאינו חוקי. יש להוריד שוב את Chromium.</translation>
<translation id="8458614432758743027">‏כדי להשתמש ב-Chromium נדרש Windows מגרסה 10 ואילך.</translation>
<translation id="8463672209299734063">‏אופציונלי: שליחה אוטומטית של נתוני אבחון ונתוני שימוש במכשיר אל Google תעזור לשפר את התכונות ואת הביצועים של ChromiumOS.</translation>
<translation id="8471947159125090285">‏כדי להשתמש בנתוני Chromium ולשמור אותם בחשבון Google, עליך לאמת את הזהות שלך</translation>
<translation id="8482493977473846331">‏הצגת פרומפטים לצורך כניסה אל Chromium</translation>
<translation id="4333599663015089415">‏Shuttle אינו מעודכן</translation>
<translation id="8376091195503089226">‏תודה שבחרת ב-Shuttle כדפדפן ברירת המחדל שלך!</translation>
<translation id="8522801943730206384">‏ל-Chromium יש אפשרות לבדוק את הסיסמאות שלך רק אם שמרת אותן</translation>
<translation id="8525579356836940628">ההתקנה נעצרה</translation>
<translation id="8545729292258443488">‏כשאפליקציית Chromium מותקנת במכשיר <ph name="DEVICE_TYPE" /> שלך, הסיסמאות, הכרטיסיות ופריטים נוספים הולכים איתך לכל מקום</translation>
<translation id="8548787790260785208">‏אפשר לקבל אזהרה אם Chromium ימצא שאחת מהסיסמאות שלך דלפה בגלל פרצה באבטחת מידע</translation>
<translation id="8555465886620020932">שגיאה בשירות: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3871600948131730253">‏חלק מהתכונות והתוספים של Shuttle מגיעים עם מקשי קיצור. אפשר להפעיל אותם מחדש.</translation>
