<translation id="8747073452963259673">‏הפינה השמאלית התחתונה של אזור החיפוש: ‎<ph name="LEFT" />%‎ משמאל, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="878572486461146056">שגיאת התקנה: מנהל הרשת החיל מדיניות קבוצתית שמונעת את ההתקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">אני רוצה לקבל תזכורת אחר כך</translation>
<translation id="8816416449795340678">‏כדי לקבל סקירה כללית זריזה ולשאול שאלות המשך, אפשר לשתף את המסמך הזה עם Gemini ב-Chromium</translation>
<translation id="8818550178040858407">‏להיכנס אל Chromium?</translation>
<translation id="1740477639007879167">‏הגדרת Shuttle כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="8826492472752484139">לוחצים על 'מנהל הסיסמאות'</translation>
<translation id="8833697763442816810">‏מערכת ChromiumOS</translation>
<translation id="51810846847651902">‏זו השפה שבה מוצגים תפריטים, הגדרות, התראות וטקסטים אחרים ב-Shuttle</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="8876044221123442390">‏הוספת פרופיל Chromium</translation>
<translation id="8890569919834781711">‏הנתונים מ-Chromium לא נשמרו בחשבון Google שלך ב-ChromiumOS בגלל שגיאה בתהליך הכניסה</translation>
<translation id="8891709362986793894">‏לפי דרישת הארגון שלך, עליך להיכנס לחשבון ב-Chromium</translation>
<translation id="8907580949721785412">‏Chromium מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="8932992523185907506">‏‫Chromium כבר לא מוגדר כדפדפן ברירת המחדל שלך. אני רוצה ש-Chromium יהיה דפדפן ברירת המחדל</translation>
<translation id="7727082350762937793">‏לא ניתן לעדכן את Shuttle</translation>
<translation id="8944232836376404813">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS" />
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK" />
            • התוספים יושבתו
            <ph name="LINE_BREAK" />
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAKS" />
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="8966875421152977384">‏הצגת קיצורי דרך לאתרים ב-Chromium</translation>
<translation id="1008106080699243847">‏הלוגו של Shuttle Enterprise</translation>
<translation id="8980139959902937527">‏עם אפליקציית Chromium במכשיר <ph name="DEVICE_TYPE" />, תכונות הבטיחות של Google הולכות איתך לכל מקום</translation>
<translation id="3649746906258419479">‏אי אפשר להפעיל את Shuttle בגלל שמשהו השתבש בפתיחת הפרופיל. כדאי לנסות להפעיל מחדש את Shuttle.</translation>
<translation id="8988036198400390003">‏ניהול הפרופילים ב-Chromium</translation>
<translation id="8993855408334954620">‏כדי לעבור בין Gemini ב-Chromium לבין הכרטיסייה הפתוחה, אפשר להשתמש במקלדת.</translation>
<translation id="9018218886431812662">ההתקנה הושלמה</translation>
<translation id="9019929317751753759">‏כדי לשפר את האבטחה של Chromium, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="9022552996538154597">‏כניסה אל Chromium</translation>
<translation id="9035791714111278917">‏הצגת החיפוש באמצעות Chromium בסרגל התפריטים של Mac והפעלת מקשי הקיצור</translation>
<translation id="3267341748208131224">‏‫Shuttle חסם את ההורדה הזו כי קובץ הארכיון כולל קבצים אחרים שעלולים להסתיר תוכנות זדוניות</translation>
<translation id="9053882453960391422">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-Chromium. לגישה מהירה, Chromium יוצמד לסרגל האפליקציות.</translation>
<translation id="9056398481763999048">‏רוצה להשתמש בכלי ה-AI הטובים ביותר של Google? כשאפליקציית Chromium מותקנת בטלפון שלך זה אפשרי</translation>
<translation id="9062666675513499497">‏כניסה אל Chromium כשנכנסים לשירותי Google אחרים</translation>
<translation id="4265215433857167851">‏Shuttle נסגר באופן אוטומטי</translation>
<translation id="7469466263552552140">‏Shuttle אינו מעודכן</translation>
<translation id="72499647218501325">{0,plural, =1{‏Shuttle יופעל מחדש בעוד שעה}one{‏Shuttle יופעל מחדש בעוד # שעות}two{‏Shuttle יופעל מחדש בעוד # שעות}other{‏Shuttle יופעל מחדש בעוד # שעות}}</translation>
<translation id="9106236359747881194">אפשר לבחור טקסט לחיפוש</translation>
<translation id="9106612006984859720">‏כדי לקבל עדכונים של Chromium בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.1.</translation>
<translation id="3313508441926611846">‏פתיחת הקישור &amp;בכרטיסיית Shuttle חדשה</translation>
<translation id="911206726377975832">למחוק גם את נתוני הגלישה שלך?</translation>
<translation id="9134482777260927479">עזרה בשיעורי הבית</translation>
<translation id="9148058034647219655">יציאה</translation>
<translation id="373308981796873164">‏רוצה להמשיך מהמקום שבו הפסקת? Shuttle יכול לשחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להפעיל את האפשרות הזו, צריך לעבור אל</translation>
<translation id="4482819741686179260">‏לפי הגדרת מנהל המערכת, Shuttle יפתח דפדפן חלופי כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="5239882079227870661">‏הפעלה מחדש לצורך עדכון &amp;Shuttle</translation>
<translation id="9190841055450128916">‏Chromium ‏(mDNS-In)</translation>
<translation id="924957577793602335">‏אפשר להתאים אישית את Chromium בדרך שנוחה לך</translation>
<translation id="93478295209880648">‏ייתכן ש-Chromium לא יפעל כראוי כי הוא כבר לא נתמך ב-Windows XP וב-Windows Vista</translation>
<translation id="945098430667185067">‏עם Chromium אפשר ליהנות מתכונות הבטיחות הכי טובות של Google.</translation>
<translation id="945522503751344254"> שליחת משוב</translation>
<translation id="965162752251293939">‏מי משתמש/ת ב-Chromium?</translation>
<translation id="967427899662692980">‏רוצה להשיג את רמת האבטחה הגבוהה ביותר של Chromium?</translation>
<translation id="983803489796659991">‏ההתקנה נכשלה כי שרת העדכון לא מכיל נתוני גיבוב (hash) של האפליקציה.</translation>
<translation id="985498048907240953">‏שימוש ב-Chromium ללא חשבון</translation>
<translation id="5192139095541169725">Silkweave</translation>
<translation id="989970834842471429">אפשר לבחור טקסט או תמונה לחיפוש באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="1699696098551154749">‏כדי להשתמש בשירותי המיקום, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Shuttle גישה</translation>
</translationbundle>