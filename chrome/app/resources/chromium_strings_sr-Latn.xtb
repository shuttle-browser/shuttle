<translation id="1515663301924664480">{0,plural, =0{Ponovo ćemo pokrenuti Shuttle}=1{Ponovo ćemo pokrenuti Shuttle za 1 sekundu}one{Ponovo ćemo pokrenuti Shuttle za # sekundu}few{Ponovo ćemo pokrenuti Shuttle za # sekunde}other{Ponovo ćemo pokrenuti Shuttle za # sekundi}}</translation>
<translation id="6241367896540709610">Chromium-u treba pristup memorijskom prostoru da bi preuzimao fajlove</translation>
<translation id="6245734527075554892">Proverava URL-ove sa listom nebezbednih sajtova koji se čuvaju u Chromium-u</translation>
<translation id="4713635402704891510">Podesi Shuttle za podrazumevani pregledač</translation>
<translation id="6248988683584659830">Podešavanja pretrage</translation>
<translation id="6261803579884938625">Koristite najbolje Google bezbednosne funkcije u pokretu uz aplikaciju Chromium na telefonu</translation>
<translation id="6268381023930128611">Želite li da se odjavite iz Chromium-a?</translation>
<translation id="6270547683008298381">Ove kartice koriste dodatne resurse. Da biste poboljšali performanse, dozvolite Chromium-u da ih učini neaktivnim.</translation>
<translation id="6281746429495226318">Prilagodite Chromium profil</translation>
<translation id="6290827346642914212">Dajte naziv Chromium profilu</translation>
<translation id="6294831894865512704">Dodatak želi da se prijavite u Chromium</translation>
<translation id="3997120491472930522">Datoteka <ph name="FILE_NAME" /> je možda opasna, pa ju je Shuttle blokirao.</translation>
<translation id="5186109991568427789">Shuttle koristi kameru.</translation>
<translation id="6333502561965082103">Druga radnja u Chromium-u je u toku. Probajte ponovo kasnije.</translation>
<translation id="6334986366598267305">Sada možete lakše da koristite Chromium sa Google nalogom i na deljenim računarima.</translation>
<translation id="6347002662287820329">Podesite Chromium kao podrazumevani pregledač da biste lako pristupali funkcijama koje znate, volite i kojima verujete.</translation>
<translation id="7093968037936297432">Shuttle prečica</translation>
<translation id="7334991367988739135">Shuttle je blokirao ovo preuzimanje jer se ovaj fajl ne preuzima često i može da bude opasan</translation>
<translation id="6373523479360886564">Jeste li sigurni da želite da deinstalirate Chromium?</translation>
<translation id="6375219077595103062">Dodajte prečicu u Menadžer lozinki</translation>
<translation id="6388799252195623474">pomoć u vezi sa ovim</translation>
<translation id="6390800440335263989">Da biste nastavili, prijavite se u Chromium kao <ph name="EMAIL" />. Time se omogućava da se na nalog primenjuju smernice organizacije.</translation>
<translation id="6400112897226594999">Chromium logotip na ekranu računara.</translation>
<translation id="6403826409255603130">Chromium je veb pregledač koji pokreće veb-stranice i aplikacije munjevitom brzinom. Brz je, stabilan i jednostavan za korišćenje. Pregledajte Veb bezbednije sa zaštitom od malvera i „pecanja“ koja je ugrađena u Chromium.</translation>
<translation id="6414624068245092115">Da biste bili sigurni da uvek možete da koristite i čuvate Chromium podatke na Google nalogu, potvrdite svoj identitet</translation>
<translation id="3077581991710361221">Shuttle radi brže i funkcije koje koriste JavaScript bi trebalo da rade kako je predviđeno</translation>
<translation id="6436260184216827876">Pretraga slika nije dostupna. Probajte ponovo kasnije.</translation>
<translation id="6442900851116057561">Restartujte Chromium OS</translation>
<translation id="6836481692352030024">Shuttle predučitava još više stranica koje ćete verovatno posetiti, kako bi se brže učitavale kada ih posetite</translation>
<translation id="6450948450282634257">Preuzmite Chromium na telefon da biste pratili cene i dobijali obaveštenja kada cena padne na bilo kom sajtu</translation>
<translation id="2653849928907685021">Isključeno • Shuttle ne može da proveri odakle potiče ovaj dodatak</translation>
<translation id="6455857529632101747">Dobro došli u Chromium profile</translation>
<translation id="6460614424172581323">Sledeći put kada otvorite Chromium na uređaju <ph name="DEVICE_TYPE" />, videćete upit da koristite grupe kartica.</translation>
<translation id="6466344609055215035">Ukloni nalog iz Chromium-a</translation>
<translation id="4119585981464207648">Kontroliše i stranicu koja se prikazuje kada pokrenete Shuttle.</translation>
<translation id="648319183876919572">Poboljšano bezbedno pregledanje doprinosi zaštiti od opasnih veb-sajtova i preuzimanja</translation>
<translation id="6510925080656968729">Deinstaliraj Chromium</translation>
<translation id="4635313972402880015">Prečice se otvaraju u Shuttle-u</translation>
<translation id="4810254941066760486">Organizacija zatvara Shuttle kada se ne koristi <ph name="TIMEOUT_DURATION" />. Podaci pregledanja su izbrisani. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja.</translation>
<translation id="6542839706527980775">Svaki profil zadržava sopstvene Chromium podatke, poput obeleživača, istorije, lozinki i drugog sadržaja</translation>
<translation id="6556755379298048869">Pretražujte pomoću tasterske prečice.</translation>
<translation id="2636806189032302779">Saznajte više o tome <ph name="BEGIN_LINK" />kako Shuttle štiti privatnost podataka<ph name="END_LINK" /></translation>
<translation id="5478536825661470867">Promene ovog podešavanja će se primeniti kada se Shuttle restartuje.</translation>
<translation id="4113260229270901158">Upravljajte dodacima klikom na Dodaci u glavnom meniju Shuttle-a.</translation>
<translation id="656935081669708576">Možete da se prebacite da biste videli lozinke sa drugog Chromium profila</translation>
<translation id="6569556444379005948">Koristite aplikaciju Chromium i ponesite sa sobom najbolje AI alatke</translation>
<translation id="7057131640166361945">Da bi ispravio pravopisne greške, Shuttle šalje Google-ovim serverima tekst koji unosite u polja za tekst.</translation>
<translation id="6598877126913850652">Idi na podešavanja obaveštenja za Chromium</translation>
<translation id="6600016381025017075">Pretražite bilo šta na ovoj stranici</translation>
<translation id="3051968423457057392">Promene će stupiti na snagu kada sledeći put ponovo pokrenete Shuttle.</translation>
<translation id="6637908313088374648">Chromium se sada pokreće kada se pokrene Windows da biste mogli odmah da počnete da pregledate. To možete da isključite u podešavanjima.</translation>
<translation id="6648212540664651655">Nastavite tamo gde ste stali: Chromium je vratio kartice iz poslednje sesije. To možete da isključite u</translation>
<translation id="665732753414869868">Chromium-u treba dozvola za kameru da bi napravio 3D mapu okruženja</translation>
<translation id="6669284030132180248">Ako sačuvate obeleživače i na Google nalogu, možete da pratite cene proizvoda u Chromium-u i da dobijate obaveštenja kada padne cena</translation>
<translation id="6676384891291319759">Pristupite Internetu</translation>
<translation id="668175097507315160">Chromium OS ne može da sinhronizuje podatke zbog greške pri prijavljivanju.</translation>
