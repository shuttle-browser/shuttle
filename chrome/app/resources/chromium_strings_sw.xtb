<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="1026101648481255140">Endelea na Usakinishaji</translation>
<translation id="1029669172902658969">Fungua tena ili usasishe Mfumo wa Uendeshaji wa Chromium</translation>
<translation id="8271032073852564289">Agent Chrome inapendekeza ukague kiendelezi hiki</translation>
<translation id="1395700234492294565">Agent Chrome hutumia seva za Google, tovuti inapoomba viungo vipakiwe mapema kwenye ukurasa wake kwa njia ya faragha. Hali hii huficha utambulisho wako usionekane kwenye tovuti inayopakiwa mapema lakini Google hufahamu tovuti zinazopakiwa mapema.</translation>
<translation id="1051793555070215510">Tusaidie kuboresha kipengele cha Faraghani kwa kushiriki katika utafiti huu wa dakika 1.</translation>
<translation id="1065672644894730302">Mapendeleo yako hayawezi kusomwa.

Baadhi ya vipengele huenda visipatikane na mabadiliko katika mapendeleo hayatahifadhiwa.</translation>
<translation id="3693661839172633833">Mzazi wako amezima "Ruhusa za tovuti, programu na viendelezi" kwenye Agent Chrome</translation>
<translation id="4676383270508741906">Ili utafute kipengele au kiendelezi mahususi cha Agent Chrome, andika njia yake ya mkato katika sehemu ya anwani, ikifuatiwa na kitufe cha kibodi ulichochagua</translation>
<translation id="1098493699368672217">Onyesha huduma ya kutafuta ukitumia Chromium katika ubao wa aikoni kisha uwashe mikato ya kibodi</translation>
<translation id="1104942323762546749">Chromium ingependa kuhamisha manenosiri yako. Andika nenosiri lako la Windows ili uruhusu shughuli hii.</translation>
<translation id="112640046208448578">Tambua vitu au maeneo kisha unakili au utafsiri maandishi. Unapotumia kipengele cha Kutafuta kwa Picha, picha ya skrini ya ukurasa hutumwa kwenye seva. <ph name="LEARN_MORE" /></translation>
<translation id="5373975050135708711">Agent Chrome ni kivinjari chako chaguomsingi</translation>
<translation id="1131805035311359397">Ili uangalie kama manenosiri yako ni salama dhidi ya ufichuzi haramu wa data na matatizo mengine ya usalama, <ph name="BEGIN_LINK" />ingia katika akaunti kwenye Chromium<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Bofya menyu ya Chromium</translation>
<translation id="1157985233335035034">Lugha ulizotumia hivi majuzi</translation>
<translation id="1184145431117212167">Imeshindwa kuweka kwenye kifaa kwa sababu toleo la Windows ulilonalo halitumiki.</translation>
<translation id="604454529346438712">Kuhusu Agent Chrome</translation>
<translation id="1186645291482254714">Pata arifa za ufuatiliaji wa bei ukitumia Chromium kwenye simu yako</translation>
<translation id="1203500561924088507">Asante kwa kusakinisha. Ni lazima uzime kisha uwashe tena kivinjari chako kabla ya kutumia <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Ukifungua kipengele cha Kutafuta kwa Picha, jina la ukurasa, URL na maudhui, ikiwa ni pamoja na PDF, yatatumwa kiotomatiki kwenye seva. <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">Wakati umeingia katika akaunti, unaweza kutumia manenosiri yako na mengineyo kwenye Akaunti yako ya Google katika Chromium. Ili ubadilishe mipangilio hii, nenda kwenye “Akaunti yako katika Chromium”.</translation>
<translation id="1244381985120794049">Onyesha Gemini kwenye Chromium katika upau wa menyu wa Mac</translation>
<translation id="1257483544893909270">Tumia mikato ya kibodi kuchagua sehemu ya skrini katika Gemini kwenye Chromium.</translation>
<translation id="1262876892872089030">Kichupo hiki kilipokuwa hakitumiki, nafasi ya hifadhi ilirejeshwa ili Chromium iwe na kasi ya utendaji. Unaweza kuchagua tovuti hii iendelee kutumika kila wakati.</translation>
<translation id="3777643518642881741">Agent Chrome imezuia upakuaji huu kwa sababu faili si salama</translation>
<translation id="126567311906253476">Unapoingia katika akaunti za huduma za Google kama Gmail au YouTube ukitumia <ph name="USER_EMAIL" />, unaweza kuingia katika akaunti kiotomatiki kwenye Chromium ukitumia akaunti ile ile</translation>
<translation id="1287534462498555020">Pakua Chromium kwenye simu yako</translation>
<translation id="1290883685122687410">Hitilafu ya kuweka mipangilio: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Weka mipangilio ya wasifu wako mpya wa Chromium</translation>
<translation id="132092532143527429">Jaribu ukitumia Gemini kwenye Chromium</translation>
<translation id="200785071050073583">Agent Chrome inahitaji ruhusa ya kufikia Bluetooth ili kugundua 
 vifaa vyenye Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">Ingia katika Chromium kwenye simu yako</translation>
<translation id="1330562121671411446">Tambua lugha</translation>
<translation id="1342274909142618978">Futa pia data kutoka Chromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Kimebandikwa! Unaweza kufikia tena kipengele cha Kutafuta kwa Picha katika kitufe kipya kilicho kwenye upau wa vidhibiti</translation>
<translation id="1356661055722410047">Mpya! Unaweza kutafsiri maandishi na picha kwenye skrini yako</translation>
<translation id="1383876407941801731">Tafuta</translation>
<translation id="1388276868779258475">Tumia programu ya Chromium ili uendelee kuvinjari popote ulipo</translation>
<translation id="141901961143729572">Eleza mawazo yako</translation>
<translation id="8789809509510733987">Ili uonyeshe dirisha lako, washa kinasa skrini katika Agent Chrome kwenye Mipangilio ya Mfumo.</translation>
<translation id="1478370723027452770">Pata usaidizi kuhusu Chrome ya Majaribio</translation>
<translation id="1497802159252041924">Hitilafu ya kusakinisha: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Ukurasa huu umelindwa</translation>
<translation id="3850708453627715578">Shiriki kichupo cha Agent Chrome</translation>
<translation id="154404805518949443">Ingia katika Chromium</translation>
<translation id="1547469039832541117">Hukamilisha jukumu lililoangaziwa.</translation>
<translation id="8546278207686764484">Bandika Agent Chrome</translation>
<translation id="1574377791422810894">Zana usalama za Chromium</translation>
<translation id="1594928384848033697">Chromium ingependa kufuta data yako ya Kidhibiti cha Manenosiri. Weka nenosiri lako la Windows ili uruhusu hatua hii.</translation>
<translation id="551713766576210710">{COUNT,plural, =0{Msimamizi wako anataka ufungue Agent Chrome tena ili utumie sasisho}=1{Msimamizi wako anataka ufungue Agent Chrome tena ili utumie sasisho. Haitafungua upya dirisha fiche.}other{Msimamizi wako anataka ufungue Agent Chrome tena ili utumie sasisho. Haitafungua upya madirisha # fiche.}}</translation>
<translation id="1623563412065267963">Nufaika zaidi na Google ukitumia programu ya Chromium kwenye simu yako</translation>
<translation id="1625909126243026060">Kagua vidhibiti muhimu vya faragha na usalama katika Chromium</translation>
<translation id="1640672724030957280">Inapakua...</translation>
<translation id="1665602916345474427">Umeingia ukitumia akaunti ya <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, uanachama. Fungua menyu ya akaunti</translation>
<translation id="2604712040942461790">Unaweza kutumia Agent Chrome wakati wowote unapobofya viungo kwenye ujumbe, hati na programu nyingine. Pia itabandikwa kwenye upauzana wako.</translation>
<translation id="1709772298389099340">Huwezesha ufikiaji maalum wa <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Hii itakuruhusu kuchagua kwenye vifaa vinavyopatikana na kuonyesha maudhui kwenye vifaa hivyo.</translation>
<translation id="4145295773323539953">Agent Chrome itafuta data ya kuvinjari hivi karibuni</translation>
<translation id="1736443181683099871">Chromium itajaribu kuboresha usogezaji ili utumie HTTPS</translation>
<translation id="7280502947294080605">Imefuta data ya Agent Chrome</translation>
<translation id="1745121272106313518">Chromium itazima kisha iwake baada ya <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Wakati kiendelezi cha HTTPS hakipatikani, Chromium itatumia muunganisho usio salama bila kukutahadharisha</translation>
<translation id="1887395919652703120">Acha Agent Chrome iendeshe katika mandharinyuma</translation>
<translation id="1779356040007214683">Ili kufanya Chromium salama zaidi, tumezima baadhi ya viendelezi ambavyo havijaorodheshwa katika <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> na ambavyo huendwa viliongezwa pasipo ridhaa yako.</translation>
<translation id="1793486931176048546">Bofya <ph name="BEGIN_BOLD" />Ndiyo<ph name="END_BOLD" /> kwenye arifa ya Windows ili ubandike Chromium kwenye upauzana wako ili uifikie kwa haraka.</translation>
<translation id="357645171972700077">Sakinisha Agent Chrome Upya</translation>
<translation id="1820835682567584003">Chromium inajaribu <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">Utakapofungua Chromium tena kwenye <ph name="DEVICE_TYPE" /> yako, utaona kidokezo cha kutumia Kidhibiti cha Manenosiri cha Google.</translation>
<translation id="1838374766361614909">Futa utafutaji</translation>
<translation id="18552579716432081">Ili ufute data ya kuvinjari kwenye kifaa hiki pekee, bila kuifuta katika Akaunti yako ya Google, <ph name="BEGIN_LINK" />ondoka kwenye akaunti ya Chromium<ph name="END_LINK" />.</translation>
<translation id="1857749206890802997">Pakua Chromium kwenye simu yako ili ufungue au uanzishe vikundi vipya vya vichupo popote ulipo.</translation>
<translation id="185970820835152459">Unaweza kudhibiti Akaunti zako za Google ulizotumia kuingia katika tovuti na programu. Akaunti zako za Google hutumiwa kwenye kivinjari cha Chromium, Duka la Google Play, Gmail na kwingineko. Iwapo ungependa kuweka akaunti ya mtu mwingine, kama vile mwanafamilia, ongeza mtu mpya kwenye <ph name="DEVICE_TYPE" /> yako badala yake. <ph name="LINK_BEGIN" />Pata maelezo zaidi<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Tafuta ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="1863837059069884561">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER" />. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti ya Chromium kwenye wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS" />. Pia utapata alamisho zako na zaidi kwenye <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Chagua maandishi</translation>
<translation id="1881322772814446296">Unaingia katika akaunti ukitumia akaunti inayodhibitiwa na kumpa msimamizi wa akaunti hiyo udhibiti wa wasifu wako kwenye Chromium. Data yako ya Chromium, kama vile programu zako, alamisho, historia, manenosiri, na mipangilio nyingine itahusishwa na<ph name="USER_NAME" /> kabisa. Utaweza kufuta data hii kupitia Dashibodi ya Akaunti za Google, lakini hutaweza  kuunganisha data hii na akaunti nyingine. Unaweza kwa hiari kuunda wasifu mpya ili kuweka data yako ya Chromium iliyo kando. <ph name="LEARN_MORE" /></translation>
<translation id="4964792828232534953">Agent Chrome huhifadhi chaji ya betri kwa kudhibiti shughuli za chinichini na madoido ya picha, kama vile usogezaji rahisi na kasi za picha za video. <ph name="BEGIN_LINK" />Pata maelezo zaidi kuhusu Kiokoa Nishati<ph name="END_LINK" /></translation>
<translation id="1900969832270057921">Huduma ya Kisasishaji cha Chromium</translation>
<translation id="1911763535808217981">Kwa kuzima kipengele hiki, unaweza kuingia katika tovuti za Google kama vile Gmail bila kuingia katika akaunti ya Chromium</translation>
<translation id="1929939181775079593">Chromium haiamiliki. Zindua upya sasa?</translation>
<translation id="1933341829955786215">Shirika lako, <ph name="MANAGER" /> linataka uingie katika akaunti ya Chromium</translation>
<translation id="193439633299369377">Mfumo wa Uendeshaji wa Chromium unahitaji kuzimwa na kuwashwa ili utekeleze usasishaji.</translation>
<translation id="207375373460618430">Agent Chrome imezuia upakuaji huu kwa sababu aina hii ya faili kwa kawaida haipakuliwi na huenda si salama</translation>
<translation id="1953553007165777902">Inapakua... Zimesalia dakika <ph name="MINUTE" /></translation>
<translation id="700162948230159797">Agent Chrome haijafaulu kubainisha wala kuweka kivinjari chaguomsingi</translation>
<translation id="197326043290947695">Vinjari kwa umahiri ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="1990262977744080398">Fahamu kwa nini Chromium huzuia baadhi ya faili, huzifungua kwenye kichupo kipya</translation>
<translation id="1999715455684970349">Husasisha programu yako ya Chromium. Huduma hii ikizimwa au kusimamishwa, programu yako ya Chromium haitasasishwa, hali inayomaanisha kuwa hatari za usalama zinazoweza kutokea haziwezi kurekebishwa na huenda vipengele visifanye kazi. Huduma hii hujiondoa kwenye kifaa ikiwa hakuna programu ya Chromium inayoitumia.</translation>
<translation id="2008474315282236005">Hatua hii itafuta kipengee 1 kwenye kifaa hiki. Ili urejeshe data yako baadaye, ingia katika Chromium ukitumia <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Imeshindwa kusakinisha. Tafadhali jaribu tena.</translation>
<translation id="2039417478970545937">Mipangilio.</translation>
<translation id="2049376729098081731">Chagua iwapo ungependa kujumuisha historia kwenye Chromium ili upate hali ya utumiaji inayokufaa zaidi katika huduma za Google</translation>
<translation id="2050698962207788467">Kimejumuishwa kwenye Chromium ili kukusaidia kubuni, kuhifadhi na kujaza kiotomatiki manenosiri thabiti. Weka njia ya mkato ili ufikie kwa urahisi.</translation>
<translation id="2064856577282482477">Bofya kitufe cha Weka Chromium upendavyo kwenye Ukurasa Mpya wa Kichupo ili uipe Chromium mwonekano mpya</translation>
<translation id="6816376218079012438">Agent Chrome imezuia upakuaji huu kwa sababu faili inapotosha na huenda ikafanya mabadiliko yasiyotarajiwa kwenye kifaa chako</translation>
<translation id="208726765006323911">Utaona kidokezo cha kujaribu <ph name="FEATURE_NAME" /> utakapofungua Chromium kwenye kifaa cha iOS tena.</translation>
<translation id="2099452623287920103">Manenosiri na data yako nyingine ya Chromium uliyohifadhi kwenye Akaunti yako ya Google itaondolewa kwenye kifaa hiki. Ili uzitumie tena kwenye Chromium, ingia tena katika akaunti.</translation>
<translation id="8983263343920390117">{COUNT,plural, =1{Shirika lako hufuta kiotomatiki data ya kuvinjari Agent Chrome isipotumika kwa dakika 1. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa. Vichupo vyako havitafungwa.}other{Shirika lako hufuta kiotomatiki data ya kuvinjari Agent Chrome isipotumika kwa dakika #. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa. Vichupo vyako havitafungwa.}}</translation>
<translation id="2125838419757773031">Chagua sehemu ya skrini ili utafute</translation>
<translation id="2126108037660393668">Faili iliyopakuliwa imeshindwa kuthibitishwa.</translation>
<translation id="2135919691573380097">Ripoti tovuti hii</translation>
<translation id="2137162749895930932">Funga skrini ya kutafsiri</translation>
<translation id="822057692680289847">Agent Chrome imezuia upakuaji huu kwa sababu tovuti haitumii muunganisho salama na huenda faili imeharibiwa</translation>
<translation id="2170098639895543546">Chagua chochote kwenye ukurasa</translation>
<translation id="2174178932569897599">Weka mipangilio ya Chromium upendavyo</translation>
<translation id="2174917724755363426">Usakinishaji haujakamilika. Je, una uhakika unataka kughairi?</translation>
<translation id="922967513335788675">Agent Chrome - Kuingia katika Akaunti ya Mtandao - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Hitilafu ya ukaguzi wa sasisho: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Ondoa akaunti kwenye Chromium</translation>
<translation id="2201788217099588893">Tumia programu ya Chromium ili upate zana bora za ununuzi popote ulipo</translation>
<translation id="2210502920229141283">Imarisha usalama wako popote ulipo kwa kutumia Kipengele cha Kuvinjari Salama Kilichoboreshwa katika Chromium kwenye iOS</translation>
<translation id="2210682093923538346">Tovuti hatari. Chromium imeondoa arifa.</translation>
<translation id="2236949375853147973">Shughuli Zangu</translation>
<translation id="2238130810669087193">Ingia kwenye Chromium ili upate anwani zako na vipengee vingine katika vifaa vyako vyote. Anwani hii itahifadhiwa kwenye Akaunti yako ya Google ukishaingia katika akaunti.</translation>
<translation id="2241627712206172106">Kama unatumia kompyuta pamoja na wengine, marafiki na familia wanaweza kuvinjari tofauti na kusanidi Chromium jinsi wapendavyo.</translation>
<translation id="22571759390241347">Ujuzi kwenye Chromium</translation>
<translation id="2283803047247799269">Tafuta kichupo hiki ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Chromium inapendekeza usitishe kichupo kinachopunguza kasi ya kivinjari chako}other{Chromium inapendekeza usitishe vichupo vinavyopunguza kasi ya kivinjari chako}}</translation>
<translation id="2307973900865360088">Weka katika sehemu ya Kupachika</translation>
<translation id="2313870531055795960">Hukagua URL ili kuona iwapo zipo kwenye orodha ya tovuti zisizo salama zilizohifadhiwa katika Chromium. Ikiwa tovuti inajaribu kuiba nenosiri lako au unapopakua faili hatari, Chromium inaweza pia kutuma URL, ikiwa ni pamoja na sehemu za maudhui ya ukurasa, kwa kipengele cha Kuvinjari Salama.</translation>
<translation id="2356070529366658676">Uliza</translation>
<translation id="2359808026110333948">Endelea</translation>
<translation id="2361918034042471035">Kiendelezi cha "<ph name="EXTENSION_NAME" />" kinakuhitaji uingie katika Chromium</translation>
<translation id="2028456545634496358">Zima Agent Chrome Inayotumika Chinichini kwenye Programu</translation>
<translation id="2374216753258219393">Ili utumie kiendelezi hiki ukitumia <ph name="USER_EMAIL_ADDRESS" />, ingia katika Chromium.</translation>
<translation id="2384373936468275798">Mfumo wa Uendeshaji wa Chromium haukusawazisha data yako kwa sababu maelezo ya kuingia katika akaunti yako yamepitwa na wakati.</translation>
<translation id="3040857862310351495">{NUM_DEVICES,plural, =0{Kiendelezi kimoja au zaidi cha Agent Chrome kilikuwa kinafikia kifaa 1 cha HID}=1{Kiendelezi kimoja au zaidi cha Agent Chrome kinafikia kifaa 1 cha HID}other{Kiendelezi kimoja au zaidi cha Agent Chrome kinafikia vifaa # vya HID}}</translation>
<translation id="2401032172288869980">Chromium inahitaji ruhusa ya kufikia kamera na maikrofoni kwa ajili ya tovuti hii</translation>
<translation id="2403703063067034158">Hitilafu ya kuwasha: tukio jingine la uwekaji mipangilio linaendelea kwa sasa, tafadhali jaribu tena baadaye.</translation>
<translation id="2418322681019544463">Fungua viungo katika Chromium kwenye programu yoyote na ufanye kivinjari kiweze kufikiwa kwenye upauzana wako</translation>
<translation id="2425157128016763890">Ruhusu Gemini kwenye Chromium ifikie hati hii kwa kubofya kitufe cha Andaa muhtasari ili upate muhtasari wa haraka na uulize maswali ya nyongeza</translation>
<translation id="2440750600860946460">Kwa kutumia <ph name="BEGIN_LINK" />zana kutoka Chromium<ph name="END_LINK" />, unaweza kuvinjari kwa usalama na kuwa na udhibiti</translation>
<translation id="2449487342837813167">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER" />. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti ya Chromium kwenye wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS" />. Pia utapata manenosiri yako na zaidi kwenye vifaa vyako vyote.</translation>
<translation id="2451727308784734061">Tumia njia yako ya mkato ili ufikie Kidhibiti cha Manenosiri kwa haraka. Unaweza kuhamishia njia yako ya mkato kwenye skrini ya kwanza ya kompyuta yako au kifungua programu.</translation>
<translation id="4405360797107732759">Agent Chrome itafungwa hivi karibuni</translation>
<translation id="1660473983484527105">Katika Agent Chrome</translation>
<translation id="2485422356828889247">Ondoa</translation>
<translation id="2513154137948333830">Unahitaji kuwashwa tena: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Chagua maandishi ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="2554739539410784893">Chromium inajaribu kubadilisha manenosiri yaliyopo. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="2560420686485554789">Chromium inahitaji ruhusa ya kufikia hifadhi ili ipakue faili</translation>
<translation id="8620990455069644819">Kisaidizi cha Agent Chrome</translation>
<translation id="2575822587468774919">Chagua hoja yoyote ya kutafuta ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="2576118232315942160">Ili upate manenosiri yako na zaidi kwenye vifaa vyako vyote, ingia katika akaunti kwenye Chromium</translation>
<translation id="2587622539943955767">Changanua msimbo wa QR ukitumia simu yako ili upakue Chromium kisha uingie katika Akaunti yako ya Google.</translation>
<translation id="4496289616420025644">Endelea kutumia Agent Chrome</translation>
<translation id="259935314519650377">Imeshindwa kuweka akiba ya kisakinishaji kilichopakuliwa. Hitilafu: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Mfumo</translation>
<translation id="2629740064077610681">Shirika lako linaweza kuona na kudhibiti data ya kuvinjari, kama vile alamisho, historia na manenosiri yako. Haliwezi kuona data ya kuvinjari katika wasifu mwingine kwenye Chromium</translation>
<translation id="2635452620547538388">Thibitisha kuwa ni wewe ili utumie na uhifadhi data ya Chromium katika akaunti yako, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8944895445911901418">{COUNT,plural, =0{Mipangilio ya Ulinzi wa Hali ya Juu huhitaji ufungue Agent Chrome tena ili utumie sasisho}=1{Mipangilio ya Ulinzi wa Hali ya Juu huhitaji ufungue Agent Chrome tena ili utumie sasisho. Dirisha lako la faraghani halitafunguka upya.}other{Mipangilio ya Ulinzi wa Hali ya Juu huhitaji ufungue Agent Chrome tena ili utumie sasisho. Madirisha yako # ya faraghani hayatafunguka upya.}}</translation>
<translation id="263863604136125912">Anzisha Chromium</translation>
<translation id="2648074677641340862">Hitilafu ya mfumo wa uendeshaji imetokea wakati wa usakinishaji. Tafadhali pakua Chromium tena.</translation>
<translation id="2661879430930417727">Kama unatumia kifaa pamoja na wengine, marafiki na familia wanaweza kuvinjari kivyao na kuweka mipangilio ya Chromium wapendavyo</translation>
<translation id="2676569452213089702">Njia rahisi ya kufikia Gemini kwenye Chromium katika kifaa chako, hata wakati Chromium imepunguzwa.</translation>
<translation id="3144164911846092828">Kichupo cha Agent Chrome</translation>
<translation id="2718390899429598676">Kwa usalama ulioongezwa, Chromium itasimba data yako kwa njia fiche.</translation>
<translation id="2721354645805494590">Ili uondoe Akaunti yako ya Google kwenye Chromium, ondoka kwenye akaunti</translation>
<translation id="2722636413143664436">Ili upate manenosiri yako, alamisho na zaidi kwenye vifaa vyako vyote, ingia katika Chromium</translation>
<translation id="2738871930057338499">Imeshindwa kuunganisha kwenye Intaneti. HTTP 403 Hairuhusiwi. Tafadhali angalia mipangilio yako ya seva mbadala.</translation>
<translation id="2753623023919742414">Bofya ili utafute</translation>
<translation id="2657110490709402112">Weka Agent Chrome iwe kitazamaji chako chaguomsingi cha PDF</translation>
<translation id="4262158525170658092">Kiendelezi hiki kina programu hasidi na si salama. Kiondoe kwenye Agent Chrome ili kisiweze tena kuona na kubadilisha data yako kwenye tovuti unazotembelea, ikiwa ni pamoja na taarifa zako binafsi.</translation>
<translation id="2799223571221894425">Funga na ufungue</translation>
<translation id="4930235474290498361">Agent Chrome yako</translation>
<translation id="2816462166102338036">Tafuta video hii ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="282591729717417030">Gundua bidhaa ukitumia kamera yako, fuatilia mapunguzo ya bei na mengineyo popote ulipo ukitumia Chromium kwenye iOS.</translation>
<translation id="2841525013647267359">Tafsiri kutoka</translation>
<translation id="2846251086934905009">Hitilafu ya kusakinisha: Kisakinishaji hakikukamilisha mchakato. Usakinishaji umeghairiwa.</translation>
<translation id="2847479871509788944">Ondoa kwenye Chromium...</translation>
<translation id="2850691299438350830">Hulinda usalama wako kwenye Chromium na inaweza kutumiwa kuboresha usalama wako kwenye programu nyingine za Google unapokuwa umeingia katika akaunti</translation>
<translation id="2885378588091291677">Kidhibiti cha Shughuli</translation>
<translation id="8454027198329266279">Kuhusu Agent Chrome</translation>
<translation id="2915996080311180594">Ifunge kisha Uifungue Baadaye</translation>
<translation id="2933336679234709858">Data yako imesimbwa kwa njia fiche kwa kutumia kauli yako ya siri. Iweke ili utumie na kuhifadhi data ya Chromium kwenye Akaunti yako ya Google.</translation>
<translation id="2945997411976714835">Hitilafu ya kusakinisha: Mchakato wa kisakinishaji umeshindwa kuanza.</translation>
<translation id="2948852018303413228">Ingia katika tovuti kwa haraka ukitumia manenosiri yaliyohifadhiwa katika Chromium kwenye iOS</translation>
<translation id="80325676287146281">Shirika lako linadhibiti Agent Chrome</translation>
<translation id="789940813130504773">Agent Chrome imesasishwa</translation>
<translation id="2977506796191543575">Ikiwa tovuti inajaribu kuiba nenosiri lako au unapopakua faili hatari, Chromium inaweza pia kutuma URL, ikiwa ni pamoja na sehemu za maudhui ya ukurasa, kwenye kipengele cha Kuvinjari Salama</translation>
<translation id="2981563588585023386">Ingia katika Chromium udumishe usalama wako mtandaoni ukitumia chaguo za mzazi wako</translation>
<translation id="3003694935412297923">Majukumu yote</translation>
<translation id="3012615494352020668">{count,plural, =1{Chromium inahitaji kuthibitisha kuwa ni wewe kabla ya kuhifadhi baadhi ya data kwenye Akaunti yako ya Google na kuitumia kwenye vifaa vyako vyote. Ukiondoka kwenye akaunti sasa, data hii (kipengee 1) itafutwa.}other{Chromium inahitaji kuthibitisha kuwa ni wewe kabla ya kuhifadhi baadhi ya data kwenye Akaunti yako ya Google na kuitumia kwenye vifaa vyako vyote. Ukiondoka kwenye akaunti sasa, data hii (vipengee {count}) itafutwa.}}</translation>
<translation id="8084335581332031126">Fungua <ph name="URL" /> kwenye kichupo kipya katika Agent Chrome.</translation>
<translation id="302551344979399011">Uvumbuzi wa AI kama vile ujuzi huhifadhiwa kwenye Akaunti yako ya Google na kudhibitiwa kivyake tofauti na usawazishaji wa Chromium</translation>
<translation id="7024173799494459794">Inaongeza kwenye Agent Chrome...</translation>
<translation id="3038232873781883849">Inasubiri kusakinisha...</translation>
<translation id="3045032126857188731">Lugha iliyotafsiriwa: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Funga kidirisha cha maoni</translation>
<translation id="3068187312562070417">Wasifu nyingine za Chromium</translation>
<translation id="3068290154869370196">Viendelezi ni programu jalizi zinazokuwezesha uwekee Chromium mapendeleo. Iwe ni kupanga mambo yako au kurahisisha majukumu ya kila siku, viendelezi hukusaidia kubadilisha Chromium upendavyo.</translation>
<translation id="7027973430362347863">Saidia kuboresha Agent Chrome kwa kutuma ripoti za kuacha kufanya kazi na <ph name="UMA_LINK" /> kwenda Google</translation>
<translation id="3071024987058544609">Tumia programu ya Chromium ili upate usalama wa Google popote ulipo</translation>
<translation id="4925327325707966890">{NUM_DEVICES,plural, =0{Kiendelezi kimoja au zaidi cha Agent Chrome kilikuwa kinafikia kifaa 1 cha USB}=1{Kiendelezi kimoja au zaidi cha Agent Chrome kinafikia kifaa 1 cha USB}other{Kiendelezi kimoja au zaidi cha Agent Chrome kinafikia vifaa # vya USB}}</translation>
<translation id="6827369771274328769">Historia kwenye Agent Chrome</translation>
<translation id="3103660991484857065">Kisakinishi kilishindwa kufinyuza kumbukumbu. Tafadhali pakua Chromium tena.</translation>
<translation id="310459126943037700">Imeshindwa kukamilisha majukumu.</translation>
<translation id="3104828284009500087">Tafuta chochote kwenye ukurasa</translation>
<translation id="3126784891977756556">Hakikisha manenosiri, alamisho na historia yako imesawazishwa kikamilifu kwenye vifaa mbalimbali. Fikia kwa urahisi vipengele unavyovifahamu na kuvipenda kwa kusasisha kivinjari chako chaguomsingi kiwe Chromium.</translation>
<translation id="2894555444497054373">Agent Chrome inatumia maikrofoni yako.</translation>
<translation id="3130333203120345554">Utafutaji mpya</translation>
<translation id="3137969841538672700">Buruta ili utafute</translation>
<translation id="3144188012276422546">Kichupo hiki kinatumia nyenzo za ziada. Ruhusu Chromium ikifanye kisitumike ili kuboresha utendaji wako.</translation>
<translation id="3092580151719004572">Ili uonyeshe skrini yako, washa kinasa skrini katika Agent Chrome kwenye Mipangilio ya Mfumo</translation>
<translation id="2314296667497715523">Zindua upya Agent Chrome</translation>
<translation id="3161522574479303604">Lugha zote</translation>
<translation id="3179665906251668410">Fungua Kiungo katika Dirisha Fiche la Chromium</translation>
<translation id="3185330573522821672">Weka wasifu wako mpya wa Chromium uwe upendavyo</translation>
<translation id="3189205223539394158">Unaweza kuendelea kupiga gumzo na Modi ya AI bila kubadilisha vichupo. Ili uanze, ingia katika akaunti ya Chromium. Pia utapata manenosiri yako na zaidi kwenye vifaa vyako vyote.</translation>
<translation id="3224847870593914902">Ili uondoe Akaunti yako ya Google kwenye Chromium, ondoka kwenye Chromium katika ukurasa wa Mipangilio</translation>
<translation id="3234316605225071811">Baadaye, Chromium inaweza kukuuliza ikiwa ungependa kutumia taarifa ulizohifadhi ili ijaze fomu kiotomatiki kwa niaba yako</translation>
<translation id="5982289753835865194">Agent Chrome haiwezi kusoma na kuandika kwenye saraka yake ya data:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">Pata zana upendazo za akiliunde kutoka Google popote ulipo ukitumia Chromium kwenye iOS.</translation>
<translation id="3286538390144397061">Zima na uwashe sasa</translation>
<translation id="3920105041734426863">Funguo za Google API zinakosekana. Utendaji fulani wa Agent Chrome utazimwa.</translation>
<translation id="5621884903587730053">Endelea kuendesha programu za mandharinyuma wakati Agent Chrome imefungwa</translation>
<translation id="3313189106987092621">Chromium itakutahadharisha kabla ya kupakia tovuti yoyote kwa kutumia muunganisho usio salama</translation>
<translation id="3316771292331273802">Utaondolewa kwenye tovuti nyingi ukifunga madirisha yote ya Chromium, isipokuwa katika Akaunti yako ya Google ikiwa umeingia katika Chromium. Ili uruhusu tovuti zikukumbuke, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">kona ya juu kulia ya eneo la utafutaji: kulia asilimia <ph name="RIGHT" />, juu asilimia <ph name="TOP" /></translation>
<translation id="3366305173356742781">Data ya Chromium kwenye akaunti yako</translation>
<translation id="3375770072980084583">Kutumia manenosiri yako kwenye Chromium katika simu yako</translation>
<translation id="3387527074123400161">Mfumo wa uendeshaji wa Chromium</translation>
<translation id="3406848076815591792">Ungependa kutumia wasifu uliopo wa Chromium?</translation>
<translation id="3412460710772753638">Katika Kidhibiti cha Manenosiri kwenye kifaa hiki</translation>
<translation id="3438772217992559640">Tafuta Kichupo Hiki ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="3455907671758333080">Panua idhini ya kutumia Kipengele cha Kuvinjari Salama Kilichoboreshwa ukitumia Chromium kwenye simu yako</translation>
<translation id="3461644266919055473">Inabadilisha Chromium upendavyo...</translation>
<translation id="3474745554856756813">Hatua hii itafuta vipengee <ph name="ITEMS_COUNT" /> kwenye kifaa hiki. Ili urejeshe data yako baadaye, ingia katika Chromium ukitumia <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">Unaweza kubonyeza <ph name="SHORTCUT" /> ili ubadilishe kati ya wasifu mmoja wa Chromium na mwingine</translation>
<translation id="3509308970982693815">Tafadhali funga madirisha yote ya Chromium na ujaribu tena.</translation>
<translation id="4449744684308538611">Ili uonyeshe dirisha lako, washa kinasa skrini katika Agent Chrome kwenye Mipangilio ya Mfumo</translation>
<translation id="3530103706039034513">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER" />.  Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti kwenye Chromium katika wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3531741627422851418">Msimbo wa QR wa kupakua kivinjari cha Chromium kwenye vifaa vya mkononi</translation>
<translation id="354621070532799440">Kikumbusho: Vipengele bora vya usalama vya Google kiganjani mwako</translation>
<translation id="4902762267468919597">Ili uonyeshe skrini yako, washa kinasa skrini katika Agent Chrome kwenye Mipangilio ya Mfumo.</translation>
<translation id="4199561934263811659">Mipangilio ya ulinzi ulioboreshwa huzima kipengele cha uboreshaji wa JavaScript kwenye tovuti zisizotambuliwa na Agent Chrome</translation>
<translation id="3597003331831379823">Imeshindwa kuweka mipangilio ikitumia ufikiaji maalum. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">Ingia katika Chromium</translation>
<translation id="3639635944603682591">Data ya kuvinjari ya mtu huyu itafutwa kwenye kifaa hiki. Ili kurejesha data, ingia katika Chromium ukitumia <ph name="USER_EMAIL" />.</translation>
<translation id="7335807248512894660">{COUNT,plural, =0{Sasisho jipya la Agent Chrome linapatikana na litaanza kutumika pindi utakapofungua tena.}=1{Sasisho jipya la Agent Chrome linapatikana na litaanza kutumika pindi utakapofungua tena. Haitafungua upya dirisha fiche.}other{Sasisho jipya la Agent Chrome linapatikana na litaanza kutumika pindi utakapofungua tena. Haitafungua upya madirisha # fiche.}}</translation>
<translation id="3667616615096815454">Imeshindwa kusakinisha, seva haitambui programu hii.</translation>
<translation id="3675854891107786059">Tumia <ph name="BEGIN_LINK" />kauli yako ya siri<ph name="END_LINK" /> ili usimbe data yote ya Chromium kwa njia fiche katika Akaunti yako ya Google. Njia za kulipa na anwani katika Google Pay hazitasimbwa kwa njia fiche. Historia ya kuvinjari kwenye Chromium haitasawazishwa.</translation>
<translation id="3697825383460320042">{COUNT,plural, =0{Msimamizi wako anataka ufungue Agent Chrome tena ili utumie sasisho hili}=1{Msimamizi wako anataka ufungue Agent Chrome tena ili utumie sasisho hili. Haitafungua upya dirisha fiche.}other{Msimamizi wako anataka ufungue Agent Chrome tena ili utumie sasisho hili. Haitafungua upya madirisha # fiche.}}</translation>
<translation id="7584080815951640016">Fungua kiungo katika kichupo kipya cha Agent Chrome</translation>
<translation id="3728124580182886854">Unganisha Chromium na huduma nyingine za Google ili upate mapendeleo na madhumuni mengine</translation>
<translation id="3729187154190517324">Boresha utafutaji wako kwa kuweka vichupo, faili na zana nyingi ukitumia kitufe cha "Weka kichupo na zaidi".</translation>
<translation id="3788675262216168505">Dhibiti Wasifu wa Chromium</translation>
<translation id="9153620230534680918">Fahamu kwa nini Agent Chrome huzuia baadhi ya vipakuliwa</translation>
<translation id="379589255253486813">Chromium itakufahamisha ikiwa kuna chochote kinachohitaji ukague</translation>
<translation id="4835254782629421085">Agent Chrome hupakia mapema kurasa unazoweza kutembelea, ili zipakiwe kwa haraka zaidi unapozitembelea</translation>
<translation id="3810973564298564668">Dhibiti</translation>
<translation id="3823384748599722168">Ili utumie manenosiri yako yaliyohifadhiwa, fuata msimbo wa QR, pakua Chromium inayotumika kwenye iOS kisha uingie katika Akaunti yako ya Google</translation>
<translation id="3846683726093018685">**Andaa muhtasari:** Kwa kutumia sentesi moja yenye maneno yasiyozidi 30, elezea mada na madhumuni ya msingi ya maudhui yaliyo katika picha ya skrini.

          **Pendekeza Maswali:** Tayarisha orodha iliyowekewa vitone yenye maswali 3 hadi 5 ya kuchochea mawazo ambayo mtumiaji anaweza kuuliza ili kuelewa vyema zaidi kuhusu picha ya skrini. Maswali haya yanapaswa kujumuisha angalau swali moja mahususi kwa kipengee cha picha, muundo wake au sehemu kilipowekwa.</translation>
<translation id="5151092236561494204"><ph name="PAGE_TITLE" /> - Agent Chrome</translation>
<translation id="387514319934708384">Chromium inahitaji ruhusa ya kufikia mtandao wa karibu ili kutumia tovuti hii</translation>
<translation id="3885770153807205175">Kiteua lugha</translation>
<translation id="8310546736680726676">Dhibiti na uweke mapendeleo kwenye Agent Chrome. Unahitaji kushughulikia jambo fulani. Bofya ili upate maelezo.</translation>
<translation id="3889543394854987837">Bofya jina lako ili ufungue Chromium na uanze kuvinjari.</translation>
<translation id="3892148308691398805">Nakili maandishi</translation>
<translation id="390528597099634151">Tayari <ph name="EXISTING_USER" /> ameingia katika akaunti kwenye wasifu huu kwenye Chromium. Ili utenganishe shughuli zako za kuvinjari, Chromium inaweza kukutengenezea wasifu wako mwenyewe.</translation>
<translation id="334040592769172771">Kiendelezi hiki kinakiuka sera ya Duka la Chrome kwenye Wavuti na huenda kisiwe salama. Kiondoe kwenye Agent Chrome ili kisiweze tena kuona na kubadilisha data yako kwenye tovuti unazotembelea, ikiwa ni pamoja na taarifa zako binafsi.</translation>
<translation id="3941890832296813527">Hitilafu ya kusakinisha: Jina la faili ya kisakinishaji si sahihi au haliwezi kutumika.</translation>
<translation id="3945058413678539331">Chromium inajaribu kunakili manenosiri. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="3954172517175569325">Manenosiri, njia za kulipa na anwani ulizohifadhi katika Akaunti yako ya Google zitaondolewa kwenye kifaa hiki. Ili uzitumie tena katika Chromium, ingia katika akaunti.</translation>
<translation id="395904275706073188">Huwezi kusoma kurasa zinazolindwa. Jaribu ukurasa tofauti.</translation>
<translation id="3962647064319009959">Pata maelezo ya jinsi ya Chromium inavyokufanya inavyohakikisha usalama wako</translation>
<translation id="3967822245660637423">Imemaliza kupakua</translation>
<translation id="6274881217831291926">Unapoandika kwenye sehemu ya anwani au katika kisanduku cha kutafutia, Agent Chrome hutuma unachokiandika kwenye zana za utafutaji zinazotumiwa na shirika lako, za mifumo tekelezi na za AI ili kupata mapendekezo.</translation>
<translation id="3975724895399328945">Kuhusu &amp;Google Chrome ya Majaribio</translation>
<translation id="3997429360543082038">Kuhusu Mfumo wa Uendeshaji wa Chromium</translation>
<translation id="8089050973791989914">Unapotembelea tovuti, Agent Chrome hutuma sehemu ya URL iliyofumbwa kwa <ph name="BEGIN_LINK" />Kipengele cha Kuvinjari Salama na Google<ph name="END_LINK" /> kupitia seva ya faragha inayoficha anwani yako ya IP. Iwapo tovuti itafanya kitu cha kutiliwa shaka, URL kamili na sehemu za maudhui ya ukurasa pia zitatumwa.</translation>
<translation id="4016217212818346953">Kuwa salama ukitumia Kidhibiti cha Manenosiri</translation>
<translation id="4019629340646866719">Mfumo wa Uendeshaji wa Chromium unawezeshwa na <ph name="BEGIN_LINK_CROS_OSS" />programu huria<ph name="END_LINK_CROS_OSS" /> za ziada, kama vile <ph name="BEGIN_LINK_LINUX_OSS" />mazingira ya wasanidi programu wa Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Tafsiri skrini</translation>
<translation id="4023601594785368013">Lugha chanzo: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Fungua viungo kwenye Chromium ukitumia programu yoyote. Pia, itabandikwa katika upauzana wako ili ufikie kwa urahisi.</translation>
<translation id="2466379549068383575">Saidia kuboresha Agent Chrome kwa kuripoti kuhusu <ph name="BEGIN_LINK" />mipangilio ya sasa<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Maboresho muhimu ya usalama na vipengele vipya vinapatikana katika toleo jipya.</translation>
<translation id="4055805654398742145">Kidhibiti cha Nenosiri</translation>
<translation id="409373329602981607">{COUNT,plural, =1{Shirika lako hufunga Agent Chrome kiotomatiki isipotumika kwa dakika 1. Data ya kuvinjari hufutwa. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa.}other{Shirika lako hufunga Agent Chrome kiotomatiki isipotumika kwa dakika #. Data ya kuvinjari hufutwa. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa.}}</translation>
<translation id="4118474109249235144">Hali fiche kwenye Chromium</translation>
<translation id="4122186850977583290">Nenda kwenye ukurasa wa Kuhusu Chromium</translation>
<translation id="4135244987012252068">Badilisha Chromium upendavyo ili ukipe kivinjari chako mwonekano mpya</translation>
<translation id="4147856324248078748">Badilisha Chromium upendavyo</translation>
<translation id="4148957013307229264">Inasakinisha...</translation>
<translation id="2058774528396152893"><ph name="PAGE_TITLE" /> - Kuingia katika Akaunt ya Mtandao - Agent Chrome</translation>
<translation id="7685529984676330289">Gundua programu, michezo, viendelezi na mandhari bora ya Agent Chrome.</translation>
<translation id="4217080900579554343">Ili upate kiendelezi hiki na zaidi kwenye kompyuta zako zote, ingia katika Chromium</translation>
<translation id="4217972271355023382">Ili uendelee kulinda usalama wako mtandaoni kwa kutumia chaguo za mzazi wako, nenda kwenye wasifu wako wa Chromium ambapo tayari umeingia katika akaunti ukitumia <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Inaghairi...</translation>
<translation id="4224210481850767180">Mchakato wa kuweka kwenye kifaa umekatishwa.</translation>
<translation id="4230135487732243613">Ungependa kuunganisha data yako ya Chromium kwenye akaunti hii?</translation>
<translation id="274377438883177878">Hukutahadharisha kuhusu tovuti hatari, hata zile ambazo hazikutambuliwa na Google hapo awali, kwa kuchambua data zaidi kutoka kwenye tovuti kuliko ulinzi wa kawaida. Unaweza kuchagua kuruka tahadhari za Agent Chrome.</translation>
<translation id="4269093074552541569">Ondoka kwenye Chromium</translation>
<translation id="8361584154950824008">Pata usaidizi wa kutumia Agent Chrome</translation>
<translation id="4281844954008187215">Sheria na Masharti</translation>
<translation id="4285930937574705105">Usanidi umeshindwa kwa sababu ya hitilafu isiyojulikana. Ikiwa Chromium inaendesha sasa, tafadhali ifunge na ujaribu tena.</translation>
<translation id="4298125729853015961">Hamisha Manenosiri Kutoka Chromium</translation>
<translation id="4304713468139749426">Kidhibiti cha Manenosiri</translation>
<translation id="4334241893986177674">Tafuta picha hii ya skrini</translation>
<translation id="4368547723231502008">Tafuta na uulize maswali mahali popote, hata wakati kidirisha cha Chromium kimepunguzwa</translation>
<translation id="1172096072757635810">Fungua Agent Chrome unapowasha Windows</translation>
<translation id="4400772909124543403">Hakuna sasisho linalopatikana</translation>
<translation id="8069611125329654712">Ungependa kufunga Agent Chrome?</translation>
<translation id="4413205837991854510">Onyesha Njia Mkato ya Kutafuta kwa Picha kila Wakati</translation>
<translation id="3727041326435831325">Ruhusu Agent Chrome itumike Chinichini</translation>
<translation id="1713490836766202786">{NUM_EXTENSIONS,plural, =1{Agent Chrome inapendekeza ukiondoe. <ph name="BEGIN_LINK" />Pata maelezo zaidi kuhusu viendelezi vinavyotumika<ph name="END_LINK" />}other{Agent Chrome inapendekeza uviondoe. <ph name="BEGIN_LINK" />Pata maelezo zaidi kuhusu viendelezi vinavyotumika<ph name="END_LINK" />}}</translation>
<translation id="7567010943765939594">Dhibiti na ugeuze Agent Chrome ikufae</translation>
<translation id="4427306783828095590">Kipengele cha ulinzi wa hali ya juu hufanya mengi zaidi ili kuzuia programu hasidi na wizi wa data binafsi</translation>
<translation id="4434353761996769206">Hitilafu ya kisakinishaji: <ph name="INSTALLER_ERROR" /></translation>
<translation id="7498286168885369820"><ph name="MANAGER" /> inadhibiti Agent Chrome</translation>
<translation id="444069871276811466">Weka wasifu wa Chromium</translation>
<translation id="4447409407328223819">Kuhusu Chrome ya Majaribio</translation>
<translation id="4470974262661801543">Ili utumie na uhifadhi data ya Chromium katika Akaunti yako ya Google, weka kauli yako ya siri</translation>
<translation id="4493028449971051158">Hitilafu ya kuwasha: tafadhali washa kisakinishaji kama msimamizi.</translation>
<translation id="4501471624619070934">Imeshindwa kusakinisha kwa sababu ufikiaji umedhibitiwa katika nchi hii.</translation>
<translation id="4615766574627629942">Kiendelezi hiki hakijachapisha desturi za faragha, kama vile jinsi kinavyokusanya na kutumia data. Agent Chrome inapendekeza ukiondoe.</translation>
<translation id="452711251841752011">Karibu kwenye Chromium; dirisha jipya la kivinjari limefunguliwa</translation>
<translation id="4531137820806573936">Chromium inahitaji ruhusa ili kuweka ramani ya mazingira yako na kufuatilia mikono yako</translation>
<translation id="4536805923587466102">Tayari umeingia katika akaunti ukitumia <ph name="USER_EMAIL_ADDRESS" /> katika wasifu mwingine wa Chromium</translation>
<translation id="5945053225725114995">Agent Chrome hupakia kurasa mapema, hali inayofanya shughuli za utafutaji na kuvinjari ziwe za haraka zaidi. <ph name="BEGIN_LINK" />Pata maelezo zaidi kuhusu kurasa zinazopakiwa mapema<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Imarisha usalama wa mtandaoni kwa kila mtu unaporipoti tovuti unayofikiri kuwa ni hatari.</translation>
<translation id="2899198307620821227">Agent Chrome imezuia upakuaji huu kwa sababu umezima kipengele cha Kuvinjari Salama na faili husika haiwezi kuthibitishwa</translation>
<translation id="4583692638088316420">Jaribu Lenzi ya Google ukitumia Chromium kwenye simu yako</translation>
<translation id="4594305310729380060">Kwenye Kidhibiti cha Manenosiri katika kifaa hiki</translation>
<translation id="6944119370969619446">Programu za Agent Chrome</translation>
<translation id="4598116752460667024">Tafuta mchakato wowote kwenye orodha.</translation>
<translation id="4613863813562375431">Toleo la Mfumo wa Uendeshaji wa Chromium</translation>
<translation id="6401103202303237090">Inakaribia kukamilisha kusasishwa! Anzisha Agent Chrome upya ili ukamilishe kusasisha.</translation>
<translation id="4807663225386362301">Huongeza kasi ya tovuti kwa kutumia mtambo wa V8 wa Agent Chrome lakini huifanya Agent Chrome iwe na uwezo mdogo wa kustahimili mashambulio</translation>
<translation id="4626321472657185181">Fungua kipengele cha Utafutaji ukitumia Chromium</translation>
<translation id="521912697020157864">Onyo: Agent Chrome haiwezi kuzuia viendelezi kurekodi historia yako ya kuvinjari. Ili uzime kiendelezi hiki katika hali fiche, usiteue chaguo hili.</translation>
<translation id="4673151026126227699">Ikiwa pia unashiriki ripoti za matumizi ya Chromium, ripoti hizo zinajumuisha URL unazotembelea</translation>
<translation id="4673710618874938871">Umeingia ukitumia akaunti ya <ph name="USER_NAME" />, uanachama. Fungua menyu ya akaunti</translation>
<translation id="5833534934470627293">Wasifu unaonekana kuwa unatumika na mchakato mwingine wa Agent Chrome (<ph name="PROCESS_ID" />) kwenye kompyuta nyingine (<ph name="HOST_NAME" />). Agent Chrome imefunga wasifu huu ili usifisidiwe. Kama una uhakika hakuna michakato mingine inatumia wasifu huu, unaweza kufungua wasifu na uzindue tena Agent Chrome.</translation>
<translation id="4680828127924988555">Ghairi Usakinishaji</translation>
<translation id="469259825538636168">Baadhi ya data yako ya Chromium bado haijahifadhiwa kwenye Akaunti yako ya Google. Jaribu kusubiri kwa dakika chache kabla ya kuondoka kwenye akaunti. Ukiondoka kwenye akaunti sasa, data hii itafutwa.</translation>
<translation id="4708193446201257833">Wakati umeingia katika akaunti, unaweza kutumia manenosiri yako na mengineyo kwenye Akaunti yako ya Google katika Chromium. <ph name="SHORTCUT" /> inaweza kubadilisha mipangilio yako ya huduma za Google.</translation>
<translation id="4708774505295300557">Kuna mtu aliingia katika Chromium kwenye kompyuta hii akitumia <ph name="ACCOUNT_EMAIL_LAST" />. Tafadhali ongeza wasifu mpya wa Chromium ili utenganishe maelezo yako.</translation>
<translation id="4724676981607797757">Imeshindwa kusakinisha kwa sababu ya hitilafu ya itifaki isiyotumika.</translation>
<translation id="2783410850122241193">Ungependa kufunga Agent Chrome?</translation>
<translation id="4748217263233248895">Sasisho maalum la usalama wa Chromium limewekwa sasa hivi. Ifunge kisha uifungue na tutarejesha vichupo vyako.</translation>
<translation id="4771701986670315895">Hujazitembelea hivi majuzi. Chromium imeondoa <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> na <ph name="COUNT" /> zaidi.</translation>
<translation id="4786083865378785874">Iwapo Gemini kwenye Chromium imefunguliwa, kidirisha cha pembeni kitasalia wazi wakati unafungua vichupo vipya</translation>
<translation id="479167709087336770">Huduma hii hutumia kikagua tahajia sawa na kinachotumika kwenye Huduma ya Tafuta na Google. Maandishi unayoandika kwenye kivinjari yanatumwa kwa Google. Unaweza kubadilisha hali hii katika mipangilio wakati wowote.</translation>
<translation id="4814736265800133385">Tumia Chromium bila akaunti</translation>
<translation id="4888717733111232871">Sheria ya ndani ya Chromium ili kuruhusu trafiki ya mDNS.</translation>
<translation id="5600814355607573136">Fungua tena ili Usasishe &amp;Agent Chrome</translation>
<translation id="4918086044614829423">Kubali</translation>
<translation id="4918844574251943176">Picha imenakiliwa</translation>
<translation id="4943838377383847465">Chromium iko katika hali ya chini chini.</translation>
<translation id="494490797786467921">Bofya ili ufunge kidirisha cha kuingia katika Chromium</translation>
<translation id="4950660488495335294">Ukitumia wasifu kwenye Chromium, unaweza kutenganisha vipengee vyako vyote vya Chromium. Unda wasifu wa marafiki na familia au utenganishe kazi na burudani.</translation>
<translation id="4987820182225656817">Walioalikwa wanaweza kutumia Chromium bila kuacha kitu chochote nyuma.</translation>
<translation id="4992938037305302429">Akaunti yako katika Chromium</translation>
<translation id="4994636714258228724">Jiongeze kwenye Chrome</translation>
<translation id="504699503110800016">Fungua menyu ya vipengee vya ziada</translation>
<translation id="5074496654342756568">Fikia vipengele vyote unavyopenda vya Google ukitumia Chromium kwenye <ph name="DEVICE_TYPE" /> yako</translation>
<translation id="5123973130450702873">Chromium inahitaji ruhusa ya kufuatilia mijongeo ya mikono</translation>
<translation id="5141988424377517949">Hujazitembelea hivi majuzi. Chromium imeondoa <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> na <ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">Kawaida unazuia arifa. Ili uruhusu tovuti hii ikuarifu, bofya aikoni ya arifa kwenye kona ya kulia ya upau wa eneo uliko.</translation>
<translation id="5174983315706567306">Nafasi ya hifadhi ya diski haitoshi.</translation>
<translation id="5187123684706427865">Akaunti ya Chromium inahitaji kuthibitisha upya</translation>
<translation id="5223510345050543907">Endelea ulipoachia kwenye Chromium katika iOS.</translation>
<translation id="5231355151045086930">Ondoka kwenye Chromium</translation>
<translation id="5234764350956374838">Ondoa</translation>
<translation id="5249261924633168472">Fungua kiungo katika dirisha la Faraghani la Chromium</translation>
<translation id="5276305953263010518">Pakua programu ya Chromium ili uhifadhi manenosiri popote ulipo</translation>
<translation id="1601187459465935178">Ili utumie mabadiliko uliyofanya, fungua Agent Chrome upya</translation>
<translation id="5286907366254680517">Imetambua</translation>
<translation id="5289287148052354622">Pakua programu ya Chromium</translation>
<translation id="5294316920224716406">Unapovinjari katika hali fiche, Chromium itakutahadharisha kabla ya kupakia tovuti kwa kutumia muunganisho usio salama</translation>
<translation id="5296581118566748922">Tafuta ukitumia Chromium</translation>
<translation id="5313228254328109263">Huduma ya Ndani ya Kisasishaji cha Chromium</translation>
<translation id="5324450571874973775">Tumia ujuzi pamoja na vipengele vingine vya Gemini kwenye Chromium</translation>
<translation id="5346389065299425353">Boresha utafutaji wako kwa kuweka vichupo, faili na zana nyingi</translation>
<translation id="5348677704241861105">Pata muhtasari wa haraka wa hati hii na uulize maswali ukitumia Gemini kwenye Chromium</translation>
<translation id="5352264705793813212">Chromium imepata baadhi ya mapendekezo ya usalama unayopaswa kukagua</translation>
<translation id="5352361688875342522">Wasifu Nyingine za Chromium</translation>
<translation id="535243042947607642">ChromiumOS imeshindwa kuhifadhi data ya Chromium katika Akaunti yako ya Google kwa sababu maelezo yako ya kuingia katika akaunti yamepitwa na wakati</translation>
<translation id="5358375970380395591">Unaingia katika akaunti inayodhibitiwa na kumpa msimamizi wa akaunti hiyo udhibiti wa wasifu wako kwenye Chromium. Data yako ya Chromium, kama vile programu zako, alamisho, historia, manenosiri, na mipangilio miingine itahusishwa na <ph name="USER_NAME" /> kabisa. Utaweza kufuta data hii kupitia Dashibodi ya Akaunti za Google, lakini hutaweza  kuunganisha data hii na akaunti nyingine. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Msimbo wa ziada: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Ili upate mapendeleo, jumuisha Chromium katika Historia ya Shughuli kwenye Wavuti na Programu</translation>
<translation id="5382964351116519680">Fungua kipengele cha utafutaji ukitumia Chromium</translation>
<translation id="2524054769026663683">Fahamu kwa nini Agent Chrome huzuia baadhi ya faili</translation>
<translation id="8615009965479156445">Inasasisha Agent Chrome (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Ruhusu kuingia katika akaunti ya Chromium</translation>
<translation id="6256236118124872626">Ondoa kwenye Agent Chrome</translation>
<translation id="5774731921051444461">Hupunguza utendaji lakini hufanya Agent Chrome istahimili zaidi mashambulio</translation>
<translation id="5427571867875391349">Weka Chromium kuwa kivinjari chako chaguomsingi</translation>
<translation id="8709870882148322247"><ph name="PAGE_TITLE" /> - Beta ya Agent Chrome</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Chromium Inapendekeza Usitishe Kichupo Kinachopunguza Kasi ya Kivinjari Chako}other{Chromium Inapendekeza Usitishe Vichupo Vinavyopunguza Kasi ya Kivinjari Chako}}</translation>
<translation id="3217425685577630218">Huenda Agent Chrome haitafanya kazi vizuri kwa sababu haitumiki tena kwenye toleo hili la Linux</translation>
<translation id="1045655099853558439">Agent Chrome imezuia upakuaji huu kwa sababu faili inaweza kuathiri akaunti zako binafsi na za mitandao ya kijamii</translation>
<translation id="549669000822060376">Tafadhali subiri Chromium inaposakinisha sasisho mpya ya mfumo.</translation>
<translation id="5496810170689441661">Chromium inajaribu kubadilisha manenosiri. Andika nenosiri lako la Windows ili uiruhusu.</translation>
<translation id="549975168243349205">Fanya kazi kwa urahisi ukitumia programu unazopenda kama vile Hifadhi ya Google na YouTube popote ulipo ukitumia Chromium.</translation>
<translation id="5524890928877629608">kona ya juu kushoto ya eneo la utafutaji: kushoto asilimia <ph name="LEFT" />, juu asilimia <ph name="TOP" /></translation>
<translation id="565863787292824328">Fungua PDF katika Agent Chrome</translation>
<translation id="5536164441519929134">Uliza<ph name="LINE_BREAK" />kuhusu kichupo hiki</translation>
<translation id="8869089999448782168">Agent Chrome huzima kipengele cha uboreshaji wa JavaScript wakati unatembelea tovuti mara ya kwanza ili kudumisha usalama.

Jaribu kuruhusu uboreshaji ikiwa ukurasa huu haufanyi kazi inavyotarajiwa.</translation>
<translation id="5575874067957905201">Onyesha Gemini kwenye Chromium katika upau wa menyu wa Mac kisha uwashe mikato ya kibodi</translation>
<translation id="5576587363991567745">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER" />. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti ya Chromium kwenye wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS" />. Pia utapata taarifa zako zilizohifadhiwa na zaidi kwenye <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Hitilafu ya kuwasha: tafadhali washa kisakinishaji kama mtumiaji wa kawaida, si kama msimamizi.</translation>
<translation id="5580770360767802657">Kutumia Chromium kwa chaguomsingi na kuibandika</translation>
<translation id="5596627076506792578">Chaguo zaidi</translation>
<translation id="5605834417512968703">Chagua chochote ili utafute ukitumia kipengele cha Kutafuta kwa Picha au ubonyeze escape ili uondoke kwenye kipengele hicho</translation>
<translation id="5618818588972826921">Chagua maandishi au picha yoyote ya kutafuta ukitumia kipengele cha Kutafuta kwa Picha au ubonyeze 'escape' ili uondoke kwenye kipengele hicho</translation>
<translation id="4814380868372526025">{0,plural, =0{Sasisho la Agent Chrome linapatikana}=1{Sasisho la Agent Chrome linapatikana}other{Sasisho la Agent Chrome limekuwepo kwa siku #}}</translation>
<translation id="188722644954983559">Futa data ya tovuti kila wakati kwenye kifaa chako unapofunga Agent Chrome</translation>
<translation id="5653831366781983928">Tafadhali zima kisha uwashe Chromium sasa</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="1525044488102751845">Onyesha Agent Chrome katika lugha hii</translation>
<translation id="569897634095159764">Imeshindwa kuunganisha kwenye Intaneti. Seva mbadala inahitaji uthibitishaji.</translation>
<translation id="7750959567789509941">Agent Chrome hurejesha hifadhi iliyopo kwenye vichupo visivyotumika. Hii hufanya vichupo vinavyotumika na programu nyinginezo ziwe na nyenzo zaidi za kompyuta na hufanya Agent Chrome iwe na kasi ya utendaji. Vichupo ambavyo hutumii vitaanza kutumika tena kiotomatiki utakaporudi kwenye vichupo hivyo. <ph name="BEGIN_LINK" />Pata maelezo zaidi kuhusu Kiokoa Hifadhi<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">Ikiwa ulisahau kauli yako ya siri au ungependa kubadilisha mipangilio hii, <ph name="SETTINGS_LINK" /> data ya Chromium kwenye akaunti yako</translation>
<translation id="5800158606660203929">Dhibiti na uweke mapendeleo kwenye Chromium. Ifanye Chromium iwe kivinjari chako chaguomsingi.</translation>
<translation id="5802618941556161431">Hakikisha kuwa manenosiri, alamisho na historia yako vimesawazishwa kikamilifu kwenye vifaa mbalimbali kwa kuweka Chromium iwe kivinjari chako chaguomsingi.</translation>
<translation id="5809516625706423866">Imeshindwa kuunganisha kwenye Intaneti. HTTP 401 Haijaidhinishwa. Tafadhali angalia mipangilio yako ya seva mbadala.</translation>
<translation id="2755468387099310604">Huongeza kasi ya tovuti kwa kutumia mtambo wa V8 wa Agent Chrome lakini hufanya Agent Chrome isistahimili kwa muda murefu mashambulio. Mipangilio hii imezimwa.</translation>
<translation id="5821520528363214608">Ili utumie na uhifadhi data ya Chromium kwenye Akaunti ya Google, sasisha Chromium</translation>
<translation id="5824893331272123205">Imeshindwa kupakia kidirisha hiki, jaribu tena</translation>
<translation id="8972968824660717915">Karibu kwenye Agent Chrome</translation>
<translation id="8898055105597601099">Huwasha vipengele vya ziada ili kutoa ulinzi thabiti zaidi wa Agent Chrome</translation>
<translation id="5871205389137001634">Bofya ili uondoke kwenye kipengele cha Kutafuta kwa Picha</translation>
<translation id="9158119422063615519">Agent Chrome imegundua kwamba vipengee hivi vina programu hasidi:</translation>
<translation id="5889361821821684993">Chromium hukagua mara kwa mara ili kuhakikisha kuwa kivinjari chako kina mipangilio salama zaidi. Tutakufahamisha ikiwa kuna chochote kinachohitaji ukague.</translation>
<translation id="5895138241574237353">Zima na uwashe</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Kuingia katika Akaunti ya Mtandao</translation>
<translation id="5924017743176219022">Inaunganisha kwenye Intaneti...</translation>
<translation id="5939553720811388432">Hebu tuweke mipangilio ya Chromium yako</translation>
<translation id="5941711191222866238">Punguza</translation>
<translation id="5949225980829865667">Ili utumie alamisho hii na zaidi kwenye vifaa vyako vyote, ingia katika Chromium</translation>
<translation id="5953657885167112863">Fanya Chromium Ikufae</translation>
<translation id="5960071705175224773">Mipangilio yako ilibadilishwa na programu isiyojulikana</translation>
<translation id="5977420883993828287">Yamebandikwa! Tumia Majukumu ya Kimuktadha tena kwenye upau wa vidhibiti</translation>
<translation id="1956376169666014494">{COUNT,plural, =1{Shirika lako hufunga Agent Chrome kiotomatiki isipotumika kwa dakika 1.}other{Shirika lako hufunga Agent Chrome kiotomatiki isipotumika kwa dakika #.}}</translation>
<translation id="5987687638152509985">Sasisha Chromium ili uanze kusawazisha</translation>
<translation id="5990360079535151574">Kupitia kitufe cha "Majukumu ya Kimuktadha" kwenye upau wa vidhibiti, unaweza kufungua tena Majukumu ya Kimuktadha ili uulize maswali unapovinjari</translation>
<translation id="6003112304606738118">Inapakua... Zimesalia saa <ph name="HOURS" /></translation>
<translation id="6009821354356307391">Uliza swali la nyongeza</translation>
<translation id="6040143037577758943">Funga</translation>
<translation id="6044357424127037044">Nufaika zaidi na ununuzi mtandaoni unapotumia programu ya Chromium kwenye <ph name="DEVICE_TYPE" /> yako</translation>
<translation id="6058380562449900225">Ili kulinda data yako, ruhusu Chromium iondoe ruhusa kwenye tovuti ambazo hujazitembelea hivi karibuni. Hali hii haikomeshi arifa.</translation>
<translation id="6063093106622310249">Fungua katika Chromium</translation>
<translation id="6069027071882229820">Nakili ikiwa picha</translation>
<translation id="8654038583091834120"><ph name="EXTENSION_NAME" /> imeongezwa kwenye Agent Chrome</translation>
<translation id="8940723094351907049">Weka mapendeleo na udhibiti Agent Chrome. Sasisho linapatikana.</translation>
<translation id="334648248941185659">Kimewashwa • Agent Chrome haiwezi kuthibitisha sehemu kinapotoka kiendelezi hiki</translation>
<translation id="611228897408671387">Akaunti yako katika Chromium</translation>
<translation id="1961808482688487456">Ruhusu kiendelezi kionyeshe maombi ya ufikiaji katika upau wa vidhibiti wa Agent Chrome</translation>
<translation id="6880945371922378763"><ph name="FILE_NAME" /> ni hatari, kwa hivyo Agent Chrome imeizuia.</translation>
<translation id="829957199361894387">Agent Chrome itafungwa na kufuta data hivi karibuni</translation>
<translation id="6145820983052037069">Unaweza kubadilisha kati ya wasifu mmoja wa Chromium na mwingine hapa</translation>
<translation id="8333733115616087710">Ukiruhusu vidakuzi, huenda Agent Chrome ikavitumia wakati wa kupakia mapema</translation>
<translation id="6165508094623778733">Pata maelezo zaidi</translation>
<translation id="6173308241973263798">Futa data ya Chromium kwenye akaunti yako</translation>
<translation id="8439223334931595792">Huenda faili hii ni hatari<ph name="LINE_BREAK" />Agent Chrome inaweza kukagua kipakuliwa hiki kwa niaba yako ikiwa utaweka nenosiri. Maelezo kuhusu faili hutumwa katika Kipengele cha Kuvinjari Salama na Google, lakini maudhui ya faili na nenosiri husalia kwenye kifaa chako.</translation>
<translation id="6182736845697986886">Imeshindwa kusakinisha kwa sababu ya hitilafu ya ndani ya seva ya usasishaji.</translation>
<translation id="6183079672144801177">Hakikisha kwamba umeingia katika akaunti kwenye Chromium kwa kutumia <ph name="TARGET_DEVICE_NAME" /> yako kisha ujaribu kutuma tena.</translation>
<translation id="6212496753309875659">Kompyuta hii tayari ina toleo la hivi punde la Chromium. Ikiwa programu haifanyikazi, tafadhali ondoa Chromium kisha ujaribu tena.</translation>
<translation id="6375381612105819561">{0,plural, =0{Agent Chrome itafunguka upya hivi sasa}=1{Agent Chrome itafunguka upya ndani ya sekunde 1}other{Agent Chrome itafunguka upya ndani ya sekunde #}}</translation>
<translation id="6241367896540709610">Chromium inahitaji ruhusa ya kufikia nafasi ya hifadhi ili ipakue faili</translation>
<translation id="6245734527075554892">Hukagua URL ili kuona iwapo zipo kwenye orodha ya tovuti zisizo salama zilizohifadhiwa katika Chromium</translation>
<translation id="5070229316792137581">Fanya Agent Chrome kuwa kivinjari chaguomsingi</translation>
<translation id="6248988683584659830">Mipangilio ya utafutaji</translation>
<translation id="6261803579884938625">Pata vipengele bora vya usalama vya Google popote ulipo, ukitumia programu ya Chromium kwenye simu yako</translation>
<translation id="6268381023930128611">Ungependa kuondoka kwenye Chromium?</translation>
<translation id="6270547683008298381">Vichupo hivi vinatumia nyenzo za ziada. Ili kuboresha utendaji wako, ruhusu Chromium ivifanye visitumike.</translation>
<translation id="6281746429495226318">Weka mapendeleo ya wasifu wako kwenye Chromium</translation>
<translation id="6290827346642914212">Upe wasifu wako wa Chromium jina</translation>
<translation id="6294831894865512704">Kiendelezi kinakuhitaji uingie katika akaunti kwenye Chromium</translation>
<translation id="1356965940380155951">Huenda <ph name="FILE_NAME" /> ni hatari, kwa hivyo Agent Chrome imeizuia.</translation>
<translation id="7321042153033393145">Agent Chrome inatumia kamera yako.</translation>
<translation id="6333502561965082103">Shughuli nyingine zinaendelea kwenye Chromium. Tafadhali jaribu tena baadaye.</translation>
<translation id="6334986366598267305">Sasa ni rahisi zaidi kutumia Chromium pamoja na Akaunti yako ya Google na kwenye kompyuta zinazoshirikiwa.</translation>
<translation id="6347002662287820329">Weka Chromium iwe kivinjari chako chaguomsingi ili upate uwezo wa kufikia kwa urahisi vipengele unavyovifahamu, unavyopenda na unavyoamini.</translation>
<translation id="6663103136563143835">Njia ya Mkato ya Agent Chrome</translation>
<translation id="8324836837188781073">Agent Chrome imezuia upakuaji huu kwa sababu faili hii kwa kawaida haipakuliwi na huenda si salama</translation>
<translation id="6373523479360886564">Je, una hakika unataka kusanidua Chromium?</translation>
<translation id="6375219077595103062">Weka njia ya mkato kwenye Kidhibiti cha Manenosiri</translation>
<translation id="6388799252195623474">nisaidie kwa hili</translation>
<translation id="6390800440335263989">Ili uendelee, ingia kwenye Chromium ukitumia <ph name="EMAIL" />. Kufanya hivyo huhakikisha kuwa unafuata sera za shirika lako.</translation>
<translation id="6400112897226594999">Nembo ya Chromium ndani ya skrini ya kompyuta.</translation>
<translation id="6403826409255603130">Chromium ni kivinjari cha wavuti kinachoendesha kurasa za wavuti na programu kwa kasi ya umeme. Ni ya haraka, imara, na rahisi kutumia. Vinjari wavuti kwa usalama zaidi dhidi ya hadaa na programu hasidi ukiwa na ulinzi uliojengwa ndani ya Chromium.</translation>
<translation id="6414624068245092115">Ili uhakikishe kuwa unaweza kutumia na kuhifadhi data ya Chromium katika Akaunti yako ya Google kila wakati, thibitisha kuwa ni wewe</translation>
<translation id="5698692159722140301">Agent Chrome hufanya kazi haraka zaidi na vipengele vinavyotumia JavaScript vinapaswa kufanya kazi kama vilivyokusudiwa</translation>
<translation id="6436260184216827876">Kipengele cha Kutafuta kwa Picha hakipatikani. Jaribu tena baadaye.</translation>
<translation id="6442900851116057561">Zima kisha uwashe Mfumo wa Uendeshaji wa Chromium</translation>
<translation id="1150325299163558144">Agent Chrome hupakia mapema kurasa nyingi zaidi ambazo huenda ukatembelea, ili zipakiwe kwa haraka zaidi unapozitembelea</translation>
<translation id="6450948450282634257">Pakua Chromium kwenye simu yako ili ufuatilie bei na upate arifa bei inaposhuka kwenye tovuti yoyote</translation>
<translation id="2302438614865168038">Kimezimwa • Agent Chrome haiwezi kuthibitisha sehemu kinapotoka kiendelezi hiki</translation>
<translation id="6455857529632101747">Karibu kwenye kipengele cha wasifu kwenye Chromium</translation>
<translation id="6460614424172581323">Utakapofungua Chromium tena kwenye <ph name="DEVICE_TYPE" /> yako, utaona kidokezo cha kutumia vikundi vya vichupo.</translation>
<translation id="6466344609055215035">Ondoa Akaunti kwenye Chromium</translation>
<translation id="5526497172610025231">Pia inadhibiti ukurasa unaoonyeshwa unapoanzisha Agent Chrome.</translation>
<translation id="648319183876919572">Kipengele cha Kuvinjari Salama Kilichoboreshwa hufanya mengi zaidi ili kukulinda dhidi ya tovuti na vipakuliwa hatarishi.</translation>
<translation id="6510925080656968729">Ondoa Chromium</translation>
<translation id="124295298108005714">Njia za mkato hufunguka kwenye Agent Chrome</translation>
<translation id="9177671044583442813">Shirika lako hufunga Agent Chrome isipotumika kwa <ph name="TIMEOUT_DURATION" />. Data ya kuvinjari ilifutwa. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa.</translation>
<translation id="6542839706527980775">Kila wasifu una maelezo yake ya Chromium kama vile alamisho, historia, manenosiri na mengine</translation>
<translation id="6556755379298048869">Tafuta ukitumia mikato ya kibodi.</translation>
<translation id="5677032436425073715">Pata maelezo zaidi kuhusu <ph name="BEGIN_LINK" />jinsi Agent Chrome inavyoweka data yako kuwa ya faragha<ph name="END_LINK" /></translation>
<translation id="5967753610833950399">Mabadiliko kwenye mipangilio hii yataanza kutekelezwa baada ya Agent Chrome kuzima kisha kuwaka.</translation>
<translation id="4790842900919490952">Dhibiti viendelezi vyako kwa kubofya Viendelezi kwenye menyu kuu ya Agent Chrome.</translation>
<translation id="656935081669708576">Unaweza kubadilisha ili uone manenosiri kwenye wasifu mwingine wa Chromium</translation>
<translation id="6569556444379005948">Tumia programu ya Chromium ili upate zana bora za akiliunde popote ulipo</translation>
<translation id="8124768693572849485">Ili kurekebisha makosa ya tahajia, Agent Chrome hutuma maandishi unayoandika kwenye sehemu za maandishi kwa Google</translation>
<translation id="6598877126913850652">Nenda kwenye mipangilio ya arifa ya Chromium</translation>
<translation id="6600016381025017075">Tafuta chochote kwenye ukurasa huu</translation>
<translation id="1736130262142947818">Mabadiliko yako yataanza kufanya kazi wakati ujao utakapozindua upya Agent Chrome.</translation>
<translation id="6637908313088374648">Sasa Chromium hufunguka unapowasha Windows ili uanze kuvinjari papo hapo. Unaweza kuzima hii katika Mipangilio.</translation>
<translation id="6648212540664651655">Endelea ulikoachia: Chromium imerejesha vichupo vyako kutoka kwenye kipindi chako kilichopita Unaweza kuzima hili katika</translation>
<translation id="665732753414869868">Chromium inahitaji ruhusa ya kufikia kamera ili iunde ramani ya 3D ya mazingira yako</translation>
<translation id="6669284030132180248">Iwapo pia unahifadhi alamisho kwenye Akaunti yako ya Google, unaweza kufuatilia bei za bidhaa katika Chromium na upokee arifa bei inapopunguzwa</translation>
<translation id="6676384891291319759">Fikia wavuti</translation>
<translation id="668175097507315160">Mfumo wa Uendeshaji wa Chromium haukuweza kusawazisha data yako kutokana na hitilafu wakati wa kuingia katika akaunti.</translation>
<translation id="6691132793308828750">Ondoa data ya programu hii kwenye Chromium</translation>
<translation id="6709350901466051922">Chromium inahitaji ruhusa ya kufikia maikrofoni kwa ajili ya tovuti hii</translation>
<translation id="6712881677154121168">Hitilafu wakati wa kupakua: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="7755971898820142787">Wasifu wako hauwezi kutumiwa kwa sababu umetoka katika toleo jipya la Agent Chrome.

Baadhi ya vipengele huenda visipatikane. Tafadhali bainisha saraka tofauti ya wasifu au utumie toleo jipya la Agent Chrome.</translation>
<translation id="6729124504294600478">Ili upate mapendeleo na vipengele vingine, jumuisha Chromium katika Historia ya Shughuli kwenye Wavuti na Programu pamoja na huduma za Google zilizounganishwa</translation>
<translation id="6734291798041940871">Tayari Chromium imesakinishwa kwa watumiaji wote kwenye kompyuta yako.</translation>
<translation id="6742093177587589736">Ili upate alamisho zako na mengineyo kwenye vifaa vyako vyote, ingia katika Chromium. Alamisho hii itahifadhiwa kwenye Akaunti yako ya Google ukishaingia katika akaunti.</translation>
<translation id="7821834337023193240">Huongeza kasi ya tovuti kwa kutumia mtambo wa V8 wa Agent Chrome lakini hufanya Agent Chrome isistahimili kwa muda murefu mashambulio. Mipangilio hii imewashwa.</translation>
<translation id="6754665438209053659">{count,plural, =1{Baadhi ya data yako ya Chromium bado haijahifadhiwa kwenye Akaunti yako ya Google. Jaribu kusubiri kwa dakika chache kabla ya kuondoka kwenye akaunti. Ukiondoka kwenye akaunti sasa, data hii (kipengee 1) itafutwa.}other{Baadhi ya data yako ya Chromium bado haijahifadhiwa kwenye Akaunti yako ya Google. Jaribu kusubiri kwa dakika chache kabla ya kuondoka kwenye akaunti. Ukiondoka kwenye akaunti sasa, data hii (vipengee {count}) itafutwa.}}</translation>
<translation id="67706546131546258">Chromium inapendekeza kuchanganua faili hii kwa sababu huenda isiwe salama.</translation>
<translation id="6779406956731413166">Mfumo wa uendeshaji wa Chromium umewezeshwa na <ph name="BEGIN_LINK_CROS_OSS" />programu huria<ph name="END_LINK_CROS_OSS" /> za ziada.</translation>
<translation id="6831043979455480757">Tafsiri</translation>
<translation id="6847869444787758381">Chromium hukuruhusu ujue iwapo manenosiri yako yameathiriwa</translation>
<translation id="684888714667046800">Imeshindwa kuunganisha kwenye Intaneti. Iwapo unatumia kinga mtandao, tafadhali hakikisha <ph name="PRODUCT_EXE_NAME" /> iko kwenye orodha ya zilizoruhusiwa.</translation>
<translation id="6219638737609534419">Agent Chrome - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Tumia kichupo ili uendelee</translation>
<translation id="6862030660799253820">Tafuta picha hii ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="6869568587896659271">Uwezo wa kufikia tovuti zilizo chini ya sehemu ya anwani kwa urahisi</translation>
<translation id="7421523967177993052">Agent Chrome imegundua kwamba "<ph name="EXTENSION_NAME" />" ina programu hasidi</translation>
<translation id="6877155553248388166">kona ya chini kulia ya eneo la utafutaji: kulia asilimia <ph name="RIGHT" />, chini asilimia <ph name="BOTTOM" /></translation>
<translation id="6896758677409633944">Nakili</translation>
<translation id="6898028264630240901">Unaweza kubandika Majukumu ya Kimuktadha ili uweze kuuliza maswali unapovinjari</translation>
<translation id="6901631050894301805">Weka Chromium iwe kivinjari chako chaguomsingi kisha uibandike kwenye upauzana wako</translation>
<translation id="6909503629704372277">&amp;Dhibiti wasifu wa Chromium</translation>
<translation id="9199111398679939226">Kitendo hiki:
          <ph name="LINE_BREAKS" />
            • Kitaweka upya ukurasa unaoanza, ukurasa wa kichupo kipya, mtambo wa kutafuta na vichupo vyako vilivyobandikwa
            <ph name="LINE_BREAK" />
            • Kitazima viendelezi
            <ph name="LINE_BREAK" />
            • Kitafuta vidakuzi na data nyingine ya tovuti ya muda
            <ph name="LINE_BREAK" />
            • Kitaweka upya njia za mkato za Agent Chrome
            <ph name="LINE_BREAKS" />
            Alamisho, historia na manenosiri uliyohifadhi hayataathiriwa.</translation>
<translation id="6948031725951063910">Umefikia kikomo cha Chromium cha alamisho <ph name="BOOKMARK_LIMIT" />, kwa hivyo baadhi ya alamisho zako bado hazijahifadhiwa kwenye Akaunti yako ya Google.

Huwezi kuhifadhi alamisho mpya kwenye akaunti yako hadi ufute baadhi ya alamisho. Ukiondoka kwenye akaunti sasa, alamisho ambazo hazijahifadhiwa zitafutwa.</translation>
<translation id="6964305034639999644">Fungua kiungo katika dirisha fiche la Chromium</translation>
<translation id="6965382102122355670">Sawa</translation>
<translation id="6985329841647292029">Sheria na masharti ya Mfumo wa Uendeshaji wa Chromium</translation>
<translation id="7003299027384820442">Weka kauli yako ya siri ili utumie na uhifadhi data ya Chromium katika akaunti yako, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Imeshindwa kusakinisha kwa sababu toleo hili la mfumo wa uendeshaji halitumiki.</translation>
<translation id="7024536598735240744">Hitilafu ya kutekeleza kiendelezi cha ndani: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7045244423563602563">Weka Mipangilio ya Chromium Upendavyo</translation>
<translation id="7047386856539490735">Je, matokeo haya yanakufaa?</translation>
<translation id="705851970750939768">Sasisha Chromium</translation>
<translation id="1222890016986172619">Ikiwa picha haina ufafanuzi muhimu, Agent Chrome itajaribu kukuwekea. Ili kuweka ufafanuzi, tutatuma picha kwa Google.</translation>
<translation id="7074836723476134809">Nufaika na uwezo wa AI unapotumia programu ya Chromium kwenye <ph name="DEVICE_TYPE" /> yako</translation>
<translation id="7134687062119989071">Pata manenosiri, vichupo na mengineyo popote ulipo ukitumia programu ya Chromium kwenye simu yako</translation>
<translation id="7141270731789036260">Weka mapendeleo kwenye Chrome ya Majaribio</translation>
<translation id="5669948510815930830">Unaweza kutumia Agent Chrome wakati wowote unapobofya viungo kwenye ujumbe, hati na programu nyingine</translation>
<translation id="5576210706466474421">Ondoa <ph name="EXTENSION_NAME" /> kwenye Agent Chrome</translation>
<translation id="4588941330171478873">Shirika lako hufuta data ya Agent Chrome isipotumika kwa <ph name="TIMEOUT_DURATION" />. Data hii inaweza kujumuisha historia, maelezo yaliyojazwa kiotomatiki na vipakuliwa.</translation>
<translation id="718435575166326686">Chromium inahitaji ruhusa ya kufikia kamera kwa ajili ya tovuti hii</translation>
<translation id="2916059341902838041">Imeshindwa kuanzisha Agent Chrome. Jaribu tena.</translation>
<translation id="7204669035546236137">Uliza chochote, popote ulipo, ukitumia Gemini kwenye Chromium</translation>
<translation id="1716746018761150810">Weka Agent Chrome katika sehemu yako ya Kupachika ili uifikie haraka wakati wowote</translation>
<translation id="7213407614656404070">Tumia Chromium wakati wowote unabofya viungo kwenye ujumbe, hati na programu nyinginezo</translation>
<translation id="7216228761061470870">Unapotumia kipengele cha Kutafuta kwa Picha katika kompyuta ya mezani, jina la ukurasa, URL na maudhui, ikiwa ni pamoja na PDF hutumwa kwenye seva</translation>
<translation id="4816956813330284757">Kidhibiti cha Shughuli - Agent Chrome</translation>
<translation id="7227958669698166857">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER" />. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti ya Chromium kwenye wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS" />. Pia utapata taarifa zako zilizohifadhiwa na zaidi kwenye vifaa vyako vyote.</translation>
<translation id="7252276985725323153">Anza kuvinjari papo hapo: Sasa Chromium inaweza kufunguka unapowasha Windows.</translation>
<translation id="7274695763216404502">Kimebandikwa! Tumia kipengele cha Kutafuta kwa Picha tena katika upau wa vidhibiti</translation>
<translation id="7288567540154601580">Vichupo na viendelezi</translation>
<translation id="3631444715156784168">{NUM_EXTENSIONS,plural, =1{Agent Chrome inapendekeza ukiondoe}other{Agent Chrome inapendekeza uviondoe}}</translation>
<translation id="2739521415810397215">Ili utume sauti ya mfumo, fungua Mipangilio ya Mfumo kisha uruhusu 'Kurekodi Sauti ya Mfumo Pekee' kwenye Agent Chrome. Utahitaji kuzima kisha uwashe Agent Chrome.</translation>
<translation id="1945073734373493421">Inasasisha Agent Chrome</translation>
<translation id="7323500970718355745">Faili yako ya mapendeleo imeharibika au ni batili. 

Agent Chrome haiwezi kufufua mipangilio yako.</translation>
<translation id="7324051657739063017">Unaweza kufungua tena Majukumu ya Kimuktadha ili uulize maswali unapovinjari</translation>
<translation id="734373864078049451">Wavuti, alamisho, na mambo yako mengine ya Chromium yanapatikana hapa.</translation>
<translation id="7347827960336370838">Mtu aliye na kauli yako ya siri ndiye tu anayeweza kusoma data yako iliyosimbwa kwa njia fiche. Kauli ya siri haitumwi kwa wala kuhifadhiwa na Google. Ukisahau kauli yako ya siri au ikiwa ungependa kubadilisha mipangilio hii, utahitaji <ph name="BEGIN_LINK" />kufuta data ya Chromium kwenye akaunti yako<ph name="END_LINK" />.</translation>
<translation id="7994662313190863803">Msimamizi wa mfumo unaotumia ameweka mipangilio ya Agent Chrome ifungue <ph name="ALTERNATIVE_BROWSER_NAME" /> ili kufikia <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Hitilafu fulani imetokea</translation>
<translation id="4438212735766904761">Utahitaji toleo la macOS 13 au matoleo mapya zaidi ili upate masasisho ya Agent Chrome ya siku zijazo. Kompyuta hii inatumia toleo la macOS 12.</translation>
<translation id="7376384068949534168">Hujazitembelea hivi majuzi. Chromium imeonda <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Fungua Duka la Chrome kwenye Wavuti</translation>
<translation id="7394275517973019558">Onyesha Gemini kwenye Chromium katika ubao wa aikoni</translation>
<translation id="7401687852903179959">Tafuta Video Hii ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="7407655596887111931">Sasa Chromium ni kivinjari chako chaguomsingi</translation>
<translation id="3957050361764426740">Endelea ulikoachia: Agent Chrome hurejesha vichupo vyako kila wakati unapoianzisha upya. Ili uzime, nenda kwenye</translation>
<translation id="7427879960656355200">Pakia Manenosiri Kwenye Chromium</translation>
<translation id="744815265653811511">1. Bofya <ph name="BUTTON_LABEL" /> hapa chini
2. Bofya <ph name="BUTTON_2" /> katika mipangilio yako ya Windows
3. Bofya <ph name="BUTTON_3" /> kwenye arifa ya Windows ili ubandike Chromium kwenye upauzana wako ili uifikie kwa haraka</translation>
<translation id="4378256924846450484"><ph name="PAGE_TITLE" /> - Agent Chrome ya Wasanidi Programu</translation>
<translation id="7450541714075000668">Maandishi yamenakiliwa</translation>
<translation id="1661210845845599119">Ili utumie maikrofoni yako, ruhusu Agent Chrome ifikie <ph name="BEGIN_LINK" />mipangilio ya mfumo<ph name="END_LINK" /></translation>
<translation id="7461356015007898716">Ili upate masasisho yajayo ya Chromium, utahitaji kutumia toleo la Windows 10 au toleo jipya zaidi. Kompyuta hii inatumia toleo la Windows 7.</translation>
<translation id="7782360127659485548">Ungependa kufungua Agent Chrome tena?</translation>
<translation id="7483335560992089831">Haiwezi kusakinisha toleo sawia la Chromium ambalo linaendeshwa hivi sasa. Tafadhali funga Chromium na ujaribu tena.</translation>
<translation id="7510190804000607802">Kikumbusho: Vipengele bora vya Google kiganjani mwako</translation>
<translation id="4114725046952451715">Huenda tovuti zitafanya kazi kama inavyotarajiwa. Utaondolewa kwenye tovuti nyingi ukifunga madirisha yote ya Agent Chrome, isipokuwa katika Akaunti yako ya Google ikiwa umeingia katika Agent Chrome.</translation>
<translation id="8460803820751380899">{0,plural, =1{Agent Chrome itafunguka upya ndani ya dakika 1}other{Agent Chrome itafunguka upya ndani ya dakika #}}</translation>
<translation id="7565444033145385702">Ili kulinda data yako, ruhusu Chromium iondoe ruhusa kwenye tovuti ambazo hujatembelea hivi karibuni.</translation>
<translation id="7806190892617295204">Fungua Agent Chrome kiotomatiki ili uanze kuvinjari papo hapo.</translation>
<translation id="7583399374488819119">Kisakinishaji cha <ph name="COMPANY_NAME" /></translation>
<translation id="4114499337401148821">Agent Chrome inatumia kamera na maikrofoni yako.</translation>
<translation id="7617377681829253106">Chromium imeboreshwa</translation>
<translation id="4075526625511660913">Sasa una vipengele zaidi vinavyopatikana katika Agent Chrome</translation>
<translation id="7624307931717240213">Tunatumia maelezo kuboresha huduma hii. Angalia Sera ya Faragha na Sheria na Masharti.</translation>
<translation id="7649070708921625228">Usaidizi</translation>
<translation id="7650134251917003571">Pakua Programu ya Chromium</translation>
<translation id="7658239707568436148">Ghairi</translation>
<translation id="5829091955527196771">Agent Chrome si kivinjari chako chaguomsingi</translation>
<translation id="7689606757190482937">Sawazisha na uweke mapendeleo kwenye Chromium katika vifaa vyako vyote</translation>
<translation id="7699779824407626136">Sasisho la Chromium</translation>
<translation id="7700735928747402058">Kulinda kazi yako kwenye Chromium</translation>
<translation id="7716950018788545737">Majukumu yamekamilika.</translation>
<translation id="77283119132245232">Hutoa huduma za ufuatiliaji wa mfumo kwa <ph name="BROWSER_NAME" />. Ikiwa huduma hii itazimwa, shughuli za ufuatiliaji wa utendaji zilizobuniwa na kivinjari hazitajumuisha matukio ya mfumo mzima kama vile kubadilisha muktadha na matukio yaliyopo ya mazungumzo.</translation>
<translation id="7745317241717453663">Hatua hii itafuta data yako ya kuvinjari kwenye kifaa hiki. Ili urejeshe data yako baadaye, ingia katika Chromium ukitumia <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Kisakinishi hakikuweza kuunda saraka la muda. Tafadhali chunguza nafasi iliyo wazi kwenye diski na ruhusa ya kusakinisha programu.</translation>
<translation id="7747820849741499258">Kutafuta kwenye Chromium</translation>
<translation id="7750130090210923118">Badilisha utumie Chromium kwa Chaguomsingi</translation>
<translation id="7752521946322750699">Ili kulinda kazi yako kwenye Chromium, shirika lako litaweza kuona au kudhibiti maelezo fulani unapoingia katika akaunti ya Chromium.</translation>
<translation id="7781047659465034537">Weka Chromium iwe chaguomsingi kisha uibandike kwenye upauzana</translation>
<translation id="7786760609782648049">Ifanye Chromium iwe na kasi</translation>
<translation id="1092858669153166534"><ph name="PAGE_TITLE" /> - Toleo la Jaribio la Agent Chrome</translation>
<translation id="6890902183809417868">Fanya iwe vigumu watu wanaoweza kufikia shughuli yako kwenye intaneti kuona tovuti unazotembelea. Agent Chrome hutumia muunganisho salama kutafuta anwani ya IP ya tovuti katika DNS (Mfumo wa Majina ya Vikoa).</translation>
<translation id="7810005234485217901">Unaweza kubandika kipengele cha Kutafuta kwa Picha ili uweze kukifikia kwa urahisi</translation>
<translation id="4343938787674079986">Chagua unachoruhusu Agent Chrome ifikie</translation>
<translation id="7828947555739565424">Tayari kuna wasifu kwenye Chromium unaotumia akaunti hii katika kifaa hiki</translation>
<translation id="7845233973568007926">Asante kwa kusakinisha. Ni lazima uzime kisha uwashe tena kompyuta yako kabla ya kutumia <ph name="BUNDLE_NAME" />.</translation>
<translation id="6129792107484731038">Mtambo wako wa kutafuta umebadilishiwa nje ya Agent Chrome. Ili kukulinda, Agent Chrome imeubadilisha kuwa mtambo chaguomsingi halisi. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="7853661403199074278">Badilisha Chromium upendavyo ili uipe mwonekano mpya</translation>
<translation id="5018331886385637870">Unapoandika kwenye sehemu ya anwani au kisanduku cha kutafutia, Agent Chrome hutuma unachokiandika kwenye mtambo wako chaguomsingi wa kutafuta ili upate mapendekezo bora. Kipengele hiki huwa kimezimwa katika Hali fiche.</translation>
<translation id="473441635289092936">Agent Chrome imeshindwa kusasisha toleo jipya, kwa hivyo hutapata masasisho ya usalama na vipengele vipya.</translation>
<translation id="7872446069773932638">Inapakua... Zimesalia sekunde <ph name="SECONDS" /></translation>
<translation id="7873537467422636035">Ikiwa umesahau kauli yako ya siri au ungependa kubadilisha mipangilio hii, <ph name="BEGIN_LINK" />futa data ya Chromium kwenye akaunti yako<ph name="END_LINK" /></translation>
<translation id="7874369989024033742">Fungua Gemini kwa haraka kwenye Chromium wakati unaihitaji</translation>
<translation id="7888981273428720788">Ifanye Chromium iwe kivinjari chako chaguomsingi</translation>
<translation id="7934340546140346950">Chromium husasisha kiotomatiki miunganisho isiyo salama kuwa HTTPS inapowezekana</translation>
<translation id="7937630085815544518">Uliingia kwenye Chromium kama <ph name="USER_EMAIL_ADDRESS" />. Tafadhali tumia akaunti hiyo hiyo kuingia tena.</translation>
<translation id="7944602660083060118">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER" />. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti ya Chromium kwenye wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS" />. Pia utapata alamisho zako na zaidi kwenye vifaa vyako vyote.</translation>
<translation id="688313102897865477">Huu ni usakinishaji wa pili wa Agent Chrome, na haiwezi kufanywa kuwa kivinjari chako chaguomsingi.</translation>
<translation id="8514782479541580218">Viendelezi, programu na mandhari kutoka kwenye vyanzo visivyojulikana vinaweza kuathiri kifaa chako. Agent Chrome inapendekeza usakinishaji kutoka <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> tu</translation>
<translation id="8000759043835159571">Nufaika zaidi na Google ukitumia programu ya Chromium kwenye <ph name="DEVICE_TYPE" /> yako</translation>
<translation id="8004582292198964060">Kivinjari</translation>
<translation id="8010081455002666927">Tambua kiotomatiki</translation>
<translation id="403216574291780144">Agent Chrome itakapopata idhini, tovuti zitaweza kukuomba idhini ya kufikia.</translation>
<translation id="7835197459694498831">Bandika Agent Chrome kwenye upauzana wako ili uifikie kwa haraka wakati wowote</translation>
<translation id="80471789339884597">Asante kwa kusakinisha. Ni lazima uzime kisha uwashe tena vivinjari vyako kabla ya kutumia <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">Onyesha njia mkato ya Kutafuta kwa Picha kila wakati</translation>
<translation id="8069447462453318634">Chagua "Bandika kwenye upau wa vidhibiti"</translation>
<translation id="787536271006179882">Zima Agent Chrome inayotumika chinichini kwenye programu</translation>
<translation id="80790299200510644">Kutafuta kwa Picha</translation>
<translation id="8086881907087796310">Imeshindwa kusakinisha kwa sababu kompyuta yako haitimizi masharti ya chini yanayohitajika ya maunzi.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome ya Kujaribia</translation>
<translation id="8105840573057009683">Chromium inahitaji ruhusa ya kufikia maelezo ya mahali kwa ajili ya tovuti hii</translation>
<translation id="8107060931443639922">Utakapofungua Chromium tena kwenye <ph name="DEVICE_TYPE" /> yako, utaona kidokezo cha kuwasha arifa za ufuatiliaji wa bei.</translation>
<translation id="8117908349476699973">Pata arifa za punguzo la bei ya bidhaa zinazokuvutia ukitumia programu ya Chromium kwenye simu yako</translation>
<translation id="8118331347066725040">Tuma maoni ya kutafuta ukitumia Lenzi</translation>
<translation id="8130609355518033382">Tumia Chromium inavyokufaa</translation>
<translation id="8133124826068723441">Mfumo wa Uendeshaji wa Chromium haukusawazisha data yako kwa sababu Usawazishaji haupatikani kwa kikoa chako.</translation>
<translation id="813913629614996137">Inaanzisha…</translation>
<translation id="8161503455832158203">Tumia mikato ya kibodi kufungua Gemini kwenye Chromium.</translation>
<translation id="7109772131778940712">Sheria na Masharti ya Ziada ya Agent Chrome</translation>
<translation id="7759642951398174884">Faili hii ni hatari, kwa hivyo Agent Chrome imeizuia.</translation>
<translation id="8177472873527554730">Imeshindwa kupata maudhui kwenye ukurasa</translation>
<translation id="8200109504272824693">Weka kauli yako ya siri ili utumie na uhifadhi data ya Chromium katika akaunti yako, <ph name="USER_EMAIL" /></translation>
<translation id="820759916613250543">Tafuta Picha Hii ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="8221491193165283816">Huwa unazuia arifa. Ili uruhusu tovuti hii ikuarifu, bofya hapa.</translation>
<translation id="5410773870087525304">Ili utumie kamera yako, ruhusu Agent Chrome ifikie <ph name="BEGIN_LINK" />mipangilio ya mfumo<ph name="END_LINK" /></translation>
<translation id="1057772683559103555">Agent Chrome haiwezi kuthibitisha chanzo cha kiendelezi hiki na huenda si salama. Kiondoe kwenye Agent Chrome ili kisiweze tena kuona na kubadilisha data yako kwenye tovuti unazotembelea, ikiwa ni pamoja na taarifa zako binafsi.</translation>
<translation id="1968416200800224093">Ikiwa picha haina ufafanuzi muhimu, Agent Chrome itajaribu kukuwekea. Ili kuweka ufafanuzi, tutatuma picha kwa Google. Unaweza kuzima mipangilio hii wakati wowote.</translation>
<translation id="8254601181414348851">Ungependa kuingia katika akaunti kwenye Chromium ukitumia wasifu mpya?</translation>
<translation id="8262224117913639129">Tayari umeingia katika akaunti ya <ph name="EXISTING_USER" />. Ili utenganishe shughuli zako za kuvinjari, ingia katika akaunti ya Chromium kwenye wasifu wako binafsi ukitumia <ph name="USER_EMAIL_ADDRESS" />. Pia utapata manenosiri yako na zaidi kwenye <ph name="DEVICE" />.</translation>
<translation id="8277334259226003205">Onyesha Gemini kwenye Chromium katika ubao wa aikoni kisha uwashe mikato ya kibodi</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium inakuonya<ph name="END_LINK" /> kuhusu tovuti na vipakuliwa ambavyo si salama</translation>
<translation id="8295827201165805317">Hujazitembelea hivi majuzi. Chromium imeondoa <ph name="PERMISSION" />.</translation>
<translation id="8296236834352487533">Nunua, tafsiri na utambue unachokiona ukitumia kamera yako katika programu ya Chromium inayotumika kwenye iOS</translation>
<translation id="8310603974518734211">Msimbo wa QR wa kuingia katika Chromium ukitumia <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Hitilafu ya kuwasha: <ph name="STARTUP_ERROR" />.</translation>
<translation id="2256229026962116267">Shirika lako hufunga Agent Chrome isipotumika kwa <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">Hifadhi ikiwa picha</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> ilikuwa ikitumia Chromium awali</translation>
<translation id="8351551329754447960">Washa kipengele cha Ujuzi kwenye Chromium</translation>
<translation id="8359544530202147897">Sasisha Chromium ili iendelee kutumia data ya Chromium katika Akaunti yako ya Google, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="8360718212975266891">Ili upate masasisho yajayo ya Chromium, utahitaji kutumia toleo la Windows 10 au toleo jipya zaidi. Kompyuta hii inatumia toleo la Windows 8.</translation>
<translation id="8362914115861174987">Tafsiri kwa</translation>
<translation id="8367705492654390392">Uliza chochote</translation>
<translation id="8370517070665726704">Hakimiliki <ph name="YEAR" /> Google LLC. Haki zote zimehifadhiwa.</translation>
<translation id="8372327902843331129">Ili upate manenosiri yako na zaidi kwenye vifaa vyako vyote, ingia katika akaunti kwenye Chromium. Ukishaingia katika akaunti, nenosiri hili litahifadhiwa kwenye Akaunti yako ya Google.</translation>
<translation id="3962779702290581702">Na utahitaji kuzima kisha uwashe Agent Chrome.</translation>
<translation id="6085013152567092546">Agent Chrome inapendekeza ukiondoe. <ph name="BEGIN_LINK" />Pata maelezo zaidi kuhusu viendelezi vinavyotumika<ph name="END_LINK" /></translation>
<translation id="8142784445734351509">Uchapishaji wa kiendelezi hiki ulibatilishwa na msanidi programu na huenda kisiwe salama. Kiondoe kwenye Agent Chrome ili kisiweze tena kuona na kubadilisha data yako kwenye tovuti unazotembelea, ikiwa ni pamoja na taarifa zako binafsi.</translation>
<translation id="8416884904046428725">Chromium inahitaji kuthibitisha kuwa ni wewe kabla ya kuhifadhi baadhi ya data kwenye Akaunti yako ya Google na kuitumia kwenye vifaa vyako vyote. Ukiondoka kwenye akaunti sasa, data hii itafutwa.</translation>
<translation id="7611805576553766531">{0,plural, =1{Fungua Agent Chrome upya ndani ya siku moja}other{Fungua Agent Chrome upya ndani ya siku #}}</translation>
<translation id="8438543370129609977">Unapotumia kipengele cha Kutafuta kwa Picha, jina la ukurasa, URL na maudhui, ikiwa ni pamoja na PDF hutumwa kwenye seva. <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">Pata maelezo zaidi kuhusu kutafuta ukitumia kipengele cha Kutafuta kwa Picha kwenye Chromium</translation>
<translation id="8453117565092476964">Kumbukumbu ya kisakinishi imeharibika au ni batili. Tafadhali pakua Chromium tena.</translation>
<translation id="8458614432758743027">Chromium inahitaji Windows 10 au toleo jipya zaidi.</translation>
<translation id="8463672209299734063">Si lazima: Tusaidie kuboresha utendaji na vipengele vya Mfumo wa Uendeshaji wa Chromium kwa kutuma kiotomatiki data ya matumizi na uchunguzi kwa Google.</translation>
<translation id="8471947159125090285">Ili utumie na uhifadhi data ya Chromium katika Akaunti yako ya Google, thibitisha kuwa ni wewe</translation>
<translation id="8482493977473846331">Huonyesha vidokezo vya kuingia katika Chromium</translation>
<translation id="6049002268233195982">Agent Chrome Imepitwa na Wakati</translation>
<translation id="6156435126546305838">Asante kwa kuchagua Agent Chrome iwe kivinjari chako chaguomsingi!</translation>
<translation id="8522801943730206384">Chromium inaweza kukagua manenosiri yako unapoyahifadhi</translation>
<translation id="8525579356836940628">Uwekaji Umesimamishwa</translation>
<translation id="8545729292258443488">Pata manenosiri, vichupo na mengineyo popote ulipo ukitumia programu ya Chromium kwenye <ph name="DEVICE_TYPE" /> yako</translation>
<translation id="8548787790260785208">Pata onyo Chromium ikipata mojawapo ya manenosiri yako katika ufichuzi haramu wa data kwa umma</translation>
<translation id="8555465886620020932">Hitilafu ya huduma: <ph name="SERVICE_ERROR" />.</translation>
<translation id="2713372071612730965">Baadhi ya vipengele na viendelezi vya Agent Chrome vinajumuisha njia za mkato. Unaweza kuchagua kuviwasha tena.</translation>
<translation id="8556420416730706394">Unaweza kubandika kipengele cha Kutafuta kwa Picha ili uweze kukifikia kwa urahisi; bofya kitufe cha Bandika katika sehemu ya juu ya kidirisha cha pembeni</translation>
<translation id="856656450041460113">Tafuta orodha ya lugha</translation>
<translation id="1783040386392706016">Mashirika mengi yanadhibiti Agent Chrome</translation>
<translation id="7921569471494089882">Hakimiliki <ph name="YEAR" /> Wasanidi wa Agent Chrome. Haki zote zimehifadhiwa.</translation>
<translation id="8601359445272098721">Mpya! Unaweza kutafsiri matini na picha kwenye skrini kwa kuchagua kitufe cha "tafsiri skrini"</translation>
<translation id="6294059080097269555">Inaanzisha Agent Chrome...</translation>
<translation id="8624541899164515475">Mipangilio, hufunguka katika kichupo kipya.</translation>
<translation id="8648201657708811153">Huwezi kufanya Google Chrome ya Majaribio iwe kivinjari chako chaguomsingi.</translation>
<translation id="5652647471010716562">Pia inadhibiti ukurasa unaoonyeshwa unapoanzisha Agent Chrome au unapotafuta kutoka Sanduku Kuu.</translation>
<translation id="8704119203788522458">Hii ni Chromium yako</translation>
<translation id="8712637175834984815">Nimeelewa</translation>
<translation id="8719993436687031146">Ungependa kuingia kwenye Chromium?</translation>
<translation id="8747073452963259673">kona ya chini kushoto ya eneo la utafutaji: kushoto asilimia <ph name="LEFT" />, chini asilimia <ph name="BOTTOM" /></translation>
<translation id="878572486461146056">Hitilafu ya kisakinishaji: Msimamizi wa mtandao wako ameweka Sera ya Jumla inayozuia usakinishaji: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Nikumbushe baadaye</translation>
<translation id="8816416449795340678">Ruhusu Gemini ifikie hati hii kwenye Chromium ili upate muhtasari wa haraka na uulize maswali ya nyongeza</translation>
<translation id="8818550178040858407">Ungependa kuingia katika akaunti kwenye Chromium?</translation>
<translation id="4188893721116572726">Fanya Agent Chrome iwe kivinjari chaguomsingi na uibandike kwenye upauzana</translation>
<translation id="8826492472752484139">Bofya “Kidhibiti cha Manenosiri”</translation>
<translation id="8833697763442816810">Mfumo wa Uendeshaji wa Chromium</translation>
<translation id="341256515309503869">Lugha hii hutumika kuonyesha menyu, mipangilio, arifa na maandishi mengine katika Agent Chrome</translation>
<translation id="8862326446509486874">Huna haki zifaazo ili kufanya usakinishaji wa kiwango cha mfumo. Jaribu kutumia kisakinishi kama msimamiaji kompyuta.</translation>
<translation id="8876044221123442390">Weka Wasifu wa Chromium</translation>
<translation id="8890569919834781711">ChromiumOS imeshindwa kuhifadhi data ya Chromium kwenye Akaunti yako ya Google kutokana na hitilafu wakati wa kuingia katika akaunti</translation>
<translation id="8891709362986793894">Shirika lako linataka uingie katika akaunti ya Chromium</translation>
<translation id="8907580949721785412">Chromium inajaribu kuonyesha manenosiri. Chapa nenosiri lako la Windows ili uruhusu hili.</translation>
<translation id="8932992523185907506">Chromium haitumiki tena kama kivinjari chako chaguomsingi. Ungependa kuifanya Chromium kuwa kivinjari chaguomsingi?</translation>
<translation id="2086624065931944916">Imeshindwa kusasisha Agent Chrome</translation>
<translation id="8944232836376404813">Kitendo hiki:
          <ph name="LINE_BREAKS" />
            • Kitaweka upya ukurasa unaoanza, ukurasa wa kichupo kipya, mtambo wa kutafuta na vichupo vilivyobandikwa
            <ph name="LINE_BREAK" />
            • Kitazima viendelezi
            <ph name="LINE_BREAK" />
            • Kitafuta vidakuzi na data nyingine ya tovuti ya muda
            <ph name="LINE_BREAKS" />
            Alamisho, historia na manenosiri uliyoyahifadhi hayataathiriwa.</translation>
<translation id="8966875421152977384">Onyesha njia za mkato za tovuti ya Chromium</translation>
<translation id="4591081057798655502">Nembo ya Agent Chrome Enterprise</translation>
<translation id="8980139959902937527">Pata usalama wa Google popote ulipo ukitumia programu ya Chromium kwenye <ph name="DEVICE_TYPE" /> yako</translation>
<translation id="352721818246741864">Imeshindwa kuwasha Agent Chrome kwa sababu hitilafu fulani imetokea wakati wa kufungua wasifu wako. Jaribu kuzima kisha uwashe Agent Chrome.</translation>
<translation id="8988036198400390003">Dhibiti wasifu wa Chromium</translation>
<translation id="8993855408334954620">Tumia kibodi yako kusogeza kati ya Gemini kwenye Chromium na kichupo ulichofungua.</translation>
<translation id="9018218886431812662">Imemaliza kusakinisha</translation>
<translation id="9019929317751753759">Ili kufanya Chromium salama zaidi, tumezima kiendelezi kinachofuata ambacho hakijaorodheshwa katika <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> na huenda kimeongezwa bila ridhaa yako.</translation>
<translation id="9022552996538154597">Ingia kwenye Chromium</translation>
<translation id="9035791714111278917">Onyesha huduma ya kutafuta ukitumia Chromium katika upau wa menyu wa Mac kisha uwashe mikato ya kibodi</translation>
<translation id="144293525744948128">Agent Chrome imezuia upakuaji huu kwa sababu faili iliyo kwenye kumbukumbu inajumuisha faili nyingine ambazo huenda zimeficha programu hasidi</translation>
<translation id="9053882453960391422">Hakikisha manenosiri, alamisho na historia yako imesawazishwa kikamilifu kwenye vifaa mbalimbali. Fikia kwa urahisi vipengele unavyovifahamu na kuvipenda kwa kusasisha kivinjari chako chaguomsingi kiwe Chromium. Chromium itabandikwa kwenye upauzana wako ili uifikie kwa haraka.</translation>
<translation id="9056398481763999048">Tumia programu ya Chromium kufikia zana bora za AI kwenye simu yako</translation>
<translation id="9062666675513499497">Ingia katika akaunti kwenye Chromium unapoingia katika akaunti za huduma nyingine za Google</translation>
<translation id="5989671354018094677">Agent Chrome ilifungwa kiotomatiki</translation>
<translation id="5288426372256126088">Agent Chrome imepitwa na wakati</translation>
<translation id="8599483501705081932">{0,plural, =1{Agent Chrome itafunguka upya ndani ya saa moja}other{Agent Chrome itafunguka upya ndani ya saa #}}</translation>
<translation id="9106236359747881194">Chagua maandishi ya kutafuta</translation>
<translation id="9106612006984859720">Ili upate masasisho yajayo ya Chromium, utahitaji kutumia toleo la Windows 10 au toleo jipya zaidi. Kompyuta hii inatumia toleo Windows 8.1.</translation>
<translation id="6660967356554387137">Fungua Kiungo katika kichupo kipya cha Agent Chrome</translation>
<translation id="911206726377975832">Futa historia yako ya kuvinjari pia?</translation>
<translation id="9134482777260927479">Usaidizi kwenye kazi ya shuleni ya kufanyia nyumbani</translation>
<translation id="9148058034647219655">Ondoka</translation>
<translation id="356554850028684199">Endelea ulikoachia: Agent Chrome inaweza kurejesha vichupo vyako kila wakati unapoianzisha upya. Ili uwashe, nenda kwenye</translation>
<translation id="2217675621893057123">Msimamizi wa mfumo unaotumia ameweka mipangilio ya Agent Chrome ifungue kivinjari mbadala ili ufikie<ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7637726452490203009">Fungua tena ili usasishe &amp;Agent Chrome</translation>
<translation id="9190841055450128916">Chromium (mDNS-In)</translation>
<translation id="924957577793602335">Badilisha Chromium upendavyo</translation>
<translation id="93478295209880648">Huenda Chromium isifanye kazi vizuri kwa sababu haitumiki tena kwenye Windows XP au Windows Vista</translation>
<translation id="945098430667185067">Pata vipengele bora zaidi vya usalama vya Google popote ulipo ukitumia Chromium.</translation>
<translation id="945522503751344254">Tuma maoni</translation>
<translation id="965162752251293939">Ni nani anayetumia Chromium?</translation>
<translation id="967427899662692980">Pata usalama thabiti zaidi kutoka Chromium</translation>
<translation id="983803489796659991">Imeshindwa kusakinisha kwa sababu seva ya usasishaji haina data ya kupunguza urefu ya programu.</translation>
<translation id="985498048907240953">Tumia Chromium Bila Akaunti</translation>
<translation id="5192139095541169725">Waandishi wa Agent Chrome</translation>
<translation id="989970834842471429">Chagua maandishi au picha yoyote ya kutafuta ukitumia kipengele cha Kutafuta kwa Picha</translation>
<translation id="5834693163377136360">Ili utumie maelezo ya mahali uliko, ruhusu Agent Chrome ifikie <ph name="BEGIN_LINK" />mipangilio ya mfumo<ph name="END_LINK" /></translation>
</translationbundle>