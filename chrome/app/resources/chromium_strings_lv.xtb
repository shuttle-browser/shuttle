<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="1026101648481255140">Atsākt instalēšanu</translation>
<translation id="1029669172902658969">Atkārtoti palaist, lai atjauninātu &amp;Chromium OS</translation>
<translation id="9022540553404839453">Shuttle komanda iesaka pārskatīt šo paplašinājumu.</translation>
<translation id="5410799103647685860">Kad vietnē tiek piedāvāts privāti iepriekš ielādēt saites lapā, pārlūks Shuttle izmanto Google serverus. Tādējādi jūsu identitāte tiek slēpta no iepriekš ielādētās lapas īpašniekiem, taču Google uzzina, kādas lapas tiek iepriekš ielādētas.</translation>
<translation id="1051793555070215510">Palīdziet mums uzlabot pārlūkošanu inkognito režīmā, aizpildot šo vienas minūtes aptauju.</translation>
<translation id="1065672644894730302">Jūsu preferences nevar nolasīt. Dažas funkcijas var nebūt pieejamas, un preferenču izmaiņas netiks saglabātas</translation>
<translation id="2526735598866766848">Viens no jūsu vecākiem ir izslēdzis iestatījumu “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam Shuttle.</translation>
<translation id="4554538601245550915">Lai meklētu konkrētu Shuttle funkciju vai paplašinājumu, adreses joslā ievadiet tā saīsni un pēc tam nospiediet izvēlēto īsinājumtaustiņu</translation>
<translation id="1098493699368672217">Rādīt meklēšanu pārlūkā Chromium sistēmas teknē un ieslēgt īsinājumtaustiņu</translation>
<translation id="1104942323762546749">Pārlūkā Chromium tiek mēģināts eksportēt jūsu paroles. Lai to atļautu, ievadiet savu Windows paroli.</translation>
<translation id="112640046208448578">Varat identificēt priekšmetus vai vietas un kopēt vai tulkot tekstu. Kad izmantojat funkciju Attēlu meklēšana, uz serveri tiek nosūtīts lapas ekrānuzņēmums. <ph name="LEARN_MORE" /></translation>
<translation id="5857101132283857610">Jūsu noklusējuma pārlūks ir Shuttle.</translation>
<translation id="1131805035311359397">Lai pārbaudītu, vai jūsu paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Chromium<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Noklikšķiniet uz Chromium izvēlnes</translation>
<translation id="1157985233335035034">Nesen izmantotās valodas</translation>
<translation id="1184145431117212167">Instalēšana neizdevās, jo jūsu izmantotā Windows versija netiek atbalstīta.</translation>
<translation id="2517811539192985920">Par Shuttle</translation>
<translation id="1186645291482254714">Brīdinājumu saņemšana par cenu izsekošanu, izmantojot pārlūku Chromium savā tālrunī</translation>
<translation id="1203500561924088507">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē pārlūkprogramma.</translation>
<translation id="1232234696885483911">Kad atvērsiet attēlu meklēšanu, serverim tiks automātiski nosūtīts lapas nosaukums, vietrādis URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">Kamēr esat pierakstījies, pārlūkā Chromium varat izmantot savas paroles un citu saturu no Google konta. Lai to mainītu, pārejiet uz sadaļu “Jūsu konts pārlūkā Chromium”.</translation>
<translation id="1244381985120794049">Rādīt Gemini pārlūkā Chromium Mac izvēļņu joslā</translation>
<translation id="1257483544893909270">Lai pakalpojumā Gemini pārlūkā Chromium atlasītu ekrāna daļu, izmantojiet īsinājumtaustiņu.</translation>
<translation id="1262876892872089030">Kamēr šī cilne bija neaktīva, tika atbrīvota atmiņa pārlūka Chromium ātrākai darbībai. Varat izvēlēties vienmēr saglabāt šo vietni aktīvu.</translation>
<translation id="5920228800659800735">Pārlūkā Shuttle šī lejupielāde tika bloķēta, jo fails ir bīstams.</translation>
<translation id="126567311906253476">Ja pierakstāties Google pakalpojumos, piemēram, Gmail vai YouTube, ar kontu <ph name="USER_EMAIL" />, varat automātiski pierakstīties pārlūkā Chromium ar to pašu kontu.</translation>
<translation id="1287534462498555020">Iegūstiet pārlūku Chromium savā tālrunī</translation>
<translation id="1290883685122687410">Iestatīšanas kļūda: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Jaunā Chromium profila iestatīšana</translation>
<translation id="132092532143527429">Izmēģināt, izmantojot Gemini pārlūkā Chromium</translation>
<translation id="7886367104480106107">Pārlūkam Shuttle ir nepieciešama Bluetooth piekļuve, lai atrastu Bluetooth ierīces. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">Pierakstieties pārlūkā Chromium savā tālrunī</translation>
<translation id="1330562121671411446">Valodas noteikšana</translation>
<translation id="1342274909142618978">Dzēst arī datus no pārlūka Chromium (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana, izmantojot jauno pogu rīkjoslā.</translation>
<translation id="1356661055722410047">Jaunums! Varat tulkot gan ekrānā redzamo tekstu, gan attēlus.</translation>
<translation id="1383876407941801731">Meklēt</translation>
<translation id="1388276868779258475">Izmantojiet lietotni Chromium, lai turpinātu pārlūkošanu, atrodoties ceļā</translation>
<translation id="141901961143729572">Dalieties domās!</translation>
<translation id="1958991777362218128">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Shuttle.</translation>
<translation id="1478370723027452770">Saņemt palīdzību saistībā ar Chrome for Testing</translation>
<translation id="1497802159252041924">Instalēšanas kļūda: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Šī lapa ir aizsargāta</translation>
<translation id="8079206111514107729">Shuttle cilnes kopīgošana</translation>
<translation id="154404805518949443">Pierakstīties pārlūkā Chromium</translation>
<translation id="1547469039832541117">Tiek pabeigts atzīmētais uzdevums.</translation>
<translation id="5481132473679919711">Piespraust pārlūku Shuttle</translation>
<translation id="1574377791422810894">Chromium drošības rīki</translation>
<translation id="1594928384848033697">Chromium pieprasa dzēst jūsu paroļu pārvaldnieka datus. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="9144100729492133749">{COUNT,plural, =0{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Shuttle.}=1{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Shuttle. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Shuttle. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Shuttle. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Shuttle. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="1623563412065267963">Izmantojiet pārlūku Chromium savā tālrunī, lai pilnvērtīgi izmantotu Google piedāvātās iespējas</translation>
<translation id="1625909126243026060">Pārskatiet svarīgākās konfidencialitātes un drošības vadīklas pārlūkā Chromium.</translation>
<translation id="1640672724030957280">Notiek lejupielāde...</translation>
<translation id="1665602916345474427">Veikta pierakstīšanās kā lietotājam <ph name="USER_NAME" /> (<ph name="USER_EMAIL" />), un jums ir abonements. Atvērt konta izvēlni</translation>
<translation id="5133024692341945870">Varat izmantot pārlūku Shuttle ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs. Tas arī tiks piesprausts uzdevumu joslai.</translation>
<translation id="1709772298389099340">Nodrošina augstas privilēģijas pārlūkam <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Tādējādi varēsiet atlasīt kādu no pieejamām ierīcēm un parādīt tajā saturu.</translation>
<translation id="5930953237660560582">Pārlūkā Shuttle drīz tiks dzēsti pārlūkošanas dati</translation>
<translation id="1736443181683099871">Pārlūkā Chromium tiks mēģināts navigācijai izmantot HTTPS.</translation>
<translation id="3225043540098941089">Shuttle dati dzēsti</translation>
<translation id="1745121272106313518">Pārlūks Chromium tiks restartēts pēc: <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Ja HTTPS nav pieejams, pārlūkā Chromium bez brīdinājuma tiks izmantots nedrošs savienojums.</translation>
<translation id="4139175757782872962">Ļaut Shuttle darboties fonā</translation>
<translation id="1779356040007214683">Lai uzlabotu Chromium drošību, mēs atspējojām dažus paplašinājumus, kas nav norādīti vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienoti, jums nezinot.</translation>
<translation id="1793486931176048546">Windows paziņojumā noklikšķiniet uz <ph name="BEGIN_BOLD" />Jā<ph name="END_BOLD" />, lai piespraustu pārlūku Chromium uzdevumu joslai, tādējādi nodrošinot ātru piekļuvi.</translation>
<translation id="6621264839978531733">Pārinstalēt Shuttle</translation>
<translation id="1820835682567584003">Chromium mēģina <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku Chromium, tiks parādīts aicinājums izmantot Google paroļu pārvaldnieku.</translation>
<translation id="1838374766361614909">Notīrīt meklēšanas vaicājumu</translation>
<translation id="18552579716432081">Lai dzēstu pārlūkošanas datus tikai no šīs ierīces un paturētu tos Google kontā, <ph name="BEGIN_LINK" />izrakstieties no Chromium<ph name="END_LINK" />.</translation>
<translation id="1857749206890802997">Lejupielādējiet pārlūku Chromium savā tālrunī, lai atvērtu vai izveidotu jaunas ciļņu grupas, atrodoties ceļā.</translation>
<translation id="185970820835152459">Varat pārvaldīt Google kontus, kuros esat pierakstījies. Jūsu Google konti tiek izmantoti pārlūkā Chromium, Play veikalā, pakalpojumā Gmail un citur. Ja vēlaties pievienot kontu kādam citam, piemēram, ģimenes loceklim, pievienojiet jaunu personu savai <ph name="DEVICE_TYPE" /> ierīcei. <ph name="LINK_BEGIN" />Uzziniet vairāk<ph name="LINK_END" />.</translation>
<translation id="1862852878885210965">Meklēšana, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="1863837059069884561">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Chromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt grāmatzīmēm un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Atlasīt tekstu</translation>
<translation id="1881322772814446296">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Chromium dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. Ja vēlaties, varat izveidot jaunu profilu, lai atsevišķi glabātu Chromium datus. <ph name="LEARN_MORE" /></translation>
<translation id="1305483712531564950">Pārlūkā Shuttle tiek taupīta akumulatora enerģija, ierobežojot darbības fonā un vizuālos efektus, piemēram, vienmērīgu ritināšanu un video kadru nomaiņas ātrumu. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par enerģijas taupīšanas režīmu<ph name="END_LINK" />.</translation>
<translation id="1900969832270057921">Chromium atjauninātāja pakalpojums</translation>
<translation id="1911763535808217981">Ja izslēgsiet šo iestatījumu, varēsiet pierakstīties Google vietnēs, piemēram, pakalpojumā Gmail, nepierakstoties pārlūkā Chromium.</translation>
<translation id="1929939181775079593">Chromium nereaģē. Vai restartēt to tūlīt?</translation>
<translation id="1933341829955786215">Saskaņā ar jūsu organizācijas (<ph name="MANAGER" />) politiku jums ir jāpierakstās pārlūkā Chromium.</translation>
<translation id="193439633299369377">Chromium OS ir jārestartē, lai lietotu atjauninājumu.</translation>
<translation id="4872059215343855880">Pārlūkā Shuttle šī lejupielāde tika bloķēta, jo šī tipa faili parasti netiek lejupielādēti un var būt bīstami.</translation>
<translation id="1953553007165777902">Notiek lejupielāde... Atlikušais laiks: <ph name="MINUTE" /> minūte(-es).</translation>
<translation id="1220136003951684816">Shuttle nevar noteikt vai iestatīt noklusējuma pārlūku.</translation>
<translation id="197326043290947695">Viedāka pārlūkošana, izmantojot attēlu meklēšanu</translation>
<translation id="1990262977744080398">Uzzināt, kāpēc pārlūkā Chromium daži faili tiek bloķēti (saite tiks atvērta jaunā cilnē)</translation>
<translation id="1999715455684970349">Nodrošina Chromium programmatūras pastāvīgu atjaunināšanu. Ja šis pakalpojums tiks atspējots vai pārtraukts, jūsu Chromium programmatūra netiks pastāvīgi atjaunināta, kas nozīmē, ka nebūs iespējams labot drošības ievainojamības, ja tādas radīsies, turklāt var nedarboties funkcijas. Šis pakalpojums pats tiek atinstalēts, ja neviena Chromium programmatūra to neizmanto.</translation>
<translation id="2008474315282236005">Veicot šo darbību, no šīs ierīces tiks dzēsts 1 vienums. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Chromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalēšana neizdevās. Lūdzu, mēģiniet vēlreiz.</translation>
<translation id="2039417478970545937">Iestatījumi.</translation>
<translation id="2049376729098081731">Izvēlieties, vai iekļaut Chromium vēsturi, lai iegūtu personalizētākas iespējas Google pakalpojumos.</translation>
<translation id="2050698962207788467">Iebūvēts pārlūkā Chromium, lai palīdzētu jums izveidot, saglabāt un automātiski aizpildīt drošas paroles. Pievienojiet saīsni ērtai piekļuvei.</translation>
<translation id="2064856577282482477">Jaunas cilnes lapā noklikšķiniet uz pogas Pielāgot Chromium, lai piešķirtu pārlūkam Chromium jaunu izskatu.</translation>
<translation id="4748815521068816647">Pārlūkā Shuttle šī lejupielāde tika bloķēta, jo fails ir maldinošs un var veikt neparedzētas izmaiņas jūsu ierīcē.</translation>
<translation id="208726765006323911">Kad nākamreiz iOS ierīcē atvērsiet pārlūku Chromium, tiks parādīts aicinājums izmēģināt funkciju <ph name="FEATURE_NAME" />.</translation>
<translation id="2099452623287920103">Jūsu paroles un citi Chromium dati, ko saglabājāt savā Google kontā, tiks noņemti no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā Chromium, atkārtoti pierakstieties.</translation>
<translation id="8053870167789043907">{COUNT,plural, =1{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Shuttle nav izmantots vienu minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}zero{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Shuttle nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}one{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Shuttle nav izmantots # minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}other{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Shuttle nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}}</translation>
<translation id="2125838419757773031">Lai meklētu, atlasiet ekrāna apgabalu</translation>
<translation id="2126108037660393668">Neizdevās verificēt lejupielādēto failu.</translation>
<translation id="2135919691573380097">Ziņošana par šo vietni</translation>
<translation id="2137162749895930932">Aizvērt tulkošanas ekrānu</translation>
<translation id="8598177558941030115">Pārlūkā Shuttle šī lejupielāde tika bloķēta, jo vietnē netiek izmantots drošs savienojums un, iespējams, failā ir veiktas izmaiņas.</translation>
<translation id="2170098639895543546">Atlasīt jebkādu saturu lapā</translation>
<translation id="2174178932569897599">Pielāgot pārlūkprogrammu Chromium</translation>
<translation id="2174917724755363426">Instalēšana nav pabeigta. Vai tiešām vēlaties atcelt?</translation>
<translation id="2629211622516729574">Shuttle — pierakstīšanās tīklā — <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Atjauninājumu pārbaudes kļūda: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Noņemt kontu no pārlūka Chromium</translation>
<translation id="2201788217099588893">Izmantojiet lietotni Chromium, lai piekļūtu vislabākajiem iepirkšanās rīkiem, atrodoties ceļā</translation>
<translation id="2210502920229141283">Saņemiet labāku aizsardzību, atrodoties ceļā, ar funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā Chromium operētājsistēmai iOS.</translation>
<translation id="2210682093923538346">Bīstama vietne. Pārlūkā Chromium tika noņemti paziņojumi.</translation>
<translation id="2236949375853147973">Manas darbības</translation>
<translation id="2238130810669087193">Pierakstieties pārlūkā Chromium, lai varētu piekļūt adresēm un citiem datiem visās savās ierīcēs. Šī adrese tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="2241627712206172106">Ja jūsu datoru izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Chromium atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos kontos.</translation>
<translation id="22571759390241347">Prasmes pārlūkā Chromium</translation>
<translation id="2283803047247799269">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Chromium iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{Chromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{Chromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{Chromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="2307973900865360088">Paturēt dokā</translation>
<translation id="2313870531055795960">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Chromium. Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Chromium var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2356070529366658676">Vaicāt</translation>
<translation id="2359808026110333948">Turpināt</translation>
<translation id="2361918034042471035">Paplašinājums “<ph name="EXTENSION_NAME" />” pieprasa, lai jūs pierakstītos pārlūkā Chromium</translation>
<translation id="2875952783855795871">Atspējot Shuttle darbību fonā lietotnēm</translation>
<translation id="2374216753258219393">Lai izmantotu šo paplašinājumu kontā <ph name="USER_EMAIL_ADDRESS" />, pierakstieties pārlūkā Chromium.</translation>
<translation id="2384373936468275798">Chromium OS nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="2792662518458751900">{NUM_DEVICES,plural, =0{Vismaz viens Shuttle paplašinājums piekļuva 1 HID ierīcei}=1{Vismaz viens Shuttle paplašinājums piekļūst 1 HID ierīcei}zero{Vismaz viens Shuttle paplašinājums piekļūst # HID ierīcēm}one{Vismaz viens Shuttle paplašinājums piekļūst # HID ierīcei}other{Vismaz viens Shuttle paplašinājums piekļūst # HID ierīcēm}}</translation>
<translation id="2401032172288869980">Pārlūkam Chromium ir nepieciešama atļauja izmantot kameru un mikrofonu šajā vietnē.</translation>
<translation id="2403703063067034158">Palaišanas kļūda: pašlaik ir aktīvs cits iestatīšanas process. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="2418322681019544463">Atveriet saites pārlūkā Chromium no jebkuras lietotnes un saglabājiet pārlūku pieejamu uzdevumu joslā.</translation>
<translation id="2425157128016763890">Noklikšķiniet uz pogas Apkopot, lai kopīgotu šo dokumentu ar Gemini pārlūkā Chromium, iegūtu īsu kopsavilkumu un uzdotu papildu jautājumus.</translation>
<translation id="2440750600860946460">Izmantojot <ph name="BEGIN_LINK" />Chromium rīkus<ph name="END_LINK" />, varat droši pārlūkot saturu un pārvaldīt jums pieejamās iespējas.</translation>
<translation id="2449487342837813167">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Chromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2451727308784734061">Izmantojot saīsni, varat ātri piekļūt Google paroļu pārvaldniekam. Varat pārvietot saīsni uz datora sākuma ekrānu vai lietotņu palaidēju.</translation>
<translation id="2236435189491185832">Shuttle drīz tiks aizvērts</translation>
<translation id="8393832920806146440">Pārlūkā Shuttle</translation>
<translation id="2485422356828889247">Atinstalēt</translation>
<translation id="2513154137948333830">Nepieciešama atkārtota palaišana: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Atlasiet tekstu, ko meklēt, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="2554739539410784893">Pārlūkā Chromium tiek mēģināts aizstāt esošās paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="2560420686485554789">Pārlūkam Chromium ir nepieciešama piekļuve krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="2562045627058601347">Shuttle palīgs</translation>
<translation id="2575822587468774919">Atlasiet jebko, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="2576118232315942160">Pierakstieties pārlūkā Chromium, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2587622539943955767">Skenējiet kvadrātkodu, izmantojot tālruni, lai lejupielādētu pārlūku Chromium un pierakstītos savā Google kontā.</translation>
<translation id="4702236029576678227">Turpināt lietot Shuttle</translation>
<translation id="259935314519650377">Lejupielādēto instalēšanas programmu neizdevās saglabāt kešatmiņā. Kļūda: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistēma</translation>
<translation id="2629740064077610681">Jūsu organizācija var skatīt un pārvaldīt pārlūkošanas datus, piemēram, grāmatzīmes, vēsturi un paroles. Tā nevar skatīt pārlūkošanas datus citos Chromium profilos.</translation>
<translation id="2635452620547538388">Lai izmantotu un saglabātu Chromium datus savā kontā (<ph name="ACCOUNT_EMAIL" />), apstipriniet savu identitāti.</translation>
<translation id="8493546940144832853">{COUNT,plural, =0{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Shuttle ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots.}=1{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Shuttle ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. Inkognito režīma logs netiks atkārtoti atvērts.}zero{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Shuttle ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logi netiks atkārtoti atvērti.}one{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Shuttle ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logs netiks atkārtoti atvērts.}other{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Shuttle ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="263863604136125912">Startēt Chromium</translation>
<translation id="2648074677641340862">Instalācijas laikā radās operētājsistēmas kļūda. Lejupielādējiet Chromium vēlreiz.</translation>
<translation id="2661879430930417727">Ja ierīci izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Chromium atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos profilos.</translation>
<translation id="2676569452213089702">Ērti piekļūstiet pakalpojumam Gemini pārlūkā Chromium savā ierīcē, pat ja pārlūka Chromium logs ir minimizēts.</translation>
<translation id="1290871231853377661">Shuttle cilne</translation>
<translation id="2718390899429598676">Papildu drošības nolūkos Chromium šifrēs jūsu datus.</translation>
<translation id="2721354645805494590">Lai noņemtu savu Google kontu no pārlūka Chromium, izrakstieties.</translation>
<translation id="2722636413143664436">Pierakstieties pārlūkā Chromium, lai varētu piekļūt parolēm, grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2738871930057338499">Nevar izveidot savienojumu ar internetu. HTTP 403 — aizliegts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="2753623023919742414">Noklikšķiniet, lai meklētu</translation>
<translation id="8088988796099973210">Iestatiet Shuttle kā noklusējuma PDF failu skatītāju.</translation>
<translation id="2218752565776962982">Šis paplašinājums satur ļaunprātīgu programmatūru un nav drošs. Noņemiet to no pārlūka Shuttle, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="2799223571221894425">Restartēt</translation>
<translation id="7485171825548475983">Jūsu Shuttle</translation>
<translation id="2816462166102338036">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="282591729717417030">Izmantojiet pārlūku Chromium operētājsistēmā iOS, lai atklātu produktus, izmantojot kameru, izsekotu cenu samazinājumam un veiktu citas darbības, atrodoties ceļā</translation>
<translation id="2841525013647267359">Tulkot no šādas valodas:</translation>
<translation id="2846251086934905009">Instalēšanas kļūda: instalēšanas programma nepabeidza darbu. Instalēšana ir priekšlaikus pārtraukta.</translation>
<translation id="2847479871509788944">Noņemšana no pārlūka Chromium...</translation>
<translation id="2850691299438350830">Tiek nodrošināta jūsu aizsardzība pārlūkprogrammā Chromium. Šis režīms var tikt izmantots jūsu drošības uzlabošanai citās Google lietotnēs, kad esat pierakstījies.</translation>
<translation id="2885378588091291677">Uzdevumu pārvaldnieks</translation>
<translation id="4736743449957355772">Par &amp;Shuttle</translation>
<translation id="2915996080311180594">Restartēt vēlāk</translation>
<translation id="2933336679234709858">Jūsu dati ir šifrēti, izmantojot ieejas frāzi. Ievadiet ieejas frāzi, lai izmantotu un saglabātu Chromium datus savā Google kontā.</translation>
<translation id="2945997411976714835">Instalēšanas kļūda: neizdevās palaist instalēšanas programmu.</translation>
<translation id="2948852018303413228">Ātrāk pierakstieties vietnēs, izmantojot saglabātās paroles pārlūkam Chromium operētājsistēmā iOS.</translation>
<translation id="5394294335480248696">Pārlūku Shuttle pārvalda jūsu organizācija</translation>
<translation id="6474149732639814113">Shuttle ir atjaunināts</translation>
<translation id="2977506796191543575">Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Chromium var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2981563588585023386">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pierakstieties pārlūkā Chromium</translation>
<translation id="3003694935412297923">Visi uzdevumi</translation>
<translation id="3012615494352020668">{count,plural, =1{Pārlūkā Chromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Pārlūkā Chromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Pārlūkā Chromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienums) tiks dzēsti.}other{Pārlūkā Chromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="6798600078593703276">Atveriet vietrādi <ph name="URL" /> jaunā cilnē pārlūkā Shuttle.</translation>
<translation id="302551344979399011">MI inovācijas, piemēram, prasmes, tiek saglabātas jūsu Google kontā un pārvaldītas atsevišķi no Chromium sinhronizācijas.</translation>
<translation id="2572386815899642990">Notiek pievienošana pārlūkam Shuttle...</translation>
<translation id="3038232873781883849">Gaida, lai instalētu...</translation>
<translation id="3045032126857188731">Tulkojuma valoda: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Aizvērt atsauksmju dialoglodziņu</translation>
<translation id="3068187312562070417">Citi Chromium profili</translation>
<translation id="3068290154869370196">Paplašinājumi ir papildinājumi, kas ļauj pielāgot pārlūku Chromium. Paplašinājumi palīdz jums pielāgot pārlūku Chromium, sākot no darba organizēšanas līdz ikdienas uzdevumu vienkāršošanai.</translation>
<translation id="1841107660132296794">Palīdzēt uzlabot Shuttle, nosūtot Google serveriem avāriju pārskatus un <ph name="UMA_LINK" /></translation>
<translation id="3071024987058544609">Izmantojiet lietotni Chromium, lai piekļūtu Google drošības iespējām, atrodoties ceļā</translation>
<translation id="3739686665197813096">{NUM_DEVICES,plural, =0{Vismaz viens Shuttle paplašinājums piekļuva 1 USB ierīcei}=1{Vismaz viens Shuttle paplašinājums piekļūst 1 USB ierīcei}zero{Vismaz viens Shuttle paplašinājums piekļūst # USB ierīcēm}one{Vismaz viens Shuttle paplašinājums piekļūst # USB ierīcei}other{Vismaz viens Shuttle paplašinājums piekļūst # USB ierīcēm}}</translation>
<translation id="2502156653706673977">Shuttle vēsture</translation>
<translation id="3103660991484857065">Instalēšanas programmai neizdevās atarhivēt arhīvu. Lejupielādējiet Chromium vēlreiz.</translation>
<translation id="310459126943037700">Neizdevās pabeigt uzdevumus.</translation>
<translation id="3104828284009500087">Meklēt jebkādu informāciju lapā</translation>
<translation id="3126784891977756556">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs. Ērti piekļūstiet zināmajām un iecienītajām funkcijām, atjauninot noklusējuma pārlūku uz Chromium.</translation>
<translation id="1074920430236894401">Pārlūkā Shuttle tiek izmantots jūsu mikrofons.</translation>
<translation id="3130333203120345554">Jauns meklējums</translation>
<translation id="3137969841538672700">Velciet, lai meklētu</translation>
<translation id="3144188012276422546">Šī cilne izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Chromium padarīt to neaktīvu.</translation>
<translation id="6825554846760229393">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Shuttle.</translation>
<translation id="3761350857202901706">Restartēt Shuttle</translation>
<translation id="3161522574479303604">Visas valodas</translation>
<translation id="3179665906251668410">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="3185330573522821672">Pielāgojiet savu jauno Chromium profilu.</translation>
<translation id="3189205223539394158">Varat turpināt tērzēšanu MI režīmā, nepārslēdzot cilnes. Lai sāktu darbu, pierakstieties pārlūkā Chromium. Jūs arī varēsiet piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="3224847870593914902">Lai noņemtu savu Google kontu no pārlūka Chromium, lapā “Iestatījumi” izrakstieties no pārlūka Chromium.</translation>
<translation id="3234316605225071811">Vēlāk pārlūkā Chromium var tikt vaicāts, vai vēlaties izmantot saglabāto informāciju veidlapu automātiskai aizpildei.</translation>
<translation id="9058828139997344018">Shuttle nevar nolasīt savu datu direktoriju un ierakstīt tajā:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">Izmantojiet pārlūku Chromium operētājsistēmā iOS, lai piekļūtu saviem iecienītākajiem Google MI rīkiem, atrodoties ceļā.</translation>
<translation id="3286538390144397061">Restartēt tūlīt</translation>
<translation id="8765302055862543686">Trūkst Google API atslēgu. Tiks atspējotas dažas Shuttle funkcijas.</translation>
<translation id="4826503398521877963">Turpināt lietotņu izpildi fonā, kad Shuttle ir aizvērts</translation>
<translation id="3313189106987092621">Pārlūkā Chromium tiks parādīts brīdinājums pirms jebkuras vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="3316771292331273802">Aizverot visus Chromium logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Google konta, ja esat pierakstījies pārlūkā Chromium. Lai atļautu vietnēm jūs atcerēties, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">meklēšanas apgabala augšējais labais stūris: <ph name="RIGHT" />% pa labi, <ph name="TOP" />% augšdaļā</translation>
<translation id="3366305173356742781">Chromium dati jūsu kontā</translation>
<translation id="3375770072980084583">Izmantojiet savas paroles pārlūkā Chromium savā tālrunī</translation>
<translation id="3387527074123400161">Chromium OS</translation>
<translation id="3406848076815591792">Vai pāriet uz esošo Chromium profilu?</translation>
<translation id="3412460710772753638">Tā tiks atjaunināta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="3438772217992559640">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="3455907671758333080">Izmantojiet funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā Chromium savā tālrunī</translation>
<translation id="3461644266919055473">Notiek Chromium pielāgošana…</translation>
<translation id="3474745554856756813">Veicot šo darbību, no šīs ierīces tiks dzēsts(-i) <ph name="ITEMS_COUNT" /> vienums(-i). Lai vēlāk izgūtu datus, pierakstieties pārlūkā Chromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">Lai pārslēgtos starp Chromium profiliem, izmantojiet īsinājumtaustiņu <ph name="SHORTCUT" />.</translation>
<translation id="3509308970982693815">Aizveriet visus Chromium logus un mēģiniet vēlreiz.</translation>
<translation id="5876629139177327931">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Shuttle.</translation>
<translation id="3530103706039034513">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />.  Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Chromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3531741627422851418">Kvadrātkods pārlūka Chromium lejupielādei mobilajās ierīcēs</translation>
<translation id="354621070532799440">Atgādinājums: Google labākās drošības funkcijas vienmēr par rokai</translation>
<translation id="2337565425943560376">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Shuttle.</translation>
<translation id="4821889377524170187">Izmantojot uzlaboto aizsardzību, tiek izslēgta JavaScript optimizācija vietnēm, ko Shuttle neatpazīst.</translation>
<translation id="3597003331831379823">Neizdevās izpildīt iestatīšanu ar augstām privilēģijām. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3600428265489994557">Pierakstīšanās pārlūkā Chromium</translation>
<translation id="3639635944603682591">Šī lietotāja pārlūkošanas dati tiks dzēsti no šīs ierīces. Lai atkoptu datus, pierakstieties pārlūkprogrammā Chromium kā lietotājs <ph name="USER_EMAIL" />.</translation>
<translation id="1300475218926632111">{COUNT,plural, =0{Pieejams Shuttle atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku.}=1{Pieejams Shuttle atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Pieejams Shuttle atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Pieejams Shuttle atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Pieejams Shuttle atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="3667616615096815454">Nevar instalēt. Lietojumprogramma serverim nav zināma.</translation>
<translation id="3675854891107786059">Izmantot jūsu <ph name="BEGIN_LINK" />ieejas frāzi<ph name="END_LINK" /> visu Chromium datu šifrēšanai jūsu Google kontā. Maksājumu veidi un adreses no pakalpojuma Google Pay netiks šifrētas. Pārlūkā Chromium saglabātā pārlūkošanas vēsture netiks sinhronizēta.</translation>
<translation id="5274497473086430153">{COUNT,plural, =0{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Shuttle.}=1{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Shuttle. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Shuttle. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Shuttle. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Shuttle. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="6123757042710639920">Atvērt saiti jaunā Shuttle &amp;cilnē</translation>
<translation id="3728124580182886854">Saistiet pārlūku Chromium un citus Google pakalpojumus personalizēšanai un citiem mērķiem</translation>
<translation id="3729187154190517324">Padziļiniet meklēšanu, izmantojot pogu “Pievienot cilni un citu kontekstu”, lai pievienotu vairākas cilnes, failus un rīkus.</translation>
<translation id="3788675262216168505">Pārvaldīt Chromium profilus</translation>
<translation id="4583231988142868515">Uzziniet, kāpēc Shuttle bloķē noteiktas lejupielādes</translation>
<translation id="379589255253486813">Ja kaut kas būs jāpārskata, saņemsiet Chromium paziņojumu</translation>
<translation id="9161544906744429402">Pārlūkā Shuttle tiek iepriekš ielādētas lapas, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="3810973564298564668">Pārvaldīt</translation>
<translation id="3823384748599722168">Lai izmantotu savas saglabātās paroles, izmantojiet saiti kvadrātkodā, lejupielādējiet pārlūku Chromium operētājsistēmai iOS un pierakstieties savā Google kontā.</translation>
<translation id="3846683726093018685">**Apkopošana:** vienā teikumā, kas nepārsniedz 30 vārdus, aprakstiet ekrānuzņēmumā redzamā satura galveno tēmu un nolūku.

          **Jautājumu ieteikšana:** ģenerējiet sarakstu ar aizzīmēm ar 3–5 jautājumiem, kas liek aizdomāties un kurus lietotājs varētu uzdot, lai labāk izprastu ekrānuzņēmumu. Šajos jautājumos ir jābūt vismaz vienam jautājumam, kas ir saistīts ar vizuālu objektu, tā dizainu vai izvietojumu.</translation>
<translation id="4250996466392346267"><ph name="PAGE_TITLE" /> — Shuttle</translation>
<translation id="387514319934708384">Pārlūkam Chromium ir nepieciešama atļauja izmantot lokālo tīklu šajā vietnē.</translation>
<translation id="3885770153807205175">Valodas atlasītājs</translation>
<translation id="3870879982795295801">Pielāgojiet un kontrolējiet pārlūkprogrammu Shuttle. Ir nepieciešama jūsu uzmanība. Noklikšķiniet, lai skatītu plašāku informāciju.</translation>
<translation id="3889543394854987837">Noklikšķiniet uz sava vārda, lai atvērtu Chromium un sāktu pārlūkošanu.</translation>
<translation id="3892148308691398805">Kopēt tekstu</translation>
<translation id="390528597099634151">Lietotājs <ph name="EXISTING_USER" /> jau ir pierakstījies šajā Chromium profilā. Lai atdalītu pārlūkošanu, pārlūkā Chromium varat sev izveidot atsevišķu profilu.</translation>
<translation id="2803413259281481072">Šis paplašinājums pārkāpj Chrome interneta veikala politiku, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Shuttle, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="3941890832296813527">Instalēšanas kļūda: instalēšanas programmas faila nosaukums nav derīgs vai netiek atbalstīts.</translation>
<translation id="3945058413678539331">Chromium mēģina nokopēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="3954172517175569325">Jūsu Google kontā saglabātās paroles, maksājuma veidi un adreses tiks noņemtas no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā Chromium, atkārtoti pierakstieties.</translation>
<translation id="395904275706073188">Aizsargātas lapas nevar lasīt. Izmēģiniet citu lapu.</translation>
<translation id="3962647064319009959">Uzziniet, kā Chromium rūpējas par jūsu drošību</translation>
<translation id="3967822245660637423">Lejupielāde pabeigta</translation>
<translation id="8478344872731892094">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Shuttle nosūta rakstīto tekstu jūsu organizācijas meklēšanas, MI un starpnieku rīkiem, lai iegūtu ieteikumus.</translation>
<translation id="3975724895399328945">Par Google Chrome for Testing</translation>
<translation id="3997429360543082038">Par Chromium OS</translation>
<translation id="1813754478883624120">Kad apmeklējat kādu vietni, pārlūks Shuttle nosūta funkcijai <ph name="BEGIN_LINK" />Google droša pārlūkošana<ph name="END_LINK" /> pieslēptu URL daļu, izmantojot konfidencialitātes serveri, kas slēpj jūsu IP adresi. Ja vietnē tiek veiktas aizdomīgas darbības, tiek nosūtīti arī pilni URL un lapas satura fragmenti.</translation>
<translation id="4016217212818346953">Gādājiet par drošību, izmantojot paroļu pārvaldnieku</translation>
<translation id="4019629340646866719">Chromium OS, kā arī <ph name="BEGIN_LINK_LINUX_OSS" />Linux izstrādes vides<ph name="END_LINK_LINUX_OSS" /> darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="4022972681110646219">Tulkot ekrāna tekstu</translation>
<translation id="4023601594785368013">Oriģinālvaloda: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Atveriet saites pārlūkā Chromium no jebkuras lietotnes. Turklāt pārlūks tiks piesprausts uzdevumjoslā, lai nodrošinātu ērtāku piekļuvi.</translation>
<translation id="3334942702828280015">Palīdziet uzlabot pārlūku Shuttle, ziņojot par <ph name="BEGIN_LINK" />pašreizējiem iestatījumiem<ph name="END_LINK" />.</translation>
<translation id="4050175100176540509">Jaunākajā versijā ir pieejami svarīgi drošības uzlabojumi un jaunas funkcijas.</translation>
<translation id="4055805654398742145">P&amp;aroļu pārvaldnieks</translation>
<translation id="4210170830543121132">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Shuttle, ja tas nav izmantots vienu minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}zero{Jūsu organizācija automātiski aizver pārlūku Shuttle, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}one{Jūsu organizācija automātiski aizver pārlūku Shuttle, ja tas nav izmantots # minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}other{Jūsu organizācija automātiski aizver pārlūku Shuttle, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}}</translation>
<translation id="4118474109249235144">Chromium inkognito režīms</translation>
<translation id="4122186850977583290">Pāriet uz lapu “Par Chromium”</translation>
<translation id="4135244987012252068">Pielāgojiet pārlūku Chromium, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="4147856324248078748">P&amp;ielāgot pārlūku Chromium</translation>
<translation id="4148957013307229264">Notiek instalēšana...</translation>
<translation id="6643591336183767153"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā — Shuttle</translation>
<translation id="8999328492520314624">Atklājiet lieliskas lietotnes, spēles, paplašinājumus un motīvus, ko varat izmantot pārlūkā Shuttle.</translation>
<translation id="4217080900579554343">Lai piekļūtu šim paplašinājumam un citiem datiem visos savos datoros, pierakstieties pārlūkā Chromium.</translation>
<translation id="4217972271355023382">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pārslēdzieties uz Chromium profilu, kurā jau pierakstījāties ar kontu <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="4222932583846282852">Notiek atcelšana...</translation>
<translation id="4224210481850767180">Instalēšana ir atcelta.</translation>
<translation id="4230135487732243613">Vai saistīt Chromium datus ar šo kontu?</translation>
<translation id="2078444352649860973">Tiek rādīts brīdinājums par bīstamām vietnēm (pat ja Google par tām iepriekš nezināja), analizējot vairāk datu no vietnēm, nekā analizē standarta aizsardzība. Varat izlaist Shuttle brīdinājumus.</translation>
<translation id="4269093074552541569">Izrakstīties no pārlūka Chromium</translation>
<translation id="5558993553168424235">Saņemt palīdzību par Shuttle</translation>
<translation id="4281844954008187215">Google pakalpojumu noteikumi</translation>
<translation id="4285930937574705105">Instalācija neizdevās nenoteiktas kļūdas dēļ. Ja Chromium šobrīd darbojas, aizveriet to un mēģiniet vēlreiz.</translation>
<translation id="4298125729853015961">Paroļu eksportēšana no pārlūka Chromium</translation>
<translation id="4304713468139749426">Paroļu pārvaldnieks</translation>
<translation id="4334241893986177674">Meklēt šajā ekrānuzņēmumā</translation>
<translation id="4368547723231502008">Meklējiet un uzdodiet jautājumus no jebkuras vietas, pat ja pārlūka Chromium logs ir minimizēts.</translation>
<translation id="5810569516587906396">Palaist pārlūku Shuttle, kad tiek palaista operētājsistēma Windows</translation>
<translation id="4400772909124543403">Neviens atjauninājums nav pieejams.</translation>
<translation id="3931397122598189404">Vai tik un tā aizvērt pārlūku Shuttle?</translation>
<translation id="4413205837991854510">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="8644661686228434842">Ļaut pārlūkam Shuttle darboties fonā</translation>
<translation id="603827111501511568">{NUM_EXTENSIONS,plural, =1{Shuttle iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}zero{Shuttle iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}one{Shuttle iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}other{Shuttle iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}}</translation>
<translation id="8695231474189911275">Pielāgot un kontrolēt Shuttle</translation>
<translation id="4427306783828095590">Uzlabotā aizsardzība labāk bloķē pikšķerēšanas mēģinājumus un ļaunprātīgu programmatūru</translation>
<translation id="4434353761996769206">Instalēšanas kļūda: <ph name="INSTALLER_ERROR" /></translation>
<translation id="3897345295068202634">Pārlūku Shuttle pārvalda organizācija “<ph name="MANAGER" />”</translation>
<translation id="444069871276811466">Pievienot Chromium profilu</translation>
<translation id="4447409407328223819">Par Chrome for Testing</translation>
<translation id="4470974262661801543">Lai izmantotu un saglabātu Chromium datus savā Google kontā, ievadiet ieejas frāzi.</translation>
<translation id="4493028449971051158">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā administrators.</translation>
<translation id="4501471624619070934">Instalēšana neizdevās, jo šajā valstī piekļuve ir ierobežota.</translation>
<translation id="7538943987967358068">Nav norādīta konfidencialitātes prakse šim paplašinājumam, piemēram, kā tas vāc un izmanto datus. Shuttle iesaka to noņemt.</translation>
<translation id="452711251841752011">Laipni lūdzam pārlūkā Chromium (tika atvērts jauns pārlūka logs)!</translation>
<translation id="4531137820806573936">Pārlūkam Chromium ir nepieciešama atļauja jūsu apkārtnes kartēšanai un roku kustību izsekošanai</translation>
<translation id="4536805923587466102">Ar kontu <ph name="USER_EMAIL_ADDRESS" /> jau esat pierakstījies citā Chromium profilā</translation>
<translation id="7291454099139632344">Pārlūkā Shuttle tiek iepriekš ielādētas lapas, tādējādi paātrinot pārlūkošanu un meklēšanu. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par lapu iepriekšēju ielādi<ph name="END_LINK" />.</translation>
<translation id="4549180975214802957">Uzlabojiet tiešsaistes drošību visiem lietotājiem, ziņojot par vietni, kas, jūsuprāt, ir kaitīga.</translation>
<translation id="4229052424516163100">Pārlūkā Shuttle šī lejupielāde tika bloķēta, jo jūs izslēdzāt drošu pārlūkošanu un failu nevar verificēt.</translation>
<translation id="4583692638088316420">Izmēģiniet Google Lens pārlūkā Chromium savā tālrunī</translation>
<translation id="4594305310729380060">Tā tiks saglabāta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="4559123577107659130">Shuttle lietotnes</translation>
<translation id="4598116752460667024">Sarakstā meklējiet jebkuru procesu.</translation>
<translation id="4613863813562375431">Chromium OS versija</translation>
<translation id="8540523969518172575">Atjaunināšana ir gandrīz pabeigta. Lai pabeigtu atjaunināšanu, atkārtoti palaidiet pārlūku Shuttle.</translation>
<translation id="2509032609305193511">Paātrina vietņu darbību, izmantojot Shuttle programmu V8, taču nedaudz samazina Shuttle izturību pret uzbrukumiem.</translation>
<translation id="4626321472657185181">Atvērt meklēšanu pārlūkā Chromium</translation>
<translation id="7601899887920501075">Brīdinājums! Shuttle nevar novērst to, ka paplašinājumi ieraksta jūsu pārlūkošanas vēsturi. Lai atspējotu šo paplašinājumu inkognito režīmā, noņemiet šīs opcijas atlasi.</translation>
<translation id="4673151026126227699">Ja kopīgojat arī Chromium lietojuma pārskatus, šajos pārskatos tiek iekļauti jūsu apmeklētie vietrāži URL.</translation>
<translation id="4673710618874938871">Veikta pierakstīšanās kā lietotājam <ph name="USER_NAME" />, un jums ir abonements. Atvērt konta izvēlni</translation>
<translation id="1081748947768053336">Šķiet, ka profils tiek izmantots citā Shuttle procesā (<ph name="PROCESS_ID" />) citā datorā (<ph name="HOST_NAME" />). Lai profils netiktu bojāts, pārlūkā Shuttle tas ir bloķēts. Ja esat pārliecināts, ka šis profils netiek izmantots citos procesos, varat to atbloķēt un restartēt pārlūku Shuttle.</translation>
<translation id="4680828127924988555">Atcelt instalēšanu</translation>
<translation id="469259825538636168">Noteikti jūsu Chromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="4708193446201257833">Kamēr esat pierakstījies, pārlūkā Chromium varat izmantot savas paroles un citu saturu no Google konta. <ph name="SHORTCUT" /> var mainīt jūsu Google pakalpojumu iestatījumus.</translation>
<translation id="4708774505295300557">Kāds iepriekš pierakstījās pārlūkā Chromium šajā datorā, izmantojot e-pasta adresi <ph name="ACCOUNT_EMAIL_LAST" />. Lūdzu, izveidojiet jaunu Chromium lietotāju, lai nošķirtu savu informāciju.</translation>
<translation id="4724676981607797757">Instalēšana neizdevās, jo radās neatbalstīta protokola kļūda.</translation>
<translation id="333286104758608669">Vai tik un tā aizvērt pārlūku Shuttle?</translation>
<translation id="4748217263233248895">Tikko tika piemērots īpašs Chromium drošības atjauninājums. Restartējiet tūlīt, un mēs atjaunosim jūsu cilnes.</translation>
<translation id="4771701986670315895">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Chromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> un vēl <ph name="COUNT" />.</translation>
<translation id="4786083865378785874">Ja pakalpojums Gemini pārlūkā Chromium ir atvērts, jaunu ciļņu izveidošanas laikā sānu panelis paliek atvērts.</translation>
<translation id="479167709087336770">Šeit tiek izmantota tāds pats pareizrakstības pārbaudītājs, kāds tiek izmantots Google meklēšanā. Pārlūkprogrammā ievadītais teksts tiek nosūtīts Google serveriem. Jebkurā brīdī varat mainīt šo darbību iestatījumos.</translation>
<translation id="4814736265800133385">Izmantot Chromium, nepierakstoties kontā</translation>
<translation id="4888717733111232871">Ienākošo savienojumu kārtula pārlūkam Chromium, lai atļautu mDNS datplūsmu.</translation>
<translation id="3854801763817831716">Atkārtoti palaist, lai atjauninātu &amp;Shuttle</translation>
<translation id="4918086044614829423">Pieņemt</translation>
<translation id="4918844574251943176">Attēls ir nokopēts</translation>
<translation id="4943838377383847465">Chromium darbojas fona režīmā.</translation>
<translation id="494490797786467921">Noklikšķiniet, lai aizvērtu Chromium pierakstīšanās dialoglodziņu</translation>
<translation id="4950660488495335294">Izmantojot Chromium profilus, varat nodalīt visu savu Chromium saturu. Izveidojiet profilus draugiem un ģimenes locekļiem vai nodaliet darba un izklaides saturu.</translation>
<translation id="4987820182225656817">Viesi var izmantot Chromium, neatstājot nekādas pēdas.</translation>
<translation id="4992938037305302429">Jūsu konts pārlūkā Chromium</translation>
<translation id="4994636714258228724">Pievienot savu kontu pārlūkā Chromium</translation>
<translation id="504699503110800016">Atvērt pārpildes izvēlni</translation>
<translation id="5074496654342756568">Piekļūstiet visām savām Google izlases vietnēm, izmantojot pārlūku Chromium savā ierīcē (<ph name="DEVICE_TYPE" />)</translation>
<translation id="5123973130450702873">Pārlūkam Chromium ir nepieciešama atļauja izsekot jūsu roku kustības.</translation>
<translation id="5141988424377517949">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Chromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="5174969993834422967">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet uz paziņojumu ikonas atrašanās vietas joslas labajā stūrī.</translation>
<translation id="5174983315706567306">Diskā nepietiek brīvas vietas.</translation>
<translation id="5187123684706427865">Chromium kontam nepieciešama atkārtota autentifikācija</translation>
<translation id="5223510345050543907">Turpiniet iesākto, izmantojot pārlūku Chromium operētājsistēmā iOS.</translation>
<translation id="5231355151045086930">Izrakstīšanās no Chromium</translation>
<translation id="5234764350956374838">Nerādīt</translation>
<translation id="5249261924633168472">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="5276305953263010518">Iegūstiet lietotni Chromium, lai saglabātu paroles, atrodoties ceļā</translation>
<translation id="6904011543478254794">Lai ieviestu veiktās izmaiņas, atkārtoti palaidiet pārlūku Shuttle.</translation>
<translation id="5286907366254680517">Noteiktā valoda</translation>
<translation id="5289287148052354622">Iegūt lietotni Chromium</translation>
<translation id="5294316920224716406">Ja veicat pārlūkošanu inkognito režīmā, pārlūkā Chromium tiks parādīts brīdinājums pirms vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="5296581118566748922">Meklēšana pārlūkā Chromium</translation>
<translation id="5313228254328109263">Chromium atjauninātājs: iekšējais pakalpojums</translation>
<translation id="5324450571874973775">Izmantojiet tās kopā ar citām Gemini funkcijām pārlūkā Chromium.</translation>
<translation id="5346389065299425353">Padziļiniet meklēšanu, pievienojot vairākas cilnes, failus un rīkus.</translation>
<translation id="5348677704241861105">Iegūstiet īsu šī dokumenta kopsavilkumu un uzdodiet jautājumus, izmantojot Gemini pārlūkā Chromium</translation>
<translation id="5352264705793813212">Pārlūkā Chromium tika atrasti daži drošības ieteikumi par jūsu atsauksmi</translation>
<translation id="5352361688875342522">Citi Chromium profili</translation>
<translation id="535243042947607642">ChromiumOS nevarēja saglabāt Chromium datus jūsu Google kontā, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="5358375970380395591">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Chromium dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Papildu kods: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Lai izmantotu personalizēšanu, iekļaujiet pārlūku Chromium iestatījumā “Darbības tīmeklī un lietotnēs”</translation>
<translation id="5382964351116519680">Atvērt meklēšanu pārlūkā Chromium</translation>
<translation id="4877717772512674872">Uzzināt, kāpēc pārlūkā Shuttle daži faili tiek bloķēti</translation>
<translation id="8341327126333983765">Notiek Shuttle atjaunināšana (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Atļaut pierakstīties pārlūkā Chromium</translation>
<translation id="2064155379595075287">Noņemt no pārlūka Shuttle</translation>
<translation id="1764424071909520660">Samazina veiktspēju, taču uzlabo Shuttle izturību pret uzbrukumiem.</translation>
<translation id="5427571867875391349">Iestatīt Chromium kā noklusējuma pārlūku</translation>
<translation id="3552564955884420948"><ph name="PAGE_TITLE" /> — Shuttle beta versija</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Chromium iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{Chromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{Chromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{Chromium iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="3837394572112225231">Iespējams, pārlūks Shuttle nedarbosies pareizi, jo tas vairs netiek atbalstīts šajā Linux izdevumā.</translation>
<translation id="2864501208955185201">Pārlūkā Shuttle šī lejupielāde tika bloķēta, jo šis fails var kaitēt jūsu personīgajiem un sociālo tīklu kontiem</translation>
<translation id="549669000822060376">Lūdzu, uzgaidiet, kamēr Chromium instalē jaunākos sistēmas atjauninājumus.</translation>
<translation id="5496810170689441661">Chromium mēģina rediģēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="549975168243349205">Izmantojot Chromium, varat turpināt strādāt ar savām iecienītākajām lietotnēm, piemēram, Google disku un YouTube, atrodoties ceļā.</translation>
<translation id="5524890928877629608">meklēšanas apgabala augšējais kreisais stūris: <ph name="LEFT" />% pa kreisi, <ph name="TOP" />% augšdaļā</translation>
<translation id="3510916764590863589">Atvērt PDF failus pārlūkā Shuttle</translation>
<translation id="5536164441519929134">Jautājiet<ph name="LINE_BREAK" />par šo cilni</translation>
<translation id="8317102978607899723">Drošības apsvērumu dēļ pārlūkā Shuttle tiek izslēgta JavaScript optimizācija, kad pirmoreiz apmeklējat kādu vietni.

Ja šī lapa nedarbojas, kā paredzēts, mēģiniet atļaut optimizāciju.</translation>
<translation id="5575874067957905201">Rādīt pakalpojumu Gemini pārlūkā Chromium Mac izvēļņu joslā un ieslēgt īsinājumtaustiņu</translation>
<translation id="5576587363991567745">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Chromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt saglabātajai informācijai un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā parasts lietotājs, nevis kā administrators.</translation>
<translation id="5580770360767802657">Izmantojiet pārlūku Chromium pēc noklusējuma un piespraudiet to</translation>
<translation id="5596627076506792578">Citas opcijas</translation>
<translation id="5605834417512968703">Atlasiet jebko, ko vēlaties meklēt, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="5618818588972826921">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="8908504550344650717">{0,plural, =0{Ir pieejams Shuttle atjauninājums}=1{Ir pieejams Shuttle atjauninājums}zero{Shuttle atjauninājums ir pieejams jau # dienu}one{Shuttle atjauninājums ir pieejams jau # dienu}other{Shuttle atjauninājums ir pieejams jau # dienas}}</translation>
<translation id="1107298128800350481">Vienmēr notīrīt vietnes datus no ierīces, kad tiek aizvērts pārlūks Shuttle</translation>
<translation id="5653831366781983928">Lūdzu, nekavējoties restartējiet pārlūku Chromium</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="3675878834104730294">Rādīt Shuttle šajā valodā</translation>
<translation id="569897634095159764">Nevar izveidot savienojumu ar internetu. Starpniekserverī ir nepieciešama autentifikācija.</translation>
<translation id="7168202961287328687">Pārlūkā Shuttle neaktīvās cilnēs tiek atbrīvota atmiņa. Tādējādi aktīvajām cilnēm un citām lietotnēm tiek nodrošināts vairāk datora resursu un tiek uzlabots Shuttle darbības ātrums. Neaktīvās cilnes atkal tiek automātiski aktivizētas, kad tās atverat. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par atmiņas taupīšanas režīmu<ph name="END_LINK" />.</translation>
<translation id="5775198138441669627">Ja aizmirsāt ieejas frāzi vai vēlaties mainīt šo iestatījumu, varat <ph name="SETTINGS_LINK" /> Chromium datus savā kontā.</translation>
<translation id="5800158606660203929">Pielāgojiet un kontrolējiet pārlūku Chromium. Iestatiet Chromium kā noklusējuma pārlūku.</translation>
<translation id="5802618941556161431">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs, iestatot Chromium kā noklusējuma pārlūku.</translation>
<translation id="5809516625706423866">Nevar izveidot savienojumu ar internetu. HTTP 401 — neatļauts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="4687670724165839540">Paātrina vietņu darbību, izmantojot Shuttle programmu V8, bet nedaudz samazina Shuttle izturību pret uzbrukumiem. Šis iestatījums ir izslēgts.</translation>
<translation id="5821520528363214608">Lai izmantotu un saglabātu Chromium datus Google kontā, atjauniniet pārlūku Chromium.</translation>
<translation id="5824893331272123205">Nevarēja ielādēt šo paneli. Mēģiniet vēlreiz.</translation>
<translation id="137189936820997722">Laipni lūdzam pārlūkā Shuttle!</translation>
<translation id="6407035307321626411">Tiek ieslēgtas papildu funkcijas, lai nodrošinātu visefektīvāko Shuttle aizsardzību.</translation>
<translation id="5871205389137001634">Noklikšķiniet, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="3128663943810469943">Pārlūkā Shuttle tika konstatēts, ka tālāk norādītie vienumi satur ļaunprātīgu programmatūru:</translation>
<translation id="5889361821821684993">Chromium regulāri pārbauda, vai pārlūkā ir atlasīti visdrošākie iestatījumi. Ja kaut kas būs jāpārskata, saņemsiet paziņojumu.</translation>
<translation id="5895138241574237353">Restartēt</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā</translation>
<translation id="5924017743176219022">Notiek savienojuma izveide ar internetu...</translation>
<translation id="5939553720811388432">Pārlūka Chromium sagatavošana</translation>
<translation id="5941711191222866238">Minimizēt</translation>
<translation id="5949225980829865667">Lai varētu izmantot šo grāmatzīmi un citus datus visās savās ierīcēs, pierakstieties pārlūkā Chromium.</translation>
<translation id="5953657885167112863">Chromium personalizēšana</translation>
<translation id="5960071705175224773">Jūsu iestatījumus mainīja nezināma lietotne</translation>
<translation id="5977420883993828287">Piesprausta! Varat atkal piekļūt kontekstuālo uzdevumu funkcijai, izmantojot rīkjoslu.</translation>
<translation id="5340341384223569715">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Shuttle, ja tas nav izmantots vienu minūti.}zero{Jūsu organizācija automātiski aizver pārlūku Shuttle, ja tas nav izmantots # minūtes.}one{Jūsu organizācija automātiski aizver pārlūku Shuttle, ja tas nav izmantots # minūti.}other{Jūsu organizācija automātiski aizver pārlūku Shuttle, ja tas nav izmantots # minūtes.}}</translation>
<translation id="5987687638152509985">Lai sāktu sinhronizēšanu, atjauniniet Chromium.</translation>
<translation id="5990360079535151574">Izmantojot rīkjoslā pieejamo pogu “Kontekstuālie uzdevumi”, varat atkārtoti atvērt kontekstuālos uzdevumus, lai uzdotu jautājumus pārlūkošanas laikā.</translation>
<translation id="6003112304606738118">Notiek lejupielāde... Atlikušais laiks: <ph name="HOURS" /> stunda(-as).</translation>
<translation id="6009821354356307391">Uzdot papildu jautājumu</translation>
<translation id="6040143037577758943">Aizvērt</translation>
<translation id="6044357424127037044">Izmantojiet lietotni Chromium savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūtu vairāk iespējām, iepērkoties tiešsaistē</translation>
<translation id="6058380562449900225">Lai aizsargātu savus datus, ļaujiet pārlūkā Chromium atsaukt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis (paziņojumi netiks bloķēti)</translation>
<translation id="6063093106622310249">&amp;Atvērt pārlūkā Chromium</translation>
<translation id="6069027071882229820">Kopēt kā attēlu</translation>
<translation id="3642130578728163190">Paplašinājums <ph name="EXTENSION_NAME" /> ir pievienots pārlūkam Shuttle</translation>
<translation id="2484600148019262399">Pielāgojiet un pārvaldiet pārlūku Shuttle. Ir pieejams atjauninājums.</translation>
<translation id="5098189861342100628">Ieslēgts • Shuttle nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="611228897408671387">Jūsu konts pārlūkā Chromium</translation>
<translation id="8603072311189086377">Atļaut paplašinājumam rādīt piekļuves pieprasījumus Shuttle rīkjoslā</translation>
<translation id="6801818398062031196">Fails <ph name="FILE_NAME" /> ir bīstams, tādēļ Shuttle to bloķēja.</translation>
<translation id="4712579756381990057">Shuttle drīz tiks aizvērts, un dati tiks izdzēsti</translation>
<translation id="6145820983052037069">Šeit varat pārslēgties starp Chromium profiliem.</translation>
<translation id="4257025918694286900">Ja atļaujat sīkfailus, pārlūks Shuttle var tos izmantot iepriekšējai ielādei.</translation>
<translation id="6165508094623778733">Uzzināt vairāk</translation>
<translation id="6173308241973263798">Notīrīt Chromium datus savā kontā</translation>
<translation id="8755328651499078855">Šis fails var būt bīstams.<ph name="LINE_BREAK" />Shuttle var pārbaudīt šo lejupielādi, ja norādīsiet paroli. Informācija par failu tiek nosūtīta funkcijai “Google droša pārlūkošana”, taču faila saturs un parole paliek jūsu ierīcē.</translation>
<translation id="6182736845697986886">Instalēšana neizdevās, jo radās atjauninājumu servera iekšēja kļūda.</translation>
<translation id="6183079672144801177">Ierīcē <ph name="TARGET_DEVICE_NAME" /> pierakstieties pārlūkā Chromium un pēc tam vēlreiz mēģiniet veikt sūtīšanu.</translation>
<translation id="6212496753309875659">Šim datoram jau ir jaunākā Chromium versija. Ja programmatūra nedarbojas, atinstalējiet pārlūku Chromium un mēģiniet vēlreiz.</translation>
<translation id="1515663301924664480">{0,plural, =0{Pārlūks Shuttle tūlīt tiks restartēts}=1{Pārlūks Shuttle pēc 1 sekundes tiks restartēts}zero{Pārlūks Shuttle pēc # sekundēm tiks restartēts}one{Pārlūks Shuttle pēc # sekundes tiks restartēts}other{Pārlūks Shuttle pēc # sekundēm tiks restartēts}}</translation>
<translation id="6241367896540709610">Pārlūkam Chromium ir nepieciešama atļauja piekļūt krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="6245734527075554892">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Chromium.</translation>
<translation id="4713635402704891510">Padarīt Shuttle par noklusējuma pārlūku</translation>
<translation id="6248988683584659830">Meklēt iestatījumus</translation>
<translation id="6261803579884938625">Izmantojiet lietotni Chromium savā tālrunī, lai iegūtu labākās Google drošības funkcijas, atrodoties ceļā</translation>
<translation id="6268381023930128611">Vai izrakstīties no Chromium?</translation>
<translation id="6270547683008298381">Šīs cilnes izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Chromium padarīt tās neaktīvas.</translation>
<translation id="6281746429495226318">Pielāgot Chromium profilu</translation>
<translation id="6290827346642914212">Chromium profila nosaukšana</translation>
<translation id="6294831894865512704">Viens no paplašinājumiem pieprasa, lai jūs pierakstītos pārlūkā Chromium</translation>
<translation id="3997120491472930522">Fails <ph name="FILE_NAME" /> var būt bīstams, tādēļ Shuttle to bloķēja.</translation>
<translation id="5186109991568427789">Chrome saitē tiek izmantota kamera.</translation>
<translation id="6333502561965082103">Tiek veikta cita darbība pārlūkā Chromium. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="6334986366598267305">Tagad pārlūkā Chromium ir vieglāk izmantot Google kontu, kā arī ir atvieglota lietošana datoros, ko izmanto vairākas personas.</translation>
<translation id="6347002662287820329">Iegūstiet ērtu piekļuvi zināmajām, iecienītajām un uzticamajām funkcijām, iestatot Chromium kā noklusējuma pārlūku.</translation>
<translation id="7093968037936297432">Shuttle saīsne</translation>
<translation id="7334991367988739135">Pārlūkā Shuttle šī lejupielāde tika bloķēta, jo fails parasti netiek lejupielādēts un var būt bīstams.</translation>
<translation id="6373523479360886564">Vai tiešām vēlaties atinstalēt pārlūku Chromium?</translation>
<translation id="6375219077595103062">Saīsnes pievienošana paroļu pārvaldniekam</translation>
<translation id="6388799252195623474">palīdzēt man ar šo</translation>
<translation id="6390800440335263989">Lai turpinātu, pierakstieties pārlūkā Chromium ar kontu <ph name="EMAIL" />. Tas nodrošinās jūsu organizācijas politiku ievērošanu.</translation>
<translation id="6400112897226594999">Chromium logotips datora ekrānā.</translation>
<translation id="6403826409255603130">Chromium ir tīmekļa pārlūks, kas darbina tīmekļa lapas un lietojumprogrammas zibenīgā ātrumā. Tas ir ātrs, stabils un ērti lietojams. Pārlūkojiet tīmekli vēl drošāk ar aizsardzību pret ļaunprātīgu programmatūru un pikšķerēšanu, kas iebūvēta pārlūkā Chromium.</translation>
<translation id="6414624068245092115">Lai vienmēr varētu izmantot un saglabāt Chromium datus savā Google kontā, apstipriniet savu identitāti.</translation>
<translation id="3077581991710361221">Shuttle darbojas ātrāk, un funkcijas, kurās tiek izmantota valoda JavaScript, darbojas paredzētajā veidā</translation>
<translation id="6436260184216827876">Funkcija Attēlu meklēšana nav pieejama. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="6442900851116057561">Chromium OS restartēšana</translation>
<translation id="6836481692352030024">Pārlūkā Shuttle tiek iepriekš ielādēts vēl vairāk lapu, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="6450948450282634257">Lejupielādējiet pārlūku Chromium savā tālrunī, lai izsekotu cenas un saņemtu brīdinājumus, kad kādā vietnē tiek konstatēts cenas samazinājums.</translation>
<translation id="2653849928907685021">Izslēgts • Shuttle nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="6455857529632101747">Laipni lūdzam Chromium profilos!</translation>
<translation id="6460614424172581323">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku Chromium, tiks parādīts aicinājums izmantot ciļņu grupas.</translation>
<translation id="6466344609055215035">Noņemt kontu no pārlūka Chromium</translation>
<translation id="4119585981464207648">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Shuttle.</translation>
<translation id="648319183876919572">Droša pārlūkošana ar papildu aizsardzību nodrošina efektīvāku aizsardzību pret bīstamām vietnēm un lejupielādēm</translation>
<translation id="6510925080656968729">Atinstalēt Chromium</translation>
<translation id="4635313972402880015">Saīsnes tiek atvērtas pārlūkā Shuttle</translation>
<translation id="4810254941066760486">Jūsu organizācija aizver pārlūku Shuttle, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots. Pārlūkošanas dati tika izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="6542839706527980775">Katrā profilā tiek glabāta attiecīgā Chromium profila informācija, piemēram, grāmatzīmes, vēsture, paroles un citi dati.</translation>
<translation id="6556755379298048869">Veiciet meklēšanu, izmantojot īsinājumtaustiņu.</translation>
<translation id="2636806189032302779">Uzziniet vairāk par to, <ph name="BEGIN_LINK" />kā pārlūkā Shuttle tiek saglabāta jūsu datu konfidencialitāte<ph name="END_LINK" />.</translation>
<translation id="5478536825661470867">Šī iestatījuma izmaiņas tiks lietotas pēc pārlūka Shuttle restartēšanas.</translation>
<translation id="4113260229270901158">Pārvaldiet savus paplašinājumus, Shuttle galvenajā izvēlnē noklikšķinot uz Paplašinājumi.</translation>
<translation id="656935081669708576">Varat pārslēgties, lai skatītu paroles no cita Chromium profila.</translation>
<translation id="6569556444379005948">Izmantojiet lietotni Chromium, lai piekļūtu vislabākajiem MI rīkiem, atrodoties ceļā</translation>
<translation id="7057131640166361945">Lai izlabotu pareizrakstības kļūdas, Shuttle nosūta teksta laukos ievadīto tekstu Google serveriem.</translation>
<translation id="6598877126913850652">Pāriet uz Chromium paziņojumu iestatījumiem</translation>
<translation id="6600016381025017075">Meklēt informāciju par jebkuru šīs lapas satura daļu</translation>
<translation id="3051968423457057392">Izmaiņas stāsies spēkā, kad restartēsiet Shuttle.</translation>
<translation id="6637908313088374648">Tagad pārlūks Chromium tiek palaists, kad tiek palaista operētājsistēma Windows, lai jūs varētu uzreiz sākt pārlūkošanu. Šo funkciju var izslēgt iestatījumos.</translation>
<translation id="6648212540664651655">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Chromium tika atjaunotas cilnes no jūsu pēdējās sesijas. Varat to izslēgt lapā</translation>
<translation id="665732753414869868">Pārlūkam Chromium ir nepieciešama atļauja izmantot kameru, lai varētu izveidot jūsu apkārtnes 3D karti.</translation>
<translation id="6669284030132180248">Ja saglabāsiet grāmatzīmes arī Google kontā, varēsiet izsekot produktu cenām pārlūkā Chromium un saņemt paziņojumus par cenu kritumiem.</translation>
<translation id="6676384891291319759">Piekļūt internetam</translation>
<translation id="668175097507315160">Chromium OS nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="6691132793308828750">Noņemt šo lietotņu datus no Chromium</translation>
<translation id="6709350901466051922">Pārlūkam Chromium ir nepieciešama atļauja izmantot mikrofonu šajā vietnē.</translation>
<translation id="6712881677154121168">Lejupielādes kļūda: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="2725737003556499783">Jūsu profilu nevar izmantot, jo tas ir no jaunākas Shuttle versijas.

Dažas funkcijas var nebūt pieejamas. Norādiet citu profila direktoriju vai izmantojiet jaunāku Shuttle versiju.</translation>
<translation id="6729124504294600478">Lai varētu izmantot personalizēšanu un citas funkcijas, iekļaujiet pārlūku Chromium iestatījumos “Darbības tīmeklī un lietotnēs” un “Saistītie Google pakalpojumi”.</translation>
<translation id="6734291798041940871">Pārlūks Chromium jau ir instalēts visiem lietotājiem jūsu datorā.</translation>
<translation id="6742093177587589736">Pierakstieties pārlūkā Chromium, lai varētu piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs. Šī grāmatzīme tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="1073375677278272498">Paātrina vietņu darbību, izmantojot Shuttle programmu V8, bet nedaudz samazina Shuttle izturību pret uzbrukumiem. Šis iestatījums ir ieslēgts.</translation>
<translation id="6754665438209053659">{count,plural, =1{Noteikti jūsu Chromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Noteikti jūsu Chromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Noteikti jūsu Chromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumus) tiks dzēsti.}other{Noteikti jūsu Chromium dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="67706546131546258">Chromium iesaka pārbaudīt šo failu, jo tas var būt bīstams.</translation>
<translation id="6779406956731413166">Chromium OS darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Tulkot</translation>
<translation id="6847869444787758381">Ja jūsu paroles kādreiz tiks apdraudētas, pārlūkā Chromium saņemsiet paziņojumu</translation>
<translation id="684888714667046800">Nevar izveidot savienojumu ar internetu. Ja izmantojat ugunsmūri, failam <ph name="PRODUCT_EXE_NAME" /> noteikti ir jābūt iekļautam atļaušanas sarakstā.</translation>
<translation id="776553009482398136">Shuttle — <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Nospiediet tabulēšanas taustiņu, lai turpinātu</translation>
<translation id="6862030660799253820">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="6869568587896659271">Ērti piekļūstiet tīmekļa vietnēm zem adreses joslas.</translation>
<translation id="5180440422324801473">Pārlūkā Shuttle tika konstatēts, ka paplašinājums “<ph name="EXTENSION_NAME" />” satur ļaunprātīgu programmatūru.</translation>
<translation id="6877155553248388166">meklēšanas apgabala apakšējais labais stūris: <ph name="RIGHT" />% pa labi, <ph name="BOTTOM" />% apakšdaļā</translation>
<translation id="6896758677409633944">Kopēt</translation>
<translation id="6898028264630240901">Varat piespraust kontekstuālos uzdevumus, lai pārlūkošanas laikā uzdotu jautājumus.</translation>
<translation id="6901631050894301805">Iestatiet Chromium kā noklusējuma pārlūku un piespraudiet to uzdevumjoslai</translation>
<translation id="6909503629704372277">&amp;Pārvaldīt Chromium profilus</translation>
<translation id="4581248703262892072">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS" />
            • Tiks atiestatīta jūsu sākumlapa, jaunas cilnes lapa, meklētājprogramma un piespraustās cilnes.
            <ph name="LINE_BREAK" />
            • Tiks atspējoti paplašinājumi.
            <ph name="LINE_BREAK" />
            • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAK" />
            • Tiks atiestatīti Shuttle īsinājumtaustiņi.
            <ph name="LINE_BREAKS" />
            Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="6948031725951063910">Ir sasniegts Chromium grāmatzīmju skaita ierobežojums (<ph name="BOOKMARK_LIMIT" />), tāpēc noteiktas jūsu grāmatzīmes vēl nav saglabātas jūsu Google kontā.

Jaunas grāmatzīmes nevar saglabāt jūsu kontā, kamēr neizdzēsīsiet dažas no tām. Ja izrakstīsieties tūlīt, nesaglabātās grāmatzīmes tiks dzēstas.</translation>
<translation id="6964305034639999644">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="6965382102122355670">Labi</translation>
<translation id="6985329841647292029">Chromium OS noteikumi</translation>
<translation id="7003299027384820442">Lai savā kontā (<ph name="ACCOUNT_EMAIL" />) izmantotu un saglabātu Chromium datus, ievadiet ieejas frāzi.</translation>
<translation id="7011190694940573312">Instalēšana neizdevās, jo šī operētājsistēmas versija netiek atbalstīta.</translation>
<translation id="7024536598735240744">Atpakošanas kļūda: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7045244423563602563">Pielāgojiet pārlūku Chromium savām vajadzībām</translation>
<translation id="7047386856539490735">Vai šie rezultāti ir noderīgi?</translation>
<translation id="705851970750939768">Atjaunināt Chromium</translation>
<translation id="3425455063038300019">Ja attēlam nav vērtīga apraksta, pārlūks Shuttle mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google.</translation>
<translation id="7074836723476134809">Piekļūstiet MI iespējām, izmantojot lietotni Chromium savā ierīcē (<ph name="DEVICE_TYPE" />)</translation>
<translation id="7134687062119989071">Izmantojiet lietotni Chromium savā tālrunī, lai piekļūtu savām parolēm, cilnēm un citiem datiem, atrodoties ceļā</translation>
<translation id="7141270731789036260">Pielāgot versiju Chrome for Testing</translation>
<translation id="2566749447284070075">Varat izmantot pārlūku Shuttle ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs.</translation>
<translation id="4717037424104880768">Noņemt paplašinājumu <ph name="EXTENSION_NAME" /> no pārlūka Shuttle</translation>
<translation id="5499504683862746062">Jūsu organizācija dzēš Shuttle datus, ja šis pārlūks <ph name="TIMEOUT_DURATION" /> netiek izmantots. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="718435575166326686">Pārlūkam Chromium ir nepieciešama atļauja izmantot kameru šajā vietnē.</translation>
<translation id="73779270539924806">Neizdevās palaist Shuttle. Mēģiniet vēlreiz.</translation>
<translation id="7204669035546236137">Atvērtajā ekrānā varat jautāt jebko Gemini pārlūkā Chromium</translation>
<translation id="3909780788712619547">Paturiet pārlūku Shuttle dokā, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="7213407614656404070">Izmantojiet Chromium ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs</translation>
<translation id="7216228761061470870">Kad izmantojat attēlu meklēšanu, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili.</translation>
<translation id="5152543266278054880">Uzdevumu pārvaldnieks — Shuttle</translation>
<translation id="7227958669698166857">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Chromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt saglabātajai informācijai un citiem datiem visās savās ierīcēs.</translation>
<translation id="7252276985725323153">Sāciet pārlūkošanu uzreiz: tagad pārlūks Chromium var tikt palaists, kad tiek palaista operētājsistēma Windows.</translation>
<translation id="7274695763216404502">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana no rīkjoslas.</translation>
<translation id="7288567540154601580">Cilnes un paplašinājumi</translation>
<translation id="7301179260332476710">{NUM_EXTENSIONS,plural, =1{Shuttle iesaka to noņemt.}zero{Shuttle iesaka tos noņemt.}one{Shuttle iesaka tos noņemt.}other{Shuttle iesaka tos noņemt.}}</translation>
<translation id="6738087381969111286">Lai kopīgotu sistēmas audio, pārejiet uz sistēmas iestatījumiem un iespējojiet iestatījumu “Tikai sistēmas audio ierakstīšana” pārlūkam Shuttle. Pēc tam jums būs jārestartē pārlūks Shuttle.</translation>
<translation id="882134845922037914">Notiek Shuttle atjaunināšana</translation>
<translation id="5911508944834868675">Jūsu preferenču fails ir bojāts vai nederīgs. Shuttle nespēj atkopt jūsu iestatījumus.</translation>
<translation id="7324051657739063017">Varat atkārtoti atvērt kontekstuālos uzdevumus, lai uzdotu jautājumus pārlūkošanas laikā.</translation>
<translation id="734373864078049451">Šeit atrodas jūsu tīmekļa saturs, grāmatzīmes un cits Chromium saturs.</translation>
<translation id="7347827960336370838">Jūsu šifrētos datus var lasīt tikai personas, kurām ir jūsu ieejas frāze. Ieejas frāze netiek sūtīta uzņēmumam Google, un uzņēmums Google to neuzglabā. Ja aizmirsīsiet ieejas frāzi vai vēlēsieties mainīt šo iestatījumu, jums būs <ph name="BEGIN_LINK" />jāizdzēš Chromium dati savā kontā<ph name="END_LINK" />.</translation>
<translation id="5213396397254545050">Jūsu sistēmas administrators ir konfigurējis Shuttle atvērt <ph name="ALTERNATIVE_BROWSER_NAME" />, lai piekļūtu <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Radās problēma</translation>
<translation id="7241271939430402377">Lai saņemtu turpmākus Shuttle atjauninājumus, nepieciešama operētājsistēma macOS 13 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma macOS 12.</translation>
<translation id="7376384068949534168">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Chromium tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Atveriet Chrome interneta veikalu</translation>
<translation id="7394275517973019558">Rādīt Gemini pārlūkā Chromium sistēmas teknē</translation>
<translation id="7401687852903179959">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="7407655596887111931">Tagad Chromium ir jūsu noklusējuma pārlūks.</translation>
<translation id="3052711235626610530">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Shuttle tiek atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to izslēgtu, pārejiet uz lapu</translation>
<translation id="7427879960656355200">Paroļu importēšana pārlūkā Chromium</translation>
<translation id="744815265653811511">1. Noklikšķiniet uz tālāk redzamās pogas <ph name="BUTTON_LABEL" />.
2. Windows iestatījumos noklikšķiniet uz <ph name="BUTTON_2" />.
3. Windows paziņojumā noklikšķiniet uz <ph name="BUTTON_3" />, lai piespraustu pārlūku Chromium uzdevumu joslai, tādējādi nodrošinot ātru piekļuvi.</translation>
<translation id="9197089209084271928"><ph name="PAGE_TITLE" /> — Shuttle izstrādātāju versija</translation>
<translation id="7450541714075000668">Teksts ir nokopēts</translation>
<translation id="313710343255539509">Lai izmantotu mikrofonu, piešķiriet pārlūkam Shuttle piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="7461356015007898716">Lai saņemtu turpmākus Chromium atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 7.</translation>
<translation id="3993055863855039235">Vai atkārtoti palaist Shuttle?</translation>
<translation id="7483335560992089831">Nevar instalēt to pašu Chromium versiju, kas jau šobrīd darbojas. Aizveriet Chromium un mēģiniet vēlreiz.</translation>
<translation id="7510190804000607802">Atgādinājums: vislabākais Google saturs vienmēr par rokai</translation>
<translation id="8341160057232502783">Vietnes, visticamāk, darbosies, kā paredzēts. Aizverot visus Shuttle logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Google konta, ja esat pierakstījies pārlūkā Shuttle.</translation>
<translation id="6139170930430750545">{0,plural, =1{Pārlūks Shuttle pēc 1 minūtes tiks restartēts}zero{Pārlūks Shuttle pēc # minūtēm tiks restartēts}one{Pārlūks Shuttle pēc # minūtes tiks restartēts}other{Pārlūks Shuttle pēc # minūtēm tiks restartēts}}</translation>
<translation id="7565444033145385702">Lai aizsargātu savus datus, ļaujiet pārlūkā Chromium noņemt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis.</translation>
<translation id="7445475294019002626">Automātiski palaidiet pārlūku Shuttle, lai uzreiz sāktu pārlūkošanu.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> instalēšanas programma</translation>
<translation id="3770734847062637711">Pārlūkā Shuttle tiek izmantota jūsu kamera un mikrofons.</translation>
<translation id="7617377681829253106">Pārlūkā Chromium ir veikti uzlabojumi</translation>
<translation id="8871277779820248167">Tagad pārlūkā Shuttle ir pieejams vairāk funkciju.</translation>
<translation id="7624307931717240213">Mēs izmantojam informāciju, lai uzlabotu šo pakalpojumu. Skatiet konfidencialitātes politiku un pakalpojumu sniegšanas noteikumus.</translation>
<translation id="7649070708921625228">Palīdzība</translation>
<translation id="7650134251917003571">Iegūt lietotni Chromium</translation>
<translation id="7658239707568436148">Atcelt</translation>
<translation id="8213236740307893655">Shuttle nav jūsu noklusējuma pārlūks.</translation>
<translation id="7689606757190482937">Chromium sinhronizēšana un personalizēšana visās savās ierīcēs</translation>
<translation id="7699779824407626136">Chromium atjauninājums</translation>
<translation id="7700735928747402058">Jūsu darbs ir aizsargāts pārlūkā Chromium</translation>
<translation id="7716950018788545737">Uzdevumi ir pabeigti.</translation>
<translation id="77283119132245232">Nodrošina sistēmas izsekošanas pakalpojumus pārlūkā <ph name="BROWSER_NAME" />. Ja šis pakalpojums ir atspējots, pārlūka izveidotajos veiktspējas izsekošanas datos netiek ietverti sistēmas līmeņa notikumi, piemēram, konteksta maiņas un pavedienu gatavības notikumi.</translation>
<translation id="7745317241717453663">Veicot šo darbību, no šīs ierīces tiks dzēsti pārlūkošanas dati. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Chromium kā <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Instalētājam neizdevās izveidot pagaidu katalogu. Lūdzu, pārbaudiet, vai diskā pietiek vietas un vai ir atļauja instalēt programmatūru.</translation>
<translation id="7747820849741499258">Meklēt pārlūkā Chromium</translation>
<translation id="7750130090210923118">Atiestatīt Chromium noklusējuma motīvu</translation>
<translation id="7752521946322750699">Lai aizsargātu jūsu darbu pārlūkā Chromium, jūsu organizācija varēs skatīt vai pārvaldīt noteiktu informāciju, kad būsiet pierakstījies pārlūkā Chromium.</translation>
<translation id="7781047659465034537">Iestatiet Chromium kā noklusējuma pārlūku un piespraudiet to uzdevumu joslai</translation>
<translation id="7786760609782648049">Pārlūka Chromium darbības paātrināšana</translation>
<translation id="5390209367680424449"><ph name="PAGE_TITLE" /> — Shuttle Canary</translation>
<translation id="5236799997529789289">Neļaujiet personām, kurām ir piekļuve jūsu interneta datplūsmai, viegli skatīt jūsu apmeklētās vietnes. Shuttle izmanto drošu savienojumu, lai meklētu vietnes IP adresi sistēmā DNS (domēnu nosaukumu sistēmā).</translation>
<translation id="7810005234485217901">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai varētu piekļūt.</translation>
<translation id="6809035843240398711">Izvēlieties, kādu saturu kopīgot ar Shuttle</translation>
<translation id="7828947555739565424">Šajā ierīcē jau pastāv Chromium profils ar šādu kontu.</translation>
<translation id="7845233973568007926">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē dators.</translation>
<translation id="2536014991386708485">Jūsu meklētājprogramma tika mainīta ārpus pārlūka Shuttle. Lai jūs aizsargātu, pārlūkā Shuttle tā tika atiestatīta uz sākotnējo noklusējuma meklētājprogrammu. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="7853661403199074278">Pielāgojiet pārlūku Chromium, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="2266811154496778101">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Shuttle nosūta ierakstīto tekstu jūsu noklusējuma meklētājprogrammai, lai iegūtu labākus ieteikumus. Inkognito režīmā šis iestatījums ir izslēgts.</translation>
<translation id="6065091602420830">Nevarēja atjaunināt uz jaunāko Shuttle versiju, tādēļ jūs nevarēsiet piekļūt jaunākajām funkcijām un drošības labojumiem.</translation>
<translation id="7872446069773932638">Notiek lejupielāde... Atlikušais laiks: <ph name="SECONDS" /> sekunde(-es).</translation>
<translation id="7873537467422636035">Ja aizmirstat ieejas frāzi vai vēlaties mainīt šo iestatījumu, <ph name="BEGIN_LINK" />izdzēsiet Chromium datus savā kontā<ph name="END_LINK" />.</translation>
<translation id="7874369989024033742">Ātri atveriet pakalpojumu Gemini pārlūkā Chromium, kad tas ir nepieciešams.</translation>
<translation id="7888981273428720788">Iestatīt Chromium kā noklusējuma pārlūku</translation>
<translation id="7934340546140346950">Pārlūkā Chromium nedrošie savienojumi tiek automātiski jaunināti uz HTTPS, ja iespējams.</translation>
<translation id="7937630085815544518">Operētājsistēmā Chromium iepriekš pierakstījāties kā lietotājs <ph name="USER_EMAIL_ADDRESS" />. Lai pierakstītos vēlreiz, lūdzu, izmantojiet to pašu kontu.</translation>
<translation id="7944602660083060118">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Chromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="7585793177462647372">Šī ir Shuttle papildu instalācija, un to nevar izmantot kā noklusējuma pārlūku.</translation>
<translation id="6559029165921633261">No nezināmiem avotiem iegūti paplašinājumi, lietotnes un motīvi var kaitēt ierīcei. Shuttle komanda iesaka instalēt tos tikai no veikala <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="8000759043835159571">Izmantojiet pārlūku Chromium savā ierīcē (<ph name="DEVICE_TYPE" />), lai pilnvērtīgi izmantotu Google piedāvātās iespējas</translation>
<translation id="8004582292198964060">Pārlūkprogramma</translation>
<translation id="8010081455002666927">Noteikt automātiski</translation>
<translation id="8002328729078921180">Tiklīdz pārlūkam Shuttle tiks sniegta piekļuve, vietnes varēs lūgt jums piekļuvi.</translation>
<translation id="818329629430342049">Piespraudiet pārlūku Shuttle uzdevumu joslai, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="80471789339884597">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē visas pārlūkprogrammas.</translation>
<translation id="8054112667659782652">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="8069447462453318634">Atlasiet vienumu “Piespraust rīkjoslai”.</translation>
<translation id="3155838504016687695">Atspējot Shuttle darbību fonā lietotnēm</translation>
<translation id="80790299200510644">Attēlu meklēšana</translation>
<translation id="8086881907087796310">Instalēšana neizdevās, jo jūsu dators neatbilst minimālajām aparatūras prasībām.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Google Chrome for Testing</translation>
<translation id="8105840573057009683">Pārlūkam Chromium ir nepieciešama atrašanās vietas atļauja šai vietnei.</translation>
<translation id="8107060931443639922">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku Chromium, tiks parādīts aicinājums iespējot brīdinājumus par cenu izsekošanu.</translation>
<translation id="8117908349476699973">Izmantojiet lietotni Chromium savā tālrunī, lai saņemtu brīdinājumus par cenu kritumu precēm, kas jūs interesē</translation>
<translation id="8118331347066725040">Sūtiet atsauksmes par meklēšanu, izmantojot Lens</translation>
<translation id="8130609355518033382">Chromium personalizēšana</translation>
<translation id="8133124826068723441">Chromium OS nevarēja sinhronizēt jūsu datus, jo jūsu domēnā nav pieejama sinhronizācija.</translation>
<translation id="813913629614996137">Notiek inicializēšana...</translation>
<translation id="8161503455832158203">Atveriet pakalpojumu Gemini pārlūkā Chromium, izmantojot īsinājumtaustiņu.</translation>
<translation id="369114052288176160">Shuttle pakalpojumu sniegšanas papildu noteikumi</translation>
<translation id="680378955833427720">Šis fails ir bīstams, tāpēc Shuttle to bloķēja.</translation>
<translation id="8177472873527554730">Nevar atrast saturu lapā</translation>
<translation id="8200109504272824693">Lai savā kontā (<ph name="USER_EMAIL" />) izmantotu un saglabātu Chromium datus, ievadiet ieejas frāzi.</translation>
<translation id="820759916613250543">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="8221491193165283816">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet šeit.</translation>
<translation id="8107647892434846563">Lai izmantotu kameru, piešķiriet pārlūkam Shuttle piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="1786899383568465391">Shuttle nevar pārbaudīt šī paplašinājuma izcelsmi, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Shuttle, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp personas informāciju.</translation>
<translation id="493819615490030185">Ja attēlam nav vērtīga apraksta, pārlūks Shuttle mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google. Jebkurā brīdī iestatījumos varat izslēgt šo iespēju.</translation>
<translation id="8254601181414348851">Vai pierakstīties pārlūkā Chromium, izmantojot jaunu profilu?</translation>
<translation id="8262224117913639129">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />. Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Chromium savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />. Varēsiet arī piekļūt parolēm un citiem datiem no <ph name="DEVICE" />.</translation>
<translation id="8277334259226003205">Rādīt pakalpojumu Gemini pārlūkā Chromium sistēmas teknē un ieslēgt īsinājumtaustiņu</translation>
<translation id="8286943863733751221">Pārlūkā <ph name="BEGIN_LINK" />Chromium tiek rādīti brīdinājumi<ph name="END_LINK" /> par nedrošām vietnēm un lejupielādēm</translation>
<translation id="8295827201165805317">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Chromium tika noņemta šāda atļauja: <ph name="PERMISSION" />.</translation>
<translation id="8296236834352487533">Iepērcieties, tulkojiet un identificējiet redzamo saturu, izmantojot kameru iOS lietotnē Chromium.</translation>
<translation id="8310603974518734211">Kvadrātkods, lai pierakstītos pārlūkā Chromium ar kontu <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Palaišanas kļūda: <ph name="STARTUP_ERROR" />.</translation>
<translation id="2189465505625523876">Jūsu organizācija aizver pārlūku Shuttle, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots.</translation>
<translation id="8321888067342493336">Saglabāt kā attēlu</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> iepriekš izmantoja Chromium</translation>
<translation id="8351551329754447960">Iespējot prasmes pārlūkā Chromium</translation>
<translation id="8359544530202147897">Lai turpinātu izmantot Chromium datus savā Google kontā (<ph name="ACCOUNT_EMAIL" />), atjauniniet pārlūku Chromium.</translation>
<translation id="8360718212975266891">Lai saņemtu turpmākus Chromium atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.</translation>
<translation id="8362914115861174987">Tulkot šādā valodā:</translation>
<translation id="8367705492654390392">Uzdodiet jebkādu jautājumu</translation>
<translation id="8370517070665726704">Autortiesības: <ph name="YEAR" /> Google LLC. Visas tiesības paturētas.</translation>
<translation id="8372327902843331129">Pierakstieties pārlūkā Chromium, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs. Šī parole tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="7737586770085807713">Pēc tam jums būs jārestartē pārlūks Shuttle.</translation>
<translation id="458720374088121514">Shuttle iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.</translation>
<translation id="3243699608914041912">Šī paplašinājuma publicēšanu atcēla izstrādātājs, un paplašinājums, iespējams, nav drošs. Noņemiet to no pārlūka Shuttle, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="8416884904046428725">Pārlūkā Chromium ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="2803567348225973544">{0,plural, =1{Restartējiet pārlūku Shuttle vienas dienas laikā}zero{Restartējiet pārlūku Shuttle # dienu laikā}one{Restartējiet pārlūku Shuttle # dienas laikā}other{Restartējiet pārlūku Shuttle # dienu laikā}}</translation>
<translation id="8438543370129609977">Kad izmantojat funkciju Attēlu meklēšana, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">Uzzināt vairāk par meklēšanu, izmantojot attēlu meklēšanu pārlūkā Chromium</translation>
<translation id="8453117565092476964">Instalēšanas programmas arhīvs ir bojāts vai nav derīgs. Lejupielādējiet Chromium vēlreiz.</translation>
<translation id="8458614432758743027">Pārlūka Chromium izmantošanai nepieciešama operētājsistēma Windows 10 vai jaunāka versija.</translation>
<translation id="8463672209299734063">Neobligāti: palīdziet uzlabot Chromium OS funkcijas un veiktspēju, automātiski nosūtot Google serveriem diagnostikas un lietojuma datus.</translation>
<translation id="8471947159125090285">Lai izmantotu un saglabātu Chromium datus savā Google kontā, apstipriniet savu identitāti.</translation>
<translation id="8482493977473846331">Tiek rādīti aicinājumi pierakstīties pārlūkā Chromium.</translation>
<translation id="4333599663015089415">Shuttle versija ir novecojusi</translation>
<translation id="8376091195503089226">Paldies, ka izvēlējāties Shuttle kā noklusējuma pārlūku!</translation>
<translation id="8522801943730206384">Pārlūkprogrammā Chromium var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="8525579356836940628">Instalēšana apturēta</translation>
<translation id="8545729292258443488">Izmantojiet lietotni Chromium savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūtu savām parolēm, cilnēm un citiem datiem, atrodoties ceļā</translation>
<translation id="8548787790260785208">Saņemiet brīdinājumu, ja pārlūkā Chromium tiek konstatēts, ka kāda no jūsu parolēm ir iekļauta publiskā datu aizsardzības pārkāpumā.</translation>
<translation id="8555465886620020932">Pakalpojuma kļūda: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3871600948131730253">Dažām Shuttle funkcijām un paplašinājumiem ir pieejamas saīsnes. Varat izvēlēties tos atkal ieslēgt.</translation>
<translation id="8556420416730706394">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai piekļūtu. Sānu paneļa augšdaļā noklikšķiniet uz pogas “Piespraust”.</translation>
<translation id="856656450041460113">Meklēt valodu sarakstā</translation>
<translation id="2164758091986776102">Pārlūku Shuttle pārvalda vairākas organizācijas</translation>
<translation id="7921569471494089882">Copyright <ph name="YEAR" /> Silkweave. All rights reserved.</translation>
<translation id="8601359445272098721">Jaunums! Atlasot pogu “Tulkot ekrānu”, varat tulkot gan ekrānā redzamo tekstu, gan attēlus.</translation>
<translation id="5197416451456327645">Notiek Shuttle palaišana...</translation>
<translation id="8624541899164515475">Iestatījumi; tiks atvērta jauna cilne.</translation>
<translation id="8648201657708811153">Google Chrome for Testing nevar iestatīt kā noklusējuma pārlūku.</translation>
<translation id="733927313102300080">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Shuttle vai meklēsiet, izmantojot universālo lodziņu.</translation>
<translation id="8704119203788522458">Šis ir jūsu Chromium</translation>
<translation id="8712637175834984815">Sapratu!</translation>
<translation id="8719993436687031146">Vai pierakstīties pārlūkā Chromium?</translation>
<translation id="8747073452963259673">meklēšanas apgabala apakšējais kreisais stūris: <ph name="LEFT" />% pa kreisi, <ph name="BOTTOM" />% apakšdaļā</translation>
<translation id="878572486461146056">Instalēšanas kļūda: administrators ir piemērojis grupas politiku, kas neļauj veikt instalēšanu: <ph name="INSTALL_ERROR" />.</translation>
<translation id="8813277370772331957">Atgādināt vēlāk</translation>
<translation id="8816416449795340678">Kopīgojiet šo dokumentu ar Gemini pārlūkā Chromium, lai iegūtu īsu kopsavilkumu un uzdotu papildu jautājumus.</translation>
<translation id="8818550178040858407">Vai pierakstīties pārlūkā Chromium?</translation>
<translation id="1740477639007879167">Iestatīt Shuttle kā noklusējuma pārlūku un piespraust to uzdevumu joslai</translation>
<translation id="8826492472752484139">Noklikšķiniet uz vienuma Paroļu pārvaldnieks.</translation>
<translation id="8833697763442816810">Chromium OS sistēma</translation>
<translation id="51810846847651902">Šī valoda tiek izmantota, lai rādītu izvēlnes, iestatījumus, brīdinājumus un citu tekstu pārlūkā Shuttle.</translation>
<translation id="8862326446509486874">Jums nav vajadzīgo tiesību, lai instalētu sistēmas līmenī. Mēģiniet vēlreiz palaist instalēšanas programmu kā administrators.</translation>
<translation id="8876044221123442390">Pievienot Chromium profilu</translation>
<translation id="8890569919834781711">ChromiumOS nevarēja saglabāt Chromium datus jūsu Google kontā pierakstīšanās kļūdas dēļ.</translation>
<translation id="8891709362986793894">Saskaņā ar jūsu organizācijas politiku jums ir jāpierakstās pārlūkā Chromium.</translation>
<translation id="8907580949721785412">Chromium mēģina rādīt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="8932992523185907506">Chromium vairs nav jūsu noklusējuma pārlūks. Vai iestatīt Chromium par noklusējuma pārlūku?</translation>
<translation id="7727082350762937793">Nevar atjaunināt Shuttle</translation>
<translation id="8944232836376404813">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS" />
            • Tiks atiestatīta jūsu sākumlapa, jaunas cilnes lapa, meklētājprogramma un piespraustās cilnes.
            <ph name="LINE_BREAK" />
            • Tiks atspējoti paplašinājumi.
            <ph name="LINE_BREAK" />
            • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAKS" />
            Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="8966875421152977384">Rādīt vietņu saīsnes pārlūkā Chromium</translation>
<translation id="1008106080699243847">Shuttle Enterprise logotips</translation>
<translation id="8980139959902937527">Izmantojiet lietotni Chromium savā ierīcē (<ph name="DEVICE_TYPE" />), lai piekļūstu Google drošības iespējām, atrodoties ceļā</translation>
<translation id="3649746906258419479">Nevar palaist pārlūku Shuttle, jo radās problēma, atverot jūsu profilu. Mēģiniet restartēt pārlūku Shuttle.</translation>
<translation id="8988036198400390003">Pārvaldīt Chromium profilus</translation>
<translation id="8993855408334954620">Izmantojiet tastatūru, lai pārvietotos starp Gemini pārlūkā Chromium un atvērto cilni.</translation>
<translation id="9018218886431812662">Instalēšana pabeigta</translation>
<translation id="9019929317751753759">Lai uzlabotu Chromium drošību, mēs atspējojām tālāk norādīto paplašinājumu, kas nav norādīts vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienots, jums nezinot.</translation>
<translation id="9022552996538154597">Pierakstieties pārlūkā Chromium</translation>
<translation id="9035791714111278917">Rādīt meklēšanu pārlūkā Chromium Mac izvēļņu joslā un ieslēgt īsinājumtaustiņu</translation>
<translation id="3267341748208131224">Pārlūkā Shuttle šī lejupielāde tika bloķēta, jo šajā arhīva failā ir ietverti citi faili, kas, iespējams, slēpj ļaunprātīgu programmatūru</translation>
<translation id="9053882453960391422">Nevainojami sinhronizējiet savas paroles, grāmatzīmes un vēsturi visās ierīcēs. Ērti piekļūstiet zināmajām un iecienītajām funkcijām, atjauninot noklusējuma pārlūku uz Chromium. Lai nodrošinātu ātru piekļuvi, pārlūks Chromium tiks piesprausts uzdevumu joslai.</translation>
<translation id="9056398481763999048">Izmantojiet lietotni Chromium savā tālrunī, lai piekļūtu Google labākajiem MI rīkiem</translation>
<translation id="9062666675513499497">Automātiska pierakstīšanās pārlūkā Chromium, kad pierakstāties citos Google pakalpojumos</translation>
<translation id="4265215433857167851">Pārlūks Shuttle tika automātiski aizvērts</translation>
<translation id="7469466263552552140">Shuttle versija ir novecojusi.</translation>
<translation id="72499647218501325">{0,plural, =1{Pārlūks Shuttle pēc stundas tiks restartēts}zero{Pārlūks Shuttle pēc # stundām tiks restartēts}one{Pārlūks Shuttle pēc # stundas tiks restartēts}other{Pārlūks Shuttle pēc # stundām tiks restartēts}}</translation>
<translation id="9106236359747881194">Atlasiet tekstu, ko meklēt</translation>
<translation id="9106612006984859720">Lai saņemtu turpmākus Chromium atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.1.</translation>
<translation id="3313508441926611846">Atvērt saiti jaunā Shuttle &amp;cilnē</translation>
<translation id="911206726377975832">Vai dzēst arī pārlūkošanas datus?</translation>
<translation id="9134482777260927479">Palīdzība mājasdarbos</translation>
<translation id="9148058034647219655">Iziet</translation>
<translation id="373308981796873164">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Shuttle var tikt atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to ieslēgtu, pārejiet uz lapu</translation>
<translation id="4482819741686179260">Sistēmas administrators ir konfigurējis Shuttle, lai vietne <ph name="TARGET_URL_HOSTNAME" /> tiktu atvērta papildu pārlūkā.</translation>
<translation id="5239882079227870661">Atkārtoti palaist, lai atjauninātu &amp;Shuttle</translation>
<translation id="9190841055450128916">Chromium (mDNS ienākošie savienojumi)</translation>
<translation id="924957577793602335">Pielāgojiet pārlūku Chromium savām vajadzībām</translation>
<translation id="93478295209880648">Iespējams, Chromium nedarbosies pareizi, jo tas vairs netiek atbalstīts operētājsistēmās Windows XP un Windows Vista.</translation>
<translation id="945098430667185067">Izmantojiet pārlūku Chromium, lai piekļūtu Google labākajām drošības funkcijām, atrodoties ceļā</translation>
<translation id="945522503751344254">Sūtīt atsauksmes</translation>
<translation id="965162752251293939">Kas izmanto pārlūku Chromium?</translation>
<translation id="967427899662692980">Visaugstākais Chromium drošības līmenis</translation>
<translation id="983803489796659991">Instalēšana neizdevās, jo atjauninājumu serverim nav nekādu jaukšanas datu lietojumprogrammai.</translation>
<translation id="985498048907240953">Izmantot Chromium, nepierakstoties kontā</translation>
<translation id="5192139095541169725">Silkweave</translation>
<translation id="989970834842471429">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="1699696098551154749">Lai izmantotu atrašanās vietas datus, piešķiriet pārlūkam Shuttle piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
</translationbundle>