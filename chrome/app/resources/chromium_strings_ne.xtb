<translation id="924957577793602335">Chromium आफूले चाहे जस्तो बनाउनुहोस्</translation>
<translation id="93478295209880648">Chromium अब उप्रान्त Windows XP वा Windows Vista मा समर्थित नभएका कारण यसले सही ढङ्गले काम नगर्न सक्छ</translation>
<translation id="945098430667185067">Chromium प्रयोग गरी जुनसुकै बेला जहाँसुकै पनि Google का उत्कृष्ट सुरक्षा सुविधाहरू प्राप्त गर्नुहोस्।</translation>
<translation id="945522503751344254">पृष्ठपोषण पठाउनुहोस्</translation>
<translation id="965162752251293939">Chromium कसले चलाउँदै हुनुहुन्छ?</translation>
<translation id="967427899662692980">Chromium को सबैभन्दा भरपर्दो सुरक्षा प्राप्त गर्नुहोस्</translation>
<translation id="983803489796659991">अपडेट सर्भरमा यो एपको कुनै पनि ह्यास डेटा नभएकाले उक्त एप इन्स्टल गर्न सकिएन।</translation>
<translation id="985498048907240953">खातामा साइन इन नगरिकनै Chromium चलाउनुहोस्</translation>
<translation id="5192139095541169725">Agent Chrome लेखकहरू</translation>
<translation id="989970834842471429">फोटो प्रयोग गरी खोज्ने सुविधामार्फत खोज्नका निम्ति जुनसुकै टेक्स्ट वा फोटो चयन गर्नुहोस्</translation>
<translation id="5834693163377136360">लोकेसन प्रयोग गर्न <ph name="BEGIN_LINK" />सिस्टम सेटिङ<ph name="END_LINK" />मा गई Agent Chrome लाई लोकेसनको एक्सेस दिनुहोस्</translation>
</translationbundle>