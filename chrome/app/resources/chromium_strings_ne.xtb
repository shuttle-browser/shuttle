<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="1026101648481255140">इन्स्टल गर्ने प्रक्रिया सुचारु गर्नुहोस्</translation>
<translation id="1029669172902658969">&amp;ChromiumOS अपडेट गर्न यसलाई रिलन्च गर्नुहोस्</translation>
<translation id="8271032073852564289">Agent Chrome तपाईंलाई यो एक्स्टेन्सनको समीक्षा गर्न सिफारिस गर्छ</translation>
<translation id="1395700234492294565">कुनै साइटले आफ्नो पेजमा भएका लिंकहरू गोप्य तरिकाले प्रिलोड गर्न लगाएका खण्डमा Agent Chrome ले Google का सर्भरहरू प्रयोग गर्छ। यसो गर्दा प्रिलोड गरिएको साइटमा भएको तपाईंको पहिचान खुलाउने जानकारी लुकाइन्छ तर Google ले कुन कुन साइट प्रिलोड गरिन्छन् भन्ने कुरा सिक्छ।</translation>
<translation id="1051793555070215510">१ मिनेटको यो सर्वेक्षण पूरा गरेर हामीलाई इन्कोग्निटो मोडको गुणस्तर सुधार्न मद्दत गर्नुहोस्।</translation>
<translation id="1065672644894730302">तपाइँका प्राथमिकातहरू पढ्न सकिदैन।

केही सुविधाहरू अनुपलब्ध हुन सक्छन् र प्राथमिकताहरूमा परिवर्तनहरू बचत हुने छैनन्।</translation>
<translation id="3693661839172633833">तपाईंका अभिभावकले Agent Chrome का हकमा "साइट, एप तथा एक्सटेन्सनसम्बन्धी अनुमति" अफ गर्नुभएको छ</translation>
<translation id="4676383270508741906">Agent Chrome को कुनै निश्चित सुविधा वा एक्स्टेन्सन खोज्न एड्रेस बारमा त्यसको सर्टकट टाइप गर्नुहोस् अनि आफूले चयन गरेको किबोर्ड की थिच्नुहोस्</translation>
<translation id="1098493699368672217">सिस्टम ट्रेमा Chromium प्रयोग गरी खोज्ने सुविधा देखाउनुहोस् र किबोर्ड सर्टकट अन गर्नुहोस्</translation>
<translation id="1104942323762546749">Chromium तपाईंका पासवर्डहरू निर्यात गर्न चाहन्छ। यसो गर्ने अनुमति दिन Windows को आफ्नो पासवर्ड टाइप गर्नुहोस्‌।</translation>
<translation id="112640046208448578">वस्तु वा ठाउँहरू पहिचान गर्नुहोस् र टेक्स्ट कपी वा अनुवाद गर्नुहोस्। तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा प्रयोग गर्दा यो पेजको एउटा स्क्रिनसट सर्भरमा पठाइन्छ। <ph name="LEARN_MORE" /></translation>
<translation id="5373975050135708711">Agent Chrome तपाईंको डिफल्ट ब्राउजर हो</translation>
<translation id="1131805035311359397">तपाईंका पासवर्डहरू कतै खुलासा भएका छन् कि छैनन् तथा सुरक्षासम्बन्धी अन्य समस्याबाट सुरक्षित छन् कि छैनन् भन्ने कुरा जाँच्न <ph name="BEGIN_LINK" />Chromium मा साइन इन गर्नुहोस्<ph name="END_LINK" />।</translation>
<translation id="1153368717515616349">Chromium मेनुमा क्लिक गर्नुहोस्</translation>
<translation id="1157985233335035034">हालसालै चयन गरिएका भाषाहरू</translation>
<translation id="1184145431117212167">तपाईंको डिभाइसमा भएको Windows को संस्करणमा नचल्ने भएकाले इन्स्टल गर्न सकिएन।</translation>
<translation id="604454529346438712">Agent Chrome का बारेमा</translation>
<translation id="1186645291482254714">आफ्नो फोनमा Chromium प्रयोग गरी मूल्य ट्र्याकिङसम्बन्धी अलर्टहरू प्राप्त गर्नुहोस्</translation>
<translation id="1203500561924088507">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME" /> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्नो ब्राउजर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="1232234696885483911">तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा खोल्दा PDF सहित पेजको शीर्षक, URL र कन्टेन्ट स्वतः सर्भरमा पठाइने छन्। <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">तपाईं साइन इन अवस्थामा भएका बेला आफ्नो Google खातामा सेभ गरिएका पासवर्ड तथा अन्य कुराहरू Chromium मा प्रयोग गर्न सक्नुहुन्छ। यो कुरा परिवर्तन गर्न “Chromium मा भएको तपाईंको खाता” मा जानुहोस्।</translation>
<translation id="1244381985120794049">Mac को मेनु बारमा Chromium मा उपलब्ध Gemini देखाउनुहोस्</translation>
<translation id="1257483544893909270">Chromium मा उपलब्ध Gemini मा स्क्रिनको कुनै भाग चयन गर्न किबोर्ड सर्टकट प्रयोग गर्नुहोस्।</translation>
<translation id="1262876892872089030">यो ट्याब निष्क्रिय हुँदा Chromium छिटो चल्ने बनाइराख्न मेमोरी खाली गरिएको थियो। तपाईं यो साइटलाई जुनसुकै बेला सक्रिय राखिराख्ने विकल्प छनौट गर्न सक्नुहुन्छ।</translation>
<translation id="3777643518642881741">यो फाइल खतरनाक भएकाले Agent Chrome ले यो फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" /> मार्फत Google का Gmail वा YouTube लगायतका सेवाहरूमा साइन इन गर्दा तपाईं उही खातामार्फत Chromium मा स्वतः साइन इन गर्न सक्नुहुन्छ</translation>
<translation id="1287534462498555020">आफ्नो फोनमा Chromium इन्स्टल गर्नुहोस्</translation>
<translation id="1290883685122687410">सेटअप गर्ने क्रममा निम्न त्रुटि भयो: <ph name="METAINSTALLER_EXIT_CODE" />। <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Chromium मा आफ्नो नयाँ प्रोफाइल सेटअप गर्नुहोस्</translation>
<translation id="132092532143527429">Chromium मा उपलब्ध Gemini प्रयोग गरी हेर्नुहोस्</translation>
<translation id="200785071050073583">Agent Chrome सँग ब्लुटुथ डिभाइसहरू खोज्नका निम्ति 
 ब्लुटुथको एक्सेस हुनु पर्छ। <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1329040302064168406">आफ्नो फोनमा Chromium मा साइन इन गर्नुहोस्</translation>
<translation id="1330562121671411446">भाषा पहिचान गर्नुहोस्</translation>
<translation id="1342274909142618978">यो जानकारी Chromium बाट पनि मेटाउनुहोस् (<ph name="URL" />)</translation>
<translation id="1345251407431278948">पिन गरियो! तपाईं टुलबारमा भएको नयाँ बटन थिचेर फोटो प्रयोग गरी खोज्ने सुविधा फेरि एक्सेस गर्न सक्नुहुन्छ</translation>
<translation id="1356661055722410047">नयाँ सुविधा! तपाईं आफ्नो स्क्रिनमा देखाइने टेक्स्ट र फोटो दुवै अनुवाद गर्न सक्नुहुन्छ</translation>
<translation id="1383876407941801731">खोज्नुहोस्</translation>
<translation id="1388276868779258475">जुनसुकै बेला जहाँसुकैबाट ब्राउज गर्न Chromium एप प्रयोग गर्नुहोस्</translation>
<translation id="141901961143729572">आफ्ना विचार व्यक्त गर्नुहोस्</translation>
<translation id="8789809509510733987">आफ्नो विन्डो सेयर गर्न सिस्टम सेटिङमा गई Agent Chrome लाई स्क्रिन रेकर्ड गर्ने अनुमति दिनुहोस्।</translation>
<translation id="1478370723027452770">Chrome for Testing का सम्बन्धमा मद्दत प्राप्त गर्नुहोस्</translation>
<translation id="1497802159252041924">इन्स्टल गर्ने क्रममा त्रुटि भयो: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">यो पेज सुरक्षित गरिएको छ</translation>
<translation id="3850708453627715578">Agent Chrome को ट्याब सेयर गर्नुहोस्</translation>
<translation id="154404805518949443">Chromium मा साइन इन गर्नुहोस्</translation>
<translation id="1547469039832541117">हाइलाइट गरिएको कार्य अन्त्य गर्छ।</translation>
<translation id="8546278207686764484">Agent Chrome पिन गर्नुहोस्</translation>
<translation id="1574377791422810894">Chromium का सुरक्षासम्बन्धी टुलहरू</translation>
<translation id="1594928384848033697">Chromium तपाईंको पासवर्ड म्यानेजरमा भएको जानकारी मेटाउन चाहन्छ। यसो गर्ने अनुमति दिन Windows को पासवर्ड टाइप गर्नुहोस्।</translation>
<translation id="551713766576210710">{COUNT,plural, =0{तपाईंका व्यवस्थापकका अनुसार तपाईंले यो अद्यावधिक लागू गर्न Agent Chrome पुनः सुरु गर्नु पर्ने हुन्छ}=1{तपाईंका व्यवस्थापकका अनुसार तपाईंले यो अद्यावधिक लागू गर्न Agent Chrome पुनः सुरु गर्नु पर्ने हुन्छ। तपाईंको इन्कोग्निटो विन्डो पुनः खुल्ने छैन।}other{तपाईंका व्यवस्थापकका अनुसार तपाईंले यो अद्यावधिक लागू गर्न Agent Chrome पुनः सुरु गर्नु पर्ने हुन्छ। तपाईंका # वटा इन्कोग्निटो विन्डो पुनः खुल्ने छैनन्।}}</translation>
<translation id="1623563412065267963">आफ्नो फोनमा Chromium एप इन्स्टल गरी Google का उत्कृष्ट सुविधाहरू प्राप्त गर्नुहोस्</translation>
<translation id="1625909126243026060">Chromium मा भएका गोपनीयता र सुरक्षासम्बन्धी मुख्य नियन्त्रण सुविधाहरूको समीक्षा गर्नुहोस्</translation>
<translation id="1640672724030957280">डाउनलोड गरिँदै छ...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" /> का रूपमा साइन इन गरिएको छ, सदस्यता। खाताको मेनु खोल्नुहोस्</translation>
<translation id="2604712040942461790">तपाईं म्यासेज, डकुमेन्ट तथा अन्य एपहरूमा भएका लिंकमा क्लिक गरी जुनसुकै बेला Agent Chrome प्रयोग गर्न सक्नुहुन्छ। यसलाई तपाईंको टास्कबारमा पनि पिन गरिने छ।</translation>
<translation id="1709772298389099340">यो सेवाले <ph name="BROWSER_NAME" /> का खास विशेषाधिकारहरू उपलब्ध गराउँछ।</translation>
<translation id="1722488837206509557">तपाईंले यो अनुमति दिनुभयो भने तपाईं उपलब्ध डिभाइसहरूमध्येबाट कुनै डिभाइस चयन गर्न र उक्त डिभाइसमा सामग्री देखाउन सक्नु हुने छ।</translation>
<translation id="4145295773323539953">Agent Chrome ले चाँडै नै ब्राउजिङ डेटा मेटाउने छ</translation>
<translation id="1736443181683099871">Chromium ले वेबपेजहरू लोड गर्न HTTPS प्रयोग गर्ने प्रयास गर्ने छ</translation>
<translation id="7280502947294080605">Agent Chrome सम्बन्धी डेटा हटाइयो</translation>
<translation id="1745121272106313518">Chromium <ph name="REMAINING_TIME" /> पछि रिस्टार्ट हुने छ</translation>
<translation id="1749104137266986751">HTTPS उपलब्ध नहुँदा Chromium ले तपाईंलाई चेतावनी नदिइकनै असुरक्षित कनेक्सन प्रयोग गर्ने छ</translation>
<translation id="1887395919652703120">क्रोमियम पृष्ठभूमिमा चलाउछन्</translation>
<translation id="1779356040007214683">Chromium लाई अझ सुरक्षित बनाउनको लागि, हामीले <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> मा सूचीकृत नगरिएका केही एक्स्टेन्सनहरूलाई अक्षम बनाएका छौँ र तपाईंलाई थाहा दिए बिना थपिएको हुन सक्छ।</translation>
<translation id="1793486931176048546">Chromium तुरुन्तै एक्सेस गर्न सकियोस् भन्नाका लागि यसलाई आफ्नो टास्कबारमा पिन गर्न Windows को नोटिफिकेसनमा देखिएको <ph name="BEGIN_BOLD" />अँ<ph name="END_BOLD" /> मा क्लिक गर्नुहोस्।</translation>
<translation id="357645171972700077">Agent Chrome पुनर्स्थापित गर्नुहोस्</translation>
<translation id="1820835682567584003">Chromium <ph name="AUTHENTICATION_PURPOSE" /> प्रयास गर्दै छ</translation>
<translation id="183031085822326697">तपाईंले अर्को पटक आफ्नो <ph name="DEVICE_TYPE" /> मा Chromium खोल्दा तपाईंलाई Google पासवर्ड म्यानेजर प्रयोग गर्ने प्रम्प्ट देखाइने छ।</translation>
<translation id="1838374766361614909">खोजी खाली गर्नुहोस्</translation>
<translation id="18552579716432081">तपाईंको Google खातामा ब्राउजिङ डेटा यथावत् राखी यो डिभाइसबाट मात्र ब्राउजिङ डेटा मेटाउन <ph name="BEGIN_LINK" />Chromium बाट साइन आउट गर्नुहोस्<ph name="END_LINK" />।</translation>
<translation id="1857749206890802997">जुनसुकै बेला जहाँसुकैबाट नयाँ ट्याब समूहहरू खोल्न वा बनाउन आफ्नो फोनमा Chromium डाउनलोड गर्नुहोस्।</translation>
<translation id="185970820835152459">तपाईं साइन इन गरिएका आफ्ना Google खाताहरू व्यवस्थापन गर्न सक्नुहुन्छ। तपाईंका Google खाताहरू Chromium ब्राउजर, Play स्टोर, Gmail र अन्य एपहरूमा प्रयोग गरिन्छन्। तपाईं परिवारका सदस्य जस्ता अरू कसैको खाता थप्न चाहनुहुन्छ भने उहाँको खाता थप्नुको साटो उहाँलाई नयाँ व्यक्तिका रूपमा आफ्नो <ph name="DEVICE_TYPE" /> मा सामेल गराउनुहोस्। <ph name="LINK_BEGIN" />थप जान्नुहोस्<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">फोटो प्रयोग गरी खोज्ने सुविधामार्फत खोज्नुहोस्</translation>
<translation id="1863837059069884561"><ph name="EXISTING_USER" /> ले पहिलेदेखि नै साइन इन गर्नुभएको छ। छुट्टै ब्राउजर प्रयोग गर्न <ph name="USER_EMAIL_ADDRESS" /> मार्फत आफ्नै प्रोफाइल प्रयोग गरी Chromium मा साइन इन गर्नुहोस्। तपाईं <ph name="DEVICE" /> बाट आफ्ना बुकमार्क र अन्य विवरणहरू पनि प्राप्त गर्नु हुने छ।</translation>
<translation id="1880677175115548835">टेक्स्ट म्यासेज चयन गर्नुहोस्</translation>
<translation id="1881322772814446296">तपाईंले व्यवस्थित खातासँगै साइन इन गरि यसको व्यवस्थापकलाई तपाईंको क्रोमियम प्रोफाइल माथि नियन्त्रण दिइरहनुभएको छ। तपाईंको क्रोमियम डाटा, जस्तै तपाईंका एप्स, बुकमार्कहरू, इतिहास, पासवर्डहरू, र अन्य सेटिङहरू <ph name="USER_NAME" /> मा स्थायी रूपमा बाँधिनेछन्। तपाईं यस डाटालाई गूगल खाता ड्यासबोर्ड मार्फत मेटाउन सक्षम हुनुहुनेछ, तर तपाईं यस खातालाई अर्को खातामा संलग्न गर्न सक्षम हुनुहुनेछैन। तपाईंले आफ्नो विद्यमान क्रोमियम डाटालाई अलग राख्न वैकल्पिक रूपमा नयाँ प्रोफाइल सिर्जना गर्न सक्नुहुन्छ। <ph name="LEARN_MORE" /></translation>
<translation id="4964792828232534953">Agent Chrome ले ब्याकग्राउन्डमा हुने गतिविधि र निर्वाध स्क्रोलिङ तथा भिडियोको फ्रेम रेटलगायतका भिजुअल इफेक्टहरू सीमित पारेर ब्याट्रीको पावर जोगाउँछ। <ph name="BEGIN_LINK" />इनर्जी सेभरका बारेमा थप जान्नुहोस्<ph name="END_LINK" /></translation>
