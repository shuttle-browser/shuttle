<translation id="829957199361894387">Agent Chrome ले चाँडै नै विन्डोहरू बन्द गर्ने र डेटा मेटाउने छ</translation>
<translation id="6145820983052037069">तपाईं यहाँबाट Chromium मा रहेको एक प्रोफाइलबाट अर्को प्रोफाइलमा जान सक्नुहुन्छ</translation>
<translation id="8333733115616087710">तपाईंले कुकीहरू प्रयोग गर्ने अनुमति दिनुभयो भने Agent Chrome ले पेजहरू प्रिलोड गर्दा ती कुकीहरू प्रयोग गर्न सक्छ</translation>
<translation id="6165508094623778733">थप जान्नुहोस्</translation>
<translation id="6173308241973263798">आफ्नो खातामा भएको Chromium को जानकारी मेटाउनुहोस्</translation>
<translation id="8439223334931595792">यो फाइल खतरनाक हुन सक्छ<ph name="LINE_BREAK" />तपाईंले पासवर्ड प्रदान गर्नुभयो भने Agent Chrome ले तपाईंका तर्फबाट यो फाइलको जाँच गरिदिन सक्छ। यो फाइलसम्बन्धी जानकारी Google सुरक्षित ब्राउजिङमा पठाइन्छ तर फाइलमा भएको सामग्री र पासवर्ड तपाईंकै डिभाइसमा रहन्छन्।</translation>
<translation id="6182736845697986886">अपडेट सर्भरमा आन्तरिक त्रुटि भएकाले इन्स्टल गर्न सकिएन।</translation>
<translation id="6183079672144801177">तपाईंले आफ्नो <ph name="TARGET_DEVICE_NAME" /> मा Chromium मा साइन इन गर्नुभएको छ भन्ने कुरा सुनिश्चित गर्नुहोस् अनि फेरि पठाउनुहोस्।</translation>
<translation id="6212496753309875659">यो कम्प्युटरमा पहिले नै Chromium को अझ हालैको संस्करण छ। यदि सफ्टवेयरले काम गरिरहेको छैन भने, कृपया Chromium को स्थापना हटाएर पुन: प्रयास गर्नुहोस्।</translation>
<translation id="6375381612105819561">{0,plural, =0{Agent Chrome अब पुनः सुरु हुने छ}=1{Agent Chrome १ सेकेन्डमा पुनः सुरु हुने छ}other{Agent Chrome # सेकेन्डमा पुनः सुरु हुने छ}}</translation>
<translation id="6241367896540709610">फाइल डाउनलोड गर्न Chromium लाई भण्डारण प्रयोग गर्ने अनुमति दिनु पर्ने हुन्छ</translation>
<translation id="6245734527075554892">यो सुविधाले Chromium मा भण्डारण गरिएका असुरक्षित साइटको सूची जाँच गरी URL हरू सुरक्षित छन् कि छैनन् भन्ने कुरा यकिन गर्छ</translation>
<translation id="5070229316792137581">क्रोमियमलाई डिफल्ट ब्राउजर बनाउनुहोस्</translation>
<translation id="6248988683584659830">खोज सेटिङहरू</translation>
<translation id="6261803579884938625">आफ्नो फोनमा Chromium एप इन्स्टल गरी जुनसुकै बेला जहाँसुकैबाट Google का उत्कृष्ट सुरक्षा सुविधाहरू प्राप्त गर्नुहोस्</translation>
<translation id="6268381023930128611">Chromium बाट साइन आउट गर्ने हो?</translation>
<translation id="6270547683008298381">यी ट्याबले अतिरिक्त स्रोतहरू प्रयोग गरिरहेका छन्। पर्फर्मेन्स अझ राम्रो बनाउन Chromium लाई यी ट्याब निष्क्रिय बनाउन दिनुहोस्।</translation>
<translation id="6281746429495226318">आफ्नो Chromium प्रोफाइल आफूले चाहे जस्तो बनाउनुहोस्</translation>
<translation id="6290827346642914212">आफ्नो Chromium प्रोफाइलको नाम राख्नुहोस्</translation>
<translation id="6294831894865512704">एउटा एक्स्टेन्सनले तपाईंलाई Chromium मा साइन गर्न अनुरोध गरिरहेको छ</translation>
<translation id="1356965940380155951"><ph name="FILE_NAME" /> खतरनाक हुन सक्छ, त्यसैले Agent Chrome ले यसमाथि रोक लगाएको छ।</translation>
<translation id="7321042153033393145">Agent Chrome ले तपाईंको क्यामेरा प्रयोग गरिरहेको छ।</translation>
<translation id="6333502561965082103">Chromium मा अर्को कारबाही जारी छ। कृपया पछि फेरि प्रयास गर्नुहोस्।</translation>
<translation id="6334986366598267305">अब तपाइँको Google खातासँग र साझा गरिएका कम्प्युटरहरूसँग Chromium प्रयोग गर्न सजिलो छ।</translation>
<translation id="6347002662287820329">Chromium लाई आफ्नो डिफल्ट ब्राउजरका रूपमा सेट गर्नुहोस् अनि आफूलाई थाहा भएका, मन पर्ने र विश्वास लाग्ने सुविधाहरू सजिलैसँग एक्सेस गर्नुहोस्।</translation>
<translation id="6663103136563143835">Agent Chrome को सर्टकट</translation>
<translation id="8324836837188781073">यो फाइल सामान्यतया डाउनलोड नगरिने र खतरनाक हुन सक्ने भएकाले Agent Chrome ले यो फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="6373523479360886564">के तपाइँ पक्का हुनुहुन्छ कि तपाइँ Chromium विस्थापित गर्न चाहनुहुन्छ?</translation>
<translation id="6375219077595103062">पासवर्ड म्यानेजरमा सर्टकट हाल्नुहोस्</translation>
<translation id="6388799252195623474">यस सम्बन्धमा मलाई मद्दत गर्नुहोस्</translation>
<translation id="6390800440335263989">जारी राख्न <ph name="EMAIL" /> मार्फत Chromium मा साइन इन गर्नुहोस्। तपाईंले यसो गर्नुभयो भने तपाईंले आफ्नो सङ्गठनका नीतिहरूको पालना गर्नुभएको छ भन्ने कुरा सुनिश्चित हुन्छ।</translation>
<translation id="6400112897226594999">कम्प्युटरको स्क्रिनमा भएको Chromium को लोगो।</translation>
<translation id="6403826409255603130">क्रोमियम बिजुली गति संग वेबपेजहरु र आवेदनसँग चल्ने एक वेब ब्राउजर हो। यो तेज, स्थिर, र प्रयोग गर्न सजिलो छ। क्रोमियममा निर्मित फिशिंग र मैलवेयर संरक्षणसंग र अधिक सुरक्षित वेब ब्राउज गर्नुहोस् ।</translation>
<translation id="6414624068245092115">तपाईं आफ्नो Google खातामा Chromium को डेटा सधैँ प्रयोग गर्न र सेभ गर्न सक्नुहुन्छ भन्ने कुरा सुनिश्चित गर्न आफ्नो पहिचान पुष्टि गर्नुहोस्</translation>
<translation id="5698692159722140301">Agent Chrome अझ चाँडो चल्छ र JavaScript प्रयोग गर्ने सुविधाहरूले डिजाइन गरिएअनुसार काम गर्नु पर्ने हो</translation>
<translation id="6436260184216827876">फोटो प्रयोग गरी खोज्ने सुविधा उपलब्ध छैन। पछि फेरि प्रयास गर्नुहोस्।</translation>
<translation id="6442900851116057561">ChromiumOS रिस्टार्ट गर्नुहोस्</translation>
<translation id="1150325299163558144">Agent Chrome ले तपाईंले खोल्न सक्ने अझ धेरै पेजहरू प्रिलोड गर्छ। तपाईंले ती पेज खोल्दा ती पेजहरू अझ छिटो लोड होऊन् भन्नाका लागि Agent Chrome ले यसो गर्छ</translation>
<translation id="6450948450282634257">मूल्यहरू ट्र्याक गर्न र कुनै पनि साइटमा मूल्य घटेका खण्डमा अलर्ट प्राप्त गर्न आफ्नो फोनमा Chromium डाउनलोड गर्नुहोस्</translation>
<translation id="2302438614865168038">अफ छ • Agent Chrome ले यो एक्स्टेन्सनको स्रोतका बारेमा पुष्टि गर्न सक्दैन</translation>
<translation id="6455857529632101747">Chromium का प्रोफाइलमा तपाईंलाई स्वागत छ</translation>
<translation id="6460614424172581323">तपाईंले अर्को पटक आफ्नो <ph name="DEVICE_TYPE" /> मा Chromium खोल्दा तपाईंलाई ट्याब समूहहरू प्रयोग गर्ने प्रम्प्ट देखाइने छ।</translation>
<translation id="6466344609055215035">Chromium बाट खाता हटाउनुहोस्</translation>
<translation id="5526497172610025231">तपाइँले क्रोमियम सुरु गर्दा कुन पृष्ठ देखाउँछ भनेर पनि यसले नियन्त्रण गर्छ।</translation>
<translation id="648319183876919572">परिष्कृत Safe Browsing सुविधाले तपाईंलाई खतरनाक वेबसाइट तथा डाउनलोडबाट थप सुरक्षित राख्छ</translation>
<translation id="6510925080656968729">Chromium को स्थापना हटाउनुहोस्</translation>
<translation id="124295298108005714">सर्टकट Agent Chrome मा खुल्छ</translation>
<translation id="9177671044583442813">तपाईंको सङ्गठनले तोकेको नियमअनुसार तपाईंले <ph name="TIMEOUT_DURATION" /> सम्म Agent Chrome प्रयोग गर्नुभएन भने त्यो स्वतः बन्द हुन्छ। ब्राउजिङ डेटा मेटाइयो। यसअन्तर्गत हिस्ट्री, अटोफिल तथा डाउनलोड समावेश हुन सक्छन्।</translation>
<translation id="6542839706527980775">हरेक प्रोफाइलका आफ्नै बुकमार्क, इतिहास, पासवर्डलगायत Chromium का सबै जानकारी हुन्छन्</translation>
<translation id="6556755379298048869">किबोर्ड सर्टकट प्रयोग गरी खोज्नुहोस्।</translation>
<translation id="5677032436425073715"><ph name="BEGIN_LINK" />Agent Chrome ले तपाईंको डेटा कसरी गोप्य राख्छ<ph name="END_LINK" /> भन्ने बारेमा थप जान्नुहोस्</translation>
<translation id="5967753610833950399">Agent Chrome रिस्टार्ट गरिएपछि मात्र यो सेटिङमा गरिएका परिवर्तनहरू लागू हुने छन्।</translation>
<translation id="4790842900919490952">Agent Chrome को मुख्य मेनुमा रहेको "एक्स्टेन्सनहरू" मा क्लिक गरी आफ्ना एक्स्टेन्सनहरू व्यवस्थापन गर्नुहोस्।</translation>
<translation id="656935081669708576">तपाईं Chromium को अर्कै प्रोफाइलमा सेभ गरिएका पासवर्डहरू हेर्न चाहनुहुन्छ भने प्रोफाइल बदल्न सक्नुहुन्छ</translation>
<translation id="6569556444379005948">जुनसुकै बेला जहाँसुकैबाट उत्कृष्ट AI टुलहरू प्रयोग गर्न Chromium एप प्रयोग गर्नुहोस्</translation>
<translation id="8124768693572849485">Agent Chrome ले तपाईंले पाठ क्षेत्रहरूमा टाइप गर्ने पाठ हिज्जेसम्बन्धी त्रुटि सच्याउने प्रयोजनका लागि Google मा पठाउँछ</translation>
<translation id="6598877126913850652">Chromium को सूचनासम्बन्धी सेटिङहरूमा जानुहोस्</translation>
<translation id="6600016381025017075">यो पेजमा भएको जुनसुकै कुरा खोज्नुहोस्</translation>
<translation id="1736130262142947818">तपाईंले अर्को पटक Agent Chrome लाई पुन: लन्च गर्दा तपाईंका परिवर्तनहरू प्रभावमा आउनेछन्।</translation>
<translation id="6637908313088374648">तपाईं तुरुन्तै ब्राउज गर्न थाल्न सक्नुहोस् भन्नाका लागि अब Windows सुरु हुँदा Chromium पनि सुरु हुन्छ। तपाईं सेटिङमा गई यो सुविधा अफ गर्न सक्नुहुन्छ।</translation>
<translation id="6648212540664651655">आफूले छाडेकै ठाउँबाट जारी राख्नुहोस्: Chromium ले तपाईंको पछिल्लो सत्रमा खोलिएका ट्याबहरू रिस्टोर गरेको छ। तपाईं निम्नमा गई यसलाई अफ गर्न सक्नुहुन्छ:</translation>
<translation id="665732753414869868">तपाईं वरपरको ठाउँको 3D नक्सा बनाउन Chromium लाई क्यामेरा प्रयोग गर्ने अनुमति दिनु पर्ने हुन्छ</translation>
<translation id="6669284030132180248">तपाईं आफ्ना बुकमार्कहरू Google खातामा पनि सेभ गर्नुहुन्छ भने तपाईं Chromium मा उत्पादनका मूल्यहरू ट्र्याक गर्न र मूल्य घट्दा सूचना प्राप्त गर्न सक्नुहुन्छ</translation>
<translation id="6676384891291319759">इन्टरनेट एक्सेस गर्नुहोस्</translation>
<translation id="668175097507315160">साइन इन गर्ने क्रममा त्रुटि भएकाले ChromiumOS ले तपाईंको डेटा सिंक गर्न सकेन।</translation>
<translation id="6691132793308828750">Chromium बाट यो एपसको डेटा हटाउनुहोस्</translation>
<translation id="6709350901466051922">यो साइट चलाउन Chromium लाई माइक्रोफोन प्रयोग गर्ने अनुमति दिनु पर्ने हुन्छ</translation>
<translation id="6712881677154121168">डाउनलोड गर्ने क्रममा त्रुटि भयो: <ph name="DOWNLOAD_ERROR" />।</translation>
<translation id="7755971898820142787">तपाईंको प्रोफाइललाई प्रयोग गर्न सकिँदैन किनभने यो Agent Chrome एउटा नयाँ संस्करणबाट ल्याइएको हो।

केही सुविधाहरू अनुपलब्ध हुन सक्छन्। कृपया एउटा भिन्न प्रोफाइल डाइरेक्टरी निर्दिष्ट गर्नुहोस् वा Agent Chrome को कुनै अझ नया सँस्करण प्रयोग गर्नुहोस्।</translation>
<translation id="6729124504294600478">पर्सनलाइजेसन र अन्य सुविधाहरू प्राप्त गर्न Chromium लाई वेब तथा एपसम्बन्धी गतिविधि र Google का लिंक गरिएका सेवाहरूमा समावेश गर्नुहोस्</translation>
<translation id="6734291798041940871">तपाईँको कम्प्युटरमा पहिले नै सबै प्रयोगकर्ताहरूका लागि Chromium को स्थापना गरिएको छ।</translation>
<translation id="6742093177587589736">आफ्ना सबै डिभाइसमा आफ्ना बुकमार्कलगायतका थप कुराहरू प्राप्त गर्न Chromium मा साइन इन गर्नुहोस्। तपाईंले साइन इन गरेपछि यो बुकमार्क तपाईंको Google खातामा सेभ गरिने छ।</translation>
<translation id="7821834337023193240">Agent Chrome को V8 इन्जिनले साइटहरूको गति बढाउँछ तर यसले Agent Chrome मा सुरक्षासम्बन्धी आक्रमणहरू हुने सम्भावना भने बढाउँछ। यो सेटिङ अन छ।</translation>
<translation id="6754665438209053659">{count,plural, =1{तपाईंको Chromium का केही डेटा अहिलेसम्म तपाईंको Google खातामा सेभ गरिएका छैनन्। साइन आउट गर्नुअघि केही बेर पर्खी हेर्नुहोस्। तपाईंले अहिले नै साइन आउट गर्नुभयो भने यो डेटा (एउटा सामग्री) मेटिने छ।}other{तपाईंको Chromium का केही डेटा अहिलेसम्म तपाईंको Google खातामा सेभ गरिएका छैनन्। साइन आउट गर्नुअघि केही बेर पर्खी हेर्नुहोस्। तपाईंले अहिले नै साइन आउट गर्नुभयो भने यी डेटा ({count} वटा सामग्री) मेटिने छन्।}}</translation>
<translation id="67706546131546258">यो फाइल जोखिमपूर्ण हुन सक्ने भएकाले Chromium ले यो फाइल स्क्यान गर्न सिफारिस गर्छ।</translation>
<translation id="6779406956731413166">ChromiumOS अतिरिक्त <ph name="BEGIN_LINK_CROS_OSS" />खुला स्रोत सफ्टवेयर<ph name="END_LINK_CROS_OSS" /> प्रयोग गरी निर्माण गरिएको हो।</translation>
