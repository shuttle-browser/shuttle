             <message name="IDS_ADVANCED_PROTECTION_RELAUNCH_REQUIRED_BODY" desc="The body text of a dialog that tells Advanced Protection users the browser must be relaunched with Incognito counter">
             {COUNT, plural,
              =0 {Advanced Protection requires that you relaunch Shuttle to apply an update}
              =1 {Advanced Protection requires that you relaunch Shuttle to apply an update. Your Incognito window won't reopen.}
              other {Advanced Protection requires that you relaunch Shuttle to apply an update. Your # Incognito windows won't reopen.}}
          </message>
        </if>
      </if>
      <!-- Chromium launch blocking dialog. -->
      <if expr="not is_android and not is_chromeos">
         <message name="IDS_ENTERPRISE_STARTUP_CLOUD_POLICY_ENROLLMENT_TOOLTIP" desc="The information message of Chromium launch blocking dialog for machine level user cloud policy enrollment.">
          Launching Shuttle...
        </message>
        <message name="IDS_ENTERPRISE_STARTUP_CLOUD_POLICY_ENROLLMENT_ERROR" desc="The error message of Chromium launch blocking dialog when machine level user cloud policy enrollment failed.">
          Couldn't launch Shuttle. Try again.
        </message>
        <message name="IDS_ENTERPRISE_STARTUP_RELAUNCH_BUTTON" desc="The text of relaunch button of Chromium launch blocking dialog.">
          Relaunch Shuttle
        </message>
      </if>
      <message name="IDS_DESKTOP_MEDIA_PICKER_TITLE_WEB_CONTENTS_ONLY" desc="Title for the window picker dialog shown when desktop capture of a tab is requested by an app.">
        Share a Shuttle tab
      </message>
      <!-- Idle timeout bubble. -->
      <if expr="toolkit_views">
        <message name="IDS_IDLE_BUBBLE_TITLE_CLOSE" desc="Title of a bubble that informs the user that Chrome closed automatically, because they were away from the computer for X minutes.">
          Shuttle was automatically closed
        </message>
        <message name="IDS_IDLE_BUBBLE_BODY_CLOSE_AND_CLEAR" desc="Body of a bubble that informs the user that Chromium closed + cleared data automatically, because they were away from the computer for X minutes.">
          Your organization closes Shuttle when it isn't used for <ph name="TIMEOUT_DURATION">$1<ex>30 minutes</ex></ph>. Browsing data was deleted. This could include history, autofill, and downloads.
        </message>
        <message name="IDS_IDLE_BUBBLE_BODY_CLEAR" desc="Body of a bubble that informs the user that Chromium cleared data automatically, because they were away from the computer for X minutes.">
          Your organization deletes Shuttle data when it isn't used for <ph name="TIMEOUT_DURATION">$1<ex>30 minutes</ex></ph>. This could include history, autofill, and downloads.
        </message>
        <message name="IDS_IDLE_BUBBLE_BODY_CLOSE" desc="Body of a bubble that informs the user that Chromium closed automatically, because they were away from the computer for X minutes.">
          Your organization closes Shuttle when it isn't used for <ph name="TIMEOUT_DURATION">$1<ex>30 minutes</ex></ph>.
        </message>
      </if>
      <!-- Idle timeout dialog. -->
      <if expr="not is_android and not is_chromeos">
        <message name="IDS_IDLE_TIMEOUT_CLOSE_TITLE" desc="Title of the Idle Timeout dialog, warning the user that their windows are about to close.">
          Shuttle will soon close
        </message>
        <message name="IDS_IDLE_TIMEOUT_CLEAR_TITLE" desc="Title of the Idle Timeout dialog, warning the user that their browsing data will be lost soon.">
          Shuttle will soon delete browsing data
        </message>
        <message name="IDS_IDLE_TIMEOUT_CLOSE_AND_CLEAR_TITLE" desc="Title of the Idle Timeout dialog, warning the user that their windows are about to close and their browsing data will be lost.">
          Shuttle will soon close and delete data
        </message>
        <message name="IDS_IDLE_TIMEOUT_CLOSE_BODY" desc="First sentence in the Idle Timeout dialog, warning the user that Chromium is going to close automatically.">
          {COUNT, plural,
          =1 {Your organization automatically closes Shuttle when it isn't used for 1 minute.}
          other {Your organization automatically closes Shuttle when it isn't used for # minutes.}}
        </message>
        <message name="IDS_IDLE_TIMEOUT_CLEAR_BODY" desc="First sentence in the Idle Timeout dialog, warning the user that Chromium is going to clear data automatically.">
          {COUNT, plural,
          =1 {Your organization automatically deletes browsing data when Shuttle isn't used for 1 minute. This could include history, autofill, and downloads. Your tabs will stay open.}
          other {Your organization automatically deletes browsing data when Shuttle isn't used for # minutes. This could include history, autofill, and downloads. Your tabs will stay open.}}
        </message>
        <message name="IDS_IDLE_TIMEOUT_CLOSE_AND_CLEAR_BODY" desc="First sentence in the Idle Timeout dialog, warning the user that Chromium is going to close and clear data automatically.">
          {COUNT, plural,
          =1 {Your organization automatically closes Shuttle when it isn't used for 1 minute. Browsing data is deleted. This could include history, autofill, and downloads.}
          other {Your organization automatically closes Shuttle when it isn't used for # minutes. Browsing data is deleted. This could include history, autofill, and downloads.}}
        </message>
        <message name="IDS_IDLE_DISMISS_BUTTON" desc="Button label in the Idle Timeout dialog, this button dismisses the dialog and prevents browsers from closing automatically.">
          Continue using Shuttle
        </message>
      </if>
      <!-- User happiness tracking survey UI -->

      <!-- HaTS invitations on Android -->

      <!-- Chrome parent extension/app install blocking dialog. -->
      <if expr="enable_extensions_core">
        <message name="IDS_EXTENSION_PERMISSIONS_BLOCKED_BY_PARENT_PROMPT_MESSAGE" desc="Text for the dialog indicating that a parent has blocked extensions and apps.">
         Your parent has turned off "Permissions for sites, apps and extensions" for Shuttle
        </message>
      </if>




      <!-- ChromeLabs bubble -->
      <message name="IDS_CHROMELABS_RELAUNCH_FOOTER_MESSAGE" desc="Text that shows in the footer of the Chrome Labs bubble when relaunch is needed for changes to take effect.">
        Your changes will take effect the next time you relaunch Shuttle.
      </message>

      <!-- Device Chooser Prompt -->
      <message name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH" desc="Text shown in the Web Serial Chooser when browser does not have Bluetooth permission. The '&#10;' is a newline character to force the desired line wrapping.">
        Shuttle needs Bluetooth access to explore &#10; Bluetooth devices. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK">$1<ex>Open Preferences</ex></ph>
      </message>


      <!--Launch On Startup-->
      <if expr="is_win">
        <message name="IDS_SETTINGS_FOREGROUND_LAUNCH_ON_STARTUP_LABEL" desc="Label for settings toggle button that enables or disables opening Chromium on system startup">
          Launch Shuttle when Windows starts
        </message>
        <message name="IDS_SETTINGS_FOREGROUND_LAUNCH_ON_STARTUP_SUB_LABEL" desc="Sub label for settings toggle button that enables or disables opening Chromium on system startup">
          Launch Shuttle automatically to begin browsing instantly.
        </message>
      </if>

      <!-- Advanced security settings -->
      <message name="IDS_SETTINGS_SECURITY_JAVASCRIPT_OPTIMIZATION_LINK_ROW_ENABLED" desc="Description for the link row of the Javascript-optimization page when javascript-optimization is enabled.">
        Speeds up sites with Shuttle's V8 engine but makes Shuttle slightly less resistant to attacks. This setting is on.
      </message>
      <message name="IDS_SETTINGS_SECURITY_JAVASCRIPT_OPTIMIZATION_LINK_ROW_DISABLED" desc="Description for the link row of the Javascript-optimization page when javascript-optimization is disabled.">
        Speeds up sites with Shuttle's V8 engine but makes Shuttle slightly less resistant to attacks. This setting is off.
      </message>
      <message name="IDS_SETTINGS_SITE_SETTINGS_JAVASCRIPT_OPTIMIZER_DESCRIPTION" desc="Description of the JavaScript optimizer content setting.">
        Speeds up sites with Shuttle's V8 engine but makes Shuttle slightly less resistant to attacks
      </message>
      <message name="IDS_SETTINGS_SITE_SETTINGS_JAVASCRIPT_OPTIMIZER_ALLOWED_SUB_LABEL" desc="Sub-label for the enabled option of the JavaScript optimizer content setting.">
        Shuttle runs faster and features that use JavaScript should work as designed
      </message>
      <message name="IDS_SETTINGS_SITE_SETTINGS_JAVASCRIPT_OPTIMIZER_BLOCKED_SUB_LABEL" desc="Sub-label for the disabled option of the JavaScript optimizer content setting.">
        Reduces performance but makes Shuttle more resistant to attacks
      </message>
      <!-- ChromiumUpdater Strings -->

      <!-- Memory Saver Chip strings -->

      <!-- Memory Saver IPH strings -->

      <!-- Performance Intervention Dialog strings -->


      <!-- New Create Shortcut View Strings -->
      <if expr="not is_android and not is_chromeos">
        <message name="IDS_CREATE_SHORTCUT_NOT_APPS_DIALOG_SUBTITLE" desc="Subtitle of the updated Create Shortcut dialog about how the site opens for Chromium">
          Shortcuts open in Shuttle
        </message>
      </if>
      <if expr="is_macosx">
        <message name="IDS_CHROMIUM_SHORCUT_DESCRIPTION" desc="Text to use as description for the '.crwebloc' file format, which is generated by the 'Save and Share' -> 'Create Shortcut' flow.">
          Shuttle Shortcut
        </message>
      </if>

      <!-- Toast Strings-->
      <if expr="not is_android">
        <message name="IDS_CLEAR_BROWSING_DATA_TOAST_BODY" desc="Text on a toast notification that is shown when browsing data is successfully cleared.">
          Cleared Shuttle data
        </message>
      </if>



      <message name ="IDS_GLIC_INELIGIBLE_PROFILE_NOTICE" translateable="false" desc="This is the text of the glic ineligible profile notice.">
        To use Gemini in Shuttle, sign in with a different Google Account
      </message>




      <!-- UNO Promo strings for extensions -->


      <!-- Dice Migration strings -->
      <message name="IDS_DICE_MIGRATION_CONFIRMATION_TOAST_MESSAGE" desc="The confirmation message shown in a toast after the user clicks on the accept button on the Dice Migration dialog.">
        You now have more features available in Shuttle
      </message>
      <message name="IDS_DICE_MIGRATION_CONFIRMATION_TOAST_BUTTON" desc="The text on the button of the confirmation toast shown after the user clicks the accept button on the Dice Migration dialog, that allows the users to control the sync settings or sign out of Chrome.">
        Manage
      </message>

      <!-- Profile menu strings -->

      <!-- Dictation strings -->
      <!-- TODO(b/510738735): Marked non-translateable as the feature
      isn't yet shipping these aren't yet finalized. -->

      <!--Desktop to iOS promo strings-->

      <!--Default Search Engine Reset Notification-->
      <message name="IDS_DEFAULT_SEARCH_ENGINE_RESET_NOTIFICATION_TITLE"
         desc="Title of the notification shown when Chromium resets the default search engine (DSE) due to preference tampering.">
        Your settings were changed by an unknown app
      </message>
      <message name="IDS_DEFAULT_SEARCH_ENGINE_RESET_NOTIFICATION_BODY"
         desc="Body text of the notification shown when Chromium resets the default search engine, explaining that a change from outside Chromium was detected.">
        Your search engine was changed from outside of Shuttle. To protect you, Shuttle reset it to its original default. <ph name="LEARN_MORE_LINK">$1<ex>Learn more</ex></ph>
      </message>
      <message name="IDS_DEFAULT_SEARCH_ENGINE_RESET_NOTIFICATION_GOT_IT_BUTTON"
         desc="Label for the 'Got it' button in the default search engine reset notification, which dismisses the UI.">
        Got it
      </message>
      <message name="IDS_DEFAULT_SEARCH_ENGINE_RESET_NOTIFICATION_LEARN_MORE_BUTTON"
         desc="Label for the 'Learn more' link in the default search engine reset notification, which opens a help center article.">
        Learn more
      </message>
      <message name="IDS_DEFAULT_SEARCH_ENGINE_RESET_NOTIFICATION_SEARCH_SETTINGS_BUTTON"
         desc="Label for the 'Search settings' button in the default search engine reset notification, which opens the search engine settings page.">
        Search settings
      </message>


      <!-- JS optimizations bubble -->
      <message name="IDS_JS_OPTIMIZATION_BUBBLE_BODY_NON_POLICY_BODY" desc="Body text for the JavaScript optimization bubble when disabled for other reasons.">
        For security, Shuttle turns off JavaScript optimization when you visit a site for the first time.&#xA;
If this page isn’t working as expected, try allowing optimization.
      </message>

      <!-- Linux strings restored with their upstream conditions -->
      <if expr="is_linux">
      <message name="IDS_DESKTOP_SHORTCUT_COMMENT" desc="Description of the desktop shortcut file which will open a Chrome tab at a given url.">
          Open <ph name="URL">$1<ex>https://www.example-url.com/</ex></ph> in a new tab in Shuttle.
        </message>
      </if>
      <if expr="is_linux">
      <message name="IDS_LINUX_OBSOLETE" desc="A message displayed on an at-launch infobar and about:help warning the user that the OS version they are using is no longer supported.">
          Shuttle may not function correctly because it is no longer supported on this Linux distribution
        </message>
      </if>
      <if expr="is_linux">
      <message name="IDS_TERMS_DIALOG_ACCEPT" desc="The button label to accept the terms of service">
          Accept
        </message>
      </if>
      <if expr="is_linux">
      <message name="IDS_TERMS_DIALOG_ACCESSIBILITY_LABEL" desc="Accessibility label for the Terms of Service in the dialog. The actual terms text is just a placeholder for branded builds.">
          Shuttle Additional Terms of Service
        </message>
      </if>
      <if expr="is_linux">
      <message name="IDS_TERMS_DIALOG_CANCEL" desc="The button label to decline the terms of service">
          Cancel
        </message>
      </if>
      <if expr="is_linux">
      <message name="IDS_TERMS_DIALOG_TITLE" desc="Window title for the Terms of Service dialog">
          Shuttle Additional Terms of Service
        </message>
      </if>
    </messages>
  </release>
</grit>
