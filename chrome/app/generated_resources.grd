      </message>
      <message name="IDS_READ_LATER_ADD_CURRENT_TAB" desc="Label for button to add the current tab to Read later">
        Add current tab
      </message>
      <message name="IDS_READ_LATER_MARK_CURRENT_TAB_READ" desc="Label for button to mark the current tab as read in Read Later">
        Mark current tab as read
      </message>

      <!-- Read Later context menu -->
      <if expr="use_titlecase">
        <message name="IDS_READ_LATER_CONTEXT_MENU_MARK_AS_UNREAD" desc="Label for context menu item to a read later entry as unread. (In title case.)">
          Mark as Unread
        </message>
        <message name="IDS_READ_LATER_CONTEXT_MENU_MARK_AS_READ" desc="Label for context menu item to a read later entry as read. (In title case.)">
          Mark as Read
        </message>
      </if>
      <if expr="not use_titlecase">
        <message name="IDS_READ_LATER_CONTEXT_MENU_MARK_AS_UNREAD" desc="Label for context menu item to a read later entry as unread.">
          Mark as unread
        </message>
        <message name="IDS_READ_LATER_CONTEXT_MENU_MARK_AS_READ" desc="Label for context menu item to a read later entry as read.">
          Mark as read
        </message>
      </if>
      <message name="IDS_READ_LATER_CONTEXT_MENU_DELETE" desc="Label for context menu item to a delete a read later entry.">
        Delete
      </message>

      <!-- Reading List submenu in App Menu -->
      <message name="IDS_READING_LIST_MENU" desc="The title of the Reading List submenu in the App Menu">
        &amp;Reading list
      </message>
      <message name="IDS_READING_LIST_MENU_ADD_TAB" desc="">
        Add tab to reading list
      </message>
      <message name="IDS_READING_LIST_MENU_SHOW_UI">
