      <message name="IDS_EXTENSIONS_MENU_REQUESTS_ACCESS_SECTION_ALLOW_BUTTON_ACCESSIBLE_NAME" desc="Accessible string on the allow button for each extension in the requests access section that grants site access to such extension." formatter_data="android_java">
