      </message>

      <!-- Side panel strings -->
      <message name="IDS_ACCNAME_SIDE_PANEL_RESIZE" is_accessibility_with_no_ui="true" desc="Screen reader announcement when the side panel resize handle is focused.">
        Side Panel Resize Handle (draggable)
      </message>
      <message name="IDS_ACCNAME_SIDE_PANEL_CLOSE" is_accessibility_with_no_ui="true" desc="Screen reader announcement when the side panel close button is focused.">
        Close side panel
      </message>
      <message name="IDS_SIDE_PANEL_RESIZE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true"
               desc="Accessible alert text announced after a user has resized the side panel via keyboard. This message is for screen reader users.">
               <ph name="WINDOW_SIDE">$1<ex>left</ex></ph> window now <ph name="WINDOW_SIZE_PERCENT">$2<ex>60%</ex></ph> wide, <ph name="PANE_SIDE">$3<ex>right</ex></ph> pane now <ph name="PANE_SIZE_PERCENT">$4<ex>40%</ex></ph> wide.
      </message>
      <message name="IDS_SIDE_PANEL_RESIZE_LEFT_SIDE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true"
               desc="Accessible alert text used in IDS_SIDE_PANEL_RESIZE_ACCESSIBLE_ALERT for which side the window/pane is seen on.">
               Left
      </message>
      <message name="IDS_SIDE_PANEL_RESIZE_RIGHT_SIDE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true"
               desc="Accessible alert text used in IDS_SIDE_PANEL_RESIZE_ACCESSIBLE_ALERT for which side the window/pane is seen on.">
               Right
      </message>
      <message name="IDS_SIDE_PANEL_TOOLBAR_BUTTON_CXMENU_UNPIN" desc="The label of the context menu item for unpinning a side panel toolbar button.">
        Unpin
      </message>
      <message name="IDS_SIDE_PANEL_TOOLBAR_BUTTON_CXMENU_PIN" desc="The label of the context menu item for pinning a side panel toolbar button.">
        Pin
      </message>
      <message name="IDS_SIDE_PANEL_HEADER_UNPIN_BUTTON_TOOLTIP" desc="The tooltip for unpinning a side panel toolbar button.">
        Unpin from toolbar
      </message>
      <message name="IDS_SIDE_PANEL_HEADER_PIN_BUTTON_TOOLTIP" desc="The tooltip for pinning a side panel toolbar button.">
        Pin to toolbar
      </message>
      <message name="IDS_SIDE_PANEL_UNPINNED" is_accessibility_with_no_ui="true" desc="Used to indicate to a screen reader user that a side panel has been unpinned.">
        Side panel unpinned
      </message>
      <message name="IDS_SIDE_PANEL_PINNED" is_accessibility_with_no_ui="true" desc="Used to indicate to a screen reader user that a side panel has been pinned.">
        Side panel pinned
      </message>
      <message name="IDS_PINNED_ACTION_BUTTON_ACCESSIBLE_TITLE" is_accessibility_with_no_ui="true" desc="Used to indicate to a screen reader user that an action is pinned in the toolbar">
        <ph name="ACTION_NAME">$1<ex>Bookmarks</ex></ph> - pinned
      </message>
      <message name="IDS_SIDE_PANEL_GENERIC_PINNABLE_IPH" desc="The body text of the IPH describing a side panel is pinnable.">
        You can pin this side panel for easy access
      </message>
      <message name="IDS_SIDE_PANEL_GENERIC_PINNABLE_IPH_SCREENREADER" desc="The screen reader text of the IPH describing a side panel is pinnable. The phrase 'top right' should read as 'top left' in rtl languages.">
        To easily get back to the side panel, click Pin at the top right
      </message>
      <message name="IDS_SIDE_PANEL_HEADER_MORE_INFO_BUTTON_TOOLTIP" desc="The tooltip for the side panel more info button.">
        More info
      </message>


      <!-- Reading mode strings -->
      <message name="IDS_SHOW_READING_MODE_SIDE_PANEL" desc="Context menu entry point to open the reading mode feature in the side panel.">
        Reading mode
      </message>
      <if expr="use_titlecase">
        <message name="IDS_READING_MODE_TITLE" desc="Title of the reading mode feature, which gives users an accessible reading experience.">
          Reading Mode
        </message>
      </if>
      <if expr="not use_titlecase">
        <message name="IDS_READING_MODE_TITLE" desc="Title of the reading mode feature, which gives users an accessible reading experience.">
          Reading mode
        </message>
