    <!-- chrome://updater -->
    <if expr="is_linux or is_macosx or is_win">
      <message name="IDS_UPDATER_ACTIVATION_FAILED" desc="Summary of a failed attempt by the Chrome Updater to become authoritative in managing updates on the machine.">
        Activation failed
      </message>
      <message name="IDS_UPDATER_ACTIVATION_SUCCEEDED" desc="Summary of a successful attempt by the Chrome Updater to become authoritative in managing updates on the machine.">
        Activation succeeded
      </message>
      <message name="IDS_UPDATER_ADD_FILTER" desc="In Title Case: Title of the button to add a filter over a list of Chrome Updater logs.">
        Add Filter
      </message>
      <message name="IDS_UPDATER_APP" desc="In Title Case: Title of the chip which filters logs by application (e.g. 'Google Chrome').">
        App
      </message>
      <message name="IDS_UPDATER_APP_COLUMN" desc="Title of a column in a table displaying the list of applications managed by Chrome's updater which displays the application's name or identifier string.">
        Application
      </message>
      <message name="IDS_UPDATER_APPLY" desc="Label on a button to apply the selected filters.">
        Apply
      </message>
      <message name="IDS_UPDATER_APP_NAME_OR_ID" desc="Placeholder text in a search box asking the user to enter an application name or identifier string.">
        App Name or ID
      </message>
      <message name="IDS_UPDATER_APP_POLICIES" desc="Header for a section of the enterprise policy table detailing the policies in effect for a specific application.">
        <ph name="APP_NAME">$1<ex>Google Chrome</ex></ph> policies
      </message>
      <message name="IDS_UPDATER_APP_STATES_QUERY_FAILED" desc="An error message indicating that the list of installed applications could not be retrieved from Chrome's updater.">
        Failed to query installed applications.
      </message>
      <message name="IDS_UPDATER_CANCEL" desc="Label on a button to cancel the current action or close a menu.">
        Cancel
      </message>
      <message name="IDS_UPDATER_CLEAR_ALL_FILTERS" desc="Tooltip or accessibility label for a button that removes all active search filters.">
        Clear all filters
      </message>
      <message name="IDS_UPDATER_COLLAPSE_ALL" desc="Label for a button that collapses all expanded items in a list.">
        Collapse All
      </message>
      <message name="IDS_UPDATER_COMMAND_LINE" desc="Label preceding the command line of an executed program in the summary of a logged Chrome Updater event">
        Command line:
      </message>
      <message name="IDS_UPDATER_COMMAND_OUTCOME" desc="Summary of an event in which a command line program was executed.">
        Command exited with code <ph name="EXIT_CODE">$1<ex>0</ex></ph>
      </message>
      <message name="IDS_UPDATER_COMMON" desc="Header string for a section of common options in a filter menu.">
        Common
      </message>
      <message name="IDS_UPDATER_DATE" desc="Label for a filter category allowing the user to filter logs by date.">
        Date
      </message>
      <message name="IDS_UPDATER_DATE_FILTER_AFTER" desc="Text displayed in a filter chip indicating logs are shown after a specific date.">
        After <ph name="START_DATE">$1<ex>Jan 1, 2025</ex></ph>
      </message>
      <message name="IDS_UPDATER_DATE_FILTER_BEFORE" desc="Text displayed in a filter chip indicating logs are shown before a specific date.">
        Before <ph name="END_DATE">$1<ex>Jan 1, 2025</ex></ph>
      </message>
      <message name="IDS_UPDATER_DATE_FILTER_RANGE" desc="Text displayed in a filter chip indicating logs are shown within a date range.">
        <ph name="START_DATE">$1<ex>Jan 1, 2025</ex></ph> to <ph name="END_DATE">$2<ex>Feb 1, 2025</ex></ph>
      </message>
      <message name="IDS_UPDATER_DISPLAYED_EVENTS_COUNT" desc="Text displayed above a filtered list of events in the Chrome Updater log indicating how many events match the filter and are displayed. The number of displayed events is greater than or equal to zero. The number of total events is one or more.">
        Displaying <ph name="NUM_DISPLAYED_EVENTS">$1<ex>17</ex></ph> of <ph name="NUM_TOTAL_EVENTS">$2<ex>1149</ex></ph>
      </message>
      <message name="IDS_UPDATER_DURATION" desc="Text indicating the duration of a Chrome Updater event in a log.">
        Duration: <ph name="DURATION">$1<ex>1m 12s</ex></ph>
      </message>
      <message name="IDS_UPDATER_EFFECTIVE_POLICY_SET" desc="Label for an expandable section which displays the enterprise policies which controlled the behavior of an action taken by the Chrome Updater in its event log.">
        Enterprise Policies
      </message>
      <message name="IDS_UPDATER_END_DATE" desc="Label for the end date input field.">
        End Date:
      </message>
      <message name="IDS_UPDATER_ERROR_ACCESS_DENIED" desc="Error message indicating that Chrome's updater could not communicate with a remote server due to the request being blocked (e.g. by a firewall or proxy server).">
        The update was blocked by network policy or a proxy server.
      </message>
      <message name="IDS_UPDATER_ERROR_CORRUPT" desc="Error message indicating that an update package is invalid or corrupted.">
        The downloaded update does not contain the expected content.
      </message>
      <message name="IDS_UPDATER_ERROR_DISABLED" desc="Error message indicating that an action recorded in the event log could not be taken by Chrome's updater because it was disallowed by enterprise policy.">
        The action was disallowed by the configured policies.
      </message>
      <message name="IDS_UPDATER_ERROR_DISK_FULL" desc="Error message indicating that an update could not be downloaded or applied because the disk is full.">
        The update failed because the system lacks sufficient storage space.
      </message>
      <message name="IDS_UPDATER_ERROR_DOWNLOAD" desc="Generic error message indicating that Chrome's Updater encountered an issue while downloading content (e.g. an update).">
        Failed to download content due to an unknown reason.
      </message>
      <message name="IDS_UPDATER_ERROR_INSTALL" desc="Generic error message indicating that an error occurred while installing an update.">
        Installation failed due to an unknown reason.
      </message>
      <message name="IDS_UPDATER_ERROR_INSTALLER_FAILED" desc="Error message indicating that an application's (e.g. Chrome's) installer program failed to complete successfully.">
        The application's installer program failed.
      </message>
      <message name="IDS_UPDATER_ERROR_NETWORK" desc="Error message indicating that a network communication error occurred with the update server.">
        A network error occurred. Check your internet connection and network settings.
      </message>
      <message name="IDS_UPDATER_ERROR_RESTRICTED" desc="Error message indicating that an update check was refused by the server because the application is restricted in the user's region.">
        The application is restricted in this region.
      </message>
      <message name="IDS_UPDATER_ERROR_UNPACK" desc="Generic error message indicating that an error occurred while unpacking an update package.">
        The update package could not be unpacked.
      </message>
      <message name="IDS_UPDATER_ERROR_UPDATE_CHECK" desc="Generic error message indicating that an error occurred while checking for updates.">
        The update check failed.
      </message>
      <message name="IDS_UPDATER_ERROR_UNKNOWN" desc="Generic error message indicating that an operation recorded in Chrome's updater's event log failed for a reason unknown to Chrome.">
        The operation failed due to an unknown reason.
      </message>
      <message name="IDS_UPDATER_EVENT_LIST_TITLE" desc="Title for a section of the chrome://updater page which displays an event log detailing the activity of Chrome's updater on a user's system.">
        Event History
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE" desc="Label for a filter category allowing the user to filter logs by the type of event.">
        Event Type
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_ACTIVATE" desc="Label for an action carried out by the Chrome Updater in which a particular version of the software becomes authoritative in managing updates on the machine.">
        Activate
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_APP_COMMAND" desc="Label for an action carried out by the Chrome Updater in which it executes a command on behalf of another application.">
        App Command
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_INSTALL" desc="Label for an action carried out by the Chrome Updater in which it attempts installation of software.">
        Install
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_LOAD_POLICY" desc="Label for an action carried out by the Chrome Updater in which it loads enterprise policies from external sources that govern the behavior of the updater.">
        Load Policy
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_PERSISTED_DATA" desc="Label for an action carried out by the Chrome Updater in which it records a snapshot of its internal data structures.">
        Persisted Data
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_POST_REQUEST" desc="Label for an action carried out by the Chrome Updater in which it performs an HTTP POST request.">
        POST Request
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_QUALIFY" desc="Label for an action carried out by the Chrome Updater in which a new version of the software performs self-health checks before becoming the authoritative updater on the system.">
        Self Test
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_UNINSTALL" desc="Label for an action carried out by the Chrome Updater in which it notices the removal of a piece of software from the system.">
        Uninstall
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_UPDATE" desc="Label for an action carried out by the Chrome Updater in which it attempts to update a piece of software from the system.">
        Update
      </message>
      <message name="IDS_UPDATER_EVENT_TYPE_UPDATER_PROCESS" desc="Label for an action carried out by the Chrome Updater in which it starts or stops a local system process.">
        Updater Process
      </message>
      <message name="IDS_UPDATER_EXPAND_ALL" desc="Label for a button that expands all collapsed items in a list.">
        Expand All
      </message>
      <message name="IDS_UPDATER_EXPORT_HISTORY_FILE" desc="Label for the button that redirects users to Chrome's support tool, allowing them to export Chrome Updater's history files.">
        Export History Files
      </message>
      <message name="IDS_UPDATER_FILTER_CHIP_APP" desc="Text displayed in a filter chip showing the selected application's names or identifier strings.">
        App: <ph name="APPS">$1<ex>Google Chrome, Google Chrome Beta, Google Chrome Canary, {6BBAE539-2232-434A-A4E5-9A33560C6284}</ex></ph>
      </message>
      <message name="IDS_UPDATER_FILTER_CHIP_DATE" desc="Text displayed in a filter chip showing the selected date range.">
        Date: <ph name="DATE_RANGE">$1<ex>Jan 1, 2025 to Feb 1, 2025</ex></ph>
      </message>
      <message name="IDS_UPDATER_FILTER_CHIP_EVENT_TYPE" desc="Text displayed in a filter chip showing the selected event types.">
        Event Type: <ph name="EVENT_TYPES">$1<ex>Update, Install</ex></ph>
      </message>
      <message name="IDS_UPDATER_FILTER_CHIP_UPDATE_OUTCOME" desc="Text displayed in a filter chip showing the selected update outcomes.">
        Update Outcome: <ph name="OUTCOMES">$1<ex>Updated, Update Error</ex></ph>
      </message>
      <message name="IDS_UPDATER_FILTER_CHIP_UPDATER_SCOPE" desc="Text displayed in a filter chip showing the selected updater scopes.">
        Updater Scope: <ph name="OUTCOMES">$1<ex>Per-system updater, Per-user updater</ex></ph>
      </message>
      <message name="IDS_UPDATER_HELP_CENTER_TOOLTIP" desc="Tooltip for the help center link about maintaining Chrome updates.">
        Learn more about maintaining Chrome updates
      </message>
      <message name="IDS_UPDATER_INACTIVE_VERSIONS_LABEL" desc="A label for a list of inactive versions of the Chrome Updater. Multiple Chrome Updater versions may be present on a users machine but only one may be active at a time.">
        Inactive Versions:
      </message>
      <message name="IDS_UPDATER_INSTALL_PATH_LABEL" desc="A label for a filesystem path indicating where the Chrome Updater is installed on a user's system.">
        Install Path:
      </message>
      <message name="IDS_UPDATER_INSTALL_SUMMARY" desc="Summary of an event in which software was installed, including the version.">
        Installed version <ph name="VERSION">$1<ex>1.2.3.4</ex></ph>
      </message>
      <message name="IDS_UPDATER_INSTALLED_APPS_TITLE" desc="Title for a section of the chrome://updater page which displays a table of applications known to the updater on the user's system.">
        Installed Applications
      </message>
      <message name="IDS_UPDATER_INTERNAL" desc="Label used to indicate that a logged Chrome Updater event pertains to the updater itself and not an app managed by the updater (e.g. Google Chrome).">
        Internal
      </message>
      <message name="IDS_UPDATER_LAST_CHECKED_LABEL" desc="A label for a timestamp indicating the last time the Chrome Updater checked for an update.">
        Last Update Check:
      </message>
      <message name="IDS_UPDATER_LAST_STARTED_LABEL" desc="A label for a timestamp indicating the last time the Chrome Updater performed its periodic tasks.">
        Last Periodic Task Run:
      </message>
      <message name="IDS_UPDATER_LEARN_MORE" desc="Label for a button that opens a help center article.">
        Learn More
      </message>
      <message name="IDS_UPDATER_LOAD_HISTORY_FILE" desc="Label for the button that allows users to upload one or more external updater history files for display.">
        Load History Files
      </message>
      <message name="IDS_UPDATER_LOAD_HISTORY_FILE_ERROR" desc="Error message displayed when one or more uploaded history files could not be parsed or processed.">
        Failed to load history. Ensure files contain valid updater logs.
      </message>
      <message name="IDS_UPDATER_NO_APPS_FOUND" desc="A message indicating that Chrome's updater is not managing any applications on the user's system.">
        No applications are installed.
      </message>
      <message name="IDS_UPDATER_NO_POLICIES" desc="A message indicating that no enterprise policies are in effect for the Chrome Updater or any of its managed applications.">
        No policies are in effect.
      </message>
      <message name="IDS_UPDATER_NO_UPDATER_FOUND" desc="A message indicating that Chrome's updater does not appear to be installed on the user's machine.">
        No updater installations could be found.
      </message>
      <message name="IDS_UPDATER_NEVER" desc="Text indicating that that an action has never happened. For instance, this is used in place of a timestamp to indicate that an instance of the Chrome Updater has never checked for any updates.">
        Never
      </message>
      <message name="IDS_UPDATER_NEXT_VERSION" desc="Label indicating the version of a software installation that the Chrome Updater tried to update to.">
        Next version: <ph name="VERSION">$1<ex>1.2.3.4</ex></ph>
      </message>
      <message name="IDS_UPDATER_NO_UPDATE" desc="Summary of an update event where the server indicated that no update was available. The text should indicate that the service was successfully able to check for an update. Not being offered an update is a normal occurance, the text should not suggest that any sort of error occured.">
        Update check completed successfully. No update was available
      </message>
      <message name="IDS_UPDATER_OMAHA_REQUEST" desc="Label for a collapsible section displaying or chip indicating the presence of Omaha protocol request data in JSON format.">
        Omaha Request
      </message>
      <message name="IDS_UPDATER_OMAHA_RESPONSE" desc="Label for a collapsible section displaying the Omaha protocol request data in JSON format.">
        Omaha Response
      </message>
      <message name="IDS_UPDATER_OTHER" desc="Header string for a section of miscellaneous options in a filter menu.">
        Other
      </message>
      <message name="IDS_UPDATER_OUTCOME" desc="Summary of an event with a specific outcome.">
        Operation completed with outcome: <ph name="OUTCOME">$1<ex>DISK_FULL</ex></ph>
      </message>
      <message name="IDS_UPDATER_OUTCOME_UNKNOWN" desc="Summary of an event carried out by the Chrome Updater where the outcome is unknown.">
        Operation completed with unknown outcome
      </message>
      <message name="IDS_UPDATER_PAGE_TITLE" desc="Title of the chrome://updater page, which displays information about the state and history of the Chrome updater installation on the users machine.">
        Updater
      </message>
      <message name="IDS_UPDATER_PARSE_ERROR_EVENTS" desc="Message indicating that one or more events could not be parsed and are hidden from the Chrome Updater event log.">
        {NUM_EVENTS, plural, =1 {1 event could not be parsed and is not shown} other {# events could not be parsed and are not shown}}
      </message>
      <message name="IDS_UPDATER_PERSISTED_DATA_SUMMARY" desc="Summary of an event indicating how many apps are registered.">
        <ph name="APP_COUNT">$1<ex>5</ex></ph> apps registered
      </message>
      <message name="IDS_UPDATER_POLICY_CONFLICT_WARNING" desc="Tooltip for a warning icon in the enterprise policy table indicating that a policy has been configured differently from multiple sources.">
        Policy configured with conflicting values from multiple sources.
      </message>
      <message name="IDS_UPDATER_POLICY_IGNORED" desc="Label for a value of an enterprise policy that is being ignored because another source has higher priority.">
        Ignored:
      </message>
      <message name="IDS_UPDATER_POLICY_NAME" desc="Title of a column in the enterprise policy table which displays the name of the policy.">
        Policy Name
      </message>
      <message name="IDS_UPDATER_POLICY_OK" desc="Tooltip for a checkmark icon in the enterprise policy table indicating that a policy has been configured.">
        Policy configured.
      </message>
      <message name="IDS_UPDATER_POLICY_SOURCE" desc="Title of a column in the enterprise policy table which displays the source of the policy (e.g. 'Platform', 'Cloud').">
        Source
      </message>
      <message name="IDS_UPDATER_POLICY_STATUS" desc="Title of a column in the enterprise policy table which displays the status of the policy.">
        Status
      </message>
      <message name="IDS_UPDATER_POLICY_VALUE" desc="Title of a column in the enterprise policy table which displays the value of the policy.">
        Policy Value
      </message>
      <message name="IDS_UPDATER_PROCESS_SUMMARY" desc="Summary of an event that involved executing a command on the system, including the numeric exit code.">
        Process exited with code <ph name="EXIT_CODE">$1<ex>0</ex></ph>
      </message>
      <message name="IDS_UPDATER_QUALIFICATION_FAILED" desc="Summary of an event in which the Chrome Updater's self-check failed, indicating that the program is not working as intended and should not manage updates for Chrome.">
        Self test failed
      </message>
      <message name="IDS_UPDATER_QUALIFICATION_SUCCEEDED" desc="Summary of an event in which the Chrome Updater's self-check succeeded, indicating that the program is working as intended and should manage updates for Chrome">
        Self test succeeded
      </message>
      <message name="IDS_UPDATER_QUERY_FAILED" desc="An error message indicating that Chrome's updater's state could not be queried.">
        Failed to query the updater state.
      </message>
      <message name="IDS_UPDATER_REMOVE_FILTER" desc="Accessibility label for the button that removes a specific filter chip.">
        Remove filter
      </message>
      <message name="IDS_UPDATER_RETURN_TO_LOCAL" desc="Label for the button that returns the page to displaying data from the user's updater installation after viewing the data contained in one or more history files.">
        View Local Data
      </message>
      <message name="IDS_UPDATER_SCOPE" desc="Label for a filter category allowing the user to filter Chrome Updater logs by the scope of the updater. Chrome Updater may be scoped per-user or per-system.">
        Updater Scope
      </message>
      <message name="IDS_UPDATER_SCOPE_SYSTEM" desc="Tooltip explaining that an event belongs to a per-system installation of the updater as opposed to a per-user installation.">
        Per-system updater
      </message>
      <message name="IDS_UPDATER_SCOPE_USER" desc="Tooltip explaining that an event belongs to a per-user installation of the updater as opposed to a per-system installation.">
        Per-user updater
      </message>
      <message name="IDS_UPDATER_START_DATE" desc="Label for the start date input field.">
        Start Date:
      </message>
      <message name="IDS_UPDATER_STATE_TITLE" desc="Title for a section of the chrome://updater page which displays information about the current state of the instances of Chrome's updater on the user's system.">
        Status
      </message>
      <message name="IDS_UPDATER_UNDATED_EVENTS" desc="Message indicating that the timestamp of one or more events was not able to determined. Events without timestamps can't be displayed in the Chrome Updater event log.">
        {NUM_EVENTS, plural, =1 {1 event could not be dated and is not shown} other {# events could not be dated and are not shown}}
      </message>
      <message name="IDS_UPDATER_UNINSTALL_SUMMARY" desc="Summary of an uninstall event, including version and reason.">
        Uninstalled version <ph name="VERSION">$1<ex>1.2.3.4</ex></ph>, reason: <ph name="REASON">$2<ex>NO_APPS_REMAINING</ex></ph>
      </message>
      <message name="IDS_UPDATER_UPDATED_TO" desc="Summary of an update event that succeeded, including the new version.">
        Updated to version <ph name="VERSION">$1<ex>1.2.3.4</ex></ph>
      </message>
      <message name="IDS_UPDATER_UPDATER_POLICIES" desc="Header for a section of the enterprise policy table detailing the policies in effect for the Chrome Updater itself.">
        Updater policies
      </message>
      <message name="IDS_UPDATER_UPDATER_VERSION" desc="Label indicating the version of the updater itself.">
        Updater version: <ph name="VERSION">$1<ex>1.2.3.4</ex></ph>
      </message>
      <message name="IDS_UPDATER_VERSION_COLUMN" desc="Title of the column in a table presenting the list of applications installed and managed by Chrome's updater.">
        Version
      </message>
      <message name="IDS_UPDATER_VERSION_LABEL" desc="A label for the version of the updater.">
        Version:
      </message>
      <message name="IDS_UPDATER_VIEWING_HISTORY_FILES" desc="Banner text indicating that the page is currently displaying data from an uploaded history file rather than the local machine.">
        {NUM_EVENTS, plural, =1 {Viewing history from 1 file} other {Viewing history from # files}}
      </message>
      <message name="IDS_UPDATER_UPDATE_ERROR" desc="Summary of an update event that failed.">
        Update operation failed
      </message>
      <message name="IDS_UPDATER_UPDATE_OUTCOME" desc="Label for a filter category allowing the user to filter logs by the outcome of the update attempt.">
        Update Outcome
      </message>
      <message name="IDS_UPDATER_UPDATE_OUTCOME_NO_UPDATE" desc="Label for the outcome of an update attempt in which no update was avaialble.">
        No Update
      </message>
      <message name="IDS_UPDATER_UPDATE_OUTCOME_UPDATED" desc="Label for the outcome of an update attempt in which an update was successfully applied.">
        Updated
      </message>
      <message name="IDS_UPDATER_UPDATE_OUTCOME_UPDATE_ERROR" desc="Label for the outcome of an update attempt in which the update could not complete because of an error.">
        Update Error
      </message>
      <message name="IDS_UPDATER_VIEW_ALL_CHROME_POLICIES" desc="Label for a button that opens the chrome://policy page.">
        View all Chrome Policies
      </message>
      <message name="IDS_UPDATER_VIEW_RAW_DETAILS" desc="Title of the button to display the contents of a Chrome Updater log in JSON format">
        Source
      </message>
    </if>
    <message name="IDS_REPORT_UNSAFE_SITE_CONFIRMATION_TOAST" desc="Message confirmation after unsafe-site-report sends to Google">
      Report sent
    </message>


    <!-- Chrome finds Notifications -->
    <message name="IDS_CHROME_FINDS_NOTIFICATIONS_HELPFUL_BUTTON_TEXT" desc="Text for the helpful button found on Chrome finds notifications.">
      Open in Chrome
    </message>
    <message name="IDS_CHROME_FINDS_NOTIFICATIONS_UNHELPFUL_BUTTON_TEXT" desc="Text for the unhelpful button found on Chrome finds notifications.">
      Not interested
    </message>

    <!-- OSCryptAsync Availability InfoBar -->
    <message name="IDS_OSCRYPTASYNC_AVAILABILITY_INFOBAR_MESSAGE" desc="Label displayed in an infobar when a keychain issue prevents some profile data from being read/written and a browser relaunch is required to resolve.">
      Relaunch the browser to load your profile data and keep it encrypted
    </message>
    <message name="IDS_OSCRYPTASYNC_AVAILABILITY_INFOBAR_BUTTON" desc="The text of the button to proceed with relaunching the entire browser to resolve keychain permission issues.">
      Relaunch
    </message>
  </messages>
</release>
</grit>
