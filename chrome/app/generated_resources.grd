      <message name="IDS_TAB_SCROLL_IPH_TITLE" desc="Title of the in-product help promo educating users on tab scrolling.">
        See all your tabs
      </message>
      <message name="IDS_TAB_SCROLL_IPH_BODY" desc="Body text of the in-product help promo educating users on tab scrolling.">
        You can scroll or use your mouse wheel to see all your tabs
      </message>
      <message name="IDS_TAB_SCROLL_IPH_HIDE_BUTTONS" desc="Text of the in-product help promo button to unpin scroll buttons.">
        Hide scroll buttons
      </message>
