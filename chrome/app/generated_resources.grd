      </message>
      <message name="IDS_READING_MODE_VOICE_MENU_DOWNLOADING" desc="Label for status text when a voice is downloading from the Read Aloud voice menu.">
        Downloading <ph name="LANGUAGE">$1<ex>English</ex></ph> voices...
      </message>
      <message name="IDS_READING_MODE_LANGUAGE_MENU_VOICES_UNAVAILABLE" desc="Label for status text when a voice attempted to be downloaded from the Read Aloud language menu is unavailable.">
        Some Google voices may not be available right now
      </message>
      <message name="IDS_READING_MODE_LANGUAGE_MENU_NO_INTERNET" desc="Label for status text when no internet prevents a voice from downloading from the Read Aloud language menu.">
        No internet
      </message>
      <message name="IDS_READING_MODE_CANT_USE_READ_ALOUD" desc="Label for toast message that shows when there are no voices available on the device and no internet prevents a voice from downloading.">
        Can't use Read Aloud right now.
      </message>
      <message name="IDS_READING_MODE_VOICE_MENU_NO_INTERNET" desc="Label for status text when no internet prevents a voice from downloading any voices from the Read Aloud language menu.">
        There are no <ph name="LANGUAGE">$1<ex>English</ex></ph> voices on your device. Connect to the internet, and try again.
      </message>
      <message name="IDS_READING_MODE_LANGUAGE_MENU_DOWNLOAD_FAILED" desc="Label for generic status text when there was an error when downloading a voice from the Read Aloud language menu and there's no more details on the error.">
        Download failed
      </message>
      <message name="IDS_READING_MODE_LANGUAGE_MENU_NO_SPACE" desc="Label for status text when no space on disk prevents a voice from downloading from the Read Aloud language menu.">
        To install this language, clear space on your device
      </message>
      <message name="IDS_READING_MODE_TOAST_NO_SPACE" desc="Label for tost message when no space on disk prevents a voice from downloading and there are no voices available at all.">
        To use Read Aloud, clear space on your device
      </message>
      <message name="IDS_READING_MODE_VOICE_MENU_NO_SPACE" desc="Label for status text when no no space on disk prevents a voice from downloading any voices from the Read Aloud language menu.">
        There are no <ph name="LANGUAGE">$1<ex>English</ex></ph> voices on your device. Clear space on your device, and try again.
      </message>
      <message name="IDS_READING_MODE_LANGUAGE_MENU_NO_SPACE_BUT_VOICES_EXIST" desc="Label for status text when no space on disk prevents a voice from downloading from the Read Aloud language menu but there are already installed voices for the language.">
        For higher quality voices, clear space on your device
      </message>
      <message name="IDS_READING_MODE_LANGUAGE_MENU_ITEM_LABEL" desc="Accessibility label for a line item in the language menu containing a language name and a preview button.">
        <ph name="LANGUAGE">$1<ex>English</ex></ph>, use right arrow key to preview voice
      </message>
      <message name="IDS_READING_MODE_VOICE_DOWNLOADED_TITLE" desc="Title for a notification to alert the user that a high quality TTS voice data file has been downloaded.">
        High-quality <ph name="LANGUAGE">$1<ex>English</ex></ph> voice files downloaded
      </message>
      <message name="IDS_READING_MODE_VOICE_DOWNLOADED_MESSAGE" desc="Message for a notification to alert the user that a high quality TTS voice data file has been downloaded.">
        Voice files are shared among users to save disk space
      </message>
      <message name="IDS_READING_MODE_ACCENT_MENU_LABEL" desc="Dialog title label for a dialog with options for managing accent preferences for Read Aloud.">
        Change voice accent
      </message>
      <message name="IDS_READING_MODE_SIDE_PANEL_PROMO_PINNING"
               desc="Text for the in-product-help bubble shown for the reading mode bubble when Side Panel Pinning is enabled.">
        To see a simplified view of this page, go to More Tools > Reading Mode
      </message>
      <message name="IDS_READING_MODE_OMNIBOX_ENTRY_POINT_PROMO"
               desc="Text for the in-product-help bubble shown for the reading mode omnibox entry point.">
        Read comfortably with minimal distractions
      </message>
      <message name="IDS_READING_MODE_OMNIBOX_ENTRY_POINT_PROMO_SCREEN_READER"
               desc="Text for the in-product-help bubble shown for the reading mode omnibox entry point for use when surfacing the bubble to a screen reader">
        Read comfortably with minimal distractions using the Reading mode button on the toolbar
      </message>
     <message name="IDS_READING_MODE_VOICE_PREVIEW_STRING" desc="Message to be played when a user previews a voice for Read Aloud.">
        Hi. This is a preview
      </message>
     <message name="IDS_READING_MODE_FONT_LOADING_STRING" desc="Text added to a font name in the Reading Mode font dropdown when the font style hasn't loaded yet.">
         (loading)
      </message>
      <message name="IDS_READING_MODE_LINE_FOCUS_LABEL" desc="Accessibility label for the line focus menu item in reading mode.">
        Line focus
      </message>
      <message name="IDS_READING_MODE_TURN_LINE_FOCUS_OFF_LABEL" desc="Text for the toolbar button in reading mode that turns off line focus. Displays only when line focus is on.">
        Turn off focus
      </message>
      <message name="IDS_READING_MODE_SIDE_PANEL_LABEL" desc="Accessibility label for the Side panel option in view menu for reading mode.">
        Side panel
      </message>
      <message name="IDS_READING_MODE_VIEW_FULL_PAGE_LABEL" desc="Accessibility label for the Full page option in view menu for reading mode.">
        Full page
      </message>
      <message name="IDS_READING_MODE_VIEW_LABEL" desc="Accessibility label for the view menu item in reading mode.">
        View
      </message>
      <message name="IDS_READING_MODE_LINKS_LABEL" desc="Accessibility label for the links menu item in reading mode.">
        Links
      </message>
      <message name="IDS_READING_MODE_PRESENTATION_MODE_IPH_BODY" desc="Text for the help bubble describing how to toggle reading mode from immersive mode to side panel mode.">
        Switch back to the side-by-side view by opening Settings, then View, and select Side Panel.
      </message>
      <message name="IDS_READING_MODE_PRESENTATION_MODE_IPH_SCREENREADER" is_accessibility_with_no_ui="true" desc="Text for the help bubble describing how to toggle reading mode from immersive mode to side panel mode.">
        Switch back to the side-by-side view by opening Settings, then View, and select Side Panel.
      </message>


      <!--Tooltip strings -->
      <message name="IDS_TOOLTIP_BACK" desc="The tooltip for back button">
        Click to go back, hold to see history
      </message>
      <message name="IDS_ACCDESCRIPTION_BACK" desc="Help text that explains to keyboard users how to interact with the back button, similar to the tooltip presented to mouse users.">
        Press to go back, context menu to see history
      </message>
      <message name="IDS_TOOLTIP_CHROMELABS_COMBOBOX" desc="The tooltip for the Chrome Labs combobox to select between experiment states">
        Select experiment state for <ph name="EXPERIMENT_NAME">$1<ex>Tab Scrolling</ex></ph>
      </message>
      <message name="IDS_TOOLTIP_FORWARD" desc="The tooltip for forward button">
        Click to go forward, hold to see history
      </message>
      <message name="IDS_ACCDESCRIPTION_FORWARD" desc="Help text that explains to keyboard users how to interact with the forward button, similar to the tooltip presented to mouse users.">
        Press to go forward, context menu to see history
      </message>
      <message name="IDS_TOOLTIP_DOWNLOAD_ICON"
          desc="The tooltip for download toolbar button icon">
          Downloads
      </message>
      <message name="IDS_TOOLTIP_DOWNLOAD_ICON_NEW_DOWNLOAD" desc="The tooltip for download toolbar button icon when at least one newly completed download is available">
        New download available
      </message>
      <message name="IDS_TOOLTIP_HOME" desc="The tooltip for the home button">
        Open the home page
      </message>
      <message name="IDS_TOOLTIP_RELOAD" desc="The tooltip for reload button">
        Reload this page
      </message>
      <message name="IDS_TOOLTIP_RELOAD_WITH_MENU" desc="The tooltip for reload button with menu in DevTools mode">
        Reload this page, hold to see more options
      </message>
      <message name="IDS_TOOLTIP_STOP" desc="The tooltip for the stop button">
        Stop loading this page
      </message>
      <message name="IDS_TOOLTIP_EXTENSIONS_BUTTON" desc="The tooltip for the extensions button">
        Extensions
      </message>
      <message name="IDS_TOOLTIP_OVERFLOW_BUTTON" desc="The tooltip for the overflow button">
        Hidden toolbar buttons
      </message>
      <if expr="enable_extensions_core">
      <message name="IDS_TOOLTIP_EXTENSIONS_BUTTON_ALL_EXTENSIONS_BLOCKED" desc="The tooltip for the extensions button when all the extensions are blocked on the current site.">
        Extensions not allowed on this site
      </message>
      <message name="IDS_TOOLTIP_EXTENSIONS_BUTTON_ANY_EXTENSION_HAS_ACCESS" desc="The tooltip for the extensions button when any extension has access to the current site.">
        Extensions allowed on this site
      </message>
      <message name="IDS_ACC_NAME_EXTENSIONS_BUTTON" desc="The accessible text for the extensions button." formatter_data="android_java">
        Extensions menu
      </message>
      <message name="IDS_ACC_NAME_EXTENSIONS_BUTTON_ALL_EXTENSIONS_BLOCKED" desc="The accessible text for the extensions button when all the extensions are blocked on the current site."  formatter_data="android_java">
        Extensions not allowed on this site. Select to open menu
      </message>
      <message name="IDS_ACC_NAME_EXTENSIONS_BUTTON_ANY_EXTENSION_HAS_ACCESS" desc="The accessible text for the extensions button when any extension has access."  formatter_data="android_java">
        Extensions allowed on this site. Select to open menu
      </message>
      </if>
      <message name="IDS_TOOLTIP_LOCATION_ICON" desc="The tooltip for location icon in the omnibox">
        View site information
      </message>
      <message name="IDS_TOOLTIP_NEW_TAB" desc="The tooltip for the new tab button">
        New tab
      </message>
      <message name="IDS_TOOLTIP_MIC_SEARCH" desc="The tooltip for search-by-voice button" formatter_data="android_java">
        Search by voice
      </message>
      <message name="IDS_TOOLTIP_LENS_SEARCH" desc="The tooltip for search-by-image button">
        Search by image
      </message>
      <message name="IDS_TOOLTIP_ZOOM" desc="The tooltip for the zoom bubble">
        Zoom: <ph name="PERCENT">$1<ex>100%</ex></ph>
      </message>
      <message name="IDS_TOOLTIP_ZOOM_EXTENSION_ICON" desc="The tooltip for the extension icon in the zoom bubble">
        This page was zoomed by the "<ph name="NAME">$1<ex>Google Cast</ex></ph>" extension
      </message>
      <message name="IDS_ZOOM_SET_DEFAULT" desc="The text label of a button which, when clicked, returns the page to default zoom">
        Reset
      </message>
      <message name="IDS_TOOLTIP_FIND" desc="The tooltip for the find button">
        Find
      </message>

      <message name="IDS_SPLIT_VIEW_TITLE_IPH" desc="The title text of the IPH describing pinning split view.">
        Pin it for next time
      </message>
      <message name="IDS_SPLIT_VIEW_BODY_IPH" desc="The body text of the IPH describing pinning split view.">
        Quickly create a split view when you need it
      </message>
      <if expr="use_titlecase">
        <message name="IDS_SPLIT_VIEW_PIN_ACTION_2_IPH" desc="In Title Case: The pin confirmation button of the IPH describing split view.">
          Pin Split View
        </message>
      </if>
      <if expr="not use_titlecase">
        <message name="IDS_SPLIT_VIEW_PIN_ACTION_2_IPH" desc="The pin confirmation button of the IPH describing split view.">
          Pin split view
        </message>
      </if>
      <message name="IDS_SPLIT_VIEW_TAB_SWITCH_ENTRY_IPH_TITLE" desc="The title for intro of quick tab switch split view IPH tutorial.">
        Split view makes it easier to multitask
      </message>
      <message name="IDS_SPLIT_VIEW_TAB_SWITCH_ENTRY_IPH_BODY" desc="The body for intro of quick tab switch split view IPH tutorial.">
        Put pages side-by-side in the same tab so you can easily compare options and more
      </message>
      <message name="IDS_SPLIT_VIEW_TAB_SWITCH_STEP_IPH_BODY" desc="The body for first step of quick tab switch split view IPH tutorial.">
        Right-click on this tab and select “New split view with current tab”
      </message>
      <message name="IDS_SPLIT_VIEW_TAB_SWITCH_COMPLETION_IPH_BODY" desc="The body for completion of quick tab switch split view IPH tutorial.">
        You can now use split view to compare, multitask, and more
      </message>
      <message name="IDS_SPLIT_VIEW_TOOLBAR_BUTTON_STEP_IPH_BODY" desc="The body for second step of quick tab switch split view IPH tutorial.">
        Click here to separate or arrange the split view
      </message>
      <message name="IDS_SPLIT_VIEW_DRAG_ENTRYPOINT_LABEL" desc="A label for the drag entrypoint indicating it can create a split view.">
        Create split view
      </message>
      <message name="IDS_SPLIT_VIEW_RESIZE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true" desc="Accessible alert announced after resizing a split view.">
        <ph name="VIEW_ONE_ORIENTATION">$1<ex>Left</ex></ph> View now <ph name="VIEW_ONE_PERCENT">$2<ex>50%</ex></ph> wide, <ph name="VIEW_TWO_ORIENTATION">$3<ex>Right</ex></ph> View now <ph name="VIEW_TWO_PERCENT">$4<ex>50%</ex></ph> wide.
      </message>
      <message name="IDS_SPLIT_VIEW_RESIZE_ACCESSIBLE_ALERT_STACKED" is_accessibility_with_no_ui="true" desc="Accessible alert announced after resizing a stacked split view.">
        <ph name="VIEW_ONE_ORIENTATION">$1<ex>Top</ex></ph> View now <ph name="VIEW_ONE_PERCENT">$2<ex>50%</ex></ph> tall, <ph name="VIEW_TWO_ORIENTATION">$3<ex>Bottom</ex></ph> View now <ph name="VIEW_TWO_PERCENT">$4<ex>50%</ex></ph> tall.
      </message>
      <message name="IDS_SPLIT_VIEW_RESIZE_LEFT_SIDE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true"
               desc="Accessible alert text used in IDS_SPLIT_VIEW_RESIZE_ACCESSIBLE_ALERT for which side the window/pane is seen on.">
               Left
      </message>
      <message name="IDS_SPLIT_VIEW_RESIZE_RIGHT_SIDE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true"
               desc="Accessible alert text used in IDS_SPLIT_VIEW_RESIZE_ACCESSIBLE_ALERT for which side the window/pane is seen on.">
               Right
      </message>
      <message name="IDS_SPLIT_VIEW_RESIZE_TOP_SIDE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true"
               desc="Accessible alert text used in IDS_SPLIT_VIEW_RESIZE_ACCESSIBLE_ALERT for which side the window/pane is seen on.">
               Top
      </message>
      <message name="IDS_SPLIT_VIEW_RESIZE_BOTTOM_SIDE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true"
               desc="Accessible alert text used in IDS_SPLIT_VIEW_RESIZE_ACCESSIBLE_ALERT for which side the window/pane is seen on.">
               Bottom
      </message>
      <message name="IDS_SPLIT_VIEW_HORIZONTAL_INDIRECT_ACCESS_IPH_TITLE" desc="The title for horizontal split view indirect access snooze IPH.">
        Try stacked split view
      </message>
      <message name="IDS_SPLIT_VIEW_HORIZONTAL_INDIRECT_ACCESS_IPH_BODY" desc="The body for horizontal split view indirect access snooze IPH.">
        Use the split view menu to switch between side by side and stacked layouts.
      </message>

      <!-- Vertical Tab Strings -->
      <message name="IDS_SWITCH_TO_VERTICAL_TAB" desc="The button in context menu that switches to vertical tab view.">
        Show tabs vertically
      </message>
      <message name="IDS_SWITCH_TO_HORIZONTAL_TAB" desc="The button in context menu that switches to horizontal tab view.">
        Show tabs horizontally
      </message>
      <if expr="use_titlecase">
        <then>
          <message name="IDS_SWITCH_TO_VERTICAL_TAB_MAC" desc="In Title Case: The button in context menu that switches to vertical tab view.">
            Show Tabs Vertically
          </message>
          <message name="IDS_SWITCH_TO_HORIZONTAL_TAB_MAC" desc="In Title Case: The button in context menu that switches to horizontal tab view.">
            Show Tabs Horizontally
          </message>
          <message name="IDS_COLLAPSE_VERTICAL_TABS" desc="In Title Case: The tooltip for the button in the top container that collapses the vertical tab strip.">
            Collapse Tabs
          </message>
          <message name="IDS_EXPAND_VERTICAL_TABS" desc="In Title Case: The tooltip for the button in the top container that expands the vertical tab strip.">
            Expand Tabs
          </message>
          <message name="IDS_VERTICAL_TABS_SEND_FEEDBACK" desc="In Title Case: The button in context menu that allows users to send feedback about vertical tabs.">
            Send Feedback About the Tab Strip
          </message>
          <message name="IDS_VERTICAL_TABS_TUTORIAL_STEP_SHOW_VERTICAL" desc="The body for the vertical tabs IPH tutorial step to switch to the vertical tabstrip. The string in quotation marks should match the translation for IDS_SWITCH_TO_VERTICAL_TAB.">
            Right-click here and select “Show Tabs Vertically”
          </message>
          <message name="IDS_VERTICAL_TABS_TUTORIAL_STEP_COLLAPSE" desc="The body for the vertical tabs IPH tutorial step to collapse the vertical tabstrip.">
            Try collapsing the tab strip to get more space
          </message>
          <message name="IDS_VERTICAL_TABS_TUTORIAL_STEP_END" desc="The body for the celebratory end step of the vertical tabs IPH tutorial. The string in quotation marks should match the translation for IDS_SWITCH_TO_HORIZONTAL_TAB.">
            You can move your tabs back to the top by right-clicking any tab and selecting “Show Tabs Horizontally”
          </message>
          <message name="IDS_VERTICAL_TABS_ENABLE_EXPAND_ON_HOVER" desc="In Title Case: The button in context menu that enables expand on hover behavior.">
            Turn on Auto Expanding Tabs
          </message>
          <message name="IDS_VERTICAL_TABS_DISABLE_EXPAND_ON_HOVER" desc="In Title Case: The button in context menu that disables expand on hover behavior.">
            Turn off Auto Expanding Tabs
          </message>
          <message name="IDS_VERTICAL_TABS_COLLAPSE_BUTTON_TOGGLE_EXPAND_ON_HOVER" desc="In Title Case: The right click context menu opened by the collapse button that toggles expand on hover behavior.">
            Expand Collapsed Tabs by Hovering
          </message>
        </then>
        <else>
          <message name="IDS_COLLAPSE_VERTICAL_TABS" desc="The tooltip for the button in the top container that collapses the vertical tab strip.">
            Collapse tabs
          </message>
          <message name="IDS_EXPAND_VERTICAL_TABS" desc="The tooltip for the button in the top container that expands the vertical tab strip.">
            Expand tabs
          </message>
          <message name="IDS_VERTICAL_TABS_SEND_FEEDBACK" desc="The button in context menu that allows users to send feedback about vertical tabs.">
            Send feedback about the tab strip
          </message>
          <message name="IDS_VERTICAL_TABS_TUTORIAL_STEP_SHOW_VERTICAL" desc="The body for the vertical tabs IPH tutorial step to switch to the vertical tabstrip. The string in quotation marks should match the translation for IDS_SWITCH_TO_VERTICAL_TAB.">
            Right-click here and select “Show tabs vertically”
          </message>
          <message name="IDS_VERTICAL_TABS_TUTORIAL_STEP_COLLAPSE" desc="The body for the vertical tabs IPH tutorial step to collapse the vertical tabstrip.">
            Try collapsing the tab strip to get more space
          </message>
          <message name="IDS_VERTICAL_TABS_TUTORIAL_STEP_END" desc="The body for the celebratory end step of the vertical tabs IPH tutorial. The string in quotation marks should match the translation for IDS_SWITCH_TO_HORIZONTAL_TAB.">
            You can move your tabs back to the top by right-clicking any tab and selecting “Show tabs horizontally”
          </message>
          <message name="IDS_VERTICAL_TABS_ENABLE_EXPAND_ON_HOVER" desc="The button in context menu that enables expand on hover behavior.">
            Turn on auto expanding tabs
          </message>
          <message name="IDS_VERTICAL_TABS_DISABLE_EXPAND_ON_HOVER" desc="The button in context menu that disables expand on hover behavior.">
            Turn off auto expanding tabs
          </message>
          <message name="IDS_VERTICAL_TABS_COLLAPSE_BUTTON_TOGGLE_EXPAND_ON_HOVER" desc="The right click context menu opened by the collapse button that toggles expand on hover behavior.">
            Expand collapsed tabs by hovering
          </message>
        </else>
      </if>
      <message name="IDS_VERTICAL_TABS_IPH_TITLE" desc="The title for the vertical tabs IPH tutorial.">
        Move your tabs to the side
      </message>
      <message name="IDS_VERTICAL_TABS_IPH_BODY" desc="The body for the vertical tabs IPH tutorial.">
        See entire tab titles, easily manage tab groups, and free up vertical space by moving your tabs to the side.
      </message>
      <message name="IDS_VERTICAL_TABS_EXPAND_ON_HOVER_DEFAULT_ENABLED_IPH_BODY" desc="The body for the vertical tabs expand on hover IPH, when expand on hover is default enabled.">
        You can now expand your tabs by hovering over them. To turn this off, right-click here.
      </message>
      <message name="IDS_VERTICAL_TABS_EXPAND_ON_HOVER_DEFAULT_DISABLED_IPH_BODY" desc="The body for the vertical tabs expand on hover IPH, when expand on hover is default disabled.">
        You can now expand your tabs by hovering over them. To turn this on, right-click here.
      </message>
      <message name="IDS_VERTICAL_RESIZE_AREA" is_accessibility_with_no_ui="true" desc="The accessibility label for the resize area in the vertical tab strip.">
            Vertical Tab Strip Resize Handle (Draggable)
      </message>
      <message name="IDS_VERTICAL_TAB_RESIZE_ACCESSIBLE_ALERT" is_accessibility_with_no_ui="true" desc="Accessible alert announced after resizing the vertical tab strip.">
            Tab Strip now <ph name="TAB_STRIP_PERCENT">$1<ex>25%</ex></ph> wide, Content Area now <ph name="CONTENT_AREA_PERCENT">$2<ex>75%</ex></ph> wide.
      </message>
      <message name="IDS_VERTICAL_TAB_GROUP_MORE_OPTIONS" is_accessibility_with_no_ui="true" desc="The accessibility label for the button in the tab group header that opens the editor bubble.">
            More Options
      </message>
      <message name="IDS_VERTICAL_TABS_VIEW_MENU_TOGGLE_COLLAPSE" desc="In Title Case: The mac view menu item that toggles the collapse state.">
            Collapse Vertical Tabs
      </message>
      <!-- /Vertical Tab Strings -->

      <!-- Tab Scroll Strings -->
      <if expr="use_titlecase">
        <then>
          <message name="IDS_TAB_SCROLL_AUTO_SHOW_ON_OVERFLOW" desc="In Title Case: Text of the setting to automatically show scroll buttons on tab overflow.">
            Automatically Show Tab Scroll Buttons When Needed
          </message>
          <message name="IDS_TAB_SCROLL_PIN_BUTTONS_SYSTEM_MENU" desc="In Title Case: Text of the context system menu item to pin scroll buttons.">
