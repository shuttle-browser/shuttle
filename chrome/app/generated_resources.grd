      <message name="IDS_EXTENSIONS_MENU_REQUESTS_ACCESS_SECTION_DISMISS_BUTTON_ACCESSIBLE_NAME" desc="Accessibility string for the dismiss button for each extension in the requests access section that dismisses the extensions's access requests on this tab's current origin." formatter_data="android_java">
