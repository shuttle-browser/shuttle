          </message>
          <message name="IDS_TAB_SCROLL_PIN_BUTTONS_SYSTEM_MENU" desc="Text of the context menu item to pin scroll buttons.">
            Pin scroll buttons
          </message>
          <message name="IDS_TAB_SCROLL_UNPIN_BUTTONS_SYSTEM_MENU" desc="In Title Case: Text of the context system menu item to unpin scroll buttons.">
            Unpin scroll buttons
          </message>
          <message name="IDS_TAB_SCROLL_UNPIN_BUTTONS" desc="Text of the context menu item to unpin scroll buttons.">
            Unpin
          </message>
        </else>
