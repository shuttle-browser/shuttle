      <!-- Organizer Panel Strings -->
      <if expr="use_titlecase">
        <then>
          <message name="IDS_VIEW_ORGANIZER_PANEL" desc="In Title Case: The tooltip for the button in the top container that shows the organizer panel.">
            View Organizer
          </message>
          <message name="IDS_HIDE_ORGANIZER_PANEL" desc="In Title Case: The tooltip for the button in the top container that hides the organizer panel.">
            Hide Organizer
          </message>
        </then>
        <else>
          <message name="IDS_VIEW_ORGANIZER_PANEL" desc="The tooltip for the button in the top container that shows the organizer panel.">
            View organizer
          </message>
          <message name="IDS_HIDE_ORGANIZER_PANEL" desc="The tooltip for the button in the top container that hides the organizer panel.">
            Hide organizer
          </message>
        </else>
      </if>
      <message name="IDS_ORGANIZER_PANEL" desc="The name of the organizer panel announced by screenreaders." is_accessibility_with_no_ui="true">
        Organizer
      </message>
      <if expr="use_titlecase">
        <message name="IDS_TAB_STRIP_UNPIN_TAB_SEARCH" desc="In Title Case: Name of the tab strip system menu item for unpinning tab search.">
          Unpin Tab Search
        </message>
        <message name="IDS_TAB_STRIP_PIN_TAB_SEARCH" desc="In Title Case: Name of the tab strip system menu item for pinning tab search.">
          Pin Tab Search
        </message>
      </if>
      <if expr="not use_titlecase">
        <message name="IDS_TAB_STRIP_UNPIN_TAB_SEARCH" desc="Name of the tab strip system menu item for unpinning tab search.">
          Unpin tab search
        </message>
        <message name="IDS_TAB_STRIP_PIN_TAB_SEARCH" desc="Name of the tab strip system menu item for pinning tab search.">
          Pin tab search
        </message>
      </if>
