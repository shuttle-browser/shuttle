import("//build/config/ui.gni")
import("//chrome/common/features.gni")
import("//chrome/test/include_js_tests.gni")
import("//components/compose/features.gni")
import("//components/guest_view/buildflags/buildflags.gni")
import("//crypto/features.gni")
import("//extensions/buildflags/buildflags.gni")
import("//pdf/features.gni")
import("//printing/buildflags/buildflags.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/typescript/webui_ts_library.gni")
import("//ui/webui/resources/tools/generate_grd.gni")
import("//ui/webui/webui_features.gni")

assert(!is_fuchsia, "Fuchsia shouldn't use anything in //chrome")

webui_ts_library("build_ts") {
  root_dir = "."
  out_dir = "$target_gen_dir/tsc"
  composite = true
  tsconfig_base = "tsconfig_base.json"
  in_files = [
    "chai_assert.ts",
    "fake_chrome_event.ts",
    "fake_media_query_list.ts",
    "keyboard_mock_interactions.ts",
    "metrics_test_support.ts",
    "mocha_adapter_simple.ts",
    "mock_controller.ts",
    "mock_timer.ts",
    "mock_timer_test.ts",
    "test_browser_proxy.ts",
    "test_mock.ts",
    "test_mock_test.ts",
    "test_open_window_proxy.ts",
    "test_plural_string_proxy.ts",
    "test_util.ts",
    "trusted_html.ts",
  ]

  if (!is_android || enable_webui_ntp) {
    in_files += [ "polymer_test_util.ts" ]
  }

  if (!is_android) {
    in_files += [
      "fake_settings_private.ts",
      "mocked_metrics_reporter.ts",
      "mouse_mock_interactions.ts",
      "test_api.ts",
      "test_store.ts",
      "test_user_education_mixed_trust_handler.ts",
    ]
  }

  deps = [ "//ui/webui/resources/js:build_ts" ]

  definitions = [
    "//tools/typescript/definitions/dom_automation_controller.d.ts",
    "//tools/typescript/definitions/chrome_histograms.d.ts",
    "//tools/typescript/definitions/metrics_private.d.ts",
  ]

  if (!is_android || enable_webui_ntp) {
    deps += [ "//third_party/polymer/v3_0:library" ]
  }

  if (!is_android) {
    deps += [ "//ui/webui/resources/mojo:build_ts" ]
    definitions += [
      "//tools/typescript/definitions/chrome_event.d.ts",
      "//tools/typescript/definitions/chrome_send.d.ts",
      "//tools/typescript/definitions/settings_private.d.ts",
    ]
  }

  definitions += []

  path_mappings =
      [ "//webui-test/chai.js|" +
        rebase_path("//third_party/node/node_modules/@types/chai/index.d.ts",
                    target_gen_dir) ]
}

if (!is_android) {
}
