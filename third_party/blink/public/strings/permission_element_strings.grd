<?xml version="1.0" encoding="UTF-8"?>

<grit base_dir="." latest_public_release="0" current_release="1" source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/permission_element_strings.h" type="rc_header">
      <emit emit_type="prepend"></emit>
    </output>
    <output filename="permission_element_strings_en-US.pak" type="data_package" lang="en" />
    <if expr="is_ios">
      <!-- iOS uses es-MX for es-419 -->
    </if>
    <!-- The translation console uses 'no' for Norwegian Bokmål. It should
         be 'nb'. -->
    <if expr="is_ios">
      <!-- iOS uses pt for pt-BR -->
    </if>
    <!-- Pseudolocales -->
  </outputs>
  <translations>
    <!-- The translation console uses 'iw' for Hebrew, but we use 'he'. -->
  </translations>
  <release seq="1" allow_pseudo="false">
    <messages fallback_to_english="true">
      <message name="IDS_PERMISSION_REQUEST_CAMERA_ALLOWED" desc="Label for a permission element when camera access is allowed">
        Camera allowed
      </message>
      <message name="IDS_PERMISSION_REQUEST_CAMERA" desc="Label for a permission element that will trigger a camera request">
        Use camera
      </message>
      <message name="IDS_PERMISSION_REQUEST_MICROPHONE_ALLOWED" desc="Label for a permission element when microphone access is allowed">
        Microphone allowed
      </message>
      <message name="IDS_PERMISSION_REQUEST_MICROPHONE" desc="Label for a permission element that will trigger a microphone request">
        Use microphone
      </message>
      <message name="IDS_PERMISSION_REQUEST_GEOLOCATION_ALLOWED" desc="Label for a permission element when geolocation access is allowed">
        Location allowed
      </message>
      <message name="IDS_PERMISSION_REQUEST_GEOLOCATION" desc="Label for a permission element that will trigger a geolocation request">
        Use location
      </message>
      <message name="IDS_PERMISSION_REQUEST_CAMERA_MICROPHONE_ALLOWED" desc="Label for a permission element when camera access and microphone access are allowed">
        Camera and microphone allowed
      </message>
      <message name="IDS_PERMISSION_REQUEST_CAMERA_MICROPHONE" desc="Label for a permission element that will trigger a camera and microphone request">
        Use microphone and camera
      </message>
      <message name="IDS_PERMISSION_REQUEST_PRECISE_GEOLOCATION_ALLOWED" desc="Label for a permission element when geolocation access is allowed">
        Precise location allowed
      </message>
      <message name="IDS_PERMISSION_REQUEST_PRECISE_GEOLOCATION" desc="Label for a permission element that will trigger a geolocation request">
        Use precise location
      </message>
      <message name="IDS_PERMISSION_REQUEST_USING_LOCATION" desc="Label for a permission element when location is being used">
        Using location...
      </message>
      <message name="IDS_PERMISSION_REQUEST_INSTALL" desc="Label for a permission element that will trigger an installation request.">
        Install
      </message>
      <!-- TODO(crbug.com/470011876): Remove string with host name. -->
      <message name="IDS_PERMISSION_REQUEST_INSTALL_WITH_HOST" desc="Label for a permission element that will trigger an installation request for an application whose host is specified">
        Install <ph name="HOSTNAME">$1<ex>www.example.com</ex></ph>
      </message>
      <message name="IDS_PERMISSION_REQUEST_LAUNCH" desc="Label for a permission element that will trigger a launch request.">
        Launch
      </message>
    </messages>
  </release>
</grit>
