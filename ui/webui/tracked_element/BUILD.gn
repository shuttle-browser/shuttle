source_set("tracked_element") {
  sources = [
    "element_highlighter_webui.cc",
    "element_highlighter_webui.h",
    "tracked_element_handler.cc",
    "tracked_element_handler.h",
    "tracked_element_handler_document_singleton.cc",
    "tracked_element_handler_document_singleton.h",
    "tracked_element_web_ui.cc",
    "tracked_element_web_ui.h",
  ]

  public_deps = [
    "//content/public/browser",
    "//ui/base/interaction",
    "//ui/webui/resources/js/tracked_element:mojo_bindings",
  ]

  deps = [
    "//base",
    "//ui/gfx",
    "//ui/gfx/geometry",
  ]

  if (!is_android) {
    deps += [
      "//ui/views",
      "//ui/views/controls/webview",
    ]
  }
}

