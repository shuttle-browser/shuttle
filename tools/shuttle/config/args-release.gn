# Shipping build (2026-10-09): official, arm64, open codecs only (RELEASE.md D2a).
# PGO + ThinLTO are off here: official releases append config/args-lto.gn (SHUTTLE_GN_EXTRA, Toby 2026-10-20) on a
# host with enough RAM (the final link needs far more than an 18 GB Mac). Plain release builds stay valid for testing.
is_official_build = true
chrome_pgo_phase = 0
use_thin_lto = false
target_cpu = "arm64"
proprietary_codecs = false
ffmpeg_branding = "Chromium"
# Scrambled Mojo message IDs stay on, salted per Chromium major instead of per release (respins skip the mojom
# regeneration). Bump config/mojom-salt.txt with each major merge.
mojom_message_id_salt_path = "//tools/shuttle/config/mojom-salt.txt"
