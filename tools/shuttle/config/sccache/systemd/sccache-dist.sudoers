# /etc/sudoers.d/sccache-dist (installed by scripts/sccache-dist-host.sh install, mode 0440).
# Lets @USER@ start/stop/restart ONLY the Shuttle sccache-dist units without a password.
# Explicit unit names on purpose: a sudoers '*' also matches spaces (extra units/arguments).
Cmnd_Alias SCCACHE_DIST = \
  /usr/bin/systemctl start sccache-dist-scheduler.service, \
  /usr/bin/systemctl stop sccache-dist-scheduler.service, \
  /usr/bin/systemctl restart sccache-dist-scheduler.service, \
  /usr/bin/systemctl start sccache-dist-server@1.service, \
  /usr/bin/systemctl stop sccache-dist-server@1.service, \
  /usr/bin/systemctl restart sccache-dist-server@1.service, \
  /usr/bin/systemctl start sccache-dist-server@2.service, \
  /usr/bin/systemctl stop sccache-dist-server@2.service, \
  /usr/bin/systemctl restart sccache-dist-server@2.service
@USER@ ALL=(root) NOPASSWD: SCCACHE_DIST
