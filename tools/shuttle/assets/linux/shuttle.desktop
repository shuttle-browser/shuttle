[Desktop Entry]
Version=1.0
Type=Application
Name=Shuttle Browser
GenericName=Web Browser
Comment=Web browser for AI agents
Exec=@EXEC@ --shuttle-open-agents %U
Icon=shuttle
Terminal=false
StartupNotify=true
StartupWMClass=shuttle
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/shuttle;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@EXEC@ --new-window
