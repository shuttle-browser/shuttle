<?xml version="1.0" encoding="UTF-8"?>
<!-- This file must be kept in sync with components_variant_internal_strings.grd in the internal repo. -->
<!-- Both files define the same strings, but this one includes public .grdp files while the other includes internal ones. -->
<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/components_variant_strings.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="components_variant_strings_en-US.pak" type="data_package" lang="en" />
    <!-- Pseudolocales -->
    <!-- On Android, output some strings into Android's xml string format.
         These strings are tagged with formatter_data="android_java" -->
    <if expr="is_android">
      <output filename="java/res/values/components_variant_strings.xml" lang="en" type="android" context="android_java" />
      <!-- Pseudolocales -->
    </if>
  </outputs>
  <translations>
  </translations>
  <release seq="1">
    <messages fallback_to_english="true">
    </messages>
  </release>
</grit>
