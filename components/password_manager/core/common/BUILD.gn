# Shuttle: the password manager is removed. Only the Credential Management
# types used by blink mojom traits and content/ (WebAuthn, FedCM) remain.
static_library("common") {
  sources = [
    "credential_manager_types.cc",
    "credential_manager_types.h",
  ]
  deps = [ "//base" ]
  public_deps = [ "//url" ]
  configs += [ "//build/config/compiler:wexit_time_destructors" ]
}
