static_library("named_system_lock") {
  sources = [ "lock.h" ]
  deps = [ "//base" ]
  if (is_linux) {
    sources += [ "lock_linux.cc" ]
  } else if (is_mac) {
    sources += [ "lock_mac.mm" ]
  } else if (is_win) {
    sources += [ "lock_win.cc" ]
  }
}

