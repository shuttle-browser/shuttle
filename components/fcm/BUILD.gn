static_library("fcm") {
  sources = [
    "fcm_activity.cc",
    "fcm_activity.h",
    "fcm_app_handler.h",
  ]

  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//components/os_crypt/async/common",
  ]

  deps = [
    "//components/fcm/crypto",
    "//google_apis/gcm",
  ]

  if (is_android) {
    sources += [
      "fcm_driver_android.cc",
      "fcm_driver_android.h",
    ]
    deps += [ "android:jni_headers" ]
  }
}

