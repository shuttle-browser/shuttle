import("//build/config/features.gni")

# Agent Chrome: the passkey model (Google Password Manager passkeys), its sync
# bridge, passkey import and the Signal API helpers are removed.
source_set("browser") {
  sources = [
    "internal_authenticator.h",
    "rate_limiter_slide_window.cc",
    "rate_limiter_slide_window.h",
  ]
  deps = [
    "//base",
    "//components/webauthn:features",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//third_party/blink/public/common",
    "//url",
  ]
}

source_set("client_data") {
  sources = [
    "client_data_json.cc",
    "client_data_json.h",
  ]
  deps = [
    ":common_utils",
    "//base",
    "//url",
  ]
}

source_set("common_utils") {
  sources = [
    "common_utils.cc",
    "common_utils.h",
    "remote_validation.cc",
    "remote_validation.h",
    "webauthn_security_utils.cc",
    "webauthn_security_utils.h",
  ]
  deps = [
    "//base",
    "//components/webauthn:features",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "rate_limiter_slide_window_unittest.cc",
    "remote_validation_unittest.cc",
    "webauthn_security_utils_unittest.cc",
  ]
  deps = [
    ":browser",
    ":common_utils",
    "//base/test:test_support",
    "//components/webauthn:features",
    "//services/network:test_support",
    "//services/network/public/cpp",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]
}

static_library("test_support") {
  testonly = true
  sources = [
    "mock_internal_authenticator.cc",
    "mock_internal_authenticator.h",
    "webauthn_test_utils.cc",
    "webauthn_test_utils.h",
  ]
  deps = [
    ":browser",
    "//base",
    "//content/public/browser",
    "//testing/gmock",
  ]
}
