import("//third_party/protobuf/proto_library.gni")

proto_library("proto") {
  sources = [ "server_certificate_database.proto" ]
  cc_generator_options =
      "dllexport_decl=COMPONENT_EXPORT(SERVER_CERTIFICATE_DATABASE):"
  cc_include = "base/component_export.h"
  component_build_force_source_set = true
  defines = [ "IS_SERVER_CERTIFICATE_DATABASE_IMPL" ]
}

component("server_certificate_database") {
  defines = [ "IS_SERVER_CERTIFICATE_DATABASE_IMPL" ]
  sources = [
    "server_certificate_database.cc",
    "server_certificate_database.h",
    "server_certificate_database_service.cc",
    "server_certificate_database_service.h",
  ]

  deps = [
    "//base",
    "//components/keyed_service/core",
    "//components/prefs",
    "//net",
    "//sql",
    "//third_party/boringssl",
  ]
  public_deps = [ ":proto" ]

  if (is_chromeos) {
    sources += [
      "server_certificate_database_nss_migrator.cc",
      "server_certificate_database_nss_migrator.h",
    ]
  }
}

