import("//components/enterprise/buildflags/buildflags.gni")

source_set("watermarking") {
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [
    "watermark.cc",
    "watermark.h",
  ]

  public_deps = [
    "//skia",
    "//ui/gfx",
  ]
}

source_set("watermarking_handler") {
  sources = []
  deps = []

  if (enterprise_watermark) {
    sources += [
      "watermark_style_policy_handler.cc",
      "watermark_style_policy_handler.h",
    ]

    deps += [
      "//components/enterprise/connectors/core",
      "//components/policy/core/browser",
      "//components/policy/core/common",
      "//components/prefs",
      "//components/strings:components_strings_grit",
    ]
  }
}

