import("//components/enterprise/buildflags/buildflags.gni")

config("extra_warnings") {
  cflags = [ "-Wshadow-field" ]
}

static_library("enterprise") {
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [
  ]

  if (!is_chromeos) {
    sources += [
      "browser/enterprise_switches.cc",
      "browser/enterprise_switches.h",
    ]
  }

  configs += [ "//build/config/compiler:wglobal_constructors" ]

  deps = [
    "//base",
    "//components/certificate_matching",
    "//components/enterprise/common/proto:saas_usage_report_event",
    "//components/policy/core/browser",
    "//components/policy/core/common",
    "//components/policy/proto",
    "//components/pref_registry",
    "//components/prefs",
    "//components/strings",
    "//components/url_matcher",
    "//components/version_info",
    "//crypto",
    "//extensions/buildflags",
    "//google_apis",
    "//net",
    "//services/network/public/cpp",
  ]

  # Include certain intermediate targets as public deps so consumers
  # can start using them as needed.
  public_deps = [
    "//components/enterprise/common/proto:browser_events_proto",
  ]

  if (!is_chromeos) {

    deps += [
      "//third_party/abseil-cpp:absl",
    ]
  }

  if (!is_ios && !is_android) {
    deps += [ "//components/signin/public/identity_manager" ]
  }

  if (is_android) {
    deps += [
      "//components/enterprise/device_attestation/android",
      "//components/enterprise/device_attestation/android:jni_headers",
    ]
  }
}

