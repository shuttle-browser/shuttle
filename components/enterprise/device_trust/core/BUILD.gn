source_set("core") {
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [
    "common_types.cc",
    "device_trust_constants.cc",
  ]

  public = [
    "common_types.h",
    "device_trust_constants.h",
    "device_trust_key_manager.h",
  ]

  deps = [ "//base" ]

  public_deps = [
    "//components/policy/proto",
    "//crypto",
  ]
}

source_set("metrics") {
  configs += [ "//components/enterprise:extra_warnings" ]

  public = [ "metrics_utils.h" ]
  sources = [ "metrics_utils.cc" ]

  public_deps = [
    ":core",
    "//base",
  ]
}

source_set("device_trust_connector_service") {
  configs += [ "//components/enterprise:extra_warnings" ]

  public = [ "device_trust_connector_service.h" ]

  sources = [ "device_trust_connector_service.cc" ]

  deps = [
    "//components/enterprise/device_trust",
    "//components/url_matcher",
    "//url",
  ]

  public_deps = [
    ":core",
    "//base",
    "//components/device_signals/core/browser",
    "//components/keyed_service/core",
    "//components/prefs",
  ]
}

source_set("device_trust_service") {
  configs += [ "//components/enterprise:extra_warnings" ]

  public = [ "device_trust_service.h" ]
  sources = [ "device_trust_service.cc" ]

  deps = [
    ":device_trust_connector_service",
    ":metrics",
    "//components/enterprise/device_trust/core/attestation",
    "//components/enterprise/device_trust/core/signals",
  ]

  public_deps = [
    ":core",
    "//base",
    "//components/keyed_service/core",
  ]
}

