import("//build/config/features.gni")

static_library("strings") {
  configs += [ "//components/enterprise:extra_warnings" ]

  sources = [
    "strings.cc",
    "strings.h",
  ]
}

if (use_blink) {
  static_library("files_scan_data") {
    configs += [ "//components/enterprise:extra_warnings" ]

    sources = [
      "files_scan_data.cc",
      "files_scan_data.h",
    ]
    deps = [
      "//base",
      "//ui/base",
    ]
  }
}

