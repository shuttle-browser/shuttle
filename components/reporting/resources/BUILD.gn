static_library("resource_manager") {
  visibility = [
    "//chrome/browser/*",
    "//chrome/test/*",
    "//components/reporting/*",
  ]
  sources = [
    "resource_manager.cc",
    "resource_manager.h",
  ]

  deps = [ "//base" ]
}

static_library("resource_managed_buffer") {
  visibility = [
    "//chrome/browser/*",
    "//chrome/test/*",
    "//components/reporting/*",
  ]

  sources = [
    "resource_managed_buffer.cc",
    "resource_managed_buffer.h",
  ]

  deps = [
    ":resource_manager",
    "//base",
    "//components/reporting/util:status",
  ]
}

