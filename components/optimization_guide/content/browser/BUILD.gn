if (is_android) {
  import("//build/config/android/rules.gni")
}
import("//components/optimization_guide/features.gni")
import("//mojo/public/tools/bindings/mojom.gni")

static_library("browser") {
  sources = [
    "autofill_annotations_provider.cc",
    "autofill_annotations_provider.h",
    "media_transcript_provider.cc",
    "media_transcript_provider.h",
    "page_content_proto_provider.cc",
    "page_content_proto_provider.h",
    "page_content_proto_util.cc",
    "page_content_proto_util.h",
  ]

  public_deps = [
    "//base",
    "//components/optimization_guide:machine_learning_tflite_buildflags",
    "//components/optimization_guide:optimization_guide_buildflags",
    "//components/optimization_guide/core:core_util",
    "//components/optimization_guide/core:features",
    "//components/optimization_guide/core:page_content",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//content/public/browser",
    "//content/public/common",
    "//services/metrics/public/cpp:metrics_cpp",
    "//services/metrics/public/cpp:ukm_builders",
    "//services/network/public/cpp",
  ]
  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  if (is_android) {
    sources += [ "page_content_proto_provider_bridge.cc" ]
    public_deps += [ "android:jni_headers" ]
  }
}
