import("//build/config/features.gni")

static_library("browser") {
  public = [
    "base_signals_collector.h",
    "browser_utils.h",
    "file_system_signals_collector.h",
    "metrics_utils.h",
    "pref_names.h",
    "settings_client.h",
    "settings_signals_collector.h",
    "signals_aggregator.h",
    "signals_aggregator_impl.h",
    "signals_collector.h",
    "signals_types.h",
    "system_signals_service_host.h",
    "user_context.h",
    "user_delegate.h",
    "user_permission_service.h",
    "user_permission_service_impl.h",
  ]

  sources = [
    "base_signals_collector.cc",
    "browser_utils.cc",
    "file_system_signals_collector.cc",
    "metrics_utils.cc",
    "pref_names.cc",
    "settings_signals_collector.cc",
    "signals_aggregator_impl.cc",
    "signals_types.cc",
    "user_context.cc",
    "user_permission_service_impl.cc",
  ]

  public_deps = [
    "//base",
    "//components/device_signals/core/common/mojom",
    "//components/keyed_service/core",
    "//third_party/abseil-cpp:absl",
  ]

  deps = [
    "//build:blink_buildflags",
    "//build:chromeos_buildflags",
    "//components/device_signals/core/common",
    "//components/device_signals/core/common:features",
    "//components/enterprise/connectors/core:constants",
    "//components/policy/core/browser",
    "//components/policy/core/common",
    "//components/prefs",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/signin/public/identity_manager",
    "//components/version_info",
    "//net",
  ]

  if (use_blink) {
    deps += [ "//content/public/browser" ]
  }

  if (is_android) {
    public += [ "android/android_os_signals_collector.h" ]
    sources += [ "android/android_os_signals_collector.cc" ]
    deps += [
      "//components/safe_browsing/android:safe_browsing_api_handler",
      "//components/safe_browsing/android:safe_browsing_api_handler_util",
    ]
  } else if (is_win || is_mac || is_linux || is_chromeos) {
    public += [
      "agent_signals_collector.h",
      "certificate_signals_collector.h",
      "crowdstrike_client.h",
      "desktop/desktop_os_signals_collector.h",
    ]
    sources += [
      "agent_signals_collector.cc",
      "certificate_signals_collector.cc",
      "crowdstrike_client.cc",
      "desktop/desktop_os_signals_collector.cc",
    ]
    deps += [ "//components/certificate_matching" ]
  }

  if (is_win) {
    sources += [ "win/browser_utils_win.cc" ]

    public_deps += [ "//components/device_signals/core/common/win" ]
  }

  if (is_mac) {
    sources += [ "mac/browser_utils_mac.cc" ]
  }

  if (is_linux || is_chromeos) {
    sources += [ "linux/browser_utils_linux.cc" ]
  }

  if (is_chromeos) {
    deps += [ "//chromeos/dbus/constants" ]
  }

  if (is_android) {
    sources += [ "android/browser_utils_android.cc" ]
  }
}

