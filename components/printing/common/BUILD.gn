import("//build/config/features.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//printing/buildflags/buildflags.gni")

assert(enable_printing)

if (enable_print_media_l10n) {
  source_set("print_media_l10n") {
    sources = [
      "print_media_l10n.cc",
      "print_media_l10n.h",
    ]

    public_deps = [ "//printing/backend" ]

    deps = [
      "//base",
      "//base:i18n",
      "//components/strings:components_strings_grit",
      "//printing:printing_base",
      "//ui/base",
    ]
  }
}

static_library("common") {
  sources = [
    "cloud_print_cdd_conversion.cc",
    "cloud_print_cdd_conversion.h",
    "print_params.cc",
    "print_params.h",
  ]

  deps = [
    ":mojo_interfaces",
    "//base",
    "//components/cloud_devices/common",
    "//printing",
    "//printing/backend",
    "//printing/common",
    "//printing/mojom",
  ]

  if (is_linux) {
    deps += [
      "//build/config/linux/dbus:buildflags",
      "//ui/linux:linux_ui",
    ]
    sources += [
      "print_dialog_linux_factory.cc",
      "print_dialog_linux_factory.h",
    ]
    if (use_dbus) {
      sources += [
        "print_dialog_linux_portal.cc",
        "print_dialog_linux_portal.h",
      ]
      deps += [
        "//components/dbus",
        "//components/strings:components_strings_grit",
        "//dbus",
      ]
    }
  }
}

mojom("mojo_interfaces") {
  sources = [ "print.mojom" ]

  public_deps = [
    "//mojo/public/mojom/base",
    "//printing/mojom",
    "//ui/accessibility/mojom",
    "//ui/gfx/geometry/mojom",
  ]

  enabled_features = []
  if (enable_print_preview) {
    enabled_features += [ "enable_print_preview" ]
  }
}

