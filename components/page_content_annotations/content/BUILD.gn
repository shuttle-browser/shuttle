import("//pdf/features.gni")

source_set("metrics") {
  sources = [
    "annotate_page_content_request_metrics.cc",
    "annotate_page_content_request_metrics.h",
    "page_context_fetcher_metrics.cc",
    "page_context_fetcher_metrics.h",
  ]
  deps = [ "//base" ]
}

source_set("content") {
  sources = [
    "annotate_page_content_request.cc",
    "annotate_page_content_request.h",
    "page_content_annotations_web_contents_observer.cc",
    "page_content_annotations_web_contents_observer.h",
    "page_content_extraction_service.cc",
    "page_content_extraction_service.h",
    "page_content_screenshot_service.cc",
    "page_content_screenshot_service.h",
    "page_context_fetcher.cc",
    "page_context_fetcher.h",
    "page_context_fetcher_manager.cc",
    "page_context_fetcher_manager.h",
    "page_context_fetcher_options.cc",
    "page_context_fetcher_options.h",
  ]

  public_deps = [
    "//base",
    "//components/optimization_guide/content/browser",
    "//components/page_content_annotations/content/browser",
    "//components/paint_preview/browser",
    "//components/paint_preview/common",
    "//components/paint_preview/common/mojom",
    "//components/paint_preview/public",
    "//components/viz/common",
    "//content/public/browser",
    "//skia",
    "//ui/gfx/geometry",
    "//url",
  ]

  deps = [
    ":metrics",
    "//components/continuous_search/browser",
    "//components/optimization_guide/content/browser:page_context_eligibility",
    "//components/optimization_guide/core:page_content",
    "//components/page_content_annotations/core",
    "//components/pdf/common:constants",
    "//components/performance_manager/scenario_api",
    "//components/services/paint_preview_compositor/public/mojom",
    "//pdf:buildflags",
  ]

  if (enable_pdf) {
    deps += [
      "//components/pdf/browser",
      "//mojo/public/cpp/bindings",
      "//pdf/mojom",
    ]
  }
}

