<?xml version="1.0" encoding="utf-8"?>

<!--
  Strings for identifying the slim web view type in chrome UI such as the task manager.
-->

<grit latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/slim_web_view_strings.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="slim_web_view_strings_en-US.pak" type="data_package" lang="en" />
    <if expr="is_ios">
      <!-- iOS uses es-MX for es-419 -->
    </if>
    <!-- The translation console uses 'no' for Norwegian Bokmål. It should
         be 'nb'. -->
    <if expr="is_ios">
      <!-- iOS uses pt for pt-BR -->
    </if>
    <!-- Pseudolocales -->
  </outputs>
  <translations>
    <!-- The translation console uses 'iw' for Hebrew, but we use 'he'. -->
  </translations>
  <release seq="1">
    <messages fallback_to_english="true">
    </messages>
  </release>
</grit>
