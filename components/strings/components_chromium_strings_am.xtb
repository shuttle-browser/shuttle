<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="am">
<translation id="130631256467250065">ለውጦችዎ መሣሪያዎን ዳግም በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="1965068424387304464">የChromium ጠቃሚ ምክር፦ የተቀመጡ የይለፍ ቃላት</translation>
<translation id="6181600115274209660">ወደ
          የShuttle ምናሌ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ይሂዱ እና ውቅርዎ ወደ «ምንም ተኪ» ወይም «ቀጥታ» መዋቀሩን ያረጋግጡ።</translation>
<translation id="8019164406370393370">የብልሽት ሪፖርት በShuttle ውስጥ አይገኝም።</translation>
<translation id="7131945667699137625">ደህንነቱ የተጠበቀ የShuttle ገፅ እየተመለከቱ ነው</translation>
<translation id="3255926992597692024">Chromium የመክፈያ ዘዴዎችን ለመሙላት ቅንብሮችን ለማሻሻል እየሞከረ ነው።</translation>
<translation id="3757825924724354052">የShuttle ዓርማ</translation>
<translation id="3837584850181228767">የChromium ጠቃሚ ምክር፦ የተሻሻለ የደህንነት አሰሳ</translation>
<translation id="4050599136622776556">Chromium የመክፈያ ዘዴዎችን ለማርትዕ እየሞከረ ነው።</translation>
<translation id="8988476603327209803">Shuttle በ<ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />  ክፍት ምንጭ ፕሮጀክት እና በሌላ <ph name="BEGIN_LINK_OSS" />ክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_OSS" /> እውን ሊሆን ችሏል።</translation>
<translation id="2477509191993550467">ይህ ገፅ በShuttle ታግዷል</translation>
<translation id="4604973006041022107">Shuttle በኬላ ወይም የጸረ-ቫይረስ ቅንብሮችዎን አውታረ መረቡን እንዲደርስበት
        ይፍቀዱለት።</translation>
<translation id="4949828774841497663">ወደ መተግበሪያዎች &gt; የሥርዓት ቅንብሮች &gt; አውታረ መረብ ይሂዱ፣
          ንቁ አውታረ መረብ የሚለውን ይምረጡ፣ የዝርዝሮች... አዝራሩ ላይ ጠቅ ያድርጉ እና የተመረጡ ሊሆኑ የሚችሉ
          ማናቸውም ተኪዎችን አይምረጡ።</translation>
<translation id="6683794703230411154">ወደ
          Shuttle ምናሌ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          አውታረ መረብ እና በይነመረብ &gt; ተኪ
          ይሂዱ እና «በራስ-ሰር ቅንብሮችን እወቅ» የሚለውን አይምረጡ።</translation>
<translation id="262795629490583875">እነዚህ ገፆች በShuttle ገንቢዎች ጥቅም ላይ እንዲውሉ የታሰቡ ናቸው እና በንቃት ተጠብቀው ላይቆዩ ወይም ላይፈተሹ ይችላሉ። እነሱን ለማንቃት ወደ <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> ያስሱ፣ የስሕተት አርም ገፆችን ለማንቃት አዝራሩን ጠቅ ያድርጉ እና ከዚያም እንደገና ወደዚህ ገፅ ያስሱ።</translation>
<translation id="6549378540556750549">እንዲሁም Chromium በሌላ <ph name="BEGIN_LINK_OSS" />ክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_OSS" /> እንዲሆን ተደርጓል።</translation>
<translation id="3051968423457057392">ለውጦችዎ Shuttle በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="7251378182421874967">Shuttle ማጣመርን ለመቀጠል የብሉቱዝ መዳረሻ ያስፈልገዋል። <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium በ<ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ክፍት ምንጭ ፕሮጀክት እንዲሆን ተደርጓል።</translation>
<translation id="6298583427647441415">ወደ
        የShuttle ምናሌ &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        ይሂዱና «<ph name="NO_PREFETCH_DESCRIPTION" />»ን አይምረጡ።
        ይሄ ችግሩን ካልፈታው ለተሻሻለ አፈጻጸም ይህን አማራጭ እንደገና መምረጥ እንመክራለን።</translation>
<translation id="8597726643333341451">ደህንነቱ የተጠበቀ የChrome ለሙከራ ገፅ እየተመለከቱ ነው</translation>
<translation id="1627254898104673072">Shuttle በትክክል አልተዘጋም።</translation>
<translation id="9183331186620388872">የChromium ጠቃሚ ምክር፦ በሌንስ ይፈልጉ</translation>
</translationbundle>