<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="130631256467250065">Ձեր փոփոխություններն ուժի մեջ կմտնեն հաջորդ անգամ, երբ վերագործարկեք սարքը:</translation>
<translation id="1965068424387304464">Chromium-ի հետ աշխատելու խորհուրդ․ պահեք գաղտնաբառերը</translation>
<translation id="6181600115274209660">Բացեք
          Shuttle-ի ընտրացանկը &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          և համոզվեք, որ ձեր կազմաձևի համար սահմանված է «առանց պրոքսի սերվերի» կամ «ուղիղ» պարամետրը։</translation>
<translation id="8019164406370393370">Խափանումների մասին հաղորդումը մատչելի չէ Shuttle-ում:</translation>
<translation id="7131945667699137625">Ցուցադրվող Shuttle էջն անվտանգ է</translation>
<translation id="3255926992597692024">Chromium-ը փորձում է փոխել վճարման եղանակների լրացման կարգավորումները։</translation>
<translation id="3757825924724354052">Shuttle-ի պատկերանշանը</translation>
<translation id="3837584850181228767">Chromium-ի հետ աշխատելու խորհուրդ․ օգտագործեք բարելավված Ապահով դիտարկումը</translation>
<translation id="4050599136622776556">Chromium-ը փորձում է փոփոխել վճարման եղանակները։</translation>
<translation id="8988476603327209803">Shuttle-ը ստեղծվել է շնորհիվ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> բաց կոդով նախագծի և այլ <ph name="BEGIN_LINK_OSS" />բաց կոդով ծրագրակազմերի<ph name="END_LINK_OSS" />:</translation>
<translation id="2477509191993550467">Այս էջն արգելափակվել է Shuttle-ի կողմից</translation>
<translation id="4604973006041022107">Հրապատի կամ հակավիրուսային ծրագրի կարգավորումներում
       թույլատրեք Shuttle-ին միանալ ցանցին:</translation>
<translation id="4949828774841497663">Գնացեք Հավելվածներ &gt; Համակարգի կարգավորումներ &gt; Ցանց, ընտրեք
         ակտիվ ցանցը, սեղմեք Մանրամասներ... կոճակը և չեղարկեք ցանկացած                              պրոքսի սերվերի ընտրությունը։</translation>
<translation id="6683794703230411154">Բացեք
          Shuttle-ի ընտրացանկը &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Ցանց և ինտերնետ &gt; Պրոքսի սերվեր
          և անջատեք «Ավտոմատ որոշել կարգավորումները» պարամետրը։</translation>
<translation id="262795629490583875">Այս էջերը, որոնք նախատեսված են Shuttle-ի մշակողների համար, չեն կարող պարբերաբար փորձարկվել կամ մշակվել։ Միացնելու համար անցեք <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> էջ, սեղմեք կոճակը՝ վրիպազերծման էջերը միացնելու համար, այնուհետև վերադարձեք այստեղ։</translation>
<translation id="6549378540556750549">Chromium-ը նաև աշխատում է այլ <ph name="BEGIN_LINK_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_OSS" /> շնորհիվ։</translation>
<translation id="3051968423457057392">Փոփոխություններն ուժի մեջ կմտնեն Shuttle-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="7251378182421874967">Զուգակցումը շարունակելու համար Shuttle-ին հասանելի դարձրեք Bluetooth-ը։ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium-ը ստեղծվել է <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />-ի բաց կոդով նախագծի հիման վրա։</translation>
<translation id="6298583427647441415">Անցեք
          Shuttle ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          և ապանշեք «<ph name="NO_PREFETCH_DESCRIPTION" />»-ը:
          Եթե խնդիրը չվերանա, խորհուրդ ենք տալիս կրկին ընտրել այս տարբերակը՝
          արդյունավետությունը բարձրացնելու համար:</translation>
<translation id="8597726643333341451">Դուք դիտում եք Chrome for Testing-ի անվտանգ էջ</translation>
<translation id="1627254898104673072">Shuttle-ը ճիշտ չի փակվել:</translation>
<translation id="9183331186620388872">Խորհուրդ Chromium-ից․ որոնեք Տեսապակու միջոցով</translation>
</translationbundle>