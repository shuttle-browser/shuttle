<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="130631256467250065">تسري التغييرات في المرة التالية التي تعيد فيها تشغيل الجهاز.</translation>
<translation id="1965068424387304464">‏نصيحة من Chromium: حفظ كلمات المرور أولوية</translation>
<translation id="6181600115274209660">‏يُرجى الانتقال إلى
          قائمة Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          والتأكّد من ضبط الإعدادات على "بلا خادم وكيل" أو "مباشر.".</translation>
<translation id="8019164406370393370">‏تقارير الأعطال غير متاحة في Shuttle.</translation>
<translation id="7131945667699137625">‏أنت تعرض صفحة Shuttle آمنة</translation>
<translation id="3255926992597692024">‏يحاول Chromium تعديل إعدادات ميزة "الملء التلقائي" لبيانات طُرق الدفع.</translation>
<translation id="3757825924724354052">‏شعار Shuttle</translation>
<translation id="3837584850181228767">‏نصيحة من Chromium: حان وقت "الحماية المحسّنة للتصفّح الآمن"</translation>
<translation id="4050599136622776556">‏يحاول Chromium تعديل طُرق الدفع.</translation>
<translation id="8988476603327209803">‏أصبح Shuttle الآن متاحًا بفضل المشروع المفتوح المصدر <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> و<ph name="BEGIN_LINK_OSS" />برامج أخرى مفتوحة المصدر<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">‏تم حظر هذه الصفحة بواسطة متصفّح Shuttle.</translation>
<translation id="4604973006041022107">‏اسمح لـ Shuttle بالدخول إلى الشبكة من خلال إعدادات جدار الحماية أو
        برنامج مكافحة الفيروسات.</translation>
<translation id="4949828774841497663">‏يُرجى الانتقال إلى "التطبيقات" (Applications) &gt; "إعدادات النظام" (System Settings) &gt; "الشبكة" (Network)، ثم اختيار
          الشبكة النشطة، والنقر على زر "التفاصيل…" (Details…‎) وإلغاء اختيار أي خوادم وكيلة
          سبق اختيارها.</translation>
<translation id="6683794703230411154">‏يُرجى الانتقال إلى
          قائمة Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          الشبكة والإنترنت &gt; الخادم الوكيل
          وإلغاء اختيار "رصد الإعدادات تلقائيًا".</translation>
<translation id="262795629490583875">‏هذه الصفحات مخصّصة لمطوّري Shuttle، وقد لا تتم صيانتها أو اختبارها بشكلٍ منتظم. لتفعيلها، يُرجى الانتقال إلى <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> والنقر على زر تفعيل صفحات تصحيح الأخطاء، ثم الانتقال إلى هذه الصفحة مرة أخرى.</translation>
<translation id="6549378540556750549">‏أصبح Chromium متاحًا من خلال <ph name="BEGIN_LINK_OSS" />برنامج آخر مفتوح المصدر<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل Shuttle.</translation>
<translation id="7251378182421874967">‏يجب منح Shuttle الإذن بالوصول إلى البلوتوث لمواصلة عملية 
الإقران. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">‏أصبح Chromium متاحًا من خلال مشروع <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> المفتوح المصدر.</translation>
<translation id="6298583427647441415">‏انتقل إلى
        قائمة Shuttle &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        وألغ اختيار "<ph name="NO_PREFETCH_DESCRIPTION" />"
        في حالة ما إذا لم يؤد ذلك إلى حل المشكلة، نوصي بتحديد هذا الخيار
        مرة أخرى من أجل أداء أفضل.</translation>
<translation id="8597726643333341451">‏أنت تعرض صفحة Chrome for Testing آمنة.</translation>
<translation id="1627254898104673072">‏لم يغلق Shuttle بشكل صحيح.</translation>
<translation id="9183331186620388872">‏نصيحة من Chromium: البحث باستخدام "عدسة Google"</translation>
</translationbundle>