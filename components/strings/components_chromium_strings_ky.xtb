<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="130631256467250065">Өзгөртүүлөрүңүз түзмөгүңүз өчүп күйгөндөн кийин күчүнө кирет.</translation>
<translation id="1965068424387304464">Chromium кеңеши: Сырсөздөрдү сактаңыз</translation>
<translation id="6181600115274209660">Төмөнкүгө өтүңүз:
          Shuttle менюсу &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />.
          Конфигурация "прокси жок" же "түздөн-түз" деп коюлганын текшериңиз.</translation>
<translation id="8019164406370393370">Shuttle'да каталар жөнүндө кабар берүү мүмкүн эмес.</translation>
<translation id="7131945667699137625">Коопсуз Shuttle баракчасын карап жатасыз</translation>
<translation id="3255926992597692024">Chromium төлөм ыкмаларын толтуруу параметрлерин өзгөртүүгө аракет кылууда.</translation>
<translation id="3757825924724354052">Shuttle логотиби</translation>
<translation id="3837584850181228767">Chromium кеңеши: Өркүндөтүлгөн коопсуз серептөө</translation>
<translation id="4050599136622776556">Chromium төлөм ыкмаларын түзөтүүгө аракет кылууда.</translation>
<translation id="8988476603327209803">Shuttle <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ачык булак долбоору жана башка <ph name="BEGIN_LINK_OSS" />ачык программа<ph name="END_LINK_OSS" /> аркылуу мүмкүн болду.</translation>
<translation id="2477509191993550467">Бул баракты Shuttle бөгөттөп койду</translation>
<translation id="4604973006041022107">Shuttle'га коргоо системасында тармакка же антивирус параметрлерине кирүүгө уруксат
          бериңиз.</translation>
<translation id="4949828774841497663">Төмөнкүгө өтүңүз Колдонмолор &gt; Тутумдун параметрлери &gt; Тармак, 
          жигердүү тармакты тандап, Чоо-жайы... баскычын чыкылдатып, колдонулган проксилерди
          тандоодон чыгарыңыз.</translation>
<translation id="6683794703230411154">Төмөнкүгө өтүңүз:
          Shuttle менюсу &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Тармак жана Интернет &gt; Прокси.
          "Параметрлерди автоматтык түрдө аныктоо" дегенди тандоодон чыгарыңыз.</translation>
<translation id="262795629490583875">Бул беттер Shuttle иштеп чыгуучуларына арналган жана жигердүү түрдө иштетилип же сыналбашы мүмкүн. Аларды иштетүү үчүн <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> бөлүмүнө өтүп, мүчүлүштүктөрдү оңдоо беттерин иштетүү үчүн баскычты басып, бул бетке кайтып келиңиз.</translation>
<translation id="6549378540556750549">Chromium башка <ph name="BEGIN_LINK_OSS" />ачык ресурс программасы<ph name="END_LINK_OSS" /> аркылуу да жеткиликтүү.</translation>
<translation id="3051968423457057392">Өзгөртүүлөрүңүз Shuttle кийинки жолу кайра ишке киргизилгенде күчүнө кирет.</translation>
<translation id="7251378182421874967">Жупташтырууну улантуу үчүн Shuttle Bluetooth'ду 
 пайдаланууга уруксат алышы керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ачык ресурс долбоору аркылуу түзүлдү.</translation>
<translation id="6298583427647441415">Shuttle меню &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        өтүп, "<ph name="NO_PREFETCH_DESCRIPTION" />" дегенди тандоодон чыгарыңыз.
        Эгер ушуну менен маселе чечилбесе, иштин майнаптуулугун жогорулатуу үчүн бул параметрди  
        кайра тандаңыз.</translation>
<translation id="8597726643333341451">Коопсуз Chrome for Testing баракчасын карап жатасыз</translation>
<translation id="1627254898104673072">Shuttle туура эмес жабылып калды.</translation>
<translation id="9183331186620388872">Chromium кеңеши: Lens менен издеңиз</translation>
</translationbundle>