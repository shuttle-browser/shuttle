<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="130631256467250065">השינויים ייכנסו לתוקף בפעם הבאה שהמכשיר יופעל מחדש.</translation>
<translation id="1965068424387304464">‏טיפ ל-Chromium: שמירת סיסמאות</translation>
<translation id="6181600115274209660">‏צריך להיכנס אל
          תפריט Shuttle‏ &gt;
          <ph name="SETTINGS_TITLE" />
          ‏&gt;
          <ph name="SYSTEM_TITLE" />
          ‏&gt;
          <ph name="PROXIES_TITLE" />
          ולבדוק שהתצורה מוגדרת לאפשרות no proxy (ללא שרת proxy‏) או direct (ישיר).</translation>
<translation id="8019164406370393370">‏דיווח על התרסקויות אינו זמין ב-Shuttle.</translation>
<translation id="7131945667699137625">‏זהו דף מאובטח של Shuttle</translation>
<translation id="3255926992597692024">‏Chromium מנסה לשנות את ההגדרות למילוי אמצעי התשלום.</translation>
<translation id="3757825924724354052">‏לוגו של Shuttle</translation>
<translation id="3837584850181228767">‏טיפ ל-Chromium: הגרסה המשופרת של הגלישה הבטוחה</translation>
<translation id="4050599136622776556">‏Chromium מנסה לערוך את אמצעי התשלום.</translation>
<translation id="8988476603327209803">‏Shuttle קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM" /> Shuttle‏<ph name="END_LINK_CHROMIUM" /> ו<ph name="BEGIN_LINK_OSS" />תוכנות קוד פתוח<ph name="END_LINK_OSS" /> אחרות.</translation>
<translation id="2477509191993550467">‏הדף הזה נחסם על ידי Shuttle</translation>
<translation id="4604973006041022107">‏שינוי הגדרות חומת האש או האנטי-וירוס כדי לאפשר ל-Shuttle
          לגשת לרשת.</translation>
<translation id="4949828774841497663">‏עוברים אל "אפליקציות" &gt; "הגדרות המערכת" &gt; "רשת", ובוחרים את
          הרשת הפעילה, לוחצים על הכפתור "פרטים…" ומבטלים את הבחירה בכל שרתי ה-proxy
          שנבחרו.</translation>
<translation id="6683794703230411154">‏צריך להיכנס אל
          תפריט Shuttle‏ &gt;
          <ph name="SETTINGS_TITLE" />
          ‏&gt;
          <ph name="SYSTEM_TITLE" />
          ‏&gt;
          <ph name="PROXIES_TITLE" />
          ‏&gt;
          Network &amp; internet (רשת ואינטרנט) &gt; Proxy (שרת proxy)
          ולבטל את הבחירה באפשרות Automatically detect settings (זיהוי אוטומטי של ההגדרות).</translation>
<translation id="262795629490583875">‏הדפים האלה מיועדים למפתחי Shuttle. יכול להיות שהם לא מתוחזקים או נבדקים באופן פעיל. כדי להפעיל אותם, עוברים לכתובת <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, לוחצים על הכפתור כדי להפעיל את מצב ניפוי הבאגים בדפים, ואז מנווטים בחזרה לדף הזה.</translation>
<translation id="6549378540556750549">‏Chromium קיים גם הודות ל<ph name="BEGIN_LINK_OSS" />תוכנת קוד פתוח<ph name="END_LINK_OSS" /> אחרת.</translation>
<translation id="3051968423457057392">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Shuttle‏.</translation>
<translation id="7251378182421874967">‏ל-Shuttle נדרשת גישה ל-Bluetooth כדי להמשיך 
 את ההתאמה. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">‏Chromium קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">‏יש להיכנס אל
        תפריט Shuttle &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        ולבטל את הבחירה באפשרות '<ph name="NO_PREFETCH_DESCRIPTION" />'.
        אם פעולה זו אינה פותרת את הבעיה, מומלץ לבחור שוב באפשרות זו
        לקבלת ביצועים משופרים.</translation>
<translation id="8597726643333341451">‏זהו דף מאובטח של Chrome for Testing</translation>
<translation id="1627254898104673072">‏כיבוי Shuttle לא בוצע כהלכה.</translation>
<translation id="9183331186620388872">‏טיפ ל-Chromium: חיפוש באמצעות Lens</translation>
</translationbundle>