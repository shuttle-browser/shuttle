<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="130631256467250065">Izmaiņas stāsies spēkā nākamajā reizē, kad restartēsiet ierīci.</translation>
<translation id="1965068424387304464">Chromium padoms: paroļu saglabāšana</translation>
<translation id="6181600115274209660">Pārejiet uz Shuttle izvēlni &gt; <ph name="SETTINGS_TITLE" /> &gt; <ph name="SYSTEM_TITLE" /> &gt; <ph name="PROXIES_TITLE" /> un konfigurācijai iestatiet opciju “Bez starpniekservera” vai “Tiešs savienojums”.</translation>
<translation id="8019164406370393370">Avāriju pārskatu sūtīšana nav pieejama pārlūkā Shuttle.</translation>
<translation id="7131945667699137625">Jūs skatāt drošu Shuttle lapu.</translation>
<translation id="3255926992597692024">Pārlūkā Chromium tiek mēģināts mainīt maksājuma veidu aizpildes iestatījumus.</translation>
<translation id="3757825924724354052">Shuttle logotips</translation>
<translation id="3837584850181228767">Chromium padoms: funkcija “Droša pārlūkošana ar papildu aizsardzību”</translation>
<translation id="4050599136622776556">Pārlūkā Chromium tiek mēģināts automātiski rediģēt maksājuma veidus.</translation>
<translation id="8988476603327209803">Shuttle ir kļuvis iespējams, pateicoties <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> atklātā pirmkoda projektam un citai <ph name="BEGIN_LINK_OSS" />atklātā pirmkoda programmatūrai<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Šī lapa ir bloķēta pārlūkā Shuttle.</translation>
<translation id="4604973006041022107">Ugunsmūra vai antivīrusu programmas iestatījumu maiņa, lai atļautu pārlūkam Shuttle piekļūt tīklam.</translation>
<translation id="4949828774841497663">Pārejiet uz sadaļu Applications (Lietojumprogrammas) &gt; System Settings (Sistēmas iestatījumi) &gt; Network (Tīkls), atlasiet aktīvo tīklu, noklikšķiniet uz pogas “Details...” (Detalizēta informācija) un noņemiet atlasi visiem starpniekserveriem, kas, iespējams, ir atlasīti.</translation>
<translation id="6683794703230411154">Pārejiet uz Shuttle izvēlni &gt; <ph name="SETTINGS_TITLE" /> &gt; <ph name="SYSTEM_TITLE" /> &gt; <ph name="PROXIES_TITLE" /> &gt; Tīkls un internets &gt; Starpniekserveris un noņemiet atzīmi no izvēles rūtiņas “Automātiski noteikt iestatījumus”.</translation>
<translation id="262795629490583875">Šīs lapas ir paredzētas Shuttle izstrādātājiem, un tās var nebūt aktīvi uzturētas vai testētas. Lai tās iespējotu, pārejiet uz lapu <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, noklikšķiniet uz pogas, lai iespējotu atkļūdošanas lapas, un pēc tam atkal pārejiet uz šo lapu.</translation>
<translation id="6549378540556750549">Pārlūku Chromium nodrošina arī cita <ph name="BEGIN_LINK_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Izmaiņas stāsies spēkā, kad restartēsiet Shuttle.</translation>
<translation id="7251378182421874967">Pārlūkam Shuttle ir nepieciešama Bluetooth piekļuve, lai turpinātu savienošanu pārī. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Pārlūku Chromium nodrošina <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> atklātā pirmkoda projekts.</translation>
<translation id="6298583427647441415">Atveriet
        Shuttle izvēlni &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        un noņemiet atzīmi no izvēles rūtiņas “<ph name="NO_PREFETCH_DESCRIPTION" />”.
        Ja problēmu neizdodas novērst, ieteicams atkal atlasīt šo opciju,
        lai uzlabotu veiktspēju.</translation>
<translation id="8597726643333341451">Jūs skatāt drošu pārlūka Chrome for Testing lapu</translation>
<translation id="1627254898104673072">Shuttle netika pareizi izslēgts.</translation>
<translation id="9183331186620388872">Chromium padoms: meklējiet, izmantojot Lens</translation>
</translationbundle>