<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="130631256467250065">તમારા ફેરફારો તમે આગલી વખતે તમારા ઉપકરણને ફરી પ્રારંભ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="1965068424387304464">Chromium ટિપ: પાસવર્ડ સાચવો</translation>
<translation id="6181600115274209660">તમે
          Shuttle મેનૂ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          પર જાઓ અને ખાતરી કરો કે તમારું કન્ફિગ્યુરેશન "પ્રૉક્સી નહીં" કે "પ્રત્યક્ષ" પર સેટ કરેલું હોય.</translation>
<translation id="8019164406370393370">Shuttle માં ક્રૅશ રિપોર્ટિંગ ઉપલબ્ધ નથી.</translation>
<translation id="7131945667699137625">તમે એક સુરક્ષિત Shuttle પેજ જોઈ રહ્યાં છો</translation>
<translation id="3255926992597692024">ચુકવણી પદ્ધતિઓ ભરવા માટે, Chromium સેટિંગમાં ફેરફાર કરવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="3757825924724354052">Shuttle લોગો</translation>
<translation id="3837584850181228767">Chromium ટિપ: Safe Browsingમાં વધારેલી સુરક્ષા</translation>
<translation id="4050599136622776556">Chromium ચુકવણી પદ્ધતિઓમાં ફેરફાર કરવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="8988476603327209803">Shuttle એ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ઓપન સ્રોત પ્રોજેક્ટ અને અન્ય <ph name="BEGIN_LINK_OSS" />ઓપન સ્રોત સૉફ્ટવેર<ph name="END_LINK_OSS" /> દ્વારા શક્ય બનાવ્યું છે.</translation>
<translation id="2477509191993550467">Shuttle દ્વારા આ પેજને બ્લૉક કરવામાં આવ્યું છે</translation>
<translation id="4604973006041022107">Shuttleને તમારા ફાયરવૉલ અથવા ઍન્ટિવાયરસ સેટિંગમાં નેટવર્ક ઍક્સેસ કરવાની
        મંજૂરી આપો.</translation>
<translation id="4949828774841497663">ઍપ્લિકેશન &gt; સિસ્ટમના સેટિંગ &gt; નેટવર્ક પર જાઓ,
          સક્રિય નેટવર્ક, વિગતો પર ક્લિક કરો... બટન પસંદ કરો, અને કોઈપણ પ્રૉક્સી નાપસંદ કરો
          જે પસંદ કરવામાં આવ્યું હોય.</translation>
<translation id="6683794703230411154">તમે
          Shuttle મેનૂ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          નેટવર્ક અને ઇન્ટરનેટ &gt; પ્રૉક્સી
          પર જાઓ અને "ઑટોમૅટિક રીતે સેટિંગની ભાળ મેળવો સેટિંગ"ને નાપસંદ કરો.</translation>
<translation id="262795629490583875">આ પેજ Shuttle ડેવલપર દ્વારા ઉપયોગમાં લેવાના હેતુથી બનાવવામાં આવ્યા છે અને તેમની સક્રિય રીતે જાળવણી અથવા પરીક્ષણ ન કરવામાં આવે એવું બની શકે છે. તેમને ચાલુ કરવા માટે, નૅવિગેટ કરીને <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> પર જાઓ, પેજને ડિબગ કરવાની સુવિધા ચાલુ કરવા માટેના બટન પર ક્લિક કરો અને નૅવિગેટ કરીને ફરી પાછા આ પેજ પર આવો.</translation>
<translation id="6549378540556750549">અન્ય <ph name="BEGIN_LINK_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_OSS" /> દ્વારા પણ Chromiumને શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="3051968423457057392">તમારા ફેરફારો તમે આગલી વખતે Shuttle ફરીથી લોંચ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="7251378182421874967">જોડાણ કરવાનું ચાલુ રાખવા માટે, Shuttleને બ્લૂટૂથના ઍક્સેસની 
 જરૂર છે. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637"><ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ઓપન સૉર્સ પ્રોજેક્ટ દ્વારા પણ Chromiumને શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="6298583427647441415">Shuttle મેનૂ &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        પર જાઓ અને "<ph name="NO_PREFETCH_DESCRIPTION" />" પસંદગીને હટાવો.
        જો આનાથી સમસ્યા ઉકેલાતી નથી, તો અમે સુધારેલ પ્રદર્શન માટે ફરીથી આ વિકલ્પને પસંદ કરવાની 
        ભલામણ કરીએ છીએ.</translation>
<translation id="8597726643333341451">તમે સુરક્ષિત Chrome for Testing પેજ જોઈ રહ્યાં છો</translation>
<translation id="1627254898104673072">Shuttle યોગ્ય રીતે શટ ડાઉન થયું નહોતું.</translation>
<translation id="9183331186620388872">Chromium ટિપ: Lens વડે શોધો</translation>
</translationbundle>