<!DOCTYPE translationbundle>
<translationbundle lang="my">
<translation id="130631256467250065">သင် ပြောင်းလဲခဲ့သည်များမျာ သင်က သင်၏ ကိရိယာကို နောက်တစ်ကြိမ် ပြန်ဖွင့်စဉ် အကျိုးသက်ရောက် လာကြပါမည်။</translation>
<translation id="1965068424387304464">Chromium အကြံပြုချက်- စကားဝှက်များ သိမ်းပါ</translation>
<translation id="6181600115274209660">ဤသို့သွားပါ-
          Shuttle မီနူး &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ထို့နောက် စီစဉ်သတ်မှတ်ချက်ကို “ပရောက်စီ အသုံးမပြုရန်” (သို့) “တိုက်ရိုက်” ဟု သတ်မှတ်ပါ။</translation>
<translation id="8019164406370393370">Shuttle တွင်ပျက်စီးမှု အစီရင်ခံချက် မရနိုင်ပါ။</translation>
<translation id="7131945667699137625">သင်သည် လုံခြုံသည့် Shuttle စာမျက်နှာကို ကြည့်ရှုနေပါသည်</translation>
<translation id="3255926992597692024">Chromium သည် ငွေပေးချေနည်းလမ်းများ ဖြည့်သည့် ဆက်တင်များကို ပြင်ဆင်ရန် ကြိုးပမ်းနေသည်။</translation>
<translation id="3757825924724354052">Shuttle လိုဂို</translation>
<translation id="3837584850181228767">Chromium အကြံပြုချက်- အရည်အသွေးမြှင့် ဘေးကင်းလုံခြုံသည့် အသုံးပြုမှု</translation>
<translation id="4050599136622776556">Chromium က ငွေပေးချေနည်းလမ်းများကို ပြင်ရန် ကြိုးပမ်းနေသည်။</translation>
<translation id="8988476603327209803">Shuttle အား <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ပွင့်လင်းအရင်းမြစ် စီမံကိန်းနှင့် အခြား <ph name="BEGIN_LINK_OSS" />ပွင့်လင်း အရင်းမြစ် ဆော့ဝဲ<ph name="END_LINK_OSS" /> မှပြုလုပ်ထားပါသည်။</translation>
<translation id="2477509191993550467">Shuttle က ဤစာမျက်နှာကို ပိတ်ထားသည်</translation>
<translation id="4604973006041022107">သင့် Firewall သို့မဟုတ် ဗိုင်းရပ်စ်ခုခံစနစ် ဆက်တင်များအတွင်း ကွန်ရက်အသုံးပြုရန် Shuttle ကိုခွင့်ပြုပါ။</translation>
<translation id="4949828774841497663">‘အပလီကေးရှင်းများ’ &gt; ‘စနစ် ဆက်တင်များ’ &gt; ‘ကွန်ရက်’ သို့ သွားပြီး
          သုံးနေသောကွန်ရက်ကို ရွေးပါ။ ‘အသေးစိတ်...’ ခလုတ်ကို နှိပ်ပြီး ရွေးထားသော ပရောက်စီများကို
          ပြန်ဖြုတ်ပါ။</translation>
<translation id="6683794703230411154">ဤသို့သွားပါ-
          Shuttle မီနူး &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          ကွန်ရက်နှင့် အင်တာနက် &gt; ပရောက်စီ
          ထို့နောက် “ဆက်တင်များကို အလိုအလျောက် သိရှိရန်” ကို ပြန်ဖြုတ်ပါ။</translation>
<translation id="262795629490583875">ဤစာမျက်နှာများကို Shuttle ဆော့ဖ်ဝဲရေးသူများ သုံးရန်အတွက် ရည်ရွယ်ထားပြီး အမြဲတစေ ပြုပြင်ထိန်းသိမ်းခြင်း/စမ်းသပ်ထားခြင်း မရှိနိုင်ပါ။ ၎င်းတို့ကိုဖွင့်ရန် <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> သို့ သွားပြီး အမှားရှာပြင်ခြင်းစာမျက်နှာများ ဖွင့်ရန် ခလုတ်ကိုနှိပ်ပြီးနောက် ဤစာမျက်နှာသို့ ပြန်လာပါ။</translation>
<translation id="6549378540556750549">အခြား <ph name="BEGIN_LINK_OSS" />အခမဲ့ ရင်းမြစ်ဆော့ဖ်ဝဲ<ph name="END_LINK_OSS" /> ဖြင့်လည်း Chromium ကို ထုတ်လုပ်ထားသည်။</translation>
<translation id="3051968423457057392">Shuttle ကိုသင်နောက်တစ်ကြိမ် ပြန်လည်စတင်လျှင် သင့်ပြောင်းလဲမှုများ အကျိုးသက်ရောက်မှု ရှိမည်ဖြစ်သည်။</translation>
<translation id="7251378182421874967">Shuttle သည် ဆက်လက်တွဲချိတ်ရန် ဘလူးတုသ်သုံးခွင့် 
 လိုပါသည်။ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637"><ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> အခမဲ့ ရင်းမြစ်ပရောဂျက်ဖြင့် Chromium ကို ထုတ်လုပ်ထားသည်။</translation>
<translation id="6298583427647441415">Shuttle မီနူးဆီကို သွားပါ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          ပြီးတော့ "<ph name="NO_PREFETCH_DESCRIPTION" />"ကို ရွေးပါ။
          ၎င်းက ပြဿနာကို ဖြေရှင်းမပေးနိုင်ခဲ့သော်၊ ပိုပြီး အဆင့်မြင့်သည့် လုပ်ကိုင်မှုအတွက် ဒီရွေးချယ်မှုကို ထပ်ပြီး ရွေးချယ်ရန်ကို ကျွန်ပ်တို့ အကြံပေးလိုပါသည်။</translation>
<translation id="8597726643333341451">သင်သည် လုံခြုံသည့် Chrome for Testing စာမျက်နှာကို ကြည့်နေခြင်းဖြစ်သည်</translation>
<translation id="1627254898104673072">Shuttle သည် မှန်ကန်စွာ ပိတ်မသွားခဲ့ပါ။</translation>
<translation id="9183331186620388872">Chromium အကြံပြုချက်- Lens ဖြင့် ရှာပါ</translation>
</translationbundle>