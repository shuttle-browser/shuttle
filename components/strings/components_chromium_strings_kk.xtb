<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="130631256467250065">Өзгерістеріңіз құрылғыңызды келесі қайта іске қосқанда күшіне енеді.</translation>
<translation id="1965068424387304464">Chromium-мен жұмыс істеу бойынша кеңес: құпия сөздерді сақтаңыз</translation>
<translation id="6181600115274209660">"Shuttle мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />"
          тармағына өтіп, конфигурация "прокси-серверсіз" немесе "тікелей" күйіне орнатылғанын тексеріңіз.</translation>
<translation id="8019164406370393370">Бұзылу туралы хабарлау мүмкіндігі Shuttle қызметінде қолжетімді емес.</translation>
<translation id="7131945667699137625">Қауіпсіз Shuttle бетін көрудесіз</translation>
<translation id="3255926992597692024">Chromium төлеу әдістерін толтыру параметрлерін өзгерткісі келеді.</translation>
<translation id="3757825924724354052">Shuttle логотипі</translation>
<translation id="3837584850181228767">Chromium-мен жұмыс істеу бойынша кеңес: Күшейтілген Safe Browsing</translation>
<translation id="4050599136622776556">Chromium төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="8988476603327209803">Shuttle қолданбасына <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ашық бастапқы код жобасы мен басқа <ph name="BEGIN_LINK_OSS" />ашық бастапқы код бағдарламалық жасақтамасы<ph name="END_LINK_OSS" /> арқылы қол жеткізілді.</translation>
<translation id="2477509191993550467">Бұл бетке Shuttle тарапынан тыйым салынған.</translation>
<translation id="4604973006041022107">Брандмауэр немесе антивирус параметрлерінде Shuttle жүйесіне
          желіге кіруге рұқсат беріңіз.</translation>
<translation id="4949828774841497663">"Қолданбалар &gt; Жүйе параметрлері &gt; Желі" тармағына өтіп, белсенді желіні таңдаңыз да, "Мәліметтер..." түймесін басып, бұрын таңдалған прокси-серверлерді таңдаудан алыңыз.</translation>
<translation id="6683794703230411154">"Shuttle мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Желі және интернет &gt; Прокси-сервер"
          тармағына өтіп, "Параметрлерді автоматты түрде анықтау" опциясын таңдаудан алыңыз.</translation>
<translation id="262795629490583875">Бұл беттер Shuttle әзірлеушілерінің қолданысына арналған және белсенді түрде жүргізілмеуі не сыналмауы мүмкін. Оларды қосу үшін <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> сайтына өтіп, түзету беттерін қосатын түймені басып, осы бетке қайтып келіңіз.</translation>
<translation id="6549378540556750549">Сонымен қатар Chromium басқа <ph name="BEGIN_LINK_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="3051968423457057392">Өзгертулеріңіз Shuttle келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="7251378182421874967">Жұптауды жалғастыру үшін Shuttle-ге Bluetooth-ты пайдалану рұқсаты керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium браузері <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ашық кодты бағдарлама жобасы арқылы қолжетімді болады.</translation>
<translation id="6298583427647441415">Shuttle мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          тармағына өтіп, "<ph name="NO_PREFETCH_DESCRIPTION" />" таңдауын алып тастаңыз.
          Бұл мәселені шешпесе, өнімділікті жақсарту үшін осы опцияны қайта
          таңдауды ұсынамыз.</translation>
<translation id="8597726643333341451">Қауіпсіз Chrome for Testing бетін көріп отырсыз.</translation>
<translation id="1627254898104673072">Shuttle дұрыс өшірілмеді.</translation>
<translation id="9183331186620388872">Chromium кеңесі: Lens арқылы іздеңіз</translation>
</translationbundle>