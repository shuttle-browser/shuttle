<!DOCTYPE translationbundle>
<translationbundle lang="pa">
<translation id="130631256467250065">ਤੁਹਾਡੀਆਂ ਤਬਦੀਲੀਆਂ ਅਗਲੀ ਵਾਰ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਨੂੰ ਮੁੜ ਚਾਲੂ ਕਰਨ 'ਤੇ ਲਾਗੂ ਹੋਣਗੀਆਂ।</translation>
<translation id="1965068424387304464">Chromium ਨੁਕਤਾ: ਪਾਸਵਰਡ ਰੱਖਿਅਤ ਕਰੋ</translation>
<translation id="6181600115274209660">Shuttle
          ਮੀਨੂ&gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" /> ਤੇ ਜਾਓ 
          ਅਤੇ ਪੱਕਾ ਕਰੋ ਕਿ ਸੰਰੂਪਣ "ਪ੍ਰੌਕਸੀ ਨਹੀਂ ਹੈ" ਜਾਂ "ਡਾਇਰੈਕਟ" ਤੇ ਸੈੱਟ ਹੈ।</translation>
<translation id="8019164406370393370">ਕ੍ਰੈਸ਼ ਰਿਪੋਰਟਿੰਗ Shuttle ਵਿੱਚ ਉਪਲਬਧ ਨਹੀਂ ਹੈ।</translation>
<translation id="7131945667699137625">ਤੁਸੀਂ ਇੱਕ ਸੁਰੱਖਿਅਤ Shuttle ਪੰਨਾ  ਦੇਖ  ਰਹੇ ਹੋ</translation>
<translation id="3255926992597692024">ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਨੂੰ ਭਰਨ ਲਈ Chromium ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸੋਧ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰ ਰਿਹਾ ਹੈ।</translation>
<translation id="3757825924724354052">Shuttle ਲੋਗੋ</translation>
<translation id="3837584850181228767">Chromium ਨੁਕਤਾ: ਵਿਸਤ੍ਰਿਤ ਸੁਰੱਖਿਅਤ ਬ੍ਰਾਊਜ਼ਿੰਗ</translation>
<translation id="4050599136622776556">Chromium ਭੁਗਤਾਨ ਵਿਧੀਆਂ ਦਾ ਸੰਪਾਦਨ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰ ਰਿਹਾ ਹੈ।</translation>
<translation id="8988476603327209803">Shuttle ਨੂੰ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ਖੁੱਲ੍ਹੇ ਸਰੋਤ ਪ੍ਰੋਜੈਕਟ ਅਤੇ ਹੋਰ <ph name="BEGIN_LINK_OSS" />ਖੁੱਲ੍ਹੇ ਸਰੋਤ ਸਾਫ਼ਟਵੇਅਰ<ph name="END_LINK_OSS" /> ਵੱਲੋਂ ਸੰਭਵ ਬਣਾਇਆ ਗਿਆ ਹੈ।</translation>
<translation id="2477509191993550467">ਇਸ ਪੰਨੇ ਨੂੰ Shuttle ਵੱਲੋਂ ਬਲਾਕ ਕੀਤਾ ਗਿਆ ਹੈ</translation>
<translation id="4604973006041022107">Shuttle ਨੂੰ ਆਪਣੀਆਂ ਫ਼ਾਇਰਵਾਲ ਜਾਂ ਐਂਟੀਵਾਇਰਸ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਨੈੱਟਵਰਕ ਤੱਕ ਪਹੁੰਚ ਕਰਨ ਦਿਓ।</translation>
<translation id="4949828774841497663">ਐਪਲੀਕੇਸ਼ਨਾਂ &gt; ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ &gt; ਨੈੱਟਵਰਕ 'ਤੇ ਜਾਓ, ਕਿਰਿਆਸ਼ੀਲ ਨੈੱਟਵਰਕ ਦੀ ਚੋਣ ਕਰੋ, ਵੇਰਵੇ... ਬਟਨ 'ਤੇ ਕਲਿੱਕ ਕਰੋ ਅਤੇ ਚੁਣੀ ਗਈ ਕਿਸੇ ਵੀ ਪ੍ਰੌਕਸੀ ਨੂੰ ਅਣ-ਚੁਣਿਆ ਕਰੋ।</translation>
<translation id="6683794703230411154">Shuttle
          ਮੀਨੂ 'ਤੇ ਜਾਓ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          ਨੈੱਟਵਰਕ ਅਤੇ ਇੰਟਰਨੈੱਟ &gt; ਪ੍ਰੌਕਸੀ
          ਅਤੇ "ਸੈਟਿੰਗਾਂ ਦਾ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਪਤਾ ਲਗਾਓ" ਨੂੰ ਅਣ-ਚੁਣਿਆ ਕਰੋ।</translation>
<translation id="262795629490583875">ਇਹ ਪੰਨੇ Shuttle ਵਿਕਾਸਕਾਰਾਂ ਵੱਲੋਂ ਵਰਤੋਂ ਕਰਨ ਲਈ ਬਣਾਏ ਗਏ ਹਨ ਅਤੇ ਹੋ ਸਕਦਾ ਹੈ ਕਿ ਇਨ੍ਹਾਂ ਦੀ ਸਮੇਂ-ਸਮੇਂ 'ਤੇ ਸਾਂਭ-ਸੰਭਾਲ ਜਾਂ ਜਾਂਚ ਨਾ ਕੀਤੀ ਜਾਂਦੀ ਹੋਵੇ। ਉਨ੍ਹਾਂ ਨੂੰ ਚਾਲੂ ਕਰਨ ਲਈ, <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> 'ਤੇ ਜਾਓ, ਡੀਬੱਗ ਪੰਨਿਆਂ ਦੀ ਸੈਟਿੰਗ ਨੂੰ ਚਾਲੂ ਕਰਨ ਲਈ ਬਟਨ 'ਤੇ ਕਲਿੱਕ ਕਰੋ ਅਤੇ ਫਿਰ ਇਸ ਪੰਨੇ 'ਤੇ ਦੁਬਾਰਾ ਜਾਓ।</translation>
<translation id="6549378540556750549">Chromium ਨੂੰ ਹੋਰ <ph name="BEGIN_LINK_OSS" />ਖੁੱਲ੍ਹੇ ਸਰੋਤ ਸਾਫ਼ਟਵੇਅਰ<ph name="END_LINK_OSS" /> ਦੀ ਮਦਦ ਨਾਲ ਵੀ ਸੰਭਵ ਬਣਾਇਆ ਗਿਆ ਹੈ।</translation>
<translation id="3051968423457057392">ਤੁਹਾਡੀਆਂ ਤਬਦੀਲੀਆਂ ਅਗਲੀ ਵਾਰ ਤੁਹਾਡੇ ਵੱਲੋਂ Shuttle ਨੂੰ ਰੀਲੌਂਚ ਕਰਨ 'ਤੇ ਲਾਗੂ ਹੋਣਗੀਆਂ।</translation>
<translation id="7251378182421874967">ਜੋੜਾਬੱਧਕਰਨ ਜਾਰੀ ਰੱਖਣ ਲਈ Shuttle ਨੂੰ ਬਲੂਟੁੱਥ ਪਹੁੰਚ 
 ਦੀ ਲੋੜ ਹੈ। <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium ਨੂੰ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ਖੁੱਲ੍ਹੇ ਸਰੋਤ ਪ੍ਰੋਜੈਕਟ ਦੀ ਮਦਦ ਨਾਲ ਸੰਭਵ ਬਣਾਇਆ ਗਿਆ ਹੈ।</translation>
<translation id="6298583427647441415">Shuttle ਮੀਨੂ&gt; ਤੇ ਜਾਓ
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          ਅਤੇ "<ph name="NO_PREFETCH_DESCRIPTION" />" ਨੂੰ ਅਚੋਣਵਾਂ ਕਰੋ।
          ਜੇਕਰ ਇਸ ਨਾਲ ਸਮੱਸਿਆ ਹੱਲ ਨਹੀਂ ਹੁੰਦੀ , ਤਾਂ ਅਸੀਂ ਬਿਹਤਰ ਪ੍ਰਦਰਸ਼ਨ ਲਈ ਇਸ ਚੋਣ ਨੂੰ ਦੁਬਾਰਾ
          ਚੁਣਨ ਦੀ ਸਲਾਹ ਦਿੰਦੇ ਹਾਂ।</translation>
<translation id="8597726643333341451">ਤੁਸੀਂ ਇੱਕ ਸੁਰੱਖਿਅਤ Chrome for Testing ਪੰਨਾ ਦੇਖ ਰਹੇ ਹੋ</translation>
<translation id="1627254898104673072">Shuttle ਸਹੀ ਢੰਗ ਨਾਲ ਬੰਦ ਨਹੀਂ ਹੋਇਆ।</translation>
<translation id="9183331186620388872">Chromium ਦਾ ਨੁਕਤਾ: Lens ਰਾਹੀਂ ਖੋਜੋ</translation>
</translationbundle>