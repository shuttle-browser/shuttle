<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="130631256467250065">Ndryshimet e tua do të hyjnë në fuqi herën tjetër kur të rinisësh pajisjen.</translation>
<translation id="1965068424387304464">Këshillë për Chromium: Ruaj fjalëkalimet</translation>
<translation id="6181600115274209660">Shko te
          menyja e Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          dhe sigurohu që konfigurimi yt të jetë i caktuar në "pa proxy" ose "i drejtpërdrejtë".</translation>
<translation id="8019164406370393370">Raportimi i ndërprerjes aksidentale nuk ofrohet në Shuttle.</translation>
<translation id="7131945667699137625">Po shikon një faqe të sigurt të Shuttle</translation>
<translation id="3255926992597692024">Chromium po përpiqet të modifikojë cilësimet për plotësimin e mënyrave të pagesave.</translation>
<translation id="3757825924724354052">Logoja e Shuttle</translation>
<translation id="3837584850181228767">Këshillë për Chromium: "Shfletimi i sigurt i përmirësuar"</translation>
<translation id="4050599136622776556">Chromium po përpiqet të modifikojë mënyrat e pagesës.</translation>
<translation id="8988476603327209803">Shuttle është bërë i mundur nga projekti me burim të hapur <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> dhe <ph name="BEGIN_LINK_OSS" />softuerë të tjerë me burim të hapur<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Kjo faqe është bllokuar nga Shuttle</translation>
<translation id="4604973006041022107">Lejo Shuttle të qaset në rrjet, në cilësimet e murit mbrojtës ose
      të antivirusit.</translation>
<translation id="4949828774841497663">Shko te Aplikacionet &gt; Cilësimet e sistemit &gt; Rrjeti, zgjidh
          rrjetin aktiv, kliko te butoni "Detajet..." , dhe hiq përzgjedhjen e çdo proxy
          që mund të jetë zgjedhur.</translation>
<translation id="6683794703230411154">Shko te
          menyja e Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Rrjeti dhe interneti &gt; Proxy
          dhe anulo zgjedhjen e "Zbulo automatikisht cilësimet".</translation>
<translation id="262795629490583875">Këto faqe synohen të përdoren nga zhvilluesit e Shuttle dhe mund të mos mirëmbahen apo testohen në mënyrë aktive. Për t'i aktivizuar ato, navigo te <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, kliko butonin për të aktivizuar faqet e korrigjimit dhe më pas navigo përsëri te kjo faqe.</translation>
<translation id="6549378540556750549">Chromium është mundësuar po ashtu nga <ph name="BEGIN_LINK_OSS" />softuerë të tjerë me burim të hapur<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Ndryshimet e tua do të hyjnë në fuqi herën tjetër kur të rinisësh Shuttle.</translation>
<translation id="7251378182421874967">Shuttle i nevojitet leje te Bluetooth-i për të vazhduar me çiftimin. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium është mundësuar nga projekti me burim të hapur <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">Shko te
          menyja e Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          dhe anulo zgjedhjen e "<ph name="NO_PREFETCH_DESCRIPTION" />."
          Nëse kjo nuk e zgjidh këtë problem, rekomandojmë ta zgjedhësh përsëri këtë opsion
          për një veprimtari më të mirë funksionimi.</translation>
<translation id="8597726643333341451">Po shikon një faqe të sigurt të Chrome for Testing</translation>
<translation id="1627254898104673072">Shuttle nuk u mbyll si duhet.</translation>
<translation id="9183331186620388872">Këshillë për Chromium: Kërko me "Lenten"</translation>
</translationbundle>