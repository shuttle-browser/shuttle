<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="130631256467250065">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ອຸປະກອນຂອງທ່ານໃໝ່.</translation>
<translation id="1965068424387304464">ເຄັດລັບ Chromium: ບັນທຶກລະຫັດຜ່ານ</translation>
<translation id="6181600115274209660">ເຂົ້າໄປ
          ເມນູ Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ແລະ ກວດສອບວ່າມີການກຳນົດການຕັ້ງຄ່າຂອງທ່ານເປັນ "ບໍ່ມີພຣັອກຊີ" ຫຼື "ໂດຍກົງ".</translation>
<translation id="8019164406370393370">ບໍ່ມີການລາຍງານການຂັດຂ້ອງຢູ່ໃນ Shuttle​.</translation>
<translation id="7131945667699137625">ທ່ານກຳລັງເບິ່ງໜ້າ Shuttle ທີ່ປອດໄພ</translation>
<translation id="3255926992597692024">Chromium ກຳລັງພະຍາຍາມແກ້ໄຂການຕັ້ງຄ່າສຳລັບການຕື່ມວິທີການຈ່າຍເງິນ.</translation>
<translation id="3757825924724354052">ໂລໂກ້ Shuttle</translation>
<translation id="3837584850181228767">ເຄັດລັບ Chromium: Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນ</translation>
<translation id="4050599136622776556">Chromium ກຳລັງພະຍາຍາມແກ້ໄຂວິທີການຈ່າຍເງິນ.</translation>
<translation id="8988476603327209803">Shuttle ເຮັດໃຫ້ເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ໂຄງການ open source ແລະ <ph name="BEGIN_LINK_OSS" />ຊອບແວ open source<ph name="END_LINK_OSS" /> ອື່ນໆ.</translation>
<translation id="2477509191993550467">ໜ້ານີ້ຖືກບລັອກໄວ້ໂດຍ Shuttle</translation>
<translation id="4604973006041022107">ອະນຸຍາດໃຫ້ Shuttle ເຂົ້າເຖິງເຄືອຂ່າຍໃນການຕັ້ງຄ່າໄຟຣ໌ວໍ ຫຼື ໂປຣແກຣມ
          ຕ້ານໄວຣັສຂອງທ່ານ.</translation>
<translation id="4949828774841497663">ເຂົ້າໄປແອັບພລິເຄຊັນ &gt; ການຕັ້ງຄ່າລະບົບ &gt; ເຄືອຂ່າຍ, ເລືອກ
          ເຄືອຂ່າຍທີ່ນຳໃຊ້ຢູ່, ຄລິກປຸ່ມລາຍລະອຽດ... ແລ້ວເຊົາເລືອກພຣັອກຊີໃດກໍຕາມ
          ທີ່ອາດເລືອກໄວ້.</translation>
<translation id="6683794703230411154">ເຂົ້າໄປ
          ເມນູ Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          ເຄືອຂ່າຍ ແລະ ອິນເຕີເນັດ &gt; ພຣັອກຊີ
          ແລ້ວເຊົາເລືອກ "ກວດຫາການຕັ້ງຄ່າໂດຍອັດຕະໂນມັດ".</translation>
<translation id="262795629490583875">ໜ້າເຫຼົ່ານີ້ມີໄວ້ສຳລັບນັກພັດທະນາ Shuttle ເທົ່ານັ້ນ ແລະ ອາດບໍ່ໄດ້ຮັບການບຳລຸງຮັກສາ ຫຼື ທົດສອບຢ່າງສະໝ່ຳສະເໝີ. ເພື່ອເປີດການນຳໃຊ້, ໃຫ້ເຂົ້າໄປ <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, ຄລິກປຸ່ມເພື່ອເປີດການນຳໃຊ້ໜ້າດີບັກ, ຈາກນັ້ນນຳທາງໄປຫາໜ້ານີ້ອີກຄັ້ງ.</translation>
<translation id="6549378540556750549">Chromium ຍັງເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_OSS" /> ອື່ນນຳອີກ.</translation>
<translation id="3051968423457057392">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ Shuttle ໃໝ່.</translation>
<translation id="7251378182421874967">Shuttle ຕ້ອງການສິດເຂົ້າເຖິງ Bluetooth ເພື່ອສືບຕໍ່ 
 ການຈັບຄູ່. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium ເປັນໄປໄດ້ໂດຍໂຄງການໂອເພນຊອດ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">ໄປ​ທີ່
          ເມ​ນູ Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          ແລະ​ຖອນ​ເລືອກ "<ph name="NO_PREFETCH_DESCRIPTION" />."
          ຖ້າອັນ​ນີ້​ບໍ່​ແກ້​ໄຂ​ບັນ​ຫາ​ໄດ້, ພວກ​ເຮົາ​ແນະ​ນຳ​ໃຫ້​ເລືອກ​ເອົາ​ທາງ​ເລືອກ​ນີ້
          ອີກ​ເພື່ອ​ເພີ່ມ​ການ​ປະ​ຕິ​ບັດ​ງານ.</translation>
<translation id="8597726643333341451">ທ່ານກຳລັງເບິ່ງໜ້າ Chrome ສຳລັບການທົດສອບທີ່ປອດໄພ</translation>
<translation id="1627254898104673072">Shuttle ມອດ​ຢ່າງບໍ່​ຖືກ​ຕ້ອງ.</translation>
<translation id="9183331186620388872">ເຄັດລັບສຳລັບ Chromium: ຊອກຫາດ້ວຍ Lens</translation>
</translationbundle>