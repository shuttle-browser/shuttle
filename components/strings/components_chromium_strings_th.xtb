<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="130631256467250065">การเปลี่ยนแปลงของคุณจะมีผลในครั้งถัดไปที่คุณรีสตาร์ทอุปกรณ์ของคุณ</translation>
<translation id="1965068424387304464">เคล็ดลับสำหรับ Chromium: บันทึกรหัสผ่าน</translation>
<translation id="6181600115274209660">ไปที่
          เมนู Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          และตรวจสอบว่าคุณได้ตั้งการกำหนดค่าเป็น "ไม่มีพร็อกซี" หรือ "โดยตรง"</translation>
<translation id="8019164406370393370">ไม่มีการรายงานข้อขัดข้องใน Chrome</translation>
<translation id="7131945667699137625">คุณกำลังดูหน้า Shuttle ที่ปลอดภัย</translation>
<translation id="3255926992597692024">Chromium กำลังพยายามแก้ไขการตั้งค่าสำหรับการกรอกวิธีการชำระเงิน</translation>
<translation id="3757825924724354052">โลโก้ Shuttle</translation>
<translation id="3837584850181228767">เคล็ดลับสำหรับ Chromium: Safe Browsing พร้อมการปกป้องที่ดียิ่งขึ้น</translation>
<translation id="4050599136622776556">Chromium กําลังพยายามแก้ไขวิธีการชําระเงิน</translation>
<translation id="8988476603327209803">Shuttle เกิดขึ้นได้ด้วยการสนับสนุนจากโครงการโอเพนซอร์ส <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> และ<ph name="BEGIN_LINK_OSS" />ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_OSS" />อื่นๆ</translation>
<translation id="2477509191993550467">หน้านี้ถูกบล็อกโดย Shuttle</translation>
<translation id="4604973006041022107">อนุญาตให้ Shuttle เข้าถึงเครือข่ายในการตั้งค่าไฟร์วอลล์
          หรือการป้องกันไวรัส</translation>
<translation id="4949828774841497663">ไปที่แอปพลิเคชัน &gt; การตั้งค่าระบบ &gt; เครือข่าย เลือกเครือข่ายที่ใช้งานอยู่ คลิกปุ่ม "รายละเอียด..." แล้วยกเลิกการเลือกพร็อกซีที่อาจเลือกไว้</translation>
<translation id="6683794703230411154">ไปที่
          เมนู Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          เครือข่ายและอินเทอร์เน็ต &gt; พร็อกซี
          แล้วยกเลิกการเลือก "ตรวจหาการตั้งค่าโดยอัตโนมัติ"</translation>
<translation id="262795629490583875">หน้าเหล่านี้มีไว้สำหรับนักพัฒนาซอฟต์แวร์ Shuttle เท่านั้น และอาจไม่ได้รับการดูแลรักษาหรือทดสอบอย่างสม่ำเสมอ หากต้องการเปิดใช้ ให้ไปที่ <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> คลิกปุ่มเพื่อเปิดใช้หน้าแก้ไขข้อบกพร่อง แล้วมาที่หน้านี้อีกครั้ง</translation>
<translation id="6549378540556750549">Chromium ยังเกิดขึ้นได้ด้วย<ph name="BEGIN_LINK_OSS" />ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_OSS" />อื่นๆ</translation>
<translation id="3051968423457057392">การเปลี่ยนแปลงของคุณจะมีผลในครั้งถัดไปที่คุณเปิด Shuttle ขึ้นอีก</translation>
<translation id="7251378182421874967">Shuttle ต้องการสิทธิ์เข้าถึงบลูทูธเพื่อจับคู่ต่อ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium เกิดขึ้นได้ด้วยโปรเจ็กต์โอเพนซอร์ส <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /></translation>
<translation id="6298583427647441415">ไปที่
          เมนู Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          และยกเลิกการเลือก "<ph name="NO_PREFETCH_DESCRIPTION" />"
          หากวิธีนี้ไม่ช่วยแก้ปัญหา เราขอแนะนำให้เลือกตัวเลือกนี้
          อีกครั้งเพื่อให้ประสิทธิภาพการทำงานดียิ่งขึ้น</translation>
<translation id="8597726643333341451">คุณกําลังดูหน้า Chrome สําหรับการทดสอบที่ปลอดภัย</translation>
<translation id="1627254898104673072">Shuttle ไม่ได้ปิดอย่างถูกต้อง</translation>
<translation id="9183331186620388872">เคล็ดลับสำหรับ Chromium: ค้นหาด้วย Lens</translation>
</translationbundle>