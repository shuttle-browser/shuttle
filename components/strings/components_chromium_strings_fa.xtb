<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="130631256467250065">تغییرات بار بعد که دستگاه راه‌اندازی می‌شود اعمال می‌شوند.</translation>
<translation id="1965068424387304464">‏نکته Chromium: گذرواژه‌ها را ذخیره کنید</translation>
<translation id="6181600115274209660">‏به
          «منو Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />»
          بروید و مطمئن شوید پیکربندی روی «no proxy» (بدون پراکسی) یا «direct» (مستقیم) تنظیم شده باشد.</translation>
<translation id="8019164406370393370">‏گزارش خرابی در Shuttle موجود نیست.</translation>
<translation id="7131945667699137625">‏درحال مشاهده یک صفحه Shuttle امن هستید</translation>
<translation id="3255926992597692024">‏Chromebook می‌خواهد تنظیمات تکمیل روش‌های پرداخت را اصلاح کند.</translation>
<translation id="3757825924724354052">‏نشان‌واره Shuttle</translation>
<translation id="3837584850181228767">‏نکته Chromium: «مرور ایمن پیشرفته»</translation>
<translation id="4050599136622776556">‏Chromium می‌خواهد روش‌های پرداخت را ویرایش کند.</translation>
<translation id="8988476603327209803">‏Shuttle با پروژه منبع باز <ph name="BEGIN_LINK_CHROMIUM" />Chromium <ph name="END_LINK_CHROMIUM" /> و سایر <ph name="BEGIN_LINK_OSS" />نرم‌افزار منبع باز<ph name="END_LINK_OSS" /> امکان‌پذیر است.</translation>
<translation id="2477509191993550467">‏این صفحه را Shuttle مسدود کرده است</translation>
<translation id="4604973006041022107">‏در تنظیمات دیوار آتش و ضدویروستان، به Shuttle اجازه دسترسی به شبکه را
          بدهید.</translation>
<translation id="4949828774841497663">به «برنامه‌ها &gt; تنظیمات سیستم &gt; شبکه» بروید، شبکه
          فعال را انتخاب کنید، روی دکمه «جزئیات…» کلیک کنید، و همه
          پراکسی‌هایی را که ممکن است انتخاب شده باشند لغو انتخاب کنید.</translation>
<translation id="6683794703230411154">‏به
          «منو Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          شبکه و اینترنت &gt; پراکسی»
          بروید و «Automatically detect settings» (تشخیص خودکار تنظیمات) را لغو انتخاب کنید.</translation>
<translation id="262795629490583875">‏این صفحه‌ها برای استفاده توسعه‌دهندگان Shuttle درنظر گرفته شده‌اند و ممکن است به‌طور فعال نگهداری یا آزمایش نشوند. برای فعال کردن آن‌ها، به <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> بروید، روی دکمه فعال کردن صفحه‌های اشکال‌زدایی کلیک کنید و سپس دوباره به این صفحه بروید.</translation>
<translation id="6549378540556750549">‏ارائه Chromium ازطریق <ph name="BEGIN_LINK_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_OSS" /> دیگر نیز ممکن شده است.</translation>
<translation id="3051968423457057392">‏دفعه بعدی که Shuttle را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="7251378182421874967">‏Shuttle باید برای ادامه مرتبط‌سازی به بلوتوث
دسترسی داشته باشد. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">‏ارائه Chromium ازطریق پروژه متن‌باز <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ممکن شده است.</translation>
<translation id="6298583427647441415">‏به
          منوی Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          بروید و علامت «<ph name="NO_PREFETCH_DESCRIPTION" />» را بردارید.
          درصورتی‌که با این کار مشکل حل نشد، توصیه می‌کنیم برای عملکرد بهبودیافته،
          این گزینه را دوباره انتخاب کنید.</translation>
<translation id="8597726643333341451">‏درحال مشاهده یکی از صفحه‌های امن Chrome for Testing هستید</translation>
<translation id="1627254898104673072">‏Shuttle به درستی خاموش نشده است.</translation>
<translation id="9183331186620388872">‏نکته Chromium: جستجو کردن با «لنز»</translation>
</translationbundle>