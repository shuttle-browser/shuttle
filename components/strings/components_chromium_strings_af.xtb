<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="af">
<translation id="130631256467250065">Jou veranderinge sal in werking tree wanneer jy jou toestel herbegin.</translation>
<translation id="1965068424387304464">Chromium-wenk: Stoor wagwoorde</translation>
<translation id="6181600115274209660">Gaan na
          die Shuttle-kieslys &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          en maak seker jou opstelling is op “geen instaanbediener nie” of “direk” gestel.</translation>
<translation id="8019164406370393370">Omvalrapportering is nie beskikbaar in Shuttle nie.</translation>
<translation id="7131945667699137625">Jy bekyk tans 'n veilige Shuttle-bladsy</translation>
<translation id="3255926992597692024">Chromium probeer tans instellings vir die invul van betaalmetodes wysig.</translation>
<translation id="3757825924724354052">Shuttle-logo</translation>
<translation id="3837584850181228767">Chromium-wenk: Verbeterde Veiligblaai</translation>
<translation id="4050599136622776556">Chromium probeer tans om betaalmetodes te wysig.</translation>
<translation id="8988476603327209803">Shuttle word moontlik gemaak deur die <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />-oopbronprojek en ander <ph name="BEGIN_LINK_OSS" />oopbronsagteware<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Hierdie bladsy is deur Shuttle geblokkeer</translation>
<translation id="4604973006041022107">Laat Shuttle in jou brandmuur- of antivirusinstellings toe om by jou netwerk
          in te gaan.</translation>
<translation id="4949828774841497663">Gaan na Apps &gt; Stelselinstellings &gt; Netwerk, kies die
          aktiewe netwerk, klik die Besonderhedeknoppie, en ontkies enige instaanbedieners
          wat dalk gekies is.</translation>
<translation id="6683794703230411154">Gaan na
          die Shuttle-kieslys &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Netwerk en internet &gt; Instaanbediener
          en ontkies “Vind instellings outomaties”.</translation>
<translation id="262795629490583875">Hierdie bladsye is bedoel vir gebruik deur Shuttle-ontwikkelaars en word dalk nie aktief onderhou of getoets nie. As jy hulle wil aktiveer, navigeer na <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, klik die knoppie om ontfoutbladsye te aktiveer en navigeer dan terug na hierdie bladsy toe.</translation>
<translation id="6549378540556750549">Chromium word ook moontlik gemaak deur ander <ph name="BEGIN_LINK_OSS" />oopbronsagteware<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Jou veranderinge sal in werking tree wanneer jy Shuttle weer herbegin.</translation>
<translation id="7251378182421874967">Shuttle het Bluetooth-toegang nodig om voort te gaan met 
 saambinding. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium word moontlik gemaak deur die <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />-oopbronprojek.</translation>
<translation id="6298583427647441415">Gaan na
        die Shuttle-kieslys &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        en ontmerk "<ph name="NO_PREFETCH_DESCRIPTION" />."
        As dit nie die probleem oplos nie, beveel ons aan dat hierdie opsie
        weer gekies word vir verbeterde werkverrigting.</translation>
<translation id="8597726643333341451">Jy bekyk tans ’n veilige Chrome-toetsweergawe-bladsy</translation>
<translation id="1627254898104673072">Chrome het nie reg toegemaak nie.</translation>
<translation id="9183331186620388872">Chromium-wenk: Soek met Lens</translation>
</translationbundle>