<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="pl">
<translation id="130631256467250065">Zmiany zostaną zastosowane przy następnym uruchomieniu urządzenia.</translation>
<translation id="1965068424387304464">Wskazówka od Chromium: zapisuj hasła</translation>
<translation id="6181600115274209660">Otwórz menu Shuttle &gt; <ph name="SETTINGS_TITLE" /> &gt; <ph name="SYSTEM_TITLE" /> &gt; <ph name="PROXIES_TITLE" /> i upewnij się, że w konfiguracji wybrano połączenie bez serwera proxy lub bezpośrednie.</translation>
<translation id="8019164406370393370">Zgłaszanie awarii nie jest dostępne w Shuttle.</translation>
<translation id="7131945667699137625">Przeglądasz bezpieczną stronę Shuttle</translation>
<translation id="3255926992597692024">Chromium próbuje zmienić ustawienia wypełniania form płatności.</translation>
<translation id="3757825924724354052">Logo Shuttle</translation>
<translation id="3837584850181228767">Wskazówka od Chromium: Ulepszone bezpieczne przeglądanie</translation>
<translation id="4050599136622776556">Chromium próbuje edytować formy płatności.</translation>
<translation id="8988476603327209803">Stworzenie Shuttle było możliwe dzięki projektowi open source <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> i innym <ph name="BEGIN_LINK_OSS" />programom o otwartym kodzie źródłowym<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Ta strona została zablokowana przez Shuttle</translation>
<translation id="4604973006041022107">Zezwalaj Shuttle na korzystanie z sieci w ustawieniach zapory sieciowej
        lub oprogramowania antywirusowego.</translation>
<translation id="4949828774841497663">Otwórz kolejno Aplikacje &gt; Ustawienia systemu &gt; Sieć, wybierz aktywną sieć, kliknij przycisk Szczegóły… i usuń zaznaczenie wszystkich zaznaczonych serwerów proxy.</translation>
<translation id="6683794703230411154">Otwórz menu Shuttle &gt; <ph name="SETTINGS_TITLE" /> &gt; <ph name="SYSTEM_TITLE" /> &gt; <ph name="PROXIES_TITLE" /> &gt; Sieć i internet &gt; Serwer proxy i odznacz „Automatycznie wykrywaj ustawienia”.</translation>
<translation id="262795629490583875">Te strony są przeznaczone dla programistów Shuttle i mogą nie być aktywnie utrzymywane ani testowane. Aby je włączyć, otwórz <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, kliknij przycisk włączania debugowania stron, a potem ponownie otwórz tę stronę.</translation>
<translation id="6549378540556750549">Stworzenie przeglądarki Chromium było też możliwe dzięki innemu <ph name="BEGIN_LINK_OSS" />oprogramowaniu open source<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Zmiany zostaną zastosowane po ponownym uruchomieniu Shuttle.</translation>
<translation id="7251378182421874967">Aby kontynuować parowanie, Shuttle potrzebuje dostępu do Bluetootha. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Stworzenie przeglądarki Chromium było możliwe dzięki projektowi open source <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">Wybierz
        menu Shuttle &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        i odznacz „<ph name="NO_PREFETCH_DESCRIPTION" />”.
        Jeśli nie rozwiąże to problemu, zalecamy ponowne wybranie tej opcji,
        by poprawić wydajność.</translation>
<translation id="8597726643333341451">Oglądasz bezpieczną stronę Chrome for Testing.</translation>
<translation id="1627254898104673072">Shuttle nie został poprawnie zamknięty.</translation>
<translation id="9183331186620388872">Wskazówka dotycząca Chromium: wyszukuj za pomocą Obiektywu</translation>
</translationbundle>