<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="130631256467250065">Mabadiliko yako yatatekelezwa utakapowasha upya tena kifaa chako.</translation>
<translation id="1965068424387304464">Kidokezo cha Chromium: Hifadhi Manenosiri</translation>
<translation id="6181600115274209660">Nenda kwenye
          menyu ya Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          na uhakikishe kuwa mipangilio yako imewekwa kuwa "hakuna seva mbadala" au "ya moja kwa moja."</translation>
<translation id="8019164406370393370">Kuripoti uharibifu hakupatikana katika Shuttle.</translation>
<translation id="7131945667699137625">Unaangalia ukurasa salama wa Shuttle</translation>
<translation id="3255926992597692024">Chromium inajaribu kurekebisha mipangilio kwa ajili ya kujaza njia za kulipa.</translation>
<translation id="3757825924724354052">Nembo ya Shuttle</translation>
<translation id="3837584850181228767">Kidokezo cha Chromium: Kipengele cha Kuvinjari Salama Kilichoboreshwa</translation>
<translation id="4050599136622776556">Chromium inajaribu kubadilisha njia za kulipa.</translation>
<translation id="8988476603327209803">Shuttle imerahisishwa na mradi wa programu huria ya <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> na programu nyingine <ph name="BEGIN_LINK_OSS" />huria<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Ukurasa huu umezuiwa na Shuttle</translation>
<translation id="4604973006041022107">Ruhusu Shuttle ifikie mtandao kwenye mipangilio yako ya kinga mtandao au kingavirusi.</translation>
<translation id="4949828774841497663">Nenda kwenye Programu &gt; Mipangilio ya Mfumo &gt; Mtandao, chagua
          mtandao unaotumika, bofya kitufe cha Maelezo... kisha uache kuchagua seva zozote mbadala
          ambazo huenda umechagua.</translation>
<translation id="6683794703230411154">Nenda kwenye
          menyu ya Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Mtandao na intaneti &gt; Seva mbadala
          kisha uache kuchagua "Tambua mipangilio kiotomatiki."</translation>
<translation id="262795629490583875">Kurasa hizi zinanuiwa kutumiwa na wasanidi programu wa Shuttle na huenda zisiweze kufanyiwa majaribio wala kudumishwa kila wakati. Ili uzifungue, nenda kwenye <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, bofya kitufe ili ufungue kurasa za utatuzi kisha urudi kwenye ukurasa huu tena.</translation>
<translation id="6549378540556750549">Chromium inawezeshwa pia na <ph name="BEGIN_LINK_OSS" />programu nyingine huria<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Mabadiliko yako yataanza kufanya kazi wakati ujao utakapozindua upya Shuttle.</translation>
<translation id="7251378182421874967">Shuttle inahitaji ruhusa ya kufikia Bluetooth ili iendelee 
 kuoanisha. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium inawezeshwa na mradi wa programu huria wa <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">Nenda kwenye
        menyu ya Shuttle &gt;
        <ph name="SETTINGS_TITLE" />
        <ph name="ADVANCED_TITLE" />na uondoe tiki kwenye "<ph name="NO_PREFETCH_DESCRIPTION" />."
        Ikiwa hili halitatatua tatizo, tunapendekeza uchague tena chaguo hili kwa utendaji ulioboreshwa.</translation>
<translation id="8597726643333341451">Unaangalia ukurasa salama wa Chrome ya Majaribio</translation>
<translation id="1627254898104673072">Shuttle haikuzimika kwa njia sahihi.</translation>
<translation id="9183331186620388872">Kidokezo cha Chromium: Tafuta Ukitumia Lenzi</translation>
</translationbundle>