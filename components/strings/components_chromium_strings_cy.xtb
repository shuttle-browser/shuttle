<!DOCTYPE translationbundle>
<translationbundle lang="cy">
<translation id="130631256467250065">Bydd eich newidiadau yn dod i rym y tro nesaf y byddwch yn ailgychwyn eich dyfais.</translation>
<translation id="1965068424387304464">Awgrym Chromium: Cadw Cyfrineiriau</translation>
<translation id="6181600115274209660">Ewch i
          ddewislen Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          a gwnewch yn siŵr bod eich ffurfweddiad wedi'i osod i "dim dirprwy weinydd" neu i "uniongyrchol."</translation>
<translation id="8019164406370393370">Nid yw adrodd am doriadau ar gael yn Shuttle.</translation>
<translation id="7131945667699137625">Rydych yn edrych ar dudalen Shuttle ddiogel</translation>
<translation id="3255926992597692024">Mae Chromium yn ceisio addasu gosodiadau ar gyfer llenwi dulliau talu.</translation>
<translation id="3757825924724354052">Logo Shuttle</translation>
<translation id="3837584850181228767">Awgrym Chromium: Gwell Pori'n Ddiogel</translation>
<translation id="4050599136622776556">Mae Chromium yn ceisio golygu dulliau talu.</translation>
<translation id="8988476603327209803">Mae Shuttle yn bosib oherwydd prosiect ffynhonnell agored <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> a <ph name="BEGIN_LINK_OSS" />meddalwedd ffynhonnell agored<ph name="END_LINK_OSS" /> eraill.</translation>
<translation id="2477509191993550467">Mae'r dudalen hon wedi'i rhwystro gan Shuttle</translation>
<translation id="4604973006041022107">Caniatewch i Shuttle gael mynediad at y rhwydwaith yn eich gosodiadau wal dân neu 
         wrthfeirysau.</translation>
<translation id="4949828774841497663">Ewch i Apiau &gt; Gosodiadau System &gt; Rhwydwaith, dewiswch y
          rhwydwaith gweithredol, cliciwch ar y botwm Manylion... a dad-ddewiswch unrhyw ddirprwyon gweinydd
          a allai fod wedi cael eu dewis.</translation>
<translation id="6683794703230411154">Ewch i
          ddewislen Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Rhwydwaith a rhyngrwyd &gt; Dirprwy weinydd
          a dad-ddewis "Canfod gosodiadau yn awtomatig".</translation>
<translation id="262795629490583875">Mae'r tudalennau hyn wedi'u bwriadu i'w defnyddio gan ddatblygwyr Shuttle, ac mae'n bosib na fyddant yn cael eu cynnal na'u profi'n weithredol. Er mwyn eu galluogi, llywiwch i <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, cliciwch ar y botwm i alluogi tudalennau dadfygio, ac yna llywiwch i'r dudalen hon eto.</translation>
<translation id="6549378540556750549">Mae Chromium hefyd yn bosib oherwydd <ph name="BEGIN_LINK_OSS" />meddalwedd ffynhonnell agored<ph name="END_LINK_OSS" /> eraill.</translation>
<translation id="3051968423457057392">Bydd eich newidiadau yn dod i rym y tro nesaf y byddwch yn ail-lansio Shuttle.</translation>
<translation id="7251378182421874967">Mae angen mynediad Bluetooth ar Shuttle i barhau i 
baru <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Mae Chromium yn bosib oherwydd y prosiect ffynhonnell agored <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">Ewch i
          ddewislen Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          a dad-ddewiswch "<ph name="NO_PREFETCH_DESCRIPTION" />."
          Os na fydd hyn yn datrys y broblem, rydym yn argymell dewis yr opsiwn hwn
          eto ar gyfer perfformiad gwell.</translation>
<translation id="8597726643333341451">Rydych yn edrych ar dudalen Chrome for Testing ddiogel</translation>
<translation id="1627254898104673072">Ni wnaeth Shuttle gau'n gywir.</translation>
<translation id="9183331186620388872">Awgrym Chromium: Chwilio â Google Lens</translation>
