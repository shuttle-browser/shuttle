<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sl">
<translation id="130631256467250065">Spremembe bodo uveljavljene pri naslednjem vnovičnem zagonu naprave.</translation>
<translation id="1965068424387304464">Nasvet za Chromium: Shranite gesla</translation>
<translation id="6181600115274209660">Odprite
          Shuttleov meni &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          in poskrbite, da je konfiguracija nastavljena na »brez strežnika proxy« ali »neposredno«.</translation>
<translation id="8019164406370393370">Poročanje o zrušitvah ni na voljo v Shuttleu.</translation>
<translation id="7131945667699137625">Ogledujete si varno stran Shuttlea</translation>
<translation id="3255926992597692024">Chromium poskuša spremeniti nastavitve za izpolnjevanje podatkov o plačilnih sredstvih.</translation>
<translation id="3757825924724354052">Logotip Shuttlea</translation>
<translation id="3837584850181228767">Nasvet za Chromium: Izboljšano varno brskanje</translation>
<translation id="4050599136622776556">Chromium poskuša urediti plačilna sredstva.</translation>
<translation id="8988476603327209803">Shuttle omogočata odprtokodni projekt <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> in druga <ph name="BEGIN_LINK_OSS" />odprtokodna programska oprema<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">To stran je blokiral Shuttle.</translation>
<translation id="4604973006041022107">V nastavitvah požarnega zidu ali protivirusnega programa omogočite Shuttleu dostop do
        omrežja.</translation>
<translation id="4949828774841497663">Odprite »Aplikacije &gt; Sistemske nastavitve &gt; Omrežje«, izberite
          aktivno omrežje, kliknite gumb »Podrobnosti …« in počistite vse strežnike proxy,
          ki so morda izbrani.</translation>
<translation id="6683794703230411154">Odprite
          Shuttleov meni &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Omrežje in internet &gt; Strežnik proxy
          in počistite izbiro možnosti »Samodejno zaznaj nastavitve«.</translation>
<translation id="262795629490583875">Te strani so namenjene razvijalcem za Shuttle in morda niso aktivno vzdrževane ali preizkušane. Če jih želite omogočiti, odprite <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, kliknite gumb, da omogočite strani za odpravljanje napak, in se znova pomaknite na to stran.</translation>
<translation id="6549378540556750549">Chromium omogoča tudi druga <ph name="BEGIN_LINK_OSS" />odprtokodna programska oprema<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Spremembe bodo začele veljati ob naslednjem zagonu Shuttlea.</translation>
<translation id="7251378182421874967">Shuttle potrebuje dostop do Bluetootha za nadaljevanje 
 seznanjanja. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium omogoča odprtokodni projekt <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">Odprite
        meni Shuttlea &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        in počistite polje »<ph name="NO_PREFETCH_DESCRIPTION" />«.
        Če s tem težave ne odpravite, priporočamo, da to možnost
        zaradi izboljšanja delovanja znova izberete.</translation>
<translation id="8597726643333341451">Ogledujete si varno stran brskalnika Chrome for Testing</translation>
<translation id="1627254898104673072">Shuttle se ni pravilno zaustavil.</translation>
<translation id="9183331186620388872">Nasvet za Chromium: Iščite z Googlom Lens</translation>
</translationbundle>