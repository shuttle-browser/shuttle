<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="130631256467250065">మీ మార్పులు మీరు మీ డివైజ్‌ను పునఃప్రారంభించే తర్వాతిసారి అమలులోకి వస్తాయి.</translation>
<translation id="1965068424387304464">Chromium చిట్కా: పాస్‌వర్డ్‌లను సేవ్ చేయండి</translation>
<translation id="6181600115274209660">Shuttle
          మెనూ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />‌కు వెళ్లి,
          మీ కాన్ఫిగరేషన్ "ప్రాక్సీ వద్దు" లేదా "డైరెక్ట్" అనే ఆప్షన్‌కు సెట్ చేసి ఉందని నిర్ధారించుకోండి.</translation>
<translation id="8019164406370393370">Shuttleలో క్రాష్ రిపోర్ట్‌ అందుబాటులో లేదు.</translation>
<translation id="7131945667699137625">మీరు సురక్షితమైన Shuttle పేజీని వీక్షిస్తున్నారు</translation>
<translation id="3255926992597692024">పేమెంట్ ఆప్షన్‌లను పూరించడానికి సంబంధించిన సెట్టింగ్‌లను ఎడిట్ చేయడానికి Chromium ట్రై చేస్తోంది.</translation>
<translation id="3757825924724354052">Shuttle లోగో</translation>
<translation id="3837584850181228767">Chromium చిట్కా: మెరుగైన సురక్షిత బ్రౌజింగ్</translation>
<translation id="4050599136622776556">పేమెంట్ ఆప్షన్‌లను ఎడిట్ చేయడానికి Chromium ట్రై చేస్తోంది.</translation>
<translation id="8988476603327209803">Shuttle అనేది <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ఓపెన్ సోర్స్ ప్రాజెక్ట్ మరియు ఇతర <ph name="BEGIN_LINK_OSS" />ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_OSS" />లపై ఎంతగానో ఆధారపడుతుంది.</translation>
<translation id="2477509191993550467">Shuttle ద్వారా ఈ పేజీ బ్లాక్ చేయబడింది</translation>
<translation id="4604973006041022107">మీ ఫైర్‌వాల్ లేదా యాంటీవైరస్ సెట్టింగ్‌ల్లో నెట్‌వర్క్‌ను యాక్సెస్ చేయడానికి
        Shuttleను అనుమతించండి.</translation>
<translation id="4949828774841497663">అప్లికేషన్‌లు &gt; సిస్టమ్ సెట్టింగ్‌లు &gt; నెట్‌వర్క్ ఆప్షన్‌కు వెళ్లి,
          యాక్టివ్‌గా ఉన్న నెట్‌వర్క్‌ను ఎంచుకొని, వివరాలు... బటన్‌ను క్లిక్ చేసి, ఏవైనా ప్రాక్సీలు ఎంపిక చేసి ఉంటే,
          ఎంపికను తొలగించండి.</translation>
<translation id="6683794703230411154">Shuttle
          మెనూ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          నెట్‌వర్క్ &amp; ఇంటర్నెట్ &gt; ప్రాక్సీకి వెళ్లి,
          "సెట్టింగ్‌లను ఆటోమేటిక్‌గా గుర్తించడం" అనే ఎంపికను తొలగించండి.</translation>
<translation id="262795629490583875">ఈ పేజీలు Shuttle డెవలపర్‌ల ఉపయోగం కోసం ఉద్దేశించినవి, అలాగే యాక్టివ్‌గా నిర్వహించబడకపోవచ్చు లేదా పరీక్షించబడకపోవచ్చు. వాటిని ఎనేబుల్ చేయడానికి, <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />కు నావిగేట్ చేయండి, డీబగ్ పేజీలను ఎనేబుల్ చేయడానికి బటన్‌ను క్లిక్ చేసి, ఆపై మళ్లీ ఈ పేజీకి నావిగేట్ చేయండి.</translation>
<translation id="6549378540556750549">ఇతర <ph name="BEGIN_LINK_OSS" />ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_OSS" /> ద్వారా కూడా Chromiumను రూపొందించడం సాధ్యమయ్యింది.</translation>
<translation id="3051968423457057392">మీ మార్పులు మీరు Shuttleని మరుసటిసారి ప్రారంభించినప్పుడు ప్రభావాన్ని చూపుతాయి.</translation>
<translation id="7251378182421874967">పెయిరింగ్‌ను కొనసాగించడానికి Shuttleకు 
 బ్లూటూత్ యాక్సెస్ అవసరం. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637"><ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ఓపెన్ సోర్స్ ప్రాజెక్ట్ ద్వారా Chromiumను రూపొందించడం సాధ్యమయ్యింది.</translation>
<translation id="6298583427647441415">Shuttle మెనూ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />కు వెళ్లండి,
          ఆపై "<ph name="NO_PREFETCH_DESCRIPTION" />" ఎంపికను తీసివేయండి.
          దీని వల్ల సమస్య పరిష్కారం కాకపోతే, మెరుగైన పనితీరు కోసం మీరు
          ఈ ఎంపికను మళ్లీ ఎంచుకోవాలని మేము సిఫార్సు చేస్తున్నాము.</translation>
<translation id="8597726643333341451">మీరు సురక్షితమైన Chrome for Testing పేజీని చూస్తున్నారు</translation>
<translation id="1627254898104673072">Shuttle సరిగ్గా షట్ డౌన్ కాలేదు.</translation>
<translation id="9183331186620388872">Chromium చిట్కా: Lensతో సెర్చ్ చేయండి</translation>
</translationbundle>