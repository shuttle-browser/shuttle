<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="130631256467250065">तपाईंले अर्को पटक तपाईंको यन्त्रलाई पुन: सुरु गर्दा तपाईंका परिवर्तनहरू प्रभावकारी हुनेछन्।</translation>
<translation id="1965068424387304464">Chromium सम्बन्धी सुझाव: पासवर्डहरू सेभ गर्नुहोस्</translation>
<translation id="6181600115274209660">Shuttle मेनु &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          मा जानुहोस् र आफ्नो कन्फिगुरेसन "कुनै पनि प्रोक्सी छैन" वा "डिरेक्ट" मा सेट गरिएको छ भन्ने कुरा सुनिश्चित गर्नुहोस्।</translation>
<translation id="8019164406370393370">क्र्यास रिपोर्टिङ Shuttle मा उपलब्ध छैन।</translation>
<translation id="7131945667699137625">तपाईं एउटा सुरक्षित Shuttle पृष्ठ हेर्दै हुनुहुन्छ</translation>
<translation id="3255926992597692024">Chromium ले भुक्तानी विधिहरू हाल्नका निम्ति सेटिङ मिलाउन खोज्दै छ।</translation>
<translation id="3757825924724354052">क्रोमियम लोगो</translation>
<translation id="3837584850181228767">Chromium सम्बन्धी सुझाव: परिष्कृत सुरक्षित ब्राउजिङ सुविधा</translation>
<translation id="4050599136622776556">Chromium ले भुक्तानी विधिहरू सम्पादन गर्ने प्रयास गर्दै छ।</translation>
<translation id="8988476603327209803">क्रोमियमको कारण सम्भव भएको हो <ph name="BEGIN_LINK_CHROMIUM" /> क्रोमियम <ph name="END_LINK_CHROMIUM" /> खुला स्रोत परियोजना र अन्य <ph name="BEGIN_LINK_OSS" /> खुला स्रोत सफ्टवेयर <ph name="END_LINK_OSS" /> ।</translation>
<translation id="2477509191993550467">Shuttle ले यो पेज ब्लक गरेको छ</translation>
<translation id="4604973006041022107">Shuttle लाई तपाईँको फायरवाल वा एन्टिभाइरसका
        सेटिङहरूमा नेटवर्कमा पहुँच गर्ने अनुमति दिनुहोस्।</translation>
<translation id="4949828774841497663">"एपहरू &gt; सिस्टम सेटिङ &gt; नेटवर्क" मा जानुहोस्,
          सक्रिय नेटवर्क चयन गर्नुहोस्, विवरणहरू... बटन थिच्नुहोस् र चयन गरिएका हुन सक्ने सबै
          प्रोक्सीहरूको चयन रद्द गर्नुहोस्।</translation>
<translation id="6683794703230411154">"Shuttle मेनु &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          नेटवर्क तथा इन्टरनेट &gt; प्रोक्सी"
          मा जानुहोस् र "सेटिङ स्वतः पत्ता लगाउनुहोस्" को चयन रद्द गर्नुहोस्।</translation>
<translation id="262795629490583875">यी पेजहरू Shuttle विकासकर्ताहरूको प्रयोगका लागि बनाइएका हुनाले सक्रिय रूपमा यिनको व्यवस्थापन वा परीक्षण नगरिएको हुन सक्छ। यी पेजहरू अन गर्न <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> मा जानुहोस्, यो बटन क्लिक गरी पेज डिबग गर्ने सुविधा अन गर्नुहोस् र त्यसपछि फेरि यो पेजमा जानुहोस्।</translation>
<translation id="6549378540556750549">Chromium बनाउँदा <ph name="BEGIN_LINK_OSS" />खुला स्रोतका अन्य सफ्टवेयर<ph name="END_LINK_OSS" />को पनि मद्दत लिइएको छ।</translation>
<translation id="3051968423457057392">तपाईंले अर्को पटक Shuttle लाई पुन: लन्च गर्दा तपाईंका परिवर्तनहरू प्रभावमा आउनेछन्।</translation>
<translation id="7251378182421874967">कनेक्ट गर्ने प्रक्रिया जारी राख्न Shuttle लाई ब्लुटुथ प्रयोग गर्ने अनुमति
 दिनु पर्ने हुन्छ। <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium बनाउँदा <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> खुला स्रोतको परियोजनाको मद्दत लिइएको छ।</translation>
<translation id="6298583427647441415">जानुहोस्
          क्रोमियम मेनुमा &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          र अचयन गर्नुहोस् "<ph name="NO_PREFETCH_DESCRIPTION" />."
          यदि यसले मुद्दा समाधान गर्दैन भने, हामी सुधारिएको कार्यसम्पादनका लागि यस विकल्पलाई फेरि चयन गर्न सिफारिस गर्दछौं।</translation>
<translation id="8597726643333341451">तपाईं सुरक्षित Chrome for Testing पेज हेर्दै हुनुहुन्छ</translation>
<translation id="1627254898104673072">क्रोमियम सही तवरले बन्द भएन।</translation>
<translation id="9183331186620388872">Chromium सम्बन्धी सुझाव: लेन्स प्रयोग गरी खोज्नुहोस्</translation>
</translationbundle>