<!DOCTYPE translationbundle>
<translationbundle lang="ur">
<translation id="130631256467250065">اپنا آلہ اگلی بار دوبارہ شروع کرنے پر آپ کی تبدیلیاں مؤثر ہوں گی۔</translation>
<translation id="1965068424387304464">‏‫Chromium کی تجویز: پاس ورڈز محفوظ کریں</translation>
<translation id="6181600115274209660">‏‫Shuttle مینیو &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          پر جائیں اور یقینی بنائیں کہ آپ کی کنفیگریشن "کوئی پراکسی نہیں" یا "ڈائریکٹ" پر سیٹ ہے۔</translation>
<translation id="8019164406370393370">‏Shuttle میں کریش رپورٹنگ دستیاب نہیں ہے۔</translation>
<translation id="7131945667699137625">‏آپ ایک محفوظ Shuttle صفحہ دیکھ رہے ہیں</translation>
<translation id="3255926992597692024">‏ادائیگی کے طریقوں پُر کرنے کی خاطر ترتیبات میں ترمیم کرنے کے لیے Chromium کوشش کر رہا ہے۔</translation>
<translation id="3757825924724354052">‏Shuttle کا لوگو</translation>
<translation id="3837584850181228767">‏‫Chromium کی تجویز: بہتر کردہ محفوظ براؤزنگ</translation>
<translation id="4050599136622776556">‏Chromium ادائیگی کے طریقوں میں ترمیم کرنے کی کوشش کر رہا ہے۔</translation>
<translation id="8988476603327209803">‏Shuttle کو ‎<ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />‎ اوپن سورس پروجیکٹ اور دیگر <ph name="BEGIN_LINK_OSS" />اوپن سورس سافٹ ویئر<ph name="END_LINK_OSS" /> کے ذریعے ممکن بنایا گیا ہے۔</translation>
<translation id="2477509191993550467">‏اس صفحے کو Shuttle نے مسدود کر دیا ہے</translation>
<translation id="4604973006041022107">‏Shuttle کو اپنے فائروال یا اینٹی وائرس کی
          ترتیبات میں نیٹ ورک تک رسائی حاصل کرنے کی اجازت دیں۔</translation>
<translation id="4949828774841497663">ایپلیکیشنز &gt; سسٹم کی ترتیبات &gt; نیٹ ورک پر جائیں، فعال نیٹ ورک منتخب کریں، تفصیلات... بٹن پر کلک کریں اور ممکنہ طور پر منتخب کردہ کسی بھی پراکسی کو غیر منتخب کریں۔</translation>
<translation id="6683794703230411154">‏‫Shuttle مینیو &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          نیٹ ورک اور انٹرنیٹ &gt; پراکسی
          پر جائیں اور"خودکار طور پر ترتیبات کو منتخب کریں" کو غیر منتخب کریں۔</translation>
<translation id="262795629490583875">‏یہ صفحات Shuttle کے ڈویلپرز کے استعمال کے ارادے سے ہیں اور ہو سکتا ہے کہ ان کی فعال طور پر دیکھ بھال یا جانچ نہ کی جائے۔ ان کو فعال کرنے کے لیے، <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> پر نیویگیٹ کریں، ڈیبگ صفحات کو فعال کرنے کے لیے بٹن پر کلک کریں اور پھر اس صفحہ پر دوبارہ نیویگیٹ کریں۔</translation>
<translation id="6549378540556750549">‏Chromium کو دوسرے <ph name="BEGIN_LINK_OSS" />اوپن سورس سافٹ ویئر<ph name="END_LINK_OSS" /> کے ذریعے بھی ممکن بنایا گیا ہے۔</translation>
<translation id="3051968423457057392">‏آپ کی تبدیلیاں Shuttle کو اگلی بار آپ کے دوبارہ شروع کرنے کے وقت نافذ ہوں گی۔</translation>
<translation id="7251378182421874967">‏جوڑا بنانا جاری رکھنے کیلئے Shuttle کو بلوٹوتھ رسائی کی ضرورت ہے۔ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">‏Chromium کو <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> اوپن سورس پروجیکٹ کے ذریعے ممکن بنایا گیا ہے۔</translation>
<translation id="6298583427647441415">‏Shuttle مینیو &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          پر جائیں اور "<ph name="NO_PREFETCH_DESCRIPTION" />" کو غیر منتخب کریں۔
          اگر اس سے مسئلہ حل نہیں ہوتا ہے تو ہم
          بہتر کارکردگی کیلئے یہ اختیار دوبارہ منتخب کرنے کی تجویز
          کرتے ہیں۔</translation>
<translation id="8597726643333341451">‏آپ محفوظ Chrome for Testing صفحہ دیکھ رہے ہیں</translation>
<translation id="1627254898104673072">‏Shuttle صحیح سے بند نہیں ہوا۔</translation>
<translation id="9183331186620388872">‏‫Chromium تجویز: لینز کے ساتھ تلاش کریں</translation>
</translationbundle>