<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hu">
<translation id="130631256467250065">A módosítások az eszköz következő újraindításakor lépnek életbe.</translation>
<translation id="1965068424387304464">Chromium-tipp: Jelszavak mentése</translation>
<translation id="6181600115274209660">Lépjen ide:
          Shuttle menü &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />,
          és gondoskodjon róla, hogy a konfiguráció beállítása „nincs proxy” vagy „közvetlen” legyen.</translation>
<translation id="8019164406370393370">A hibajelentések nem állnak rendelkezésre a Shuttleban.</translation>
<translation id="7131945667699137625">Jelenleg biztonságos Shuttle-oldalt tekint meg</translation>
<translation id="3255926992597692024">A Chromium módosítani próbálja a fizetési módok kitöltési beállításait.</translation>
<translation id="3757825924724354052">Shuttle embléma</translation>
<translation id="3837584850181228767">Chromium-tipp: Biztonságos Böngészés fokozott védelemmel</translation>
<translation id="4050599136622776556">A Chromium szerkeszteni próbálja a fizetési módokat.</translation>
<translation id="8988476603327209803">A Shuttle a <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> nyílt forráskódú projektnek és további <ph name="BEGIN_LINK_OSS" />nyílt forráskódú szoftvereknek<ph name="END_LINK_OSS" /> köszönhetően jött létre.</translation>
<translation id="2477509191993550467">Ezt az oldalt a Shuttle blokkolja</translation>
<translation id="4604973006041022107">A hálózat elérésének engedélyezése a Shuttle számára a tűzfal-
          vagy vírusirtó-beállításokban.</translation>
<translation id="4949828774841497663">Lépjen az Alkalmazások &gt; Rendszerbeállítások &gt; Hálózat menüpontra,
          válassza ki az aktív hálózatot, kattintson a Részletek… gombra, és szüntesse meg
          a kiválasztott proxyk kijelölését.</translation>
<translation id="6683794703230411154">Lépjen ide:
          Shuttle-menü &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Hálózat és internet &gt; Proxy,
          és szüntesse meg a „Beállítások automatikus észlelése” beállítás kijelölését.</translation>
<translation id="262795629490583875">Ezek az oldalak a Shuttle fejlesztői számára készültek, és előfordulhat, hogy nincsenek aktívan karbantartva vagy tesztelve. Az engedélyezésükhöz lépjen a <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> oldalra, kattintson a hibaelhárítási oldalak engedélyezéséhez tartozó gombra, majd lépjen ismét erre az oldalra.</translation>
<translation id="6549378540556750549">A Chromiumot létrejöttéhez más <ph name="BEGIN_LINK_OSS" />nyílt forráskódú szoftverek<ph name="END_LINK_OSS" /> is hozzájárultak.</translation>
<translation id="3051968423457057392">Módosításai a Shuttle újraindítása után lépnek érvénybe.</translation>
<translation id="7251378182421874967">A Shuttlenak Bluetooth-hozzáférésre van szükséges a párosítás 
 folytatásához. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">A Chromium a <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> nyílt forráskódú projektnek köszönhetően jött létre.</translation>
<translation id="6298583427647441415">Lépjen ide:
        Shuttle menü &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />,
        és törölje a jelet a(z) „<ph name="NO_PREFETCH_DESCRIPTION" />” jelölőnégyzetből.
        Ha ettől nem szűnik meg a probléma, javasoljuk, hogy jelölje be ismét ezt a lehetőséget a jobb teljesítmény érdekében.</translation>
<translation id="8597726643333341451">Jelenleg biztonságos Chrome for Testing-oldalt tekint meg.</translation>
<translation id="1627254898104673072">A Shuttle nem záródott be megfelelően.</translation>
<translation id="9183331186620388872">Chromium-tipp: Kereshet a Lens segítségével</translation>
</translationbundle>