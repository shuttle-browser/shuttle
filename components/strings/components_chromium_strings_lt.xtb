<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lt">
<translation id="130631256467250065">Pakeitimai įsigalios kitą kartą iš naujo paleidus įrenginį.</translation>
<translation id="1965068424387304464">„Chromium“ patarimas: išsaugokite slaptažodžius</translation>
<translation id="6181600115274209660">Eikite į
          „Shuttle“ meniu &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ir įsitikinkite, kad konfigūracija nustatyta kaip „be tarpinio serverio“ arba „tiesioginė“.</translation>
<translation id="8019164406370393370">„Shuttle“ negalima teikti strigčių ataskaitų.</translation>
<translation id="7131945667699137625">Peržiūrite saugų „Shuttle“ puslapį</translation>
<translation id="3255926992597692024">„Chromium“ bando keisti mokėjimo metodų pildymo nustatymus.</translation>
<translation id="3757825924724354052">„Shuttle“ logotipas</translation>
<translation id="3837584850181228767">„Chromium“ patarimas: Sustiprintas saugus naršymas</translation>
<translation id="4050599136622776556">„Chromium“ bando redaguoti mokėjimo metodus.</translation>
<translation id="8988476603327209803">„Shuttle“ pasiekiama naudojant <ph name="BEGIN_LINK_CHROMIUM" />„Shuttle“<ph name="END_LINK_CHROMIUM" /> atvirojo šaltinio projektą ir kitą <ph name="BEGIN_LINK_OSS" />atvirojo šaltinio programinę įrangą<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Šį puslapį užblokavo „Shuttle“</translation>
<translation id="4604973006041022107">Leiskite „Shuttle“ pasiekti tinklą užkardos arba antivirusinės programos
          nustatymuose.</translation>
<translation id="4949828774841497663">Eikite į skiltį „Programos“ &gt; „Sistemos nustatymai“ &gt; „Tinklas“, pasirinkite
          aktyvų tinklą, spustelėkite mygtuką „Išsami informacija...“ ir panaikinkite visų tarpinių serverių,
          kurie galėjo būti pasirinkti, pasirinkimą.</translation>
<translation id="6683794703230411154">Eikite į
          „Shuttle“ meniu &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          „Tinklas ir internetas“ &gt; „Tarpinis serveris“
          ir panaikinkite parinkties „Automatiškai aptikti nustatymus“ pasirinkimą.</translation>
<translation id="262795629490583875">Šie puslapiai skirti naudoti „Shuttle“ kūrėjams ir gali nebūti aktyviai tvarkomi ar išbandomi. Jei norite juos įgalinti, eikite adresu <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, spustelėkite mygtuką, kad įgalintumėte derinimo puslapius, ir tada grįžkite į šį puslapį.</translation>
<translation id="6549378540556750549">„Chromium“ taip pat pasiekiama naudojant kitą <ph name="BEGIN_LINK_OSS" />atvirojo šaltinio programinę įrangą<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Pakeitimai įsigalios kitą kartą iš naujo paleidus „Shuttle“.</translation>
<translation id="7251378182421874967">„Shuttle“ reikia pasiekti „Bluetooth“, kad galėtų sieti 
 toliau. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">„Chromium“ pasiekiama naudojant <ph name="BEGIN_LINK_CHROMIUM" />„Chromium“<ph name="END_LINK_CHROMIUM" /> atvirojo šaltinio projektą.</translation>
<translation id="6298583427647441415">Eikite į
        „Shuttle“ meniu &gt;
        „<ph name="SETTINGS_TITLE" />“
        &gt;
        „<ph name="ADVANCED_TITLE" />“
        ir panaikinkite „<ph name="NO_PREFETCH_DESCRIPTION" />“ pasirinkimą.
        Jei tai atlikus problema išlieka, rekomenduojame vėl pasirinkti šią parinktį,
        kad pagerėtų našumas.</translation>
<translation id="8597726643333341451">Peržiūrite saugų „Chrome for Testing“ puslapį</translation>
<translation id="1627254898104673072">„Shuttle“ netinkamai išsijungė.</translation>
<translation id="9183331186620388872">„Chromium“ patarimas: ieškokite naudodami „Lens“</translation>
</translationbundle>