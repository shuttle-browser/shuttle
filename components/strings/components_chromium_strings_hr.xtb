<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="130631256467250065">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete uređaj.</translation>
<translation id="1965068424387304464">Savjet za Chromium: spremite zaporke</translation>
<translation id="6181600115274209660">Otvorite izbornik preglednika Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          i provjerite je li konfiguracija postavljena na "bez proxyja" ili "izravno".</translation>
<translation id="8019164406370393370">Prijavljivanje padova nije dostupno u pregledniku Shuttle.</translation>
<translation id="7131945667699137625">Gledate sigurnu stranicu Shuttlea</translation>
<translation id="3255926992597692024">Chromium pokušava izmijeniti postavke za popunjavanje načina plaćanja.</translation>
<translation id="3757825924724354052">Logotip Shuttlea</translation>
<translation id="3837584850181228767">Savjet za Chromium: poboljšano sigurno pregledavanje</translation>
<translation id="4050599136622776556">Chromium pokušava urediti načine plaćanja.</translation>
<translation id="8988476603327209803">Shuttle omogućuju projekt utemeljen na otvorenom kôdu <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> i drugi <ph name="BEGIN_LINK_OSS" />softveri utemeljeni na otvorenom kôdu<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Shuttle je blokirao ovu stranicu</translation>
<translation id="4604973006041022107">U postavkama vatrozida ili antivirusnog programa omogućite Shuttleu da pristupa mreži.</translation>
<translation id="4949828774841497663">Idite na Aplikacije &gt; Postavke sustava &gt; Mreža, odaberite
          aktivnu mrežu, kliknite gumb Pojedinosti... i poništite odabir svih proxyja
          koji su možda odabrani.</translation>
<translation id="6683794703230411154">Otvorite izbornik Shuttlea &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Mreža i internet &gt; Proxy i poništite odabir opcije Automatski otkrij postavke.</translation>
<translation id="262795629490583875">Te su stranice namijenjene razvojnim programerima Shuttlea i možda se ne održavaju ili testiraju aktivno. Da biste ih omogućili, otvorite <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, kliknite gumb za omogućivanje stranica za otklanjanje pogrešaka, a zatim se ponovo vratite na ovu stranicu.</translation>
<translation id="6549378540556750549">Chromium je omogućio i drugi <ph name="BEGIN_LINK_OSS" />softver otvorenog izvornog koda<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete Shuttle.</translation>
<translation id="7251378182421874967">Shuttle treba pristup Bluetoothu za nastavak 
 uparivanja. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium je omogućio <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />, projekt otvorenog izvornog koda.</translation>
<translation id="6298583427647441415">Otvorite
        izbornik Shuttlea &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        pa poništite odabir stavke "<ph name="NO_PREFETCH_DESCRIPTION" />".
        Ako se time ne riješi poteškoća, preporučujemo da ponovo odaberete tu opciju
        radi bolje izvedbe.</translation>
<translation id="8597726643333341451">Pregledavate sigurnu stranicu Chrome for Testing</translation>
<translation id="1627254898104673072">Shuttle se nije ispravno zatvorio.</translation>
<translation id="9183331186620388872">Savjet za Chromium: pretražujte pomoću Objektiva</translation>
</translationbundle>