<!DOCTYPE translationbundle>
<translationbundle lang="sr-Latn">
<translation id="130631256467250065">Promene će stupiti na snagu kada sledeći put ponovo pokrenete uređaj.</translation>
<translation id="1965068424387304464">Napomena za Chromium: Sačuvajte lozinke</translation>
<translation id="6181600115274209660">Idite u
          Shuttle meni &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          i proverite da li je konfiguracija podešena na „no proxy“ (bez proksija) ili „direct“ (direktno).</translation>
<translation id="8019164406370393370">Izveštavanje o otkazivanjima nije dostupno u Shuttle-u.</translation>
<translation id="7131945667699137625">Gledate bezbednu Shuttle stranicu.</translation>
<translation id="3255926992597692024">Chromium pokušava da izmeni podešavanja za popunjavanje načina plaćanja.</translation>
<translation id="3757825924724354052">Shuttle logotip</translation>
<translation id="3837584850181228767">Napomena za Chromium: Poboljšano bezbedno pregledanje</translation>
<translation id="4050599136622776556">Chromium pokušava da izmeni načine plaćanja.</translation>
<translation id="8988476603327209803">Shuttle omogućavaju <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> projekat otvorenog koda i drugi <ph name="BEGIN_LINK_OSS" />softver otvorenog koda<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Shuttle blokira ovu stranicu</translation>
<translation id="4604973006041022107">Dozvolite Shuttle-u da pristupa mreži u zaštitnom zidu ili antivirusnim
          podešavanjima.</translation>
<translation id="4949828774841497663">Idite u Applications (Aplikacije) &gt; System Settings (Podešavanja sistema) &gt; Network (Mreža), pa izaberite
          aktivnu mrežu, kliknite na dugme Details... (Detalji), a zatim poništite izbor svih proksija
          koji su izabrani.</translation>
<translation id="6683794703230411154">Idite u
          Shuttle meni &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Mreža i internet &gt; Proksi
          i poništite izbor opcije Automatski otkrij podešavanja.</translation>
<translation id="262795629490583875">Ove stranice su namenjene programerima Shuttle-a i možda se ne održavaju niti testiraju aktivno. Da biste ih omogućili, idite na <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, kliknite na dugme da biste omogućili stranice za otklanjanje grešaka, pa ponovo idite na ovu stranicu.</translation>
<translation id="6549378540556750549">Chromium omogućava i drugi <ph name="BEGIN_LINK_OSS" />softver otvorenog koda<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Promene će stupiti na snagu kada sledeći put ponovo pokrenete Shuttle.</translation>
<translation id="7251378182421874967">Shuttle zahteva pristup Bluetooth-u radi nastavljanja sa 
 uparivanjem. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium omogućava <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> projekat otvorenog koda.</translation>
<translation id="6298583427647441415">Otvorite
          Shuttle meni &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          i opozovite izbor opcije „<ph name="NO_PREFETCH_DESCRIPTION" />“.
          Ako vam to ne reši problem, preporučujemo da ponovo izaberete
          ovu opciju radi boljih performansi.</translation>
<translation id="8597726643333341451">Pregledate bezbednu Chrome for Testing stranicu</translation>
<translation id="1627254898104673072">Shuttle se nije ispravno zatvorio.</translation>
<translation id="9183331186620388872">Savet za Chromium: Pretražujte pomoću Objektiva</translation>
</translationbundle>