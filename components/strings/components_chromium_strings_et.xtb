<!DOCTYPE translationbundle>
<translationbundle lang="et">
<translation id="130631256467250065">Muudatused jõustuvad järgmine kord, kui seadme taaskäivitate.</translation>
<translation id="1965068424387304464">Chromiumi nõuanne: salvestage paroolid</translation>
<translation id="6181600115274209660">Minge
          Shuttlei menüüsse &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ja veenduge, et konfiguratsioon on määratud valikule „Puhverserverita” või „Otse”.</translation>
<translation id="8019164406370393370">Krahhiaruandlus ei ole Shuttleis saadaval.</translation>
<translation id="7131945667699137625">Vaatate turvalist Shuttlei lehte</translation>
<translation id="3255926992597692024">Chromium proovib muuta makseviiside sisestamise seadeid.</translation>
<translation id="3757825924724354052">Shuttlei logo</translation>
<translation id="3837584850181228767">Chromiumi nõuanne: täiustatud ohutu sirvimine</translation>
<translation id="4050599136622776556">Chromium üritab muuta makseviise.</translation>
<translation id="8988476603327209803">Shuttlei aluseks on avatud lähtekoodiga projekt <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ja muu <ph name="BEGIN_LINK_OSS" />avatud lähtekoodiga tarkvara<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Shuttle blokeeris selle lehe</translation>
<translation id="4604973006041022107">Lubage Shuttlei juurdepääs võrgule tulemüüri või viirusetõrje
         seadetes.</translation>
<translation id="4949828774841497663">Avage Applications &gt; System Settings &gt; Network, valige
          aktiivne võrk, klõpsake nupul Details... ja tühistage mis tahes puhverserverite valikud,
          mis võisid olla valitud.</translation>
<translation id="6683794703230411154">Avage
          Shuttlei menüü &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Võrk ja internet &gt; Puhverserver
          ning tühistage valik „Tuvasta seaded automaatselt“.</translation>
<translation id="262795629490583875">Need lehed on mõeldud kasutamiseks Shuttlei arendajatele ning neid ei pruugita aktiivselt hooldada ega testida. Silumislehtede lubamiseks navigeerige lingile <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, klõpsake selleks ettenähtud nupul ja seejärel navigeerige uuesti praegusele lehele.</translation>
<translation id="6549378540556750549">Chromiumi võimaldab pakkuda ka muu <ph name="BEGIN_LINK_OSS" />avatud lähtekoodiga tarkvara<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Teie muudatused jõustuvad järgmine kord, kui Shuttlei taaskäivitate.</translation>
<translation id="7251378182421874967">Shuttle vajab sidumise jätkamiseks juurdepääsu Bluetoothile. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromiumi võimaldab pakkuda <ph name="BEGIN_LINK_CHROMIUM" />Chromiumi<ph name="END_LINK_CHROMIUM" /> avatud lähtekoodi projekt.</translation>
<translation id="6298583427647441415">Avage
        Shuttlei menüü &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        ja tühistage valik „<ph name="NO_PREFETCH_DESCRIPTION" />”.
        Kui see probleemi ei lahenda, soovitame selle valiku
        toimivuse parandamiseks uuesti teha.</translation>
<translation id="8597726643333341451">Vaatate turvalist brauseri Chrome for Testing lehte</translation>
<translation id="1627254898104673072">Shuttle ei sulgunud õigesti.</translation>
<translation id="9183331186620388872">Chromiumi nõuanne: otsige Lensiga</translation>
</translationbundle>