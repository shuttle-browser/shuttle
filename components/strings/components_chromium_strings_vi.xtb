<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="130631256467250065">Thay đổi của bạn sẽ có hiệu lực vào lần tiếp theo bạn khởi động lại thiết bị của mình.</translation>
<translation id="1965068424387304464">Mẹo khi dùng Chromium: Lưu mật khẩu</translation>
<translation id="6181600115274209660">Chuyển đến
          trình đơn Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          và đảm bảo cấu hình của bạn được đặt thành "không có proxy" hoặc "trực tiếp".</translation>
<translation id="8019164406370393370">Báo cáo sự cố hiện không khả dụng trong Shuttle.</translation>
<translation id="7131945667699137625">Bạn đang xem trang Shuttle an toàn</translation>
<translation id="3255926992597692024">Chromium đang cố gắng sửa đổi chế độ cài đặt cho việc điền phương thức thanh toán.</translation>
<translation id="3757825924724354052">Biểu trưng Shuttle</translation>
<translation id="3837584850181228767">Mẹo khi dùng Chromium: Duyệt web an toàn có tăng cường bảo vệ</translation>
<translation id="4050599136622776556">Chromium đang cố gắng chỉnh sửa phương thức thanh toán.</translation>
<translation id="8988476603327209803">Shuttle trở nên khả thi là nhờ dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> và các <ph name="BEGIN_LINK_OSS" />phần mềm nguồn mở<ph name="END_LINK_OSS" /> khác.</translation>
<translation id="2477509191993550467">Trang này bị Shuttle chặn</translation>
<translation id="4604973006041022107">Cho phép Shuttle truy cập mạng trong cài đặt tường lửa hoặc diệt vi-rút 
        của bạn.</translation>
<translation id="4949828774841497663">Chuyển đến phần Ứng dụng &gt; Cài đặt hệ thống &gt; Mạng, chọn
          mạng đang hoạt động, nhấp vào nút Chi tiết..., rồi bỏ chọn mọi máy chủ proxy
          có thể đã được chọn.</translation>
<translation id="6683794703230411154">Chuyển đến
          trình đơn Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Mạng và Internet &gt; Proxy
          rồi bỏ chọn "Tự động phát hiện chế độ cài đặt".</translation>
<translation id="262795629490583875">Các trang này dành cho nhà phát triển Shuttle sử dụng và có thể không được duy trì hoặc kiểm tra liên tục. Để kích hoạt các trang này, hãy chuyển đến <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, nhấp vào nút để kích hoạt trang gỡ lỗi, rồi chuyển đến trang này một lần nữa.</translation>
<translation id="6549378540556750549">Chromium cũng được cung cấp thông qua <ph name="BEGIN_LINK_OSS" />phần mềm nguồn mở<ph name="END_LINK_OSS" /> khác.</translation>
<translation id="3051968423457057392">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại Shuttle.</translation>
<translation id="7251378182421874967">Shuttle cần có quyền truy cập Bluetooth để tiếp tục 
 ghép nối. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Chromium được cung cấp thông qua dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">Chuyển đến
          menu Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          và bỏ chọn "<ph name="NO_PREFETCH_DESCRIPTION" />."
          Nếu cách này không giải quyết được sự cố thì chúng tôi khuyên bạn nên chọn lại tùy chọn này
          để cải thiện hiệu suất.</translation>
<translation id="8597726643333341451">Bạn đang xem một trang Chrome for Testing an toàn</translation>
<translation id="1627254898104673072">Shuttle không tắt đúng cách.</translation>
<translation id="9183331186620388872">Mẹo dùng Chromium: Tìm kiếm bằng Ống kính</translation>
</translationbundle>