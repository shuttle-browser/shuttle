<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="130631256467250065">Οι αλλαγές σας θα εφαρμοστούν την επόμενη φορά που θα επανεκκινήσετε τη συσκευή σας.</translation>
<translation id="1965068424387304464">Συμβουλή για το Chromium: Αποθήκευση κωδικών πρόσβασης</translation>
<translation id="6181600115274209660">Μεταβείτε
          στο μενού του Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          και βεβαιωθείτε ότι η διαμόρφωσή σας είναι ρυθμισμένη στην επιλογή "χωρίς διακομιστή μεσολάβησης" ή "άμεση".</translation>
<translation id="8019164406370393370">Η αναφορά σφαλμάτων δεν είναι διαθέσιμη στο Shuttle.</translation>
<translation id="7131945667699137625">Βλέπετε μια ασφαλή σελίδα Shuttle</translation>
<translation id="3255926992597692024">Το Chromium προσπαθεί να τροποποιήσει τις ρυθμίσεις για τη συμπλήρωση τρόπων πληρωμής.</translation>
<translation id="3757825924724354052">Λογότυπο Shuttle</translation>
<translation id="3837584850181228767">Συμβουλή για το Chromium: Βελτιωμένη Ασφαλής περιήγηση</translation>
<translation id="4050599136622776556">Το Chromium προσπαθεί να επεξεργαστεί τους τρόπους πληρωμής.</translation>
<translation id="8988476603327209803">Το Shuttle υλοποιήθηκε με τη βοήθεια του έργου ανοικτού κώδικα <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> και άλλου <ph name="BEGIN_LINK_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_OSS" />.</translation>
<translation id="2477509191993550467">Αυτή η σελίδα έχει αποκλειστεί από το Shuttle.</translation>
<translation id="4604973006041022107">Επιτρέψτε στο Shuttle να αποκτήσει πρόσβαση στο δίκτυο από τις ρυθμίσεις του τείχους προστασίας
          ή του λογισμικού προστασίας από ιούς που διαθέτετε.</translation>
<translation id="4949828774841497663">Μεταβείτε στις Εφαρμογές &gt; Ρυθμίσεις συστήματος &gt; Δίκτυο, επιλέξτε το
          ενεργό δίκτυο, κάντε κλικ στο κουμπί "Λεπτομέρειες…" και καταργήστε την επιλογή τυχόν διακομιστών μεσολάβησης
          που μπορεί να έχουν επιλεγεί.</translation>
<translation id="6683794703230411154">Μεταβείτε στο
          μενού του Shuttle &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Δίκτυο και διαδίκτυο &gt; Διακομιστής μεσολάβησης
          και αποεπιλέξτε την επιλογή Αυτόματος εντοπισμός ρυθμίσεων.</translation>
<translation id="262795629490583875">Αυτές οι σελίδες προορίζονται για χρήση από προγραμματιστές του Shuttle και ενδέχεται να μην συντηρούνται ή να ελέγχονται ενεργά. Για να τις ενεργοποιήσετε, μεταβείτε στο <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, κάντε κλικ στο κουμπί, για να ενεργοποιήσετε τις σελίδες εντοπισμού σφαλμάτων και, στη συνέχεια, μεταβείτε ξανά σε αυτή τη σελίδα.</translation>
<translation id="6549378540556750549">Το Chromium υλοποιήθηκε με τη βοήθεια και άλλων <ph name="BEGIN_LINK_OSS" />λογισμικών ανοικτού κώδικα<ph name="END_LINK_OSS" />.</translation>
<translation id="3051968423457057392">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το Shuttle.</translation>
<translation id="7251378182421874967">Το Shuttle χρειάζεται πρόσβαση στο Bluetooth για να συνεχιστεί 
 η σύζευξη. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Το Chromium υλοποιήθηκε με το έργο ανοικτού κώδικα <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="6298583427647441415">Μεταβείτε
        στο μενού του Shuttle &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        και αποεπιλέξτε "<ph name="NO_PREFETCH_DESCRIPTION" />".
        Εάν με αυτόν τον τρόπο δεν επιλύεται το ζήτημά σας, συνιστούμε
        να ενεργοποιήσετε ξανά αυτή την επιλογή για βελτιωμένη απόδοση.</translation>
<translation id="8597726643333341451">Βλέπετε μια ασφαλή σελίδα Chrome for Testing</translation>
<translation id="1627254898104673072">Το Shuttle δεν έκλεισε σωστά.</translation>
<translation id="9183331186620388872">Συμβουλή για το Chromium: Αναζήτηση με το Lens</translation>
</translationbundle>